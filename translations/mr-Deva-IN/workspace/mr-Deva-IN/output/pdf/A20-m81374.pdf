          <div id="fs-id1167836664452" class="problem">
            <p id="fs-id1167836664454">
              <span class="math" data-check="MR-BRIDGE-017::src-fs-id1167836664454-1" data-origin-check="src-fs-id1167836664454-1">(−1, −1), (0, 5)</span>
            </p>
          </div>
