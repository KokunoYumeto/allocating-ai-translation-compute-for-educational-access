        <h4>प्रश्न 8</h4>
        <div id="fs-id1167829905989" class="problem">
          <p id="fs-id1167829905991">
            <span class="math" data-check="MR-BRIDGE-022::src-fs-id1167829905991-1" data-origin-check="src-fs-id1167829905991-1">y = −x</span>
