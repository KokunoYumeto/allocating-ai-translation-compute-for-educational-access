        </section>
        <section id="fs-id1167836322980" data-source="A20:m81374#fs-id1167836322980" data-kind="translation" data-origin-unit="MR-BRIDGE-017" data-source-tag="exercise">
          <h4>प्रश्न 10</h4>
          <div id="fs-id1167836322982" class="problem">
            <p id="fs-id1167829790349">
              <span class="math" data-check="MR-BRIDGE-017::src-fs-id1167829790349-1" data-origin-check="src-fs-id1167829790349-1">(3, 5), (4, −1)</span>
            </p>
            <p>
              <a href="#fs-id1167833049600">स्रोत-उत्तर पाहा</a>
            </p>
          </div>
          <div id="fs-id1167833049600" class="solution">
            <h5>स्रोतातील उत्तर</h5>
            <p id="fs-id1167836455885">
