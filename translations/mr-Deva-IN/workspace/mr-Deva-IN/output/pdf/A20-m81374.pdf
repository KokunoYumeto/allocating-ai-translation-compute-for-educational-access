          <h4>प्रश्न 19</h4>
          <div id="fs-id1167836560608" class="problem">
            <p id="fs-id1167829741858">
              <span class="math" data-check="MR-BRIDGE-020::src-fs-id1167829741858-1" data-origin-check="src-fs-id1167829741858-1">F(x) = 2x²−3x+1;</span>
