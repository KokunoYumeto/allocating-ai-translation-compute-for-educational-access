            <p>
              <a href="#fs-id1167832982331">प्रश्नाकडे परत</a>
            </p>
          </div>
        </section>
        <section id="fs-id1167833227116" data-source="A20:m81374#fs-id1167833227116" data-kind="translation" data-origin-unit="MR-BRIDGE-017" data-source-tag="exercise">
          <h4>प्रश्न 23</h4>
          <div id="fs-id1167836598001" class="problem">
            <p id="fs-id1167836598003">
              <span class="math" data-check="MR-BRIDGE-017::src-fs-id1167836598003-1" data-origin-check="src-fs-id1167836598003-1">y = −(2/5)x + 3</span>
            </p>
          </div>
          <p data-kind="original" class="source-answer-missing">स्रोतात या प्रश्नाचे उत्तर दिलेले नाही. स्वतः सोडवा.</p>
        </section>
        <section id="fs-id1167836628505" data-source="A20:m81374#fs-id1167836628505" data-kind="translation" data-origin-unit="MR-BRIDGE-017" data-source-tag="exercise">
          <h4>प्रश्न 24</h4>
          <div id="fs-id1167836535018" class="problem">
            <p id="fs-id1167836535020">
              <span class="math" data-check="MR-BRIDGE-017::src-fs-id1167836535020-1" data-origin-check="src-fs-id1167836535020-1">4x − 3y = 12</span>
            </p>
            <p>
              <a href="#fs-id1167833340136">स्रोत-उत्तर पाहा</a>
            </p>
          </div>
          <div id="fs-id1167833340136" class="solution">
            <h5>स्रोतातील उत्तर</h5>
            <div id="fs-id1167836493580">
              <figure id="fs-id1167836493581">
                <img src="../assets/MR-BRIDGE-017/CNX_IntAlg_Figure_03_06_374_img_new.jpg" alt="दोन्ही अक्षांवर −10 ते 10 खुणा. डावीकडून उजवीकडे चढणारी सरळ रेषा (0, −4) आणि (3, 0) या बिंदूंमधून जाते. दोन्ही टोकांना बाण आहेत." data-origin-src="asset:CNX_IntAlg_Figure_03_06_374_img_new.jpg" />
