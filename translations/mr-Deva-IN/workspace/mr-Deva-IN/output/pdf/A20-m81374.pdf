        <section id="fs-id1167829741996" data-source="A20:m81374#fs-id1167829741996" data-kind="translation" data-origin-unit="MR-BRIDGE-017" data-source-tag="exercise">
          <h4>प्रश्न 20</h4>
          <div id="fs-id1167829741998" class="problem">
            <p id="fs-id1167829619884">
              <span class="math" data-check="MR-BRIDGE-017::src-fs-id1167829619884-1" data-origin-check="src-fs-id1167829619884-1">4x − 5y = 8</span>
