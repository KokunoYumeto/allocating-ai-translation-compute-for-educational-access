<ns0:note xmlns:ns0="http://cnx.rice.edu/cnxml" xmlns:ns1="http://www.w3.org/1998/Math/MathML" id="fs-id1167829598148">
<ns0:title>Graph of a Function</ns0:title>
<ns0:para id="fs-id1167836692382">The graph of a function is the graph of all its ordered pairs, <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mi>x</ns1:mi><ns1:mo>,</ns1:mo><ns1:mi>y</ns1:mi></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow></ns1:mrow></ns1:math> or using function notation, <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mi>x</ns1:mi><ns1:mo>,</ns1:mo><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>)</ns1:mo></ns1:mrow></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow></ns1:mrow></ns1:math> where <ns1:math><ns1:mrow><ns1:mi>y</ns1:mi><ns1:mo>=</ns1:mo><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>.</ns1:mo></ns1:mrow></ns1:math></ns0:para>
<ns0:equation id="fs-id1167829719082" class="unnumbered"><ns0:label /><ns1:math><ns1:mrow><ns1:mtable><ns1:mtr><ns1:mtd columnalign="right"><ns1:mi>f</ns1:mi></ns1:mtd><ns1:mtd /><ns1:mtd /><ns1:mtd columnalign="left"><ns1:mtext>name of function</ns1:mtext></ns1:mtd></ns1:mtr><ns1:mtr><ns1:mtd columnalign="right"><ns1:mi>x</ns1:mi></ns1:mtd><ns1:mtd /><ns1:mtd /><ns1:mtd columnalign="left"><ns1:mi>x</ns1:mi><ns1:mtext>-coordinate of the ordered pair</ns1:mtext></ns1:mtd></ns1:mtr><ns1:mtr><ns1:mtd columnalign="right"><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>)</ns1:mo></ns1:mrow></ns1:mtd><ns1:mtd /><ns1:mtd /><ns1:mtd columnalign="left"><ns1:mi>y</ns1:mi><ns1:mtext>-coordinate of the ordered pair</ns1:mtext></ns1:mtd></ns1:mtr></ns1:mtable></ns1:mrow></ns1:math></ns0:equation>
</ns0:note>
