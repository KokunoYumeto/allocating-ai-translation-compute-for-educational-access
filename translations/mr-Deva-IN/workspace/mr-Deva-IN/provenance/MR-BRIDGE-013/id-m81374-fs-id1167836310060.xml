<ns0:para id="fs-id1167829860129">Gambarkan grafik: <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>=</ns1:mo><ns1:msup><ns1:mi>x</ns1:mi><ns1:mn>2</ns1:mn></ns1:msup><ns1:mo>.</ns1:mo></ns1:mrow></ns1:math></ns0:para>
