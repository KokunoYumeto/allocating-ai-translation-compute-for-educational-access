<ns0:para id="fs-id1167836349492">Gambarkan grafik: <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>=</ns1:mo><ns1:mtext>−</ns1:mtext><ns1:mrow><ns1:mo>|</ns1:mo><ns1:mrow><ns1:mi>x</ns1:mi></ns1:mrow><ns1:mo>|</ns1:mo></ns1:mrow><ns1:mo>.</ns1:mo></ns1:mrow></ns1:math></ns0:para>
