<?xml version='1.0' encoding='utf-8'?>
<ns0:example xmlns:ns0="http://cnx.rice.edu/cnxml" xmlns:ns1="http://www.w3.org/1998/Math/MathML" id="fs-id1167825091753">
<ns0:exercise id="fs-id1167833056074">
<ns0:problem id="fs-id1167836513618">
<ns0:para id="fs-id1167836612024">Gambarkan grafik: <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>=</ns1:mo><ns1:mn>−2</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>4</ns1:mn><ns1:mo>.</ns1:mo></ns1:mrow></ns1:math></ns0:para>
</ns0:problem>
<ns0:solution id="fs-id1167836546655">
<ns0:para id="fs-id1167836618853"><ns0:table id="fs-id1167836688758" class="unnumbered unstyled" aria-label="Fungsi f(x) = negatif 2x − 4 adalah fungsi linear. Gradiennya m = negatif 2 dan titik potong sumbu y-nya b = negatif 4. Grafik dibuat menggunakan gradien dan titik potong sumbu y. Gambar menampilkan grafik fungsi linear pada bidang koordinat x-y; kedua sumbu membentang dari negatif 6 hingga 6. Garis melalui titik (negatif 2, 0), (0, negatif 4), dan (negatif 1, negatif 2).">
<ns0:label />
<ns0:tgroup cols="2">
<ns0:colspec colnum="1" colname="c1" />
<ns0:colspec colnum="2" colname="c2" />
<ns0:tbody>
<ns0:row valign="top">
<ns0:entry valign="top" align="left" />
<ns0:entry valign="top" align="left"><ns1:math><ns1:mrow><ns1:mspace width="4.5em" /><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>=</ns1:mo><ns1:mn>−2</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>4</ns1:mn></ns1:mrow></ns1:math></ns0:entry>
</ns0:row>
<ns0:row valign="top">
<ns0:entry valign="top" align="left">Kita mengenalinya sebagai fungsi linear.</ns0:entry>
<ns0:entry valign="top" align="left" />
</ns0:row>
<ns0:row valign="top">
<ns0:entry valign="top" align="left">Tentukan gradien dan titik potong sumbu <ns0:emphasis effect="italics">y</ns0:emphasis>.</ns0:entry>
<ns0:entry valign="top" align="left"><ns1:math><ns1:mrow><ns1:mspace width="5.5em" /><ns1:mi>m</ns1:mi><ns1:mo>=</ns1:mo><ns1:mn>−2</ns1:mn></ns1:mrow></ns1:math><ns0:newline /><ns1:math><ns1:mrow><ns1:mspace width="5.65em" /><ns1:mi>b</ns1:mi><ns1:mo>=</ns1:mo><ns1:mn>−4</ns1:mn></ns1:mrow></ns1:math></ns0:entry>
</ns0:row>
<ns0:row valign="top">
<ns0:entry valign="top" align="left">Gambarkan grafik menggunakan gradien dan titik potong sumbu y.</ns0:entry>
<ns0:entry valign="top" align="left"><ns0:media id="fs-id1167829746004" alt="Sebuah bidang koordinat dengan garis lurus melewati (negatif 2, 0) dan (0, negatif 4)."><ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_06_009a_img.jpg" /></ns0:media></ns0:entry>
</ns0:row>
</ns0:tbody>
</ns0:tgroup>
</ns0:table></ns0:para>
</ns0:solution>
</ns0:exercise>
</ns0:example>
