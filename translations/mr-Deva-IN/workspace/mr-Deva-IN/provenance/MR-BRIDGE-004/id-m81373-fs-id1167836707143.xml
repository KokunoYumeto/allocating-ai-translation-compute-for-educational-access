<ns0:problem id="fs-id1167836524480">
<ns0:para id="fs-id1167836524482"><ns0:newline /><ns0:media id="fs-id1167836524483" alt="Grafik menampilkan enam titik pada bidang koordinat xy dengan kedua sumbu dari negatif 6 hingga 6: (negatif 1, 4), (negatif 1, negatif 4), (0, 3), (0, negatif 3), (1, 4), dan (1, negatif 4).">
<ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_05_207_img_new.jpg" />
</ns0:media></ns0:para>
</ns0:problem>
<ns0:solution id="fs-id1167829861860">
<ns0:para id="fs-id1167829861862"><ns0:span class="token">ⓐ</ns0:span> (1, 4), (1, −4), (−1, 4), (−1, −4), (0, 3), (0, −3) <ns0:span class="token">ⓑ</ns0:span> {−1, 0, 1} <ns0:span class="token">ⓒ</ns0:span> {−4, −3, 3, 4}</ns0:para>
</ns0:solution>
</ns0:exercise>
