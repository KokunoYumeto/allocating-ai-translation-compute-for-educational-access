<ns0:problem id="fs-id1167836623116">
<ns0:para id="fs-id1167836623118"><ns0:newline /><ns0:media id="fs-id1167836623119" alt="Grafik menampilkan enam titik pada bidang koordinat xy dengan kedua sumbu dari negatif 6 hingga 6: (negatif 3, 4), (negatif 3, negatif 1), (0, negatif 3), (2, 3), (4, negatif 1), dan (4, negatif 3).">
<ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_05_205_img_new.jpg" />
</ns0:media></ns0:para>
</ns0:problem>
<ns0:solution id="fs-id1167836448402">
<ns0:para id="fs-id1167836448404"><ns0:span class="token">ⓐ</ns0:span> (2, 3), (4, −3), (−2, −1), (−3, 4), (4, −1), (0, −3) <ns0:span class="token">ⓑ</ns0:span> {−3, −2, 0, 2, 4}<ns0:newline /><ns0:span class="token">ⓒ</ns0:span> {−3, −1, 3, 4}</ns0:para>
</ns0:solution>
</ns0:exercise>
