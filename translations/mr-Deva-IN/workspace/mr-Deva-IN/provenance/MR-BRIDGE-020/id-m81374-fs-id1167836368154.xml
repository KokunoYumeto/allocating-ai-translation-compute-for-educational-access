<ns0:media id="fs-id1167824617025" alt="Gambar menampilkan titik-titik pada bidang koordinat x-y; kedua sumbu membentang dari negatif 6 hingga 6. Titik-titiknya adalah (negatif 3, 1), (negatif 2, negatif 1), (negatif 2, negatif 3), (0, negatif 1), (0, 4), dan (4, 3).">
<ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_06_235_img_new.jpg" />
</ns0:media>
</ns0:problem>
<ns0:solution id="fs-id1167833290236">
<ns0:para id="fs-id1167833290238"><ns0:span class="token">ⓐ</ns0:span> (4, 3), (−2, −3), (−2, −1), (−3, 1), (0, −1), (0, 4),<ns0:newline /><ns0:span class="token">ⓑ</ns0:span> D: {−3, −2, 0, 4}<ns0:newline /><ns0:span class="token">ⓒ</ns0:span> R: {−3, −1, 1, 3, 4}</ns0:para>
</ns0:solution>
