<ns0:problem id="fs-id1167829788685">
<ns0:para id="fs-id1167829788687">For the function <ns1:math><ns1:mrow><ns1:mi>g</ns1:mi><ns1:mo stretchy="false">(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo stretchy="false">)</ns1:mo><ns1:mo>=</ns1:mo><ns1:mn>4</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>7</ns1:mn><ns1:mo>,</ns1:mo></ns1:mrow></ns1:math> evaluate the function.</ns0:para>
<ns0:para id="fs-id1167829906594"><ns0:span class="token">ⓐ</ns0:span> <ns1:math><ns1:mrow><ns1:mi>g</ns1:mi><ns1:mo stretchy="false">(</ns1:mo><ns1:msup><ns1:mi>m</ns1:mi><ns1:mn>2</ns1:mn></ns1:msup><ns1:mo stretchy="false">)</ns1:mo></ns1:mrow></ns1:math> <ns0:span class="token">ⓑ</ns0:span> <ns1:math><ns1:mrow><ns1:mi>g</ns1:mi><ns1:mo stretchy="false">(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>3</ns1:mn><ns1:mo stretchy="false">)</ns1:mo></ns1:mrow></ns1:math> <ns0:span class="token">ⓒ</ns0:span> <ns1:math><ns1:mrow><ns1:mi>g</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>−</ns1:mo><ns1:mi>g</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mn>3</ns1:mn><ns1:mo>)</ns1:mo></ns1:mrow></ns1:mrow></ns1:math></ns0:para>
</ns0:problem>
<ns0:solution id="fs-id1167836624292">
<ns0:para id="fs-id1167836554185"><ns0:span class="token">ⓐ</ns0:span> <ns1:math><ns1:mrow><ns1:mn>4</ns1:mn><ns1:msup><ns1:mi>m</ns1:mi><ns1:mn>2</ns1:mn></ns1:msup><ns1:mo>−</ns1:mo><ns1:mn>7</ns1:mn></ns1:mrow></ns1:math> <ns0:span class="token">ⓑ</ns0:span> <ns1:math><ns1:mrow><ns1:mn>4</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>19</ns1:mn></ns1:mrow></ns1:math><ns0:newline /><ns0:span class="token">ⓒ</ns0:span> <ns1:math><ns1:mrow><ns1:mn>4</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>12</ns1:mn></ns1:mrow></ns1:math></ns0:para>
</ns0:solution>
