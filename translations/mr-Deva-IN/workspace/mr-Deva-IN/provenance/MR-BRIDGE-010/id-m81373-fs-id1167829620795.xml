<ns0:title>Variabel Bebas dan Terikat</ns0:title>
<ns0:para id="fs-id1167836548512">Untuk fungsi <ns1:math><ns1:mrow><ns1:mi>y</ns1:mi><ns1:mo>=</ns1:mo><ns1:mi>f</ns1:mi><ns1:mo stretchy="false">(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo stretchy="false">)</ns1:mo><ns1:mo>,</ns1:mo></ns1:mrow></ns1:math></ns0:para>
<ns0:equation id="fs-id1167836732021" class="unnumbered"><ns0:label /><ns1:math><ns1:mrow><ns1:mtable><ns1:mtr><ns1:mtd columnalign="left"><ns1:mi>x</ns1:mi><ns1:mspace width="0.2em" /><ns1:mtext>adalah variabel bebas karena dapat mengambil sembarang nilai dalam domain</ns1:mtext></ns1:mtd></ns1:mtr>
<ns1:mtr><ns1:mtd columnalign="left"><ns1:mi>y</ns1:mi><ns1:mspace width="0.2em" /><ns1:mtext>sebagai variabel terikat karena nilainya bergantung pada</ns1:mtext><ns1:mspace width="0.2em" /><ns1:mi>x</ns1:mi></ns1:mtd></ns1:mtr></ns1:mtable></ns1:mrow></ns1:math></ns0:equation>
</ns0:note>
