<?xml version='1.0' encoding='utf-8'?>
<ns0:note xmlns:ns0="http://cnx.rice.edu/cnxml" xmlns:ns1="http://www.w3.org/1998/Math/MathML" id="fs-id1167824735502">
<ns0:title>Notasi Fungsi</ns0:title>
<ns0:para id="fs-id1167836379405">Untuk fungsi <ns1:math><ns1:mrow><ns1:mi>y</ns1:mi><ns1:mo>=</ns1:mo><ns1:mi>f</ns1:mi><ns1:mo stretchy="false">(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo stretchy="false">)</ns1:mo></ns1:mrow></ns1:math></ns0:para>
<ns0:equation id="fs-id1167829590438" class="unnumbered"><ns0:label /><ns1:math><ns1:mrow><ns1:mtable><ns1:mtr><ns1:mtd columnalign="left"><ns1:mi>f</ns1:mi><ns1:mspace width="0.2em" /><ns1:mtext>adalah nama fungsi</ns1:mtext></ns1:mtd></ns1:mtr>
<ns1:mtr><ns1:mtd columnalign="left"><ns1:mi>x</ns1:mi><ns1:mspace width="0.2em" /><ns1:mtext>adalah nilai domain</ns1:mtext></ns1:mtd></ns1:mtr>
<ns1:mtr><ns1:mtd columnalign="left"><ns1:mi>f</ns1:mi><ns1:mo stretchy="false">(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo stretchy="false">)</ns1:mo><ns1:mspace width="0.2em" /><ns1:mtext>adalah nilai range</ns1:mtext><ns1:mspace width="0.2em" /><ns1:mi>y</ns1:mi><ns1:mspace width="0.2em" /><ns1:mtext>yang bersesuaian dengan nilai</ns1:mtext><ns1:mspace width="0.2em" /><ns1:mi>x</ns1:mi></ns1:mtd></ns1:mtr></ns1:mtable></ns1:mrow></ns1:math></ns0:equation>
<ns0:para id="fs-id1167829743148">Kita membaca <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mo stretchy="false">(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo stretchy="false">)</ns1:mo></ns1:mrow></ns1:math> sebagai <ns0:emphasis effect="italics">f</ns0:emphasis> dari <ns0:emphasis effect="italics">x</ns0:emphasis> atau nilai <ns0:emphasis effect="italics">f</ns0:emphasis> pada <ns0:emphasis effect="italics">x</ns0:emphasis>.</ns0:para>
</ns0:note>
