<?xml version='1.0' encoding='utf-8'?>
<ns0:note xmlns:ns0="http://cnx.rice.edu/cnxml" xmlns:ns1="http://www.w3.org/1998/Math/MathML" id="fs-id1167824735502">
<ns0:title>Function Notation</ns0:title>
<ns0:para id="fs-id1167836379405">For the function <ns1:math><ns1:mrow><ns1:mi>y</ns1:mi><ns1:mo>=</ns1:mo><ns1:mi>f</ns1:mi><ns1:mo stretchy="false">(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo stretchy="false">)</ns1:mo></ns1:mrow></ns1:math></ns0:para>
<ns0:equation id="fs-id1167829590438" class="unnumbered"><ns0:label /><ns1:math><ns1:mrow><ns1:mtable><ns1:mtr><ns1:mtd columnalign="left"><ns1:mi>f</ns1:mi><ns1:mspace width="0.2em" /><ns1:mtext>is the name of the function</ns1:mtext></ns1:mtd></ns1:mtr>
<ns1:mtr><ns1:mtd columnalign="left"><ns1:mi>x</ns1:mi><ns1:mspace width="0.2em" /><ns1:mtext>is the domain value</ns1:mtext></ns1:mtd></ns1:mtr>
<ns1:mtr><ns1:mtd columnalign="left"><ns1:mi>f</ns1:mi><ns1:mo stretchy="false">(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo stretchy="false">)</ns1:mo><ns1:mspace width="0.2em" /><ns1:mtext>is the range value</ns1:mtext><ns1:mspace width="0.2em" /><ns1:mi>y</ns1:mi><ns1:mspace width="0.2em" /><ns1:mtext>corresponding to the value</ns1:mtext><ns1:mspace width="0.2em" /><ns1:mi>x</ns1:mi></ns1:mtd></ns1:mtr></ns1:mtable></ns1:mrow></ns1:math></ns0:equation>
<ns0:para id="fs-id1167829743148">We read <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mo stretchy="false">(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo stretchy="false">)</ns1:mo></ns1:mrow></ns1:math> as <ns0:emphasis effect="italics">f</ns0:emphasis> of <ns0:emphasis effect="italics">x</ns0:emphasis> or the value of <ns0:emphasis effect="italics">f</ns0:emphasis> at <ns0:emphasis effect="italics">x</ns0:emphasis>.</ns0:para>
</ns0:note>
