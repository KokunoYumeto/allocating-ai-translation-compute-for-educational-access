<ns0:span class="token">ⓑ</ns0:span> <ns1:math><ns1:mrow><ns1:mo stretchy="false">(</ns1:mo><ns1:mn>0</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn><ns1:mo stretchy="false">)</ns1:mo></ns1:mrow></ns1:math></ns0:para>
