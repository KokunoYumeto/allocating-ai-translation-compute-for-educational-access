<ns0:exercise xmlns:ns0="http://cnx.rice.edu/cnxml" xmlns:ns1="http://www.w3.org/1998/Math/MathML" id="fs-id1167832940626">
<ns0:problem id="fs-id1167832940628">
<ns0:media id="fs-id1167832940630" alt="Gambar ini menampilkan fungsi kuadrat yang digambarkan pada bidang koordinat x y. Sumbu x membentang dari negatif 6 hingga 6. Sumbu y membentang dari negatif 6 hingga 6. Parabola melewati titik (negatif 2, 0), (negatif 1, negatif 3), (0, negatif 4), (1, negatif 3), dan (2, 0). Titik terendah pada grafik adalah (0, negatif 4).">
<ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_06_254_img_new.jpg" />
</ns0:media>
<ns0:para id="fs-id1167836629848">
<ns0:span class="token">ⓐ</ns0:span> Tentukan titik potong sumbu <ns1:math><ns1:mi>x</ns1:mi></ns1:math>.<ns0:newline />
<ns0:span class="token">ⓑ</ns0:span> Tentukan titik potong sumbu <ns1:math><ns1:mrow><ns1:mi>y</ns1:mi></ns1:mrow></ns1:math>.<ns0:newline />
<ns0:span class="token">ⓒ</ns0:span> Tentukan <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>−1</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>.</ns1:mo></ns1:mrow></ns1:math><ns0:newline />
<ns0:span class="token">ⓓ</ns0:span> Tentukan <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mn>1</ns1:mn><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>.</ns1:mo></ns1:mrow></ns1:math><ns0:newline />
<ns0:span class="token">ⓔ</ns0:span> Tentukan domainnya. Tuliskan dalam notasi interval.<ns0:newline />
<ns0:span class="token">ⓕ</ns0:span> Tentukan range-nya. Tuliskan dalam notasi interval.</ns0:para>
</ns0:problem>
<ns0:solution id="fs-id1167829831564">
<ns0:para id="fs-id1167833071738"><ns0:span class="token">ⓐ</ns0:span> <ns1:math><ns1:mrow><ns1:mi>x</ns1:mi><ns1:mo>=</ns1:mo><ns1:mn>−2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>2</ns1:mn></ns1:mrow></ns1:math> <ns0:span class="token">ⓑ</ns0:span> <ns1:math><ns1:mrow><ns1:mi>y</ns1:mi><ns1:mo>=</ns1:mo><ns1:mn>−4</ns1:mn></ns1:mrow></ns1:math><ns0:newline /><ns0:span class="token">ⓒ</ns0:span> <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>−1</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>=</ns1:mo><ns1:mn>−3</ns1:mn></ns1:mrow></ns1:math> <ns0:span class="token">ⓓ</ns0:span> <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mn>1</ns1:mn><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>=</ns1:mo><ns1:mn>−3</ns1:mn></ns1:mrow></ns1:math><ns0:newline /><ns0:span class="token">ⓔ</ns0:span> D: (-∞,∞) <ns0:span class="token">ⓕ</ns0:span> R: [<ns1:math><ns1:mrow><ns1:mn>−4</ns1:mn><ns1:mo>,</ns1:mo></ns1:mrow></ns1:math> ∞)</ns0:para>
</ns0:solution>
</ns0:exercise>
