<ns0:problem id="fs-id1167833369858">
<ns0:para id="fs-id1167833369860">Use the set of ordered pairs to <ns0:span class="token">ⓐ</ns0:span> determine whether the relation is a function, <ns0:span class="token">ⓑ</ns0:span> find the domain of the relation, and <ns0:span class="token">ⓒ</ns0:span> find the range of the relation.</ns0:para>
<ns0:para id="fs-id1167833310998"><ns1:math><ns1:mrow><ns1:mrow><ns1:mo>{</ns1:mo><ns1:mrow><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>−3</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>27</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>−2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>8</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>−1</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>1</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>0</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo></ns1:mrow></ns1:mrow></ns1:mrow></ns1:math><ns0:newline /><ns1:math><ns1:mrow><ns1:mrow><ns1:mrow><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>1</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>1</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>8</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>3</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>27</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow></ns1:mrow><ns1:mo>}</ns1:mo></ns1:mrow></ns1:mrow></ns1:math></ns0:para>
</ns0:problem>
<ns0:solution id="fs-id1167836476899">
<ns0:para id="fs-id1167836476901"><ns0:span class="token">ⓐ</ns0:span> yes <ns0:span class="token">ⓑ</ns0:span> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>{</ns1:mo><ns1:mrow><ns1:mn>−3</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>−2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>−1</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>1</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>3</ns1:mn></ns1:mrow><ns1:mo>}</ns1:mo></ns1:mrow></ns1:mrow></ns1:math> <ns0:span class="token">ⓒ</ns0:span> {0, 1, 8, 27}</ns0:para>
</ns0:solution>
