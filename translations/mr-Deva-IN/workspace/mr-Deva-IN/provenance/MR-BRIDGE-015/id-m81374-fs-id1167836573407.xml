<ns0:exercise xmlns:ns0="http://cnx.rice.edu/cnxml" xmlns:ns1="http://www.w3.org/1998/Math/MathML" id="fs-id1167836573407" class="material-set-2">
<ns0:problem id="fs-id1167836432065">
<ns0:media id="fs-id1167829747450" alt="Gambar ini menampilkan setengah atas lingkaran yang digambarkan pada bidang koordinat x y. Sumbu x membentang dari negatif 6 hingga 6. Sumbu y membentang dari negatif 4 hingga 8. Segmen garis melengkung dimulai di titik (negatif 3, 2). Garis melewati titik (0, 5) dan berakhir di titik (3, 2). Titik (0, 5) adalah titik tertinggi pada grafik. Titik (negatif 3, 2) dan (3, 2) adalah titik terendah pada grafik.">
<ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_06_217_img_new.jpg" />
</ns0:media>
<ns0:para id="fs-id1167836609689"><ns0:span class="token">ⓐ</ns0:span> Tentukan <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mn>0</ns1:mn><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>.</ns1:mo></ns1:mrow></ns1:math><ns0:newline />
<ns0:span class="token">ⓑ</ns0:span> Tentukan <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>−3</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>.</ns1:mo></ns1:mrow></ns1:math><ns0:newline />
<ns0:span class="token">ⓒ</ns0:span> Tentukan <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mn>3</ns1:mn><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>.</ns1:mo></ns1:mrow></ns1:math><ns0:newline />
<ns0:span class="token">ⓓ</ns0:span> Tentukan nilai <ns0:emphasis effect="italics">x</ns0:emphasis> ketika <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>=</ns1:mo><ns1:mn>0</ns1:mn><ns1:mo>.</ns1:mo></ns1:mrow></ns1:math><ns0:newline />
<ns0:span class="token">ⓔ</ns0:span> Tentukan titik potong sumbu <ns0:emphasis effect="italics">x</ns0:emphasis>.<ns0:newline />
<ns0:span class="token">ⓕ</ns0:span> Tentukan titik potong sumbu <ns0:emphasis effect="italics">y</ns0:emphasis>.<ns0:newline />
<ns0:span class="token">ⓖ</ns0:span> Tentukan domainnya. Tuliskan dalam notasi interval.<ns0:newline />
<ns0:span class="token">ⓗ</ns0:span> Tentukan range-nya. Tuliskan dalam notasi interval.</ns0:para>
</ns0:problem>
<ns0:solution id="fs-id1167836544041">
<ns0:para id="fs-id1167829714553"><ns0:span class="token">ⓐ</ns0:span> <ns1:math><ns1:mrow><ns1:mn>5</ns1:mn></ns1:mrow></ns1:math> <ns0:span class="token">ⓑ</ns0:span> <ns1:math><ns1:mrow><ns1:mn>2</ns1:mn></ns1:mrow></ns1:math> <ns0:span class="token">ⓒ</ns0:span> <ns1:math><ns1:mrow><ns1:mn>2</ns1:mn></ns1:mrow></ns1:math> <ns0:span class="token">ⓓ</ns0:span> <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>=</ns1:mo><ns1:mn>0</ns1:mn></ns1:mrow></ns1:math> untuk tidak ada <ns0:emphasis effect="italics">x</ns0:emphasis> <ns0:span class="token">ⓔ</ns0:span> tidak ada <ns0:span class="token">ⓕ</ns0:span> <ns1:math><ns1:mrow><ns1:mfenced><ns1:mrow><ns1:mn>0</ns1:mn><ns1:mo>,</ns1:mo><ns1:mspace width="0.2em" /><ns1:mn>5</ns1:mn></ns1:mrow></ns1:mfenced></ns1:mrow></ns1:math> <ns0:span class="token">ⓖ</ns0:span> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>[</ns1:mo><ns1:mrow><ns1:mn>−3</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>3</ns1:mn></ns1:mrow><ns1:mo>]</ns1:mo></ns1:mrow></ns1:mrow></ns1:math><ns0:newline /><ns0:span class="token">ⓗ</ns0:span> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>[</ns1:mo><ns1:mrow><ns1:mn>2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>5</ns1:mn></ns1:mrow><ns1:mo>]</ns1:mo></ns1:mrow></ns1:mrow></ns1:math></ns0:para>
</ns0:solution>
</ns0:exercise>
