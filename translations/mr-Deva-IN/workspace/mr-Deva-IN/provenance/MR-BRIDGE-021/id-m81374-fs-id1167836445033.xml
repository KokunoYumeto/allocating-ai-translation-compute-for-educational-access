<?xml version='1.0' encoding='utf-8'?>
<ns0:exercise xmlns:ns0="http://cnx.rice.edu/cnxml" xmlns:ns1="http://www.w3.org/1998/Math/MathML" id="fs-id1167836445033">
<ns0:problem id="fs-id1167836445035">
<ns0:media id="fs-id1167829748062" alt="Gambar ini menampilkan garis melengkung bergelombang yang digambarkan pada bidang koordinat x y. Sumbu x membentang dari negatif 2 kali pi hingga 2 kali pi. Sumbu y membentang dari negatif 6 hingga 6. Segmen garis melengkung melewati titik (negatif 2 kali pi, 0), (negatif 3 dibagi 2 kali pi, 1), (negatif pi, 0), (negatif 1 dibagi 2 kali pi, negatif 1), (0, 0), (1 dibagi 2 kali pi, 1), (pi, 0), (3 dibagi 2 kali pi, negatif 1), dan (2 kali pi, 0). Titik (negatif 3 dibagi 2 kali pi, 1) dan (1 dibagi 2 kali pi, 1) adalah titik tertinggi pada grafik. Titik (negatif 1 dibagi 2 kali pi, negatif 1) dan (3 dibagi 2 kali pi, negatif 1) adalah titik terendah pada grafik. Pola ini memanjang ke kiri dan kanan tanpa batas.">
<ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_06_248_img_new.jpg" />
</ns0:media>
<ns0:para id="fs-id1167836622098"><ns0:span class="token">ⓐ</ns0:span> Tentukan <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mn>0</ns1:mn><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>.</ns1:mo></ns1:mrow></ns1:math><ns0:newline />
<ns0:span class="token">ⓑ</ns0:span> Tentukan <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mfrac><ns1:mn>1</ns1:mn><ns1:mn>2</ns1:mn></ns1:mfrac><ns1:mi>π</ns1:mi></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>.</ns1:mo></ns1:mrow></ns1:math><ns0:newline />
<ns0:span class="token">ⓒ</ns0:span> Tentukan <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mo>−</ns1:mo><ns1:mfrac><ns1:mn>3</ns1:mn><ns1:mn>2</ns1:mn></ns1:mfrac><ns1:mi>π</ns1:mi></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>.</ns1:mo></ns1:mrow></ns1:math><ns0:newline />
<ns0:span class="token">ⓓ</ns0:span> Tentukan nilai <ns0:emphasis effect="italics">x</ns0:emphasis> ketika <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>=</ns1:mo><ns1:mn>0</ns1:mn><ns1:mo>.</ns1:mo></ns1:mrow></ns1:math><ns0:newline />
<ns0:span class="token">ⓔ</ns0:span> Tentukan titik potong sumbu <ns1:math><ns1:mrow><ns1:mi>x</ns1:mi></ns1:mrow></ns1:math>.<ns0:newline />
<ns0:span class="token">ⓕ</ns0:span> Tentukan titik potong sumbu <ns1:math><ns1:mrow><ns1:mi>y</ns1:mi></ns1:mrow></ns1:math>.<ns0:newline />
<ns0:span class="token">ⓖ</ns0:span> Tentukan domainnya. Tuliskan dalam notasi interval.<ns0:newline />
<ns0:span class="token">ⓗ</ns0:span> Tentukan range-nya. Tuliskan dalam notasi interval.</ns0:para>
</ns0:problem>
<ns0:solution id="fs-id1167824720940">
<ns0:para id="fs-id1167824720942"><ns0:span class="token">ⓐ</ns0:span> <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>=</ns1:mo><ns1:mn>0</ns1:mn></ns1:mrow></ns1:math> <ns0:span class="token">ⓑ</ns0:span> <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mfenced><ns1:mrow><ns1:mfrac><ns1:mi>π</ns1:mi><ns1:mn>2</ns1:mn></ns1:mfrac></ns1:mrow></ns1:mfenced><ns1:mo>=</ns1:mo><ns1:mn>1</ns1:mn></ns1:mrow></ns1:math><ns0:newline /><ns0:span class="token">ⓒ</ns0:span> <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mfenced><ns1:mrow><ns1:mo>−</ns1:mo><ns1:mfrac><ns1:mrow><ns1:mn>3</ns1:mn><ns1:mi>π</ns1:mi></ns1:mrow><ns1:mn>2</ns1:mn></ns1:mfrac></ns1:mrow></ns1:mfenced><ns1:mo>=</ns1:mo><ns1:mn>1</ns1:mn></ns1:mrow></ns1:math> <ns0:span class="token">ⓓ</ns0:span> <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>=</ns1:mo><ns1:mn>0</ns1:mn></ns1:mrow></ns1:math> untuk <ns1:math><ns1:mrow><ns1:mi>x</ns1:mi><ns1:mo>=</ns1:mo><ns1:mn>−2</ns1:mn><ns1:mi>π</ns1:mi><ns1:mo>,</ns1:mo><ns1:mtext>−</ns1:mtext><ns1:mi>π</ns1:mi><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn><ns1:mo>,</ns1:mo><ns1:mi>π</ns1:mi><ns1:mo>,</ns1:mo><ns1:mn>2</ns1:mn><ns1:mi>π</ns1:mi></ns1:mrow></ns1:math><ns0:newline /><ns0:span class="token">ⓔ</ns0:span> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>−2</ns1:mn><ns1:mi>π</ns1:mi><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo></ns1:mrow></ns1:math> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mtext>−</ns1:mtext><ns1:mi>π</ns1:mi><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo></ns1:mrow></ns1:math> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>0</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo></ns1:mrow></ns1:math> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mi>π</ns1:mi><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo></ns1:mrow></ns1:math> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>2</ns1:mn><ns1:mi>π</ns1:mi><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow></ns1:mrow></ns1:math> <ns0:span class="token">ⓕ</ns0:span> <ns1:math><ns1:mrow><ns1:mfenced><ns1:mrow><ns1:mn>0</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn></ns1:mrow></ns1:mfenced></ns1:mrow></ns1:math><ns0:newline /><ns0:span class="token">ⓖ</ns0:span> <ns1:math><ns1:mrow><ns1:mfenced close="]" open="["><ns1:mrow><ns1:mo>−</ns1:mo><ns1:mi>∞</ns1:mi><ns1:mo>,</ns1:mo><ns1:mi>∞</ns1:mi></ns1:mrow></ns1:mfenced></ns1:mrow></ns1:math> <ns0:span class="token">ⓗ</ns0:span> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>[</ns1:mo><ns1:mrow><ns1:mn>−1</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>1</ns1:mn></ns1:mrow><ns1:mo>]</ns1:mo></ns1:mrow></ns1:mrow></ns1:math></ns0:para>
</ns0:solution>
</ns0:exercise>
