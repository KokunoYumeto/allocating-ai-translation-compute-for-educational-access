<ns0:example xmlns:ns0="http://cnx.rice.edu/cnxml" xmlns:ns1="http://www.w3.org/1998/Math/MathML" id="fs-id1167834191318">
<ns0:exercise id="fs-id1167834156729">
<ns0:problem id="fs-id1167834184039">
<ns0:para id="fs-id1167834189749">Tanpa menggambar grafik, tentukan jumlah solusi, lalu klasifikasikan sistem persamaan tersebut.</ns0:para>
<ns0:para id="fs-id1167834429136"><ns0:span class="token">ⓐ</ns0:span> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>{</ns1:mo><ns1:mtable><ns1:mtr><ns1:mtd columnalign="left"><ns1:mi>y</ns1:mi><ns1:mo>=</ns1:mo><ns1:mn>3</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>1</ns1:mn></ns1:mtd></ns1:mtr><ns1:mtr><ns1:mtd columnalign="left"><ns1:mn>6</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>2</ns1:mn><ns1:mi>y</ns1:mi><ns1:mo>=</ns1:mo><ns1:mn>12</ns1:mn></ns1:mtd></ns1:mtr></ns1:mtable></ns1:mrow></ns1:mrow></ns1:math> <ns0:span class="token">ⓑ</ns0:span> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>{</ns1:mo><ns1:mtable><ns1:mtr><ns1:mtd columnalign="left"><ns1:mn>2</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>+</ns1:mo><ns1:mi>y</ns1:mi><ns1:mo>=</ns1:mo><ns1:mo>−</ns1:mo><ns1:mn>3</ns1:mn></ns1:mtd></ns1:mtr><ns1:mtr><ns1:mtd columnalign="left"><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>5</ns1:mn><ns1:mi>y</ns1:mi><ns1:mo>=</ns1:mo><ns1:mn>5</ns1:mn></ns1:mtd></ns1:mtr></ns1:mtable></ns1:mrow></ns1:mrow></ns1:math></ns0:para>
</ns0:problem>
<ns0:solution id="fs-id1167831882192">
<ns0:para id="fs-id1167835363341"><ns0:span class="token">ⓐ</ns0:span> Kita akan membandingkan gradien dan titik potong kedua garis.</ns0:para>
<ns0:table id="fs-idm341212944" class="unnumbered unstyled" summary="Analisis sistem persamaan linear untuk menentukan apakah kedua garis sejajar dengan membandingkan bentuk gradien–titik potong sumbu y keduanya.">
<ns0:label />
<ns0:tgroup cols="2">
<ns0:colspec colnum="1" colname="c1" />
<ns0:colspec colnum="2" colname="c2" />
<ns0:tbody>
<ns0:row>
<ns0:entry>Persamaan pertama sudah dalam bentuk gradien–titik potong sumbu y.</ns0:entry>
<ns0:entry><ns1:math><ns1:mrow><ns1:mspace width="6.5em" /><ns1:mtable><ns1:mtr><ns1:mtd columnalign="left"><ns1:mrow><ns1:mo>{</ns1:mo><ns1:mtable><ns1:mtr><ns1:mtd columnalign="right"><ns1:mi>y</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mn>3</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>1</ns1:mn></ns1:mtd></ns1:mtr><ns1:mtr><ns1:mtd columnalign="right"><ns1:mn>6</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>2</ns1:mn><ns1:mi>y</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mn>12</ns1:mn></ns1:mtd></ns1:mtr></ns1:mtable></ns1:mrow></ns1:mtd></ns1:mtr><ns1:mtr><ns1:mtd columnalign="left"><ns1:mspace width="3em" /><ns1:mi>y</ns1:mi><ns1:mspace width="0.5em" /><ns1:mo>=</ns1:mo><ns1:mspace width="0.5em" /><ns1:mn>3</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>1</ns1:mn></ns1:mtd></ns1:mtr></ns1:mtable></ns1:mrow></ns1:math></ns0:entry>
</ns0:row>
<ns0:row>
<ns0:entry valign="top">Tuliskan persamaan kedua dalam bentuk gradien–titik potong sumbu y.</ns0:entry>
<ns0:entry><ns1:math><ns1:mspace width="4.5em" /><ns1:mtable><ns1:mtr><ns1:mtd /><ns1:mtd /><ns1:mtd /><ns1:mtd /><ns1:mtd /><ns1:mtd columnalign="right"><ns1:mn>6</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>2</ns1:mn><ns1:mi>y</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mn>12</ns1:mn></ns1:mtd></ns1:mtr><ns1:mtr><ns1:mtd /><ns1:mtd /><ns1:mtd /><ns1:mtd /><ns1:mtd /><ns1:mtd columnalign="right"><ns1:mo>−</ns1:mo><ns1:mn>2</ns1:mn><ns1:mi>y</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mn>−6</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>+</ns1:mo><ns1:mn>12</ns1:mn></ns1:mtd></ns1:mtr><ns1:mtr><ns1:mtd /><ns1:mtd /><ns1:mtd /><ns1:mtd /><ns1:mtd /><ns1:mtd columnalign="right"><ns1:mfrac><ns1:mrow><ns1:mn>−2</ns1:mn><ns1:mi>y</ns1:mi></ns1:mrow><ns1:mrow><ns1:mn>−2</ns1:mn></ns1:mrow></ns1:mfrac></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mfrac><ns1:mrow><ns1:mn>−6</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>+</ns1:mo><ns1:mn>12</ns1:mn></ns1:mrow><ns1:mrow><ns1:mn>−2</ns1:mn></ns1:mrow></ns1:mfrac></ns1:mtd></ns1:mtr><ns1:mtr><ns1:mtd /><ns1:mtd /><ns1:mtd /><ns1:mtd /><ns1:mtd /><ns1:mtd columnalign="right"><ns1:mi>y</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mn>3</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>6</ns1:mn></ns1:mtd></ns1:mtr></ns1:mtable></ns1:math></ns0:entry>
</ns0:row>
<ns0:row>
<ns0:entry valign="top">Tentukan gradien dan titik potong setiap garis.</ns0:entry>
<ns0:entry><ns1:math><ns1:mtable><ns1:mtr><ns1:mtd columnalign="right"><ns1:mi>y</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mn>3</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>1</ns1:mn></ns1:mtd><ns1:mtd columnalign="right"><ns1:mspace width="3.2em" /><ns1:mi>y</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mn>3</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>6</ns1:mn></ns1:mtd></ns1:mtr><ns1:mtr><ns1:mtd columnalign="right"><ns1:mi>m</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mn>3</ns1:mn></ns1:mtd><ns1:mtd columnalign="right"><ns1:mspace width="3.2em" /><ns1:mi>m</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mn>3</ns1:mn></ns1:mtd></ns1:mtr><ns1:mtr><ns1:mtd columnalign="right"><ns1:mi>b</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mn>−1</ns1:mn></ns1:mtd><ns1:mtd columnalign="right"><ns1:mspace width="3.2em" /><ns1:mi>b</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mn>−6</ns1:mn></ns1:mtd></ns1:mtr></ns1:mtable></ns1:math></ns0:entry>
</ns0:row>
<ns0:row>
<ns0:entry />
<ns0:entry>Karena gradien kedua garis sama, tetapi titik potong sumbu <ns0:emphasis effect="italics">y</ns0:emphasis>berbeda, kedua garis sejajar.</ns0:entry>
</ns0:row>
</ns0:tbody>
</ns0:tgroup>
</ns0:table>
<ns0:para id="fs-id1167834367141">Sistem persamaan yang grafiknya berupa garis-garis sejajar tidak memiliki solusi serta merupakan sistem tidak konsisten dan independen.</ns0:para>
<ns0:para id="fs-id1167826995612"><ns0:span class="token">ⓑ</ns0:span> Kita akan membandingkan gradien dan titik potong kedua garis.</ns0:para>
<ns0:table id="fs-idm341515088" class="unnumbered unstyled" summary="Tabel memperagakan langkah demi langkah penyelesaian sistem persamaan linear dengan mengubah kedua persamaan ke bentuk gradien–titik potong sumbu y dan membandingkan gradiennya.">
<ns0:label />
<ns0:tgroup cols="2">
<ns0:colspec colnum="1" colname="c1" />
<ns0:colspec colnum="2" colname="c2" />
<ns0:tbody>
<ns0:row>
<ns0:entry />
<ns0:entry><ns1:math><ns1:mrow><ns1:mtable><ns1:mtr><ns1:mtd columnalign="left"><ns1:mrow><ns1:mo>{</ns1:mo><ns1:mtable><ns1:mtr><ns1:mtd columnalign="right"><ns1:mn>2</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>+</ns1:mo><ns1:mi>y</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mn>−3</ns1:mn></ns1:mtd></ns1:mtr><ns1:mtr><ns1:mtd columnalign="right"><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>5</ns1:mn><ns1:mi>y</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mn>5</ns1:mn></ns1:mtd></ns1:mtr></ns1:mtable></ns1:mrow></ns1:mtd></ns1:mtr></ns1:mtable></ns1:mrow></ns1:math></ns0:entry>
</ns0:row>
<ns0:row>
<ns0:entry>Tuliskan kedua persamaan dalam bentuk gradien–titik potong sumbu y.</ns0:entry>
<ns0:entry><ns1:math><ns1:mrow><ns1:mspace width="1em" /><ns1:mtable><ns1:mtr><ns1:mtd columnalign="right"><ns1:mn>2</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>+</ns1:mo><ns1:mi>y</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>−</ns1:mo><ns1:mn>3</ns1:mn></ns1:mtd><ns1:mtd /><ns1:mtd /><ns1:mtd columnalign="right"><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>5</ns1:mn><ns1:mi>y</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mn>5</ns1:mn></ns1:mtd></ns1:mtr><ns1:mtr><ns1:mtd columnalign="right"><ns1:mi>y</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mn>−2</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>3</ns1:mn></ns1:mtd><ns1:mtd /><ns1:mtd /><ns1:mtd columnalign="right"><ns1:mn>−5</ns1:mn><ns1:mi>y</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mtext>−</ns1:mtext><ns1:mi>x</ns1:mi><ns1:mo>+</ns1:mo><ns1:mn>5</ns1:mn></ns1:mtd></ns1:mtr><ns1:mtr><ns1:mtd /><ns1:mtd /><ns1:mtd /><ns1:mtd /><ns1:mtd /><ns1:mtd columnalign="right"><ns1:mfrac><ns1:mrow><ns1:mo>−</ns1:mo><ns1:mn>5</ns1:mn><ns1:mi>y</ns1:mi></ns1:mrow><ns1:mrow><ns1:mo>−</ns1:mo><ns1:mn>5</ns1:mn></ns1:mrow></ns1:mfrac></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mfrac><ns1:mrow><ns1:mo>−</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>+</ns1:mo><ns1:mn>5</ns1:mn></ns1:mrow><ns1:mrow><ns1:mo>−</ns1:mo><ns1:mn>5</ns1:mn></ns1:mrow></ns1:mfrac></ns1:mtd></ns1:mtr><ns1:mtr><ns1:mtd /><ns1:mtd /><ns1:mtd /><ns1:mtd /><ns1:mtd /><ns1:mtd columnalign="right"><ns1:mi>y</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mfrac><ns1:mn>1</ns1:mn><ns1:mn>5</ns1:mn></ns1:mfrac><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>1</ns1:mn></ns1:mtd></ns1:mtr></ns1:mtable></ns1:mrow></ns1:math></ns0:entry>
</ns0:row>
<ns0:row>
<ns0:entry>Tentukan gradien dan titik potong setiap garis.</ns0:entry>
<ns0:entry><ns1:math><ns1:mrow><ns1:mspace width="2.5em" /><ns1:mtable><ns1:mtr><ns1:mtd columnalign="right"><ns1:mi>y</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>−</ns1:mo><ns1:mn>2</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>3</ns1:mn></ns1:mtd><ns1:mtd columnalign="right"><ns1:mspace width="3.8em" /><ns1:mi>y</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mfrac><ns1:mn>1</ns1:mn><ns1:mn>5</ns1:mn></ns1:mfrac><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>1</ns1:mn></ns1:mtd></ns1:mtr><ns1:mtr><ns1:mtd columnalign="right"><ns1:mi>m</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>−</ns1:mo><ns1:mn>2</ns1:mn></ns1:mtd><ns1:mtd columnalign="right"><ns1:mspace width="3.8em" /><ns1:mi>m</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mfrac><ns1:mn>1</ns1:mn><ns1:mn>5</ns1:mn></ns1:mfrac></ns1:mtd></ns1:mtr><ns1:mtr><ns1:mtd columnalign="right"><ns1:mi>b</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mn>−3</ns1:mn></ns1:mtd><ns1:mtd columnalign="right"><ns1:mspace width="3.8em" /><ns1:mi>b</ns1:mi></ns1:mtd><ns1:mtd columnalign="left"><ns1:mo>=</ns1:mo></ns1:mtd><ns1:mtd columnalign="left"><ns1:mn>−1</ns1:mn></ns1:mtd></ns1:mtr></ns1:mtable></ns1:mrow></ns1:math></ns0:entry>
</ns0:row>
<ns0:row>
<ns0:entry />
<ns0:entry>Karena gradiennya berbeda, kedua garis berpotongan.</ns0:entry>
</ns0:row>
</ns0:tbody>
</ns0:tgroup>
</ns0:table>
<ns0:para id="fs-id1167835419049">Sistem persamaan yang grafiknya berpotongan memiliki satu solusi serta merupakan sistem konsisten dan independen.</ns0:para>
</ns0:solution>
</ns0:exercise>
</ns0:example>
