<?xml version='1.0' encoding='utf-8'?>
<ns0:exercise xmlns:ns0="http://cnx.rice.edu/cnxml" xmlns:ns1="http://www.w3.org/1998/Math/MathML" id="fs-id1167833379473" class="material-set-2">
<ns0:problem id="fs-id1167833379475">
<ns0:para id="fs-id1167836622804">Determine whether each ordered pair is a solution to the inequality <ns1:math><ns1:mrow><ns1:mi>x</ns1:mi><ns1:mo>+</ns1:mo><ns1:mi>y</ns1:mi><ns1:mo>&gt;</ns1:mo><ns1:mn>4</ns1:mn><ns1:mtext>:</ns1:mtext></ns1:mrow></ns1:math></ns0:para>
<ns0:para id="fs-id1167836792019"><ns0:span class="token">ⓐ</ns0:span> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>6</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>1</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow></ns1:mrow></ns1:math> <ns0:span class="token">ⓑ</ns0:span> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>−3</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>6</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow></ns1:mrow></ns1:math> <ns0:span class="token">ⓒ</ns0:span> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>3</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>2</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow></ns1:mrow></ns1:math> <ns0:span class="token">ⓓ</ns0:span> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>−5</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>10</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow></ns1:mrow></ns1:math> <ns0:span class="token">ⓔ</ns0:span> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>0</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow></ns1:mrow></ns1:math></ns0:para>
</ns0:problem>
<ns0:solution id="fs-id1167836621307">
<ns0:para id="fs-id1167836621309"><ns0:span class="token">ⓐ</ns0:span> yes <ns0:span class="token">ⓑ</ns0:span> no <ns0:span class="token">ⓒ</ns0:span> yes <ns0:span class="token">ⓓ</ns0:span> yes; <ns0:span class="token">ⓔ</ns0:span> no</ns0:para>
</ns0:solution>
</ns0:exercise>
