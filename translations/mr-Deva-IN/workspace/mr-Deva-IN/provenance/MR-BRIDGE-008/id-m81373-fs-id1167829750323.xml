<ns0:note xmlns:ns0="http://cnx.rice.edu/cnxml" xmlns:ns1="http://www.w3.org/1998/Math/MathML" id="fs-id1167829750323" class="try">
<ns0:exercise id="fs-id1167829850985">
<ns0:problem id="fs-id1167829879283">
<ns0:para id="fs-id1167824773962">Gunakan grafik relasi untuk <ns0:span class="token">ⓐ</ns0:span> mencantumkan pasangan berurutan relasi <ns0:span class="token">ⓑ</ns0:span> menentukan domain relasi <ns0:span class="token">ⓒ</ns0:span> menentukan range relasi.</ns0:para>
<ns0:media id="fs-id1167836341066" alt="Grafik menampilkan enam titik pada bidang koordinat xy dengan kedua sumbu dari negatif 6 hingga 6: (negatif 3, 3), (negatif 2, 2), (negatif 1, 0), (0, negatif 1), (2, negatif 2), dan (4, negatif 4).">
<ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_05_005_img_new.jpg" />
</ns0:media>
</ns0:problem>
<ns0:solution id="fs-id1167836419079">
<ns0:para id="fs-id1167833051815"><ns0:span class="token">ⓐ</ns0:span> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>−3</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>3</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>−2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>2</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>−1</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo></ns1:mrow></ns1:math><ns0:newline /><ns1:math><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>0</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>−1</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>−2</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>4</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>−4</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow></ns1:math><ns0:newline /><ns0:span class="token">ⓑ</ns0:span> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>{</ns1:mo><ns1:mrow><ns1:mn>−3</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>−2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>−1</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>4</ns1:mn></ns1:mrow><ns1:mo>}</ns1:mo></ns1:mrow></ns1:mrow></ns1:math><ns0:newline /><ns0:span class="token">ⓒ</ns0:span> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>{</ns1:mo><ns1:mrow><ns1:mn>3</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>−1</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>−2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>−4</ns1:mn></ns1:mrow><ns1:mo>}</ns1:mo></ns1:mrow></ns1:mrow></ns1:math></ns0:para>
</ns0:solution>
</ns0:exercise>
</ns0:note>
