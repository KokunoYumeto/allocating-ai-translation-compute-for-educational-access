<ns0:note xmlns:ns0="http://cnx.rice.edu/cnxml" xmlns:ns1="http://www.w3.org/1998/Math/MathML" id="fs-id1167829738598" class="try">
<ns0:exercise id="fs-id1167833056928">
<ns0:problem id="fs-id1167836485775">
<ns0:para id="fs-id1167833050002">Gunakan grafik relasi untuk <ns0:span class="token">ⓐ</ns0:span> mencantumkan pasangan berurutan relasi <ns0:span class="token">ⓑ</ns0:span> menentukan domain relasi <ns0:span class="token">ⓒ</ns0:span> menentukan range relasi.</ns0:para>
<ns0:media id="fs-id1167833049956" alt="Grafik menampilkan enam titik pada bidang koordinat xy dengan kedua sumbu dari negatif 6 hingga 6: (negatif 3, 5), (negatif 3, 0), (negatif 3, negatif 6), (negatif 1, negatif 2), (1, 2), dan (4, negatif 4).">
<ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_05_006_img_new.jpg" />
</ns0:media>
</ns0:problem>
<ns0:solution id="fs-id1167833021407">
<ns0:para id="fs-id1167836503993"><ns0:span class="token">ⓐ</ns0:span> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>−3</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>−3</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>5</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>−3</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>−6</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo></ns1:mrow></ns1:math><ns0:newline /><ns1:math><ns1:mrow><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>−1</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>−2</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>1</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>2</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>4</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>−4</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow></ns1:mrow></ns1:math><ns0:newline /><ns0:span class="token">ⓑ</ns0:span> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>{</ns1:mo><ns1:mrow><ns1:mn>−3</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>−1</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>1</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>4</ns1:mn></ns1:mrow><ns1:mo>}</ns1:mo></ns1:mrow></ns1:mrow></ns1:math><ns0:newline /><ns0:span class="token">ⓒ</ns0:span> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>{</ns1:mo><ns1:mrow><ns1:mn>−6</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>5</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>−2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>−4</ns1:mn></ns1:mrow><ns1:mo>}</ns1:mo></ns1:mrow></ns1:mrow></ns1:math></ns0:para>
</ns0:solution>
</ns0:exercise>
</ns0:note>
