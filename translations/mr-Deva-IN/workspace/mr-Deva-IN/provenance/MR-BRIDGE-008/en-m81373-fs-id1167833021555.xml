<ns0:problem id="fs-id1167829614386">
<ns0:para id="fs-id1167836360520">For the relation <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>{</ns1:mo><ns1:mrow><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>1</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>3</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>6</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>3</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>9</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>4</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>12</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>5</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>15</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow></ns1:mrow><ns1:mo>}</ns1:mo></ns1:mrow><ns1:mo>:</ns1:mo></ns1:mrow></ns1:math></ns0:para>
<ns0:para id="fs-id1167833290815"><ns0:span class="token">ⓐ</ns0:span> Find the domain of the relation.</ns0:para>
<ns0:para id="fs-id1167825702514"><ns0:span class="token">ⓑ</ns0:span> Find the range of the relation.</ns0:para>
</ns0:problem>
<ns0:solution id="fs-id1167829812976">
<ns0:para id="fs-id1167833346148"><ns0:span class="token">ⓐ</ns0:span> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>{</ns1:mo><ns1:mrow><ns1:mn>1</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>3</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>4</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>5</ns1:mn></ns1:mrow><ns1:mo>}</ns1:mo></ns1:mrow></ns1:mrow></ns1:math><ns0:newline /><ns0:span class="token">ⓑ</ns0:span> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>{</ns1:mo><ns1:mrow><ns1:mn>3</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>6</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>9</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>12</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>15</ns1:mn></ns1:mrow><ns1:mo>}</ns1:mo></ns1:mrow></ns1:mrow></ns1:math></ns0:para>
</ns0:solution>
</ns0:exercise>
