<?xml version='1.0' encoding='utf-8'?>
<ns0:section xmlns:ns0="http://cnx.rice.edu/cnxml" xmlns:ns1="http://www.w3.org/1998/Math/MathML" id="fs-id1167829711772" class="key-concepts">
<ns0:title>Key Concepts</ns0:title>
<ns0:list id="fs-id1167836294674" list-type="bulleted" bullet-style="bullet">
<ns0:item><ns0:emphasis effect="bold">Function Notation:</ns0:emphasis> For the function <ns1:math><ns1:mrow><ns1:mi>y</ns1:mi><ns1:mo>=</ns1:mo><ns1:mi>f</ns1:mi><ns1:mo stretchy="false">(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo stretchy="false">)</ns1:mo></ns1:mrow></ns1:math>
<ns0:list id="fs-id1167829810537" list-type="bulleted" bullet-style="open-circle">
<ns0:item><ns0:emphasis effect="italics">f</ns0:emphasis> is the name of the function</ns0:item>
<ns0:item><ns0:emphasis effect="italics">x</ns0:emphasis> is the domain value</ns0:item>
<ns0:item><ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mo stretchy="false">(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo stretchy="false">)</ns1:mo></ns1:mrow></ns1:math> is the range value <ns0:emphasis effect="italics">y</ns0:emphasis> corresponding to the value <ns0:emphasis effect="italics">x</ns0:emphasis><ns0:newline />
We read <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mo stretchy="false">(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo stretchy="false">)</ns1:mo></ns1:mrow></ns1:math> as <ns0:emphasis effect="italics">f</ns0:emphasis> of <ns0:emphasis effect="italics">x</ns0:emphasis> or the value of <ns0:emphasis effect="italics">f</ns0:emphasis> at <ns0:emphasis effect="italics">x</ns0:emphasis>.</ns0:item></ns0:list></ns0:item>
<ns0:item><ns0:emphasis effect="bold">Independent and Dependent Variables:</ns0:emphasis> For the function <ns1:math><ns1:mrow><ns1:mi>y</ns1:mi><ns1:mo>=</ns1:mo><ns1:mi>f</ns1:mi><ns1:mo stretchy="false">(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo stretchy="false">)</ns1:mo><ns1:mo>,</ns1:mo></ns1:mrow></ns1:math>
<ns0:list id="fs-id1167836715045" list-type="bulleted" bullet-style="open-circle">
<ns0:item><ns0:emphasis effect="italics">x</ns0:emphasis> is the independent variable as it can be any value in the domain</ns0:item>
<ns0:item><ns0:emphasis effect="italics">y</ns0:emphasis> is the dependent variable as its value depends on <ns0:emphasis effect="italics">x</ns0:emphasis></ns0:item>
</ns0:list></ns0:item>
</ns0:list>
</ns0:section>
