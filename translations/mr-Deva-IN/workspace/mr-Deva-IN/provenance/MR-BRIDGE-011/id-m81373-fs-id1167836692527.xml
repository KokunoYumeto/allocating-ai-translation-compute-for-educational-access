<ns0:example xmlns:ns0="http://cnx.rice.edu/cnxml" xmlns:ns1="http://www.w3.org/1998/Math/MathML" id="fs-id1167836692527">
<ns0:exercise id="fs-id1167836327016">
<ns0:problem id="fs-id1167833385954">
<ns0:para id="fs-id1167826194732">Untuk relasi <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>{</ns1:mo><ns1:mrow><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>1</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>1</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>4</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>3</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>9</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>4</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>16</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>5</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>25</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow></ns1:mrow><ns1:mo>}</ns1:mo></ns1:mrow><ns1:mo>:</ns1:mo></ns1:mrow></ns1:math></ns0:para>
<ns0:para id="fs-id1167836619755"><ns0:span class="token">ⓐ</ns0:span> Tentukan domain relasi tersebut.</ns0:para>
<ns0:para id="fs-id1167833356505"><ns0:span class="token">ⓑ</ns0:span> Tentukan range relasi tersebut.</ns0:para>
</ns0:problem>
<ns0:solution id="fs-id1167824765140">
<ns0:para id="fs-id1167836597346"><ns1:math><ns1:mrow><ns1:mspace width="21em" /><ns1:mrow><ns1:mo>{</ns1:mo><ns1:mrow><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>1</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>1</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>4</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>3</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>9</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>4</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>16</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>5</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>25</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow></ns1:mrow><ns1:mo>}</ns1:mo></ns1:mrow></ns1:mrow></ns1:math></ns0:para>
<ns0:para id="fs-id1167829691118"><ns0:span class="token">ⓐ</ns0:span> Domain adalah himpunan semua nilai <ns0:emphasis effect="italics">x</ns0:emphasis> dari relasi tersebut. <ns1:math><ns1:mrow><ns1:mspace width="3.3em" /><ns1:mrow><ns1:mo>{</ns1:mo><ns1:mrow><ns1:mn>1</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>3</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>4</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>5</ns1:mn></ns1:mrow><ns1:mo>}</ns1:mo></ns1:mrow></ns1:mrow></ns1:math></ns0:para>
<ns0:para id="fs-id1167829593929"><ns0:span class="token">ⓑ</ns0:span> Range adalah himpunan semua nilai <ns0:emphasis effect="italics">y</ns0:emphasis> dari relasi tersebut. <ns1:math><ns1:mrow><ns1:mspace width="4em" /><ns1:mrow><ns1:mo>{</ns1:mo><ns1:mrow><ns1:mn>1</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>4</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>9</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>16</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>25</ns1:mn></ns1:mrow><ns1:mo>}</ns1:mo></ns1:mrow></ns1:mrow></ns1:math></ns0:para>
</ns0:solution>
</ns0:exercise>
</ns0:example>
