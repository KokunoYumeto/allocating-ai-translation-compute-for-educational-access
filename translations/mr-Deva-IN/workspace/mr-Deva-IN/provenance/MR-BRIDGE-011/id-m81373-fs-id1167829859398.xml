<?xml version='1.0' encoding='utf-8'?>
<ns0:example xmlns:ns0="http://cnx.rice.edu/cnxml" xmlns:ns1="http://www.w3.org/1998/Math/MathML" id="fs-id1167829859398">
<ns0:exercise id="fs-id1167833137652">
<ns0:problem id="fs-id1167836619820">
<ns0:para id="fs-id1167836619822">Untuk fungsi <ns1:math><ns1:mrow><ns1:mi>g</ns1:mi><ns1:mo stretchy="false">(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo stretchy="false">)</ns1:mo><ns1:mo>=</ns1:mo><ns1:mn>3</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>5</ns1:mn><ns1:mo>,</ns1:mo></ns1:mrow></ns1:math> hitung nilai fungsi tersebut.</ns0:para>
<ns0:para id="fs-id1167836320931"><ns0:span class="token">ⓐ</ns0:span> <ns1:math><ns1:mrow><ns1:mi>g</ns1:mi><ns1:mo stretchy="false">(</ns1:mo><ns1:msup><ns1:mi>h</ns1:mi><ns1:mn>2</ns1:mn></ns1:msup><ns1:mo stretchy="false">)</ns1:mo></ns1:mrow></ns1:math> <ns0:span class="token">ⓑ</ns0:span> <ns1:math><ns1:mrow><ns1:mi>g</ns1:mi><ns1:mo stretchy="false">(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>+</ns1:mo><ns1:mn>2</ns1:mn><ns1:mo stretchy="false">)</ns1:mo></ns1:mrow></ns1:math> <ns0:span class="token">ⓒ</ns0:span> <ns1:math><ns1:mrow><ns1:mi>g</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>+</ns1:mo><ns1:mi>g</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mn>2</ns1:mn><ns1:mo>)</ns1:mo></ns1:mrow></ns1:mrow></ns1:math></ns0:para>
</ns0:problem>
<ns0:solution id="fs-id1167833397154">
<ns0:para id="fs-id1167836754871"><ns0:span class="token">ⓐ</ns0:span> <ns0:newline />
<ns0:table id="fs-id1171790386499" class="unnumbered unstyled" aria-label="g dari x sama dengan 3x dikurangi 5. Untuk menghitung g dari h kuadrat, substitusikan h kuadrat untuk x. g dari h kuadrat sama dengan 3 kali h kuadrat dikurangi 5, atau 3h kuadrat dikurangi 5.">
<ns0:label />
<ns0:tgroup cols="2">
<ns0:colspec colnum="1" colname="c1" />
<ns0:colspec colnum="2" colname="c2" />
<ns0:tbody>
<ns0:row>
<ns0:entry />
<ns0:entry />
<ns0:entry />
<ns0:entry valign="top" align="left"><ns0:media id="fs-id1171792580809" alt="Fungsi linear g dari x sama dengan 3x dikurangi 5 ditampilkan pada latar putih."><ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_05_018a_img_new.jpg" /></ns0:media></ns0:entry>
</ns0:row>
<ns0:row>
<ns0:entry valign="top" align="left">Untuk menghitung <ns1:math><ns1:mrow><ns1:mi>g</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:msup><ns1:mi>h</ns1:mi><ns1:mn>2</ns1:mn></ns1:msup><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo></ns1:mrow></ns1:math> substitusikan <ns1:math><ns1:mrow><ns1:msup><ns1:mi>h</ns1:mi><ns1:mn>2</ns1:mn></ns1:msup></ns1:mrow></ns1:math> untuk <ns0:emphasis effect="italics">x</ns0:emphasis>.</ns0:entry>
<ns0:entry />
<ns0:entry />
<ns0:entry valign="top" align="left"><ns0:media id="fs-id1171790163372" alt="Persamaan g dari h kuadrat sama dengan 3h kuadrat dikurangi 5 ditampilkan; variabel h disorot merah."><ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_05_018b_img_new.jpg" /></ns0:media></ns0:entry>
</ns0:row>
<ns0:row>
<ns0:entry />
<ns0:entry />
<ns0:entry />
<ns0:entry valign="top" align="left"><ns0:media id="fs-id1171792588637" alt="Persamaan g dari h kuadrat sama dengan 3h kuadrat dikurangi 5 ditampilkan; masukan fungsi dan variabel dalam bentuknya sama-sama h kuadrat."><ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_05_018c_img_new.jpg" /></ns0:media></ns0:entry>
</ns0:row>
</ns0:tbody>
</ns0:tgroup>
</ns0:table></ns0:para>
<ns0:para id="fs-id1167836556251"><ns0:span class="token">ⓑ</ns0:span> <ns0:newline />
<ns0:table id="fs-id1171792580965" class="unnumbered unstyled" aria-label="g dari x sama dengan 3x dikurangi 5. Untuk menghitung g dari x ditambah 2, substitusikan x ditambah 2 untuk x. g dari x ditambah 2 sama dengan 3 kali besaran x ditambah 2 dalam tanda kurung dikurangi 5. Setelah disederhanakan, hasilnya 3x ditambah 6 dikurangi 5, lalu 3x ditambah 1.">
<ns0:label />
<ns0:tgroup cols="2">
<ns0:colspec colnum="1" colname="c1" />
<ns0:colspec colnum="2" colname="c2" />
<ns0:tbody>
<ns0:row>
<ns0:entry />
<ns0:entry valign="top" align="left"><ns0:media id="fs-id1171792545190" alt="Fungsi linear g dari x sama dengan 3x dikurangi 5 ditampilkan dengan teks hitam pada latar putih."><ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_05_019a_img_new.jpg" /></ns0:media></ns0:entry>
</ns0:row>
<ns0:row>
<ns0:entry valign="top" align="left">Untuk menghitung <ns1:math><ns1:mrow><ns1:mi>g</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>+</ns1:mo><ns1:mn>2</ns1:mn><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo></ns1:mrow></ns1:math> substitusikan <ns1:math><ns1:mrow><ns1:mi>x</ns1:mi><ns1:mo>+</ns1:mo><ns1:mn>2</ns1:mn></ns1:mrow></ns1:math> untuk <ns0:emphasis effect="italics">x</ns0:emphasis>.</ns0:entry>
<ns0:entry valign="top" align="left"><ns0:media id="fs-id1171792543055" alt="Persamaan g dari x ditambah 2 sama dengan 3 kali besaran x ditambah 2 dalam tanda kurung dikurangi 5 ditampilkan; masukan x diganti dengan x ditambah 2."><ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_05_019b_img_new.jpg" /></ns0:media></ns0:entry>
</ns0:row>
<ns0:row>
<ns0:entry valign="top" align="left">Sederhanakan.</ns0:entry>
<ns0:entry valign="top" align="left"><ns0:media id="fs-id1171792802121" alt="Persamaan g dari x ditambah 2 sama dengan 3x ditambah 6 dikurangi 5 ditampilkan pada latar putih."><ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_05_019c_img_new.jpg" /></ns0:media></ns0:entry>
</ns0:row>
<ns0:row>
<ns0:entry />
<ns0:entry valign="top" align="left"><ns0:media id="fs-id1171790304229" alt="Persamaan g dari x ditambah 2 sama dengan 3x ditambah 1 ditampilkan pada latar putih."><ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_05_019d_img_new.jpg" /></ns0:media></ns0:entry>
</ns0:row>
</ns0:tbody>
</ns0:tgroup>
</ns0:table></ns0:para>
<ns0:para id="fs-id1167836448921"><ns0:span class="token">ⓒ</ns0:span> <ns0:newline />
<ns0:table id="fs-id1167836606104" class="unnumbered unstyled" aria-label="g dari x sama dengan 3x dikurangi 5. Untuk menghitung g dari x ditambah g dari 2, tentukan dahulu g dari 2. g dari 2 sama dengan 3 kali 2 dikurangi 5, yaitu 1. Kemudian, g dari x ditambah g dari 2 sama dengan 3x dikurangi 5 ditambah 1. Bagian 3x dikurangi 5 berasal dari g dari x dan 1 berasal dari g dari 2. Setelah disederhanakan, hasilnya 3x dikurangi 4.">
<ns0:label />
<ns0:tgroup cols="2">
<ns0:colspec colnum="1" colname="c1" />
<ns0:colspec colnum="2" colname="c2" />
<ns0:tbody>
<ns0:row>
<ns0:entry />
<ns0:entry />
<ns0:entry valign="top" align="left"><ns0:media id="fs-id1167829839522" alt="Fungsi g dari x sama dengan 3x dikurangi 5 ditampilkan.">
<ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_05_020b_img.jpg" />
</ns0:media>
</ns0:entry>
</ns0:row>
<ns0:row>
<ns0:entry valign="top" align="left">Untuk menghitung <ns1:math><ns1:mrow><ns1:mi>g</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>+</ns1:mo><ns1:mi>g</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mn>2</ns1:mn><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo></ns1:mrow></ns1:math> tentukan terlebih dahulu <ns1:math><ns1:mrow><ns1:mi>g</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mn>2</ns1:mn><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>.</ns1:mo></ns1:mrow></ns1:math></ns0:entry>
<ns0:entry />
<ns0:entry valign="top" align="left"><ns0:media id="fs-id1167836635207" alt="Persamaan g dari 2 sama dengan 3 kali 2 dikurangi 5 ditampilkan; angka 2 disorot merah pada kedua tempat.">
<ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_05_020c_img.jpg" />
</ns0:media>
</ns0:entry>
</ns0:row>
<ns0:row>
<ns0:entry />
<ns0:entry />
<ns0:entry valign="top" align="left"><ns0:media id="fs-id1167829685715" alt="Persamaan g dari 2 sama dengan 1 ditampilkan pada latar putih.">
<ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_05_020d_img.jpg" />
</ns0:media>
</ns0:entry>
</ns0:row>
<ns0:row>
<ns0:entry valign="top" align="left"><ns0:media id="fs-id1167836693279" alt="Instruksi berbunyi: “Sekarang tentukan g(x) + g(2).”">
<ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_05_020a_img.jpg" />
</ns0:media>
</ns0:entry>
<ns0:entry />
<ns0:entry valign="top" align="left"><ns0:media id="fs-id1167836322927" alt="Persamaan g(x) + g(2) = 3x − 5 + 1 ditampilkan; kurung kurawal bawah biru menandai 3x − 5 sebagai g(x) dan 1 sebagai g(2).">
<ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_05_020e_img.jpg" />
</ns0:media>
</ns0:entry>
</ns0:row>
<ns0:row>
<ns0:entry valign="top" align="left">Sederhanakan.</ns0:entry>
<ns0:entry />
<ns0:entry valign="top" align="left"><ns0:media id="fs-id1167824734809" alt="Persamaan g(x) + g(2) = 3x − 5 + 1 ditampilkan dengan teks hitam pada latar putih.">
<ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_05_020f_img.jpg" />
</ns0:media>
</ns0:entry>
</ns0:row>
<ns0:row>
<ns0:entry />
<ns0:entry />
<ns0:entry valign="top" align="left"><ns0:media id="fs-id1167836539801" alt="Persamaan g(x) + g(2) = 3x − 4 ditampilkan dengan teks hitam pada latar putih.">
<ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_05_020g_img.jpg" />
</ns0:media>
</ns0:entry>
</ns0:row>
</ns0:tbody>
</ns0:tgroup>
</ns0:table></ns0:para>
<ns0:para id="fs-id1167832981642">Perhatikan perbedaan antara bagian <ns0:span class="token">ⓑ</ns0:span> dan <ns0:span class="token">ⓒ</ns0:span>. Kita memperoleh <ns1:math><ns1:mrow><ns1:mi>g</ns1:mi><ns1:mo stretchy="false">(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>+</ns1:mo><ns1:mn>2</ns1:mn><ns1:mo stretchy="false">)</ns1:mo><ns1:mo>=</ns1:mo><ns1:mn>3</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>+</ns1:mo><ns1:mn>1</ns1:mn></ns1:mrow></ns1:math> dan <ns1:math><ns1:mrow><ns1:mi>g</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>+</ns1:mo><ns1:mi>g</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mn>2</ns1:mn><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>=</ns1:mo><ns1:mn>3</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>4</ns1:mn><ns1:mo>.</ns1:mo></ns1:mrow></ns1:math> Jadi, terlihat bahwa <ns1:math><ns1:mrow><ns1:mi>g</ns1:mi><ns1:mo stretchy="false">(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>+</ns1:mo><ns1:mn>2</ns1:mn><ns1:mo stretchy="false">)</ns1:mo><ns1:mo>≠</ns1:mo><ns1:mi>g</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>+</ns1:mo><ns1:mi>g</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mn>2</ns1:mn><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>.</ns1:mo></ns1:mrow></ns1:math></ns0:para>
</ns0:solution>
</ns0:exercise>
</ns0:example>

