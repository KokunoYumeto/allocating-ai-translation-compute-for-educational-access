<ns0:para id="fs-id1167833060073">Use the set of ordered pairs to (i) determine whether the relation is a function (ii) find the domain of the relation (iii) find the range of the function.</ns0:para>
<ns0:para id="fs-id1167832951108"><ns0:span class="token">ⓐ</ns0:span> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>{</ns1:mo><ns1:mrow><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>−3</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>−6</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>−2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>−4</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>−1</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>−2</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>0</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>1</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>2</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>4</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>3</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>6</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow></ns1:mrow><ns1:mo>}</ns1:mo></ns1:mrow></ns1:mrow></ns1:math></ns0:para>
<ns0:para id="fs-id1167833380236"><ns0:span class="token">ⓑ</ns0:span> <ns1:math><ns1:mrow><ns1:mrow><ns1:mo>{</ns1:mo><ns1:mrow><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>8</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>−4</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>4</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>−2</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>−1</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>0</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>1</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>4</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>2</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mn>8</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>4</ns1:mn></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow></ns1:mrow><ns1:mo>}</ns1:mo></ns1:mrow></ns1:mrow></ns1:math></ns0:para>
</ns0:problem>
<ns0:solution id="fs-id1167836352889">
