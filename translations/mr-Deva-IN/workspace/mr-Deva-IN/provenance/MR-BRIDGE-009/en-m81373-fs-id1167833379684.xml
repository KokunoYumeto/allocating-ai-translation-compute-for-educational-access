</ns0:problem>
<ns0:solution id="fs-id1167829811714">
<ns0:para id="fs-id1167833255910"><ns0:span class="token">ⓐ</ns0:span> yes <ns0:span class="token">ⓑ</ns0:span> no <ns0:span class="token">ⓒ</ns0:span> yes</ns0:para>
