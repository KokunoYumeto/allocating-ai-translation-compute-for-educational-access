<ns0:para id="fs-id1167836730830">Tentukan apakah setiap persamaan merupakan fungsi.</ns0:para>
<ns0:para id="fs-id1167836621950"><ns0:span class="token">ⓐ</ns0:span> <ns1:math><ns1:mrow><ns1:mi>x</ns1:mi><ns1:mo>+</ns1:mo><ns1:msup><ns1:mi>y</ns1:mi><ns1:mn>2</ns1:mn></ns1:msup><ns1:mo>=</ns1:mo><ns1:mn>4</ns1:mn></ns1:mrow></ns1:math> <ns0:span class="token">ⓑ</ns0:span> <ns1:math><ns1:mrow><ns1:mi>y</ns1:mi><ns1:mo>=</ns1:mo><ns1:msup><ns1:mi>x</ns1:mi><ns1:mn>2</ns1:mn></ns1:msup><ns1:mo>−</ns1:mo><ns1:mn>7</ns1:mn></ns1:mrow></ns1:math> <ns0:span class="token">ⓒ</ns0:span> <ns1:math><ns1:mrow><ns1:mi>y</ns1:mi><ns1:mo>=</ns1:mo><ns1:mn>5</ns1:mn><ns1:mi>x</ns1:mi><ns1:mo>−</ns1:mo><ns1:mn>4</ns1:mn></ns1:mrow></ns1:math></ns0:para>
</ns0:problem>
<ns0:solution id="fs-id1167836289689">
<ns0:para id="fs-id1167829859295"><ns0:span class="token">ⓐ</ns0:span> tidak <ns0:span class="token">ⓑ</ns0:span> ya <ns0:span class="token">ⓒ</ns0:span> ya</ns0:para>
</ns0:solution>
