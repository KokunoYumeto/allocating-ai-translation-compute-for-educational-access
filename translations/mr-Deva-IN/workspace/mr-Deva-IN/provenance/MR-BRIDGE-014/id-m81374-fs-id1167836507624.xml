<?xml version='1.0' encoding='utf-8'?>
<ns0:note xmlns:ns0="http://cnx.rice.edu/cnxml" xmlns:ns1="http://www.w3.org/1998/Math/MathML" id="fs-id1167836507624" class="try">
<ns0:exercise id="fs-id1167829685616">
<ns0:problem id="fs-id1167836547928">
<ns0:para id="fs-id1167833007616">Gunakan grafik fungsi untuk menentukan nilai-nilai yang diminta.</ns0:para>
<ns0:media id="fs-id1167836539761" alt="Gambar ini menampilkan garis melengkung bergelombang yang digambarkan pada bidang koordinat x y. Sumbu x membentang dari negatif 2 kali pi hingga 2 kali pi. Sumbu y membentang dari negatif 6 hingga 6. Segmen garis melengkung melewati titik (negatif 2 kali pi, 0), (negatif 3 dibagi 2 kali pi, 2), (negatif pi, 0), (negatif 1 dibagi 2 kali pi, negatif 2), (0, 0), (1 dibagi 2 kali pi, 2), (pi, 0), (3 dibagi 2 kali pi, negatif 2), dan (2 kali pi, 0). Titik (negatif 3 dibagi 2 kali pi, 2) dan (1 dibagi 2 kali pi, 2) adalah titik tertinggi pada grafik. Titik (negatif 1 dibagi 2 kali pi, negatif 2) dan (3 dibagi 2 kali pi, negatif 2) adalah titik terendah pada grafik. Garis ini memanjang ke kiri dan kanan tanpa batas.">
<ns0:image mime-type="image/jpeg" src="../../media/CNX_IntAlg_Figure_03_06_025_img_new.jpg" />
</ns0:media>
<ns0:para id="fs-id1167836418791"><ns0:span class="token">ⓐ</ns0:span> Tentukan <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mn>0</ns1:mn><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>.</ns1:mo></ns1:mrow></ns1:math><ns0:newline />
<ns0:span class="token">ⓑ</ns0:span> Tentukan <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mfrac><ns1:mn>1</ns1:mn><ns1:mn>2</ns1:mn></ns1:mfrac><ns1:mi>π</ns1:mi></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>.</ns1:mo></ns1:mrow></ns1:math><ns0:newline />
<ns0:span class="token">ⓒ</ns0:span> Tentukan <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mo>−</ns1:mo><ns1:mfrac><ns1:mn>3</ns1:mn><ns1:mn>2</ns1:mn></ns1:mfrac><ns1:mi>π</ns1:mi></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>.</ns1:mo></ns1:mrow></ns1:math><ns0:newline />
<ns0:span class="token">ⓓ</ns0:span> Tentukan nilai <ns0:emphasis effect="italics">x</ns0:emphasis> dalam [<ns1:math><ns1:mrow><ns1:mo>-</ns1:mo><ns1:mn>2</ns1:mn><ns1:mi>π</ns1:mi></ns1:mrow><ns1:mo>,</ns1:mo><ns1:mrow><ns1:mn>2</ns1:mn><ns1:mi>π</ns1:mi></ns1:mrow></ns1:math>] ketika <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>=</ns1:mo><ns1:mn>0</ns1:mn><ns1:mo>.</ns1:mo></ns1:mrow></ns1:math><ns0:newline />
<ns0:span class="token">ⓔ</ns0:span> Tentukan titik potong sumbu <ns0:emphasis effect="italics">x</ns0:emphasis>.<ns0:newline />
<ns0:span class="token">ⓕ</ns0:span> Tentukan titik potong sumbu <ns0:emphasis effect="italics">y</ns0:emphasis>.<ns0:newline />
<ns0:span class="token">ⓖ</ns0:span> Tentukan domainnya. Tuliskan dalam notasi interval.<ns0:newline />
<ns0:span class="token">ⓗ</ns0:span> Tentukan range-nya. Tuliskan dalam notasi interval.</ns0:para>
</ns0:problem>
<ns0:solution id="fs-id1167829753187">
<ns0:para id="fs-id1167836550513"><ns0:span class="token">ⓐ</ns0:span> <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mo stretchy="false">(</ns1:mo><ns1:mn>0</ns1:mn><ns1:mo stretchy="false">)</ns1:mo><ns1:mo>=</ns1:mo><ns1:mn>0</ns1:mn></ns1:mrow></ns1:math> <ns0:span class="token">ⓑ</ns0:span> <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mo>=</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mfrac><ns1:mi>π</ns1:mi><ns1:mn>2</ns1:mn></ns1:mfrac></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>=</ns1:mo><ns1:mn>2</ns1:mn></ns1:mrow></ns1:math> <ns0:span class="token">ⓒ</ns0:span> <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mo>=</ns1:mo><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mfrac><ns1:mrow><ns1:mn>−3</ns1:mn><ns1:mi>π</ns1:mi></ns1:mrow><ns1:mn>2</ns1:mn></ns1:mfrac></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow><ns1:mo>=</ns1:mo><ns1:mn>2</ns1:mn></ns1:mrow></ns1:math> <ns0:span class="token">ⓓ</ns0:span> <ns1:math><ns1:mrow><ns1:mi>f</ns1:mi><ns1:mo stretchy="false">(</ns1:mo><ns1:mi>x</ns1:mi><ns1:mo stretchy="false">)</ns1:mo><ns1:mo>=</ns1:mo><ns1:mn>0</ns1:mn></ns1:mrow></ns1:math> untuk <ns1:math><ns1:mrow><ns1:mi>x</ns1:mi><ns1:mo>=</ns1:mo><ns1:mn>−2</ns1:mn><ns1:mi>π</ns1:mi><ns1:mo>,</ns1:mo><ns1:mtext>−</ns1:mtext><ns1:mi>π</ns1:mi><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn><ns1:mo>,</ns1:mo><ns1:mi>π</ns1:mi><ns1:mo>,</ns1:mo><ns1:mn>2</ns1:mn><ns1:mi>π</ns1:mi></ns1:mrow></ns1:math> <ns0:span class="token">ⓔ</ns0:span> <ns1:math><ns1:mrow><ns1:mo stretchy="false">(</ns1:mo><ns1:mn>−2</ns1:mn><ns1:mi>π</ns1:mi><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn><ns1:mo stretchy="false">)</ns1:mo><ns1:mo>,</ns1:mo><ns1:mo stretchy="false">(</ns1:mo><ns1:mtext>−</ns1:mtext><ns1:mi>π</ns1:mi><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn><ns1:mo stretchy="false">)</ns1:mo><ns1:mo>,</ns1:mo><ns1:mo stretchy="false">(</ns1:mo><ns1:mn>0</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn><ns1:mo stretchy="false">)</ns1:mo><ns1:mo>,</ns1:mo><ns1:mo stretchy="false">(</ns1:mo><ns1:mi>π</ns1:mi><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn><ns1:mo stretchy="false">)</ns1:mo><ns1:mo>,</ns1:mo><ns1:mo stretchy="false">(</ns1:mo><ns1:mn>2</ns1:mn><ns1:mi>π</ns1:mi><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn><ns1:mo stretchy="false">)</ns1:mo></ns1:mrow></ns1:math> <ns0:span class="token">ⓕ</ns0:span> <ns1:math><ns1:mrow><ns1:mo stretchy="false">(</ns1:mo><ns1:mn>0</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>0</ns1:mn><ns1:mo stretchy="false">)</ns1:mo></ns1:mrow></ns1:math> <ns0:span class="token">ⓖ</ns0:span> <ns1:math><ns1:mrow><ns1:mo>(</ns1:mo><ns1:mrow><ns1:mo>−</ns1:mo><ns1:mi>∞</ns1:mi><ns1:mo>,</ns1:mo><ns1:mspace width="0.2em" /><ns1:mi>∞</ns1:mi></ns1:mrow><ns1:mo>)</ns1:mo></ns1:mrow></ns1:math> <ns0:span class="token">ⓗ</ns0:span> <ns1:math><ns1:mrow><ns1:mo stretchy="false">[</ns1:mo><ns1:mn>−2</ns1:mn><ns1:mo>,</ns1:mo><ns1:mn>2</ns1:mn><ns1:mo stretchy="false">]</ns1:mo></ns1:mrow></ns1:math></ns0:para>
</ns0:solution>
</ns0:exercise>
</ns0:note>
