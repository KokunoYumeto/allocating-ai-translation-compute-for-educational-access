<glossary xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
<definition id="fs-id1165135445751">
<term>interval notation</term>
<meaning id="fs-id1165135190252">a method of describing a set that includes all numbers between a lower limit and an upper limit; the lower and upper values are listed between brackets or parentheses, a square bracket indicating inclusion in the set, and a parenthesis indicating exclusion</meaning>
</definition>

<definition id="fs-id1165135487256">
<term>piecewise function</term>
<meaning id="fs-id1165137452169">a function in which more than one formula is used to define the output</meaning>
</definition>

<definition id="fs-id1165137863188">
<term>set-builder notation</term>
<meaning id="fs-id1165137863193">a method of describing a set by a rule that all of its members obey; it takes the form <m:math>
 <m:mrow>
  <m:mo>{</m:mo><m:mi>x</m:mi><m:mo>|</m:mo><m:mspace width="0.5em"/><m:mtext>statement about </m:mtext><m:mi>x</m:mi><m:mo>}</m:mo>
 </m:mrow>
</m:math>
</meaning>
</definition>
</glossary>
