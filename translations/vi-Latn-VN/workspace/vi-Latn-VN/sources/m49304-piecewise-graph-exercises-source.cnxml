<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
<content>
<section>
<para id="fs-id1165137785119">For the following exercises, sketch a graph of the piecewise function. Write the domain in interval notation.</para>

<exercise id="fs-id1165137462167">
<problem id="fs-id1165137408525">
<para id="fs-id1165137408527"> <m:math>
 <m:mrow>
  <m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mrow><m:mo>{</m:mo> <m:mrow>
   <m:mtable columnalign="left">
    <m:mtr columnalign="left">
     <m:mtd columnalign="left">
      <m:mrow>
       <m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn>
      </m:mrow>
     </m:mtd>
     <m:mtd columnalign="left">
      <m:mrow>
       <m:mtext>if</m:mtext>
      </m:mrow>
     </m:mtd>
     <m:mtd columnalign="left">
      <m:mrow>
       <m:mi>x</m:mi><m:mo>&lt;</m:mo><m:mo>−</m:mo><m:mn>2</m:mn>
      </m:mrow>
     </m:mtd>
    </m:mtr>
    <m:mtr columnalign="left">
     <m:mtd columnalign="left">
      <m:mrow>
       <m:mo>−</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn>
      </m:mrow>
     </m:mtd>
     <m:mtd columnalign="left">
      <m:mrow>
       <m:mtext>if</m:mtext>
      </m:mrow>
     </m:mtd>
     <m:mtd columnalign="left">
      <m:mrow>
       <m:mi>x</m:mi><m:mo>≥</m:mo><m:mo>−</m:mo><m:mn>2</m:mn>
      </m:mrow>
     </m:mtd>
    </m:mtr>

   </m:mtable>
  </m:mrow> </m:mrow>
 </m:mrow>
</m:math>
</para></problem>
</exercise>

<exercise id="fs-id1165137562309"><problem id="fs-id1165134328320">
<para id="fs-id1165134328322"> <m:math>
<m:mrow>
<m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mrow><m:mo>{</m:mo> <m:mrow>
<m:mtable columnalign="left">
<m:mtr columnalign="left">
<m:mtd columnalign="left">
<m:mrow>
<m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn>
</m:mrow>
</m:mtd>
<m:mtd columnalign="left">
<m:mrow>
<m:mtext>if</m:mtext>
</m:mrow>
</m:mtd>
<m:mtd columnalign="left">
<m:mrow>
<m:mi>x</m:mi><m:mo>&lt;</m:mo><m:mn>1</m:mn>
</m:mrow>
</m:mtd>
</m:mtr>
<m:mtr columnalign="left">
<m:mtd columnalign="left">
<m:mrow>
<m:mn>1</m:mn><m:mo>+</m:mo><m:mi>x</m:mi>
</m:mrow>
</m:mtd>
<m:mtd columnalign="left">
<m:mrow>
<m:mtext>if</m:mtext>
</m:mrow>
</m:mtd>
<m:mtd columnalign="left">
<m:mrow>
<m:mi>x</m:mi><m:mo>≥</m:mo><m:mn>1</m:mn>
</m:mrow>
</m:mtd>
</m:mtr>

</m:mtable>
</m:mrow> </m:mrow>
</m:mrow>
</m:math>
</para></problem>
<solution id="fs-id1165135481131">
<para id="fs-id1165135481133">domain: <m:math>
<m:mrow>
<m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mi>∞</m:mi><m:mo>,</m:mo><m:mi>∞</m:mi><m:mo stretchy="false">)</m:mo></m:mrow>
</m:math>
</para>

<media id="fs-id1165137662700" alt="A graph displays a piecewise function with a jump discontinuity at x=1. The function is defined by a line segment ending with an open circle at (1,1) and another line segment starting with a closed circle at (1,2).">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_02_214.jpg"/>
</media>

</solution>
</exercise><exercise id="fs-id1165137628033">
<problem id="fs-id1165137658060">
<para id="fs-id1165137658062"> <m:math>
<m:mrow>
<m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mrow><m:mo>{</m:mo> <m:mrow>
<m:mtable>
<m:mtr>
<m:mtd>
<m:mrow>
<m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mspace width="0.5em"/><m:mspace width="0.5em"/><m:mtext>if</m:mtext><m:mspace width="0.5em"/><m:mspace width="0.5em"/><m:mi>x</m:mi><m:mo>&lt;</m:mo><m:mn>0</m:mn></m:mrow>
</m:mtd>
</m:mtr>
<m:mtr>
<m:mtd>
<m:mrow>
<m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mspace width="0.5em"/><m:mspace width="0.5em"/><m:mtext>if</m:mtext><m:mspace width="0.5em"/><m:mi>x</m:mi><m:mo>&gt;</m:mo><m:mn>0</m:mn></m:mrow>
</m:mtd>
</m:mtr>

</m:mtable></m:mrow> </m:mrow></m:mrow>
</m:math>
</para>
</problem>
</exercise>
<exercise id="fs-id1165135641679"><problem id="fs-id1165135641681">
<para id="fs-id1165133402089"> <m:math>
<m:mrow>
<m:mi>f</m:mi><m:mrow><m:mo>(</m:mo>
<m:mi>x</m:mi>
<m:mo>)</m:mo></m:mrow><m:mo>=</m:mo><m:mrow><m:mo>{</m:mo> <m:mrow>
<m:mtable>
<m:mtr>
<m:mtd>
<m:mn>3</m:mn>
</m:mtd>
<m:mtd>
<m:mrow>
<m:mtext>if</m:mtext></m:mrow>
</m:mtd>
<m:mtd>
<m:mrow>
<m:mi>x</m:mi><m:mo>&lt;</m:mo><m:mn>0</m:mn></m:mrow>
</m:mtd>
</m:mtr>
<m:mtr>
<m:mtd>
<m:mrow>
<m:msqrt>
<m:mi>x</m:mi>
</m:msqrt>
</m:mrow>
</m:mtd>
<m:mtd>
<m:mrow>
<m:mtext>if</m:mtext></m:mrow>
</m:mtd>
<m:mtd>
<m:mrow>
<m:mi>x</m:mi><m:mo>≥</m:mo><m:mn>0</m:mn></m:mrow>
</m:mtd>
</m:mtr>

</m:mtable></m:mrow> </m:mrow></m:mrow>
</m:math>
</para>
</problem>
<solution id="fs-id1165137500956"><para id="fs-id1165135532432"> domain: <m:math>
<m:mrow>
<m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mi>∞</m:mi><m:mo>,</m:mo><m:mi>∞</m:mi><m:mo stretchy="false">)</m:mo></m:mrow>
</m:math>
</para>

<media id="fs-id1165137474386" alt="Graph of f(x).">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_02_216.jpg"/>
</media>
</solution>
</exercise><exercise id="fs-id1165135192719">
<problem id="fs-id1165135192721">
<para id="fs-id1165137400953"> <m:math>
 <m:mrow>
  <m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mrow><m:mo>{</m:mo> <m:mrow>
   <m:mtable>
    <m:mtr>
     <m:mtd>
      <m:mrow>
       <m:msup>
        <m:mi>x</m:mi>
        <m:mn>2</m:mn>
       </m:msup>
       <m:mtext>      if </m:mtext><m:mi>x</m:mi><m:mo>&lt;</m:mo><m:mn>0</m:mn>
      </m:mrow>
     </m:mtd>
    </m:mtr>
    <m:mtr>
     <m:mtd>
      <m:mrow>
       <m:mn>1</m:mn><m:mo>−</m:mo><m:mi>x</m:mi><m:mtext>  if </m:mtext><m:mi>x</m:mi><m:mo>&gt;</m:mo><m:mn>0</m:mn>
      </m:mrow>
     </m:mtd>
    </m:mtr>

   </m:mtable>
  </m:mrow> </m:mrow>
 </m:mrow>
</m:math>
</para></problem>
</exercise>
<exercise id="fs-id1165137594981"><problem id="fs-id1165135210029">
<para id="fs-id1165135210031"> <m:math>
 <m:mrow>
  <m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mrow><m:mo>{</m:mo> <m:mrow>
   <m:mtable columnalign="right">
    <m:mtr columnalign="right">
     <m:mtd columnalign="right">
      <m:mrow>
       <m:mtable columnalign="right">
        <m:mtr columnalign="right">
         <m:mtd columnalign="right">
          <m:mrow>
           <m:msup>
            <m:mi>x</m:mi>
            <m:mn>2</m:mn>
           </m:msup>

          </m:mrow>
         </m:mtd>
        </m:mtr>
        <m:mtr columnalign="right">
         <m:mtd columnalign="right">
          <m:mrow>
           <m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn>
          </m:mrow>
         </m:mtd>
        </m:mtr>

       </m:mtable>
      </m:mrow>
     </m:mtd>
    </m:mtr>

   </m:mtable>
  </m:mrow> </m:mrow><m:mspace width="0.5em"/><m:mtable columnalign="left">
   <m:mtr columnalign="left">
    <m:mtd columnalign="left">
     <m:mrow>
      <m:mtext>if</m:mtext><m:mspace width="0.5em"/><m:mi>x</m:mi><m:mo>&lt;</m:mo><m:mn>0</m:mn>
     </m:mrow>
    </m:mtd>
   </m:mtr>
   <m:mtr columnalign="left">
    <m:mtd columnalign="left">
     <m:mrow>
      <m:mtext>if</m:mtext><m:mspace width="0.5em"/><m:mi>x</m:mi><m:mo>≥</m:mo><m:mn>0</m:mn>
     </m:mrow>
    </m:mtd>
   </m:mtr>

  </m:mtable>
 </m:mrow>
</m:math>
</para></problem>
<solution id="fs-id1165137667233">
<para id="fs-id1165135382142"> domain: <m:math>
<m:mrow>
<m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mi>∞</m:mi><m:mo>,</m:mo><m:mi>∞</m:mi><m:mo stretchy="false">)</m:mo></m:mrow>
</m:math>
</para>

<media id="fs-id1165135188662" alt="A piecewise graph: a parabola curving left from an open circle at (0,0), and a line segment starting from a closed circle at (0,2) extending right. It illustrates a jump discontinuity.">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_02_218.jpg"/>
</media>

</solution>
</exercise><exercise id="fs-id1165137571389">
<problem id="fs-id1165137433000">
<para id="fs-id1165137433002"> <m:math>
<m:mrow>
<m:mi>f</m:mi><m:mrow><m:mo>(</m:mo>
<m:mi>x</m:mi>
<m:mo>)</m:mo></m:mrow><m:mo>=</m:mo><m:mrow><m:mo>{</m:mo> <m:mrow>
<m:mtable>
<m:mtr>
<m:mtd>
<m:mrow>
<m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow>
</m:mtd>
<m:mtd>
<m:mrow>
<m:mtext>if</m:mtext></m:mrow>
</m:mtd>
<m:mtd>
<m:mrow>
<m:mi>x</m:mi><m:mo>&lt;</m:mo><m:mn>1</m:mn></m:mrow>
</m:mtd>
</m:mtr>
<m:mtr>
<m:mtd>
<m:mrow>
<m:msup>
<m:mi>x</m:mi>
<m:mn>3</m:mn>
</m:msup>
</m:mrow>
</m:mtd>
<m:mtd>
<m:mrow>
<m:mtext>if</m:mtext></m:mrow>
</m:mtd>
<m:mtd>
<m:mrow>
<m:mi>x</m:mi><m:mo>≥</m:mo><m:mn>1</m:mn></m:mrow>
</m:mtd>
</m:mtr>

</m:mtable></m:mrow> </m:mrow></m:mrow>
</m:math>
</para>
</problem>
</exercise>
<exercise id="fs-id1165137407891"><problem id="fs-id1165137554125">
<para id="fs-id1165137554127"> <m:math>
 <m:mrow>
  <m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mrow><m:mo>{</m:mo> <m:mrow>
   <m:mtable>
    <m:mtr>
     <m:mtd>
      <m:mrow>
       <m:mo>|</m:mo><m:mi>x</m:mi><m:mo>|</m:mo>
      </m:mrow>
     </m:mtd>
    </m:mtr>
    <m:mtr>
     <m:mtd>
      <m:mn>1</m:mn>
     </m:mtd>
    </m:mtr>

   </m:mtable>
  </m:mrow> </m:mrow><m:mtable columnalign="left">
   <m:mtr columnalign="left">
    <m:mtd columnalign="left">
     <m:mrow>
      <m:mtext>if</m:mtext><m:mspace width="0.5em"/><m:mi>x</m:mi><m:mo>&lt;</m:mo><m:mn>2</m:mn>
     </m:mrow>
    </m:mtd>
   </m:mtr>
   <m:mtr columnalign="left">
    <m:mtd columnalign="left">
     <m:mrow>
      <m:mtext>if</m:mtext><m:mspace width="0.5em"/><m:mi>x</m:mi><m:mo>≥</m:mo><m:mn>2</m:mn>
     </m:mrow>
    </m:mtd>
   </m:mtr>

  </m:mtable>
 </m:mrow>
</m:math>
</para></problem>
<solution id="fs-id1165137401041">
<para id="fs-id1165134252896">domain: <m:math>
<m:mrow>
<m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mi>∞</m:mi><m:mo>,</m:mo><m:mi>∞</m:mi><m:mo stretchy="false">)</m:mo></m:mrow>
</m:math>
</para>

<media id="fs-id1165135432997" alt="Graph of f(x).">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_02_220.jpg"/>
</media>

</solution>
</exercise></section>
