<?xml version='1.0' encoding='utf-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" source-module="m49301" scope="algebraic-classification-first-21-exercises">
  <title>Algebraic: Function Classification</title>
  <content>
<section id="fs-id1165134080937"><title>Algebraic</title><para id="fs-id1165134080942">For the following exercises, determine whether the relation represents a function.</para>
<exercise id="fs-id1165134080945">
 <problem id="fs-id1165134080947">
  <para id="fs-id1165132967123"> <m:math>
   <m:mrow>
    <m:mrow><m:mo>{</m:mo> <m:mrow>
     <m:mrow><m:mo>(</m:mo>
      <m:mrow>
       <m:mi>a</m:mi><m:mo>,</m:mo><m:mi>b</m:mi></m:mrow>
      <m:mo>)</m:mo></m:mrow><m:mo>,</m:mo><m:mspace width="0.5em"/><m:mrow><m:mo>(</m:mo>
       <m:mrow>
        <m:mi>c</m:mi><m:mo>,</m:mo><m:mi>d</m:mi></m:mrow>
       <m:mo>)</m:mo></m:mrow><m:mo>,</m:mo><m:mspace width="0.5em"/><m:mrow><m:mo>(</m:mo>
        <m:mrow>
         <m:mi>a</m:mi><m:mo>,</m:mo><m:mi>c</m:mi></m:mrow>
        <m:mo>)</m:mo></m:mrow></m:mrow> <m:mo>}</m:mo></m:mrow></m:mrow>
  </m:math>
  </para>
 </problem>
</exercise>
<exercise id="fs-id1165135570225">
 <problem id="fs-id1165135570227">
  <para id="fs-id1165137530462"> <m:math>
   <m:mrow>
    <m:mo>{</m:mo><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mo>,</m:mo><m:mi>b</m:mi><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mi>b</m:mi><m:mo>,</m:mo><m:mi>c</m:mi><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mi>c</m:mi><m:mo>,</m:mo><m:mi>c</m:mi><m:mo stretchy="false">)</m:mo><m:mo>}</m:mo></m:mrow>
  </m:math>
  </para>
 </problem>
<solution id="fs-id1165135318977">
 <para id="fs-id1165135318979">function</para>
</solution>
</exercise>

 <para id="fs-id1165135318984">For the following exercises, determine whether the relation represents <m:math>
  <m:mrow>
   <m:mi>y</m:mi></m:mrow>
 </m:math> as a function of <m:math>
 <m:mrow>
  <m:mi>x</m:mi><m:mo>.</m:mo>
 </m:mrow>
</m:math>
 </para>

<exercise id="fs-id1165137841682">
 <problem id="fs-id1165137841684">
  <para id="fs-id1165137841686"> <m:math>
   <m:mrow>
    <m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow>
  </m:math>
  </para>
 </problem>
</exercise>
<exercise id="fs-id1165137925514">
 <problem id="fs-id1165135628498">
  <para id="fs-id1165135628500"> <m:math>
   <m:mrow>
    <m:mi>y</m:mi><m:mo>=</m:mo><m:msup>
     <m:mi>x</m:mi>
     <m:mn>2</m:mn>
    </m:msup>
   </m:mrow>
  </m:math>
  </para>
 </problem>
<solution id="fs-id1165137942475">
 <para id="fs-id1165137942477"> function</para>
</solution>
</exercise>
<exercise id="fs-id1165137942483">
 <problem id="fs-id1165137722399">
  <para id="fs-id1165137722401"> <m:math>
   <m:mrow>
    <m:mi>x</m:mi><m:mo>=</m:mo><m:msup>
     <m:mi>y</m:mi>
     <m:mn>2</m:mn>
    </m:msup>
   </m:mrow>
  </m:math>
  </para>
 </problem>
</exercise>
<exercise id="fs-id1165135394228">
 <problem id="fs-id1165135394230">
  <para id="fs-id1165135394232"> <m:math>
   <m:mrow>
    <m:mn>3</m:mn><m:msup>
     <m:mi>x</m:mi>
     <m:mn>2</m:mn>
    </m:msup>
    <m:mo>+</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>14</m:mn></m:mrow>
  </m:math>
  </para>
 </problem>
<solution id="fs-id1165135675187">
 <para id="fs-id1165135675189"> function</para>
</solution>
</exercise>
<exercise id="fs-id1165135675195">
 <problem id="fs-id1165135173422">
  <para id="fs-id1165135173424"> <m:math>
   <m:mrow>
    <m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:msup>
     <m:mi>y</m:mi>
     <m:mn>2</m:mn>
    </m:msup>
    <m:mo>=</m:mo><m:mn>6</m:mn></m:mrow>
  </m:math>
  </para>
 </problem>
</exercise>
<exercise id="fs-id1165137864148">
 <problem id="fs-id1165134085981">
  <para id="fs-id1165134085983"> <m:math>
   <m:mrow>
    <m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn><m:msup>
     <m:mi>x</m:mi>
     <m:mn>2</m:mn>
    </m:msup>
    <m:mo>+</m:mo><m:mn>40</m:mn><m:mi>x</m:mi></m:mrow>
  </m:math>
  </para>
 </problem>
<solution id="fs-id1165137679348">
 <para id="fs-id1165137679350"> function </para>
</solution>
</exercise>
<exercise id="fs-id1165137679356">
 <problem id="fs-id1165137924374">
  <para id="fs-id1165137924377"> <m:math>
   <m:mrow>
    <m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac>
     <m:mn>1</m:mn>
     <m:mi>x</m:mi>
    </m:mfrac>
   </m:mrow>
  </m:math>
  </para>
 </problem>
</exercise>
<exercise id="fs-id1165137661060">
 <problem id="fs-id1165137661062">
  <para id="fs-id1165137661065"> <m:math>
   <m:mrow>
    <m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac>
     <m:mrow>
      <m:mn>3</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow>
     <m:mrow>
      <m:mn>7</m:mn><m:mi>y</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow>
    </m:mfrac>
   </m:mrow>
  </m:math>
  </para>
 </problem>
<solution id="fs-id1165135581209"><para id="fs-id1165135581210"> function </para></solution></exercise>

<exercise id="fs-id1165135581214">
 <problem id="fs-id1165135581216">
  <para id="fs-id1165135581218"> <m:math>
   <m:mrow>
    <m:mi>x</m:mi><m:mo>=</m:mo><m:msqrt>
     <m:mrow>
      <m:mn>1</m:mn><m:mo>−</m:mo><m:msup>
       <m:mi>y</m:mi>
       <m:mn>2</m:mn>
      </m:msup>
     </m:mrow>
    </m:msqrt>
   </m:mrow>
  </m:math>
  </para>
 </problem>
</exercise>
<exercise id="fs-id1165133202429">
 <problem id="fs-id1165133202431">
  <para id="fs-id1165133202434"> <m:math>
   <m:mrow>
    <m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac>
     <m:mrow>
      <m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow>
     <m:mrow>
      <m:mn>7</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow>
    </m:mfrac>
   </m:mrow>
  </m:math>
  </para>
 </problem>
<solution id="fs-id1165134042765">
 <para id="fs-id1165134042767"> function </para>
</solution>
</exercise>
<exercise id="fs-id1165134042772">
 <problem id="fs-id1165134042774">
  <para id="fs-id1165134042776"> <m:math>
   <m:mrow>
    <m:msup>
     <m:mi>x</m:mi>
     <m:mn>2</m:mn>
    </m:msup>
    <m:mo>+</m:mo><m:msup>
     <m:mi>y</m:mi>
     <m:mn>2</m:mn>
    </m:msup>
    <m:mo>=</m:mo><m:mn>9</m:mn></m:mrow>
  </m:math>
  </para>
 </problem>
</exercise>
<exercise id="fs-id1165137887434">
 <problem id="fs-id1165137887436">
  <para id="fs-id1165134329782"> <m:math>
   <m:mrow>
    <m:mn>2</m:mn><m:mi>x</m:mi><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:mrow>
  </m:math>
  </para>
 </problem>
<solution id="fs-id1165135434851">
 <para id="fs-id1165135434853"> function </para>
</solution>
</exercise>
<exercise id="fs-id1165137658561">
 <problem id="fs-id1165137658563">
  <para id="fs-id1165137658565"> <m:math>
   <m:mrow>
    <m:mi>x</m:mi><m:mo>=</m:mo><m:msup>
     <m:mi>y</m:mi>
     <m:mn>3</m:mn>
    </m:msup>
   </m:mrow>
  </m:math>
  </para>
 </problem>
</exercise>
<exercise id="fs-id1165137777686">
 <problem id="fs-id1165137777688">
  <para id="fs-id1165137777690"> <m:math>
   <m:mrow>
    <m:mi>y</m:mi><m:mo>=</m:mo><m:msup>
     <m:mi>x</m:mi>
     <m:mn>3</m:mn>
    </m:msup>
   </m:mrow>
  </m:math>
  </para>
 </problem>
<solution id="fs-id1165137849364">
 <para id="fs-id1165137849366">function</para>
</solution>
</exercise>
<exercise id="fs-id1165137892513">
 <problem id="fs-id1165137892515">
  <para id="fs-id1165137892517"> <m:math>
   <m:mrow>
    <m:mi>y</m:mi><m:mo>=</m:mo><m:msqrt>
     <m:mrow>
      <m:mn>1</m:mn><m:mo>−</m:mo><m:msup>
       <m:mi>x</m:mi>
       <m:mn>2</m:mn>
      </m:msup>
     </m:mrow>
    </m:msqrt>
   </m:mrow>
  </m:math>
  </para>
 </problem>
</exercise>
<exercise id="fs-id1165134216874">
 <problem id="fs-id1165134216877">
  <para id="fs-id1165134216879"> <m:math>
   <m:mrow>
    <m:mi>x</m:mi><m:mo>=</m:mo><m:mo>±</m:mo><m:msqrt>
     <m:mrow>
      <m:mn>1</m:mn><m:mo>−</m:mo><m:mi>y</m:mi></m:mrow>
    </m:msqrt>
   </m:mrow>
  </m:math>
  </para>
 </problem>
<solution id="fs-id1165135527680">
 <para id="fs-id1165135538764">function</para>
</solution>
</exercise>
<exercise id="fs-id1165135538770">
 <problem id="fs-id1165135538772">
  <para id="fs-id1165135538774"> <m:math>
   <m:mrow>
    <m:mi>y</m:mi><m:mo>=</m:mo><m:mo>±</m:mo><m:msqrt>
     <m:mrow>
      <m:mn>1</m:mn><m:mo>−</m:mo><m:mi>x</m:mi></m:mrow>
    </m:msqrt>
   </m:mrow>
  </m:math>
  </para>
 </problem>
</exercise>
<exercise id="fs-id1165135203596">
 <problem id="fs-id1165135203598">
  <para id="fs-id1165135203600"> <m:math>
   <m:mrow>
    <m:msup>
     <m:mi>y</m:mi>
     <m:mn>2</m:mn>
    </m:msup>
    <m:mo>=</m:mo><m:msup>
     <m:mi>x</m:mi>
     <m:mn>2</m:mn>
    </m:msup>
   </m:mrow>
  </m:math>
  </para>
 </problem>
<solution id="fs-id1165137629243">
 <para id="fs-id1165137599978"> not a function </para>
</solution>
</exercise>

 <exercise id="fs-id1165137599984">
  <problem id="fs-id1165137599986">
   <para id="fs-id1165137599988"> <m:math>
  <m:mrow>
   <m:msup>
    <m:mi>y</m:mi>
    <m:mn>3</m:mn>
   </m:msup>
   <m:mo>=</m:mo><m:msup>
    <m:mi>x</m:mi>
    <m:mn>2</m:mn>
   </m:msup>
  </m:mrow>
 </m:math>
   </para>
  </problem>
 </exercise>
</section>
  </content>
