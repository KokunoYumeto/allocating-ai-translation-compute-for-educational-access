         <m:mi>x</m:mi>
         <m:mo>)</m:mo></m:mrow><m:mo>=</m:mo><m:mi>x</m:mi></m:mrow>
      </m:math>
      </entry>
      <entry align="center">
       <media id="fs-id1165137811013" alt="Graph of a straight line.">
