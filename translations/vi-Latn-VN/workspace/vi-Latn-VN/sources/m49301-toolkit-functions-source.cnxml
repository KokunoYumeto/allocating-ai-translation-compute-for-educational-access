         <m:mi>x</m:mi>
         <m:mo>)</m:mo></m:mrow><m:mo>=</m:mo><m:mrow><m:mo>|</m:mo> <m:mi>x</m:mi> <m:mo>|</m:mo></m:mrow></m:mrow>
      </m:math>
      </entry>
      <entry align="center">
       <media id="fs-id1165135195221" alt="Graph of absolute function.">
        <image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_01_020n-ec22.jpg" />
