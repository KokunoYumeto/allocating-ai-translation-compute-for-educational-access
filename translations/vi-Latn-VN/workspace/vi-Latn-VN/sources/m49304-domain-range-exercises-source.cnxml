<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML">
<content>
<section id="fs-id1165137580833">
<title>Graphical</title>
<para id="fs-id1165135186809">For the following exercises, write the domain and range of each function using interval notation.</para>

<exercise id="fs-id1165135168172"><problem id="fs-id1165137647479">

<media id="fs-id1165137891294" alt="Graph of a function from (2, 8]." display="block">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_02_202-95dc.jpg"/>
</media>

</problem>
<solution id="fs-id1165137820038">
<para id="fs-id1165137424631"> domain: <m:math>
<m:mrow>
<m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>8</m:mn><m:mo stretchy="false">]</m:mo><m:mo>,</m:mo></m:mrow>
</m:math> range <m:math>
<m:mrow>
<m:mo stretchy="false">[</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mn>8</m:mn><m:mo stretchy="false">)</m:mo></m:mrow>
</m:math>
</para>
</solution>
</exercise><exercise id="fs-id1165135160181"><problem id="fs-id1165135160183">

<media id="fs-id1165137837830" alt="Graph of a function from [4, 8)." display="block">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_02_203-38f5.jpg"/>
</media>

</problem>
</exercise><exercise id="fs-id1165137723404"><problem id="fs-id1165137809982">

<media id="fs-id1165137733767" alt="Graph of a function from [-4, 4]." display="block">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_02_204-d2ad.jpg"/>
</media>

</problem>
<solution id="fs-id1165137847285">
<para id="fs-id1165137541038"> domain: <m:math>
<m:mrow>
<m:mo stretchy="false">[</m:mo><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>,</m:mo><m:mtext> 4],</m:mtext></m:mrow>
</m:math> range: <m:math>
<m:mrow>
<m:mo stretchy="false">[</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mtext> 2]</m:mtext></m:mrow>
</m:math>
</para>
</solution>
</exercise><exercise id="fs-id1165137590678"><problem id="fs-id1165134168421">

<media id="fs-id1165137837060" alt="Graph of a function from [2, 6]." display="block">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_02_205-5a91.jpg"/>
</media>

</problem>
</exercise><exercise id="fs-id1165137737326"><problem id="fs-id1165137737328">

<media id="fs-id1165134129572" alt="Graph of a function from [-5, 3)." display="block">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_02_206-059d.jpg"/>
</media>

</problem>
<solution id="fs-id1165137657479">
<para id="fs-id1165137657482">domain: <m:math>
<m:mrow>
<m:mo stretchy="false">[</m:mo><m:mo>−</m:mo><m:mn>5</m:mn><m:mo>,</m:mo><m:mspace width="0.5em"/><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo></m:mrow>
</m:math> range: <m:math>
<m:mrow>
<m:mrow><m:mo>[</m:mo> <m:mrow>
<m:mn>0</m:mn><m:mo>,</m:mo><m:mn>2</m:mn></m:mrow> <m:mo>]</m:mo></m:mrow></m:mrow>
</m:math>
</para>
</solution>
</exercise><exercise id="fs-id1165137404973"><problem id="fs-id1165137404975">

<media id="fs-id1165134305418" alt="Graph of a function from [-3, 2)." display="block">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_02_207-ec92.jpg"/>
</media>

</problem>
</exercise><exercise id="fs-id1165137544188"><problem id="fs-id1165137437269">

<media id="fs-id1165137447903" alt="Graph of a function from (-infinity, 2]." display="block">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_02_208-7f09.jpg"/>
</media>

</problem>
<solution id="fs-id1165137445711">
<para id="fs-id1165137445713"> domain: <m:math>
<m:mrow>
<m:mo stretchy="false">(</m:mo><m:mo>−</m:mo><m:mi>∞</m:mi><m:mo>,</m:mo><m:mn>1</m:mn><m:mo stretchy="false">]</m:mo><m:mo>,</m:mo></m:mrow>
</m:math> range: <m:math>
<m:mrow>
<m:mo stretchy="false">[</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mi>∞</m:mi><m:mo stretchy="false">)</m:mo></m:mrow>
</m:math>
</para>
</solution>
</exercise><exercise id="fs-id1165135176309"><problem id="fs-id1165134323791">

<media id="fs-id1165135192955" alt="Graph of a function from [-4, infinity)." display="block">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_02_209-37f5.jpg"/>
</media>

</problem>
</exercise><exercise id="fs-id1165137642580"><problem id="fs-id1165137642582">

<media id="fs-id1165134482733" alt="Graph of a function from [-6, -1/6]U[1/6, 6]/." display="block">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_02_210-a5dd.jpg"/>
</media>

</problem>
<solution id="fs-id1165134043582">
<para id="fs-id1165135335983">domain: <m:math>
<m:mrow>
<m:mrow><m:mo>[</m:mo> <m:mrow>
<m:mo>−</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mfrac>
<m:mn>1</m:mn>
<m:mn>6</m:mn>
</m:mfrac>
</m:mrow> <m:mo>]</m:mo></m:mrow><m:mo>∪</m:mo><m:mrow><m:mo>[</m:mo> <m:mrow>
<m:mfrac>
<m:mn>1</m:mn>
<m:mn>6</m:mn>
</m:mfrac>
<m:mo>,</m:mo><m:mn>6</m:mn></m:mrow> <m:mo>]</m:mo></m:mrow><m:mo>;</m:mo></m:mrow>
</m:math> range: <m:math>
<m:mrow>
<m:mrow><m:mo>[</m:mo> <m:mrow>
<m:mo>−</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mfrac>
<m:mn>1</m:mn>
<m:mn>6</m:mn>
</m:mfrac>
</m:mrow> <m:mo>]</m:mo></m:mrow><m:mo>∪</m:mo><m:mrow><m:mo>[</m:mo> <m:mrow>
<m:mfrac>
<m:mn>1</m:mn>
<m:mn>6</m:mn>
</m:mfrac>
<m:mo>,</m:mo><m:mn>6</m:mn></m:mrow> <m:mo>]</m:mo></m:mrow></m:mrow>
</m:math>
</para>
</solution>
</exercise><exercise id="fs-id1165137442385"><problem id="fs-id1165137812572">

<media id="fs-id1165137645308" alt="Graph of a function from (-2.5, infinity)." display="block">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_02_211-3cb1.jpg"/>
</media>

</problem>
</exercise><exercise id="fs-id1165137851981"><problem id="fs-id1165137851983">

<media id="fs-id1165137602824" alt="Graph of a function from [-3, infinity)." display="block">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_02_212-f3f3.jpg"/>
</media>

</problem>
<solution id="fs-id1165137575572">
<para id="fs-id1165137601170">domain: <m:math>
<m:mrow>
<m:mo stretchy="false">[</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mspace width="0.5em"/><m:mi>∞</m:mi><m:mo stretchy="false">)</m:mo><m:mo>;</m:mo></m:mrow>
</m:math> range: <m:math>
<m:mrow>
<m:mo stretchy="false">[</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mi>∞</m:mi><m:mo stretchy="false">)</m:mo></m:mrow>
</m:math>
</para>
</solution>
</exercise>
