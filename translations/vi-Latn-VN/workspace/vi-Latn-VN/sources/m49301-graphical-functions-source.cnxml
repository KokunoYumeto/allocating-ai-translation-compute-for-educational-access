<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_01_205-9b65.jpg"/>
</media>

 </problem>
</exercise><exercise id="fs-id1165137749974"><problem id="fs-id1165137439464">

   <media id="fs-id1165137439470" alt="A graph of the cubic function y=x^3, displaying its characteristic S-shape. The curve passes through the origin (0,0), (-1,-1), and (1,1), extending infinitely upwards and downwards as x increases or decreases." display="block">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_01_206-a4e5.jpg"/>
</media>

