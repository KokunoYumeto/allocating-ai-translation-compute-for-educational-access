</exercise><exercise id="fs-id1165135593325"><problem id="fs-id1165135593327">

   <media id="fs-id1165135593333" alt="Graph of relation." display="block">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_01_212-3015.jpg"/>
</media>

 </problem>
<solution id="fs-id1165134240963"><para id="fs-id1165134240964"> function </para></solution></exercise><exercise id="fs-id1165134240968"><problem id="fs-id1165134054028">
  <para id="fs-id1165134054030">Given the following graph,
<list id="fs-id1165134054032" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> Evaluate <m:math>
  <m:mrow>
   <m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>−1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>.</m:mo></m:mrow>
 </m:math>
 </item>
 <item><span class="token">ⓑ</span> Solve for <m:math>
  <m:mrow>
   <m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>3.</m:mn></m:mrow>
 </m:math>
 </item>
</list></para><media id="fs-id1165137834413" alt="A coordinate plane with x-axis from -3 to 10 and y-axis from 0 to 4. A blue curve starts at (-2,0) and extends to the right, showing increasing positive values, resembling a square root function." display="block">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_01_213-fd68.jpg"/>
</media>

 </problem>
</exercise><exercise id="fs-id1165135632092"><problem id="fs-id1165135632095">
  <para id="fs-id1165137861992">Given the following graph,
  <list id="fs-id1165137861994" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> Evaluate <m:math>
   <m:mrow>
    <m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>.</m:mo></m:mrow>
  </m:math>
</item>
  <item><span class="token">ⓑ</span> Solve for <m:math>
   <m:mrow>
    <m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>−3.</m:mn></m:mrow>
  </m:math> </item>
  </list></para><media id="fs-id1165135567425" alt="A Cartesian graph displays a blue W-shaped curve, typical of a quartic function. It has a local maximum at (0,1) and two local minima around (-2,-3) and (2,-3), extending upwards symmetrically." display="block">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_01_214-4087.jpg"/>
</media>

</problem>
 <solution id="fs-id1165134108640"><list id="eip-idm666464064" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math>
  <m:mrow>
   <m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>0</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>1</m:mn><m:mo>;</m:mo></m:mrow>
 </m:math></item><item><span class="token">ⓑ</span> <m:math>
 <m:mrow>
  <m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mspace width="0.5em"/><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow>
</m:math> or <m:math>
 <m:mrow>
  <m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow>
</m:math></item>
 </list></solution></exercise><exercise id="fs-id1165134325868"><problem id="fs-id1165134325870">
   <para id="fs-id1165134325872">Given the following graph,
<list id="fs-id1165134325875" list-type="enumerated" number-style="arabic" class="circled">
 <item><span class="token">ⓐ</span> Evaluate <m:math>
  <m:mrow>
   <m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo>.</m:mo></m:mrow>
 </m:math>
 </item>
 <item><span class="token">ⓑ</span> Solve for <m:math>
  <m:mrow>
   <m:mi>f</m:mi><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>1.</m:mn></m:mrow>
 </m:math>
 </item>
</list>
</para><media id="fs-id1165135575950" alt="Graph of relation." display="block">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_01_215-571f.jpg"/>
</media>

  </problem>
 </exercise>
