<?xml version='1.0' encoding='utf-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" source-module="m49301" scope="graphical-first-15-exercises">
  <title>Graphical: Vertical Tests and Reading Function Values</title>
  <content>
<section id="fs-id1165135664071">
<title>Graphical</title>
<para id="fs-id1165135664077">For the following exercises, use the vertical line test to determine which graphs show relations that are functions.</para>
<exercise id="fs-id1165135455987"><problem id="fs-id1165135455989">
 <media id="fs-id1165135455994" alt="Graph of relation." display="block">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_01_201-5fd2.jpg"/>
</media>

</problem>
</exercise><exercise id="fs-id1165137527641"><problem id="fs-id1165137847086">
  <media id="fs-id1165137847091" alt="A graph displays two curves originating from the origin (0,0) and extending rightwards. The upper curve goes upwards, and the lower curve goes downwards, both symmetric about the x-axis, increasingly steep." display="block">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_01_202-c11d.jpg"/>
</media>

 </problem>
<solution id="fs-id1165135332505">
 <para id="fs-id1165135332507">not a function</para>
</solution>
</exercise><exercise id="fs-id1165135332512"><problem id="fs-id1165133336399">

