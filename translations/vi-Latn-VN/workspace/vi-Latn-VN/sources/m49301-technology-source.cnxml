<?xml version='1.0' encoding='utf-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" source-module="m49301" scope="complete-technology-exercises">
  <title>Technology: Graphs on Closed Domains</title>
  <content>
<section id="fs-id1165134373511">
<title>Technology</title>
<para id="fs-id1165135530586">For the following exercises, graph <m:math>
 <m:mrow>
  <m:mi>y</m:mi><m:mo>=</m:mo><m:msup>
   <m:mi>x</m:mi>
   <m:mn>2</m:mn>
  </m:msup>
  </m:mrow>
</m:math> on the given domain. Determine the corresponding range. Show each graph.</para><exercise id="fs-id1165135530591">
  <problem id="fs-id1165135530593">
   <para id="fs-id1165135530595"> <m:math>
  <m:mrow>
   <m:mo stretchy="false">[</m:mo><m:mo>−</m:mo><m:mn>0.1</m:mn><m:mo>,</m:mo><m:mspace width="0.5em"/><m:mn>0.1</m:mn><m:mo stretchy="false">]</m:mo></m:mrow>
 </m:math>
   </para>
  </problem>
 </exercise>
<exercise id="fs-id1165134087674"><problem id="fs-id1165134087676"><para id="fs-id1165134087677"> <m:math>
  <m:mrow>
   <m:mo stretchy="false">[</m:mo><m:mo>−</m:mo><m:mn>10</m:mn><m:mo>,</m:mo><m:mtext> 10</m:mtext><m:mo stretchy="false">]</m:mo></m:mrow>
 </m:math>
 </para></problem>
 <solution id="fs-id1165137809996"><para id="fs-id1165137809998"> <m:math>
  <m:mrow>
   <m:mo stretchy="false">[</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mtext> 100</m:mtext><m:mo stretchy="false">]</m:mo></m:mrow>
 </m:math>
 </para>
<media id="fs-id1165133448050" alt="Graph of a parabola.">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_01_220-324e.jpg"/>
</media>
</solution></exercise><exercise id="fs-id1165135695182">
 <problem id="fs-id1165135695184">
  <para id="fs-id1165135695186"> <m:math>
   <m:mrow>
    <m:mo stretchy="false">[</m:mo><m:mo>−</m:mo><m:mn>100</m:mn><m:mo>,</m:mo><m:mn>100</m:mn><m:mo stretchy="false">]</m:mo></m:mrow>
  </m:math>
  </para>
 </problem>
</exercise>
 <para id="fs-id1165135388446">For the following exercises, graph <m:math>
  <m:mrow>
   <m:mi>y</m:mi><m:mo>=</m:mo><m:msup>
    <m:mi>x</m:mi>
    <m:mn>3</m:mn>
   </m:msup>
   </m:mrow>
 </m:math> on the given domain. Determine the corresponding range. Show each graph.</para><exercise id="fs-id1165134060421"><problem id="fs-id1165134060424">
  <para id="fs-id1165134060426"> <m:math>
   <m:mrow>
    <m:mo stretchy="false">[</m:mo><m:mo>−</m:mo><m:mn>0.1</m:mn><m:mo>,</m:mo><m:mtext> 0</m:mtext><m:mtext>.1</m:mtext><m:mo stretchy="false">]</m:mo></m:mrow>
  </m:math>
  </para>
 </problem>
 <solution id="fs-id1165135634141"><para id="fs-id1165135634142"> <m:math>
  <m:mrow>
   <m:mo stretchy="false">[</m:mo><m:mo>−</m:mo><m:mn>0.001</m:mn><m:mo>,</m:mo><m:mtext> 0</m:mtext><m:mtext>.001</m:mtext><m:mo stretchy="false">]</m:mo></m:mrow>
 </m:math>
 </para>
<media id="fs-id1165135259631" alt="Graph of a parabola.">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_01_222-2e5d.jpg"/>
</media>
</solution>
</exercise><exercise id="fs-id1165133195224">
 <problem id="fs-id1165133195226">
  <para id="fs-id1165133195229"> <m:math>
   <m:mrow>
    <m:mo stretchy="false">[</m:mo><m:mo>−</m:mo><m:mn>10</m:mn><m:mo>,</m:mo><m:mtext> 10</m:mtext><m:mo stretchy="false">]</m:mo></m:mrow>
  </m:math>
  </para>
 </problem>
</exercise>
<exercise id="fs-id1165133402070"><problem id="fs-id1165133402072"><para id="fs-id1165133402074"> <m:math>
  <m:mrow>
   <m:mo stretchy="false">[</m:mo><m:mo>−</m:mo><m:mn>100</m:mn><m:mo>,</m:mo><m:mtext> 100</m:mtext><m:mo stretchy="false">]</m:mo></m:mrow>
 </m:math>
 </para></problem>
 <solution id="fs-id1165137833875"><para id="fs-id1165137833876"> <m:math>
  <m:mrow>
   <m:mo stretchy="false">[</m:mo><m:mo>−</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mn>000</m:mn><m:mo>,</m:mo><m:mn>000</m:mn><m:mo>,</m:mo><m:mtext> 1,000,000</m:mtext><m:mo stretchy="false">]</m:mo></m:mrow>
 </m:math>
 </para>
<media id="fs-id1165135434747" alt="Graph of a cubic function.">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_01_224-c9b5.jpg"/>
</media>
</solution></exercise><para id="fs-id1165135634160">For the following exercises, graph <m:math>
  <m:mrow>
   <m:mi>y</m:mi><m:mo>=</m:mo><m:msqrt>
    <m:mi>x</m:mi>
   </m:msqrt>
   </m:mrow>
 </m:math> on the given domain. Determine the corresponding range. Show each graph.</para><exercise id="fs-id1165137844302">
 <problem id="fs-id1165137844304">
  <para id="fs-id1165137844306"> <m:math>
   <m:mrow>
    <m:mo stretchy="false">[</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mtext> 0</m:mtext><m:mtext>.01</m:mtext><m:mo stretchy="false">]</m:mo></m:mrow>
  </m:math>
  </para>
 </problem>
</exercise>
<exercise id="fs-id1165137540730"><problem id="fs-id1165137540733">
  <para id="fs-id1165137540735"> <m:math>
   <m:mrow>
    <m:mo stretchy="false">[</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mtext> 100</m:mtext><m:mo stretchy="false">]</m:mo></m:mrow>
  </m:math>
  </para>
 </problem>
 <solution id="fs-id1165135344910"><para id="eip-id1963987"> <m:math>
  <m:mrow>
   <m:mo stretchy="false">[</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mtext> 10</m:mtext><m:mo stretchy="false">]</m:mo></m:mrow>
 </m:math>
 </para>
 <media id="fs-id1165137850247" alt="Graph of a square root function.">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_01_226-6e2a.jpg"/>
</media>
</solution></exercise><exercise id="fs-id1165137605840">
 <problem id="fs-id1165137605842">
  <para id="fs-id1165137605844"> <m:math>
   <m:mrow>
    <m:mo stretchy="false">[</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mtext> 10,000</m:mtext><m:mo stretchy="false">]</m:mo></m:mrow>
  </m:math>
  </para>
 </problem>
</exercise>

 <para id="fs-id1165137539207">For the following exercises, graph <m:math>
  <m:mrow>
   <m:mi>y</m:mi><m:mo>=</m:mo><m:mroot>
    <m:mi>x</m:mi>
    <m:mn>3</m:mn>
   </m:mroot>
  </m:mrow>
 </m:math> on the given domain. Determine the corresponding range. Show each graph.</para><exercise id="fs-id1165134031227"><problem id="fs-id1165134031229">
  <para id="fs-id1165134031231"> <m:math>
   <m:mrow>
    <m:mo stretchy="false">[</m:mo><m:mn>−0.001</m:mn><m:mo>,</m:mo><m:mtext>0.001</m:mtext><m:mo stretchy="false">]</m:mo></m:mrow>
  </m:math>
  </para></problem>
 <solution id="fs-id1165137928674"><para id="fs-id1165137928675"> <m:math>
  <m:mrow>
   <m:mo stretchy="false">[</m:mo><m:mn>−0.1</m:mn><m:mo>,</m:mo><m:mtext>0.1</m:mtext><m:mo stretchy="false">]</m:mo></m:mrow>
 </m:math>
 </para>
 <media id="fs-id1165135407024" alt="Graph of a square root function.">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_01_228-c583.jpg"/>
</media>
 </solution></exercise><exercise id="fs-id1165134087649">
 <problem id="fs-id1165134087651">
  <para id="fs-id1165134087653"> <m:math>
   <m:mrow>
    <m:mo stretchy="false">[</m:mo><m:mn>−1000</m:mn><m:mo>,</m:mo><m:mtext>1000</m:mtext><m:mo stretchy="false">]</m:mo></m:mrow>
  </m:math>
  </para></problem>
</exercise>
 <exercise id="fs-id1165135251229"><problem id="fs-id1165135251230"><para id="fs-id1165135251231"> <m:math>
 <m:mrow>
  <m:mo stretchy="false">[</m:mo><m:mn>−1,000,000</m:mn><m:mo>,</m:mo><m:mtext>1,000,000</m:mtext><m:mo stretchy="false">]</m:mo>
 </m:mrow>
</m:math>
</para></problem>
  <solution id="fs-id1165137686659"><para id="fs-id1165137686660"> <m:math>
   <m:mrow>
    <m:mo stretchy="false">[</m:mo><m:mo>−</m:mo><m:mn>100</m:mn><m:mo>,</m:mo><m:mtext> 100</m:mtext><m:mo stretchy="false">]</m:mo></m:mrow>
  </m:math>
  </para>

 <media id="fs-id1165135394245" alt="Graph of a cubic root function.">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_01_230-869c.jpg"/>
</media>
</solution></exercise></section>
