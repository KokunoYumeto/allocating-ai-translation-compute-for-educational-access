<source-excerpt xmlns="http://cnx.rice.edu/cnxml"><para id="fs-id1165135531627">For the following exercises, determine if the given graph is a one-to-one function.</para><exercise id="fs-id1165135541711"><problem id="fs-id1165135541713">

    <media id="fs-id1165135541720" alt="Graph of a circle." display="block">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_01_216-4707.jpg" />
</media>

  </problem>
<solution id="fs-id1165133085670"><para id="fs-id1165133085671">not a function so it is also not a one-to-one function</para></solution></exercise><exercise id="fs-id1165133085674"><problem id="fs-id1165134380351">
  <media id="fs-id1165134380356" alt="Graph of a parabola." display="block">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_01_232-8b55.jpg" />
</media>

 </problem>
</exercise><exercise id="fs-id1165134037560"><problem id="fs-id1165134037562">

   <media id="fs-id1165134037568" alt="Graph of a rotated cubic function." display="block">
<image mime-type="image/jpg" src="../../media/CNX_Precalc_Figure_01_01_217-7861.jpg" />
</media>

 </problem>
<solution id="fs-id1165137583859"><para id="fs-id1165137583860">one-to-one function</para></solution>
 </exercise><exercise id="fs-id1165134031248"><problem id="fs-id1165134031250">

 <media id="fs-id1165134031257" alt="Graph of half of 1/x." display="block">
