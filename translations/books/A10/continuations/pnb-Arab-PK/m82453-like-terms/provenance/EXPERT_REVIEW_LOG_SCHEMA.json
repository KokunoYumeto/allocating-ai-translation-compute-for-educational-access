{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/interlanguage/a10-expert-review-log-v1.schema.json",
  "title": "A10 locale terminology and difficult-translation review log",
  "type": "object",
  "required": ["schema", "locale", "coverage_status", "entries"],
  "properties": {
    "schema": {"const": "a10.expert-review-log.v1"},
    "locale": {"type": "string", "minLength": 2},
    "coverage_status": {"enum": ["partial", "complete"]},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision_id", "source_location", "target_location", "source_sense", "chosen_wording", "authorities_checked", "rationale", "alternatives", "uncertainty", "provisional", "review_question", "rationale_timing"],
        "properties": {
          "decision_id": {"type": "string", "minLength": 1},
          "source_location": {"type": "string", "minLength": 1},
          "target_location": {"type": "string", "minLength": 1},
          "source_sense": {"type": "string", "minLength": 1},
          "chosen_wording": {"type": "string", "minLength": 1},
          "authorities_checked": {"type": "array", "minItems": 1},
          "rationale": {"type": "string", "minLength": 1},
          "alternatives": {"type": "array"},
          "uncertainty": {"type": "string", "minLength": 1},
          "provisional": {"type": "boolean"},
          "review_question": {"type": "string", "minLength": 1},
          "rationale_timing": {"enum": ["contemporaneous", "retrospective_reconstruction"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
