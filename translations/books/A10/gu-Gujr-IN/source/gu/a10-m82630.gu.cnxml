<?xml version='1.0' encoding='utf-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:ns1="http://cnx.rice.edu/mdml" class="preface" xml:lang="gu-Gujr-IN">

  <title>પ્રસ્તાવના</title>
  <metadata>
    <ns1:content-id>m82630</ns1:content-id>
    <ns1:title>પ્રસ્તાવના</ns1:title>
    <ns1:abstract />
    <ns1:uuid>f80c5e9e-2697-4f6a-8d76-a10cb48e02b8</ns1:uuid>
  </metadata>

  <content class="preface">
    <para id="eip-192">પુસ્તક <emphasis effect="italics">Elementary Algebra 2e</emphasis>માં આપનું સ્વાગત છે—તે OpenStaxનું શૈક્ષણિક સંસાધન છે. વિદ્યાર્થીઓને સારી ગુણવત્તાની અભ્યાસસામગ્રી ઓછી કિંમતે અથવા નિઃશુલ્ક મળે અને સાથે શૈક્ષણિક ચોકસાઈનાં ઉચ્ચતમ ધોરણો જળવાય તે હેતુથી આ પાઠ્યપુસ્તક લખાયું છે.</para>
    <section id="eip-287">
      <title>OpenStax વિશે</title>
      <para id="eip-634">OpenStax એ Rice Universityનો ભાગ છે; Rice University એક 501(c)(3) બિનનફાકારક સખાવતી સંસ્થા છે. ઉત્તમ શિક્ષણ સૌને સુલભ બનાવવું એ અમારું ધ્યેય છે. પરોપકારી સંસ્થાઓ સાથેની ભાગીદારી અને અન્ય શૈક્ષણિક સંસાધન કંપનીઓ સાથેના સહયોગ દ્વારા અમે અભ્યાસના સૌથી સામાન્ય અવરોધો દૂર કરી રહ્યા છીએ. કારણ કે અમે માનીએ છીએ કે જ્ઞાન દરેકને મળવું જોઈએ અને મળી શકે છે.</para>
    </section>
    <section id="eip-328">
      <title>OpenStaxનાં સંસાધનો વિશે</title>
      <section id="eip-583">
        <title>જરૂરિયાત મુજબ ફેરફાર</title>
        <para id="eip-912"><emphasis effect="italics">Elementary Algebra 2e</emphasis> Creative Commons Attribution-NonCommercial-ShareAlike 4.0 (CC BY-NC-SA) લાઇસન્સ હેઠળ ઉપલબ્ધ છે. તેનો અર્થ એ છે કે તમે આ સામગ્રીનું બિનવ્યાવસાયિક રીતે વિતરણ કરી શકો છો, તેને નવી રીતે ગોઠવી શકો છો અને તેના આધારે નવી સામગ્રી બનાવી શકો છો, જો તમે OpenStax અને સામગ્રીના યોગદાનકર્તાઓને શ્રેય આપો અને તમામ રૂપાંતરિત કૃતિઓનું એ જ લાઇસન્સ હેઠળ વિતરણ કરો.</para>
        <para id="eip-706">અમારાં પુસ્તકો ખુલ્લા લાઇસન્સ હેઠળ હોવાથી તમે આખું પુસ્તક વાપરી શકો છો અથવા તમારા અભ્યાસક્રમની જરૂરિયાતોને સૌથી વધુ અનુરૂપ વિભાગો પસંદ કરી શકો છો. વિદ્યાર્થીઓને તમારા પાઠ્યક્રમમાં અમુક પ્રકરણો અને વિભાગો તમારા પસંદગીના ક્રમમાં આપીને સામગ્રી ફરી ગોઠવી શકો છો. તમારા પાઠ્યક્રમમાં પુસ્તકના વેબ સ્વરૂપના વિભાગોની સીધી કડી પણ આપી શકો છો.</para>
        <para id="eip-740">શિક્ષકો પાસે પોતાના OpenStax પુસ્તકની જરૂરિયાત મુજબ ફેરફાર કરેલી આવૃત્તિ બનાવવાનો વિકલ્પ પણ છે. આ આવૃત્તિ શિક્ષણસંસ્થાની પુસ્તકદુકાન દ્વારા વિદ્યાર્થીઓને ઓછી કિંમતના મુદ્રિત કે ડિજિટલ સ્વરૂપમાં આપી શકાય છે. વધુ માહિતી માટે openstax.org પર તમારા પુસ્તકનું પાનું જુઓ.</para>
      </section>
      <section id="eip-92">
        <title>ચિત્રોના શ્રેય વિશે: <emphasis effect="italics"> Elementary Algebra 2e</emphasis></title>
        <para id="eip-787"> પુસ્તક <emphasis effect="italics"> Elementary Algebra 2e</emphasis>માં મોટાભાગનાં ચિત્રોની નીચેની નોંધમાં તેનું શીર્ષક, સર્જક અથવા અધિકારધારક, તેને ઉપલબ્ધ કરાવતું માધ્યમ અને લાઇસન્સનો શ્રેય આપેલો છે. કેટલાંક ચિત્રો પરવાનગી મેળવીને અપાયેલાં છે અને તેમનો ઉપયોગ શ્રેયની નોંધમાં આપેલી શરતો કે મર્યાદાઓ સાથે જ કરવો જોઈએ. ખુલ્લા લાઇસન્સવાળા ચિત્રોનો બિનવ્યાવસાયિક ઉપયોગ કરનાર વ્યક્તિઓ કે સંસ્થાઓ તેનો ફરી ઉપયોગ કરી શકે છે, જો મૂળ સ્રોતને એ જ રીતે શ્રેય આપે. (વ્યાવસાયિક સંસ્થાઓએ પુનઃઉપયોગના અધિકારો અને પરવાનગી વિશે ચર્ચા કરવા OpenStaxનો સંપર્ક કરવો જોઈએ.) વાંચવાની સરળતા અને સામગ્રીનો પ્રવાહ જાળવવા કેટલાંક ચિત્રોનો શ્રેય લખાણમાં આપેલો નથી. આ પુસ્તકમાંથી એવું ચિત્ર ફરી વાપરો જેના માટે શ્રેય આપેલો નથી, તો નીચેનું શ્રેય આપો: Copyright Rice University, OpenStax, under CC BY-NC-SA 4.0 license.</para>
      </section>
      <section id="eip-581">
        <title>ભૂલસુધારણા</title>
        <para id="eip-169">OpenStaxનાં તમામ પાઠ્યપુસ્તકોની કડક સમીક્ષા થાય છે. તેમ છતાં, અન્ય વ્યાવસાયિક ગુણવત્તાનાં પાઠ્યપુસ્તકોની જેમ, ક્યારેક ભૂલો રહી જાય છે. અમારાં પુસ્તકો વેબ પર હોવાથી શૈક્ષણિક દૃષ્ટિએ જરૂરી લાગે ત્યારે સમયાંતરે સુધારા કરી શકીએ છીએ. જો તમે કોઈ સુધારો સૂચવવા માગતા હો, તો openstax.org પર તમારા પુસ્તકના પાનાની કડી દ્વારા મોકલો. વિષયના નિષ્ણાતો ભૂલસુધારણા માટેનાં બધાં સૂચનો તપાસે છે. દરેક સુધારા વિશે પારદર્શકતા જાળવવા OpenStax પ્રતિબદ્ધ છે; તેથી openstax.org પર તમારા પુસ્તકના પાનામાં અગાઉ કરેલા ભૂલસુધારાઓની યાદી પણ મળશે.</para>
      </section>
      <section id="eip-674">
        <title>સ્વરૂપ</title>
        <para id="eip-232">આ પાઠ્યપુસ્તક openstax.org દ્વારા વેબ અથવા PDF સ્વરૂપમાં નિઃશુલ્ક અને મુદ્રિત સ્વરૂપમાં ઓછી કિંમતે મેળવી શકો છો.</para>
      </section>
    </section>
    <section id="eip-574">
      <title>આ પુસ્તક વિશે: <emphasis effect="italics">Elementary Algebra</emphasis></title>
      <para id="eip-203"><emphasis effect="italics">Elementary Algebra 2e</emphasis> એક સેમેસ્ટરના પ્રાથમિક બીજગણિતના અભ્યાસક્રમની વિષયવ્યાપ અને ક્રમની જરૂરિયાતો પૂરી કરવા તૈયાર કરાયું છે. પુસ્તકની ગોઠવણીને કારણે તેને વિવિધ અભ્યાસક્રમોને અનુરૂપ બનાવવું સરળ છે. જુદી પૃષ્ઠભૂમિ અને શીખવાની રીતો ધરાવતા વિદ્યાર્થીઓની જરૂરિયાતો ધ્યાનમાં રાખીને તેમાં બીજગણિતની મૂળભૂત સંકલ્પનાઓ વિસ્તારથી સમજાવી છે. દરેક વિષય અગાઉના અભ્યાસ પર આધારિત છે, જેથી ગણિતના વિષયોનો પરસ્પર સંબંધ અને ગોઠવણી સ્પષ્ટ થાય.</para>
      <section id="eip-95">
        <title>વિષયવિસ્તાર અને વ્યાપ</title>
        <para id="eip-974"><emphasis effect="italics">Elementary Algebra 2e</emphasis>માં વિષયો રજૂ કરવાની રીત પરંપરાગત ક્રમથી જુદી છે. અગાઉના પુસ્તક <emphasis effect="italics">Prealgebra</emphasis>ના વિષયોના આધારે અહીં નાનાં-નાનાં પગલાંના ક્રમમાં સામગ્રી રજૂ કરી છે, જેથી વિદ્યાર્થીઓને અભ્યાસક્રમમાં સફળ થવાની પોતાની ક્ષમતા પર વિશ્વાસ વધે. વિષયોનો ક્રમ કાળજીથી નક્કી કર્યો છે, જેથી અભ્યાસમાં તાર્કિક રીતે આગળ વધાય અને દરેક સંકલ્પના સારી રીતે સમજાય. નવા વિચારો રજૂ કરતી વખતે અગાઉના વિષયો સાથે તેમનો સંબંધ સ્પષ્ટ કર્યો છે.</para>
        <list id="eip-992" list-type="bulleted" bullet-style="none">
          <item><emphasis effect="bold">પ્રકરણ 1: પાયાની સમજ</emphasis><newline /> પ્રકરણ 1માં પૂર્ણ સંખ્યાઓ, પૂર્ણાંકો, અપૂર્ણાંકો અને દશાંશ સંખ્યાઓ પરની અંકગણિતની ક્રિયાઓનું પુનરાવર્તન છે, જેથી વિદ્યાર્થીઓને બીજગણિતના અભ્યાસ માટે મજબૂત પાયો મળે.</item>
          <item><emphasis effect="bold">પ્રકરણ 2: સુરેખ સમીકરણો અને અસમતાઓ ઉકેલવી</emphasis><newline /> પ્રકરણ 2માં વિદ્યાર્થીઓ સમીકરણના ઉકેલની ચકાસણી કરવાનું શીખે છે. તેઓ સમાનતાના બાદબાકી અને સરવાળાના ગુણધર્મોથી તથા ગુણાકાર અને ભાગાકારના ગુણધર્મોથી સમીકરણો ઉકેલે છે; બંને બાજુ ચલ અને અચળ પદો ધરાવતાં સમીકરણો ઉકેલે છે; સુરેખ સમીકરણો માટે સામાન્ય રીત વાપરે છે; અપૂર્ણાંક કે દશાંશ ધરાવતાં સમીકરણો ઉકેલે છે; સૂત્રમાંથી ચોક્કસ ચલનું મૂલ્ય અલગ તારવે છે; અને સુરેખ અસમતાઓ ઉકેલે છે.</item>
          <item><emphasis effect="bold">પ્રકરણ 3: ગણિતનાં નમૂનાઓ</emphasis><newline /> સમીકરણો ઉકેલવા જરૂરી કૌશલ્યો શીખ્યા પછી વિદ્યાર્થીઓ પ્રકરણ 3માં તે કૌશલ્યોથી શબ્દોમાં આપેલા પ્રશ્નો અને સંખ્યાઓના પ્રશ્નો ઉકેલે છે.</item>
          <item><emphasis effect="bold">પ્રકરણ 4: આલેખો</emphasis><newline /> પ્રકરણ 4માં લંબયામી નિર્દેશાંક પદ્ધતિ સમજાવી છે; સામાન્ય ઉપયોગમાં આવતા મોટા ભાગના આલેખોનો તે આધાર છે. વિદ્યાર્થીઓ તેમાં બિંદુઓ દર્શાવવાનું, બે ચલવાળાં સુરેખ સમીકરણોના આલેખ દોરવાનું, અક્ષછેદોની મદદથી આલેખ દોરવાનું, રેખાનો ઢાળ સમજવાનું, રેખાના સમીકરણનું ઢાળ-અક્ષછેદ સ્વરૂપ વાપરવાનું, રેખાનું સમીકરણ શોધવાનું અને સુરેખ અસમતાઓના આલેખ દોરવાનું શીખે છે.</item>
          <item><emphasis effect="bold">પ્રકરણ 5: સુરેખ સમીકરણોનાં સમૂહો</emphasis><newline /> પ્રકરણ 5માં આલેખ, ચલની અવેજી અને ચલને દૂર કરવાની રીતથી સમીકરણોનાં સમૂહો ઉકેલવાનું છે. તેમાં સમીકરણોના સમૂહોથી વ્યવહારુ પ્રશ્નો અને મિશ્રણના પ્રશ્નો ઉકેલવાનું, તેમજ સુરેખ અસમતાઓના સમૂહોના આલેખ દોરવાનું પણ છે.</item>
          <item><emphasis effect="bold">પ્રકરણ 6: બહુપદીઓ</emphasis><newline /> પ્રકરણ 6માં વિદ્યાર્થીઓ બહુપદીઓનો સરવાળો અને બાદબાકી કરવાનું, ઘાતના ગુણાકારના ગુણધર્મો વાપરવાનું, બહુપદીઓનો ગુણાકાર કરવાનું, ખાસ ગુણનફળો વાપરવાનું અને એકપદી તથા બહુપદીનો ભાગાકાર કરવાનું શીખે છે. તેઓ પૂર્ણાંક ઘાત અને વૈજ્ઞાનિક સંકેતલેખન પણ સમજે છે.</item>
          <item><emphasis effect="bold">પ્રકરણ 7: અવયવીકરણ</emphasis><newline /> પ્રકરણ 7માં વિદ્યાર્થીઓ પદાવલીના અવયવો પાડવાની પ્રક્રિયા સમજે છે અને અમુક પ્રકારનાં સમીકરણો ઉકેલવામાં અવયવીકરણ કેવી રીતે વપરાય છે તે જુએ છે.</item>
          <item><emphasis effect="bold">પ્રકરણ 8: સંમેય પદાવલીઓ અને સમીકરણો</emphasis><newline /> પ્રકરણ 8માં વિદ્યાર્થીઓ સંમેય પદાવલીઓનો ઉપયોગ કરે છે, સંમેય સમીકરણો ઉકેલે છે અને તેમનો ઉપયોગ કરીને વિવિધ વ્યવહારુ પ્રશ્નો ઉકેલે છે.</item>
          <item><emphasis effect="bold">પ્રકરણ 9: મૂળ અને કરણીઓ</emphasis><newline /> પ્રકરણ 9માં વિદ્યાર્થીઓ વર્ગમૂળના ગુણધર્મોથી પરિચિત થાય છે અને તેમને વાપરવાનું શીખે છે. પછી આ સંકલ્પનાઓને ઊંચી કક્ષાનાં મૂળ અને સંમેય ઘાત સુધી વિસ્તારે છે.</item>
          <item><emphasis effect="bold">પ્રકરણ 10: દ્વિઘાત સમીકરણો</emphasis><newline /> પ્રકરણ 10માં વિદ્યાર્થીઓ દ્વિઘાત સમીકરણોના ગુણધર્મો શીખે છે, તે સમીકરણો ઉકેલે છે અને તેમના આલેખ દોરે છે. વિવિધ પરિસ્થિતિઓને ગણિતમાં દર્શાવવા તેમનો ઉપયોગ કરવાનું પણ શીખે છે.</item>
        </list>
        <para id="eip-178">બધાં પ્રકરણોને અનેક વિભાગોમાં વહેંચ્યાં છે. તેમનાં શીર્ષકો અહીં જોઈ શકાય છે: <emphasis effect="bold">વિષયસૂચિ</emphasis>.</para>
      </section>
      <section id="eip-758">
        <title>બીજી આવૃત્તિમાં કરેલા ફેરફારો</title>
        <para id="eip-297"> પુસ્તક <emphasis effect="italics"> Elementary Algebra 2e</emphasis>ની સુધારેલી આવૃત્તિમાં ગણિતની સ્પષ્ટતા અને ચોકસાઈ પર ધ્યાન આપ્યું છે. દરેક ઉદાહરણ, “જાતે અજમાવો”, વિભાગનો અભ્યાસ, પુનરાવર્તન અભ્યાસ અને અભ્યાસ કસોટીના દરેક પ્રશ્નની અનેક નિષ્ણાત શિક્ષકોએ સમીક્ષા કરી અને પછી લેખકોએ ચકાસણી કરી. આ સઘન પ્રયાસથી લખાણ, પ્રશ્નોની ભાષા, જવાબો, શિક્ષકો માટેના ઉકેલો અને ચિત્રોમાં સેંકડો ફેરફારો થયા. </para>
        <para id="eip-503">જોકે, પાઠ્યપુસ્તકોમાં સુધારા કરતી વખતે પ્રશ્નો અને અભ્યાસના ક્રમાંક બદલાય ત્યારે થતી મુશ્કેલીઓથી OpenStax અને અમારા લેખકો વાકેફ છે. 2જી આવૃત્તિ તરફનું પરિવર્તન શક્ય તેટલું સરળ બનાવવા અમે અભ્યાસના ક્રમાંકમાં થતા ફેરફારો ઓછામાં ઓછા રાખ્યા છે. ઉદાહરણ તરીકે, જરૂરી હોય ત્યાં પ્રશ્નો કાઢી નાખવા કે ઉમેરવાને બદલે ક્રમાંક જળવાય તે રીતે પ્રશ્નો બદલ્યા છે. તેથી લગભગ બધાં પ્રકરણોમાં અભ્યાસના ક્રમાંક બદલાશે નહીં; જે પ્રકરણોમાં બદલાશે ત્યાં ફેરફાર નાનો હશે. શિક્ષકો અને અભ્યાસક્રમના સંયોજકો નવી આવૃત્તિનો સરળતાથી ઉપયોગ કરી શકશે.</para>
        <para id="eip-191">સુવિધા વધારવા માટે “તૈયાર રહો!” અભ્યાસના જવાબો હવે અલગ સંસાધનને બદલે નિયમિત ઉકેલ માર્ગદર્શિકાઓમાં મળશે.</para>
        <para id="eip-832">નવી આવૃત્તિ અપનાવવા માટેની વિગતવાર માર્ગદર્શિકા openstax.org પર શિક્ષકોના સંસાધન તરીકે ઉપલબ્ધ છે.</para>
      </section>
      <section id="eip-825">
        <title>મુખ્ય વિશેષતાઓ અને માહિતીનાં ચોકઠાં</title>
        <section id="eip-828">
          <title>ઉદાહરણો</title>
          <para id="eip-497">શીખવાના દરેક લક્ષ્ય માટે એક કે વધુ સંપૂર્ણ ઉકેલવાળાં ઉદાહરણો આપેલાં છે. વિદ્યાર્થીઓએ નિપુણતા મેળવવાની હોય તેવી પ્રશ્ન ઉકેલવાની રીતો તેમાં દર્શાવેલી છે. સામાન્ય રીતે દરેક લક્ષ્ય માટે અનેક ઉદાહરણો આપીએ છીએ, જેથી એક જ પ્રકારના પ્રશ્ન માટે જુદી રીતો દર્શાવી શકાય અથવા ધીમે ધીમે વધુ જટિલ બનતા સમાન પ્રકારના પ્રશ્નો રજૂ કરી શકાય.</para>
          <para id="eip-186">બધાં ઉદાહરણો બે કે ત્રણ ભાગના સરળ સ્વરૂપમાં છે. પહેલાં અમે પ્રશ્ન રજૂ કરીએ છીએ. પછી ઉકેલ દર્શાવીને એક-એક પગલું સમજાવીએ છીએ. અંતે, અમુક ઉદાહરણોમાં, ઉકેલ કેવી રીતે ચકાસવો તે બતાવીએ છીએ. મોટાભાગનાં ઉદાહરણો બે સ્તંભમાં લખેલાં છે: ડાબે સમજણ અને જમણે ગણિત. આ ગોઠવણી શિક્ષક વર્ગમાં બોર્ડ પર લખતાં લખતાં ઉદાહરણ સમજાવે છે તે રીતને અનુસરે છે.</para>
        </section>
        <section id="eip-85">
          <title>તૈયાર રહો!</title>
          <para id="eip-372">વિભાગ 2.1થી શરૂ કરીને દરેક વિભાગની શરૂઆતમાં “તૈયાર રહો!”ના થોડા પ્રશ્નો આપેલા છે, જેથી વિદ્યાર્થીઓ જાણી શકે કે તે વિભાગ માટે જરૂરી પૂર્વકૌશલ્યો તેમણે મેળવ્યાં છે કે નહીં. અગાઉના વિભાગોનાં ચોક્કસ ઉદાહરણોનો સંદર્ભ આપેલો છે, જેથી વધુ પુનરાવર્તનની જરૂર હોય એવા વિદ્યાર્થીઓ સમજણ સરળતાથી શોધી શકે. આ પ્રશ્નોના જવાબો પુસ્તક સાથેનાં પૂરક સંસાધનોમાં મળી શકે છે.</para>
        </section>
        <section id="eip-605">
          <title>જાતે અજમાવો</title>
          <para id="eip-207"><media id="eip-id11714328" alt="સફેદ ચોરસની વચ્ચે જમણી બાજુ અણી ધરાવતું ઘેરા રાખોડી રંગનું ચિહ્ન છે. ચોરસની આસપાસ આછા વાદળી રંગની નરમ છાંયાવાળી કિનારી છે. આ પ્રતીક સામાન્ય રીતે “આગળનું”, “આગળ” અથવા “વિસ્તારો” સૂચવે છે.">

              <image mime-type="image/png" src="../../media/tryit.png" />
            </media> “જાતે અજમાવો”નો પ્રશ્ન ઉદાહરણ પછી તરત આવે છે, જેથી વિદ્યાર્થીને એના જેવો પ્રશ્ન તરત ઉકેલવાની તક મળે. પુસ્તકના PDF અને વેબ સ્વરૂપમાં “જાતે અજમાવો”ના જવાબો જવાબસૂચિમાં આપેલા છે.</para>
        </section>
        <section id="eip-493">
          <title>કેવી રીતે કરવું</title>
          <para id="eip-109"><media id="eip-id11708242101" alt="તટસ્થ હાવભાવવાળી વ્યક્તિનું પ્રતીકાત્મક ચિત્ર. તેની બાજુમાં બોલવાનું દર્શાવતા ફુગ્ગામાં ત્રણ ટપકાં છે, જે વિચાર, જવાબની રાહ અથવા લખાઈ રહેલો સંદેશ સૂચવે છે.">

              <image mime-type="image/png" src="../../media/howtoicon.png" />

            </media>“કેવી રીતે કરવું” સામાન્ય રીતે “જાતે અજમાવો”ના અભ્યાસ પછી આવે છે. અગાઉના ઉદાહરણનો પ્રશ્ન ઉકેલવા માટેનાં પગલાંનો ક્રમ તેમાં આપેલો હોય છે.</para>
        </section>
        <section id="eip-660">
          <title>માધ્યમો</title>
          <para id="eip-606"><media id="eip-id1176034388" alt="સફેદ ચોરસની વચ્ચે જમણી બાજુ અણીવાળા ત્રિકોણનું વાદળી-લીલા રંગનું પ્લે પ્રતીક છે. તેની આસપાસ એ જ રંગની નરમ, ઝાંખી કિનારી છે. તે વિડિયો અથવા ઑડિયો શરૂ કરવાનું સૂચવે છે.">

              <image mime-type="image/png" src="../../media/media.png" />

            </media> “માધ્યમો”નું પ્રતીક દરેક વિભાગના અંતે, વિભાગના અભ્યાસ પહેલાં આવે છે. તે ઑનલાઇન વિડિયો પાઠોની કડીઓની યાદી દર્શાવે છે. આ પાઠો વિભાગમાં રજૂ કરેલી સંકલ્પનાઓ અને કૌશલ્યોને વધુ મજબૂત બનાવે છે.</para>
          <para id="eip-582">જવાબદારી અંગે સ્પષ્ટતા: અમે શીખવાનાં લક્ષ્યોને નજીકથી અનુરૂપ વિડિયો પાઠો પસંદ કર્યા છે, પરંતુ તે પાઠો અમે બનાવ્યા નથી. તે ખાસ કરીને નીચેના પુસ્તક સાથે વાપરવા માટે બનાવેલા કે બદલેલા પણ નથી: <emphasis effect="italics">Prealgebra 2e</emphasis>. </para>
          <para id="eip-801"><emphasis effect="bold">પોતાની સમજની તપાસ</emphasis>માં વિભાગનાં શીખવાનાં લક્ષ્યો આપેલાં છે, જેથી વિદ્યાર્થીઓ પોતાની નિપુણતા ચકાસી શકે અને સુધારા માટે ચોક્કસ યોજના બનાવી શકે.</para>
        </section>
      </section>
      <section id="eip-180">
        <title>આકૃતિઓની ગોઠવણી</title>
        <para id="fs-id1171791372805"><emphasis effect="italics">Elementary Algebra 2e</emphasis>માં ઘણી આકૃતિઓ અને ચિત્રો છે. આખા પુસ્તકનાં ચિત્રોમાં સ્પષ્ટ અને સાદી શૈલી રાખેલી છે, જેથી દરેક ચિત્રની સૌથી મહત્ત્વની માહિતી પર ધ્યાન જાય અને બિનજરૂરી દૃશ્ય વિગતો ઓછી રહે.</para>
        <media id="fs-id1171782146065" alt="આકૃતિમાં ત્રણ x y-નિર્દેશાંક સમતલ છે. પહેલામાં બે રેખા એક બિંદુએ છેદે છે. નીચે લખ્યું છે: “રેખાઓ છેદે છે. છેદતી રેખાઓને એક બિંદુ સામાન્ય હોય છે. આ સમીકરણસમૂહનો એક ઉકેલ છે.” બીજા સમતલમાં બે સમાંતર રેખા છે. નીચે લખ્યું છે: “રેખાઓ સમાંતર છે. સમાંતર રેખાઓને કોઈ બિંદુ સામાન્ય હોતું નથી. આ સમીકરણસમૂહનો કોઈ ઉકેલ નથી.” ત્રીજા સમતલમાં એક રેખા છે. નીચે લખ્યું છે: “બંને સમીકરણો એક જ રેખા આપે છે. માત્ર એક રેખા હોવાથી અનંત ઉકેલો છે.”">
          <image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_05_01_015_img.jpg" />
        </media>
      </section>
      <section id="eip-892">
        <title><emphasis effect="italics">વિભાગનો અભ્યાસ</emphasis></title>
        <para id="fs-id1171791358532">દરેક પ્રકરણના દરેક વિભાગના અંતે વિવિધ પ્રકારના અભ્યાસપ્રશ્નો આપેલા છે. તેઓ ગૃહકાર્ય તરીકે આપી શકાય અથવા પસંદ કરીને માર્ગદર્શન સાથે અભ્યાસ માટે વાપરી શકાય. આ પ્રશ્નસમૂહોને આપેલું નામ છે: <emphasis effect="italics">અભ્યાસથી નિપુણતા</emphasis> —જેથી ગૃહકાર્ય પૂરું કરવા પ્રોત્સાહન મળે.</para>
        <list id="fs-id1171784123283" list-type="bulleted" bullet-style="bullet">
          <item>અભ્યાસપ્રશ્નો શીખવાનાં લક્ષ્યો સાથે જોડાયેલા છે. તેનાથી દરેક વિદ્યાર્થીની જરૂરિયાત મુજબ વ્યક્તિગત અભ્યાસયોજના આપવી સરળ બને છે.</item>
          <item>કૌશલ્યો વિકસે તે માટે અભ્યાસપ્રશ્નોને કાળજીપૂર્વક ક્રમમાં ગોઠવેલા છે.</item>
          <item>અંકગણિતની મૂળ ગણતરીઓનો અભ્યાસ થાય અને તે વધુ પાકી થાય તે રીતે અચળ રાશિઓ અને સહગુણકોનાં મૂલ્યો પસંદ કરેલાં છે.</item>
          <item>બેકી અને એકી ક્રમાંકવાળા પ્રશ્નો જોડીમાં આપેલા છે.</item>
          <item>પ્રશ્નો પુસ્તકનાં ઉદાહરણોને અનુસરે છે અને તેમને આગળ વધારે છે. વિદ્યાર્થીઓ બંને વચ્ચેનો સંબંધ સહેલાઈથી ઓળખી શકે તે માટે ઉદાહરણો જેવી જ સૂચનાઓ વાપરેલી છે.</item>
          <item>વ્યવહારુ ઉપયોગના પ્રશ્નો રોજિંદા જીવનના અનેક અનુભવોમાંથી તેમજ કૉલેજનાં ગણિતનાં પુસ્તકોમાં પરંપરાગત રીતે અપાતા પ્રશ્નોમાંથી લીધેલા છે.</item>
          <item><emphasis effect="bold">રોજિંદા જીવનમાં ગણિત</emphasis> નામના ભાગમાં તે વિભાગની સંકલ્પનાઓ વાપરતી વ્યવહારુ પરિસ્થિતિઓ રજૂ કરેલી છે.</item>
          <item><emphasis effect="bold">લેખન અભ્યાસ</emphasis> દરેક પ્રશ્નસમૂહમાં આપેલા છે, જેથી સંકલ્પનાઓની સમજ, વિવેચનાત્મક વિચાર અને વાંચન-લેખનની ક્ષમતા વિકસે.</item>
        </list>

      </section>
      <section id="eip-339">
        <title><emphasis effect="italics">પ્રકરણના પુનરાવર્તનની વિશેષતાઓ</emphasis></title>
        <para id="eip-575">દરેક પ્રકરણના અંતે સૌથી મહત્ત્વના મુદ્દાઓનું પુનરાવર્તન અને વધારાના અભ્યાસપ્રશ્નો છે. વિદ્યાર્થીઓ તેનો ઉપયોગ પરીક્ષાની તૈયારી માટે કરી શકે છે.</para>
        <list id="eip-673">
          <item><emphasis effect="bold">મુખ્ય શબ્દો</emphasis>માં પ્રકરણના ઘાટા અક્ષરમાં લખેલા દરેક શબ્દની ઔપચારિક વ્યાખ્યા આપેલી છે.</item>
          <item><emphasis effect="bold">મુખ્ય સંકલ્પનાઓ</emphasis>માં દરેક વિભાગના સૌથી મહત્ત્વના વિચારોનો સાર છે. પુનરાવર્તનની જરૂર હોય તો સંબંધિત ઉદાહરણો સુધી જવાની કડી પણ આપેલી છે.</item>
          <item><emphasis effect="bold">પ્રકરણના પુનરાવર્તન અભ્યાસ</emphasis>માં દરેક વિભાગની સૌથી મહત્ત્વની સંકલ્પનાઓ યાદ કરાવતા અભ્યાસપ્રશ્નો છે.</item>
          <item><emphasis effect="bold">અભ્યાસ કસોટી</emphasis>માં પ્રકરણનાં સૌથી મહત્ત્વનાં શીખવાનાં લક્ષ્યોનું મૂલ્યાંકન કરતા વધારાના પ્રશ્નો છે.</item>
          <item><emphasis effect="bold">જવાબસૂચિ</emphasis>માં “જાતે અજમાવો”ના બધા પ્રશ્નોના તથા વિભાગના અભ્યાસ, પ્રકરણના પુનરાવર્તન અભ્યાસ અને અભ્યાસ કસોટીના એક છોડીને એક પ્રશ્નના જવાબો છે.</item>
        </list>
      </section>
      <section id="sect-00001">
        <title>પુસ્તકના પ્રશ્નોના જવાબો</title>
        <para id="para-00001">ઉદાહરણોના જવાબ પુસ્તકમાં પ્રશ્નની બરાબર નીચે આપેલા છે. “જાતે અજમાવો”ના બધા જવાબ જવાબસૂચિમાં છે. વિભાગના અભ્યાસ, પ્રકરણના પુનરાવર્તન અભ્યાસ અને અભ્યાસ કસોટીના એકી ક્રમાંકવાળા પ્રશ્નોના જવાબ વિદ્યાર્થીઓ માટે જવાબસૂચિમાં છે. બેકી ક્રમાંકવાળા પ્રશ્નોના જવાબ માત્ર શિક્ષકો માટેની જવાબ માર્ગદર્શિકામાં, શિક્ષકોનાં સંસાધનોના પાનાં દ્વારા, મળે છે.</para>
      </section>
    </section>
    <section id="eip-806">
      <title>વધારાનાં સંસાધનો</title>
      <section id="eip-666">
        <title>વિદ્યાર્થીઓ અને શિક્ષકો માટેનાં સંસાધનો</title>
        <para id="eip-990">વિદ્યાર્થીઓ અને શિક્ષકો બંને માટે વધારાનાં સંસાધનો એકત્ર કર્યાં છે. તેમાં શરૂઆત માટેની માર્ગદર્શિકાઓ, સાધનો વડે ગણિત શીખવતી કાર્યપત્રિકાઓ અને “તૈયાર રહો!”ના પ્રશ્નોની જવાબસૂચિ છે. શિક્ષકોનાં સંસાધનો માટે ચકાસાયેલ શિક્ષક ખાતું જરૂરી છે; openstax.orgમાં પ્રવેશ કરીને તેની વિનંતી કરી શકાય છે. તમારા OpenStax પુસ્તકના અભ્યાસને પૂરક બનાવવા આ સંસાધનો વાપરો. </para>
      </section>
      <section id="eip-447">
        <title>ભાગીદારોનાં સંસાધનો</title>
        <para id="eip-872">બધે વિદ્યાર્થીઓ અને શિક્ષકોને સારી ગુણવત્તાની અભ્યાસસામગ્રી પરવડે તેવી કિંમતે અને સરળતાથી મળે તે ધ્યેયમાં OpenStaxના ભાગીદારો અમારા સહયોગી છે. તેમનાં સાધનો ઓછી કિંમતે અમારાં OpenStax પુસ્તકો સાથે સરળતાથી કામ કરે છે. તમારા પુસ્તકનાં ભાગીદાર સંસાધનો મેળવવા openstax.org પર તેના પાનાની મુલાકાત લો. </para>
      </section>
    </section>
    <section id="eip-653">
      <title>લેખકો વિશે</title>
      <section id="eip-957" class="sr-contrib-auth">
        <title>વરિષ્ઠ યોગદાનકર્તા લેખકો</title>
        <para id="eip-417">Lynn Marecek અને MaryAnne Anthony-Smith ઘણાં વર્ષોથી Santa Ana Collegeમાં ગણિત ભણાવે છે. પ્રારંભિક સહાયક ગણિતના અભ્યાસક્રમોમાં વિદ્યાર્થીઓનું શીખવું સુધારવાના અનેક પ્રકલ્પોમાં તેમણે સાથે કામ કર્યું છે. તેઓ આ પુસ્તકનાં લેખકો છે: <emphasis effect="italics">Strategies for Success: Study Skills for the College Math Student</emphasis>; તેને Pearson HigherEdએ પ્રકાશિત કર્યું છે.</para>
        <para id="eip-855"><emphasis effect="bold">Lynn Marecek, Santa Ana College</emphasis></para>
        <para id="eip-250"><emphasis effect="bold">MaryAnne Anthony-Smith, Santa Ana College</emphasis></para>
        <para id="eip-478"><emphasis effect="bold">Andrea Honeycutt Mathis, Northeast Mississippi Community College</emphasis></para>
      </section>
      <section id="fs-id1169977069259">
        <title>સમીક્ષકો</title>
        <para id="eip-id1169146105286">Jay Abramson, Arizona State University<newline /> Bryan Blount, Kentucky Wesleyan College<newline /> Gale Burtch, Ivy Tech Community College<newline /> Tamara Carter, Texas A&amp;M University<newline /> Danny Clarke, Truckee Meadows Community College<newline /> Michael Cohen, Hofstra University<newline /> Christina Cornejo, Erie Community College<newline /> Denise Cutler, Bay de Noc Community College<newline /> Lance Hemlow, Raritan Valley Community College<newline /> John Kalliongis, Saint Louis Iniversity<newline /> Stephanie Krehl, Mid-South Community College<newline /> Laurie Lindstrom, Bay de Noc Community College<newline /> Beverly Mackie, Lone Star College System<newline /> Allen Miller, Northeast Lakeview College<newline /> Christian Roldán-Johnson, College of Lake County Community College<newline /> Martha Sandoval-Martinez, Santa Ana College<newline /> Gowribalan Vamadeva, University of Cincinnati Blue Ash College<newline /> Kim Watts, North Lake College<newline /> Libby Watts, Tidewater Community College<newline /> Allen Wolmer, Atlantic Jewish Academy<newline /> John Zarske, Santa Ana College<newline /></para>
      </section>
    </section>
  </content>

</document>