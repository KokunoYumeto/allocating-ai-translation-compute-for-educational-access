<problem id="fs-id1170652627511">
<para id="fs-id1170652627513"><m:math><m:mrow><m:mn>37.5</m:mn><m:mo>+</m:mo><m:mn>12.23</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
