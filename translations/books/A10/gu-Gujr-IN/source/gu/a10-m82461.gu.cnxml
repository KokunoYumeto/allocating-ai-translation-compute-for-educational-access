<problem id="fs-id1170654233314">
<para id="fs-id1170654233316"><m:math><m:mrow><m:mn>256.37</m:mn><m:mo>−</m:mo><m:mn>85.49</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170652629925">
<problem id="fs-id1170652629928">
<para id="fs-id1170652621077"><m:math><m:mrow><m:mn>15.35</m:mn><m:mo>−</m:mo><m:mn>20.88</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170652621088">
<para id="fs-id1170652621090">−5.53</para>
</solution>
</exercise>
