<para id="fs-id1170653795725"><m:math><m:mrow><m:mn>25</m:mn><m:mtext>°</m:mtext></m:mrow></m:math> સેલ્સિયસ</para>
</problem>
</exercise>
<exercise id="fs-id1170653901546">
<problem id="fs-id1170652657537">
<para id="fs-id1170652657539"><m:math><m:mrow><m:mtext>−</m:mtext><m:mn>10</m:mn><m:mtext>°</m:mtext></m:mrow></m:math> સેલ્સિયસ</para>
</problem>
<solution id="fs-id1170653767670">
<para id="fs-id1170653767672"><m:math><m:mrow><m:mn>14</m:mn><m:mtext>°</m:mtext><m:mtext>F</m:mtext></m:mrow></m:math>
</para>
</solution>
</exercise>
<exercise id="fs-id1170654166277">
<problem id="fs-id1170654166279">
<para id="fs-id1170654166281"><m:math><m:mrow><m:mtext>−</m:mtext><m:mn>15</m:mn><m:mtext>°</m:mtext></m:mrow></m:math> સેલ્સિયસ</para>
</problem>
</exercise>
<exercise id="fs-id1170654114551">
<problem id="fs-id1170654114553">
<para id="fs-id1170654166308"><m:math><m:mrow><m:mn>22</m:mn><m:mtext>°</m:mtext></m:mrow></m:math> સેલ્સિયસ</para>
</problem>
<solution id="fs-id1170654008905">
<para id="fs-id1170654008907"><m:math><m:mrow><m:mn>71.6</m:mn><m:mtext>°</m:mtext><m:mtext>F</m:mtext></m:mrow></m:math>
</para>
</solution>
</exercise>
<exercise id="fs-id1170653772193">
<problem id="fs-id1170653772196">
<para id="fs-id1170653772198"><m:math><m:mrow><m:mn>8</m:mn><m:mtext>°</m:mtext></m:mrow></m:math> સેલ્સિયસ</para>
</problem>
</exercise>
<exercise id="fs-id1170654014485">
<problem id="fs-id1170653990777">
<para id="fs-id1170653990779"><m:math><m:mrow><m:mn>43</m:mn><m:mtext>°</m:mtext></m:mrow></m:math> સેલ્સિયસ</para>
</problem>
<solution id="fs-id1170653991470">
<para id="fs-id1170652664077"><m:math><m:mrow><m:mn>109.4</m:mn><m:mtext>°</m:mtext><m:mtext>F</m:mtext></m:mrow></m:math>
</para>
</solution>
</exercise>
<exercise id="fs-id1170653886847">
