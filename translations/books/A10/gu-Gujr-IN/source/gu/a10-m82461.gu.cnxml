<?xml version='1.0' encoding='utf-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" xmlns:md="http://cnx.rice.edu/mdml" xml:lang="gu-Gujr-IN">

<title>માપન પદ્ધતિઓ</title>
<metadata>
  <md:content-id>m82461</md:content-id>
  <md:title>માપન પદ્ધતિઓ</md:title>
  <md:abstract><para id="para-00001">આ વિભાગના અંતે તમે આ કરી શકશો:</para>
<list id="list-00001">
<item>યુ.એસ. પદ્ધતિમાં એકમોનું રૂપાંતર કરવું</item>
<item>યુ.એસ. પદ્ધતિમાં માપનના મિશ્ર એકમો વાપરવા</item>
<item>મેટ્રિક પદ્ધતિમાં એકમોનું રૂપાંતર કરવું</item>
<item>મેટ્રિક પદ્ધતિમાં માપનના મિશ્ર એકમો વાપરવા</item>
<item>યુ.એસ. અને મેટ્રિક માપન પદ્ધતિઓ વચ્ચે રૂપાંતર કરવું</item>
<item>ફેરનહીટ અને સેલ્સિયસ તાપમાન વચ્ચે રૂપાંતર કરવું</item>
</list></md:abstract>
  <md:uuid>69fe7540-4ca9-4cf1-8e7c-cfd3d94cf3fc</md:uuid>
</metadata>

<content>
<note id="fs-id1170653756314" class="be-prepared">
<para id="fs-id1170653756100">આ વિભાગના વિષયોનો વધુ વિગતવાર પરિચય <emphasis effect="italics">પૂર્વબીજગણિત</emphasis> પુસ્તકના આ પ્રકરણમાં મળે છે: <emphasis effect="bold">વાસ્તવિક સંખ્યાઓના ગુણધર્મો</emphasis>.</para>
</note>
<section id="fs-id1170654126241">
<title>યુ.એસ. પદ્ધતિમાં એકમોનું રૂપાંતર કરો</title>
<para id="fs-id1170653740434">વિશ્વભરમાં સામાન્ય રીતે બે માપન પદ્ધતિઓ વપરાય છે. મોટા ભાગના દેશો મેટ્રિક પદ્ધતિ વાપરે છે. યુ.એસ.માં બીજી માપન પદ્ધતિ વપરાય છે, જેને સામાન્ય રીતે <term id="term-00001">યુ.એસ. પદ્ધતિ</term> કહેવાય છે. પહેલાં યુ.એસ. પદ્ધતિ જોઈએ.</para>
<para id="fs-id1170653846703">યુ.એસ. માપન પદ્ધતિમાં લંબાઈ માપવા ઇંચ, ફૂટ, યાડ અને માઈલ તથા વજન માપવા પાઉન્ડ અને ટન વપરાય છે. ક્ષમતા માટે કપ, પિન્ટ, ક્વૉર્ટ અને ગૅલન વપરાય છે. યુ.એસ. અને મેટ્રિક બંને પદ્ધતિઓમાં સમય સેકન્ડ, મિનિટ અને કલાકમાં મપાય છે.</para>
<para id="fs-id1170653916421">માપનનાં સમકક્ષ મૂલ્યો <link target-id="fs-id1170654027716" />માં બતાવ્યાં છે. કોષ્ટકમાં દરેક માપનનું સામાન્ય સંક્ષિપ્ત રૂપ કૌંસમાં આપ્યું છે.</para>
<table id="fs-id1170654027716" aria-label="આ કોષ્ટક યુ.એસ. માપન પદ્ધતિ બતાવે છે. લંબાઈ: 1 ફૂટ (ft.) = 12 ઇંચ (in.), 1 યાડ (yd.) = 3 ફૂટ, અને 1 માઈલ (mi.) = 5,280 ફૂટ. ક્ષમતા: 3 નાના ચમચા (t) = 1 મોટો ચમચો (T), 16 મોટા ચમચા = 1 કપ (C), 1 કપ = 8 પ્રવાહી ઔંસ (fl. oz.), 1 પિન્ટ (pt.) = 2 કપ, 1 ક્વૉર્ટ (qt.) = 2 પિન્ટ, અને 1 ગૅલન (gal) = 4 ક્વૉર્ટ. વજન: 1 પાઉન્ડ (lb.) = 16 ઔંસ (oz.) અને 1 ટન = 2,000 પાઉન્ડ. સમય: 1 મિનિટ (min) = 60 સેકન્ડ (sec), 1 કલાક (hr) = 60 મિનિટ, 1 દિવસ = 24 કલાક, 1 અઠવાડિયું (wk) = 7 દિવસ અને 1 વર્ષ (yr) = 365 દિવસ.">
<tgroup cols="2">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<thead>
<row valign="top">
<entry align="center" valign="top" namest="c1" nameend="c2">યુ.એસ. માપન પદ્ધતિ</entry>
</row>
</thead>
<tbody>
<row valign="top">
<entry valign="middle" align="left"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="left"><m:mtext mathvariant="bold">લંબાઈ</m:mtext></m:mtd><m:mtd /><m:mtd columnalign="left"><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>1</m:mn><m:mspace width="0.2em" /><m:mtext>ફૂટ</m:mtext><m:mspace width="0.2em" /><m:mtext>(ft.)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>12</m:mn><m:mspace width="0.2em" /><m:mtext>ઇંચ</m:mtext><m:mspace width="0.2em" /><m:mtext>(in.)</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>1</m:mn><m:mspace width="0.2em" /><m:mtext>યાડ</m:mtext><m:mspace width="0.2em" /><m:mtext>(yd.)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>3</m:mn><m:mspace width="0.2em" /><m:mtext>ફૂટ</m:mtext><m:mspace width="0.2em" /><m:mtext>(ft.)</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>1</m:mn><m:mspace width="0.2em" /><m:mtext>માઈલ</m:mtext><m:mspace width="0.2em" /><m:mtext>(mi.)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>5,280</m:mn><m:mspace width="0.2em" /><m:mtext>ફૂટ</m:mtext><m:mspace width="0.2em" /><m:mtext>(ft.)</m:mtext></m:mtd></m:mtr></m:mtable></m:mtd></m:mtr></m:mtable></m:mrow></m:math></entry>
<entry valign="middle" align="left"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="left"><m:mtext mathvariant="bold">ક્ષમતા</m:mtext></m:mtd><m:mtd /><m:mtd columnalign="left"><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>3</m:mn><m:mspace width="0.2em" /><m:mtext>નાના ચમચા</m:mtext><m:mspace width="0.2em" /><m:mtext>(t)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mn>1</m:mn><m:mspace width="0.2em" /><m:mtext>મોટો ચમચો</m:mtext><m:mspace width="0.2em" /><m:mtext>(T)</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>16 મોટા ચમચા</m:mtext><m:mspace width="0.2em" /><m:mtext>(T)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>1 કપ</m:mtext><m:mspace width="0.2em" /><m:mtext>(C)</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>1 કપ</m:mtext><m:mspace width="0.2em" /><m:mtext>(C)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>8 પ્રવાહી ઔંસ</m:mtext><m:mspace width="0.2em" /><m:mtext>(fl. oz.)</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>1 પિન્ટ</m:mtext><m:mspace width="0.2em" /><m:mtext>(pt.)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>2 કપ</m:mtext><m:mspace width="0.2em" /><m:mtext>(C)</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>1 ક્વૉર્ટ</m:mtext><m:mspace width="0.2em" /><m:mtext>(qt.)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>2 પિન્ટ</m:mtext><m:mspace width="0.2em" /><m:mtext>(pt.)</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>1 ગૅલન</m:mtext><m:mspace width="0.2em" /><m:mtext>(gal)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>4 ક્વૉર્ટ</m:mtext><m:mspace width="0.2em" /><m:mtext>(qt.)</m:mtext></m:mtd></m:mtr></m:mtable></m:mtd></m:mtr></m:mtable></m:mrow></m:math></entry>
</row>
<row valign="top">
<entry valign="middle" align="left"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="left"><m:mtext mathvariant="bold">વજન</m:mtext></m:mtd><m:mtd /><m:mtd columnalign="left"><m:mtable><m:mtr><m:mtd columnalign="left"><m:mtext>1 પાઉન્ડ</m:mtext><m:mspace width="0.2em" /><m:mtext>(lb.)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>16 ઔંસ</m:mtext><m:mspace width="0.2em" /><m:mtext>(oz.)</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>1 ટન</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>2,000 પાઉન્ડ</m:mtext><m:mspace width="0.2em" /><m:mtext>(lb.)</m:mtext></m:mtd></m:mtr></m:mtable></m:mtd></m:mtr></m:mtable></m:mrow></m:math>
</entry>
<entry valign="middle" align="left"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="left"><m:mtext mathvariant="bold">સમય</m:mtext></m:mtd><m:mtd /><m:mtd columnalign="left"><m:mspace width="1em" /><m:mtable><m:mtr><m:mtd columnalign="left"><m:mtext>1 મિનિટ</m:mtext><m:mspace width="0.2em" /><m:mtext>(min)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>60 સેકન્ડ</m:mtext><m:mspace width="0.2em" /><m:mtext>(sec)</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>1 કલાક</m:mtext><m:mspace width="0.2em" /><m:mtext>(hr)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>60 મિનિટ</m:mtext><m:mspace width="0.2em" /><m:mtext>(min)</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>1 દિવસ</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>24 કલાક</m:mtext><m:mspace width="0.2em" /><m:mtext>(hr)</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>1 અઠવાડિયું</m:mtext><m:mspace width="0.2em" /><m:mtext>(wk)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>7 દિવસ</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>1 વર્ષ</m:mtext><m:mspace width="0.2em" /><m:mtext>(yr)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>365 દિવસ</m:mtext></m:mtd></m:mtr></m:mtable></m:mtd></m:mtr></m:mtable></m:mrow></m:math>
</entry>
</row>
</tbody>
</tgroup>
</table>
<para id="fs-id1170654047456">રોજિંદા જીવનમાં ઘણી વાર ફૂટ અને યાડ, મિનિટ અને સેકન્ડ, ક્વૉર્ટ અને ગૅલન જેવા માપનના એકમો વચ્ચે રૂપાંતર કરવું પડે છે. આ રૂપાંતર માટે ગુણાકારની તટસ્થ સંખ્યાનો ગુણધર્મ વાપરીશું. સરળ સંદર્ભ માટે તે ગુણધર્મ ફરી લખીએ.</para>
<note id="fs-id1170653916750">
<title>ગુણાકાર માટે તટસ્થ સંખ્યાનો ગુણધર્મ</title>
<para id="fs-id1166422851511"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="left"><m:mtext>કોઈ પણ વાસ્તવિક સંખ્યા</m:mtext><m:mspace width="0.2em" /><m:mi>a</m:mi><m:mo>:</m:mo></m:mtd><m:mtd /><m:mtd /><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mi>a</m:mi><m:mo>·</m:mo><m:mn>1</m:mn><m:mo>=</m:mo><m:mi>a</m:mi><m:mspace width="3em" /><m:mn>1</m:mn><m:mo>·</m:mo><m:mi>a</m:mi><m:mo>=</m:mo><m:mi>a</m:mi></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mstyle mathvariant="bold" mathsize="normal"><m:mn>1</m:mn></m:mstyle><m:mspace width="0.2em" /><m:mtext>એ</m:mtext><m:mspace width="0.2em" /><m:mtext mathvariant="bold">ગુણાકાર માટેની તટસ્થ સંખ્યા</m:mtext></m:mtd><m:mtd /><m:mtd /><m:mtd /><m:mtd /><m:mtd /></m:mtr></m:mtable></m:mrow></m:math></para>
</note>
<para id="fs-id1170653791367">ગુણાકાર માટે તટસ્થ સંખ્યાનો ગુણધર્મ વાપરતી વખતે 1ને એવા રૂપમાં લખીએ છીએ જે એકમોનું રૂપાંતર કરવામાં મદદ કરે. ધારો કે ઇંચને ફૂટમાં ફેરવવા છે. 1 ફૂટ 12 ઇંચ બરાબર છે, એટલે 1ને નીચેના અપૂર્ણાંક તરીકે લખીશું: <m:math><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn><m:mspace width="0.2em" /><m:mtext>ફૂટ</m:mtext></m:mrow><m:mrow><m:mn>12</m:mn><m:mspace width="0.2em" /><m:mtext>ઇંચ</m:mtext></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math> આ અપૂર્ણાંક વડે ગુણવાથી મૂલ્ય બદલાતું નથી; ફક્ત એકમો બદલાય છે.</para>
<para id="fs-id1170653875590">પરંતુ <m:math><m:mrow><m:mfrac><m:mrow><m:mn>12</m:mn><m:mspace width="0.2em" /><m:mtext>ઇંચ</m:mtext></m:mrow><m:mrow><m:mn>1</m:mn><m:mspace width="0.2em" /><m:mtext>ફૂટ</m:mtext></m:mrow></m:mfrac></m:mrow></m:math> પણ 1 બરાબર છે. નીચેના બે ગુણાકારમાંથી કયો કરવો: <m:math><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn><m:mspace width="0.2em" /><m:mtext>ફૂટ</m:mtext></m:mrow><m:mrow><m:mn>12</m:mn><m:mspace width="0.2em" /><m:mtext>ઇંચ</m:mtext></m:mrow></m:mfrac></m:mrow></m:math> અથવા <m:math><m:mrow><m:mfrac><m:mrow><m:mn>12</m:mn><m:mspace width="0.2em" /><m:mtext>ઇંચ</m:mtext></m:mrow><m:mrow><m:mn>1</m:mn><m:mspace width="0.2em" /><m:mtext>ફૂટ</m:mtext></m:mrow></m:mfrac><m:mo>?</m:mo></m:mrow></m:math> રૂપાંતર કરતાં આપણે એવો અપૂર્ણાંક પસંદ કરીએ જેથી <emphasis effect="italics">આપેલો એકમ</emphasis> રૂપાંતર દરમિયાન છેદાઈ જાય. એકમ દર્શાવતા શબ્દોને <term class="no-emphasis" id="term-00002">અવયવ</term> ગણો અને સામાન્ય અવયવોની જેમ સામાન્ય એકમોને “છેદી” નાખો. જો <m:math><m:mrow><m:mn>66</m:mn></m:mrow></m:math> ઇંચને ફૂટમાં ફેરવવા હોય, તો કયો ગુણાકાર ઇંચ દૂર કરશે?</para>
<media id="fs-id1170653895402" alt="બે પદાવલીઓ છે: 66 ઇંચ·(1 ફૂટ)/(12 ઇંચ) અને 66 ઇંચ·(12 ઇંચ)/(1 ફૂટ). બીજી પદાવલી પર લાલ ચોકડી છે. નીચે પહેલી પદાવલી ફરી છે અને અંશ-છેદના ઇંચ લાલ રેખાથી છેદેલા છે; આ રૂપ કામ કરે છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_10_016_img_new.jpg" />
</media>
<para id="fs-id1170653851306">ઇંચ છેદાઈ જાય છે અને માત્ર ફૂટ બાકી રહે છે. બીજા રૂપમાં છેદાય એવો કોઈ એકમ નથી, એટલે તે મદદરૂપ નથી.</para>
<example id="fs-id1170654038452">
<title>એકમોનું રૂપાંતર કેવી રીતે કરવું</title>
<exercise id="fs-id1170653749262">
<problem id="fs-id1170652619424">
<para id="fs-id1170654013255">મૅરીઍનની ઊંચાઈ 66 ઇંચ છે. તેની ઊંચાઈને ફૂટમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170653806518">
<title>ઉકેલ</title>
<media id="fs-id1170654071984" alt="ત્રણ કૉલમના કોષ્ટકમાં પગલું 1 છે: “રૂપાંતર કરવાના માપનનો 1 સાથે ગુણાકાર કરો; આપેલા અને જોઈતા એકમોને જોડતા અપૂર્ણાંક તરીકે 1 લખો.” વચ્ચે સમજ છે: “66 ઇંચનો 1 સાથે ગુણાકાર કરો અને 1ને ઇંચ તથા ફૂટને જોડતા અપૂર્ણાંક તરીકે લખો. ઇંચ છેદાઈ જાય તે માટે છેદમાં ઇંચ જોઈએ!” જમણે 66 ઇંચ·1 અને 66 ઇંચ·(1 ફૂટ)/(12 ઇંચ) છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_10_017a_img_new.jpg" />
</media>
<media id="fs-id1170654026865" alt="આગળ “પગલું 2. ગુણાકાર કરો.” સૂચના છે. મદદરૂપ નોંધ કહે છે: “66 ઇંચને 66 ઇંચ/1 ગણો.” ગણતરી (66 ઇંચ × 1 ફૂટ)/(12 ઇંચ) છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_10_017b_img_new.jpg" />
</media>
<media id="fs-id1170654030491" alt="આગળ “પગલું 3. અપૂર્ણાંકનું સાદું રૂપ આપો.” સૂચના છે. નોંધ કહે છે: “ઇંચ છેદાઈ જાય છે.” પરિણામ 66 ફૂટ/12 છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_10_017c_img_new.jpg" />
</media>
<media id="fs-id1170653797102" alt="છેલ્લે “પગલું 4. સાદું રૂપ આપો.” અને “66ને 12 વડે ભાગો.” લખ્યું છે. અંતિમ પરિણામ 5.5 ફૂટ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_10_017d_img_new.jpg" />
</media>
</solution>
</exercise>
</example>
<note id="fs-id1170653845964" class="try">
<exercise id="fs-id1170654048412">
<problem id="fs-id1170654069080">
<para id="fs-id1170654235450">લેક્સીની ઊંચાઈ 30 ઇંચ છે. તેની ઊંચાઈને ફૂટમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170654202421">
<para id="fs-id1170653768687">2.5 ફૂટ</para>
</solution>
</exercise>
</note>
<note id="fs-id1170654075151" class="try">
<exercise id="fs-id1170654037129">
<problem id="fs-id1170653736114">
<para id="fs-id1170654012903">રેનેએ 18 યાડ લાંબી નળી ખરીદી. લંબાઈને ફૂટમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170654030911">
<para id="fs-id1170653849545">54 ફૂટ</para>
</solution>
</exercise>
</note>
<note id="fs-id1170654239459" class="howto">
<title>એકમોનું રૂપાંતર કરો.</title>
<list id="fs-id1166422695049" list-type="enumerated" number-style="arabic" class="stepwise">
<item>રૂપાંતર કરવાના માપનનો 1 સાથે ગુણાકાર કરો; આપેલા અને જોઈતા એકમોને જોડતા અપૂર્ણાંક તરીકે 1 લખો.</item>
<item>ગુણાકાર કરો.</item>
<item>અપૂર્ણાંકનું સાદું રૂપ આપો.</item>
<item>સાદું રૂપ આપો.</item>
</list>
</note>
<para id="fs-id1170653814859">એકમોનું રૂપાંતર કરવા ગુણાકારની તટસ્થ સંખ્યાનો ગુણધર્મ વાપરીએ ત્યારે જે એકમમાંથી ફેરવવાનું છે તે છેદાઈ જાય તેની ખાતરી કરવી જોઈએ. સામાન્ય રીતે તેનો અર્થ છે કે રૂપાંતર-અપૂર્ણાંકના છેદમાં એ એકમ હોવો જોઈએ.</para>
<example id="fs-id1170653740449">
<exercise id="fs-id1170654236695">
<problem id="fs-id1170654016452">
<para id="fs-id1170654237975">સાન ડિએગો સફારી પાર્કની હાથીણ ન્ડુલાનું વજન લગભગ 3.2 ટન છે. તેનું વજન પાઉન્ડમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170654026793">
<title>ઉકેલ</title>
<para id="fs-id1170654284514">3.2 ટનને પાઉન્ડમાં ફેરવીશું. ગુણાકારની તટસ્થ સંખ્યાનો ગુણધર્મ વાપરીને 1ને નીચેના અપૂર્ણાંક તરીકે લખીશું: <m:math><m:mrow><m:mfrac><m:mrow><m:mn>2000</m:mn><m:mspace width="0.2em" /><m:mtext>પાઉન્ડ</m:mtext></m:mrow><m:mrow><m:mn>1</m:mn><m:mspace width="0.2em" /><m:mtext>ટન</m:mtext></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math><newline />
<table id="eip-id1169750866374" class="unnumbered unstyled" aria-label="બે કૉલમના કોષ્ટકમાં ડાબે સૂચનાઓ અને જમણે ગણતરીનાં પગલાં છે. પહેલાં “રૂપાંતર કરવાના માપનનો 1 સાથે ગુણાકાર કરો.” અને જમણે 3.2 ટન, પછી 3.2 ટન ગુણ્યા 1 છે. આગળ “1ને ટન અને પાઉન્ડને જોડતા અપૂર્ણાંક તરીકે લખો.” અને 3.2 ટન ગુણ્યા (2,000 પાઉન્ડ)/(1 ટન) છે. પછી “સાદું રૂપ આપો.” અને (3.2 ટન × 2,000 પાઉન્ડ)/(1 ટન)માં ટનના એકમો છેદેલા છે. છેલ્લે “ગુણાકાર કરો.” અને 6,400 પાઉન્ડ મળે છે. તેથી ન્ડુલાનું વજન લગભગ 6,400 પાઉન્ડ છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry align="center"><m:math><m:mtext>3.2 ટન</m:mtext></m:math></entry>
  </row>
  <row>
    <entry>રૂપાંતર કરવાના માપનનો 1 સાથે ગુણાકાર કરો.</entry>
    <entry align="center"><m:math><m:mtext>3.2 ટન</m:mtext><m:mo>⋅</m:mo><m:mn>1</m:mn></m:math></entry>
  </row>
  <row>
    <entry>1ને ટન અને પાઉન્ડને જોડતા અપૂર્ણાંક તરીકે લખો.</entry>
    <entry align="center"><m:math><m:mtext>3.2 ટન</m:mtext><m:mo>⋅</m:mo><m:mfrac><m:mtext>2,000 પાઉન્ડ</m:mtext><m:mtext>1 ટન</m:mtext></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>સાદું રૂપ આપો.</entry>
    <entry align="center"><media id="eip-id1169750866446" alt="એકમ-રૂપાંતરની પદાવલીમાં 3.2 ટનનો (2,000 પાઉન્ડ)/(1 ટન) સાથે ગુણાકાર છે. 3.2 ટનને પાઉન્ડમાં ફેરવવા ટનના બંને એકમ છેદેલા છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_018_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry align="center"><m:math><m:mtext>6,400 પાઉન્ડ</m:mtext></m:math></entry>
  </row>
  <row>
    <entry />
    <entry align="center">ન્ડુલાનું વજન લગભગ 6,400 પાઉન્ડ છે.</entry>
  </row>
 </tbody>

</tgroup>
</table>
</para></solution>
</exercise>
</example>
<note id="fs-id1170653805697" class="try">
<exercise id="fs-id1170653875525">
<problem id="fs-id1170653909784">
<para id="fs-id1170653894637">આર્નોલ્ડની એસયુવીનું વજન લગભગ 4.3 ટન છે. વજનને પાઉન્ડમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170654114644">
<para id="fs-id1170654012646">8,600 પાઉન્ડ</para>
</solution>
</exercise>
</note>
<note id="fs-id1170653832701" class="try">
<exercise id="fs-id1170653906365">
<problem id="fs-id1170653737164">
<para id="fs-id1170653871089">કાર્નિવલ <emphasis effect="italics">ડેસ્ટિની</emphasis> ક્રૂઝ જહાજનું વજન 51,000 ટન છે. વજનને પાઉન્ડમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170654031734">
<para id="fs-id1170653905491">102,000,000 પાઉન્ડ</para>
</solution>
</exercise>
</note>
<para id="fs-id1170653892484">કેટલીક વાર એક એકમમાંથી બીજા એકમમાં ફેરવવા વચ્ચે બીજા ઘણા એકમો વાપરવા પડે છે, એટલે ઘણા અપૂર્ણાંકોનો ગુણાકાર કરવો પડે છે.</para>
<example id="fs-id1170653884339">
<exercise id="fs-id1170653837665">
<problem id="fs-id1170654078868">
<para id="fs-id1170653906724">જુલિયેટ પોતાના પરિવાર સાથે ઉનાળાના ઘરે જાય છે. તે પોતાના પ્રેમીથી 9 અઠવાડિયાં દૂર રહેશે. સમયને મિનિટમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170653815775">
<title>ઉકેલ</title>
<para id="fs-id1170653896344">અઠવાડિયાંને મિનિટમાં ફેરવવા પહેલાં અઠવાડિયાંને દિવસમાં, દિવસને કલાકમાં અને પછી કલાકને મિનિટમાં ફેરવીશું. આ માટે 1 બરાબર એવા રૂપાંતર અવયવોનો ગુણાકાર કરીશું.<newline />

<table id="eip-id1169753123087" class="unnumbered unstyled" aria-label="9 અઠવાડિયાં આપેલાં છે. બે કૉલમના કોષ્ટકમાં ડાબે સૂચનાઓ અને જમણે ગણતરી છે. પહેલાં “1ને (7 દિવસ)/(1 અઠવાડિયું), (24 કલાક)/(1 દિવસ) અને (60 મિનિટ)/(1 કલાક) તરીકે લખો.” જમણે (9 અઠવાડિયાં/1) × (7 દિવસ/1 અઠવાડિયું) × (24 કલાક/1 દિવસ) × (60 મિનિટ/1 કલાક) છે. આગળ “સામાન્ય એકમો છેદી નાખો.” અને એ જ ગુણાકારમાં અઠવાડિયાં, દિવસ અને કલાક છેદેલા છે. પછી “ગુણાકાર કરો.” અને (9 × 7 × 24 × 60 મિનિટ)/(1 × 1 × 1 × 1) છે. છેલ્લે “સાદું રૂપ આપો.” અને 90,720 મિનિટ મળે છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry align="center">9 અઠવાડિયાં.</entry>
  </row>
  <row>
    <entry>સંખ્યા <m:math><m:mn>1</m:mn></m:math> ને નીચે પ્રમાણે લખો: <m:math><m:mfrac><m:mtext>7 દિવસ</m:mtext><m:mtext>1 અઠવાડિયું</m:mtext></m:mfrac></m:math>, <m:math><m:mfrac><m:mtext>24 કલાક</m:mtext><m:mtext>1 દિવસ</m:mtext></m:mfrac></m:math>, અને <m:math><m:mfrac><m:mtext>60 મિનિટ</m:mtext><m:mtext>1 કલાક</m:mtext></m:mfrac></m:math>.</entry>
    <entry align="center"><m:math><m:mfrac><m:mtext>9 અઠવાડિયાં</m:mtext><m:mn>1</m:mn></m:mfrac><m:mo>⋅</m:mo><m:mfrac><m:mtext>7 દિવસ</m:mtext><m:mtext>1 અઠવાડિયું</m:mtext></m:mfrac><m:mo>⋅</m:mo><m:mfrac><m:mtext>24 કલાક</m:mtext><m:mtext>1 દિવસ</m:mtext></m:mfrac><m:mo>⋅</m:mo><m:mfrac><m:mtext>60 મિનિટ</m:mtext><m:mtext>1 કલાક</m:mtext></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry align="left">સામાન્ય એકમો છેદી નાખો.</entry>
    <entry align="center"><media id="eip-id1169753123179" alt="પરિમાણીય વિશ્લેષણથી 9 અઠવાડિયાંને મિનિટમાં ફેરવ્યું છે. અપૂર્ણાંકોની શ્રેણીમાં અઠવાડિયાંને દિવસમાં, દિવસને કલાકમાં અને કલાકને મિનિટમાં ફેરવતાં દરેક પગલે એકમો છેદી નાખ્યા છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_001_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry align="center"><m:math><m:mfrac><m:mrow><m:mn>9</m:mn><m:mo>⋅</m:mo><m:mn>7</m:mn><m:mo>⋅</m:mo><m:mn>24</m:mn><m:mo>⋅</m:mo><m:mtext>60 મિનિટ</m:mtext></m:mrow><m:mrow><m:mn>1</m:mn><m:mo>⋅</m:mo><m:mn>1</m:mn><m:mo>⋅</m:mo><m:mn>1</m:mn><m:mo>⋅</m:mo><m:mn>1</m:mn></m:mrow></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry align="center"><m:math><m:mtext>90,720 મિનિટ</m:mtext></m:math></entry>
  </row>

 </tbody>




</tgroup>
</table></para><para id="fs-id1170654066877">જુલિયેટ અને તેનો પ્રેમી 90,720 મિનિટ દૂર રહેશે (ભલે આ સમય અનંત જેવો લાગે!).</para>
</solution>
</exercise>
</example>
<note id="fs-id1170654190201" class="try">
<exercise id="fs-id1170653913514">
<problem id="fs-id1170654026286">
<para id="fs-id1170654010958">પૃથ્વી અને ચંદ્ર વચ્ચેનું અંતર લગભગ 250,000 માઈલ છે. આ લંબાઈને યાડમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170654012247">
<para id="fs-id1170654026042">440,000,000 યાડ</para>
</solution>
</exercise>
</note>
<note id="fs-id1170653791122" class="try">
<exercise id="fs-id1170653899856">
<problem id="fs-id1170654031116">
<para id="fs-id1170653923366">આંતરરાષ્ટ્રીય અવકાશ મથકના એક્સપિડિશન 28ના અવકાશયાત્રીઓ અવકાશમાં 15 અઠવાડિયાં વિતાવે છે. સમયને મિનિટમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170654037785">
<para id="fs-id1170654012320">151,200 મિનિટ</para>
</solution>
</exercise>
</note>
<example id="fs-id1170653736488">
<exercise id="fs-id1170654204715">
<problem id="fs-id1170653889570">
<para id="fs-id1170653915966">1 ગૅલનમાં કેટલા પ્રવાહી ઔંસ હોય છે?</para>
</problem>
<solution id="fs-id1170653868720">
<title>ઉકેલ</title>
<para id="fs-id1170654027574">ગૅલનને ઔંસમાં ફેરવવા ઘણા રૂપાંતર અવયવોનો ગુણાકાર કરીશું. જુઓ <link target-id="fs-id1170654027716" />.<newline />
<table id="eip-id1169754171774" class="unnumbered unstyled" aria-label="1 ગૅલન આપેલો છે. બે કૉલમના કોષ્ટકમાં ડાબે સૂચનાઓ અને જમણે ગણતરી છે. પહેલાં “રૂપાંતર કરવાના માપનનો 1 સાથે ગુણાકાર કરો.” જમણે (1 ગૅલન/1) × (4 ક્વૉર્ટ/1 ગૅલન) × (2 પિન્ટ/1 ક્વૉર્ટ) × (2 કપ/1 પિન્ટ) × (8 ઔંસ/1 કપ) છે. આગળ “સાચો એકમ મળે એવા રૂપાંતર અવયવો વાપરો અને સાદું રૂપ આપો.” એ જ ગુણાકારમાં ગૅલન, ક્વૉર્ટ, પિન્ટ અને કપ છેદેલા છે. પછી (1 × 4 × 2 × 2 × 8 ઔંસ)/(1 × 1 × 1 × 1 × 1) છે. છેલ્લે 128 ઔંસ મળે છે. 1 ગૅલનમાં 128 ઔંસ હોય છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry align="center">1 ગૅલન</entry>
  </row>
  <row>
    <entry>રૂપાંતર કરવાના માપનનો 1 સાથે ગુણાકાર કરો.</entry>
    <entry align="center"><m:math><m:mfrac><m:mtext>1 ગૅલન</m:mtext><m:mn>1</m:mn></m:mfrac><m:mo>⋅</m:mo><m:mfrac><m:mtext>4 ક્વૉર્ટ</m:mtext><m:mtext>1 ગૅલન</m:mtext></m:mfrac><m:mo>⋅</m:mo><m:mfrac><m:mtext>2 પિન્ટ</m:mtext><m:mtext>1 ક્વૉર્ટ</m:mtext></m:mfrac><m:mo>⋅</m:mo><m:mfrac><m:mtext>2 કપ</m:mtext><m:mtext>1 પિન્ટ</m:mtext></m:mfrac><m:mo>⋅</m:mo><m:mfrac><m:mtext>8 ઔંસ</m:mtext><m:mtext>1 કપ</m:mtext></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry align="left">સાચો એકમ મળે એવા રૂપાંતર અવયવો વાપરો.<newline /> સાદું રૂપ આપો.</entry>
    <entry align="center"><media id="eip-id1169750758852" alt="પરિમાણીય વિશ્લેષણથી 1 ગૅલનને ઔંસમાં ફેરવવા ક્વૉર્ટ, પિન્ટ, કપ અને ઔંસના ગુણાકાર અવયવો વાપર્યા છે અને એકમો છેદી નાખ્યા છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_019_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry align="center"><m:math><m:mfrac><m:mrow><m:mn>1</m:mn><m:mo>⋅</m:mo><m:mn>4</m:mn><m:mo>⋅</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mtext>8 ઔંસ</m:mtext></m:mrow><m:mrow><m:mn>1</m:mn><m:mo>⋅</m:mo><m:mn>1</m:mn><m:mo>⋅</m:mo><m:mn>1</m:mn><m:mo>⋅</m:mo><m:mn>1</m:mn><m:mo>⋅</m:mo><m:mn>1</m:mn></m:mrow></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>સાદું રૂપ આપો.</entry>
    <entry align="center"><m:math><m:mtext>128 ઔંસ</m:mtext></m:math><newline />. 1 ગૅલનમાં 128 પ્રવાહી ઔંસ હોય છે.</entry>
  </row>

 </tbody>




</tgroup>
</table></para></solution>
</exercise>
</example>
<note id="fs-id1170653882056" class="try">
<exercise id="fs-id1170653773881">
<problem id="fs-id1170653904288">
<para id="fs-id1170653886975">1 ગૅલનમાં કેટલા કપ હોય છે?</para>
</problem>
<solution id="fs-id1170654026872">
<para id="fs-id1170654060119">16 કપ</para>
</solution>
</exercise>
</note>
<note id="fs-id1170654080749" class="try">
<exercise id="fs-id1170654202908">
<problem id="fs-id1170653773259">
<para id="fs-id1170653890266">1 કપમાં કેટલા નાના ચમચા હોય છે?</para>
</problem>
<solution id="fs-id1170653753162">
<para id="fs-id1170653834434">48 નાના ચમચા</para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1170653806821">
<title>યુ.એસ. પદ્ધતિમાં માપનના મિશ્ર એકમો વાપરો</title>
<para id="fs-id1170654192559">રોજિંદા પ્રસંગોમાં માપનના મિશ્ર એકમો ઘણી વાર વપરાય છે. ધારો કે જોની ઊંચાઈ 5 ફૂટ 10 ઇંચ છે, તે 7 કલાક 45 મિનિટ કામ કરે છે અને પછી રાત્રિભોજનમાં 1 પાઉન્ડ 2 ઔંસનું સ્ટેક ખાય છે—આ બધાં માપનમાં મિશ્ર એકમો છે.</para>
<para id="fs-id1170654031695">મિશ્ર એકમવાળાં માપન પર અંકગણિતની ક્રિયાઓ કરતી વખતે કાળજી જરૂરી છે. સરખા એકમોનો જ સરવાળો કે બાદબાકી કરો!</para>
<example id="fs-id1170654217418">
<exercise id="fs-id1170654286419">
<problem id="fs-id1170654014673">
<para id="fs-id1170653741175">સીમોરે બાર્બેક્યૂ માટે ત્રણ સ્ટેક ખરીદ્યાં. તેમનાં વજન 14 ઔંસ, 1 પાઉન્ડ 2 ઔંસ અને 1 પાઉન્ડ 6 ઔંસ હતાં. તેણે કુલ કેટલા પાઉન્ડ સ્ટેક ખરીદ્યાં?</para>
</problem>
<solution id="fs-id1170653795707">
<title>ઉકેલ</title>
<para id="fs-id1170653762858">સ્ટેકનું કુલ વજન શોધવા તેમનાં વજનનો સરવાળો કરીશું.<newline />
<table id="eip-id1169750704484" class="unnumbered unstyled" aria-label="કોષ્ટકમાં ડાબે સૂચનાઓ અને જમણે ગણતરીનાં પગલાં છે. પહેલાં “ઔંસ ઉમેરો. પછી પાઉન્ડ ઉમેરો.” જમણે 14 ઔંસ, 1 પાઉન્ડ 2 ઔંસ અને 1 પાઉન્ડ 6 ઔંસનો ઊભો સરવાળો છે; ઔંસ તથા પાઉન્ડના એકમો ગોઠવેલા છે. પરિણામ 2 પાઉન્ડ 22 ઔંસ છે. પછી “22 ઔંસને પાઉન્ડ અને ઔંસમાં ફેરવો.” અને “પાઉન્ડ ઉમેરો.” જમણે 2 પાઉન્ડ + 1 પાઉન્ડ 6 ઔંસ = 3 પાઉન્ડ 6 ઔંસ છે. સીમોરે 3 પાઉન્ડ 6 ઔંસ સ્ટેક ખરીદ્યાં."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry>ઔંસ ઉમેરો. પછી પાઉન્ડ ઉમેરો.</entry>
    <entry><media id="eip-id1169750704513" alt="ઊભા સરવાળામાં 14 ઔંસ, 1 પાઉન્ડ 2 ઔંસ અને 1 પાઉન્ડ 6 ઔંસનો સરવાળો 2 પાઉન્ડ 22 ઔંસ બતાવ્યો છે. 3 પાઉન્ડ 6 ઔંસમાં રૂપાંતર આ આકૃતિમાં નથી."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_014_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>22 ઔંસને પાઉન્ડ અને ઔંસમાં ફેરવો.</entry>
<entry><m:math><m:mrow><m:mspace width="0.35em" /></m:mrow></m:math>2 પાઉન્ડ + 1 પાઉન્ડ 6 ઔંસ</entry>
  </row>
  <row>
    <entry>પાઉન્ડ ઉમેરો.</entry>
    <entry><m:math><m:mrow><m:mspace width="0.35em" /></m:mrow></m:math>3 પાઉન્ડ 6 ઔંસ</entry>
  </row>
  <row>
     <entry />
    <entry>સીમોરે 3 પાઉન્ડ 6 ઔંસ સ્ટેક ખરીદ્યાં.</entry>
    </row>
 </tbody>

</tgroup>
</table></para></solution>
</exercise>
</example>
<note id="fs-id1170653867884" class="try">
<exercise id="fs-id1170654034426">
<problem id="fs-id1170654073784">
<para id="fs-id1170652630000">લૉરાએ ત્રણ બાળકોને જન્મ આપ્યો, જેમનાં વજન 3 પાઉન્ડ 3 ઔંસ, 3 પાઉન્ડ 3 ઔંસ અને 2 પાઉન્ડ 9 ઔંસ હતાં. ત્રણેય બાળકોનું કુલ જન્મવજન કેટલું હતું?</para>
</problem>
<solution id="fs-id1170654014491">
<para id="fs-id1170653832216"><m:math><m:mrow><m:mtext>8 પાઉન્ડ</m:mtext><m:mo>.</m:mo><m:mspace width="0.2em" /><m:mtext>15 ઔંસ</m:mtext></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170654127576" class="try">
<exercise id="fs-id1170653758700">
<problem id="fs-id1170653900357">
<para id="fs-id1170653894981">સ્ટૅને પોતાના પરિવારના ઓરડા માટે ક્રાઉન મોલ્ડિંગના બે ટુકડા કાપ્યા, જે 8 ફૂટ 7 ઇંચ અને 12 ફૂટ 11 ઇંચ લાંબા હતા. મોલ્ડિંગની કુલ લંબાઈ કેટલી હતી?</para>
</problem>
<solution id="fs-id1170653775359">
<para id="fs-id1170653860902">21 ફૂટ 6 ઇંચ</para>
</solution>
</exercise>
</note>
<example id="fs-id1170653881632">
<exercise id="fs-id1170653910861">
<problem id="fs-id1170653908540">
<para id="fs-id1170654008782">ઍન્થનીએ લાકડાનાં ચાર પાટિયાં ખરીદ્યાં, જેમાંથી દરેક 6 ફૂટ 4 ઇંચ લાંબું હતું. તેણે ખરીદેલા લાકડાની કુલ લંબાઈ કેટલી છે?</para>
</problem>
<solution id="fs-id1170652622776">
<title>ઉકેલ</title>
<para id="fs-id1170653833248">કુલ લંબાઈ શોધવા એક પાટિયાની લંબાઈનો ગુણાકાર કરીશું.<newline />


<table id="eip-id1169750705411" class="unnumbered unstyled" aria-label="કોષ્ટકમાં ડાબે સૂચનાઓ અને જમણે ગણતરીનાં પગલાં છે. પહેલાં “ઇંચનો અને પછી ફૂટનો ગુણાકાર કરો.” જમણે 6 ફૂટ 4 ઇંચનો 4 સાથે ઊભો ગુણાકાર છે અને પરિણામ 24 ફૂટ 16 ઇંચ છે. પછી “16 ઇંચને ફૂટમાં ફેરવો.” અને “ફૂટ ઉમેરો.” જમણે 24 ફૂટ + 1 ફૂટ 4 ઇંચ છે. તેથી ઍન્થનીએ 25 ફૂટ 4 ઇંચ લાકડું ખરીદ્યું.">
<label /><tgroup cols="2">
 <tbody>
  <row>
    <entry>ઇંચનો અને પછી ફૂટનો ગુણાકાર કરો.</entry>
    <entry><media id="eip-id1169750705429" alt="મિશ્ર માપનના ગુણાકારમાં 6 ફૂટ 4 ઇંચ ગુણ્યા 4નું પરિણામ 24 ફૂટ 16 ઇંચ છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_015a_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>16 ઇંચને ફૂટમાં ફેરવો.<newline /> ફૂટ ઉમેરો.</entry>
    <entry><media id="eip-id1169750705447" alt="યુ.એસ. એકમોના સરવાળામાં 24 ફૂટ + 1 ફૂટ 4 ઇંચ = 25 ફૂટ 4 ઇંચ છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_015b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry />
    <entry>ઍન્થનીએ 25 ફૂટ 4 ઇંચ લાકડું ખરીદ્યું.</entry>
  </row>
 </tbody>
</tgroup>
</table>
</para></solution>
</exercise>
</example>
<note id="fs-id1170654067973" class="try">
<exercise id="fs-id1170653886029">
<problem id="fs-id1170653913548">
<para id="fs-id1170653904200">હેનરી પોતાની સ્પાઘેટી સૉસની વાનગી ત્રણ ગણી બનાવવા માગે છે; તેમાં 1 પાઉન્ડ 8 ઔંસ ટર્કીનું ખીમું વપરાય છે. તેને કેટલા પાઉન્ડ ખીમું જોઈએ?</para>
</problem>
<solution id="fs-id1170652620585">
<para id="fs-id1170653815807">4 પાઉન્ડ 8 ઔંસ</para>
</solution>
</exercise>
</note>
<note id="fs-id1170654278743" class="try">
<exercise id="fs-id1170653773130">
<problem id="fs-id1170653896355">
<para id="fs-id1170653903490">જોએલેન 5 ગૅલન 3 ક્વૉર્ટનું દ્રાવણ બમણું કરવા માગે છે. તેની પાસે કુલ કેટલા ગૅલન દ્રાવણ થશે?</para>
</problem>
<solution id="fs-id1170654246112">
<para id="fs-id1170654069199">11 ગૅલન 2 ક્વૉર્ટ</para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1170654181456">
<title>મેટ્રિક પદ્ધતિમાં એકમોનું રૂપાંતર કરો</title>
<para id="fs-id1170653741424">આ <term id="term-00003">મેટ્રિક પદ્ધતિ</term>માં એકમો 10ના ઘાતો દ્વારા સંબંધિત છે. તેમનાં નામના મૂળ શબ્દો આ સંબંધ દર્શાવે છે. ઉદાહરણ તરીકે, લંબાઈ માપવાનો મૂળ એકમ મીટર છે. એક કિલોમીટર 1,000 મીટર છે; પૂર્વગ <emphasis effect="italics">કિલો</emphasis>નો અર્થ <emphasis effect="italics">હજાર</emphasis> છે. એક સેન્ટિમીટર એ મીટરનો <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>100</m:mn></m:mrow></m:mfrac></m:mrow></m:math> ભાગ છે, જેમ એક સેન્ટ એ એક ડૉલરનો <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>100</m:mn></m:mrow></m:mfrac></m:mrow></m:math> ભાગ છે.</para>
<para id="fs-id1170652648089">મેટ્રિક પદ્ધતિનાં માપનના સમકક્ષ મૂલ્યો <link target-id="fs-id1170653789448" />માં બતાવ્યાં છે. દરેક માપનનું સામાન્ય સંક્ષિપ્ત રૂપ કૌંસમાં આપ્યું છે.</para>
<table id="fs-id1170653789448" aria-label="“મેટ્રિક માપન પદ્ધતિ” મથાળાવાળા કોષ્ટકમાં લંબાઈ, દળ અને ક્ષમતા એમ ત્રણ કૉલમ છે. લંબાઈ: 1 કિલોમીટર (km) = 1,000 m, 1 હેક્ટોમીટર (hm) = 100 m, 1 ડેકામીટર (dam) = 10 m, 1 મીટર (m) = 1 m, 1 ડેસિમીટર (dm) = 0.1 m, 1 સેન્ટિમીટર (cm) = 0.01 m અને 1 મિલીમીટર (mm) = 0.001 m; નીચે 1 મીટર = 100 સેન્ટિમીટર અને 1 મીટર = 1,000 મિલીમીટર છે. દળ: 1 કિલોગ્રામ (kg) = 1,000 g, 1 હેક્ટોગ્રામ (hg) = 100 g, 1 ડેકાગ્રામ (dag) = 10 g, 1 ગ્રામ (g) = 1 g, 1 ડેસિગ્રામ (dg) = 0.1 g, 1 સેન્ટિગ્રામ (cg) = 0.01 g અને 1 મિલીગ્રામ (mg) = 0.001 g; નીચે 1 ગ્રામ = 100 સેન્ટિગ્રામ અને 1 ગ્રામ = 1,000 મિલીગ્રામ છે. ક્ષમતા: 1 કિલોલીટર (kL) = 1,000 L, 1 હેક્ટોલીટર (hL) = 100 L, 1 ડેકાલીટર (daL) = 10 L, 1 લીટર (L) = 1 L, 1 ડેસિલીટર (dL) = 0.1 L, 1 સેન્ટિલીટર (cL) = 0.01 L અને 1 મિલીલીટર (mL) = 0.001 L; નીચે 1 લીટર = 100 સેન્ટિલીટર અને 1 લીટર = 1,000 મિલીલીટર છે.">
<tgroup cols="3">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<colspec colnum="3" colname="c3" />
<thead>
<row valign="top">
<entry valign="middle" align="center" namest="c1" nameend="c3">મેટ્રિક માપન પદ્ધતિ</entry>
</row>
<row valign="top">
<entry valign="middle" align="center">લંબાઈ</entry>
<entry valign="middle" align="center">દળ</entry>
<entry valign="middle" align="center">ક્ષમતા</entry>
</row>
</thead>
<tbody>
<row valign="top">
<entry valign="middle" align="left">1 કિલોમીટર (km) = 1,000 m<newline /><newline />
1 હેક્ટોમીટર (hm) = 100 m<newline /><newline />
1 ડેકામીટર (dam) = 10 m<newline /><newline />
1 મીટર (m) = 1 m<newline /><newline />
1 ડેસિમીટર (dm) = 0.1 m<newline /><newline />
1 સેન્ટિમીટર (cm) = 0.01 m<newline /><newline />
1 મિલીમીટર (mm) = 0.001 m</entry>
<entry valign="middle" align="left">1 કિલોગ્રામ (kg) = 1,000 g<newline /><newline />
1 હેક્ટોગ્રામ (hg) = 100 g<newline /><newline />
1 ડેકાગ્રામ (dag) = 10 g<newline /><newline />
1 ગ્રામ (g) = 1 g<newline /><newline />
1 ડેસિગ્રામ (dg) = 0.1 g<newline /><newline />
1 સેન્ટિગ્રામ (cg) = 0.01 g<newline /><newline />
1 મિલીગ્રામ (mg) = 0.001 g</entry>
<entry valign="middle" align="left">1 કિલોલીટર (kL) = 1,000 L<newline /><newline />
1 હેક્ટોલીટર (hL) = 100 L<newline /><newline />
1 ડેકાલીટર (daL) = 10 L<newline /><newline />
1 લીટર (L) = 1 L<newline /><newline />
1 ડેસિલીટર (dL) = 0.1 L<newline /><newline />
1 સેન્ટિલીટર (cL) = 0.01 L<newline /><newline />
1 મિલીલીટર (mL) = 0.001 L</entry>
</row>
<row valign="top">
<entry valign="middle" align="left">1 મીટર = 100 સેન્ટિમીટર<newline /><newline />
1 મીટર = 1,000 મિલીમીટર</entry>
<entry valign="middle" align="left">1 ગ્રામ = 100 સેન્ટિગ્રામ<newline /><newline />
1 ગ્રામ = 1,000 મિલીગ્રામ</entry>
<entry valign="middle" align="left">1 લીટર = 100 સેન્ટિલીટર<newline /><newline />
1 લીટર = 1,000 મિલીલીટર</entry>
</row>
</tbody>
</tgroup>
</table>
<para id="fs-id1170653833801">મેટ્રિક પદ્ધતિમાં રૂપાંતર કરવા યુ.એસ. પદ્ધતિ જેવી જ રીત વાપરીશું. ગુણાકારની તટસ્થ સંખ્યાનો ગુણધર્મ વાપરીને સાચો એકમ મળે એવા 1 બરાબર રૂપાંતર અવયવ વડે ગુણશું.</para>
<para id="fs-id1170654013407">તમે ક્યારેય 5K કે 10K દોડ દોડ્યા છો? આવી દોડની લંબાઈ કિલોમીટરમાં મપાય છે. યુનાઇટેડ સ્ટેટ્સમાં દોડની લંબાઈની વાત કરતી વખતે મેટ્રિક પદ્ધતિ સામાન્ય રીતે વપરાય છે.</para>
<example id="fs-id1170653908291">
<exercise id="fs-id1170654026380">
<problem id="fs-id1170653799921">
<para id="fs-id1170653832767">નિક 10K દોડ દોડ્યો. તેણે કેટલા મીટર દોડ્યું?</para>
</problem>
<solution id="fs-id1170654176791">
<title>ઉકેલ</title>
<para id="fs-id1170653915002">ગુણાકારની તટસ્થ સંખ્યાનો ગુણધર્મ વાપરીને કિલોમીટરને મીટરમાં ફેરવીશું.<newline />

<table id="eip-id1169752203306" class="unnumbered unstyled" aria-label="10 કિલોમીટર આપેલા છે. કોષ્ટકમાં ડાબે સૂચનાઓ અને જમણે ગણતરીનાં પગલાં છે. પહેલાં “રૂપાંતર કરવાના માપનનો 1 સાથે ગુણાકાર કરો.” અને 10 km × 1 છે. પછી “1ને કિલોમીટર અને મીટરને જોડતા અપૂર્ણાંક તરીકે લખો.” અને 10 km × (1,000 m)/(1 km) છે. પછી “સાદું રૂપ આપો.” અને (10 km × 1,000 m)/(1 km)માં કિલોમીટરના એકમો છેદેલા છે. છેલ્લે “ગુણાકાર કરો.” અને 10,000 m મળે છે.">
<label /><tgroup cols="2">
 <tbody>
  <row>
    <entry />
    <entry align="center">10 કિલોમીટર</entry>
  </row>
  <row>
    <entry>રૂપાંતર કરવાના માપનનો 1 સાથે ગુણાકાર કરો.</entry>
    <entry><media id="eip-id1169752203335" alt="સફેદ પૃષ્ઠભૂમિ પર “10 કિલોમીટર ગુણ્યા 1” છે. “કિલોમીટર” લાલ અને 10 તથા 1 કાળા રંગમાં છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_002a_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>1ને કિલોમીટર અને મીટરને જોડતા અપૂર્ણાંક તરીકે લખો.</entry>
    <entry><media id="eip-id1169752202935" alt="એકમ-રૂપાંતરની પદાવલીમાં 10 કિલોમીટરનો (1,000 મીટર)/(1 કિલોમીટર) સાથે ગુણાકાર છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_002b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>સાદું રૂપ આપો.</entry>
    <entry><media id="eip-id1169752202952" alt="પરિમાણીય વિશ્લેષણથી 10 કિલોમીટરને મીટરમાં ફેરવતી પદાવલી 10 કિલોમીટર × (1,000 m)/(1 કિલોમીટર) છે; કિલોમીટરના એકમો લાલ રંગમાં છેદેલા છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_002c_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry>10,000 મીટર</entry>
  </row>
  <row>
    <entry />
    <entry>નિક 10,000 મીટર દોડ્યો.</entry>
  </row>
 </tbody>

</tgroup>
</table>
</para></solution>
</exercise>
</example>
<note id="fs-id1170653895512" class="try">
<exercise id="fs-id1170654232032">
<problem id="fs-id1170653924000">
<para id="fs-id1170653790645">સૅન્ડીએ પોતાની પહેલી 5K દોડ પૂરી કરી! તે કેટલા મીટર દોડી?</para>
</problem>
<solution id="fs-id1170653761027">
<para id="fs-id1170654027507">5,000 મીટર</para>
</solution>
</exercise>
</note>
<note id="fs-id1170653774088" class="try">
<exercise id="fs-id1170653838422">
<problem id="fs-id1170653741057">
<para id="fs-id1170653985161">હર્મને 2.5 મીટર લાંબો ગાલીચો ખરીદ્યો. તેની લંબાઈ કેટલા સેન્ટિમીટર છે?</para>
</problem>
<solution id="fs-id1170654016694">
<para id="fs-id1170653837027">250 સેન્ટિમીટર</para>
</solution>
</exercise>
</note>
<example id="fs-id1170653898510">
<exercise id="fs-id1170653775700">
<problem id="fs-id1170654203077">
<para id="fs-id1170653870855">એલિનોરના નવજાત બાળકનું વજન 3,200 ગ્રામ હતું. બાળકનું વજન કેટલા કિલોગ્રામ હતું?</para>
</problem>
<solution id="fs-id1170653834770">
<title>ઉકેલ</title>
<para id="fs-id1170654016052">ગ્રામને કિલોગ્રામમાં ફેરવીશું.<newline />

<table id="eip-id1169750760364" class="unnumbered unstyled" aria-label="3,200 ગ્રામ આપેલા છે. કોષ્ટકમાં ડાબે સૂચનાઓ અને જમણે ગણતરી છે. પહેલાં “રૂપાંતર કરવાના માપનનો 1 સાથે ગુણાકાર કરો.” અને 3,200 g × 1 છે. પછી “1ને કિલોગ્રામ અને ગ્રામને જોડતા અપૂર્ણાંક તરીકે લખો.” અને 3,200 g × (1 kg)/(1,000 g) છે. પછી “સાદું રૂપ આપો.” અને ગ્રામના એકમો છેદેલા છે. આગળ “ગુણાકાર કરો.” અને (3,200 kg)/1,000 છે. છેલ્લે “ભાગાકાર કરો.” અને 3.2 કિલોગ્રામ મળે છે.">
<label /><tgroup cols="2">
 <tbody>
  <row>
    <entry />
    <entry align="center"><media id="eip-id1169750760384" alt="સફેદ પૃષ્ઠભૂમિ પર “3,200 ગ્રામ” છે; “ગ્રામ” લાલ રંગમાં છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_004a_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>રૂપાંતર કરવાના માપનનો 1 સાથે ગુણાકાર કરો.</entry>
    <entry align="center"><media id="eip-id1169750760403" alt="સફેદ પૃષ્ઠભૂમિ પર કાળા અને લાલ રંગમાં “3,200 ગ્રામ × 1” છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_004b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>1ને કિલોગ્રામ અને ગ્રામને જોડતા અપૂર્ણાંક તરીકે લખો.</entry>
    <entry align="center"><media id="eip-id1169750760421" alt="એકમ-રૂપાંતરની પદાવલી 3,200 ગ્રામ × (1 kg)/(1,000 ગ્રામ) છે. આપેલા માપન અને છેદમાં “ગ્રામ” લાલ રંગમાં છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_004c_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>સાદું રૂપ આપો.</entry>
    <entry align="center"><media id="eip-id1169750760440" alt="3,200 ગ્રામને કિલોગ્રામમાં ફેરવવા (1 kg)/(1,000 ગ્રામ) રૂપાંતર અવયવ વાપર્યો છે અને ગ્રામના એકમો છેદેલા છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_004d_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry align="center"><m:math><m:mfrac><m:mtext>3,200 કિલોગ્રામ</m:mtext><m:mn>1,000</m:mn></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>ભાગાકાર કરો.</entry>
    <entry align="center">3.2 કિલોગ્રામ<newline />. બાળકનું વજન 3.2 કિલોગ્રામ હતું.</entry>
  </row>
 </tbody>
</tgroup>
</table>
</para>
</solution>
</exercise>
</example>
<note id="fs-id1170654235809" class="try">
<exercise id="fs-id1170653898632">
<problem id="fs-id1170653881980">
<para id="fs-id1170654047447">કારીના નવજાત બાળકનું વજન 2,800 ગ્રામ હતું. બાળકનું વજન કેટલા કિલોગ્રામ હતું?</para>
</problem>
<solution id="fs-id1170654012324">
<para id="fs-id1170653907924">2.8 કિલોગ્રામ</para>
</solution>
</exercise>
</note>
<note id="fs-id1170653741586" class="try">
<exercise id="fs-id1170652631605">
<problem id="fs-id1170654015378">
<para id="fs-id1170653903912">ઍન્ડરસનને મળેલા પાર્સલ પર 4,500 ગ્રામ લખેલું હતું. આ પાર્સલનું વજન કેટલા કિલોગ્રામ હતું?</para>
</problem>
<solution id="fs-id1170653791953">
<para id="fs-id1170654215841">4.5 કિલોગ્રામ</para>
</solution>
</exercise>
</note>
<para id="fs-id1170653850159">મેટ્રિક પદ્ધતિથી પરિચિત થતાં તમને એક ભાત દેખાશે. આ પદ્ધતિ દસના અવયવીઓ પર આધારિત હોવાથી ગણતરીમાં દસના અવયવીઓ સાથે ગુણાકાર થાય છે. દશાંશ ચિહ્ન ખસેડીને આવી ગણતરી સરળ કરવાનું આપણે શીખ્યા છીએ.</para>
<para id="fs-id1170653907474">10, 100 કે 1,000 વડે ગુણવા દશાંશ ચિહ્નને અનુક્રમે એક, બે કે ત્રણ સ્થાન જમણે ખસેડીએ છીએ. 0.1, 0.01 કે 0.001 વડે ગુણવા તેને અનુક્રમે એક, બે કે ત્રણ સ્થાન ડાબે ખસેડીએ છીએ.</para>
<para id="fs-id1170653792025">મેટ્રિક પદ્ધતિમાં માપનનું રૂપાંતર કરતી વખતે આ ભાત વાપરી શકાય. આ <link target-id="fs-id1170653898510" />માં 3,200 ગ્રામને કિલોગ્રામમાં ફેરવવા <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>1000</m:mn></m:mrow></m:mfrac></m:mrow></m:math> (અથવા 0.001) વડે ગુણ્યું હતું. આ દશાંશ ચિહ્નને ત્રણ સ્થાન ડાબે ખસેડવા સમાન છે.</para>
<media id="fs-id1170654008560" alt="ડાબે 3,200·(1/1,000)ની નીચે 3.2 છે. જમણે 3,200.માંથી દશાંશ ચિહ્ન ત્રણ સ્થાન ડાબે ખસતું વાદળી તીર છે અને નીચે 3.2 છે. આ આકૃતિમાં g કે kg લખેલા નથી.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_10_005_img_new.jpg" />
</media>
<example id="fs-id1170653917879">
<exercise id="fs-id1170654030410">
<problem id="fs-id1170653912013">
<para id="fs-id1170653741035">ફેરવો: <span class="token">ⓐ</span> 350 Lને કિલોલીટરમાં <span class="token">ⓑ</span> 4.1 Lને મિલીલીટરમાં.</para>
</problem>
<solution id="fs-id1170654080821">
<title>ઉકેલ</title>
<list id="fs-id1166422551215" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> લીટરને કિલોલીટરમાં ફેરવીશું. આ <link target-id="fs-id1170653789448" />માં જોઈ શકાય છે કે <m:math><m:mn>1</m:mn><m:mspace width="0.2em" /><m:mtext>કિલોલીટર</m:mtext><m:mo>=</m:mo><m:mtext>1,000 લીટર બરાબર છે.</m:mtext></m:math><newline />
<table id="eip-id1169754143940" class="unnumbered unstyled can-break" aria-label="350 L આપેલા છે. કોષ્ટકમાં ડાબે સૂચનાઓ અને જમણે ગણતરી છે. પહેલાં “1ને લીટર અને કિલોલીટરને જોડતા અપૂર્ણાંક તરીકે લખીને 1 વડે ગુણો.” અને 350 L × (1 kL)/(1,000 L) છે. પછી “સાદું રૂપ આપો.” અને Lના એકમો છેદેલા છે; 350ના છેલ્લા 0ની જમણી બાજુથી ત્રણ સ્થાન ડાબે જતા તીર છે. આગળ “દશાંશ ચિહ્નને 3 સ્થાન ડાબે ખસેડો. (350.)” અને અંતે 0.35 kL છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry><m:math><m:mtext>350 L</m:mtext></m:math></entry>
  </row>
  <row>
    <entry>1ને લીટર અને કિલોલીટરને જોડતા અપૂર્ણાંક તરીકે લખીને 1 વડે ગુણો.</entry>
    <entry><m:math><m:mtext>350 L</m:mtext><m:mo>⋅</m:mo><m:mfrac><m:mtext>1 kL</m:mtext><m:mtext>1,000 L</m:mtext></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>સાદું રૂપ આપો.</entry>
    <entry><m:math><m:mn>350</m:mn><m:mspace width=".2em" /><m:menclose notation="updiagonalstrike"><m:mtext>L</m:mtext></m:menclose><m:mo>⋅</m:mo><m:mfrac><m:mtext>1 kL</m:mtext><m:mrow><m:mn>1,000</m:mn><m:mspace width=".2em" /><m:menclose notation="updiagonalstrike"><m:mtext>L</m:mtext></m:menclose></m:mrow></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry><media id="eip-id1169754197015" alt="“દશાંશ ચિહ્નને 3 સ્થાન ડાબે ખસેડો.” સૂચના સાથે (350.) છે; વાદળી તીર દશાંશ ચિહ્નથી ત્રણ સ્થાન ડાબે જાય છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_006_img_new.jpg" /></media></entry>
    <entry><m:math><m:mtext>0.35 kL</m:mtext></m:math></entry>
  </row>
 </tbody>

</tgroup>
</table>
<newline /><newline /></item>
<item><span class="token">ⓑ</span> લીટરને મિલીલીટરમાં ફેરવીશું. આ <link target-id="fs-id1170653789448" /> માંથી જોઈ શકાય છે કે <m:math><m:mtext>1 લીટર</m:mtext><m:mspace width="0.2em" /><m:mo>=</m:mo><m:mspace width="0.2em" /><m:mtext>1,000 મિલીલીટર બરાબર છે.</m:mtext></m:math><newline />
<table id="eip-id1169748340002" class="unnumbered unstyled can-break" aria-label="4.1 L આપેલા છે. કોષ્ટકમાં ડાબે સૂચનાઓ અને જમણે ગણતરી છે. પહેલાં “1ને લીટર અને મિલીલીટરને જોડતા અપૂર્ણાંક તરીકે લખીને 1 વડે ગુણો.” અને 4.1 L × (1,000 mL)/(1 L) છે. પછી “સાદું રૂપ આપો.” અને Lના એકમો છેદેલા છે. આગળ “દશાંશ ચિહ્નને 3 સ્થાન જમણે ખસેડો.” જમણે 4.100 mLમાં દશાંશ ચિહ્નથી ત્રણ સ્થાન જમણે જતા તીર છે. નીચે 4,100 mL છે.">
<label /><tgroup cols="2">
 <tbody>
  <row>
    <entry />
    <entry><media id="eip-id1169748340021" alt="સફેદ પૃષ્ઠભૂમિ પર 4.1 L છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_007a_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>1ને લીટર અને મિલીલીટરને જોડતા અપૂર્ણાંક તરીકે લખીને 1 વડે ગુણો.</entry>
    <entry><media id="eip-id1169748340038" alt="4.1 લીટરને મિલીલીટરમાં ફેરવવા 4.1 L × (1,000 mL)/(1 L) પદાવલી છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_007b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>સાદું રૂપ આપો.</entry>
    <entry><media id="eip-id1169748340054" alt="એકમ-રૂપાંતરની પદાવલી 4.1 L × (1,000 mL)/(1 L) છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_007c_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>દશાંશ ચિહ્નને 3 સ્થાન જમણે ખસેડો.</entry>
    <entry><media id="eip-id1169748340071" alt="4.100 mLમાં દશાંશ ચિહ્નથી ત્રણ સ્થાન જમણે જતા વાદળી તીરો છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_007d_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry />
    <entry><media id="eip-id1169748340087" alt="સફેદ પૃષ્ઠભૂમિ પર ઘેરા રાખોડી રંગમાં 4,100 mL છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_007e_img_new.jpg" /></media></entry>
  </row>
 </tbody>
</tgroup>
</table>
</item>
</list></solution>
</exercise>
</example>
<note id="fs-id1170653833635" class="try">
<exercise id="fs-id1170653934363">
<problem id="fs-id1170653743925">
<para id="fs-id1170653832489">ફેરવો: <span class="token">ⓐ</span> 725 Lને કિલોલીટરમાં <span class="token">ⓑ</span> 6.3 Lને મિલીલીટરમાં</para>
</problem>
<solution id="fs-id1170653924052">
<para id="fs-id1170654013885"><span class="token">ⓐ</span> 0.725 કિલોલીટર <span class="token">ⓑ</span> 6,300 મિલીલીટર</para>
</solution>
</exercise>
</note>
<note id="fs-id1170653794871" class="try">
<exercise id="fs-id1170653879193">
<problem id="fs-id1170653887890">
<para id="fs-id1170653905800">ફેરવો: <span class="token">ⓐ</span> 350 hLને લીટરમાં <span class="token">ⓑ</span> 4.1 Lને સેન્ટિલીટરમાં</para>
</problem>
<solution id="fs-id1170653888910">
<para id="fs-id1170654022506"><span class="token">ⓐ</span> 35,000 લીટર <span class="token">ⓑ</span> 410 સેન્ટિલીટર</para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1170654114169">
<title>મેટ્રિક પદ્ધતિમાં માપનના મિશ્ર એકમો વાપરો</title>
<para id="fs-id1170654035773">મેટ્રિક પદ્ધતિમાં મિશ્ર એકમવાળાં માપન પર અંકગણિતની ક્રિયાઓ કરતી વખતે યુ.એસ. પદ્ધતિ જેટલી જ કાળજી રાખવી પડે છે. પરંતુ એકમો 10ના ઘાતો સાથે સંબંધિત હોવાથી આ સરળ હોઈ શકે છે. સરખા એકમોનો જ સરવાળો કે બાદબાકી કરો.</para>
<example id="fs-id1170653770878"><exercise id="fs-id1170653798678">
<problem id="fs-id1170654068967">
<para id="fs-id1170653832101">રાયલૅન્ડની ઊંચાઈ 1.6 મીટર છે. તેના નાના ભાઈની ઊંચાઈ 85 સેન્ટિમીટર છે. રાયલૅન્ડ પોતાના નાના ભાઈ કરતાં કેટલો ઊંચો છે?</para>
</problem>
<solution id="fs-id1170653737171">
<title>ઉકેલ</title>
<para id="fs-id1170654150871">બંને માપનને સેન્ટિમીટર અથવા મીટરમાં ફેરવી શકાય. મીટર મોટો એકમ છે, એટલે લંબાઈની બાદબાકી મીટરમાં કરીશું. દશાંશ ચિહ્નને 2 સ્થાન ડાબે ખસેડીને 85 સેન્ટિમીટરને મીટરમાં ફેરવીએ છીએ.</para>
<table id="eip-765" summary="આ કોષ્ટકમાં લખાણરૂપ પ્રશ્ન અને તેની અલગ ગાણિતિક ગણતરીનું ઉદાહરણ છે.">
<tgroup cols="2"><tbody>
  <row>
    <entry>85 સેન્ટિમીટરને મીટરમાં લખો.</entry>
    <entry><m:math><m:mtable>
    	<m:mtr><m:mtd columnalign="left"><m:mspace width="0.7em" /><m:mn>1.60</m:mn><m:mspace width="0.2em" /><m:mtext>m</m:mtext></m:mtd></m:mtr>
    	<m:mtr><m:mtd columnalign="left"><m:munder accentunder="true"><m:mrow><m:mn>−0.85</m:mn><m:mspace width="0.2em" /><m:mtext>m</m:mtext></m:mrow><m:mtext>_______</m:mtext></m:munder></m:mtd></m:mtr>
    	<m:mtr><m:mtd columnalign="left"><m:mspace width="0.7em" /><m:mn>0.75</m:mn><m:mspace width="0.2em" /><m:mtext>m</m:mtext></m:mtd></m:mtr>
	</m:mtable></m:math></entry>
  </row>
</tbody>

</tgroup>
</table>
<para id="fs-id1170653869873">રાયલૅન્ડ પોતાના ભાઈ કરતાં <m:math><m:mrow><m:mtext>0.75 m</m:mtext></m:mrow></m:math> વધુ ઊંચો છે.</para>
</solution>
</exercise>
</example><note id="fs-id1170653892930" class="try">
<exercise id="fs-id1170653890431">
<problem id="fs-id1170653753016">
<para id="fs-id1170654030763">મૅરિએલાની ઊંચાઈ 1.58 મીટર છે. તેની દીકરીની ઊંચાઈ 75 સેન્ટિમીટર છે. મૅરિએલા પોતાની દીકરી કરતાં કેટલી ઊંચી છે? જવાબ સેન્ટિમીટરમાં લખો.</para>
</problem>
<solution id="fs-id1170653769757">
<para id="fs-id1170653903354">83 સેન્ટિમીટર</para>
</solution>
</exercise>
</note>
<note id="fs-id1170653902329" class="try">
<exercise id="fs-id1170654075164">
<problem id="fs-id1170654073930">
<para id="fs-id1170653930864">હૅન્કના આંગણાની વાડ 2 મીટર ઊંચી છે. હૅન્કની ઊંચાઈ 96 સેન્ટિમીટર છે. હૅન્ક વાડ કરતાં કેટલો નીચો છે? જવાબ મીટરમાં લખો.</para>
</problem>
<solution id="fs-id1170653889337">
<para id="fs-id1170653737844">1.04 મીટર</para>
</solution>
</exercise>
</note>
<example id="fs-id1170653769022"><exercise id="fs-id1170653930763">
<problem id="fs-id1170653834744">
<para id="fs-id1170653740148">ડેનાની મસૂરના સૂપની વાનગીમાં 150 મિલીલીટર ઓલિવ તેલ જોઈએ છે. ડેના વાનગી ત્રણ ગણી બનાવવા માગે છે. તેને કેટલા લીટર ઓલિવ તેલ જોઈએ?</para>
</problem>
<solution id="fs-id1170653769748">
<title>ઉકેલ</title>
<para id="fs-id1170653772190">પહેલાં ઓલિવ તેલનું પ્રમાણ મિલીલીટરમાં શોધીને પછી તેને લીટરમાં ફેરવીશું.</para>
<table id="eip-270" summary="આ કોષ્ટકમાં 3 × 150 mLની ગણતરી અને તેને લીટરમાં ફેરવવાનાં પગલાં છે.">
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry>ત્રણ ગણું કરો: <m:math><m:mtext>150 mL</m:mtext></m:math></entry>
  </row>
    <row>
    <entry>બીજગણિતમાં લખો.</entry>
    <entry><m:math><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>150</m:mn><m:mspace width="0.2em" /><m:mtext>mL</m:mtext></m:math></entry>
  </row>
    <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry><m:math><m:mtext>450 mL</m:mtext></m:math></entry>
  </row>
    <row>
    <entry>લીટરમાં ફેરવો.</entry>
    <entry><m:math><m:mn>450</m:mn><m:mo>·</m:mo><m:mfrac><m:mrow><m:mn>0.001</m:mn><m:mspace width="0.2em" /><m:mtext>L</m:mtext></m:mrow><m:mrow><m:mn>1</m:mn><m:mspace width="0.2em" /><m:mtext>mL</m:mtext></m:mrow></m:mfrac></m:math></entry>
  </row>
    <row>
    <entry>સાદું રૂપ આપો.</entry>
    <entry><m:math><m:mtext>0.45 L</m:mtext></m:math></entry>
  </row>
  <row>
    <entry />
    <entry>ડેનાને 0.45 લીટર ઓલિવ તેલ જોઈએ.</entry>
  </row>
</tbody>

</tgroup>
</table></solution>
</exercise></example><note id="fs-id1170653868239" class="try">
<exercise id="fs-id1170654242692">
<problem id="fs-id1170653879980">
<para id="fs-id1170654008685">આલ્ફ્રેડો સૉસની વાનગીમાં 250 મિલીલીટર દૂધ જોઈએ છે. રેનાતા મોટી પાર્ટી માટે આલ્ફ્રેડો સૉસ સાથે પાસ્તા બનાવે છે અને વાનગીનું પ્રમાણ 8 ગણું કરવું છે. તેને કેટલા લીટર દૂધ જોઈએ?</para>
</problem>
<solution id="fs-id1170653915614">
<para id="fs-id1170654009181">2 લીટર</para>
</solution>
</exercise>
</note>
<note id="fs-id1170653750040" class="try">
<exercise id="fs-id1170653800550">
<problem id="fs-id1170653834634">
<para id="fs-id1170653867920">બકલાવાની એક ટ્રે બનાવવા ડોરોથિયાને 400 ગ્રામ ફિલો પેસ્ટ્રી જોઈએ છે. જો તે બકલાવાની 6 ટ્રે બનાવે, તો તેને કેટલા કિલોગ્રામ ફિલો પેસ્ટ્રી જોઈએ?</para>
</problem>
<solution id="fs-id1170653791989">
<para id="fs-id1170653902147">2.4 કિલોગ્રામ</para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1170653885743">
<title>યુ.એસ. અને મેટ્રિક માપન પદ્ધતિઓ વચ્ચે રૂપાંતર કરો</title>
<para id="fs-id1170653750622">યુનાઇટેડ સ્ટેટ્સમાં ઘણાં માપન મેટ્રિક એકમોમાં થાય છે. સોડા 2 લીટરની બૉટલમાં મળે, કૅલ્શિયમની ગોળી 500 mgની હોય અને દોડ 5K હોય શકે. બંને પદ્ધતિમાં સરળતાથી કામ કરવા તેમની વચ્ચે રૂપાંતર આવડવું જરૂરી છે.</para>
<para id="fs-id1170654236427"><link target-id="fs-id1170653913870" /> માં કેટલાક સૌથી સામાન્ય રૂપાંતર આપ્યાં છે.</para>
<table id="fs-id1170653913870" aria-label="“યુ.એસ. અને મેટ્રિક પદ્ધતિઓ વચ્ચેના રૂપાંતર અવયવો” મથાળાવાળા કોષ્ટકમાં લંબાઈ, દળ અને ક્ષમતા એમ ત્રણ કૉલમ છે. લંબાઈ: 1 in. = 2.54 cm, 1 ft. = 0.305 m, 1 yd. = 0.914 m, 1 mi. = 1.61 km અને 1 m = 3.28 ft. દળ: 1 lb. = 0.45 kg, 1 oz. = 28 g અને 1 kg = 2.2 lb. ક્ષમતા: 1 qt. = 0.95 L, 1 fl. oz. = 30 mL અને 1 L = 1.06 qt.">
<tgroup cols="3">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<colspec colnum="3" colname="c3" />
<thead>
<row valign="top">
<entry valign="middle" align="center" namest="c1" nameend="c3">યુ.એસ. અને મેટ્રિક પદ્ધતિઓ વચ્ચેના રૂપાંતર અવયવો</entry>
</row>
<row valign="top">
<entry valign="middle" align="center">લંબાઈ</entry>
<entry valign="middle" align="center">દળ</entry>
<entry valign="middle" align="center">ક્ષમતા</entry>
</row>
</thead>
<tbody>
<row valign="top">
<entry valign="middle" align="left"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="left"><m:mtable><m:mtr><m:mtd columnalign="left"><m:mtext>1 in.</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>2.54 cm</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>1 ft.</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>0.305 m</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>1 yd.</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>0.914 m</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>1 mi.</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>1.61 km</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>1 m</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>3.28 ft.</m:mtext></m:mtd></m:mtr></m:mtable></m:mtd></m:mtr></m:mtable></m:mrow></m:math></entry>
<entry valign="middle" align="left"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="left"><m:mtable><m:mtr><m:mtd columnalign="left"><m:mtext>1 lb.</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>0.45 kg</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>1 oz.</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>28 g</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>1 kg</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>2.2 lb.</m:mtext></m:mtd></m:mtr></m:mtable></m:mtd></m:mtr></m:mtable></m:mrow></m:math>
</entry>
<entry valign="middle" align="left"><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="left"><m:mtable><m:mtr><m:mtd columnalign="left"><m:mtext>1 qt.</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>0.95 L</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>1 fl. oz.</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>30 mL</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>1 L</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>1.06 qt.</m:mtext></m:mtd></m:mtr></m:mtable></m:mtd></m:mtr></m:mtable></m:mrow></m:math></entry>
</row>
</tbody>
</tgroup>
</table>
<para id="fs-id1170653893032"><link target-id="CNX_ElemAlg_Figure_01_10_008" /> માં પટ્ટી પર ઇંચ અને સેન્ટિમીટર વચ્ચેનો સંબંધ બતાવ્યો છે.</para>
<figure id="CNX_ElemAlg_Figure_01_10_008">
<media id="fs-id1170654009196" alt="પટ્ટીની ઉપર ઇંચનો માપક્રમ 0થી 5થી થોડો આગળ અને નીચે સેન્ટિમીટરનો માપક્રમ 0થી 12થી થોડો આગળ છે; બંનેમાં નાના વિભાગો છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_10_008_img_new.jpg" />
</media>
<caption>આ પટ્ટી ઇંચ અને સેન્ટિમીટર બતાવે છે.</caption>
</figure>
<para id="fs-id1170653881351"><link target-id="CNX_ElemAlg_Figure_01_10_009" /> માં માપવાના કપ પર ઔંસ અને મિલીલીટરનાં નિશાન બતાવ્યાં છે.</para>
<figure id="CNX_ElemAlg_Figure_01_10_009"><media id="fs-id1170654030469" alt="માપવાના કપની ડાબી બાજુ 1/4થી 2 કપ સુધી, મધ્યમાં 2થી 16 પ્રવાહી ઔંસ સુધી અને જમણી બાજુ 50થી 500 મિલીલીટર સુધીનાં નિશાન છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_10_009_img_new.jpg" />
</media>

<caption>આ માપવાનો કપ ઔંસ અને મિલીલીટર બતાવે છે.</caption></figure><para id="fs-id1170653736108"><link target-id="CNX_ElemAlg_Figure_01_10_010" /> માં બાથરૂમના કાંટા પર પાઉન્ડ અને કિલોગ્રામનાં નિશાન બતાવ્યાં છે.</para>
<figure id="CNX_ElemAlg_Figure_01_10_010">
<media id="fs-id1170653910440" alt="બાથરૂમના કાંટામાં બહારનો ગોળ માપક્રમ 0થી 320 પાઉન્ડ અને અંદરનો માપક્રમ 0થી 140 કિલોગ્રામ બતાવે છે; લાલ સૂચક લગભગ શૂન્ય પર છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_10_010_img_new.jpg" />
</media>
<caption>આ કાંટો પાઉન્ડ અને કિલોગ્રામ બતાવે છે.</caption>
</figure>
<para id="fs-id1170653876302">પદ્ધતિની અંદર રૂપાંતર કરીએ તેવી જ રીતે, એકમ-રૂપાંતર અવયવો વડે ગુણાકાર કરીને બે પદ્ધતિઓ વચ્ચે રૂપાંતર કરીએ છીએ.</para>
<example id="fs-id1170654075277"><exercise id="fs-id1170653876396">
<problem id="fs-id1170653899040">
<para id="fs-id1170654149168">લીની પાણીની બૉટલમાં 500 mL પાણી સમાય છે. બૉટલમાં કેટલા પ્રવાહી ઔંસ છે? જવાબને સૌથી નજીકના દશાંશ પ્રવાહી ઔંસ સુધી ફેરવો.</para>
</problem>
<solution id="fs-id1170654011769">
<title>ઉકેલ</title>
<table id="eip-461" summary="એકમ-રૂપાંતર અવયવ વડે 500 મિલીલીટરને ઔંસમાં ફેરવવાનાં પગલાં છે; પરિણામ 16.7 ઔંસ છે.">
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry><m:math><m:mtext>500 mL</m:mtext></m:math></entry>
  </row>
    <row>
    <entry>mL અને ઔંસને જોડતા એકમ-રૂપાંતર અવયવ વડે ગુણો.</entry>
    <entry><m:math><m:mn>500</m:mn><m:mspace width="0.2em" /><m:mtext>મિલીલીટર</m:mtext><m:mo>·</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn><m:mspace width="0.2em" /><m:mtext>ઔંસ</m:mtext></m:mrow><m:mrow><m:mn>30</m:mn><m:mspace width="0.2em" /><m:mtext>મિલીલીટર</m:mtext></m:mrow></m:mfrac></m:math></entry>
  </row>
    <row>
    <entry>સાદું રૂપ આપો.</entry>
    <entry><m:math><m:mfrac><m:mrow><m:mtext>500 ઔંસ</m:mtext></m:mrow><m:mrow><m:mn>30</m:mn></m:mrow></m:mfrac></m:math></entry>
  </row>
    <row>
    <entry>ભાગાકાર કરો.</entry>
    <entry><m:math><m:mtext>16.7 ઔંસ.</m:mtext></m:math></entry>
  </row>
  <row>
    <entry />
    <entry>પાણીની બૉટલમાં 16.7 ઔંસ છે.</entry>
  </row>
</tbody>
</tgroup>
</table>
</solution>
</exercise>
</example><note id="fs-id1170653771275" class="try">
<exercise id="fs-id1170654008678">
<problem id="fs-id1170654036019">
<para id="fs-id1170653752524">2 Lની સોડાની બૉટલમાં કેટલા ક્વૉર્ટ છે?</para>
</problem>
<solution id="fs-id1170652789213">
<para id="fs-id1170653846740">2.12 ક્વૉર્ટ</para>
</solution>
</exercise>
</note>
<note id="fs-id1170652938147" class="try">
<exercise id="fs-id1170652928454">
<problem id="fs-id1170652928456">
<para id="fs-id1170654150165">4 ક્વૉર્ટ દૂધમાં કેટલા લીટર છે?</para>
</problem>
<solution id="fs-id1170653889769">
<para id="fs-id1170652665046">3.8 લીટર</para>
</solution>
</exercise>
</note>
<example id="fs-id1170653836983"><exercise id="fs-id1170653768882">
<problem id="fs-id1170653768884">
<para id="fs-id1170653769448">સોલેઈ રોડ ટ્રિપ પર હતી. તેણે આગળનું આરામસ્થાન 100 કિલોમીટર દૂર હોવાનું નિશાન જોયું. આગળના આરામસ્થાન સુધી કેટલા માઈલ છે?</para>
</problem>
<solution id="fs-id1170652658229">
<title>ઉકેલ</title>
<table id="eip-310" summary="100 કિલોમીટરને માઈલમાં ફેરવવાનાં ગણતરી સહિતનાં પગલાં અને અંતિમ અંતર.">
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry><m:math><m:mtext>100 કિલોમીટર</m:mtext></m:math></entry>
  </row>
    <row>
    <entry>km અને miને જોડતા એકમ-રૂપાંતર અવયવ વડે ગુણો.</entry>
    <entry><m:math><m:mn>100</m:mn><m:mspace width="0.2em" /><m:mtext>કિલોમીટર</m:mtext><m:mo>·</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn><m:mspace width="0.2em" /><m:mtext>માઈલ</m:mtext></m:mrow><m:mrow><m:mn>1.61</m:mn><m:mspace width="0.2em" /><m:mtext>કિલોમીટર</m:mtext></m:mrow></m:mfrac></m:math></entry>
  </row>
    <row>
    <entry>સાદું રૂપ આપો.</entry>
    <entry><m:math><m:mfrac><m:mrow><m:mtext>100 માઈલ</m:mtext></m:mrow><m:mrow><m:mn>1.61</m:mn></m:mrow></m:mfrac></m:math></entry>
  </row>
    <row>
    <entry>ભાગાકાર કરો.</entry>
    <entry><m:math><m:mtext>62 માઈલ.</m:mtext></m:math></entry>
  </row>
  <row>
    <entry />
    <entry>સોલેઈ 62 માઈલ મુસાફરી કરશે.</entry>
  </row>
</tbody>

</tgroup>
</table>
</solution>
</exercise>
</example><note id="fs-id1170653797640" class="try">
<exercise id="fs-id1170653871535">
<problem id="fs-id1170654053808">
<para id="fs-id1170654053811">માઉન્ટ કિલિમાન્જારોની ઊંચાઈ 5,895 મીટર છે. ઊંચાઈને ફૂટમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170654068833">
<para id="fs-id1170654068835">19,336 ફૂટ</para>
</solution>
</exercise>
</note>
<note id="fs-id1170653756054" class="try">
<exercise id="fs-id1170654076817">
<problem id="fs-id1170654022158">
<para id="fs-id1170654149655">ન્યૂ યોર્ક શહેરથી લંડન સુધીનું હવાઈ અંતર 5,586 કિલોમીટર છે. અંતરને માઈલમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170652640987">
<para id="fs-id1170653874813">3,469.57 માઈલ</para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1170654125831">
<title>ફેરનહીટ અને સેલ્સિયસ તાપમાન વચ્ચે રૂપાંતર કરો</title>
<para id="fs-id1170654141793">તમે ક્યારેય બીજા દેશમાં હવામાનની આગાહી સાંભળી છે? જો આગાહીમાં આ તાપમાન હોય: <m:math><m:mrow><m:mn>22</m:mn><m:mtext>°</m:mtext><m:mtext>C</m:mtext><m:mo>,</m:mo></m:mrow></m:math> તો તેનો શું અર્થ થાય?</para>
<para id="fs-id1170653807898">યુ.એસ. અને મેટ્રિક પદ્ધતિઓ તાપમાન માપવા જુદા માપક્રમ વાપરે છે. યુ.એસ. પદ્ધતિ ફેરનહીટ ડિગ્રી વાપરે છે, જેને <m:math><m:mrow><m:mtext>°</m:mtext><m:mtext>F</m:mtext><m:mtext>.</m:mtext></m:mrow></m:math> લખાય છે. મેટ્રિક પદ્ધતિ સેલ્સિયસ ડિગ્રી વાપરે છે, જેને <m:math><m:mrow><m:mtext>°</m:mtext><m:mtext>C</m:mtext><m:mtext>.</m:mtext></m:mrow></m:math> લખાય છે. <link target-id="CNX_ElemAlg_Figure_01_10_011" />માં બંને પદ્ધતિ વચ્ચેનો સંબંધ બતાવ્યો છે.</para>
<figure id="CNX_ElemAlg_Figure_01_10_011">
<media id="fs-id1170654141345" alt="બે થર્મોમીટર છે—એક સેલ્સિયસ (°C) અને બીજું ફેરનહીટ (°F). “પાણી ઊકળે છે” પાસે 100°C અને 212°F છે. “શરીરનું સામાન્ય તાપમાન” પાસે 37°C અને 98.6°F છે. “પાણી થીજે છે” પાસે 0°C અને 32°F છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_10_011_img_new.jpg" />
</media>
<caption>આકૃતિમાં શરીરનું સામાન્ય તાપમાન તથા પાણીના થીજવા અને ઊકળવાનાં તાપમાન ફેરનહીટ અને સેલ્સિયસ ડિગ્રીમાં બતાવ્યાં છે.</caption>
</figure>
<note id="fs-id1170654115235">
<title>તાપમાનનું રૂપાંતર</title>
<para id="fs-id1170654200442">ફેરનહીટ તાપમાન Fને સેલ્સિયસ તાપમાન Cમાં ફેરવવા આ સૂત્ર વાપરો:</para>
<equation id="fs-id1170654010052" class="unnumbered"><label /><m:math><m:mrow><m:mi>C</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>9</m:mn></m:mfrac><m:mrow><m:mo>(</m:mo><m:mrow><m:mi>F</m:mi><m:mo>−</m:mo><m:mn>32</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math></equation>
<para id="fs-id1170654230844">સેલ્સિયસ તાપમાન Cને ફેરનહીટ તાપમાન Fમાં ફેરવવા આ સૂત્ર વાપરો:</para>
<equation id="fs-id1170654284373" class="unnumbered"><label /><m:math><m:mrow><m:mi>F</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>9</m:mn><m:mn>5</m:mn></m:mfrac><m:mi>C</m:mi><m:mo>+</m:mo><m:mn>32</m:mn><m:mo>.</m:mo></m:mrow></m:math></equation>
</note>
<example id="fs-id1170654015022">
<exercise id="fs-id1170654015024">
<problem id="fs-id1170653930602">
<para id="fs-id1170653930604">ફેરવો: <m:math><m:mrow><m:mn>50</m:mn><m:mtext>°</m:mtext></m:mrow></m:math> ફેરનહીટને સેલ્સિયસ ડિગ્રીમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170653755791">
<title>ઉકેલ</title>
<para id="fs-id1170654232177">અમે <m:math><m:mrow><m:mn>50</m:mn><m:mtext>°</m:mtext><m:mtext>F</m:mtext></m:mrow></m:math> ને સૂત્રમાં મૂકી C શોધીશું.<newline />
<table id="eip-id1169749562678" class="unnumbered unstyled can-break" aria-label="°Fને °Cમાં ફેરવવાનું સૂત્ર C=(5/9)(F−32) છે. આગળ “Fના સ્થાને 50 મૂકો.” એટલે C=(5/9)(50−32). પછી “કૌંસનું સાદું રૂપ આપો.” એટલે C=(5/9)(18). છેલ્લે “ગુણાકાર કરો.” એટલે C=10."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry><media id="eip-id1169752086556" alt="ફેરનહીટ (F)માંથી સેલ્સિયસ (C)માં તાપમાન ફેરવવાનું સૂત્ર C=(5/9)(F−32) છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_012b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry><media id="eip-id1169752086570" alt="સફેદ પૃષ્ઠભૂમિ પર “Fના સ્થાને 50 મૂકો.” છે; 50 લાલ રંગમાં છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_012a_img_new.jpg" /></media></entry>
    <entry><media id="eip-id1169752086580" alt="ફેરનહીટમાંથી સેલ્સિયસમાં રૂપાંતરનું સૂત્ર C=(5/9)(50−32) છે; 50 લાલ રંગમાં છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_012c_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>કૌંસનું સાદું રૂપ આપો.</entry>
    <entry><media id="eip-id1169752086596" alt="સમીકરણ C=(5/9)(18) છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_012d_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry><media id="eip-id1169752086613" alt="સફેદ પૃષ્ઠભૂમિ પર ઘેરા રંગમાં C=10 છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_012e_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry />
    <entry>આમ 50°F એ 10°C બરાબર છે.</entry>
  </row>
 </tbody>


</tgroup>
</table>
</para></solution>
</exercise>
</example>
<note id="fs-id1170654125384" class="try">
<exercise id="fs-id1170653772087">
<problem id="fs-id1170653772089">
<para id="fs-id1170653867974">ફેરનહીટ તાપમાનને સેલ્સિયસ ડિગ્રીમાં ફેરવો: <m:math><m:mrow><m:mn>59</m:mn><m:mtext>°</m:mtext></m:mrow></m:math> ફેરનહીટ.</para>
</problem>
<solution id="fs-id1170654032787">
<para id="fs-id1170654032789"><m:math><m:mrow><m:mrow><m:mn>15</m:mn><m:mtext>°</m:mtext><m:mtext>C</m:mtext></m:mrow></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170654060534" class="try">
<exercise id="fs-id1170654239366">
<problem id="fs-id1170654239368">
<para id="fs-id1170653748922">ફેરનહીટ તાપમાનને સેલ્સિયસ ડિગ્રીમાં ફેરવો: <m:math><m:mrow><m:mn>41</m:mn><m:mtext>°</m:mtext></m:mrow></m:math> ફેરનહીટ.</para>
</problem>
<solution id="fs-id1170653748995">
<para id="fs-id1170654069280"><m:math><m:mrow><m:mn>5</m:mn><m:mtext>°</m:mtext><m:mtext>C</m:mtext></m:mrow></m:math>
</para>
</solution>
</exercise>
</note>
<example id="fs-id1170654129736">
<exercise id="fs-id1170653798020">
<problem id="fs-id1170653798022">
<para id="fs-id1170654067027">પૅરિસની મુલાકાત વખતે વુડીએ તાપમાન <m:math><m:mrow><m:mn>20</m:mn><m:mtext>°</m:mtext></m:mrow></m:math> સેલ્સિયસ જોયું. તાપમાનને ફેરનહીટ ડિગ્રીમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170653769463">
<title>ઉકેલ</title>
<para id="fs-id1170653769466">અમે <m:math><m:mrow><m:mn>20</m:mn><m:mtext>°</m:mtext><m:mtext>C</m:mtext></m:mrow></m:math> ને સૂત્રમાં મૂકી F શોધીશું.<newline />
<table id="eip-id1169750701791" class="unnumbered unstyled" aria-label="°Cને °Fમાં ફેરવવાનું સૂત્ર F=(9/5)C+32 છે. આગળ “Cના સ્થાને 20 મૂકો.” એટલે F=(9/5)(20)+32. પછી “ગુણાકાર કરો.” એટલે F=36+32. છેલ્લે “સરવાળો કરો.” એટલે F=68.">
<label /><tgroup cols="2">
 <tbody>
  <row>
    <entry />
    <entry><media id="eip-id1169750701810" alt="સેલ્સિયસ (C)માંથી ફેરનહીટ (F)માં તાપમાન ફેરવવાનું સૂત્ર F=(9/5)C+32 છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_013b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry><media id="eip-id1169750701824" alt="સફેદ પૃષ્ઠભૂમિ પર “Cના સ્થાને 20 મૂકો.” સૂચના છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_013a_img_new.jpg" /></media></entry>
    <entry><media id="eip-id1169750701834" alt="સેલ્સિયસમાંથી ફેરનહીટમાં રૂપાંતરનું સમીકરણ F=(9/5)(20)+32 છે; 20 લાલ રંગમાં છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_013c_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry><media id="eip-id1169750701850" alt="સફેદ પૃષ્ઠભૂમિ પર ઘેરા રંગમાં F=36+32 છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_013d_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>સરવાળો કરો.</entry>
    <entry><media id="eip-id1169750701867" alt="સફેદ પૃષ્ઠભૂમિ પર ઘેરા રાખોડી રંગમાં F=68 છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_10_013e_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry />
    <entry>આમ 20°C એ 68°F બરાબર છે.</entry>
  </row>
 </tbody>
</tgroup>
</table>
</para>
</solution>
</exercise>
</example>
<note id="fs-id1170653875549" class="try">
<exercise id="fs-id1170653875552">
<problem id="fs-id1170653791656">
<para id="fs-id1170653791658">સેલ્સિયસ તાપમાનને ફેરનહીટ ડિગ્રીમાં ફેરવો: હેલસિંકી, ફિનલૅન્ડમાં તાપમાન <m:math><m:mrow><m:mn>15</m:mn><m:mtext>°</m:mtext></m:mrow></m:math> સેલ્સિયસ હતું.</para>
</problem>
<solution id="fs-id1170654237812">
<para id="fs-id1170654238722"><m:math><m:mrow><m:mn>59</m:mn><m:mtext>°</m:mtext><m:mtext>F</m:mtext></m:mrow></m:math>
</para>
</solution>
</exercise>
</note>
<note id="fs-id1170652620855" class="try">
<exercise id="fs-id1170654201794">
<problem id="fs-id1170654201796">
<para id="fs-id1170654237375">સેલ્સિયસ તાપમાનને ફેરનહીટ ડિગ્રીમાં ફેરવો: સિડની, ઑસ્ટ્રેલિયામાં તાપમાન <m:math><m:mrow><m:mn>10</m:mn><m:mtext>°</m:mtext></m:mrow></m:math> સેલ્સિયસ હતું.</para>
</problem>
<solution id="fs-id1170653809204">
<para id="fs-id1170653809207"><m:math><m:mrow><m:mn>50</m:mn><m:mtext>°</m:mtext><m:mtext>F</m:mtext></m:mrow></m:math></para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1170653741720" class="key-concepts">
<title>મુખ્ય મુદ્દા</title>
<list id="fs-id1170653748210" list-type="bulleted" bullet-style="bullet">
<item><emphasis effect="bold">મેટ્રિક માપન પદ્ધતિ</emphasis>
<list id="fs-id1170653893604" list-type="bulleted" bullet-style="open-circle">
<item><emphasis effect="bold">લંબાઈ</emphasis><newline />
<m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="left"><m:mtext>1 કિલોમીટર (km)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>1,000 m</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 હેક્ટોમીટર (hm)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>100 m</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 ડેકામીટર (dam)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>10 m</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 મીટર (m)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>1 m</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 ડેસિમીટર (dm)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>0.1 m</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 સેન્ટિમીટર (cm)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>0.01 m</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 મિલીમીટર (mm)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>0.001 m</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 મીટર</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>100 સેન્ટિમીટર</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 મીટર</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>1,000 મિલીમીટર</m:mtext></m:mtd></m:mtr></m:mtable></m:mrow></m:math></item>
<item><emphasis effect="bold">દળ</emphasis><newline />
<m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="left"><m:mtext>1 કિલોગ્રામ (kg)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>1,000 g</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 હેક્ટોગ્રામ (hg)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>100 g</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 ડેકાગ્રામ (dag)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>10 g</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 ગ્રામ (g)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>1 g</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 ડેસિગ્રામ (dg)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>0.1 g</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 સેન્ટિગ્રામ (cg)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>0.01 g</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 મિલીગ્રામ (mg)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>0.001 g</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 ગ્રામ</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>100 સેન્ટિગ્રામ</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 ગ્રામ</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>1,000 મિલીગ્રામ</m:mtext></m:mtd></m:mtr></m:mtable></m:mrow></m:math></item>
<item><emphasis effect="bold">ક્ષમતા</emphasis><newline />
<m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="left"><m:mtext>1 કિલોલીટર (kL)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>1,000 L</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 હેક્ટોલીટર (hL)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>100 L</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 ડેકાલીટર (daL)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>10 L</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 લીટર (L)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>1 L</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 ડેસિલીટર (dL)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>0.1 L</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 સેન્ટિલીટર (cL)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>0.01 L</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 મિલીલીટર (mL)</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>0.001 L</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 લીટર</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>100 સેન્ટિલીટર</m:mtext></m:mtd></m:mtr>
<m:mtr><m:mtd columnalign="left"><m:mtext>1 લીટર</m:mtext></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mtext>1,000 મિલીલીટર</m:mtext></m:mtd></m:mtr></m:mtable></m:mrow></m:math></item>
</list></item>
<item><emphasis effect="bold">તાપમાનનું રૂપાંતર</emphasis>
<list id="fs-id1170653750836" list-type="bulleted" bullet-style="open-circle">
<item>ફેરનહીટ તાપમાન Fને સેલ્સિયસ તાપમાન Cમાં ફેરવવા આ સૂત્ર વાપરો: <m:math><m:mrow><m:mtext>C</m:mtext><m:mo>=</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>9</m:mn></m:mfrac><m:mrow><m:mo>(</m:mo><m:mrow><m:mtext>F</m:mtext><m:mo>−</m:mo><m:mn>32</m:mn></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></item>
<item>સેલ્સિયસ તાપમાન Cને ફેરનહીટ તાપમાન Fમાં ફેરવવા આ સૂત્ર વાપરો: <m:math><m:mrow><m:mtext>F</m:mtext><m:mo>=</m:mo><m:mfrac><m:mn>9</m:mn><m:mn>5</m:mn></m:mfrac><m:mtext>C</m:mtext><m:mo>+</m:mo><m:mn>32</m:mn></m:mrow></m:math></item>
</list></item>
</list>
</section>
<section id="fs-id1170653917353" class="section-exercises">
<title>વિભાગની કસરતો</title><section id="fs-id1170653917356" class="practice-perfect">
<title>અભ્યાસથી નિપુણતા</title>
<para id="fs-id1170654080058"><emphasis effect="bold">યુ.એસ. પદ્ધતિમાં એકમોનું રૂપાંતર કરો</emphasis></para>
<para id="fs-id1166424788676">નીચેની કસરતોમાં એકમોનું રૂપાંતર કરો.</para>
<exercise id="fs-id1170653762731">
<problem id="fs-id1170654239256">
<para id="fs-id1170654239258">બગીચાની એક બૅન્ચ 6 ફૂટ લાંબી છે. લંબાઈને ઇંચમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170653745495">
<para id="fs-id1170654156794">72 ઇંચ</para>
</solution>
</exercise>
<exercise id="fs-id1170654011000">
<problem id="fs-id1170654011002">
<para id="fs-id1170653761135">ફર્શની એક ટાઇલ 2 ફૂટ પહોળી છે. પહોળાઈને ઇંચમાં ફેરવો.</para>
</problem>
</exercise>
<exercise id="fs-id1170654008693">
<problem id="fs-id1170654008695">
<para id="fs-id1170653769260">રિબન 18 ઇંચ લાંબી છે. લંબાઈને ફૂટમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170653888707">
<para id="fs-id1170653888709">1.5 ફૂટ</para>
</solution>
</exercise>
<exercise id="fs-id1170653893503">
<problem id="fs-id1170653790994">
<para id="fs-id1170653790996">કાર્સનની ઊંચાઈ 45 ઇંચ છે. તેની ઊંચાઈને ફૂટમાં ફેરવો.</para>
</problem>
</exercise>
<exercise id="fs-id1170653769410">
<problem id="fs-id1170654231276">
<para id="fs-id1170654231278">અમેરિકન ફૂટબૉલનું મેદાન 160 ફૂટ પહોળું છે. પહોળાઈને યાડમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170653809012">
<para id="fs-id1170653845426"><m:math><m:mrow><m:mn>53</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math> યાડ </para>
</solution>
</exercise>
<exercise id="fs-id1170654239813">
<problem id="fs-id1170654201991">
<para id="fs-id1170654201993">બેઝબૉલના મેદાનમાં હોમ પ્લેટથી પહેલા બેઝ સુધીનું અંતર 30 યાડ છે. અંતરને ફૂટમાં ફેરવો.</para>
</problem>
</exercise>
<exercise id="fs-id1170652666221">
<problem id="fs-id1170654080033">
<para id="fs-id1170654080035">યુલિસિસ શાળાથી 1.5 માઈલ દૂર રહે છે. અંતરને ફૂટમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170654122714">
<para id="fs-id1170653914188">7,920 ફૂટ</para>
</solution>
</exercise>
<exercise id="fs-id1170653984869">
<problem id="fs-id1170653984871">
<para id="fs-id1170654114388">ડેન્વર, કોલોરાડો સમુદ્રસપાટીથી 5,183 ફૂટ ઊંચું છે. ઊંચાઈને માઈલમાં ફેરવો.</para>
</problem>
</exercise>
<exercise id="fs-id1170653802017">
<problem id="fs-id1170653802019">
<para id="fs-id1170654212324">કિલર વ્હેલનું વજન 4.6 ટન છે. વજનને પાઉન્ડમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170653902584">
<para id="fs-id1170653902586">9,200 પાઉન્ડ</para>
</solution>
</exercise>
<exercise id="fs-id1170653770327">
<problem id="fs-id1170654126063">
<para id="fs-id1170654126065">બ્લૂ વ્હેલનું વજન 150 ટન જેટલું હોઈ શકે છે. વજનને પાઉન્ડમાં ફેરવો.</para>
</problem>
</exercise>
<exercise id="fs-id1170653776787">
<problem id="fs-id1170654202178">
<para id="fs-id1170654202180">ખાલી બસનું વજન 35,000 પાઉન્ડ છે. વજનને ટનમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170654076083">
<para id="fs-id1170654235440"><m:math><m:mrow><m:mn>17</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math> ટન</para>
</solution>
</exercise>
<exercise id="fs-id1170652618785">
<problem id="fs-id1170653871425">
<para id="fs-id1170653871427">ઉડાન શરૂ કરતી વખતે વિમાનનું વજન 220,000 પાઉન્ડ છે. વજનને ટનમાં ફેરવો.</para>
</problem>
</exercise>
<exercise id="fs-id1170654031658">
<problem id="fs-id1170654031660">
<para id="fs-id1170654034408">રોકોએ પોતાની મુલાકાત માટે <m:math><m:mrow><m:mn>1</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math> કલાક રાહ જોઈ. સમયને સેકન્ડમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170652630356">
<para id="fs-id1170654079063">5,400 સેકન્ડ</para>
</solution>
</exercise>
<exercise id="fs-id1170654011825">
<problem id="fs-id1170653815060">
<para id="fs-id1170653815062">મિસ્ટીની શસ્ત્રક્રિયા <m:math><m:mrow><m:mn>2</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math> કલાક ચાલી. સમયને સેકન્ડમાં ફેરવો.</para>
</problem>
</exercise>
<exercise id="fs-id1170653915733">
<problem id="fs-id1170654014951">
<para id="fs-id1170654014954">એક પિન્ટમાં કેટલા નાના ચમચા હોય છે?</para>
</problem>
<solution id="fs-id1170653903551">
<para id="fs-id1170653924359"><m:math><m:mrow><m:mn>96</m:mn></m:mrow></m:math> નાના ચમચા</para>
</solution>
</exercise>
<exercise id="fs-id1170653849133">
<problem id="fs-id1170654236291">
<para id="fs-id1170654236293">એક ગૅલનમાં કેટલા મોટા ચમચા હોય છે?</para>
</problem>
</exercise>
<exercise id="fs-id1170654230146">
<problem id="fs-id1170654230149">
<para id="fs-id1170653912851">જેજેની બિલાડી પોઝીનું વજન 14 પાઉન્ડ છે. તેનું વજન ઔંસમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170654141724">
<para id="fs-id1170652626972"><m:math><m:mrow><m:mn>224</m:mn></m:mrow></m:math> ઔંસ</para>
</solution>
</exercise>
<exercise id="fs-id1170653772693">
<problem id="fs-id1170653772695">
<para id="fs-id1170653739038">એપ્રિલના કૂતરા બીન્સનું વજન 8 પાઉન્ડ છે. તેનું વજન ઔંસમાં ફેરવો.</para>
</problem>
</exercise>
<exercise id="fs-id1170654061937">
<problem id="fs-id1170654061939">
<para id="fs-id1170654234178">ક્રિસ્ટા પોતાના દીકરાની પાર્ટીમાં 20 કપ રસ પીરસશે. કદને ગૅલનમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170653906793">
<para id="fs-id1170653906796"><m:math><m:mrow><m:mn>1</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math> ગૅલન</para>
</solution>
</exercise>
<exercise id="fs-id1170654008947">
<problem id="fs-id1170654008949">
<para id="fs-id1170654068263">લાન્સને દોડના સ્પર્ધકો માટે 50 કપ પાણી જોઈએ છે. કદને ગૅલનમાં ફેરવો.</para>
</problem>
</exercise>
<exercise id="fs-id1170653899086">
<problem id="fs-id1170653899089">
<para id="fs-id1170654044612">જૉનની ઊંચાઈ 6 ફૂટ 4 ઇંચ છે. તેની ઊંચાઈને ઇંચમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170654014531">
<para id="fs-id1170654014533">76 ઇંચ</para>
</solution>
</exercise>
<exercise id="fs-id1170654079925">
<problem id="fs-id1170654079927">
<para id="fs-id1170654067982">ફેઈની ઊંચાઈ 4 ફૂટ 10 ઇંચ છે. તેની ઊંચાઈને ઇંચમાં ફેરવો.</para>
</problem>
</exercise>
<exercise id="fs-id1170653898370">
<problem id="fs-id1170653793290">
<para id="fs-id1170653793293">મેફ્લાવર <emphasis effect="italics">નામના જહાજની મુસાફરી</emphasis> 2 મહિના અને 5 દિવસ ચાલી. સમયને દિવસમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170654159512">
<para id="fs-id1170653886635">65 દિવસ</para>
</solution>
</exercise>
<exercise id="fs-id1170653791390">
<problem id="fs-id1170654035875">
<para id="fs-id1170654035878">લિનની સમુદ્રી સફર 6 દિવસ 18 કલાક ચાલી. સમયને કલાકમાં ફેરવો.</para>
</problem>
</exercise>
<exercise id="fs-id1170653737986">
<problem id="fs-id1170654115541">
<para id="fs-id1170654115543">જન્મ સમયે બાળક પ્રેસ્ટનનું વજન 7 પાઉન્ડ 3 ઔંસ હતું. તેનું વજન ઔંસમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170654080904">
<para id="fs-id1170653889814">115 ઔંસ</para>
</solution>
</exercise>
<exercise id="fs-id1170654128326">
<problem id="fs-id1170654128328">
<para id="fs-id1170654125330">જન્મ સમયે બાળક ઑડ્રીનું વજન 6 પાઉન્ડ 15 ઔંસ હતું. તેનું વજન ઔંસમાં ફેરવો.</para>
</problem>
</exercise>
<para id="fs-id1170654236813"><emphasis effect="bold">યુ.એસ. પદ્ધતિમાં માપનના મિશ્ર એકમો વાપરો</emphasis></para>
<para id="fs-id1166425265812">નીચેની કસરતોમાં ઉકેલ શોધો.</para>
<exercise id="fs-id1170653740988">
<problem id="fs-id1170654238944">
<para id="fs-id1170654238946">એલીએ ત્રણ માછલી પકડી. તેમનાં વજન 2 પાઉન્ડ 4 ઔંસ, 1 પાઉન્ડ 11 ઔંસ અને 4 પાઉન્ડ 14 ઔંસ હતાં. ત્રણેય માછલીનું કુલ વજન કેટલું હતું?</para>
</problem>
<solution id="fs-id1170654154464">
<para id="fs-id1170653903666">8 પાઉન્ડ 13 ઔંસ</para>
</solution>
</exercise>
<exercise id="fs-id1170654150129">
<problem id="fs-id1170654239296">
<para id="fs-id1170654239298">જુડીએ 1 પાઉન્ડ 6 ઔંસ બદામ, 2 પાઉન્ડ 3 ઔંસ અખરોટ અને 8 ઔંસ કાજુ ખરીદ્યાં. જુડીએ કુલ કેટલા પાઉન્ડ સૂકો મેવો ખરીદ્યો?</para>
</problem>
</exercise>
<exercise id="fs-id1170653930829">
<problem id="fs-id1170653870754">
<para id="fs-id1170653870756">એક દિવસે અન્યા પોતાની વાહન ચલાવવાની મિનિટો નોંધતી હતી. તેણે 45, 10, 8, 65, 20 અને 35 મિનિટ નોંધ્યાં. અન્યાએ કેટલા કલાક વાહન ચલાવ્યું?</para>
</problem>
<solution id="fs-id1170654157570">
<para id="fs-id1170653809609">3.05 કલાક</para>
</solution>
</exercise>
<exercise id="fs-id1170654275904">
<problem id="fs-id1170653740271">
<para id="fs-id1170653740273">ગયા વર્ષે એરિક 6 વ્યાવસાયિક પ્રવાસે ગયો. દરેક પ્રવાસના દિવસોની સંખ્યા 5, 2, 8, 12, 6 અને 3 હતી. ગયા વર્ષે એરિકે વ્યાવસાયિક પ્રવાસમાં કેટલાં અઠવાડિયાં વિતાવ્યાં?</para>
</problem>
</exercise>
<exercise id="fs-id1170653850272">
<problem id="fs-id1170654073699">
<para id="fs-id1170654073701">રેનેએ પોતાના કમ્પ્યૂટરની 3 ફૂટ 8 ઇંચની વીજતાર સાથે 6 ફૂટ 6 ઇંચનો એક્સ્ટેન્શન તાર જોડ્યો. બંને તારની કુલ લંબાઈ કેટલી હતી?</para>
</problem>
<solution id="fs-id1170652630010">
<para id="fs-id1170652630012">10 ફૂટ 2 ઇંચ</para>
</solution>
</exercise>
<exercise id="fs-id1170653889064">
<problem id="fs-id1170653889066">
<para id="fs-id1170654080766">ફાવઝીની એસયુવી 6 ફૂટ 4 ઇંચ ઊંચી છે. જો તે એસયુવી પર 2 ફૂટ 10 ઇંચનું ખોખું મૂકે, તો એસયુવી અને ખોખાની કુલ ઊંચાઈ કેટલી થાય?</para>
</problem>
</exercise>
<exercise id="fs-id1170652621488">
<problem id="fs-id1170652621490">
<para id="fs-id1170652664087">લેઈલાની 8 પ્લેસમૅટ બનાવવા માગે છે. દરેક માટે તેને 18 ઇંચ કાપડ જોઈએ. 8 પ્લેસમૅટ માટે કેટલા યાડ કાપડ જોઈએ?</para>
</problem>
<solution id="fs-id1170653870809">
<para id="fs-id1170653869446">4 યાડ</para>
</solution>
</exercise>
<exercise id="fs-id1170653990930">
<problem id="fs-id1170653990932">
<para id="fs-id1170654228700">મિરેઈલને પોતાના નૃત્યવર્ગની 12 છોકરીઓમાંથી દરેક માટે 24 ઇંચ રિબન કાપવાની છે. તેને કુલ કેટલા યાડ રિબન જોઈએ?</para>
</problem>
</exercise>
<para id="fs-id1170654075429"><emphasis effect="bold">મેટ્રિક પદ્ધતિમાં એકમોનું રૂપાંતર કરો</emphasis></para>
<para id="fs-id1166420323132">નીચેની કસરતોમાં એકમોનું રૂપાંતર કરો.</para>
<exercise id="fs-id1170653771772">
<problem id="fs-id1170654085000">
<para id="fs-id1170654085002">ગાલિબ 5 કિલોમીટર દોડ્યો. લંબાઈને મીટરમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170654239348">
<para id="fs-id1170654037921">5,000 મીટર</para>
</solution>
</exercise>
<exercise id="fs-id1170653990786">
<problem id="fs-id1170653869751">
<para id="fs-id1170653869753">કિટાકા 8 કિલોમીટર ચાલ્યો. લંબાઈને મીટરમાં ફેરવો.</para>
</problem>
</exercise>
<exercise id="fs-id1170652667198">
<problem id="fs-id1170652667200">
<para id="fs-id1170654125368">એસ્ટ્રેલાની ઊંચાઈ 1.55 મીટર છે. તેની ઊંચાઈને સેન્ટિમીટરમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170653772983">
<para id="fs-id1170653772986">155 સેન્ટિમીટર</para>
</solution>
</exercise>
<exercise id="fs-id1170653750275">
<problem id="fs-id1170653750277">
<para id="fs-id1170653770371">છીછરા પાણીના હોજની પહોળાઈ 2.45 મીટર છે. પહોળાઈને સેન્ટિમીટરમાં ફેરવો.</para>
</problem>
</exercise>
<exercise id="fs-id1170653799995">
<problem id="fs-id1170653744079">
<para id="fs-id1170653744081">માઉન્ટ વ્હિટની 3,072 મીટર ઊંચું છે. ઊંચાઈને કિલોમીટરમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170654231328">
<para id="fs-id1170654237384">3.072 કિલોમીટર</para>
</solution>
</exercise>
<exercise id="fs-id1170653761201">
<problem id="fs-id1170654009025">
<para id="fs-id1170654009028">મૅરિઆના ટ્રેન્ચની ઊંડાઈ 10,911 મીટર છે. ઊંડાઈને કિલોમીટરમાં ફેરવો.</para>
</problem>
</exercise>
<exercise id="fs-id1170654149856">
<problem id="fs-id1170654149858">
<para id="fs-id1170654182737">જૂનની મલ્ટિવિટામિન ગોળીમાં 1,500 મિલીગ્રામ કૅલ્શિયમ છે. તેને ગ્રામમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170652616943">
<para id="fs-id1170652618202">1.5 ગ્રામ</para>
</solution>
</exercise>
<exercise id="fs-id1170654030582">
<problem id="fs-id1170654030584">
<para id="fs-id1170654022367">સામાન્ય રૂબી-થ્રોટેડ હમિંગબર્ડનું વજન 3 ગ્રામ હોય છે. તેને મિલીગ્રામમાં ફેરવો.</para>
</problem>
</exercise>
<exercise id="fs-id1170653878005">
<problem id="fs-id1170653878007">
<para id="fs-id1170653899962">માખણની એક સ્ટિકમાં 91.6 ગ્રામ ચરબી હોય છે. તેને મિલીગ્રામમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170654066916">
<para id="fs-id1170654066918">91,600 મિલીગ્રામ</para>
</solution>
</exercise>
<exercise id="fs-id1170652665848">
<problem id="fs-id1170653897879">
<para id="fs-id1170653897881">ગૌર્મે આઇસક્રીમની એક માત્રામાં 25 ગ્રામ ચરબી હોય છે. તેને મિલીગ્રામમાં ફેરવો.</para>
</problem>
</exercise>
<exercise id="fs-id1170653742509">
<problem id="fs-id1170653740911">
<para id="fs-id1170653740913">હવાઈ ટપાલના પત્રનું મહત્તમ દળ 2 કિલોગ્રામ છે. તેને ગ્રામમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170653878263">
<para id="fs-id1170653903704">2,000 ગ્રામ</para>
</solution>
</exercise>
<exercise id="fs-id1170654150997">
<problem id="fs-id1170654150999">
<para id="fs-id1170652666532">જન્મ સમયે દિમિત્રીની દીકરીનું વજન 3.8 કિલોગ્રામ હતું. તેને ગ્રામમાં ફેરવો.</para>
</problem>
</exercise>
<exercise id="fs-id1170653793358">
<problem id="fs-id1170653793361">
<para id="fs-id1170653771684">વાઇનની બૉટલમાં 750 મિલીલીટર હતું. તેને લીટરમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170653739001">
<para id="fs-id1170653739003">0.75 લીટર</para>
</solution>
</exercise>
<exercise id="fs-id1170654157160">
<problem id="fs-id1170654157162">
<para id="fs-id1170653776712">દવાની બૉટલમાં 300 મિલીલીટર હતું. તેને લીટરમાં ફેરવો.</para>
</problem>
</exercise>
<para id="fs-id1170653916569"><emphasis effect="bold">મેટ્રિક પદ્ધતિમાં માપનના મિશ્ર એકમો વાપરો</emphasis></para>
<para id="fs-id1166424959232">નીચેની કસરતોમાં ઉકેલ શોધો.</para>
<exercise id="fs-id1170653774011">
<problem id="fs-id1170653774013">
<para id="fs-id1170654012375">મૅથિયસની ઊંચાઈ 1.8 મીટર છે. તેના દીકરાની ઊંચાઈ 89 સેન્ટિમીટર છે. મૅથિયસ પોતાના દીકરા કરતાં કેટલો ઊંચો છે?</para>
</problem>
<solution id="fs-id1170652666013">
<para id="fs-id1170652666015">91 સેન્ટિમીટર</para>
</solution>
</exercise>
<exercise id="fs-id1170654016409">
<problem id="fs-id1170654016411">
<para id="fs-id1170654229985">સ્ટાવ્રોસની ઊંચાઈ 1.6 મીટર છે. તેની બહેનની ઊંચાઈ 95 સેન્ટિમીટર છે. સ્ટાવ્રોસ પોતાની બહેન કરતાં કેટલો ઊંચો છે?</para>
</problem>
</exercise>
<exercise id="fs-id1170654114380">
<problem id="fs-id1170654114382">
<para id="fs-id1170652666995">સામાન્ય કબૂતરનું વજન 345 ગ્રામ અને સામાન્ય બતકનું 1.2 કિલોગ્રામ છે. બતક અને કબૂતરના વજનનો ગ્રામમાં તફાવત કેટલો છે?</para>
</problem>
<solution id="fs-id1170653777141">
<para id="fs-id1170653777143">855 ગ્રામ</para>
</solution>
</exercise>
<exercise id="fs-id1170653851116">
<problem id="fs-id1170653851118">
<para id="fs-id1170653736930">કોન્ચેટા પાસે 2 કિલોગ્રામ લોટની થેલી હતી. તેણે બિસ્કોટી બનાવવા 180 ગ્રામ લોટ વાપર્યો. થેલીમાં કેટલા કિલોગ્રામ લોટ બાકી છે?</para>
</problem>
</exercise>
<exercise id="fs-id1170653832002">
<problem id="fs-id1170653832004">
<para id="fs-id1170654075298">હૅરીએ 5 પાર્સલ મોકલ્યાં, દરેકનું વજન 420 ગ્રામ હતું. પાર્સલનું કુલ વજન કિલોગ્રામમાં કેટલું હતું?</para>
</problem>
<solution id="fs-id1170654038016">
<para id="fs-id1170654038018">2.1 કિલોગ્રામ</para>
</solution>
</exercise>
<exercise id="fs-id1170652620603">
<problem id="fs-id1170652620605">
<para id="fs-id1170654116204">એક ગ્લાસ નારંગીના રસમાંથી 560 મિલીગ્રામ પોટૅશિયમ મળે છે. લિન્ડા દર સવારે એક ગ્લાસ રસ પીવે છે. 30 દિવસમાં તેને રસમાંથી કેટલા ગ્રામ પોટૅશિયમ મળે છે?</para>
</problem>
</exercise>
<exercise id="fs-id1170653832447">
<problem id="fs-id1170653832449">
<para id="fs-id1170654036062">જોનાસ દિવસમાં 8 વાર 200 મિલીલીટર પાણી પીવે છે. તે એક દિવસમાં કેટલા લીટર પાણી પીવે છે?</para>
</problem>
<solution id="fs-id1170654275731">
<para id="fs-id1170654275733">1.6 લીટર</para>
</solution>
</exercise>
<exercise id="fs-id1170654116892">
<problem id="fs-id1170654116894">
<para id="fs-id1170653909237">સંપૂર્ણ અનાજની સૅન્ડવિચ બ્રેડની એક માત્રામાં 6 ગ્રામ પ્રોટીન મળે છે. તેની 7 માત્રામાંથી કેટલા મિલીગ્રામ પ્રોટીન મળે છે?</para>
</problem>
</exercise>
<para id="fs-id1170653773654"><emphasis effect="bold">યુ.એસ. અને મેટ્રિક માપન પદ્ધતિઓ વચ્ચે રૂપાંતર કરો</emphasis></para>
<para id="fs-id1166424799920">નીચેની કસરતોમાં એકમોનું રૂપાંતર કરો. જવાબને નજીકના દશાંશમાં ફેરવો.</para>
<exercise id="fs-id1170653874704">
<problem id="fs-id1170654150048">
<para id="fs-id1170654150050">બિલની ઊંચાઈ 75 ઇંચ છે. તેની ઊંચાઈને સેન્ટિમીટરમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170652631657">
<para id="fs-id1170654141544">190.5 સેન્ટિમીટર</para>
</solution>
</exercise>
<exercise id="fs-id1170654014023">
<problem id="fs-id1170654014025">
<para id="fs-id1170654215755">ફ્રૅન્કીની ઊંચાઈ 42 ઇંચ છે. તેની ઊંચાઈને સેન્ટિમીટરમાં ફેરવો.</para>
</problem>
</exercise>
<exercise id="fs-id1170652657474">
<problem id="fs-id1170652657476">
<para id="fs-id1170654149007">માર્કસે અમેરિકન ફૂટબૉલ 24 યાડ દૂર ફેંક્યો. ફેંકની લંબાઈને મીટરમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170653737090">
<para id="fs-id1170653737092">21.9 મીટર</para>
</solution>
</exercise>
<exercise id="fs-id1170653797334">
<problem id="fs-id1170652777045">
<para id="fs-id1170652777047">કોનીએ પડદા બનાવવા 9 યાડ કાપડ ખરીદ્યું. કાપડની લંબાઈને મીટરમાં ફેરવો.</para>
</problem>
</exercise>
<exercise id="fs-id1170653875223">
<problem id="fs-id1170654292136">
<para id="fs-id1170654292138">દરેક અમેરિકન દર વર્ષે સરેરાશ 1,650 પાઉન્ડ કચરો ફેંકે છે. આ વજનને કિલોગ્રામમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170654230264">
<para id="fs-id1170654236254">750 કિલોગ્રામ</para>
</solution>
</exercise>
<exercise id="fs-id1170652750026">
<problem id="fs-id1170652777322">
<para id="fs-id1170652777324">એક સરેરાશ અમેરિકન પોતાના જીવનકાળમાં 90,000 પાઉન્ડ કચરો ફેંકશે. આ વજનને કિલોગ્રામમાં ફેરવો.</para>
</problem>
</exercise>
<exercise id="fs-id1170652696519">
<problem id="fs-id1170653770465">
<para id="fs-id1170653770467">5K દોડ 5 કિલોમીટર લાંબી છે. આ લંબાઈને માઈલમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170653905130">
<para id="fs-id1170653913390">3.1 માઈલ</para>
</solution>
</exercise>
<exercise id="fs-id1170654142498">
<problem id="fs-id1170654142500">
<para id="fs-id1170654239796">કૅથરિનની ઊંચાઈ 1.6 મીટર છે. તેની ઊંચાઈને ફૂટમાં ફેરવો.</para>
</problem>
</exercise>
<exercise id="fs-id1170653740244">
<problem id="fs-id1170653740246">
<para id="fs-id1170654192523">ડૉનના સૂટકેસનું વજન 20 કિલોગ્રામ હતું. વજનને પાઉન્ડમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170653904587">
<para id="fs-id1170653904589">44 પાઉન્ડ</para>
</solution>
</exercise>
<exercise id="fs-id1170654010293">
<problem id="fs-id1170654010295">
<para id="fs-id1170654013477">જૅક્સનના બૅકપૅકનું વજન 15 કિલોગ્રામ હતું. વજનને પાઉન્ડમાં ફેરવો.</para>
</problem>
</exercise>
<exercise id="fs-id1170652623485">
<problem id="fs-id1170652623487">
<para id="fs-id1170654071396">ઑઝીએ પોતાના ટ્રકમાં 14 ગૅલન ઇંધણ ભરાવ્યું. કદને લીટરમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170653751940">
<para id="fs-id1170653751943">53.2 લીટર</para>
</solution>
</exercise>
<exercise id="fs-id1170654235218">
<problem id="fs-id1170653908584">
<para id="fs-id1170653908586">બર્નાર્ડે 8 ગૅલન રંગ ખરીદ્યો. કદને લીટરમાં ફેરવો.</para>
</problem>
</exercise>
<para id="fs-id1170654204869"><emphasis effect="bold">ફેરનહીટ અને સેલ્સિયસ તાપમાન વચ્ચે રૂપાંતર કરો</emphasis></para>
<para id="fs-id1166422524475">નીચેની કસરતોમાં ફેરનહીટ તાપમાનને સેલ્સિયસ ડિગ્રીમાં ફેરવો. જવાબને નજીકના દશાંશમાં ફેરવો.</para>
<exercise id="fs-id1170654010969">
<problem id="fs-id1170654010971">
<para id="fs-id1170653767701"><m:math><m:mrow><m:mn>86</m:mn><m:mtext>°</m:mtext></m:mrow></m:math> ફેરનહીટ</para>
</problem>
<solution id="fs-id1170653868917">
<para id="fs-id1170654286121"><m:math><m:mrow><m:mn>30</m:mn><m:mtext>°</m:mtext><m:mtext>C</m:mtext></m:mrow></m:math>
</para>
</solution>
</exercise>
<exercise id="fs-id1170652788374">
<problem id="fs-id1170653908559">
<para id="fs-id1170653908562"><m:math><m:mrow><m:mn>77</m:mn><m:mtext>°</m:mtext></m:mrow></m:math> ફેરનહીટ</para>
</problem>
</exercise>
<exercise id="fs-id1170654190223">
<problem id="fs-id1170654246120">
<para id="fs-id1170654246123"><m:math><m:mrow><m:mn>104</m:mn><m:mtext>°</m:mtext></m:mrow></m:math> ફેરનહીટ</para>
</problem>
<solution id="fs-id1170653991049">
<para id="fs-id1170653991051"><m:math><m:mrow><m:mn>40</m:mn><m:mtext>°</m:mtext><m:mtext>C</m:mtext></m:mrow></m:math>
</para>
</solution>
</exercise>
<exercise id="fs-id1170654237877">
<problem id="fs-id1170654237879">
<para id="fs-id1170652711658"><m:math><m:mrow><m:mn>14</m:mn><m:mtext>°</m:mtext></m:mrow></m:math> ફેરનહીટ</para>
</problem>
</exercise>
<exercise id="fs-id1170654080020">
<problem id="fs-id1170653870800">
<para id="fs-id1170653870802"><m:math><m:mrow><m:mn>72</m:mn><m:mtext>°</m:mtext></m:mrow></m:math> ફેરનહીટ</para>
</problem>
<solution id="fs-id1170654192537">
<para id="fs-id1170654192539"><m:math><m:mrow><m:mn>22.2</m:mn><m:mtext>°</m:mtext><m:mtext>C</m:mtext></m:mrow></m:math>
</para>
</solution>
</exercise>
<exercise id="fs-id1170654285776">
<problem id="fs-id1170654285778">
<para id="fs-id1170653903644"><m:math><m:mrow><m:mn>4</m:mn><m:mtext>°</m:mtext></m:mrow></m:math> ફેરનહીટ</para>
</problem>
</exercise>
<exercise id="fs-id1170652937000">
<problem id="fs-id1170654149436">
<para id="fs-id1170654149438"><m:math><m:mrow><m:mn>0</m:mn><m:mtext>°</m:mtext></m:mrow></m:math> ફેરનહીટ</para>
</problem>
<solution id="fs-id1170654068994">
<para id="fs-id1170654068996"><m:math><m:mrow><m:mtext>−</m:mtext><m:mn>17.8</m:mn><m:mtext>°</m:mtext><m:mtext>C</m:mtext></m:mrow></m:math>
</para>
</solution>
</exercise>
<exercise id="fs-id1170653899182">
<problem id="fs-id1170652642436">
<para id="fs-id1170652642438"><m:math><m:mrow><m:mn>120</m:mn><m:mtext>°</m:mtext></m:mrow></m:math> ફેરનહીટ</para>
</problem>
</exercise>
<para id="fs-id1170653742219">નીચેની કસરતોમાં સેલ્સિયસ તાપમાનને ફેરનહીટ ડિગ્રીમાં ફેરવો. જવાબને નજીકના દશાંશમાં ફેરવો.</para>
<exercise id="fs-id1170653885395">
<problem id="fs-id1170653885397">
<para id="fs-id1170653874529"><m:math><m:mrow><m:mn>5</m:mn><m:mtext>°</m:mtext></m:mrow></m:math> સેલ્સિયસ</para>
</problem>
<solution id="fs-id1170654075065">
<para id="fs-id1170654075067"><m:math><m:mrow><m:mn>41</m:mn><m:mtext>°</m:mtext><m:mtext>F</m:mtext></m:mrow></m:math>
</para>
</solution>
</exercise>
<exercise id="fs-id1170653795721">
