<para id="fs-id1170652743047"><m:math><m:mrow><m:mn>−8.6</m:mn><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>−8.6</m:mn></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
