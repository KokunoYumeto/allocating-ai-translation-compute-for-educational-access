    {
      "name": "CNX_BMath_Figure_AppB_001.te.svg",
      "localized_sha256": "f182aeca9a4b80f5cb6482ea13c84aa6bae3a7a384c0204fd2609f981b24a926",
      "width": 1480,
      "height": 780,
      "texts": [
        {
          "text": "నేను చేయగలను…",
          "role": "header-te",
          "x": 271.5078125,
          "y": 48,
          "w": 216.984375,
          "h": 35,
          "outsideCell": false
        },
        {
          "text": "I can…",
          "role": "header-en",
          "x": 351.8984375,
          "y": 96,
          "w": 56.203125,
          "h": 27,
          "outsideCell": false
        },
        {
          "text": "నమ్మకంగా",
          "role": "header-te",
          "x": 799.0625,
          "y": 48,
          "w": 122.2744140625,
          "h": 35,
          "outsideCell": false
        },
        {
          "text": "Confidently",
          "role": "header-en",
          "x": 809.3046875,
          "y": 96,
          "w": 101.69921875,
          "h": 27,
          "outsideCell": false
        },
        {
          "text": "కొంత సహాయంతో",
          "role": "header-te",
          "x": 997.6640625,
          "y": 48,
          "w": 205.251953125,
          "h": 35,
          "outsideCell": false
        },
        {
          "text": "With some help",
          "role": "header-en",
          "x": 1029.5703125,
          "y": 96,
          "w": 140.08984375,
          "h": 27,
          "outsideCell": false
        },
        {
          "text": "లేదు—ఇంకా",
          "role": "header-te",
          "x": 1266.078125,
          "y": 26,
          "w": 147.84375,
          "h": 35,
          "outsideCell": false
        },
        {
          "text": "అర్థం కాలేదు!",
          "role": "header-te",
          "x": 1260.7734375,
          "y": 58,
          "w": 158.453125,
          "h": 35,
          "outsideCell": false
        },
        {
          "text": "No—I don’t",
          "role": "header-en",
          "x": 1288.171875,
          "y": 96,
          "w": 103.875,
          "h": 27,
          "outsideCell": false
        },
        {
          "text": "get it!",
          "role": "header-en",
          "x": 1314.1015625,
          "y": 118,
          "w": 51.796875,
          "h": 27,
          "outsideCell": false
        },
        {
          "text": "సహజ సంఖ్యలను, పూర్ణాంకాలను గుర్తించడం",
          "role": "objective-te",
          "x": 38,
          "y": 168,
          "w": 520.015625,
          "h": 35,
          "outsideCell": false
        },
        {
          "text": "identify counting numbers and whole numbers.",
          "role": "objective-en",
          "x": 38,
          "y": 220,
          "w": 438.59375,
          "h": 28,
          "outsideCell": false
        },
        {
          "text": "పూర్ణాంకాలకు నమూనాలు చూపడం",
          "role": "objective-te",
          "x": 38,
          "y": 268,
          "w": 405.1875,
          "h": 35,
          "outsideCell": false
        },
        {
          "text": "model whole numbers.",
          "role": "objective-en",
          "x": 38,
          "y": 320,
          "w": 211.859375,
          "h": 28,
          "outsideCell": false
        },
        {
          "text": "అంకె ఉన్న స్థానాన్ని గుర్తించడం",
          "role": "objective-te",
          "x": 38,
          "y": 368,
          "w": 372.078125,
          "h": 35,
          "outsideCell": false
        },
        {
          "text": "identify the place value of a digit.",
          "role": "objective-en",
          "x": 38,
          "y": 420,
          "w": 306.96875,
          "h": 28,
          "outsideCell": false
        },
        {
          "text": "స్థాన విలువతో పూర్ణాంకాలను",
          "role": "objective-te",
          "x": 38,
          "y": 459,
          "w": 326.9375,
          "h": 35,
          "outsideCell": false
        },
        {
          "text": "అక్షరాలలో రాయడం",
          "role": "objective-te",
          "x": 38,
          "y": 491,
          "w": 244.359375,
          "h": 35,
          "outsideCell": false
        },
        {
          "text": "use place value to name whole numbers.",
          "role": "objective-en",
          "x": 38,
          "y": 520,
          "w": 375.828125,
          "h": 28,
          "outsideCell": false
        },
        {
          "text": "స్థాన విలువతో పూర్ణాంకాలను",
          "role": "objective-te",
          "x": 38,
          "y": 559,
          "w": 326.9375,
          "h": 35,
          "outsideCell": false
        },
        {
          "text": "అంకెలలో రాయడం",
          "role": "objective-te",
          "x": 38,
          "y": 591,
          "w": 230.25,
          "h": 35,
          "outsideCell": false
        },
        {
          "text": "use place value to write whole numbers.",
          "role": "objective-en",
          "x": 38,
          "y": 620,
          "w": 369.6875,
          "h": 28,
          "outsideCell": false
        },
        {
          "text": "పూర్ణాంకాలను నిర్దిష్ట స్థానానికి",
          "role": "objective-te",
          "x": 38,
          "y": 659,
          "w": 331.75,
          "h": 35,
          "outsideCell": false
        },
        {
          "text": "సవరించి రాయడం",
          "role": "objective-te",
          "x": 38,
          "y": 691,
          "w": 220.953125,
          "h": 35,
          "outsideCell": false
        },
        {
          "text": "round whole numbers.",
          "role": "objective-en",
          "x": 38,
