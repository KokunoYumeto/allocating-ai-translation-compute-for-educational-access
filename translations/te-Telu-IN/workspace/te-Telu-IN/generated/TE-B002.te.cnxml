<entry align="center"><m:math><m:mrow><m:mn>1</m:mn></m:mrow></m:math></entry>
<entry align="center"><m:math><m:mrow><m:mn>100</m:mn></m:mrow></m:math></entry>
<entry align="right"><m:math><m:mrow><m:mn>100</m:mn></m:mrow><m:mspace width="1em" /></m:math></entry>
</row>
<row valign="top">
<entry align="center"><m:math><m:mrow><m:mn>3</m:mn></m:mrow></m:math></entry>
<entry align="center">పదులు</entry>
<entry align="center"><m:math><m:mrow><m:mn>3</m:mn></m:mrow></m:math></entry>
<entry align="center"><m:math><m:mrow><m:mn>10</m:mn></m:mrow></m:math></entry>
<entry align="right"><m:math><m:mrow><m:mn>30</m:mn></m:mrow><m:mspace width="1em" /></m:math></entry>
</row>
<row valign="top">
<entry align="center"><m:math><m:mrow><m:mn>8</m:mn></m:mrow></m:math></entry>
