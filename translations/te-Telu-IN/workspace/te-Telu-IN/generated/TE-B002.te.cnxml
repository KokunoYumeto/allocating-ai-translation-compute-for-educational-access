<entry align="center">సంఖ్య</entry>
<entry align="center">విలువ</entry>
<entry align="right">మొత్తం విలువ</entry>
</row>
</thead>
<tbody>
<row valign="top">
<entry align="center"><m:math><m:mrow><m:mn>1</m:mn></m:mrow></m:math></entry>
