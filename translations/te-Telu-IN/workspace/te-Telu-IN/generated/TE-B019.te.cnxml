</problem>
</exercise>
<exercise id="fs-id1791279">
<problem id="fs-id2219928">
<para id="fs-id2277393"><m:math><m:mrow><m:mn>3,740</m:mn><m:mo>+</m:mo><m:mn>18,593</m:mn></m:mrow></m:math></para>
</problem>
