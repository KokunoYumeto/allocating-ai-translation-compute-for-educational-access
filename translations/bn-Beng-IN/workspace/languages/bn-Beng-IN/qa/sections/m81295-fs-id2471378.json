        "eip-id1168469496456"
      ],
      "source_issue": "The table aria-label corrupts $3.99 as >.99 twice and narrates the two final approximate relations as equality, although the table MathML correctly uses ≈.",
      "bengali_correction": "The Bengali aria-label says $3.99 and explicitly narrates $0.166 ≈ $0.17 and $3.99 ÷ 24 ≈ $0.17 as approximations, while preserving all source MathML and table structure.",
      "status": "pixels_and_math_preserved_accessibility_text_corrected"
    },
    {
      "kind": "source_image_alt_decimal_position_mismatch",
      "source_ids": [
        "eip-id1168466131136",
        "eip-id1168469801090"
      ],
      "source_issue": "The 024 first-image alt says the red dot is above the first 1, but the actual pixel places it above the dividend's decimal point. The 025 first-image alt says the dot is above 3, but the actual pixel again places it above the decimal point.",
      "bengali_correction": "Both Bengali alternatives describe the visible dot directly above the dividend decimal point; original raster bytes are unchanged.",
      "status": "pixels_preserved_alt_corrected"
    },
    {
      "kind": "source_image_alt_dividend_typo",
      "source_ids": [
        "fs-id1629721"
      ],
      "source_issue": "The 026 image alt calls a in the fraction notation the 'divided'; the visible image labels a as dividend and b as divisor in all three notations.",
      "bengali_correction": "The Bengali alternative explicitly identifies a as ভাজ্য and b as the nonzero ভাজক in a÷b, a/b and long-division notation.",
      "status": "pixels_preserved_alt_corrected"
    },
