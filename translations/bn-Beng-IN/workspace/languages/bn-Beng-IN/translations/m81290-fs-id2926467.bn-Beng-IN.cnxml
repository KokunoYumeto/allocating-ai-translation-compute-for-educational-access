<?xml version='1.0' encoding='utf-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" xml:lang="bn-Beng-IN" id="m81290-fs-id2926467.bn-Beng-IN"><title>m81290-fs-id2926467</title><content><section id="fs-id2926467" class="section-exercises">
<section id="fs-id2299052" class="practice-perfect">
<title>অনুশীলনে দক্ষতা বাড়ে</title>
<para id="fs-id2165515"><emphasis effect="bold">মডেলের সাহায্যে মিশ্র ভগ্নাংশের যোগ</emphasis> </para><para id="eip-731">নীচের অনুশীলনীগুলিতে মডেলের সাহায্যে যোগফল নির্ণয় করো। তোমার মডেলটি ছবি এঁকে দেখাও। সব গোটা অংশ একই মাপের ধরো।</para><exercise id="fs-id2716140">
<problem id="fs-id2843031">
<para id="fs-id1302420"><m:math><m:mrow><m:mn>1</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>3</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2817966">
<problem id="fs-id1710595">
<para id="fs-id1784434"><m:math><m:mrow><m:mn>2</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>1</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2145567">
<para id="fs-id1171103736087"><newline />
<media id="fs-id1816266" alt="একই মাপের চারটি বৃত্ত। প্রথম তিনটি পুরো রং করা। চতুর্থ বৃত্তটি তিনটি সমান ভাগে ভাগ করা, যার দুটি রং করা এবং একটি সাদা। রং করা মোট অংশ ৩ গোটা ও লব ২, হর ৩-এর ভগ্নাংশ, অর্থাৎ ৩ গোটা ও দুই তৃতীয়াংশ।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_06_202_img.jpg" />
</media><newline />
<m:math><m:mrow><m:mn>3</m:mn><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1964725">
<problem id="fs-id2619370">
<para id="fs-id2741564"><m:math><m:mrow><m:mn>1</m:mn><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>1</m:mn><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2462758">
<problem id="fs-id1929285">
<para id="fs-id2906599"><m:math><m:mrow><m:mn>1</m:mn><m:mfrac><m:mn>5</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>1</m:mn><m:mfrac><m:mn>5</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id3228154">
<para id="fs-id1171098820953"><newline />
<media id="fs-id2454125" alt="একই মাপের চারটি বৃত্ত। প্রথম তিনটি পুরো রং করা। চতুর্থ বৃত্তটি তিনটি সমান ভাগে ভাগ করা, যার দুটি রং করা এবং একটি সাদা। রং করা মোট অংশ ৩ গোটা ও লব ২, হর ৩-এর ভগ্নাংশ, অর্থাৎ ৩ গোটা ও দুই তৃতীয়াংশ।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_06_202_img.jpg" />
</media><newline />
<m:math><m:mrow><m:mn>3</m:mn><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<para id="fs-id2471200"><emphasis effect="bold">একই হরের মিশ্র ভগ্নাংশের যোগ</emphasis> </para><para id="eip-831">নীচের অনুশীলনীগুলিতে যোগ করো।</para><exercise id="fs-id2284085">
<problem id="fs-id1339837">
<para id="fs-id1983326"><m:math><m:mrow><m:mn>5</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>6</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1560843">
<problem id="fs-id2303898">
<para id="fs-id1376946"><m:math><m:mrow><m:mn>2</m:mn><m:mfrac><m:mn>4</m:mn><m:mn>9</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>5</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2378980">
<para id="fs-id2658519"><m:math><m:mrow><m:mn>7</m:mn><m:mfrac><m:mn>5</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id764543">
<problem id="fs-id1341074">
<para id="fs-id1817002"><m:math><m:mrow><m:mn>4</m:mn><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>9</m:mn><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2171048">
<problem id="fs-id1405783">
<para id="fs-id2608530"><m:math><m:mrow><m:mn>7</m:mn><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mn>3</m:mn><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id3319060">
<para id="fs-id2277965">11</para>
</solution>
</exercise>
<exercise id="fs-id1823582">
<problem id="fs-id1215384">
<para id="fs-id1730404"><m:math><m:mrow><m:mn>3</m:mn><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>6</m:mn><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1200097">
<problem id="fs-id1371064">
<para id="fs-id1630834"><m:math><m:mrow><m:mn>9</m:mn><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>1</m:mn><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2170929">
<para id="fs-id1575855"><m:math><m:mrow><m:mn>11</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2432094">
<problem id="fs-id1789951">
<para id="fs-id2319271"><m:math><m:mrow><m:mn>6</m:mn><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mn>8</m:mn><m:mfrac><m:mn>3</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2348702">
<problem id="fs-id2792546">
<para id="fs-id1701153"><m:math><m:mrow><m:mn>8</m:mn><m:mfrac><m:mn>4</m:mn><m:mn>9</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>2</m:mn><m:mfrac><m:mn>8</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2299150">
<para id="fs-id2967738"><m:math><m:mrow><m:mn>11</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<para id="fs-id1578957"><emphasis effect="bold">মডেলের সাহায্যে মিশ্র ভগ্নাংশের বিয়োগ</emphasis> </para><para id="eip-337">নীচের অনুশীলনীগুলিতে মডেলের সাহায্যে বিয়োগফল নির্ণয় করো। তোমার মডেলটি ছবি এঁকে দেখাও। সব গোটা অংশ একই মাপের ধরো।</para><exercise id="fs-id1369100">
<problem id="fs-id2451214">
<para id="fs-id1967417"><m:math><m:mrow><m:mn>1</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>−</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1151892">
<problem id="fs-id1913663">
<para id="fs-id2330937"><m:math><m:mrow><m:mn>1</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>−</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2495320">
<para id="fs-id1171105067639"><newline />
<media id="fs-id3016845" alt="একটি বৃত্ত আটটি সমান ভাগে ভাগ করা। বাঁ দিকের চারটি ভাগ রং করা, ডান দিকের চারটি সাদা। রং করা অংশের লব ৪, হর ৮; লঘিষ্ঠ আকারে লব ১, হর ২, অর্থাৎ অর্ধেক।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_06_204_img.jpg" />
</media><newline />
<m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<para id="fs-id1884621"><emphasis effect="bold">একই হরের মিশ্র ভগ্নাংশের বিয়োগ</emphasis> </para><para id="eip-951">নীচের অনুশীলনীগুলিতে বিয়োগফল নির্ণয় করো।</para><exercise id="fs-id1516554">
<problem id="fs-id1950630">
<para id="fs-id1886122"><m:math><m:mrow><m:mn>2</m:mn><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>−</m:mo><m:mn>1</m:mn><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2140929">
<problem id="fs-id1547127">
<para id="fs-id1732944"><m:math><m:mrow><m:mn>2</m:mn><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mn>1</m:mn><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1510197">
<para id="fs-id1301576"><m:math><m:mrow><m:mn>1</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2433613">
<problem id="fs-id1388136">
<para id="fs-id1341755"><m:math><m:mrow><m:mn>8</m:mn><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mn>4</m:mn><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2269626">
<problem id="fs-id4333775">
<para id="fs-id1948959"><m:math><m:mrow><m:mn>19</m:mn><m:mfrac><m:mrow><m:mn>13</m:mn></m:mrow><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mn>13</m:mn><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2277402">
<para id="fs-id2200774"><m:math><m:mrow><m:mn>6</m:mn><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2270119">
<problem id="fs-id1160023">
<para id="fs-id2789072"><m:math><m:mrow><m:mn>8</m:mn><m:mfrac><m:mn>3</m:mn><m:mn>7</m:mn></m:mfrac><m:mo>−</m:mo><m:mn>4</m:mn><m:mfrac><m:mn>4</m:mn><m:mn>7</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1762266">
<problem id="fs-id1730400">
<para id="fs-id2567809"><m:math><m:mrow><m:mn>5</m:mn><m:mfrac><m:mn>2</m:mn><m:mn>9</m:mn></m:mfrac><m:mo>−</m:mo><m:mn>3</m:mn><m:mfrac><m:mn>4</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1565773">
<para id="fs-id1166761301176"><m:math><m:mrow><m:mn>1</m:mn><m:mfrac><m:mn>7</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id3414953">
<problem id="fs-id1246342">
<para id="fs-id1407844"><m:math><m:mrow><m:mn>2</m:mn><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>−</m:mo><m:mn>1</m:mn><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1834436">
<problem id="fs-id1969110">
<para id="fs-id2493828"><m:math><m:mrow><m:mn>2</m:mn><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mn>1</m:mn><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2318582">
<para id="fs-id2758762"><m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<para id="fs-id1752756"><emphasis effect="bold">ভিন্ন হরের মিশ্র ভগ্নাংশের যোগ ও বিয়োগ</emphasis> </para><para id="eip-791">নীচের অনুশীলনীগুলিতে যোগফল বা বিয়োগফল নির্ণয় করো এবং প্রযোজ্য ক্ষেত্রে মিশ্র ভগ্নাংশে লেখো। ভগ্নাংশ অংশকে লঘিষ্ঠ আকারে প্রকাশ করো। সম্পাদকীয় স্পষ্টীকরণ: উৎসে সব উত্তর মিশ্র ভগ্নাংশে লিখতে বলা হয়েছে; তবে ফলের পরম মান ১-এর কম হলে লঘিষ্ঠ আকারে ভগ্নাংশ লিখবে এবং ঋণাত্মক হলে ঋণচিহ্ন রাখবে। পূর্ণসংখ্যা হলে পূর্ণসংখ্যাই লিখবে।</para><exercise id="fs-id1841849">
<problem id="fs-id1390542">
<para id="fs-id1340660"><m:math><m:mrow><m:mn>3</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>6</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1522774">
<problem id="fs-id1509357">
<para id="fs-id1971802"><m:math><m:mrow><m:mn>2</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>5</m:mn><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2454954">
<para id="fs-id2134084"><m:math><m:mrow><m:mn>7</m:mn><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2266612">
<problem id="fs-id1610273">
<para id="fs-id908845"><m:math><m:mrow><m:mn>1</m:mn><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>4</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id3448276">
<problem id="fs-id4228043">
<para id="fs-id2942973"><m:math><m:mrow><m:mn>7</m:mn><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>8</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2453704">
<para id="fs-id1886241"><m:math><m:mrow><m:mn>16</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1385668">
<problem id="fs-id1736668">
<para id="fs-id1218150"><m:math><m:mrow><m:mn>9</m:mn><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mn>2</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1936948">
<problem id="fs-id2310401">
<para id="fs-id2646654"><m:math><m:mrow><m:mn>6</m:mn><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>−</m:mo><m:mn>1</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1614348">
<para id="fs-id2296184"><m:math><m:mrow><m:mn>5</m:mn><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2626772">
<problem id="fs-id2344527">
<para id="fs-id1863446"><m:math><m:mrow><m:mn>2</m:mn><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>−</m:mo><m:mn>3</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2170228">
<problem id="fs-id1800602">
<para id="fs-id2430783"><m:math><m:mrow><m:mn>2</m:mn><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>−</m:mo><m:mn>4</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2278294">
<para id="fs-id908853"><m:math><m:mrow><m:mn>−1</m:mn><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>24</m:mn></m:mrow></m:mfrac></m:mrow></m:math>। এখানে ঋণচিহ্নটি গোটা মিশ্র ভগ্নাংশের মানের উপর প্রযোজ্য: ১ গোটা ও লব ১১, হর ২৪-এর ভগ্নাংশের যোগফলের বিপরীত সংখ্যা। এটি ঋণাত্মক ১-এর সঙ্গে ধনাত্মক এগারো চব্বিশাংশের যোগ নয়।</para>
</solution>
</exercise>
<para id="fs-id1360468"><emphasis effect="bold">সমন্বিত অনুশীলন</emphasis> </para><para id="eip-734">নীচের অনুশীলনীগুলিতে নির্দেশিত গাণিতিক ক্রিয়াটি করো এবং ফলকে লঘিষ্ঠ আকারে প্রকাশ করো। প্রযোজ্য ক্ষেত্রে মিশ্র ভগ্নাংশে লেখো। সম্পাদকীয় স্পষ্টীকরণ: উৎসের সব উত্তর মিশ্র ভগ্নাংশে লেখার নির্দেশটি এখানে সব প্রশ্নে খাটে না। ফলের পরম মান ১-এর কম হলে ভগ্নাংশে, আর পূর্ণসংখ্যা হলে পূর্ণসংখ্যায় রাখো। ঋণাত্মক ফলের ঋণচিহ্ন বজায় রাখো।</para><exercise id="fs-id1381829">
<problem id="fs-id1824249">
<para id="fs-id2281536"><m:math><m:mrow><m:mn>2</m:mn><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>·</m:mo><m:mn>1</m:mn><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1549369">
<problem id="fs-id2310759">
<para id="fs-id2275768"><m:math><m:mrow><m:mn>1</m:mn><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>·</m:mo><m:mn>4</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2454022">
<para id="fs-id2134618"><m:math><m:mrow><m:mn>6</m:mn><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mrow><m:mn>18</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2795160">
<problem id="fs-id808272">
<para id="fs-id2785561"><m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>7</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>4</m:mn><m:mn>7</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1823569">
<problem id="fs-id1932677">
<para id="fs-id2792428"><m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>9</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2266732">
<para id="fs-id2719421"><m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2295448">
<problem id="fs-id1375497">
<para id="fs-id1611460"><m:math><m:mrow><m:mn>1</m:mn><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2372861">
<problem id="fs-id2308930">
<para id="fs-id2458948"><m:math><m:mrow><m:mn>2</m:mn><m:mfrac><m:mn>3</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1735513">
<para id="fs-id1630264">23</para>
</solution>
</exercise>
<exercise id="fs-id1726392">
<problem id="fs-id1511893">
<para id="fs-id1863041"><m:math><m:mrow><m:mn>13</m:mn><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mn>9</m:mn><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1356690">
<problem id="fs-id1217217">
<para id="fs-id1531769"><m:math><m:mrow><m:mn>15</m:mn><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>−</m:mo><m:mn>6</m:mn><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1408147">
<para id="fs-id1799412"><m:math><m:mrow><m:mn>8</m:mn><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2678903">
<problem id="fs-id2339918">
<para id="fs-id1519191"><m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>9</m:mn></m:mfrac><m:mo>−</m:mo><m:mfrac><m:mn>4</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2222872">
<problem id="fs-id769304">
<para id="fs-id2222104"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1523928">
<para id="fs-id2382179"><m:math><m:mrow><m:mfrac><m:mn>4</m:mn><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id3335905">
<problem id="fs-id2749365">
<para id="fs-id1931570"><m:math><m:mrow><m:mn>4</m:mn><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1973825">
<problem id="fs-id1368412">
<para id="fs-id1738645"><m:math><m:mrow><m:mn>6</m:mn><m:mo>−</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1805564">
<para id="fs-id1378469"><m:math><m:mrow><m:mn>5</m:mn><m:mfrac><m:mn>3</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2661403">
<problem id="fs-id2467039">
<para id="fs-id1732260"><m:math><m:mrow><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2482150">
<problem id="fs-id1885599">
<para id="fs-id2909060"><m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>24</m:mn></m:mrow></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mrow><m:mn>14</m:mn></m:mrow><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1499793">
<para id="fs-id4223958"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>16</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1562863">
<problem id="fs-id1779075">
<para id="fs-id1966036"><m:math><m:mrow><m:mn>9</m:mn><m:mfrac><m:mn>6</m:mn><m:mrow><m:mn>11</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mn>7</m:mn><m:mfrac><m:mrow><m:mn>10</m:mn></m:mrow><m:mrow><m:mn>11</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2471251">
<problem id="fs-id2594085">
<para id="fs-id2084975"><m:math><m:mrow><m:mn>8</m:mn><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>13</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mn>4</m:mn><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>13</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2362854">
<para id="fs-id1548299"><m:math><m:mrow><m:mn>13</m:mn><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>13</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1345384">
<problem id="fs-id1598281">
<para id="fs-id2453665"><m:math><m:mrow><m:mn>3</m:mn><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>5</m:mn><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2880449">
<problem id="fs-id2789146">
<para id="fs-id2466425"><m:math><m:mrow><m:mn>2</m:mn><m:mfrac><m:mn>5</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>4</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1470525">
<para id="fs-id1580822"><m:math><m:mrow><m:mn>7</m:mn><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>30</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1974110">
<problem id="fs-id1518775">
<para id="fs-id1785910"><m:math><m:mrow><m:mfrac><m:mn>8</m:mn><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mrow><m:mn>10</m:mn></m:mrow><m:mrow><m:mn>19</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1463146">
<problem id="fs-id1409546">
<para id="fs-id2135071"><m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>8</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1223841">
<para id="fs-id2370106"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>10</m:mn></m:mrow><m:mrow><m:mn>27</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2269244">
<problem id="fs-id1619442">
<para id="fs-id1511680"><m:math><m:mrow><m:mn>6</m:mn><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>−</m:mo><m:mn>2</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2819330">
<problem id="fs-id1789711">
<para id="fs-id2174924"><m:math><m:mrow><m:mn>6</m:mn><m:mfrac><m:mn>5</m:mn><m:mn>9</m:mn></m:mfrac><m:mo>−</m:mo><m:mn>4</m:mn><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1335836">
<para id="fs-id2684399"><m:math><m:mrow><m:mn>2</m:mn><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>45</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1278966">
<problem id="fs-id2375487">
<para id="fs-id1948802"><m:math><m:mrow><m:mn>5</m:mn><m:mfrac><m:mn>2</m:mn><m:mn>9</m:mn></m:mfrac><m:mo>−</m:mo><m:mn>4</m:mn><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2299623">
<problem id="fs-id2637756">
<para id="fs-id1826963"><m:math><m:mrow><m:mn>4</m:mn><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>−</m:mo><m:mn>3</m:mn><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2635901">
<para id="fs-id2299037"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mrow><m:mn>24</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</section>
<section id="fs-id2256557" class="everyday">
<title>রোজকার জীবনে গণিত</title>
<exercise id="fs-id2704082">
<problem id="fs-id2642666">
<para id="fs-id1972934"><emphasis effect="bold">সেলাই</emphasis> — রেনাটা তার স্বামী ও ছেলের জন্য একই ধরনের শার্ট সেলাই করছে। যে কাটার ছক সে ব্যবহার করবে, সেই অনুযায়ী স্বামীর শার্টের জন্য লাগবে <m:math><m:mrow><m:mn>2</m:mn><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math> গজ কাপড় এবং ছেলের শার্টের জন্য লাগবে <m:math><m:mrow><m:mn>1</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math> গজ কাপড়। দুটি শার্ট তৈরি করতে তার মোট কত গজ কাপড় লাগবে?</para>
</problem>
</exercise>
<exercise id="fs-id2298122">
<problem id="fs-id1166761303595">
<para id="fs-id2771889"><emphasis effect="bold">সেলাই</emphasis> — পলিনের কাছে জ্যাকেট তৈরির জন্য <m:math><m:mrow><m:mn>3</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math> গজ কাপড় আছে। জ্যাকেটটি তৈরি করতে লাগে <m:math><m:mrow><m:mn>2</m:mn><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math> গজ কাপড়। জ্যাকেট তৈরির পরে তার কত গজ কাপড় বাকি থাকবে?</para>
</problem>
<solution id="fs-id1480665">
<para id="fs-id2212344"><m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math> গজ</para>
</solution>
</exercise>
<exercise id="fs-id1549412">
<problem id="fs-id2201253">
<para id="fs-id1613316"><emphasis effect="bold">ছাপার কাজ</emphasis> — নিশান্ত কম্পিউটার থেকে নিমন্ত্রণপত্র ছাপছে। কাগজের প্রস্থ <m:math><m:mrow><m:mn>8</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math> ইঞ্চি। সে ছাপার অংশের বাঁ দিকে ও ডান দিকে, প্রত্যেক দিকে <m:math><m:mrow><m:mn>1</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math> ইঞ্চি করে ফাঁকা জায়গা রাখে। কাগজে ছাপার অংশের প্রস্থ কত?</para>
</problem>
</exercise>
<exercise id="fs-id2140723">
<problem id="fs-id1517156">
<para id="fs-id2908975"><emphasis effect="bold">ছবিতে ফ্রেম লাগানো</emphasis> — টেসা তার ছেলের পড়াশোনা শেষ করার স্মারক ছবির জন্য একটি ফ্রেম কিনেছে। ছবির প্রস্থ <m:math><m:mn>8</m:mn></m:math> ইঞ্চি। ছবির চারদিকে ফ্রেমের পাতের প্রস্থ প্রত্যেক দিকে <m:math><m:mrow><m:mn>2</m:mn><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math> ইঞ্চি। ফ্রেম লাগানো ছবিটির মোট প্রস্থ কত হবে?</para>
</problem>
<solution id="fs-id2620012">
<para id="fs-id2659814"><m:math><m:mrow><m:mn>13</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math> ইঞ্চি</para>
</solution>
</exercise>
</section>
<section id="fs-id3274178" class="writing">
<title>লিখে প্রকাশ করো</title>
<exercise id="fs-id2348872">
<problem id="fs-id1952548">
<para id="fs-id1298662">একটি চিত্র আঁকো এবং সেটি ব্যবহার করে নীচের যোগটি কীভাবে করতে হয়, তা ব্যাখ্যা করো: <m:math><m:mrow><m:mn>1</m:mn><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>2</m:mn><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2922307">
<problem id="fs-id2694337">
<para id="fs-id1779181">শহরে গাড়ি চালিয়ে যেতে এডগারকে পথশুল্ক বা টোল বাবদ <m:math><m:mrow><m:mo>$</m:mo><m:mn>3.75</m:mn></m:mrow></m:math> দিতে হবে। এখানে ডলারে খরচ দেওয়া আছে।</para>
<para id="fs-id2485256"><span class="token">ⓐ</span> বেরোনোর আগে সে কীভাবে <m:math><m:mrow><m:mo>$</m:mo><m:mn>10</m:mn></m:mrow></m:math>-এর নোট ভাঙিয়ে এমন খুচরো নিতে পারে, যাতে টোলের ঠিক পরিমাণটি দিতে পারে? ব্যাখ্যা করো।</para><para id="fs-id2650349"><span class="token">ⓑ</span> নীচের বিয়োগটি করার পদ্ধতির সঙ্গে এডগারের পরিস্থিতির কী মিল আছে, তা ব্যাখ্যা করো: <m:math><m:mrow><m:mn>10</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>?</m:mo></m:mrow></m:math></para></problem>
<solution id="fs-id1389830">
<para id="fs-id1562260">খুচরো নেওয়ার উপায় ও ব্যাখ্যা বিভিন্ন রকম হতে পারে।</para>
</solution>
</exercise>
<exercise id="fs-id1301014">
<problem id="fs-id2146701">
<para id="fs-id2425029">যোগ করো: <m:math><m:mrow><m:mn>4</m:mn><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mn>3</m:mn><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math>। যোগটি দুবার করো—প্রথমবার সংখ্যাগুলিকে মিশ্র ভগ্নাংশের রূপে রেখে, দ্বিতীয়বার অপ্রকৃত ভগ্নাংশে রূপান্তর করে। কোন পদ্ধতিটি তোমার বেশি সুবিধাজনক মনে হয়? কেন?</para>
</problem>
</exercise>
<exercise id="fs-id2587795">
<problem id="fs-id2909109">
<para id="fs-id2268873">বিয়োগ করো: <m:math><m:mrow><m:mn>3</m:mn><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>−</m:mo><m:mn>4</m:mn><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math>। বিয়োগটি দুবার করো—প্রথমবার সংখ্যাগুলিকে মিশ্র ভগ্নাংশের রূপে রেখে, দ্বিতীয়বার অপ্রকৃত ভগ্নাংশে রূপান্তর করে। কোন পদ্ধতিটি তোমার বেশি সুবিধাজনক মনে হয়? কেন?</para>
</problem>
<solution id="fs-id1633226">
<para id="fs-id2277299">ব্যাখ্যা ও পছন্দের পদ্ধতি বিভিন্ন রকম হতে পারে।</para>
</solution>
</exercise>
</section><section id="eip-296"><title>নিজের শেখা যাচাই করো</title><para id="eip-id1168466311226"><span class="token">ⓐ</span> অনুশীলনীগুলি শেষ করার পরে, এই পাঠের শেখার উদ্দেশ্যগুলি কতটা আয়ত্ত করেছ, তা যাচাই করতে এই তালিকাটি ব্যবহার করো।</para>


<para id="eip-611"><figure id="eip-id1164268510606" class="unnumbered"><label /><media id="eip-id1164268510609" alt="নিজের শেখা যাচাই করার তালিকা। প্রতিটি কাজের জন্য তিনটি অবস্থার একটি বেছে নাও: ‘আত্মবিশ্বাসের সঙ্গে পারি’, ‘কিছুটা সাহায্য পেলে পারি’, অথবা ‘না, বুঝতে পারিনি’। কাজগুলি হল: একই হরের মিশ্র ভগ্নাংশের যোগ মডেলের সাহায্যে দেখানো; একই হরের মিশ্র ভগ্নাংশ যোগ করা; মিশ্র ভগ্নাংশের বিয়োগ মডেলের সাহায্যে দেখানো; একই হরের মিশ্র ভগ্নাংশ বিয়োগ করা; ভিন্ন হরের মিশ্র ভগ্নাংশ যোগ ও বিয়োগ করা। মূল ইংরেজি ছবিটি অপরিবর্তিত রাখা হয়েছে; তার সম্পূর্ণ বাংলা পাঠ এখানে দেওয়া হল।"><image mime-type="image/jpg" src="../../media/CNX_BMath_Figure_AppB_025.jpg" /></media></figure>
</para><para id="eip-id1168466075811"><span class="token">ⓑ</span> তালিকাটি দেখে বলো, সব কটি কাজ আত্মবিশ্বাসের সঙ্গে করতে পারার জন্য তুমি কী করবে?</para></section></section>
</content></document>