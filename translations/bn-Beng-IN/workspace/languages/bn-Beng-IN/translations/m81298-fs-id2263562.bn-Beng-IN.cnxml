<para id="fs-id1852233">&gt;</para>
</solution>
</exercise>
<exercise id="fs-id1620295">
<problem id="fs-id1620297">
<para id="fs-id2830266"><m:math><m:mrow><m:mn>−0.44</m:mn><m:mo>___</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2283885">
<problem id="fs-id2684884">
<para id="fs-id2684886"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>___</m:mo><m:mn>−0.925</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1406413">
<para id="fs-id1459626">&gt;</para>
</solution>
</exercise>
<exercise id="fs-id2649967">
<problem id="fs-id1569178">
<para id="fs-id1569180"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>___</m:mo><m:mn>−0.632</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id2452805">নীচের অনুশীলনীগুলিতে প্রতিটি সংখ্যার সেটকে ছোটো থেকে বড়ো ক্রমে লেখো।</para>
<exercise id="fs-id2270973">
<problem id="fs-id1166761304910">
<para id="fs-id1166761304912"><m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>,</m:mo><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>16</m:mn></m:mrow></m:mfrac><m:mo>,</m:mo><m:mn>0.55</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id2319404">
<para id="fs-id2319406"><m:math><m:mrow><m:mn>0.55</m:mn><m:mo>,</m:mo><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>16</m:mn></m:mrow></m:mfrac><m:mo>,</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1529735">
<problem id="fs-id3218119">
<para id="fs-id3218121"><m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>,</m:mo><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac><m:mo>,</m:mo><m:mn>0.36</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2209686">
<problem id="fs-id2209688">
<para id="fs-id1392400"><m:math><m:mrow><m:mn>0.702</m:mn><m:mo>,</m:mo><m:mfrac><m:mrow><m:mn>13</m:mn></m:mrow><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac><m:mo>,</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id4327555">
<para id="fs-id4327557"><m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>,</m:mo><m:mfrac><m:mrow><m:mn>13</m:mn></m:mrow><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac><m:mo>,</m:mo><m:mn>0.702</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2755077">
<problem id="fs-id2785379">
<para id="fs-id2785381"><m:math><m:mrow><m:mn>0.15</m:mn><m:mo>,</m:mo><m:mfrac><m:mn>3</m:mn><m:mrow><m:mn>16</m:mn></m:mrow></m:mfrac><m:mo>,</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1885257">
<problem id="fs-id1885259">
<para id="fs-id1190821"><m:math><m:mrow><m:mn>−0.3</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>,</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1509587">
<para id="fs-id1736773"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac><m:mo>,</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>,</m:mo><m:mo>−</m:mo><m:mn>0.3</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2210219">
<problem id="fs-id2133772">
<para id="fs-id2133774"><m:math><m:mrow><m:mn>−0.2</m:mn><m:mo>,</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac><m:mo>,</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1355823">
<problem id="fs-id1355825">
<para id="fs-id2498364"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>,</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>7</m:mn><m:mn>9</m:mn></m:mfrac><m:mo>,</m:mo><m:mn>−0.7</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id2363018">
<para id="fs-id2785787"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>7</m:mn><m:mn>9</m:mn></m:mfrac><m:mo>,</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>,</m:mo><m:mn>−0.7</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1835884">
<problem id="fs-id2314635">
<para id="fs-id2314637"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>8</m:mn><m:mn>9</m:mn></m:mfrac><m:mo>,</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>,</m:mo><m:mn>−0.9</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id2630755"><emphasis effect="bold">গাণিতিক প্রক্রিয়ার ক্রম মেনে রাশি সরল করো</emphasis> </para><para id="eip-651">নীচের অনুশীলনীগুলিতে প্রতিটি রাশি সরল করো।</para><exercise id="fs-id1609872">
<problem id="fs-id2495732">
