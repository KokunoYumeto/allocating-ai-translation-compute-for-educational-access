</problem>
<solution id="fs-id2138088">
<para id="fs-id2200996"><list id="eip-id1168466190242" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> 31.4 ইঞ্চি </item><item><span class="token">ⓑ</span> 78.5 বর্গ ইঞ্চি</item></list></para></solution>
</exercise>
