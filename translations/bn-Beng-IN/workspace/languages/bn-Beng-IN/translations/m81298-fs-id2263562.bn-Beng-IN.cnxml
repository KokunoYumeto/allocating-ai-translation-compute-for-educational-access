<problem id="fs-id2134943">
<para id="fs-id2134945"><m:math><m:mrow><m:mn>−0.75</m:mn><m:mo>___</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
