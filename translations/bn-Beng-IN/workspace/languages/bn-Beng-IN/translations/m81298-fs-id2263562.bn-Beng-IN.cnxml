<problem id="fs-id1560084">
<para id="fs-id588818"><m:math><m:mrow><m:mn>0.92</m:mn><m:mspace width="0.2em" /><m:mo>___</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2084552">
<problem id="fs-id1753212">
<para id="fs-id1753214"><m:math><m:mrow><m:mn>0.66</m:mn><m:mspace width="0.2em" /><m:mo>___</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2773555">
