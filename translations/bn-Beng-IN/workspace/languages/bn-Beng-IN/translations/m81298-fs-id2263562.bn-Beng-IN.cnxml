<?xml version='1.0' encoding='utf-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" xml:lang="bn-Beng-IN" id="m81298-fs-id2263562.bn-Beng-IN"><title>অধ্যায়ের অনুশীলনী: দশমিক সংখ্যা ও ভগ্নাংশ</title><content><section id="fs-id2263562" class="section-exercises">
<section id="fs-id2758024" class="practice-perfect">
<title>অনুশীলনে দক্ষতা বাড়াও</title>
<para id="fs-id2993174"><emphasis effect="bold">ভগ্নাংশকে দশমিক সংখ্যায় রূপান্তর করো</emphasis> </para><para id="eip-322">নীচের অনুশীলনীগুলিতে প্রতিটি ভগ্নাংশকে দশমিক সংখ্যায় রূপান্তর করো।</para><exercise id="fs-id2368879">
<problem id="fs-id2368881">
<para id="fs-id1781702"><m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1519541">
<para id="fs-id4337737">0.4</para>
</solution>
</exercise>
<exercise id="fs-id1836202">
<problem id="fs-id1836204">
<para id="fs-id1808386"><m:math><m:mrow><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1597518">
<problem id="fs-id1597520">
<para id="fs-id2608770"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2218883">
<para id="fs-id2218885">−0.375</para>
</solution>
</exercise>
<exercise id="fs-id2209715">
<problem id="fs-id3002052">
<para id="fs-id3002054"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1806368">
<problem id="fs-id1806370">
<para id="fs-id1386722"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2993537">
<para id="fs-id2993539">0.85</para>
</solution>
</exercise>
<exercise id="fs-id2842862">
<problem id="fs-id2439739">
<para id="fs-id2439741"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>13</m:mn></m:mrow><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id968949">
<problem id="fs-id968951">
<para id="fs-id1367562"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1832995">
<para id="fs-id1693486">2.75</para>
</solution>
</exercise>
<exercise id="fs-id2150257">
<problem id="fs-id1166761272448">
<para id="fs-id1166761272450"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id3323688">
<problem id="fs-id1795587">
<para id="fs-id1795589"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>310</m:mn></m:mrow><m:mrow><m:mn>25</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2908907">
<para id="fs-id2908909">−12.4</para>
</solution>
</exercise>
<exercise id="fs-id1971579">
<problem id="fs-id3333823">
<para id="fs-id3333825"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>284</m:mn></m:mrow><m:mrow><m:mn>25</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2817805">
<problem id="fs-id1169857">
<para id="fs-id1169859"><m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1322153">
<para id="fs-id1322155"><m:math><m:mrow><m:mn>0</m:mn><m:mo>.</m:mo><m:mover><m:mn>5</m:mn><m:mo>–</m:mo></m:mover></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2777729">
<problem id="fs-id1982062">
<para id="fs-id1982064"><m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2299730">
<problem id="fs-id1917999">
<para id="fs-id1918001"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>15</m:mn></m:mrow><m:mrow><m:mn>11</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2140810">
<para id="fs-id2626374"><m:math><m:mrow><m:mn>1</m:mn><m:mo>.</m:mo><m:mover accent="true"><m:mrow><m:mn>36</m:mn></m:mrow><m:mtext>—</m:mtext></m:mover></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2418764">
<problem id="fs-id2418766">
<para id="fs-id2620249"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>18</m:mn></m:mrow><m:mrow><m:mn>11</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1969744">
<problem id="fs-id1969746">
<para id="fs-id2780348"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>15</m:mn></m:mrow><m:mrow><m:mn>111</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2567714">
<para id="fs-id2567716"><m:math><m:mrow><m:mn>0</m:mn><m:mo>.</m:mo><m:mover accent="true"><m:mrow><m:mn>135</m:mn></m:mrow><m:mtext>—</m:mtext></m:mover></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id4378966">
<problem id="fs-id2835323">
<para id="fs-id2835325"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>25</m:mn></m:mrow><m:mrow><m:mn>111</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id2454274">নীচের অনুশীলনীগুলিতে প্রতিটি রাশি সরল করো।</para><exercise id="fs-id2454278">
<problem id="fs-id1405153">
<para id="fs-id1405155"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>6.5</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1950938">
<para id="fs-id1950941">7</para>
</solution>
</exercise>
<exercise id="fs-id2241333">
<problem id="fs-id2241335">
<para id="fs-id2662695"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>10.75</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1863741">
<problem id="fs-id1960403">
<para id="fs-id1960405"><m:math><m:mrow><m:mn>2.4</m:mn><m:mo>+</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2579415">
<para id="fs-id2579418">3.025</para>
</solution>
</exercise>
<exercise id="fs-id2472625">
<problem id="fs-id2472627">
<para id="fs-id1466647"><m:math><m:mrow><m:mn>3.9</m:mn><m:mo>+</m:mo><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2340972">
<problem id="fs-id2340974">
<para id="fs-id1570497"><m:math><m:mrow><m:mn>9.73</m:mn><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1916650">
<para id="fs-id1916652">10.58</para>
</solution>
</exercise>
<exercise id="fs-id2193162">
<problem id="fs-id2458927">
<para id="fs-id2458929"><m:math><m:mrow><m:mn>6.29</m:mn><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>21</m:mn></m:mrow><m:mrow><m:mn>40</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id1822134"><emphasis effect="bold">দশমিক সংখ্যা ও ভগ্নাংশের ক্রম নির্ণয় করো</emphasis> </para><para id="eip-471">নীচের অনুশীলনীগুলিতে প্রতিটি জোড়া সংখ্যার ক্রম নির্ণয় করতে উপযুক্ত চিহ্নটি বসাও—<m:math><m:mrow><m:mo>&lt;</m:mo></m:mrow></m:math> অথবা <m:math><m:mrow><m:mtext>&gt;.</m:mtext></m:mrow></m:math></para><exercise id="fs-id2474623">
<problem id="fs-id2687332">
<para id="fs-id2687334"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>___</m:mo><m:mn>0.8</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1767321">
<para id="fs-id1767323">&lt;</para>
</solution>
</exercise>
<exercise id="fs-id2649432">
<problem id="fs-id1394448">
<para id="fs-id1394450"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>___</m:mo><m:mn>0.4</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1733266">
<problem id="fs-id1960093">
<para id="fs-id1960095"><m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>___</m:mo><m:mo>0.25</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1833714">
<para id="fs-id1833716">&gt;</para>
</solution>
</exercise>
<exercise id="fs-id1936896">
<problem id="fs-id2174155">
<para id="fs-id2174157"><m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>___</m:mo><m:mn>0.35</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1340088">
<problem id="fs-id4310141">
<para id="fs-id4310143"><m:math><m:mrow><m:mn>0.725</m:mn><m:mspace width="0.2em" /><m:mo>___</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1327865">
<para id="fs-id1405460">&lt;</para>
</solution>
</exercise>
