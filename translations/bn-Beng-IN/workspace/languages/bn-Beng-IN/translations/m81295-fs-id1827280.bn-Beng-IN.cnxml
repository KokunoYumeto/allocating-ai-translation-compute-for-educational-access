</problem>
</exercise>
<exercise id="fs-id2170080">
<problem id="fs-id1151903">
<para id="fs-id1151905"><m:math><m:mrow><m:mn>24</m:mn><m:mo stretchy="false">(</m:mo><m:mn>0.5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:msup><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0.3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
</problem>
<solution id="fs-id1804380">
<para id="fs-id1381229">12.09</para>
</solution>
</exercise>
