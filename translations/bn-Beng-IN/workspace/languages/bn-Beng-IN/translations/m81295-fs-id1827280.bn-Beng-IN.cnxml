<para id="fs-id3340492"><m:math><m:mrow><m:mn>35</m:mn><m:mo stretchy="false">(</m:mo><m:mn>0.2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:msup><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>0.9</m:mn><m:mo stretchy="false">)</m:mo></m:mrow><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1224556">
<problem id="fs-id1224558">
<para id="fs-id2708186"><m:math><m:mrow><m:mn>1.15</m:mn><m:mo stretchy="false">(</m:mo><m:mn>26.83</m:mn><m:mo>+</m:mo><m:mn>1.61</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2778239">
<para id="fs-id2778241">32.706</para>
</solution>
</exercise>
<exercise id="fs-id1886110">
