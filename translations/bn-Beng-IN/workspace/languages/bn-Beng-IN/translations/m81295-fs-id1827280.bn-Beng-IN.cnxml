<problem id="fs-id2418766">
<para id="fs-id2630509"><m:math><m:mrow><m:mn>6</m:mn><m:mo stretchy="false">(</m:mo><m:mn>12.4</m:mn><m:mo>−</m:mo><m:mn>9.2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1347546">
<para id="fs-id1347549">19.2</para>
</solution>
</exercise>
