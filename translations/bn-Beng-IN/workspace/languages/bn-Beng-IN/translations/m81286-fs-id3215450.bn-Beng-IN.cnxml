<entry align="center" valign="top"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>15</m:mn></m:mrow><m:mn>7</m:mn></m:mfrac></m:mrow></m:math></entry>
<entry align="center" />
<entry align="center" />
<entry align="center" />
</row>
<row>
<entry align="center" valign="top"><m:math><m:mrow><m:mn>−9</m:mn></m:mrow></m:math></entry>
<entry align="center" />
<entry align="center" />
<entry align="center" />
</row>
</tbody>
</tgroup>
</table>
</problem>
<solution id="fs-id2492055">
<para id="fs-id1167906045192"><newline />
<media id="fs-id1167906045195" alt="সারণির চার স্তম্ভ: সংখ্যা, বিপরীত সংখ্যা, পরম মান ও গুণাত্মক বিপরীত। প্রথম সারি: ঋণাত্মক ভগ্নাংশ লব ৩ হর ১৩; ভগ্নাংশ লব ৩ হর ১৩; ভগ্নাংশ লব ৩ হর ১৩; ঋণাত্মক ভগ্নাংশ লব ১৩ হর ৩। দ্বিতীয় সারি: ভগ্নাংশ লব ৯ হর ১৪; ঋণাত্মক ভগ্নাংশ লব ৯ হর ১৪; ভগ্নাংশ লব ৯ হর ১৪; ভগ্নাংশ লব ১৪ হর ৯। তৃতীয় সারি: ভগ্নাংশ লব ১৫ হর ৭; ঋণাত্মক ভগ্নাংশ লব ১৫ হর ৭; ভগ্নাংশ লব ১৫ হর ৭; ভগ্নাংশ লব ৭ হর ১৫। শেষ সারি: ঋণাত্মক ৯; ৯; ৯; ঋণাত্মক ভগ্নাংশ লব ১ হর ৯।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_02_201_img.jpg" />
</media></para>
</solution>
</exercise>
<para id="fs-id1607610"><emphasis effect="bold">ভগ্নাংশের ভাগ</emphasis> </para><para id="eip-640">নীচের অনুশীলনগুলিতে চিত্র এঁকে প্রতিটি ভগ্নাংশের ভাগের মডেল দেখাও।</para><exercise id="fs-id764835">
<problem id="fs-id782662">
<para id="fs-id2299819"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1465303">
<problem id="fs-id3165768">
<para id="fs-id1571326"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2279098">
<para id="fs-id2377015">4
<newline />
<media id="fs-idm206228288" alt="উপরের পাতের মান লব ১ ও হর ২-এর ভগ্নাংশ। একই দৈর্ঘ্যের নীচের সারিতে চারটি সমান পাত আছে; প্রতিটির মান লব ১ ও হর ৮-এর ভগ্নাংশ। তাই এক-অর্ধেকের মধ্যে এক-অষ্টমাংশের চারটি দল আছে।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_02_042b_img.jpg" />
</media></para>
</solution>
</exercise>
<exercise id="fs-id1916693">
<problem id="fs-id2157212">
<para id="fs-id4201392"><m:math><m:mrow><m:mn>2</m:mn><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1578681">
<problem id="fs-id2912460">
<para id="fs-id1956495"><m:math><m:mrow><m:mn>3</m:mn><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2439629">
<para id="fs-id1366632">12
<newline />
<media id="fs-idm239861520" alt="উপরের সারিতে পাশাপাশি তিনটি সমগ্র পাত, প্রতিটির মান ১। প্রতিটি সমগ্রের নীচে চারটি সমান ছোটো পাত; প্রতিটির মান লব ১ ও হর ৪-এর ভগ্নাংশ। মোট বারোটি ছোটো পাত আছে, তাই ৩-এর মধ্যে এক-চতুর্থাংশের বারোটি দল আছে।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_02_042d_img.jpg" />
</media></para>
</solution>
</exercise>
<para id="fs-id1464458">নীচের অনুশীলনগুলিতে ভাগ করো এবং উত্তর লঘিষ্ঠ আকারে লেখো। চলযুক্ত রাশির ক্ষেত্রে হর ও ভাজকের মান শূন্য নয় বলে ধরো।</para>
<exercise id="fs-id1858302">
<problem id="fs-id1742800">
<para id="fs-id1531440"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1566978">
<problem id="fs-id2129236">
<para id="fs-id1344614"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1801438">
<para id="fs-id2459937">4</para>
</solution>
</exercise>
<exercise id="fs-id2594981">
<problem id="fs-id2170418">
<para id="fs-id1778575"><m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2427735">
<problem id="fs-id2657860">
<para id="fs-id2301622"><m:math><m:mrow><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1357360">
<para id="fs-id1549993"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>16</m:mn></m:mrow><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1406691">
<problem id="fs-id1374368">
<para id="fs-id4130836"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>4</m:mn><m:mn>7</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2933662">
<problem id="fs-id2260910">
<para id="fs-id1925576"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2246011">
<para id="fs-id1129185"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2212160">
<problem id="fs-id1804559">
<para id="fs-id1833337"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>7</m:mn><m:mn>9</m:mn></m:mfrac><m:mo>÷</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>7</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1518697">
<problem id="fs-id2176000">
<para id="fs-id2904124"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>÷</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
<solution id="fs-id1525626">
<para id="fs-id1239717">1</para>
</solution>
</exercise>
<exercise id="fs-id2283920">
<problem id="fs-id4337752">
<para id="fs-id1579037"><m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mi>x</m:mi><m:mrow><m:mn>11</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id3302722">
<problem id="fs-id1588929">
<para id="fs-id2206389"><m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mi>y</m:mi><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2218036">
<para id="fs-id2352829"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>18</m:mn></m:mrow><m:mrow><m:mn>5</m:mn><m:mi>y</m:mi></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1405693">
