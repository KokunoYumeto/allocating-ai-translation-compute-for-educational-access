</problem>
</exercise>
<exercise id="fs-id3334258">
<problem id="fs-id1265763">
<para id="fs-id1581964"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>5</m:mn><m:mi>q</m:mi></m:mrow><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mrow><m:mn>15</m:mn><m:mi>q</m:mi></m:mrow><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2261312">
<para id="fs-id2142397"><m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id3447846">
<problem id="fs-id2703653">
<para id="fs-id1722355"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>8</m:mn><m:mi>u</m:mi></m:mrow><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mrow><m:mn>12</m:mn><m:mi>v</m:mi></m:mrow><m:mrow><m:mn>25</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2451413">
<problem id="fs-id2790346">
<para id="fs-id2905919"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>12</m:mn><m:mi>r</m:mi></m:mrow><m:mrow><m:mn>25</m:mn></m:mrow></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mrow><m:mn>18</m:mn><m:mi>s</m:mi></m:mrow><m:mrow><m:mn>35</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2497158">
<para id="fs-id4118562"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>14</m:mn><m:mi>r</m:mi></m:mrow><m:mrow><m:mn>15</m:mn><m:mi>s</m:mi></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1524310">
<problem id="fs-id3327298">
<para id="fs-id2678771"><m:math><m:mrow><m:mn>−5</m:mn><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2290556">
