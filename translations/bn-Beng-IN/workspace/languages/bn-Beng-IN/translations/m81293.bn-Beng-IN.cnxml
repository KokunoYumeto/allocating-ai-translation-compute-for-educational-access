<exercise id="fs-id1969211">
<problem id="fs-id747654">
<para id="fs-id747656"><m:math><m:mrow><m:mn>3.1</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1613150">
<para id="fs-id1171102882443"><newline /><media id="fs-id1960314" alt="−5 থেকে 5 পর্যন্ত পূর্ণসংখ্যা-চিহ্নিত সংখ্যারেখা। 3 ও 4-এর মাঝে 3.1 অবস্থানে একটি গাঢ় নীলচে-সবুজ বিন্দু আছে।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_05_01_209_img.jpg" />
</media></para>
</solution>
</exercise>
