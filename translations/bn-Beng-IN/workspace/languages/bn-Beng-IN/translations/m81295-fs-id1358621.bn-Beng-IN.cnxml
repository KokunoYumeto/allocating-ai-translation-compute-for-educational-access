</note>
<note id="fs-id2138939" class="try">
<exercise id="fs-id2219305">
<problem id="fs-id1852067">
<para id="fs-id2467094">গুণ করো: <m:math><m:mrow><m:mn>10.79</m:mn><m:mo stretchy="false">(</m:mo><m:mn>8.12</m:mn><m:mo stretchy="false">).</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1528901">
<para id="fs-id1960506">87.6148</para>
</solution>
