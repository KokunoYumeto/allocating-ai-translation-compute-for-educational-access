<para id="fs-id1383611">গুণ করো: <m:math><m:mrow><m:mn>4.5</m:mn><m:mo stretchy="false">(</m:mo><m:mn>6.107</m:mn><m:mo stretchy="false">).</m:mo></m:mrow></m:math></para>
</problem>
