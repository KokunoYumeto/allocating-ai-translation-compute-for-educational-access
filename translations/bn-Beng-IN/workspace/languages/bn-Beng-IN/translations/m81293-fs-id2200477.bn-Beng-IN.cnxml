<entry align="center"><m:math><m:mn>0.0001</m:mn></m:math></entry>
<entry align="center"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>10,000</m:mn></m:mrow></m:mfrac></m:mrow></m:math></entry>
<entry align="center">দশ হাজার ভাগের এক ভাগ</entry>
