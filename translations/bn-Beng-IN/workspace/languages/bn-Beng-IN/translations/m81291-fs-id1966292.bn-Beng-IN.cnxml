<?xml version='1.0' encoding='utf-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" xml:lang="bn-Beng-IN" id="m81291-fs-id1966292.bn-Beng-IN"><title>এই অংশের অনুশীলনী</title><content><section id="fs-id1966292" class="section-exercises"><title>এই অংশের অনুশীলনী</title><section id="fs-id1308918" class="practice-perfect"><title>অনুশীলনে দক্ষতা</title><para id="fs-id2220581"><emphasis effect="bold">কোনো ভগ্নাংশ একটি সমীকরণের সমাধান কি না নির্ণয় করা</emphasis> </para><para id="eip-672">নিচের অনুশীলনীগুলিতে প্রতিটি সংখ্যা প্রদত্ত সমীকরণের সমাধান কি না নির্ণয় করো।</para><exercise id="fs-id2365303">
<problem id="fs-id1184058">
<para id="fs-id2654759"><m:math><m:mi>x</m:mi><m:mo>−</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac></m:math>:
<list id="eip-id1168469627170" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:math></item>
<item><span class="token">ⓒ</span> <m:math><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:math></item></list></para></problem>
</exercise>
<exercise id="fs-id1693698">
<problem id="fs-id1736844">
<para id="fs-id2275767"><m:math><m:mi>y</m:mi><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:math>:
<list id="eip-id1168466033373" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:math></item>
<item><span class="token">ⓒ</span> <m:math><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:math></item></list></para></problem>
<solution id="fs-id2323022">
<para id="fs-id1393114"><list id="eip-id1168468667325" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> না</item><item><span class="token">ⓑ</span> হ্যাঁ</item><item><span class="token">ⓒ</span> না</item></list></para></solution>
</exercise>
<exercise id="fs-id1969681">
<problem id="fs-id1519174">
<para id="fs-id1572134"><m:math><m:mi>h</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac></m:math>:
<list id="eip-id1168469648984" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mi>h</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mi>h</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac></m:math></item>
<item><span class="token">ⓒ</span> <m:math><m:mi>h</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac></m:math></item></list></para></problem>
</exercise>
<exercise id="fs-id1919632">
<problem id="fs-id1808162">
<para id="fs-id1339163"><m:math><m:mi>k</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>6</m:mn></m:mfrac></m:math>:
<list id="eip-id1168468285421" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mi>k</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mi>k</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>13</m:mn></m:mrow><m:mrow><m:mn>30</m:mn></m:mrow></m:mfrac></m:math></item>
<item><span class="token">ⓒ</span> <m:math><m:mi>k</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>13</m:mn></m:mrow><m:mrow><m:mn>30</m:mn></m:mrow></m:mfrac></m:math></item></list></para></problem>
<solution id="fs-id1932879">
<para id="fs-id2825651"><list id="eip-id1168466162900" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> না</item><item><span class="token">ⓑ</span> হ্যাঁ</item><item><span class="token">ⓒ</span> না</item></list></para></solution>
</exercise>
<para id="fs-id1722646"><emphasis effect="bold">সমতার যোগের, বিয়োগের ও ভাগের ধর্ম ব্যবহার করে ভগ্নাংশযুক্ত সমীকরণ সমাধান</emphasis> </para><para id="eip-891">নিচের সমীকরণগুলি সমাধান করো।</para><exercise id="fs-id2270119">
<problem id="fs-id1948313">
<para id="fs-id1263378"><m:math><m:mrow><m:mi>y</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mn>4</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id4337840">
<problem id="fs-id1394715">
<para id="fs-id1543493"><m:math><m:mrow><m:mi>m</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1547744">
<para id="fs-id2280961"><m:math><m:mrow><m:mi>m</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1569508">
<problem id="fs-id1570447">
<para id="fs-id2205455"><m:math><m:mrow><m:mi>f</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1388457">
<problem id="fs-id2209828">
<para id="fs-id2952179"><m:math><m:mrow><m:mi>h</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2138421">
<para id="fs-id2298245"><m:math><m:mrow><m:mi>h</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2418810">
<problem id="fs-id1567756">
<para id="fs-id1608792"><m:math><m:mrow><m:mi>a</m:mi><m:mo>−</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1609691">
<problem id="fs-id1366251">
<para id="fs-id2635900"><m:math><m:mrow><m:mi>c</m:mi><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2777746">
<para id="fs-id1576804"><emphasis effect="italics">c</emphasis> = −1</para>
</solution>
</exercise>
<exercise id="fs-id1340619">
<problem id="fs-id1917385">
<para id="fs-id1105593"><m:math><m:mrow><m:mi>x</m:mi><m:mo>−</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2670021">
<problem id="fs-id2384127">
<para id="fs-id1863446"><m:math><m:mrow><m:mi>z</m:mi><m:mo>−</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1357191">
<para id="fs-id1356664"><emphasis effect="italics">z</emphasis> = −1</para>
</solution>
</exercise>
<exercise id="fs-id1160115">
<problem id="fs-id1221889">
<para id="fs-id1313205"><m:math><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1519192">
<problem id="fs-id1762340">
<para id="fs-id1458024"><m:math><m:mrow><m:mi>p</m:mi><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1920877">
<para id="fs-id1943541"><m:math><m:mrow><m:mi>p</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>37</m:mn></m:mrow><m:mrow><m:mn>40</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2323269">
<problem id="fs-id871831">
<para id="fs-id1606376"><m:math><m:mrow><m:mi>s</m:mi><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>8</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2678457">
<problem id="fs-id1547420">
<para id="fs-id1594696"><m:math><m:mrow><m:mi>k</m:mi><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1390542">
<para id="fs-id1931672"><m:math><m:mrow><m:mi>k</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2149966">
<problem id="fs-id1530669">
<para id="fs-id3367236"><m:math><m:mrow><m:mn>5</m:mn><m:mi>j</m:mi><m:mo>=</m:mo><m:mn>17</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2217658">
<problem id="fs-id2444865">
<para id="fs-id2276889"><m:math><m:mrow><m:mn>7</m:mn><m:mi>k</m:mi><m:mo>=</m:mo><m:mn>18</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1948959">
<para id="fs-id1562292"><m:math><m:mrow><m:mi>k</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>18</m:mn></m:mrow><m:mn>7</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id3413566">
<problem id="fs-id764542">
<para id="fs-id1328089"><m:math><m:mrow><m:mn>−4</m:mn><m:mi>w</m:mi><m:mo>=</m:mo><m:mn>26</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2365360">
<problem id="fs-id2587650">
<para id="fs-id2352831"><m:math><m:mrow><m:mn>−9</m:mn><m:mi>v</m:mi><m:mo>=</m:mo><m:mn>33</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1569049">
<para id="fs-id1459371"><m:math><m:mrow><m:mi>v</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<para id="fs-id4272492"><emphasis effect="bold">সমতার গুণের ধর্ম ব্যবহার করে ভগ্নাংশযুক্ত সমীকরণ সমাধান</emphasis> </para><para id="eip-746">নিচের সমীকরণগুলি সমাধান করো।</para><exercise id="fs-id2630542">
<problem id="fs-id2750839">
<para id="fs-id2678758"><m:math><m:mrow><m:mfrac><m:mi>f</m:mi><m:mn>4</m:mn></m:mfrac><m:mo>=</m:mo><m:mn>−20</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1371534">
<problem id="fs-id2660984">
<para id="fs-id2154707"><m:math><m:mrow><m:mfrac><m:mi>b</m:mi><m:mn>3</m:mn></m:mfrac><m:mo>=</m:mo><m:mn>−9</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1967416">
<para id="fs-id2364156"><emphasis effect="italics">b</emphasis> = −27</para>
</solution>
</exercise>
<exercise id="fs-id2787518">
<problem id="fs-id1338286">
<para id="fs-id1361007"><m:math><m:mrow><m:mfrac><m:mi>y</m:mi><m:mn>7</m:mn></m:mfrac><m:mo>=</m:mo><m:mn>−21</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2466998">
<problem id="fs-id1943524">
<para id="fs-id1363942"><m:math><m:mrow><m:mfrac><m:mi>x</m:mi><m:mn>8</m:mn></m:mfrac><m:mo>=</m:mo><m:mn>−32</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1823313">
<para id="fs-id1358295"><emphasis effect="italics">x</emphasis> = −256</para>
</solution>
</exercise>
<exercise id="fs-id2619849">
<problem id="fs-id2758763">
<para id="fs-id1218346"><m:math><m:mrow><m:mfrac><m:mi>p</m:mi><m:mrow><m:mn>−5</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mn>−40</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id3274178">
<problem id="fs-id2352971">
<para id="fs-id1357474"><m:math><m:mrow><m:mfrac><m:mi>q</m:mi><m:mrow><m:mn>−4</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mn>−40</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1083670">
<para id="fs-id2909034"><emphasis effect="italics">q</emphasis> = 160</para>
</solution>
</exercise>
<exercise id="fs-id1241982">
<problem id="fs-id1312556">
<para id="fs-id2657725"><m:math><m:mrow><m:mfrac><m:mi>r</m:mi><m:mrow><m:mn>−12</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mn>−6</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2216112">
<problem id="fs-id2646616">
<para id="fs-id2297277"><m:math><m:mrow><m:mfrac><m:mi>s</m:mi><m:mrow><m:mn>−15</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mn>−3</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id2172014">
<para id="fs-id1983342"><emphasis effect="italics">s</emphasis> = 45</para>
</solution>
</exercise>
<exercise id="fs-id2392530">
<problem id="fs-id2368160">
<para id="fs-id1401847"><m:math><m:mrow><m:mo>−</m:mo><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>23</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2655068">
<problem id="fs-id1962484">
<para id="fs-id1951109"><m:math><m:mrow><m:mo>−</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>42</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1358026">
<para id="fs-id2298121"><emphasis effect="italics">y</emphasis> = −42</para>
</solution>
</exercise>
<exercise id="fs-id1531820">
<problem id="fs-id1543448">
<para id="fs-id2192202"><m:math><m:mrow><m:mo>−</m:mo><m:mi>h</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1808252">
<problem id="fs-id1406956">
<para id="fs-id2392720"><m:math><m:mrow><m:mo>−</m:mo><m:mi>k</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2173287">
<para id="fs-id1899854"><m:math><m:mrow><m:mi>k</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id3242308">
<problem id="fs-id1470520">
<para id="fs-id1402051"><m:math><m:mrow><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac><m:mi>n</m:mi><m:mo>=</m:mo><m:mn>20</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1781874">
<problem id="fs-id1371690">
<para id="fs-id1927695"><m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac><m:mi>p</m:mi><m:mo>=</m:mo><m:mn>30</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id2678755">
<para id="fs-id865802"><emphasis effect="italics">p</emphasis> = 100</para>
</solution>
</exercise>
<exercise id="fs-id1894840">
<problem id="fs-id1760754">
<para id="fs-id1262058"><m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac><m:mi>q</m:mi><m:mo>=</m:mo><m:mn>−48</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1701067">
<problem id="fs-id1509549">
<para id="fs-id1308635"><m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>2</m:mn></m:mfrac><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>−40</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1711065">
<para id="fs-id2348802"><emphasis effect="italics">m</emphasis> = −16</para>
</solution>
</exercise>
<exercise id="fs-id1492024">
<problem id="fs-id1620078">
<para id="fs-id1377257"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>9</m:mn></m:mfrac><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>16</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2433503">
<problem id="fs-id2900974">
<para id="fs-id2583272"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>7</m:mn></m:mfrac><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id4337738">
<para id="fs-id2701625"><emphasis effect="italics">b</emphasis> = −21</para>
</solution>
</exercise>
<exercise id="fs-id1544649">
<problem id="fs-id1919363">
<para id="fs-id1341074"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>6</m:mn><m:mrow><m:mn>11</m:mn></m:mrow></m:mfrac><m:mi>u</m:mi><m:mo>=</m:mo><m:mn>−24</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2170307">
<problem id="fs-id1364168">
<para id="fs-id1549883"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac><m:mi>v</m:mi><m:mo>=</m:mo><m:mn>−15</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1511128">
<para id="fs-id1863405"><emphasis effect="italics">v</emphasis> = 36</para>
</solution>
</exercise>
<para id="fs-id2926731"><emphasis effect="bold">মিশ্র অনুশীলন</emphasis> </para><para id="eip-294">নিচের সমীকরণগুলি সমাধান করো।</para><exercise id="fs-id2257996">
<problem id="fs-id1382194">
<para id="fs-id1266000"><m:math><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id3230928">
<problem id="fs-id2281164">
<para id="fs-id1283302"><m:math><m:mrow><m:mn>8</m:mn><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id4222385">
<para id="fs-id1828928"><emphasis effect="italics">y</emphasis> = 0</para>
</solution>
</exercise>
<exercise id="fs-id2483868">
<problem id="fs-id2199619">
<para id="fs-id2278917"><m:math><m:mrow><m:mn>4</m:mn><m:mi>f</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id3301308">
<problem id="fs-id1586770">
<para id="fs-id2642721"><m:math><m:mrow><m:mn>7</m:mn><m:mi>g</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>7</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1575683">
<para id="fs-id2171285"><m:math><m:mrow><m:mi>g</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1216359">
<problem id="fs-id2280537">
<para id="fs-id1387164"><m:math><m:mrow><m:mi>p</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1166761237483">
<problem id="fs-id601306">
<para id="fs-id1620718"><m:math><m:mrow><m:mi>q</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1585472">
<para id="fs-id1816621"><m:math><m:mrow><m:mi>q</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2262648">
<problem id="fs-id2642602">
<para id="fs-id1216884"><m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac><m:mi>m</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2701527">
<problem id="fs-id2839311">
<para id="fs-id2300877"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mi>n</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1362315">
<para id="fs-id1724786"><m:math><m:mrow><m:mi>n</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>14</m:mn></m:mrow><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2214511">
<problem id="fs-id1834143">
<para id="fs-id1822162"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>=</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1910881">
<problem id="fs-id1782388">
<para id="fs-id1382980"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>=</m:mo><m:mi>y</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1184113">
<para id="fs-id2294129"><m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>25</m:mn></m:mrow><m:mrow><m:mn>24</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1344464">
<problem id="fs-id2665545">
<para id="fs-id1633039"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mo>-</m:mo><m:mi>f</m:mi></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2861059">
<problem id="fs-id2577336">
<para id="fs-id3398787"><m:math><m:mrow><m:mfrac><m:mn>8</m:mn><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mo>-</m:mo><m:mtext mathvariant="italic">d</m:mtext></m:mrow></m:math></para>
</problem>
<solution id="fs-id1242625">
<para id="fs-id1524314"><m:math><m:mrow><m:mi>d</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>8</m:mn><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<para id="fs-id1457778"><emphasis effect="bold">বাক্যকে সমীকরণে প্রকাশ করে সমাধান</emphasis> </para><para id="eip-564">নিচের বাক্যগুলিকে বীজগাণিতিক সমীকরণে প্রকাশ করো এবং সমাধান করো।</para><exercise id="fs-id1258801">
<problem id="fs-id2863994">
<para id="fs-id2609697"><m:math><m:mi>n</m:mi></m:math>-কে আট দিয়ে ভাগ করলে ভাগফল হয় <m:math><m:mrow><m:mn>−16</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1967383">
<problem id="fs-id3253872">
<para id="fs-id2275916"><m:math><m:mi>n</m:mi></m:math>-কে ছয় দিয়ে ভাগ করলে ভাগফল হয় <m:math><m:mrow><m:mn>−24</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2934517">
<para id="fs-id764612"><m:math><m:mrow><m:mfrac><m:mi>n</m:mi><m:mn>6</m:mn></m:mfrac><m:mo>=</m:mo><m:mn>−24</m:mn><m:mo>;</m:mo><m:mi>n</m:mi><m:mo>=</m:mo><m:mn>−144</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2140995">
<problem id="fs-id2932890">
<para id="fs-id1956166"><m:math><m:mi>m</m:mi></m:math>-কে <m:math><m:mrow><m:mn>−9</m:mn></m:mrow></m:math> দিয়ে ভাগ করলে ভাগফল হয় <m:math><m:mrow><m:mn>−7</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1264552">
<problem id="fs-id1508771">
<para id="fs-id1568475"><m:math><m:mi>m</m:mi></m:math>-কে <m:math><m:mrow><m:mn>−7</m:mn></m:mrow></m:math> দিয়ে ভাগ করলে ভাগফল হয় <m:math><m:mrow><m:mn>−8</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2630522">
<para id="fs-id2261034"><m:math><m:mrow><m:mfrac><m:mi>m</m:mi><m:mrow><m:mn>−7</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mn>−8</m:mn><m:mo>;</m:mo><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>56</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id4131717">
<problem id="fs-id2140723">
<para id="fs-id1604899"><m:math><m:mi>f</m:mi></m:math>-কে <m:math><m:mrow><m:mn>−3</m:mn></m:mrow></m:math> দিয়ে ভাগ করলে ভাগফল হয় <m:math><m:mrow><m:mn>−18</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2700338">
<problem id="fs-id2199147">
<para id="fs-id2458948"><m:math><m:mi>f</m:mi></m:math>-কে <m:math><m:mrow><m:mn>−4</m:mn></m:mrow></m:math> দিয়ে ভাগ করলে ভাগফল হয় <m:math><m:mrow><m:mn>−20</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2626491">
<para id="fs-id1334897"><m:math><m:mrow><m:mfrac><m:mi>f</m:mi><m:mrow><m:mn>−4</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mn>−20</m:mn><m:mo>;</m:mo><m:mi>f</m:mi><m:mo>=</m:mo><m:mn>80</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1582653">
<problem id="fs-id1379916">
<para id="fs-id1334672"><m:math><m:mi>g</m:mi></m:math>-কে বারো দিয়ে ভাগ করলে ভাগফল হয় <m:math><m:mn>8</m:mn><m:mo>.</m:mo></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2299431">
<problem id="fs-id2626244">
<para id="fs-id1826963"><m:math><m:mi>g</m:mi></m:math>-কে নয় দিয়ে ভাগ করলে ভাগফল হয় <m:math><m:mrow><m:mn>14</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2670572">
<para id="fs-id1202530"><m:math><m:mrow><m:mfrac><m:mi>g</m:mi><m:mn>9</m:mn></m:mfrac><m:mo>=</m:mo><m:mn>14</m:mn><m:mo>;</m:mo><m:mi>g</m:mi><m:mo>=</m:mo><m:mn>126</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2266733">
<problem id="fs-id3173658">
<para id="fs-id4163897"><m:math><m:mi>q</m:mi></m:math>-এর 3/4 অংশ হলো <m:math><m:mrow><m:mn>12</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2630126">
<problem id="fs-id1280169">
<para id="fs-id4228030"><m:math><m:mi>q</m:mi></m:math>-এর 2/5 অংশ হলো <m:math><m:mrow><m:mn>20</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1881083">
<para id="fs-id1833483"><m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac><m:mi>q</m:mi><m:mo>=</m:mo><m:mn>20</m:mn><m:mo>;</m:mo><m:mi>q</m:mi><m:mo>=</m:mo><m:mn>50</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1932310">
<problem id="fs-id1807018">
<para id="fs-id2707707"><m:math><m:mi>p</m:mi></m:math>-এর 7/10 অংশ হলো <m:math><m:mrow><m:mn>−63</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1409912">
<problem id="fs-id1215944">
<para id="fs-id2369590"><m:math><m:mi>p</m:mi></m:math>-এর 4/9 অংশ হলো <m:math><m:mrow><m:mn>−28</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1512471">
<para id="fs-id1183694"><m:math><m:mrow><m:mfrac><m:mn>4</m:mn><m:mn>9</m:mn></m:mfrac><m:mi>p</m:mi><m:mo>=</m:mo><m:mn>−28</m:mn><m:mo>;</m:mo><m:mi>p</m:mi><m:mo>=</m:mo><m:mn>−63</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1543941">
<problem id="fs-id1619721">
<para id="fs-id2671136"><m:math><m:mi>m</m:mi></m:math>-কে <m:math><m:mn>4</m:mn></m:math> দিয়ে ভাগ করলে ভাগফল হয় ঋণাত্মক <m:math><m:mn>6</m:mn><m:mo>.</m:mo></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1166761237416">
<problem id="fs-id2661765">
<para id="fs-id1760915"><m:math><m:mi>h</m:mi></m:math>-কে <m:math><m:mn>2</m:mn></m:math> দিয়ে ভাগ করলে ভাগফল হয় <m:math><m:mrow><m:mn>43</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1514784">
<para id="fs-id1929365"><m:math><m:mrow><m:mfrac><m:mi>h</m:mi><m:mn>2</m:mn></m:mfrac><m:mo>=</m:mo><m:mn>43</m:mn><m:mo>;</m:mo><m:mi>h</m:mi><m:mo>=</m:mo><m:mn>86</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1925529">
<problem id="fs-id1919738">
<para id="fs-id4876925"><m:math><m:mi>z</m:mi></m:math>-এর 3/4 অংশ হলো <m:math><m:mrow><m:mn>15</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1578976">
<problem id="fs-id1336899">
<para id="fs-id1841547"><m:math><m:mrow><m:mi>a</m:mi></m:mrow></m:math>-কে <m:math><m:mrow><m:mfrac><m:mrow><m:mn>2</m:mn></m:mrow><m:mrow><m:mn>3</m:mn></m:mrow></m:mfrac></m:mrow></m:math> দিয়ে ভাগ করলে ভাগফল হয় <m:math><m:mrow><m:mfrac><m:mrow><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2130548">
<para id="fs-id2140251"><m:math><m:mrow><m:mrow><m:mfrac><m:mrow><m:mspace width="0.2em" /><m:mi>a</m:mi><m:mspace width="0.2em" /></m:mrow><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:mfrac></m:mrow><m:mo>=</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>;</m:mo><m:mspace width="0.2em" /><m:mi>a</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2636910">
<problem id="fs-id1387101">
<para id="fs-id2346144">5/6 ও <m:math><m:mi>x</m:mi></m:math>-এর যোগফল হলো <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1566796">
<problem id="fs-id2295647">
<para id="fs-id1732261">3/4 ও <m:math><m:mi>x</m:mi></m:math>-এর যোগফল হলো <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2267186">
<para id="fs-id1029618"><m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>+</m:mo><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>;</m:mo><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2299624">
<problem id="fs-id1949530">
<para id="fs-id1298663"><m:math><m:mi>y</m:mi></m:math> থেকে 1/4 বিয়োগ করলে বিয়োগফল হয় <m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1730718">
<problem id="fs-id1470571">
<para id="fs-id1337914"><m:math><m:mi>y</m:mi></m:math> থেকে 1/3 বিয়োগ করলে বিয়োগফল হয় <m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2467039">
<para id="fs-id2268676"><m:math><m:mrow><m:mi>y</m:mi><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>=</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>;</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</section><section id="fs-id3322439" class="everyday">
<title>রোজকার জীবনে গণিত</title>
<exercise id="fs-id2908975">
<problem id="fs-id1863042">
<para id="fs-id2471025"><emphasis effect="bold">কেনাকাটা</emphasis> — টেরেসা ছাড়ে এক জোড়া জুতো কিনল <m:math><m:mrow><m:mo>$</m:mo><m:mn>48</m:mn></m:mrow></m:math> দামে। ছাড়ের দাম ছিল নিয়মিত দামের <m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math> অংশ। নিচের সমীকরণটি সমাধান করে জুতোজোড়ার নিয়মিত দাম নির্ণয় করো: <m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mi>p</m:mi><m:mo>=</m:mo><m:mn>48</m:mn></m:mrow></m:math>।</para>
</problem>
</exercise>
<exercise id="fs-id1574817">
<problem id="fs-id1264797">
<para id="fs-id1298696"><emphasis effect="bold">খেলাঘর</emphasis> — শিশুর খেলাঘরের টেবিলের উচ্চতা বড়োদের টেবিলের উচ্চতার <m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math> অংশ। খেলাঘরের টেবিলটির উচ্চতা <m:math><m:mrow><m:mn>18</m:mn></m:mrow></m:math> ইঞ্চি। নিচের সমীকরণটি সমাধান করে বড়োদের টেবিলটির উচ্চতা নির্ণয় করো: <m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>5</m:mn></m:mfrac><m:mi>h</m:mi><m:mo>=</m:mo><m:mn>18</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2670750">
<para id="fs-id1564467">30 ইঞ্চি</para>
</solution>
</exercise>
</section>
<section id="fs-id782736" class="writing">
<title>লিখে বোঝাও</title>
<exercise id="fs-id770387">
<problem id="fs-id3231997">
<para id="fs-id833282">মূল পাঠে <link target-id="fs-id2213976">এই উদাহরণের লিঙ্ক</link> দিয়ে এই সমীকরণের তিনটি সমাধান-পদ্ধতির আলোচনা বোঝানো হয়েছে: <m:math><m:mrow><m:mo>−</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>15</m:mn><m:mo>.</m:mo></m:mrow></m:math> কোন পদ্ধতি তোমার পছন্দ? কেন? সম্পাদকীয় উৎস-সতর্কতা: লিঙ্কটি আসলে p/(−8) = −40-এর উদাহরণে নিয়ে যায়, তিন পদ্ধতির আলোচনায় নয়। তিন পদ্ধতির জন্য আগের ‘সহগ −1 হলে সমীকরণ সমাধান’ অংশের উদাহরণটি দেখো।</para>
</problem>
</exercise>
<exercise id="fs-id1525134">
<problem id="fs-id2576938">
<para id="fs-id2646659">রিচার্ডের মতে <m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>24</m:mn></m:mrow></m:math> সমীকরণটির সমাধান হলো <m:math><m:mrow><m:mn>16</m:mn><m:mo>.</m:mo></m:mrow></m:math> রিচার্ড কেন ভুল বলছে, তা ব্যাখ্যা করো।</para>
</problem>
<solution id="fs-id1563314">
<para id="fs-id2166810">ব্যাখ্যা বিভিন্ন রকম হতে পারে।</para>
</solution>
</exercise>
</section><section id="eip-11"><title>নিজেকে যাচাই করো</title><para id="eip-id1168467291107"><span class="token">ⓐ</span> অনুশীলনীগুলি শেষ করে, এই অংশের শেখার উদ্দেশ্যগুলি কতটা আয়ত্ত হয়েছে তা নিচের তালিকা দিয়ে যাচাই করো।</para>

<figure id="eip-id1165721038033" class="unnumbered"><label /><media id="eip-id1165721038036" alt="নিজেকে যাচাই করার সারণি। ‘আমি পারি’ শিরোনামের নিচে চারটি বিষয়: কোনো ভগ্নাংশ সমীকরণের সমাধান কি না নির্ণয় করা; সমতার যোগের, বিয়োগের ও ভাগের ধর্ম ব্যবহার করে ভগ্নাংশযুক্ত সমীকরণ সমাধান করা; সমতার গুণের ধর্ম ব্যবহার করে সমীকরণ সমাধান করা; বাক্যকে সমীকরণে প্রকাশ করে সমাধান করা। প্রতিটি বিষয়ের জন্য তিনটি ঘর: আত্মবিশ্বাসের সঙ্গে পারি; কিছু সাহায্য নিয়ে পারি; না, এখনও বুঝিনি।"><image mime-type="image/jpg" src="../../media/CNX_BMath_Figure_AppB_026.jpg" /></media></figure><para id="eip-id1168466075811"><span class="token">ⓑ</span> তালিকাটি দেখে সামগ্রিকভাবে কি মনে হচ্ছে যে তুমি পরের অধ্যায়ের জন্য ভালোভাবে প্রস্তুত? কেন মনে হচ্ছে বা কেন মনে হচ্ছে না, তা লেখো।</para></section>
</section></content></document>