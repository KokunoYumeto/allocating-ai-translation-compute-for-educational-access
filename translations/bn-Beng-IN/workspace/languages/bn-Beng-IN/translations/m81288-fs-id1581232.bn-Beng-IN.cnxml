<?xml version='1.0' encoding='utf-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" xml:lang="bn-Beng-IN" id="m81288-fs-id1581232.bn-Beng-IN"><title>m81288-fs-id1581232</title><content><note id="fs-id1581232" class="be-prepared">
<exercise id="fs-idm198389824">
<problem id="fs-idm180560288">
<para id="fs-idm197954080">সরল করো: <m:math><m:mrow><m:mfrac><m:mrow><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow><m:mn>6</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math><newline />এই অঙ্কে ভুল হলে <link target-id="fs-id2317911" document="m81287" /> আবার দেখো।</para>
</problem>
<solution id="fs-idm205012720">
<para id="fs-idm157706512"><m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
</content></document>