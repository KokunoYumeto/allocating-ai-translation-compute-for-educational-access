<?xml version='1.0' encoding='utf-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" xml:lang="bn-Beng-IN" id="m81285-fs-id1390550.bn-Beng-IN"><title>ভগ্নাংশ ও মিশ্র ভগ্নাংশকে ছোটো-বড়োর ক্রমে সাজানো</title><content><section id="fs-id1390550">
<title>ভগ্নাংশ ও মিশ্র ভগ্নাংশকে ছোটো-বড়োর ক্রমে সাজানো</title>
<para id="fs-id1369610">অসমতা-চিহ্নের সাহায্যে ভগ্নাংশগুলিকে ছোটো-বড়োর ক্রমে সাজানো যায়। মনে রেখো, <m:math><m:mrow><m:mi>a</m:mi><m:mo>&gt;</m:mo><m:mi>b</m:mi></m:mrow></m:math>-এর অর্থ, সংখ্যারেখায় <m:math><m:mi>a</m:mi></m:math> রয়েছে <m:math><m:mi>b</m:mi></m:math>-এর ডান দিকে। সংখ্যারেখায় বাঁ থেকে ডান দিকে গেলে মান বাড়ে।</para><example id="fs-id1510243">
<exercise id="fs-id1470921"><problem id="fs-id2458837">
<para id="fs-id2135907">প্রতিটি জোড়ার সংখ্যাদুটির মধ্যে <m:math><m:mo>&lt;</m:mo></m:math> বা <m:math><m:mo>&gt;:</m:mo></m:math> চিহ্ন বসিয়ে ছোটো-বড়োর সম্পর্ক দেখাও।<list id="eip-id1168467275138" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mo>−</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>____</m:mo><m:mn>−1</m:mn></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mn>−3</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>____</m:mo><m:mn>−3</m:mn></m:math></item>
<item><span class="token">ⓒ</span> <m:math><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>7</m:mn></m:mfrac><m:mo>____</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac></m:math></item>
<item><span class="token">ⓓ</span> <m:math><m:mn>−2</m:mn><m:mo>____</m:mo><m:mfrac><m:mrow><m:mn>−16</m:mn></m:mrow><m:mn>9</m:mn></m:mfrac></m:math></item></list></para>

</problem>
<solution id="fs-id2719140">
<title>সমাধান</title>
<para id="fs-id1807376"><span class="token">ⓐ</span> <m:math><m:mo>−</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>&gt;</m:mo><m:mn>−1</m:mn></m:math></para><media id="fs-id1340602" alt="সংখ্যারেখায় −3 থেকে 3 পর্যন্ত পূর্ণসংখ্যাগুলি চিহ্নিত। −1 বিন্দুটি দেখানো আছে। −1 ও 0-এর মাঝে −2/3 বিন্দুটি দেখানো আছে; সেটি −1-এর ডান দিকে। তাই −2/3 বড়ো।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_01_064_img.jpg" />
</media>
<para id="fs-id2085055"><span class="token">ⓑ</span> <m:math><m:mn>−3</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>&lt;</m:mo><m:mn>−3</m:mn></m:math></para><media id="fs-id4379002" alt="সংখ্যারেখায় −4 থেকে 4 পর্যন্ত পূর্ণসংখ্যাগুলি চিহ্নিত। −3 বিন্দুটি দেখানো আছে। −4 ও −3-এর মাঝে ঋণাত্মক মিশ্র ভগ্নাংশ −3 1/2, অর্থাৎ −7/2, দেখানো আছে। এটি −3-এর বাঁ দিকে।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_01_065_img.jpg" />
</media>
<para id="fs-id1731809"><span class="token">ⓒ</span> <m:math><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>7</m:mn></m:mfrac><m:mspace width="0.2em" /><m:mtext>&lt;</m:mtext><m:mspace width="0.2em" /><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac></m:math></para><media id="fs-id2262396" alt="সংখ্যারেখায় −3 থেকে 3 পর্যন্ত পূর্ণসংখ্যাগুলি চিহ্নিত। −1 ও 0-এর মাঝে −3/7 এবং −3/8 বিন্দুদুটি দেখানো আছে। −3/7 বিন্দুটি −3/8-এর বাঁ দিকে; তাই −3/7 ছোটো।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_01_066_img.jpg" />
</media>
<para id="fs-id1971918"><span class="token">ⓓ</span> <m:math><m:mn>−2</m:mn><m:mo>&lt;</m:mo><m:mfrac><m:mrow><m:mn>−16</m:mn></m:mrow><m:mn>9</m:mn></m:mfrac></m:math></para><media id="fs-id1807634" alt="সংখ্যারেখায় −3 থেকে 3 পর্যন্ত পূর্ণসংখ্যাগুলি চিহ্নিত। −2 বিন্দুটি দেখানো আছে। −2 ও −1-এর মাঝে −16/9 বিন্দুটি দেখানো আছে। −2 বিন্দুটি −16/9-এর বাঁ দিকে; তাই −2 ছোটো।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_01_067_img.jpg" />
</media>
</solution>
</exercise></example>
<note id="fs-id1617835" class="try">
<exercise id="fs-id2428831">
<problem id="fs-id2267848">
<para id="fs-id2290500">প্রতিটি জোড়ার সংখ্যাদুটির মধ্যে <m:math><m:mo>&lt;</m:mo></m:math> বা <m:math><m:mo>&gt;:</m:mo></m:math> চিহ্ন বসিয়ে ছোটো-বড়োর সম্পর্ক দেখাও।</para>
<para id="fs-id3165501"><list id="eip-id1168468590445" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:munder accentunder="true"><m:mspace width="1em" /><m:mo stretchy="true">__</m:mo></m:munder><m:mo>−</m:mo><m:mn>1</m:mn></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mn>−1</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:munder accentunder="true"><m:mspace width="1em" /><m:mo stretchy="true">__</m:mo></m:munder><m:mo>−</m:mo><m:mn>2</m:mn></m:math></item>
<item><span class="token">ⓒ</span> <m:math><m:mo>−</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:munder accentunder="true"><m:mspace width="1em" /><m:mo stretchy="true">__</m:mo></m:munder><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:math></item>
<item><span class="token">ⓓ</span> <m:math><m:mn>−3</m:mn><m:munder accentunder="true"><m:mspace width="1em" /><m:mo stretchy="true">__</m:mo></m:munder><m:mo>−</m:mo><m:mfrac><m:mn>7</m:mn><m:mn>3</m:mn></m:mfrac></m:math></item></list></para></problem>
<solution id="fs-id2294023">
<para id="fs-id3232156"><list id="eip-id1168468529000" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> &gt;</item><item><span class="token">ⓑ</span> &gt;</item><item><span class="token">ⓒ</span> &lt;</item><item><span class="token">ⓓ</span> &lt;</item></list></para></solution>
</exercise>
</note>
<note id="fs-id2323137" class="try">
<exercise id="fs-id1392860">
<problem id="fs-id1569084">
<para id="fs-id1166761272449">প্রতিটি জোড়ার সংখ্যাদুটির মধ্যে <m:math><m:mo>&lt;</m:mo></m:math> বা <m:math><m:mo>&gt;:</m:mo></m:math> চিহ্ন বসিয়ে ছোটো-বড়োর সম্পর্ক দেখাও।</para>
<para id="fs-id1834425"><list id="eip-id1168468613384" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mn>−3</m:mn><m:mo>__</m:mo><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mn>5</m:mn></m:mfrac></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mn>−2</m:mn><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>__</m:mo><m:mn>−2</m:mn></m:math></item>
<item><span class="token">ⓒ</span> <m:math><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>5</m:mn></m:mfrac><m:munder accentunder="true"><m:mspace width="1em" /><m:mo stretchy="true">__</m:mo></m:munder><m:mo>−</m:mo><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac></m:math></item>
<item><span class="token">ⓓ</span> <m:math><m:mn>−4</m:mn><m:munder accentunder="true"><m:mspace width="1em" /><m:mo stretchy="true">__</m:mo></m:munder><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>10</m:mn></m:mrow><m:mn>3</m:mn></m:mfrac></m:math></item></list></para></problem>
<solution id="fs-id1785204">
<para id="fs-id1614351"><list id="eip-id1168467263798" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> &gt;</item><item><span class="token">ⓑ</span> &lt;</item><item><span class="token">ⓒ</span> &gt;</item><item><span class="token">ⓓ</span> &lt;</item></list></para></solution>
</exercise>
</note>
<note id="fs-id3358130" class="media-2"><title>আরও অনলাইন সহায়ক উপকরণ দেখো</title><list id="fs-id1467308" display="block">
<item><link url="https://www.openstax.org/l/24Introtofract">ভগ্নাংশের পরিচয়</link></item>
<item><link url="https://www.openstax.org/l/24FractPattBloc">নকশার টুকরো দিয়ে ভগ্নাংশ চেনা</link></item>
</list>
</note></section>
</content></document>