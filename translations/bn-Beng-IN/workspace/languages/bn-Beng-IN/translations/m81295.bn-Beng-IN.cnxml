<note id="fs-id4222450" class="try">
<exercise id="fs-id1602846">
<problem id="fs-id2379284">
<para id="fs-id1383316">গুণ করো: <m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>−7.78</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>4.9</m:mn><m:mo stretchy="false">)</m:mo><m:mtext>.</m:mtext></m:mrow></m:math></para>
