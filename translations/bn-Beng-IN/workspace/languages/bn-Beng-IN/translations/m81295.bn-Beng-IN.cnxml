		    <m:mtd><m:munder accentunder="true"><m:mrow><m:mn>4152</m:mn></m:mrow><m:mtext>_____</m:mtext></m:munder></m:mtd>
		</m:mtr>
		<m:mtr>
		    <m:mtd columnalign="right"><m:mn>42558</m:mn></m:mtd>
		</m:mtr>
	</m:mtable>
</m:math>
</entry>
 </row>
 <row>
 <entry><media id="eip-id1168466285144" alt="−8.2 ও 5.19-এর গুণফলে দশমিক বিন্দু ডান দিক থেকে 3 ঘর পরে বসাতে বলা হয়েছে; −8.2-এ 1টি এবং 5.19-এ 2টি দশমিক ঘর চিহ্নিত।"><image mime-type="image/png" src="../../media/CNX_BMath_Figure_05_02_020_img-01.png" /></media></entry>
 <entry><m:math>
	<m:mtable>
