		</m:mtr>
	</m:mtable>
</m:math></entry>
 </row>
 <row>
   <entry>গুণ করো।</entry>
   <entry><m:math>
	<m:mtable>
		<m:mtr>
			<m:mtd columnalign="right"><m:mn>5.19</m:mn></m:mtd>
		</m:mtr>
		<m:mtr>
			<m:mtd columnalign="right"><m:munder accentunder="true"><m:mrow><m:mo>×</m:mo><m:mn>8.2</m:mn></m:mrow><m:mtext>_____</m:mtext></m:munder></m:mtd>
		</m:mtr>
