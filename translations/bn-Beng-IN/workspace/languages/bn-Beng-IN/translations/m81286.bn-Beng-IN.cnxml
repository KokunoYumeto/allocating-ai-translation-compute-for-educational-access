  </row>

</tbody>







</tgroup>
</table><table id="eip-id1170195508737" class="unnumbered unstyled" summary="7-কে লব 7, হর 1-এর ভগ্নাংশের আকারে লিখে গুণাত্মক বিপরীত নির্ণয় এবং গুণফল যাচাই।"><label />
<tgroup cols="2"><tbody>
  <row>
    <entry><span class="token">ⓓ</span> </entry>
    <entry />
  </row>
  <row>
    <entry><m:math><m:mn>7</m:mn></m:math>-এর গুণাত্মক বিপরীত নির্ণয় করো।</entry>
    <entry />
  </row>

<row>
    <entry><m:math><m:mn>7</m:mn></m:math>-কে ভগ্নাংশের আকারে লেখো।</entry>
    <entry><m:math><m:mfrac><m:mrow><m:mn>7</m:mn></m:mrow><m:mrow><m:mn>1</m:mn></m:mrow></m:mfrac></m:math></entry>
  </row>

<row>
<entry><m:math><m:mfrac><m:mrow><m:mn>7</m:mn></m:mrow><m:mrow><m:mn>1</m:mn></m:mrow></m:mfrac></m:math>-এর গুণাত্মক বিপরীত লেখো।</entry>
<entry><m:math><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>7</m:mn></m:mrow></m:mfrac></m:math></entry>
</row>


<row>
    <entry>যাচাই:</entry>
    <entry><m:math><m:mn>7</m:mn><m:mo>⋅</m:mo><m:mo>(</m:mo><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mrow><m:mn>7</m:mn></m:mrow></m:mfrac><m:mo>)</m:mo></m:math></entry>
  </row>


<row>
<entry />
<entry><m:math><m:mn>1</m:mn><m:mo>✓</m:mo></m:math></entry></row>

</tbody>





</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id1602123" class="try">
<exercise id="fs-id2906598">
<problem id="fs-id2171218">
<para id="fs-id2175650">গুণাত্মক বিপরীত নির্ণয় করো:</para>
<para id="fs-id2676883"><list id="eip-id1168469888111" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mfrac><m:mn>5</m:mn><m:mn>7</m:mn></m:mfrac></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:math></item>
<item><span class="token">ⓒ</span> <m:math><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mn>4</m:mn></m:mfrac></m:math></item>
<item><span class="token">ⓓ</span> <m:math><m:mn>14</m:mn></m:math></item></list></para></problem>
<solution id="fs-id2223955">
<para id="fs-id2330674"><list id="eip-id1168468629212" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mfrac><m:mn>7</m:mn><m:mn>5</m:mn></m:mfrac></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mn>−8</m:mn></m:math></item>
<item><span class="token">ⓒ</span> <m:math><m:mo>−</m:mo><m:mfrac><m:mn>4</m:mn><m:mrow><m:mn>11</m:mn></m:mrow></m:mfrac></m:math></item>
<item><span class="token">ⓓ</span> <m:math><m:mfrac><m:mn>1</m:mn><m:mn>14</m:mn></m:mfrac></m:math></item></list></para></solution>
</exercise>
</note>
<note id="fs-id1160285" class="try">
<exercise id="fs-id1918491">
<problem id="fs-id3159114">
<para id="fs-id1512222">গুণাত্মক বিপরীত নির্ণয় করো:</para>
<para id="fs-id1355541"><list id="eip-id1168468483976" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mfrac><m:mn>3</m:mn><m:mn>7</m:mn></m:mfrac></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:math></item>
<item><span class="token">ⓒ</span> <m:math><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>14</m:mn></m:mrow><m:mn>9</m:mn></m:mfrac></m:math></item>
<item><span class="token">ⓓ</span> <m:math><m:mn>21</m:mn></m:math></item></list></para></problem>
<solution id="fs-id2900649">
<para id="fs-id2262256"><list id="eip-id1168469835155" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mfrac><m:mn>7</m:mn><m:mn>3</m:mn></m:mfrac></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mo>−</m:mo><m:mn>12</m:mn></m:math></item>
<item><span class="token">ⓒ</span> <m:math><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>9</m:mn></m:mrow><m:mn>14</m:mn></m:mfrac></m:math></item>
<item><span class="token">ⓓ</span> <m:math><m:mfrac><m:mrow><m:mn>1</m:mn></m:mrow><m:mn>21</m:mn></m:mfrac></m:math></item></list></para></solution>
</exercise>
</note>
<para id="fs-id3013805">আগের একটি অধ্যায়ে আমরা বিপরীত সংখ্যা ও পরম মান নিয়ে কাজ করেছি। <link target-id="fs-id1394345" />-এ বিপরীত সংখ্যা, পরম মান ও গুণাত্মক বিপরীতের তুলনা দেখানো হয়েছে।</para>
<table id="fs-id1394345" aria-label="দুই সারি ও তিন স্তম্ভের ছকে বিপরীত সংখ্যা, পরম মান ও গুণাত্মক বিপরীতের তুলনা। অশূন্য সংখ্যার বিপরীত সংখ্যার চিহ্ন উল্টো হয়; শূন্যের বিপরীত সংখ্যা শূন্য। পরম মান কখনও ঋণাত্মক হয় না। অশূন্য সংখ্যার গুণাত্মক বিপরীতের চিহ্ন একই থাকে এবং ভগ্নাংশের লব ও হরের স্থান বদলায়; শূন্যের গুণাত্মক বিপরীত নেই।">
<label />
<tgroup cols="3">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<colspec colnum="3" colname="c3" />
<thead>
<row valign="top">
<entry align="left">বিপরীত সংখ্যা</entry>
<entry align="left">পরম মান</entry>
<entry align="left">গুণাত্মক বিপরীত</entry>
</row>
</thead>
<tbody>
<row valign="top">
<entry align="left" valign="top">অশূন্য সংখ্যার চিহ্ন উল্টো হয়; শূন্যের বিপরীত সংখ্যা শূন্য</entry>
<entry align="left" valign="top">কখনও ঋণাত্মক হয় না</entry>
<entry align="left" valign="top">অশূন্য সংখ্যার চিহ্ন একই থাকে; ভগ্নাংশের লব ও হরের স্থান বদলায়। শূন্যের গুণাত্মক বিপরীত নেই</entry>
</row>
</tbody>
</tgroup>
</table>
<example id="fs-id2649269">
<exercise id="fs-id1811476">
<problem id="fs-id1741941">
<para id="fs-id1627754">বাঁ দিকের স্তম্ভে দেওয়া প্রতিটি সংখ্যার জন্য ছকটি পূরণ করো:</para>
<table id="fs-id1179454" class="unnumbered" aria-label="পাঁচ সারি ও চার স্তম্ভের ছক। স্তম্ভের শিরোনাম: সংখ্যা, বিপরীত সংখ্যা, পরম মান এবং গুণাত্মক বিপরীত। প্রথম স্তম্ভে আছে ঋণাত্মক চিহ্নযুক্ত লব 3, হর 8-এর ভগ্নাংশ; লব 1, হর 2; লব 9, হর 5; এবং ঋণাত্মক 5। বাকি ঘরগুলি পূরণ করতে হবে।">
<label />
<tgroup cols="4">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<colspec colnum="3" colname="c3" />
<colspec colnum="4" colname="c4" />
<thead>
<row>
<entry align="left">সংখ্যা</entry>
<entry align="left">বিপরীত সংখ্যা</entry>
<entry align="left">পরম মান</entry>
<entry align="left">গুণাত্মক বিপরীত</entry>
</row>
</thead>
<tbody>
<row>
<entry align="left" valign="top"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></entry>
<entry align="left" />
<entry align="left" />
<entry align="left" />
</row>
<row>
<entry align="left" valign="top"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></entry>
<entry align="left" />
<entry align="left" />
<entry align="left" />
</row>
<row>
<entry align="left" valign="top"><m:math><m:mrow><m:mfrac><m:mn>9</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></entry>
<entry align="left" />
<entry align="left" />
<entry align="left" />
</row>
<row>
<entry align="left" valign="top"><m:math><m:mrow><m:mn>−5</m:mn></m:mrow></m:math></entry>
<entry align="left" />
<entry align="left" />
<entry align="left" />
</row>
</tbody>
</tgroup>
</table>
</problem>
<solution id="fs-id2431075">
<title>সমাধান</title>
<para id="fs-id1932057">বিপরীত সংখ্যা পেতে অশূন্য সংখ্যার চিহ্ন বদলাও; শূন্যের বিপরীত সংখ্যা শূন্য। পরম মান পেতে ধনাত্মক সংখ্যাকে একই রাখো, কিন্তু ঋণাত্মক সংখ্যার বিপরীত সংখ্যা নাও; শূন্যের পরম মান শূন্য। গুণাত্মক বিপরীত পেতে অশূন্য সংখ্যার চিহ্ন একই রাখো এবং ভগ্নাংশের <term class="no-emphasis" id="term-00008">লব ও হরের স্থান বদলাও</term>।</para>
<table id="fs-id1722688" class="unnumbered" aria-label="পূর্ণ করা ছকে স্তম্ভের ক্রম: সংখ্যা, বিপরীত সংখ্যা, পরম মান, গুণাত্মক বিপরীত। প্রথম সারি: ঋণাত্মক চিহ্নযুক্ত লব 3, হর 8; লব 3, হর 8; লব 3, হর 8; ঋণাত্মক চিহ্নযুক্ত লব 8, হর 3। দ্বিতীয় সারি: লব 1, হর 2; ঋণাত্মক চিহ্নযুক্ত লব 1, হর 2; লব 1, হর 2; 2। তৃতীয় সারি: লব 9, হর 5; ঋণাত্মক চিহ্নযুক্ত লব 9, হর 5; লব 9, হর 5; লব 5, হর 9। চতুর্থ সারি: ঋণাত্মক 5; 5; 5; ঋণাত্মক চিহ্নযুক্ত লব 1, হর 5।">
<label />
<tgroup cols="4">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<colspec colnum="3" colname="c3" />
<colspec colnum="4" colname="c4" />
<thead>
<row>
<entry align="left">সংখ্যা</entry>
<entry align="left">বিপরীত সংখ্যা</entry>
<entry align="left">পরম মান</entry>
<entry align="left">গুণাত্মক বিপরীত</entry>
</row>
</thead>
<tbody>
<row>
<entry align="left" valign="top"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></entry>
<entry align="left" valign="top"><m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></entry>
<entry align="left" valign="top"><m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></entry>
<entry align="left" valign="top"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>8</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></entry>
</row>
<row>
<entry align="left" valign="top"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></entry>
<entry align="left" valign="top"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></entry>
<entry align="left" valign="top"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></entry>
<entry align="left" valign="top"><m:math><m:mn>2</m:mn></m:math></entry>
</row>
<row>
<entry align="left" valign="top"><m:math><m:mrow><m:mfrac><m:mn>9</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></entry>
<entry align="left" valign="top"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>9</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></entry>
<entry align="left" valign="top"><m:math><m:mrow><m:mfrac><m:mn>9</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></entry>
<entry align="left" valign="top"><m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></entry>
</row>
<row>
<entry align="left" valign="top"><m:math><m:mrow><m:mn>−5</m:mn></m:mrow></m:math></entry>
<entry align="left" valign="top"><m:math><m:mn>5</m:mn></m:math></entry>
<entry align="left" valign="top"><m:math><m:mn>5</m:mn></m:math></entry>
<entry align="left" valign="top"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></entry>
</row>
</tbody>
</tgroup>
</table>
</solution>
</exercise>
</example>
<note id="fs-id2792517" class="try">
<exercise id="fs-id1608252">
<problem id="fs-id2202608">
<para id="fs-id1236377">দেওয়া প্রতিটি সংখ্যার জন্য ছকটি পূরণ করো:</para>
<table id="fs-id2657895" class="unnumbered" aria-label="পাঁচ সারি ও চার স্তম্ভের ছক। স্তম্ভের শিরোনাম: সংখ্যা, বিপরীত সংখ্যা, পরম মান এবং গুণাত্মক বিপরীত। প্রথম স্তম্ভে আছে ঋণাত্মক চিহ্নযুক্ত লব 5, হর 8-এর ভগ্নাংশ; লব 1, হর 4; লব 8, হর 3; এবং ঋণাত্মক 8। বাকি ঘরগুলি পূরণ করতে হবে।">
<label />
<tgroup cols="4">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<colspec colnum="3" colname="c3" />
<colspec colnum="4" colname="c4" />
<thead>
<row>
<entry align="center">সংখ্যা</entry>
<entry align="center">বিপরীত সংখ্যা</entry>
<entry align="center">পরম মান</entry>
<entry align="center">গুণাত্মক বিপরীত</entry>
</row>
</thead>
<tbody>
<row>
<entry align="center" valign="top"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></entry>
<entry align="center" />
<entry align="center" />
<entry align="center" />
</row>
<row>
<entry align="center" valign="top"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></entry>
<entry align="center" />
<entry align="center" />
<entry align="center" />
</row>
<row>
<entry align="center" valign="top"><m:math><m:mrow><m:mfrac><m:mn>8</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></entry>
<entry align="center" />
<entry align="center" />
<entry align="center" />
</row>
<row>
<entry align="center" valign="top"><m:math><m:mrow><m:mn>−8</m:mn></m:mrow></m:math></entry>
<entry align="center" />
<entry align="center" />
<entry align="center" />
</row>
</tbody>
</tgroup>
</table>
</problem>
<solution id="fs-id2198989">
<para id="fs-id1167906110243"><newline /><media id="fs-id1167906110247" alt="উত্তরের ছকে চারটি স্তম্ভ: সংখ্যা, বিপরীত সংখ্যা, পরম মান এবং গুণাত্মক বিপরীত। প্রথম সারি: ঋণাত্মক চিহ্নযুক্ত লব 5, হর 8-এর ভগ্নাংশ; বিপরীত সংখ্যা লব 5, হর 8; পরম মান লব 5, হর 8; গুণাত্মক বিপরীত ঋণাত্মক চিহ্নযুক্ত লব 8, হর 5। দ্বিতীয় সারি: লব 1, হর 4; বিপরীত সংখ্যা ঋণাত্মক চিহ্নযুক্ত লব 1, হর 4; পরম মান লব 1, হর 4; গুণাত্মক বিপরীত 4। তৃতীয় সারি: লব 8, হর 3; বিপরীত সংখ্যা ঋণাত্মক চিহ্নযুক্ত লব 8, হর 3; পরম মান লব 8, হর 3; গুণাত্মক বিপরীত লব 3, হর 8। চতুর্থ সারি: ঋণাত্মক 8; বিপরীত সংখ্যা 8; পরম মান 8; গুণাত্মক বিপরীত ঋণাত্মক চিহ্নযুক্ত লব 1, হর 8।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_02_037_img.jpg" />
</media></para>
</solution>
</exercise>
</note>
<note id="eip-id1165685648332" class="try">
<exercise id="eip-id1165685648336">
<problem id="eip-id1165685648339">
<para id="eip-id1165685648364">দেওয়া প্রতিটি সংখ্যার জন্য ছকটি পূরণ করো:</para>
<table id="eip-id1165685648367" class="unnumbered">
<label />
<tgroup cols="4">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<colspec colnum="3" colname="c3" />
<colspec colnum="4" colname="c4" />
<thead>
<row>
<entry align="center">সংখ্যা</entry>
<entry align="center">বিপরীত সংখ্যা</entry>
<entry align="center">পরম মান</entry>
<entry align="center">গুণাত্মক বিপরীত</entry>
</row>
</thead>
<tbody>
<row>
<entry align="center" valign="top"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>4</m:mn><m:mn>7</m:mn></m:mfrac></m:mrow></m:math></entry>
<entry align="center" />
<entry align="center" />
<entry align="center" />
</row>
<row>
<entry align="center" valign="top"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></entry>
<entry align="center" />
<entry align="center" />
<entry align="center" />
</row>
<row>
<entry align="center" valign="top"><m:math><m:mrow><m:mfrac><m:mn>9</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></entry>
<entry align="center" />
<entry align="center" />
<entry align="center" />
</row>
<row>
<entry align="center" valign="top"><m:math><m:mrow><m:mn>−1</m:mn></m:mrow></m:math></entry>
<entry align="center" />
<entry align="center" />
<entry align="center" />
</row>
</tbody>
</tgroup>
</table></problem>
<solution id="fs-idm236193504">
<para id="fs-idm236193248"><newline /><media id="fs-idm236192864" alt="উত্তরের ছকে চারটি স্তম্ভ: সংখ্যা, বিপরীত সংখ্যা, পরম মান এবং গুণাত্মক বিপরীত। প্রথম সারি: ঋণাত্মক চিহ্নযুক্ত লব 4, হর 7-এর ভগ্নাংশ; বিপরীত সংখ্যা লব 4, হর 7; পরম মান লব 4, হর 7; গুণাত্মক বিপরীত ঋণাত্মক চিহ্নযুক্ত লব 7, হর 4। দ্বিতীয় সারি: লব 1, হর 8; বিপরীত সংখ্যা ঋণাত্মক চিহ্নযুক্ত লব 1, হর 8; পরম মান লব 1, হর 8; গুণাত্মক বিপরীত 8। তৃতীয় সারি: লব 9, হর 4; বিপরীত সংখ্যা ঋণাত্মক চিহ্নযুক্ত লব 9, হর 4; পরম মান লব 9, হর 4; গুণাত্মক বিপরীত লব 4, হর 9। চতুর্থ সারি: ঋণাত্মক 1; বিপরীত সংখ্যা 1; পরম মান 1; গুণাত্মক বিপরীত ঋণাত্মক 1।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_02_040_img.jpg" />
</media></para>
</solution>
</exercise></note></section><section id="fs-id2700526">
<title>ভগ্নাংশের ভাগ</title><para id="fs-id1574742">কেন <m:math><m:mrow><m:mn>12</m:mn><m:mo>÷</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow><m:mo>?</m:mo></m:math> গোনার গুটি দিয়ে আগে এর মডেল তৈরি করেছি। প্রতিটি দলে <m:math><m:mn>3</m:mn></m:math>টি করে গুটি রাখলে <m:math><m:mrow><m:mn>12</m:mn></m:mrow></m:math>টি গুটি দিয়ে মোট কতটি দল তৈরি করা যায়?</para>
<media id="fs-id1621685" alt="চারটি ডিম্বাকৃতি বেষ্টনী; প্রতিটির ভিতরে 3টি করে গোল গুটি, মোট 12টি গুটি।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_02_015_img.jpg" />
</media>
<para id="fs-id1828558">এখানে <m:math><m:mn>4</m:mn></m:math>টি দল আছে; প্রতিটি দলে <m:math><m:mn>3</m:mn></m:math>টি গুটি। অন্যভাবে বললে, <m:math><m:mrow><m:mn>3</m:mn></m:mrow></m:math>-কে চারবার নিলে হয় <m:math><m:mrow><m:mn>12</m:mn><m:mo>.</m:mo></m:mrow></m:math> তাই, <m:math><m:mrow><m:mn>12</m:mn><m:mo>÷</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>4</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id2340005">ভগ্নাংশ ভাগ করলে কী হবে? ধরা যাক, এই ভাগফলটি নির্ণয় করতে চাই: <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math> জানতে হবে, <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math> মাপের কতগুলি অংশ মিলে তৈরি হয় <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math> এটি অর্ধেক মাপের অংশ। ভগ্নাংশের পাত দিয়ে এই ভাগের মডেল বানাতে পারি। প্রথমে অর্ধেক ও এক-ষষ্ঠাংশ মাপের পাতগুলি পাশাপাশি মেলাই; দেখো <link target-id="CNX_BMath_Figure_04_02_016" />। দেখা যাচ্ছে, <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math> মাপের তিনটি পাতের মোট পরিমাণ <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>,</m:mo></m:mrow></m:math> অর্থাৎ অর্ধেক পাতের মাপ। তাই <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>=</m:mo><m:mn>3</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<figure id="CNX_BMath_Figure_04_02_016">
<media id="fs-id1458356" alt="উপরে একটি আয়তাকার পাত; তার চিহ্নিত ভগ্নাংশে লব 1, হর 2। নীচে একই দৈর্ঘ্যের আয়তাকার পাত সমান 3 ভাগে বিভক্ত; প্রতিটি ভাগের চিহ্নিত ভগ্নাংশে লব 1, হর 6।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_02_016-179c.jpg" />
</media>
</figure>
<note id="eip-993" class="manipulative-math">হাতে-কলমে গণিতের ‘ভগ্নাংশ ভাগের মডেল’ কাজটি করলে ভগ্নাংশের ভাগ আরও ভালোভাবে বুঝতে পারবে।</note><example id="fs-id1340751">
<exercise id="fs-id1508964">
<problem id="fs-id1899946">
<para id="fs-id1969048">মডেল তৈরি করো: <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2908766">
<title>সমাধান</title>
<para id="fs-id1885595">লক্ষ্য হল খুঁজে দেখা, কতগুলি <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math> মাপের পাত মিলে তৈরি হয় <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math> প্রথমে <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math> মাপের একটি পাত নাও। তার নীচে <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math> মাপের পাতগুলি এমনভাবে পাশাপাশি সাজাও, যেন উপরের <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math> মাপের পাতটির সমান দৈর্ঘ্য হয়।</para>
<media id="fs-id1362946" alt="উপরে একটি আয়তাকার পাত; তার চিহ্নিত ভগ্নাংশে লব 1, হর 4। নীচে একই দৈর্ঘ্যের আয়তাকার পাত সমান 2 ভাগে বিভক্ত; প্রতিটি ভাগের চিহ্নিত ভগ্নাংশে লব 1, হর 8।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_02_017_img.jpg" />
</media>
<para id="fs-id3017276">এক-চতুর্থাংশ মাপের পাতটি তৈরি করতে দুটি <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math> মাপের পাত লাগে। অর্থাৎ, দুটি পাত মিলে হয় <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id4163583">তাই, <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>=</m:mo><m:mn>2</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</solution>
</exercise>
</example>
<note id="fs-id1730116" class="try">
<exercise id="fs-id4315988">
<problem id="fs-id4219967">
<para id="fs-id1567253">মডেল তৈরি করো: <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2138110">
<para id="fs-idm206575408">2</para>
<para id="fs-id1171103030165"><newline /><media id="fs-id1325545" alt="উপরে একটি আয়তাকার পাত; তার চিহ্নিত ভগ্নাংশে লব 1, হর 3। নীচে একই দৈর্ঘ্যের আয়তাকার পাত সমান 2 ভাগে বিভক্ত; প্রতিটি ভাগের চিহ্নিত ভগ্নাংশে লব 1, হর 6।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_02_018_img.jpg" />
</media></para>
</solution>
</exercise>
</note>
<note id="fs-id1919209" class="try">
<exercise id="fs-id1208820">
<problem id="fs-id2325427">
<para id="fs-id2298816">মডেল তৈরি করো: <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2220935">
<para id="fs-idm241127312">2</para>
<para id="fs-id1171103110560"><newline /><media id="fs-id2387806" alt="উপরে একটি আয়তাকার পাত; তার চিহ্নিত ভগ্নাংশে লব 1, হর 2। নীচে একই দৈর্ঘ্যের আয়তাকার পাত সমান 2 ভাগে বিভক্ত; প্রতিটি ভাগের চিহ্নিত ভগ্নাংশে লব 1, হর 4।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_02_019_img.jpg" />
</media></para>
</solution>
</exercise>
</note>
<example id="fs-id2269244">
<exercise id="fs-id2908464">
<problem id="fs-id1282534">
<para id="fs-id2262665">মডেল তৈরি করো: <m:math><m:mrow><m:mn>2</m:mn><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id3340394">
<title>সমাধান</title>
<para id="fs-id1398050">জানতে চাই, <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math> মাপের কতগুলি অংশ মিলে তৈরি হয় <m:math><m:mn>2</m:mn><m:mo>.</m:mo></m:math> নীচের মডেলে তা দেখানো হয়েছে।</para>
<media id="fs-id1398224" alt="উপরে দুটি একই দৈর্ঘ্যের আয়তাকার পাত; প্রতিটির উপরে লেখা 1। নীচে একই দৈর্ঘ্যের দুটি পাত, প্রতিটি সমান 4 ভাগে বিভক্ত; মোট 8টি ভাগের প্রত্যেকটির চিহ্নিত ভগ্নাংশে লব 1, হর 4।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_02_020_img.jpg" />
</media>
<para id="fs-id1738644">আটটি <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math> মাপের অংশ মিলে দুটি গোটা হয়। গোটা সংখ্যা ও ভাগের সমীকরণটি হল <m:math><m:mn>2</m:mn><m:mo>,</m:mo><m:mrow><m:mn>2</m:mn><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>=</m:mo><m:mn>8</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</solution>
</exercise>
</example>
<note id="fs-id3274121" class="try">
<exercise id="fs-id1370723">
<problem id="fs-id1714263">
<para id="fs-id1721210">মডেল তৈরি করো: <m:math><m:mrow><m:mn>2</m:mn><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1168874">
<para id="fs-idm241335632">6</para>
<para id="fs-id1171103265357"><newline /><media id="fs-id1608240" alt="উপরে একই দৈর্ঘ্যের দুটি আয়তাকার পাত; প্রতিটির উপরে লেখা 1। নীচে একই দৈর্ঘ্যের দুটি পাত, প্রতিটি সমান 3 ভাগে বিভক্ত; মোট 6টি ভাগের প্রত্যেকটির চিহ্নিত ভগ্নাংশে লব 1, হর 3।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_02_021_img.jpg" />
</media></para>
</solution>
</exercise>
</note>
<note id="fs-id2241393" class="try">
<exercise id="fs-id1393940">
<problem id="fs-id2212061">
<para id="fs-id1389506">মডেল তৈরি করো: <m:math><m:mrow><m:mn>3</m:mn><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1609314">
<para id="fs-idm235819968">6</para>
<para id="fs-id1171102819720"><newline /><media id="fs-id3202520" alt="উপরে একই দৈর্ঘ্যের 3টি আয়তাকার পাত; প্রতিটির উপরে লেখা 1। নীচে একই দৈর্ঘ্যের 3টি পাত, প্রতিটি সমান 2 ভাগে বিভক্ত; মোট 6টি ভাগের প্রত্যেকটির চিহ্নিত ভগ্নাংশে লব 1, হর 2।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_02_022_img.jpg" />
</media></para>
</solution>
</exercise>
</note>
<para id="fs-id1785530">আর-একভাবে <m:math><m:mrow><m:mn>2</m:mn><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math>-এর মডেল তৈরি করতে এবার মার্কিন মুদ্রা ব্যবহার করি। ইংরেজিতে <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math>-কে প্রায়ই ‘কোয়ার্টার’ বলা হয়; <link target-id="CNX_BMath_Figure_04_02_023" />-এ দেখানো কোয়ার্টার মুদ্রাটির মূল্য এক ডলারের এক-চতুর্থাংশ। তাই <m:math><m:mrow><m:mn>2</m:mn><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math> প্রশ্নটির অর্থ দাঁড়ায়, ‘দুই ডলারে কতগুলি কোয়ার্টার আছে?’ এক ডলারে <m:math><m:mn>4</m:mn></m:math>টি কোয়ার্টার থাকে; তাই <m:math><m:mn>2</m:mn></m:math> ডলারে থাকে <m:math><m:mn>8</m:mn></m:math>টি কোয়ার্টার। আবারও পেলাম, <m:math><m:mrow><m:mn>2</m:mn><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>=</m:mo><m:mn>8</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<figure id="CNX_BMath_Figure_04_02_023">
<media id="fs-id1543978" alt="মার্কিন যুক্তরাষ্ট্রের একটি কোয়ার্টার মুদ্রার ছবি।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_02_023.jpg" />
</media>
<caption>‘কোয়ার্টার’ নামে পরিচিত এই মার্কিন মুদ্রাটির মূল্য এক ডলারের এক-চতুর্থাংশ।</caption>
</figure>
<para id="fs-id1733017">ভগ্নাংশের পাত দিয়ে দেখিয়েছি, <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>=</m:mo><m:mn>3</m:mn><m:mo>.</m:mo></m:mrow></m:math> লক্ষ করো, <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>6</m:mn><m:mn>1</m:mn></m:mfrac><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math>-ও সত্য। <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math> ও <m:math><m:mrow><m:mfrac><m:mn>6</m:mn><m:mn>1</m:mn></m:mfrac></m:mrow></m:math>-এর মধ্যে সম্পর্ক কী? এগুলি পরস্পরের গুণাত্মক বিপরীত—লব ও হরের স্থান বদলালে একটি থেকে অপরটি পাওয়া যায়। এ থেকেই ভগ্নাংশ ভাগের নিয়মটি পাই।</para>
<note id="fs-id1185222">
<title>ভগ্নাংশ ভাগের নিয়ম</title>
<para id="fs-id1792338">ধরা যাক, <m:math><m:mrow><m:mi>a</m:mi><m:mo>,</m:mo><m:mi>b</m:mi><m:mo>,</m:mo><m:mi>c</m:mi><m:mo>,</m:mo></m:mrow></m:math> ও <m:math><m:mrow><m:mi>d</m:mi></m:mrow></m:math> এমন সংখ্যা, যেখানে <m:math><m:mrow><m:mi>b</m:mi><m:mo>≠</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mi>c</m:mi><m:mo>≠</m:mo><m:mn>0</m:mn><m:mo>,</m:mo></m:mrow></m:math> এবং <m:math><m:mrow><m:mi>d</m:mi><m:mo>≠</m:mo><m:mn>0</m:mn><m:mo>,</m:mo></m:mrow></m:math> তবে</para>
<equation id="fs-id1171100707994" class="unnumbered"><label /><m:math><m:mrow><m:mfrac><m:mi>a</m:mi><m:mi>b</m:mi></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mi>c</m:mi><m:mi>d</m:mi></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mi>a</m:mi><m:mi>b</m:mi></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mi>d</m:mi><m:mi>c</m:mi></m:mfrac></m:mrow></m:math></equation>
<para id="fs-id2691204">ভগ্নাংশ ভাগ করতে প্রথম ভগ্নাংশটিকে দ্বিতীয় অশূন্য ভগ্নাংশের গুণাত্মক বিপরীত দিয়ে গুণ করো।</para>
</note>
<para id="fs-id2325600">আমাদের <m:math><m:mrow><m:mi>b</m:mi><m:mo>≠</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mi>c</m:mi><m:mo>≠</m:mo><m:mn>0</m:mn></m:mrow></m:math> ও <m:math><m:mrow><m:mi>d</m:mi><m:mo>≠</m:mo><m:mn>0</m:mn></m:mrow></m:math> শর্তগুলি লিখতে হবে, যাতে কখনও শূন্য দিয়ে ভাগ না হয়।</para>
<example id="fs-id2352971"><exercise id="fs-id1382195">
<problem id="fs-id2603246">
<para id="fs-id2275768">ভাগ করো এবং উত্তরটি লঘিষ্ঠ আকারে লেখো: <m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>÷</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>7</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2263586">
<title>সমাধান</title>

<table id="eip-id1168468274991" class="unnumbered unstyled" summary="ভগ্নাংশ ভাগকে দ্বিতীয় ভগ্নাংশের গুণাত্মক বিপরীত দিয়ে গুণে বদলে লঘিষ্ঠ আকারে উত্তর পাওয়ার ধাপগুলি দেখানো হয়েছে।"><label />
<tgroup cols="2"><tbody>
<row>
  <entry />
  <entry><m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>÷</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>7</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></entry></row>
<row>
  <entry>প্রথম ভগ্নাংশটিকে দ্বিতীয় ভগ্নাংশের গুণাত্মক বিপরীত দিয়ে গুণ করো।</entry>
  <entry><m:math><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>(</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>7</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>)</m:mo></m:math></entry></row>
<row>
  <entry>গুণ করো। গুণফল ঋণাত্মক।</entry>
  <entry><m:math><m:mo>−</m:mo><m:mfrac><m:mn>14</m:mn><m:mn>15</m:mn></m:mfrac></m:math></entry></row>
</tbody>



</tgroup>
</table></solution>
</exercise>
</example><note id="fs-id4120559" class="try">
<exercise id="fs-id2495384">
<problem id="fs-id2220252">
<para id="fs-id2961572">ভাগ করো এবং উত্তরটি লঘিষ্ঠ আকারে লেখো: <m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>7</m:mn></m:mfrac><m:mo>÷</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2267354">
<para id="fs-id1262427"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>14</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1160023" class="try">
<exercise id="fs-id1727728">
<problem id="fs-id1548119">
<para id="fs-id1629369">ভাগ করো এবং উত্তরটি লঘিষ্ঠ আকারে লেখো: <m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>÷</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>7</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2204854">
<para id="fs-id1579752"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>10</m:mn></m:mrow><m:mrow><m:mn>21</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<example id="fs-id1822162"><exercise id="fs-id1347749">
<problem id="fs-id1159900">
<para id="fs-id2629698">চলটির মান শূন্য নয় ধরে ভাগ করো এবং উত্তরটি লঘিষ্ঠ আকারে লেখো: <m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mi>n</m:mi><m:mn>5</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id3340612">
<title>সমাধান</title>

<table id="eip-id1168466192195" class="unnumbered unstyled" summary="চলযুক্ত দুটি ভগ্নাংশ ভাগ করতে দ্বিতীয় ভগ্নাংশের গুণাত্মক বিপরীত দিয়ে গুণ করার ধাপগুলি দেখানো হয়েছে।"><label />
<tgroup cols="2"><tbody>
<row>
  <entry />
  <entry><m:math><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mi>n</m:mi><m:mn>5</m:mn></m:mfrac></m:math></entry></row>
<row>
  <entry>প্রথম ভগ্নাংশটিকে দ্বিতীয় ভগ্নাংশের গুণাত্মক বিপরীত দিয়ে গুণ করো।</entry>
  <entry><m:math><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>5</m:mn><m:mi>n</m:mi></m:mfrac></m:math></entry></row>
<row>
  <entry>গুণ করো।</entry>
  <entry><m:math><m:mfrac><m:mrow><m:mn>10</m:mn></m:mrow><m:mrow><m:mn>3</m:mn><m:mi>n</m:mi></m:mrow></m:mfrac></m:math></entry></row>
</tbody>


</tgroup>
</table>
</solution>
</exercise></example><note id="fs-id1808732" class="try">
<exercise id="fs-id752392">
<problem id="fs-id2662153">
<para id="fs-id1744840">চলটির মান শূন্য নয় ধরে ভাগ করো এবং উত্তরটি লঘিষ্ঠ আকারে লেখো: <m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mi>p</m:mi><m:mn>7</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2267236">
<para id="fs-id1461555"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>21</m:mn></m:mrow><m:mrow><m:mn>5</m:mn><m:mi>p</m:mi></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1529415" class="try">
<exercise id="fs-id2645446">
<problem id="fs-id1265120">
<para id="fs-id1516055">চলটির মান শূন্য নয় ধরে ভাগ করো এবং উত্তরটি লঘিষ্ঠ আকারে লেখো: <m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mi>q</m:mi><m:mn>3</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2434605">
<para id="fs-id1386794"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>15</m:mn></m:mrow><m:mrow><m:mn>8</m:mn><m:mi>q</m:mi></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<example id="fs-id1549882"><exercise id="fs-id2370170">
<problem id="fs-id1546203">
<para id="fs-id2369156">ভাগ করো এবং উত্তরটি লঘিষ্ঠ আকারে লেখো: <m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>÷</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id3199626">
<title>সমাধান</title>
<table id="eip-id1168467263034" class="unnumbered unstyled" summary="দুটি ঋণাত্মক ভগ্নাংশ ভাগ, গুণফলের চিহ্ন নির্ণয়, সাধারণ গুণনীয়ক বাদ দেওয়া ও লঘিষ্ঠ আকারে লেখার ধাপগুলি দেখানো হয়েছে।"><label />
<tgroup cols="2"><tbody>
<row>
  <entry />
  <entry align="center"><m:math><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>÷</m:mo><m:mo>(</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>)</m:mo></m:math></entry></row>
<row>
  <entry>প্রথম ভগ্নাংশটিকে দ্বিতীয় ভগ্নাংশের গুণাত্মক বিপরীত দিয়ে গুণ করো।</entry>
  <entry align="center"><m:math><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>·</m:mo><m:mo>(</m:mo><m:mo>−</m:mo><m:mfrac><m:mn>8</m:mn><m:mn>7</m:mn></m:mfrac><m:mo>)</m:mo></m:math></entry></row>
<row>
  <entry>গুণ করো। আগে গুণফলের চিহ্ন নির্ণয় করতে মনে রেখো।</entry>
  <entry align="center"><m:math><m:mfrac><m:mrow><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>8</m:mn></m:mrow><m:mrow><m:mn>4</m:mn><m:mo>·</m:mo><m:mn>7</m:mn></m:mrow></m:mfrac></m:math></entry></row>
<row>
  <entry>সাধারণ গুণনীয়কগুলি দেখানোর জন্য নতুন করে লেখো।</entry>
  <entry align="center"><m:math><m:mfrac><m:mrow><m:mn>3</m:mn><m:mo>·</m:mo><m:menclose notation="updiagonalstrike"><m:mn>4</m:mn></m:menclose><m:mo>·</m:mo><m:mn>2</m:mn></m:mrow><m:mrow><m:menclose notation="updiagonalstrike"><m:mn>4</m:mn></m:menclose><m:mo>·</m:mo><m:mn>7</m:mn></m:mrow></m:mfrac></m:math></entry></row>
<row>
  <entry>সাধারণ গুণনীয়ক বাদ দিয়ে লঘিষ্ঠ আকারে লেখো।</entry>
  <entry align="center"><m:math><m:mfrac><m:mn>6</m:mn><m:mn>7</m:mn></m:mfrac></m:math></entry></row>
</tbody>





</tgroup>
</table></solution>
</exercise></example><note id="fs-id1862865" class="try">
<exercise id="fs-id1250656">
<problem id="fs-id1605117">
<para id="fs-id2649324">ভাগ করো এবং উত্তরটি লঘিষ্ঠ আকারে লেখো: <m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>÷</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1613316">
<para id="fs-id1631317"><m:math><m:mrow><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1731339" class="try">
<exercise id="fs-id2279421">
<problem id="fs-id1949411">
<para id="fs-id1470461">ভাগ করো এবং উত্তরটি লঘিষ্ঠ আকারে লেখো: <m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>÷</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1531820">
<para id="fs-id1731663"><m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<example id="fs-id2961464"><exercise id="fs-id2135873">
<problem id="fs-id1781622">
<para id="fs-id1611165">ভাগ করো এবং উত্তরটি লঘিষ্ঠ আকারে লেখো: <m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>18</m:mn></m:mrow></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mrow><m:mn>14</m:mn></m:mrow><m:mrow><m:mn>27</m:mn></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2305386">
<title>সমাধান</title>

<table id="eip-id1168466022407" class="unnumbered unstyled" summary="দুটি ভগ্নাংশ ভাগকে গুণে বদলে সাধারণ গুণনীয়ক বাদ দিয়ে লঘিষ্ঠ আকারে উত্তর পাওয়ার ধাপগুলি দেখানো হয়েছে।"><label />
<tgroup cols="2"><tbody>
<row>
  <entry />
  <entry><m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>18</m:mn></m:mrow></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mrow><m:mn>14</m:mn></m:mrow><m:mrow><m:mn>27</m:mn></m:mrow></m:mfrac></m:mrow></m:math></entry></row>
<row>
  <entry>প্রথম ভগ্নাংশটিকে দ্বিতীয় ভগ্নাংশের গুণাত্মক বিপরীত দিয়ে গুণ করো।</entry>
  <entry><m:math><m:mfrac><m:mn>7</m:mn><m:mn>18</m:mn></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>27</m:mn><m:mn>14</m:mn></m:mfrac></m:math></entry></row>
<row>
  <entry>গুণ করো।</entry>
  <entry><m:math><m:mfrac><m:mrow><m:mn>7</m:mn><m:mo>·</m:mo><m:mn>27</m:mn></m:mrow><m:mrow><m:mn>18</m:mn><m:mo>·</m:mo><m:mn>14</m:mn></m:mrow></m:mfrac></m:math></entry></row>
<row>
  <entry>সাধারণ গুণনীয়কগুলি দেখানোর জন্য নতুন করে লেখো।</entry>
  <entry><media id="eip-id1168468328104" alt="একটি ভগ্নাংশে লবে 7 গুণ 9 গুণ 3 এবং হরে 9 গুণ 2 গুণ 7 গুণ 2। লব ও হরের সাধারণ গুণনীয়ক 7 ও 9 কেটে বাদ দেওয়া দেখানো হয়েছে।"><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_02_034_img-01.png" /></media></entry></row>
<row>
  <entry>সাধারণ গুণনীয়ক বাদ দাও।</entry>
  <entry><m:math><m:mfrac><m:mn>3</m:mn><m:mrow><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>2</m:mn></m:mrow></m:mfrac></m:math></entry></row>
<row>
  <entry>লঘিষ্ঠ আকারে লেখো।</entry>
  <entry><m:math><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:math></entry></row>
</tbody>





</tgroup>
</table></solution>
</exercise></example><note id="fs-id2603320" class="try">
<exercise id="fs-id1607514">
<problem id="fs-id1395156">
<para id="fs-id1222060">ভাগ করো এবং উত্তরটি লঘিষ্ঠ আকারে লেখো: <m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>27</m:mn></m:mrow></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mrow><m:mn>35</m:mn></m:mrow><m:mrow><m:mn>36</m:mn></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1782725">
<para id="fs-id2206531"><m:math><m:mrow><m:mfrac><m:mn>4</m:mn><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1824545" class="try">
<exercise id="fs-id1392635">
<problem id="fs-id2451798">
<para id="fs-id2224488">ভাগ করো এবং উত্তরটি লঘিষ্ঠ আকারে লেখো: <m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>14</m:mn></m:mrow></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mrow><m:mn>15</m:mn></m:mrow><m:mrow><m:mn>28</m:mn></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1957189">
<para id="fs-id1547189"><m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1784433" class="media-2"><title>আরও অনলাইন উপকরণ দেখো</title><list id="fs-id2707739" display="block">
<item><link url="https://www.openstax.org/l/24SimplifyFrac">ভগ্নাংশ লঘিষ্ঠ আকারে লেখা</link></item>
<item><link url="https://www.openstax.org/l/24MultiplyFrac">ভগ্নাংশের গুণ: শুধু ধনাত্মক ভগ্নাংশ</link></item>
<item><link url="https://www.openstax.org/l/24MultSigned">চিহ্নযুক্ত ভগ্নাংশের গুণ</link></item>
<item><link url="https://www.openstax.org/l/24DivideFrac">ভগ্নাংশের ভাগ: শুধু ধনাত্মক ভগ্নাংশ</link></item>
<item><link url="https://www.openstax.org/l/24DivideSign">চিহ্নযুক্ত ভগ্নাংশের ভাগ</link></item>
</list></note></section>
<section id="fs-id1790063" class="key-concepts">
<title>মূল ধারণা</title>
<list id="eip-167"><item><emphasis>সমতুল ভগ্নাংশের ধর্ম</emphasis><list id="eip-id1170323004261"><item>যদি <m:math><m:mi>a</m:mi><m:mo>,</m:mo><m:mi> b</m:mi><m:mo>,</m:mo><m:mi> c</m:mi></m:math> এমন সংখ্যা হয়, যেখানে <m:math><m:mi>b</m:mi><m:mo>≠</m:mo><m:mn>0</m:mn></m:math> এবং <m:math><m:mi>c</m:mi><m:mo>≠</m:mo><m:mn>0</m:mn></m:math> তবে <m:math><m:mfrac><m:mrow><m:mi>a</m:mi></m:mrow><m:mrow><m:mi>b</m:mi></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mi>a</m:mi><m:mo>⋅</m:mo><m:mi>c</m:mi></m:mrow><m:mrow><m:mi>b</m:mi><m:mo>⋅</m:mo><m:mi>c</m:mi></m:mrow></m:mfrac></m:math> এবং <m:math><m:mfrac><m:mrow><m:mi>a</m:mi><m:mo>⋅</m:mo><m:mi>c</m:mi></m:mrow><m:mrow><m:mi>b</m:mi><m:mo>⋅</m:mo><m:mi>c</m:mi></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mi>a</m:mi></m:mrow><m:mrow><m:mi>b</m:mi></m:mrow></m:mfrac></m:math>।</item></list></item>
<item><emphasis>ভগ্নাংশকে লঘিষ্ঠ আকারে প্রকাশ করো।</emphasis><list id="eip-id1170323004302" list-type="enumerated" number-style="arabic" class="stepwise"><item>সাধারণ গুণনীয়কগুলি দেখিয়ে লব ও হর আবার লেখো। দরকার হলে লব ও হরকে মৌলিক গুণনীয়কে বিশ্লেষণ করো।</item>
<item>সমতুল ভগ্নাংশের ধর্ম ব্যবহার করে সাধারণ গুণনীয়ক দিয়ে লব ও হর ভাগ করো।</item>
<item>লবে ও হরে বাকি থাকা গুণনীয়কগুলি গুণ করো।</item></list></item>
<item><emphasis>ভগ্নাংশের গুণ</emphasis><list id="eip-id1170323004360"><item>যদি <m:math><m:mi>a</m:mi><m:mo>,</m:mo><m:mi> b</m:mi><m:mo>,</m:mo><m:mi> c</m:mi><m:mo>,</m:mo></m:math> এবং <m:math><m:mi>d</m:mi></m:math> এমন সংখ্যা হয়, যেখানে <m:math><m:mi>b</m:mi><m:mo>≠</m:mo><m:mn>0</m:mn></m:math> এবং <m:math><m:mi>d</m:mi><m:mo>≠</m:mo><m:mn>0</m:mn></m:math> তবে <m:math><m:mfrac><m:mrow><m:mi>a</m:mi></m:mrow><m:mrow><m:mi>b</m:mi></m:mrow></m:mfrac><m:mo>⋅</m:mo><m:mfrac><m:mrow><m:mi>c</m:mi></m:mrow><m:mrow><m:mi>d</m:mi></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mi>a</m:mi><m:mi>c</m:mi></m:mrow><m:mrow><m:mi>b</m:mi><m:mi>d</m:mi></m:mrow></m:mfrac></m:math>।</item></list></item>
<item><emphasis>গুণাত্মক বিপরীত</emphasis><list id="eip-id1170322987712"><item>একটি অশূন্য ভগ্নাংশের লব ও হরের স্থান বদলালে তার গুণাত্মক বিপরীত পাওয়া যায়। একটি অশূন্য সংখ্যা ও তার গুণাত্মক বিপরীতের গুণফল <m:math><m:mn>1</m:mn></m:math>। নীচের সমতায় লব ও হর দুটিই অশূন্য: <m:math><m:mfrac><m:mrow><m:mi>a</m:mi></m:mrow><m:mrow><m:mi>b</m:mi></m:mrow></m:mfrac><m:mo>⋅</m:mo><m:mfrac><m:mrow><m:mi>b</m:mi></m:mrow><m:mrow><m:mi>a</m:mi></m:mrow></m:mfrac><m:mo>=</m:mo><m:mn>1</m:mn></m:math></item>
<item><table id="eip-id1170326426110" aria-label="বিপরীত সংখ্যা, পরম মান ও গুণাত্মক বিপরীতের পার্থক্য"><title /><tgroup cols="3"><tbody>
<row>
<entry><emphasis>বিপরীত সংখ্যা</emphasis></entry>
<entry><emphasis>পরম মান</emphasis></entry>
<entry><emphasis>গুণাত্মক বিপরীত</emphasis></entry>
</row>

<row>
<entry>অশূন্য সংখ্যার চিহ্ন উল্টো হয়; শূন্যের বিপরীত সংখ্যা শূন্য</entry>
<entry>কখনও ঋণাত্মক হয় না</entry>
<entry>অশূন্য সংখ্যার চিহ্ন একই থাকে; ভগ্নাংশের লব ও হরের স্থান বদলায়</entry></row></tbody></tgroup></table></item></list></item>
<item><emphasis>ভগ্নাংশের ভাগ</emphasis><list id="eip-id1170323913006"><item>যদি <m:math><m:mi>a</m:mi><m:mo>, </m:mo><m:mi>b</m:mi><m:mo>, </m:mo><m:mi>c</m:mi><m:mo>,</m:mo></m:math> এবং <m:math><m:mi>d</m:mi></m:math> এমন সংখ্যা হয়, যেখানে <m:math><m:mi>b</m:mi><m:mo>≠</m:mo><m:mn>0</m:mn></m:math>, <m:math><m:mi>c</m:mi><m:mo>≠</m:mo><m:mn>0</m:mn></m:math> এবং <m:math><m:mi>d</m:mi><m:mo>≠</m:mo><m:mn>0</m:mn></m:math> তবে<newline /><equation id="eip-id1170322979647"><m:math><m:mfrac><m:mrow><m:mi>a</m:mi></m:mrow><m:mrow><m:mi>b</m:mi></m:mrow></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mrow><m:mi>c</m:mi></m:mrow><m:mrow><m:mi>d</m:mi></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mi>a</m:mi></m:mrow><m:mrow><m:mi>b</m:mi></m:mrow></m:mfrac><m:mo>⋅</m:mo><m:mfrac><m:mrow><m:mi>d</m:mi></m:mrow><m:mrow><m:mi>c</m:mi></m:mrow></m:mfrac></m:math></equation></item>
<item>ভগ্নাংশ ভাগ করতে প্রথম ভগ্নাংশটিকে দ্বিতীয় ভগ্নাংশটির গুণাত্মক বিপরীত দিয়ে গুণ করো।</item></list></item></list></section>
<section id="fs-id3215450" class="section-exercises"><section id="fs-id1808116" class="practice-perfect"><title>অনুশীলনে দক্ষতা</title><para id="fs-id2375474"><emphasis effect="bold">ভগ্নাংশকে লঘিষ্ঠ আকারে প্রকাশ করা</emphasis> </para><para id="eip-507">নীচের অনুশীলনগুলিতে প্রতিটি ভগ্নাংশকে লঘিষ্ঠ আকারে লেখো। কোনো অপ্রকৃত ভগ্নাংশকে মিশ্র ভগ্নাংশে পরিণত কোরো না। চলযুক্ত রাশির ক্ষেত্রে হরের মান শূন্য নয় বলে ধরো।</para><exercise id="fs-id1568581">
<problem id="fs-id1347888">
<para id="fs-id1604351"><m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>21</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1346528">
<para id="fs-id2246481"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2775170">
<problem id="fs-id1790731">
<para id="fs-id1284728"><m:math><m:mrow><m:mfrac><m:mn>8</m:mn><m:mrow><m:mn>24</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2481556">
<problem id="fs-id2264545">
<para id="fs-id1347502"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>15</m:mn></m:mrow><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1346791">
<para id="fs-id1379732"><m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2261411">
<problem id="fs-id1374022">
<para id="fs-id3211279"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>12</m:mn></m:mrow><m:mrow><m:mn>18</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1312453">
<problem id="fs-id2785410">
<para id="fs-id2314438"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>40</m:mn></m:mrow><m:mrow><m:mn>88</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2420182">
<para id="fs-id1336899"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>11</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1547777">
<problem id="fs-id2369338">
<para id="fs-id1033577"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>63</m:mn></m:mrow><m:mrow><m:mn>99</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1032604">
<problem id="fs-id1788807">
<para id="fs-id1603310"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>108</m:mn></m:mrow><m:mrow><m:mn>63</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2325399">
<para id="fs-id2817966"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>12</m:mn></m:mrow><m:mn>7</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2793119">
<problem id="fs-id574581">
<para id="fs-id2261318"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>104</m:mn></m:mrow><m:mrow><m:mn>48</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1684083">
<problem id="fs-id1381828">
<para id="fs-id1363951"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>120</m:mn></m:mrow><m:mrow><m:mn>252</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2196239">
<para id="fs-id1970881"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>10</m:mn></m:mrow><m:mrow><m:mn>21</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1741803">
<problem id="fs-id2280962">
<para id="fs-id1967034"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>182</m:mn></m:mrow><m:mrow><m:mn>294</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1238655">
<problem id="fs-id2655499">
<para id="fs-id1406695"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>168</m:mn></m:mrow><m:mrow><m:mn>192</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2687031">
<para id="fs-id1799726"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2903548">
<problem id="fs-id2262648">
<para id="fs-id1607745"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>140</m:mn></m:mrow><m:mrow><m:mn>224</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2279769">
<problem id="fs-id2676746">
<para id="fs-id1302203"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>11</m:mn><m:mi>x</m:mi></m:mrow><m:mrow><m:mn>11</m:mn><m:mi>y</m:mi></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1402050">
<para id="fs-id1899705"><m:math><m:mrow><m:mfrac><m:mi>x</m:mi><m:mi>y</m:mi></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2270719">
<problem id="fs-id2338434">
<para id="fs-id4153464"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>15</m:mn><m:mi>a</m:mi></m:mrow><m:mrow><m:mn>15</m:mn><m:mi>b</m:mi></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2716617">
<problem id="fs-id908852">
<para id="fs-id1960210"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow><m:mrow><m:mn>12</m:mn><m:mi>y</m:mi></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id3203073">
<para id="fs-id1920834"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mi>x</m:mi><m:mrow><m:mn>4</m:mn><m:mi>y</m:mi></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2172406">
<problem id="fs-id1094601">
<para id="fs-id2216272"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi></m:mrow><m:mrow><m:mn>32</m:mn><m:mi>y</m:mi></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1594743">
<problem id="fs-id2288018">
<para id="fs-id1357548"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>14</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow><m:mrow><m:mn>21</m:mn><m:mi>y</m:mi></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1727185">
<para id="fs-id2310581"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow><m:mrow><m:mn>3</m:mn><m:mi>y</m:mi></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2792510">
<problem id="fs-id2146523">
<para id="fs-id2993417"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>24</m:mn><m:mi>a</m:mi></m:mrow><m:mrow><m:mn>32</m:mn><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id2164361"><emphasis effect="bold">ভগ্নাংশের গুণ</emphasis> </para><para id="eip-661">নীচের অনুশীলনগুলিতে চিত্র এঁকে গুণের মডেল দেখাও।</para><exercise id="fs-id1893304">
<problem id="fs-id1408242">
<para id="fs-id1288130"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1284174">
<para id="fs-id2348804"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math>
<newline />
<media id="fs-idm201661312" alt="সমান ছয় ভাগের আয়তক্ষেত্র, দুই সারি ও তিন স্তম্ভ। প্রথম দুই স্তম্ভের চারটি ঘর সবুজ; তাদের নীচের সারির দুটি ঘর আরও গাঢ়। সবুজ অংশ হল লব ২ ও হর ৩-এর ভগ্নাংশ। তার অর্ধেক হল গাঢ় দুটি ঘর: লব ২ ও হর ৬, অর্থাৎ লব ১ ও হর ৩।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_02_041a_img.jpg" />
</media></para>
</solution>
</exercise>
<exercise id="fs-id1373285">
<problem id="fs-id2278341">
<para id="fs-id1484783"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2261168">
<problem id="fs-id1345738">
<para id="fs-id2314456"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1913808">
<para id="fs-id1515486"><m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>18</m:mn></m:mrow></m:mfrac></m:mrow></m:math>
<newline />
<media id="fs-idm525542880" alt="সমান আঠারো ভাগের আয়তক্ষেত্র, তিন সারি ও ছয় স্তম্ভ। প্রথম পাঁচ স্তম্ভের পনেরোটি ঘর সবুজ; তাদের নীচের সারির পাঁচটি ঘর আরও গাঢ়। সবুজ অংশ হল লব ৫ ও হর ৬-এর ভগ্নাংশ। তার এক-তৃতীয়াংশ হল গাঢ় পাঁচটি ঘর: লব ৫ ও হর ১৮।">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_04_02_041c_img.jpg" />
</media></para>
</solution>
</exercise>
<exercise id="fs-id1389494">
<problem id="fs-id1597497">
<para id="fs-id2220562"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id1943541">নীচের অনুশীলনগুলিতে গুণ করো এবং উত্তর লঘিষ্ঠ আকারে লেখো।</para>
<exercise id="fs-id2715472">
<problem id="fs-id1631522">
<para id="fs-id2661041"><m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1973825">
<para id="fs-id1336323"><m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1544169">
<problem id="fs-id1308438">
<para id="fs-id2376745"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2266856">
<problem id="fs-id2777560">
<para id="fs-id1517644"><m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1529110">
<para id="fs-id2204669"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>27</m:mn></m:mrow><m:mrow><m:mn>40</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id3302583">
<problem id="fs-id1842765">
<para id="fs-id1973900"><m:math><m:mrow><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>7</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2924529">
<problem id="fs-id1773352">
<para id="fs-id1405782"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
<solution id="fs-id1594436">
<para id="fs-id1596023"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2418810">
<problem id="fs-id2486497">
<para id="fs-id1461123"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>4</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2167868">
<problem id="fs-id2334193">
<para id="fs-id1827310"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>9</m:mn></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>3</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id2471763">
<para id="fs-id1935703"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2669693">
<problem id="fs-id2129525">
<para id="fs-id1841592"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>4</m:mn><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2314753">
<problem id="fs-id4219942">
<para id="fs-id2247424"><m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>8</m:mn><m:mrow><m:mn>21</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
<solution id="fs-id1523740">
<para id="fs-id3301361"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id2603810">
<problem id="fs-id1935472">
<para id="fs-id1800026"><m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>8</m:mn><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id3208477">
<problem id="fs-id2426558">
<para id="fs-id3242540"><m:math><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>14</m:mn></m:mrow><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
<solution id="fs-id2172399">
<para id="fs-id2472033"><m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>21</m:mn></m:mrow><m:mrow><m:mn>50</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1858616">
<problem id="fs-id1544270">
<para id="fs-id2474584"><m:math><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mfrac><m:mrow><m:mn>25</m:mn></m:mrow><m:mrow><m:mn>33</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1415856">
<problem id="fs-id1410437">
<para id="fs-id1365265"><m:math><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>63</m:mn></m:mrow><m:mrow><m:mn>84</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>44</m:mn></m:mrow><m:mrow><m:mn>90</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
<solution id="fs-id2903896">
<para id="fs-id1253704"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>30</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1988914">
<problem id="fs-id1960568">
<para id="fs-id1774638"><m:math><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>33</m:mn></m:mrow><m:mrow><m:mn>60</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mfrac><m:mrow><m:mn>40</m:mn></m:mrow><m:mrow><m:mn>88</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
</exercise>
