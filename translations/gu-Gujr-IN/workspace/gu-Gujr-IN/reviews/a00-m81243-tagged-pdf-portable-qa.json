  "figures": [
    {
      "alt": "સંખ્યારેખા 0 થી 6 સમાન અંતરે. ડાબે નાની અને જમણે મોટી સંખ્યાઓ.",
      "children_text": "0123456નાનીમોટી"
    },
    {
      "alt": "સ્થાનકિંમતનું નમૂનું અમેરિકી ચલણની નોટોના ત્રણ સમૂહ. $100ની 3 નોટો: 3 × $100 = $300. $10ની 7 નોટો: 7 × $10 = $70. $1ની 4 નોટો: 4 × $1 = $4.",
      "children_text": "$1003 × $100 = $300$107 × $10 = $70$14 × $1 = $4"
    },
    {
      "alt": "સ્થાનકિંમતનું નમૂનું $300 + $70 + $4 = $374. 300નો અંક 3, 70નો અંક 7 અને 4 લાલ રંગે દર્શાવ્યા છે. તીરો આ અંકોને 374ના અનુક્રમે સો, દશક અને એકમના અંક સાથે જોડે છે.",
      "children_text": "$300$70$4++374$374"
    },
    {
      "alt": "સ્થાનકિંમતનું નમૂનું એક ખંડ 1 દર્શાવે છે. 10 ખંડોની આડી સળી 10 દર્શાવે છે. 10 હરોળ અને 10 સ્તંભના 100 ખંડોનો ચોરસ 100 દર્શાવે છે.",
      "children_text": "1 ખંડ = 11 સળી = 101 ચોરસ = 100"
    },
    {
      "alt": "સ્થાનકિંમતનું નમૂનું 100 ખંડોનો 1 ચોરસ એટલે 1 સો; દરેકમાં 10 ખંડો ધરાવતી 3 સળીઓ એટલે 3 દશક; 8 છૂટા ખંડો એટલે 8 એકમ.",
      "children_text": "1 સો3 દશક8 એકમ"
    },
    {
      "alt": "સ્થાનકિંમતનું નમૂનું 100 + 30 + 8 = 138. 100નો અંક 1, 30નો અંક 3 અને 8 લાલ રંગે દર્શાવ્યા છે. તીરો આ અંકોને 138ના અનુક્રમે સો, દશક અને એકમના અંક સાથે જોડે છે.",
      "children_text": "100308++138138"
    },
    {
      "alt": "સ્થાનકિંમતનું નમૂનું દરેકમાં 100 ખંડો ધરાવતા 2 ચોરસ, 10 ખંડોની 1 આડી સળી અને 5 છૂટા ખંડો.",
      "children_text": ""
    },
    {
      "alt": "સ્થાનકિંમતનું નમૂનું 200 + 10 + 5 = 215. 200નો અંક 2, 10નો અંક 1 અને 5 લાલ રંગે દર્શાવ્યા છે. તીરો આ અંકોને 215ના અનુક્રમે સો, દશક અને એકમના અંક સાથે જોડે છે.",
      "children_text": "200105++215215"
    },
    {
      "alt": "સ્થાનકિંમતનું નમૂનું 100 ખંડોનો 1 ચોરસ, દરેકમાં 10 ખંડો ધરાવતી 7 આડી સળીઓ અને 6 છૂટા ખંડો.",
      "children_text": ""
    },
    {
      "alt": "સ્થાનકિંમતનું નમૂનું દરેકમાં 100 ખંડો ધરાવતા 2 ચોરસ, દરેકમાં 10 ખંડો ધરાવતી 3 આડી સળીઓ અને 7 છૂટા ખંડો.",
      "children_text": ""
    },
    {
      "alt": "ચિત્રમાં ત્રણ પ્રકારના ભાગ છે. પહેલા ભાગમાં પાંચ ચોરસ છે; દરેક ચોરસમાં 100 ખંડ છે, 10 ખંડ પહોળાઈમાં અને 10 ખંડ ઊંચાઈમાં. બીજા ભાગમાં છ આડી સળીઓ છે; દરેકમાં 10 ખંડ છે. ત્રીજા ભાગમાં 1 અલગ ખંડ છે.",
      "children_text": ""
    },
    {
      "alt": "ચિત્રમાં ત્રણ પ્રકારના ભાગ છે. પહેલા ભાગમાં ત્રણ ચોરસ છે; દરેક ચોરસમાં 100 ખંડ છે, 10 ખંડ પહોળાઈમાં અને 10 ખંડ ઊંચાઈમાં. બીજા ભાગમાં આઠ આડી સળીઓ છે; દરેકમાં 10 ખંડ છે. ત્રીજા ભાગમાં 4 અલગ ખંડ છે.",
      "children_text": ""
    },
    {
      "alt": "ચિત્રમાં બે પ્રકારના ભાગ છે. પહેલા ભાગમાં ચાર ચોરસ છે; દરેક ચોરસમાં 100 ખંડ છે, 10 ખંડ પહોળાઈમાં અને 10 ખંડ ઊંચાઈમાં. બીજા ભાગમાં 7 અલગ ખંડ છે.",
      "children_text": ""
    },
    {
      "alt": "ચિત્રમાં બે પ્રકારના ભાગ છે. પહેલા ભાગમાં છ ચોરસ છે; દરેક ચોરસમાં 100 ખંડ છે, 10 ખંડ પહોળાઈમાં અને 10 ખંડ ઊંચાઈમાં. બીજા ભાગમાં 2 આડી સળીઓ છે; દરેકમાં 10 ખંડ છે.",
