<?xml version='1.0' encoding='utf-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" xmlns:ns1="http://cnx.rice.edu/mdml" xml:lang="gu-Gujr-IN">
<title>પદાવલીઓની કિંમત શોધો, સરળ કરો અને શબ્દોને પદાવલીમાં ફેરવો</title>
<metadata>
  <ns1:content-id>m81270</ns1:content-id>
  <ns1:title>પદાવલીઓની કિંમત શોધો, સરળ કરો અને શબ્દોને પદાવલીમાં ફેરવો</ns1:title>
  <ns1:abstract><para id="para-00001">આ વિભાગના અંતે તમે:</para><list id="list-00001">
<item>બીજગણિતની પદાવલીઓની કિંમત શોધી શકશો.</item>
<item>પદ, સહગુણક અને સજાતીય પદો ઓળખી શકશો.</item>
<item>સજાતીય પદો ભેગાં કરીને પદાવલીઓ સરળ કરી શકશો.</item>
<item>શબ્દસમૂહોને બીજગણિતની પદાવલીઓમાં ફેરવી શકશો.</item>
</list></ns1:abstract>
  <ns1:uuid>f8ffe655-ee35-4be9-9b1b-ae94f43c84fa</ns1:uuid>
</metadata>

<content>
<note id="fs-id1925557" class="be-prepared">
<para id="fs-id1808152">શરૂઆત કરતાં પહેલાં તૈયારી તપાસવાના આ પ્રશ્નો ઉકેલો.</para>
<exercise id="fs-idm214826640">
<problem id="fs-idm214703584">
<para id="fs-idm217388976">આ લખાવટ <m:math><m:mrow><m:mi>n</m:mi><m:mo>÷</m:mo><m:mn>5</m:mn></m:mrow></m:math> પદાવલી છે કે સમીકરણ?<newline />જો આ પ્રશ્નમાં ભૂલ થઈ હોય, તો ફરી જુઓ: <link target-id="fs-id2650235" document="m81268" />.</para>
</problem>
<solution id="fs-idm203090000">
<para id="fs-idm188629360">પદાવલી</para>
</solution>
</exercise>
</note>
<note id="fs-id1925558" class="be-prepared">
<exercise id="fs-idm216816528">
<problem id="fs-idm216370544">
<para id="fs-idm219867904">સરળ કરો: <m:math><m:mrow><m:msup><m:mn>4</m:mn><m:mn>5</m:mn></m:msup><m:mo>.</m:mo></m:mrow></m:math><newline />જો આ પ્રશ્નમાં ભૂલ થઈ હોય, તો ફરી જુઓ: <link target-id="fs-id1962334" document="m81268" />.</para>
</problem>
<solution id="fs-idm211961088">
<para id="fs-idm217224880"><m:math><m:mrow><m:mn>1</m:mn><m:mo>,</m:mo><m:mn>024</m:mn></m:mrow></m:math></para>
</solution>
</exercise></note>
<note id="fs-id1925257" class="be-prepared">
<exercise id="fs-idm216233584">
<problem id="fs-idm216101520">
<para id="fs-idm220191280">સરળ કરો: <m:math><m:mrow><m:mn>1</m:mn><m:mo>+</m:mo><m:mn>8</m:mn><m:mo>⋅</m:mo><m:mn>9</m:mn><m:mo>.</m:mo></m:mrow></m:math><newline />જો આ પ્રશ્નમાં ભૂલ થઈ હોય, તો ફરી જુઓ: <link target-id="fs-id1949613" document="m81268" />.</para>
</problem>
<solution id="fs-idm218567024">
<para id="fs-idm216460896"><m:math><m:mrow><m:mn>73</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<section id="fs-id2241263">
<title>બીજગણિતની પદાવલીઓની કિંમત શોધો</title>
<para id="fs-id2907739">અગાઉના વિભાગમાં આપણે ક્રિયાઓનો ક્રમ વાપરીને પદાવલીઓ સરળ કરી. આ વિભાગમાં ફરી ક્રિયાઓનો ક્રમ અનુસરીને પદાવલીઓની કિંમત શોધીશું.</para>
<para id="fs-id1632121">બીજગણિતની પદાવલીની <term id="term-00001">કિંમત શોધવી</term> એટલે આપેલી સંખ્યા મૂકીને પદાવલીનું પરિણામ ગણવું. સંખ્યા જેના સ્થાને મૂકીએ તે છે <term class="no-emphasis" id="term-00002">ચલ</term> . કોઈ <term class="no-emphasis" id="term-00003">પદાવલી</term>ની કિંમત શોધવા પદાવલીમાં ચલની જગ્યાએ આપેલી સંખ્યા મૂકીએ અને પછી ક્રિયાઓનો ક્રમ વાપરીને પદાવલી સરળ કરીએ.</para>
<example id="fs-id2202625"><exercise id="fs-id1177441">
<problem id="fs-id1372248">
<para id="fs-id1987806">કિંમત શોધો: <m:math><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn></m:mrow></m:math>  જ્યારે 
<list id="eip-id1168467157803" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> 
<m:math><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:math>
</item>
<item>
<span class="token">ⓑ</span> 
<m:math><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>12</m:mn></m:math></item>
</list></para></problem>
<solution id="fs-id2388055">
<title>ઉકેલ</title>
<para id="fs-id1576712"><span class="token">ⓐ</span> કિંમત શોધવા પદાવલીમાં આ સંખ્યા મૂકો: <m:math><m:mrow><m:mn>3</m:mn></m:mrow></m:math> આ ચલની જગ્યાએ: <m:math><m:mrow><m:mi>x</m:mi></m:mrow></m:math> પછી પદાવલી સરળ કરો.<newline />

<table id="eip-id1166566546426" class="unnumbered unstyled" aria-label="ચિત્રમાં આપેલી પદાવલી x વત્તા 7 છે. xની જગ્યાએ 3 મૂકો. પદાવલી 3 વત્તા x થાય છે, જે 10 છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry><media id="eip-id1166566546450" alt="સફેદ પૃષ્ઠભૂમિ પર કાળા અક્ષરમાં ગણિતની પદાવલી x + 7 છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_007_img-01.png" /></media></entry>
  </row>
  <row>
    <entry>આપેલી કિંમત મૂકો.</entry>
    <entry><media id="eip-id1166566546467" alt="ચિત્રમાં સાદું ગાણિતિક સમીકરણ 3 + 7 છે. સંખ્યા 3 લાલ છે અને વત્તાની નિશાની તથા સંખ્યા 7 સફેદ પૃષ્ઠભૂમિ પર કાળાં છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_007_img-02.png" /></media></entry>
  </row>
  <row>
    <entry>સરવાળો કરો.</entry>
    <entry><media id="eip-id1166566311657" alt="સંખ્યા 10 દર્શાવેલી છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_007_img-03.png" /></media></entry>
  </row>

</tbody>





</tgroup>
</table></para><para id="fs-id2650628"> જ્યારે  <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn><m:mo>,</m:mo></m:mrow></m:math> ત્યારે પદાવલી <m:math><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn></m:mrow></m:math> ની કિંમત છે <m:math><m:mrow><m:mn>10</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id2819088"><span class="token">ⓑ</span> કિંમત શોધવા પદાવલીમાં આ સંખ્યા મૂકો: <m:math><m:mrow><m:mn>12</m:mn></m:mrow></m:math> આ ચલની જગ્યાએ: <m:math><m:mi>x</m:mi></m:math> પછી પદાવલી સરળ કરો.<newline />
<table id="eip-id1166566410105" class="unnumbered unstyled" aria-label="ચિત્રમાં આપેલી પદાવલી x વત્તા 7 છે. xની જગ્યાએ 12 મૂકો. પદાવલી 12 વત્તા x થાય છે, જે 19 છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry><media id="eip-id1166566434247" alt="ચલ x, વત્તાની નિશાની અને સંખ્યા 7ની બનેલી ગણિતની પદાવલી x + 7 સફેદ પૃષ્ઠભૂમિ પર ઘાટા, છેડા પર સેરિફ વગરના અક્ષરમાં છે."><image mime-type="image/png" src="../../media/CNX_BMAth_Figure_02_02_008_img-01.png" /></media></entry>
  </row>
  <row>
    <entry>આપેલી કિંમત મૂકો.</entry>
    <entry><media id="eip-id1166566434264" alt="બે સંખ્યાનો સરવાળો દર્શાવતી ગણિતની પદાવલી: 12 લાલ છે અને 7 કાળો છે; વચ્ચે કાળી વત્તાની નિશાની છે: 12 + 7."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_008_img-02.png" /></media></entry>
  </row>
  <row>
    <entry>સરવાળો કરો.</entry>
    <entry><media id="eip-id1166566434281" alt="સંખ્યા 19 દર્શાવેલી છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_008_img-03.png" /></media></entry>
  </row>
</tbody>




</tgroup>
</table></para><para id="fs-id1737222"> જ્યારે  <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>12</m:mn><m:mo>,</m:mo></m:mrow></m:math> ત્યારે પદાવલી <m:math><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn></m:mrow></m:math> ની કિંમત છે <m:math><m:mrow><m:mn>19</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id1736700">નોંધો કે ભાગ <span class="token">ⓐ</span> અને <span class="token">ⓑ</span> માં એક જ પદાવલીથી શરૂઆત કરી હોવા છતાં જુદાં પરિણામ મળ્યાં. કારણ કે આ ચલ માટેની કિંમતો જુદી હતી: <m:math><m:mrow><m:mi>x</m:mi></m:mrow></m:math> . પદાવલીની કિંમત શોધીએ ત્યારે પરિણામ ચલ માટે વાપરેલી કિંમત પર આધારિત હોય છે.</para></solution>
</exercise>
</example><note id="fs-id1988839" class="try">
<exercise id="fs-id1566404">
<problem id="fs-id2211298">
<para id="fs-id1357478">કિંમત શોધો:</para>
<para id="fs-id1800084"><m:math><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /></m:math>
<list id="eip-id1168467133964" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> 
<m:math><m:mspace width="0.2em" /><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>6</m:mn><m:mspace width="0.2em" /><m:mspace width="0.2em" /></m:math></item>
<item>
<span class="token">ⓑ</span> 
<m:math><m:mspace width="0.2em" /><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>15</m:mn></m:math></item>
</list></para></problem>
<solution id="fs-id1946698">
<para id="fs-id1881659"><list id="eip-id1168468303825" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> 10
</item>
<item>
<span class="token">ⓑ</span> 19
</item>
</list></para></solution>
</exercise>
</note>
<note id="fs-id1171103481707" class="try">
<exercise id="fs-id3016905"><problem id="fs-id1893299">
<para id="fs-id1171105480166">કિંમત શોધો:</para>
<para id="fs-id2138650"><m:math><m:mi>a</m:mi><m:mo>−</m:mo><m:mn>5</m:mn><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /></m:math>
<list id="eip-id1168469871235" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> 
<m:math><m:mspace width="0.2em" /><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>9</m:mn><m:mspace width="0.2em" /><m:mspace width="0.2em" /></m:math></item>
<item>
<span class="token">ⓑ</span> 
<m:math><m:mspace width="0.2em" /><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>17</m:mn></m:math></item>
</list></para></problem>
<solution id="fs-id3293034">
<list id="eip-id1168468555320" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> 4
</item>
<item>
<span class="token">ⓑ</span> 12
</item>
</list></solution>
</exercise></note>
<example id="fs-id3218226">
<exercise id="fs-id2219842">
<problem id="fs-id2603896">
<para id="fs-id1800944">કિંમત શોધો: <m:math><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /></m:math>
<list id="eip-id1168468470077" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>5</m:mn><m:mspace width="0.2em" /><m:mspace width="0.2em" /></m:math></item>
<item>
<span class="token">ⓑ</span> 
<m:math><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:math></item>
</list></para></problem>
<solution id="fs-id1406199">
<title>ઉકેલ</title>
<para id="fs-id2311961">યાદ રાખો, <m:math><m:mrow><m:mi>a</m:mi><m:mi>b</m:mi></m:mrow></m:math> એટલે <m:math><m:mi>a</m:mi></m:math> ગુણ્યા <m:math><m:mi>b</m:mi><m:mo>,</m:mo></m:math> એટલે <m:math><m:mrow><m:mn>9</m:mn><m:mi>x</m:mi></m:mrow></m:math> નો અર્થ છે <m:math><m:mn>9</m:mn></m:math> ગુણ્યા <m:math><m:mrow><m:mi>x</m:mi><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id3177480"><span class="token">ⓐ</span> પદાવલીની કિંમત શોધવા, જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>5</m:mn><m:mo>,</m:mo></m:mrow></m:math> ત્યારે આ સંખ્યા મૂકીએ: <m:math><m:mn>5</m:mn></m:math> આ ચલની જગ્યાએ: <m:math><m:mi>x</m:mi><m:mo>,</m:mo></m:math> અને પછી સરળ કરીએ.<newline />

<table id="eip-id1168469462966" class="unnumbered unstyled" aria-label="ચિત્રમાં આપેલી પદાવલી નવ x ઓછા 2 છે. xની જગ્યાએ 5 મૂકો. પદાવલી 9 ગુણ્યા 5 ઓછા 2 થાય છે. પહેલાં ગુણાકાર કરો. નવ ગુણ્યા 5 એટલે 45; પદાવલી હવે 45 ઓછા 2 છે. બાદબાકી કરતાં 43 મળે છે.">
<label /><tgroup cols="2">
 <tbody>
  <row>
    <entry />
    <entry><media id="eip-id1168469462986" alt="સફેદ પૃષ્ઠભૂમિ પર સ્પષ્ટ ડિજિટલ અક્ષરમાં ગણિતની પદાવલી 9x - 2 છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_016_img-02.png" /></media></entry>
  </row>
  <row>
    <entry><media id="eip-id1168469463000" alt="લખાણ છે: xની જગ્યાએ 5 મૂકો. સંખ્યા 5 લાલ છે અને બાકી લખાણ સફેદ પૃષ્ઠભૂમિ પર ઘેરા લીલાશ પડતા વાદળી રંગનું છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_016_img-01.png" /></media></entry>
    <entry><media id="eip-id1168469463011" alt="ગણિતની પદાવલી 9.5-2 દર્શાવેલી છે. સંખ્યા 5, આ લખાવટમાં: 9.5, લાલ છે; બાકીની સંખ્યાઓ 9 અને 2 તથા ટપકું અને ઓછાની નિશાની કાળાં છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_016_img-03.png" /></media></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry><media id="eip-id1168469463028" alt="સફેદ પૃષ્ઠભૂમિ પર સાદા કાળા અક્ષરમાં ગણિતની પદાવલી 45 - 2 છે; તે બાદબાકીનો પ્રશ્ન દર્શાવે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_016_img-04.png" /></media></entry>
  </row>
  <row>
    <entry>બાદબાકી કરો.</entry>
    <entry><media id="eip-id1168469463045" alt="સાદી સફેદ પૃષ્ઠભૂમિ પર સંખ્યા 43 કાળા અક્ષરમાં છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_016_img-05.png" /></media></entry>
  </row>
</tbody>

</tgroup>
</table>
</para><para id="fs-id2440233"><span class="token">ⓑ</span> પદાવલીની કિંમત શોધવા, જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>1</m:mn><m:mo>,</m:mo></m:mrow></m:math> ત્યારે આ સંખ્યા મૂકીએ: <m:math><m:mn>1</m:mn></m:math> આ ચલની જગ્યાએ: <m:math><m:mi>x</m:mi><m:mo>,</m:mo></m:math> અને પછી સરળ કરીએ.<newline />

<table id="eip-id1168468440939" class="unnumbered unstyled" aria-label="ચિત્રમાં આપેલી પદાવલી નવ x ઓછા 2 છે. xની જગ્યાએ 1 મૂકો. પદાવલી 9 ગુણ્યા 1 ઓછા 2 થાય છે. પહેલાં ગુણાકાર કરો. નવ ગુણ્યા 1 એટલે 9; પદાવલી હવે 9 ઓછા 2 છે. બાદબાકી કરતાં 7 મળે છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry><media id="eip-id1168468440960" alt="સફેદ પૃષ્ઠભૂમિ પર સ્પષ્ટ ઘેરા અક્ષરમાં ગણિતની પદાવલી 9x - 2 છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_017_img-02.png" /></media></entry>
  </row>
  <row>
    <entry><media id="eip-id1168468440974" alt="સાદી સફેદ પૃષ્ઠભૂમિ પર લખાણ છે: xની જગ્યાએ 1 મૂકો. સંખ્યા 1 લાલ છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_017_img-01.png" /></media></entry>
    <entry><media id="eip-id1168468440984" alt="ચિત્રમાં ગણિતની પદાવલી 9(1) - 2 છે. સંખ્યા 1 લાલ છે; તે મૂકેલી કિંમત કે ગણતરીમાં ધ્યાન આપવાનું સ્થાન હોઈ શકે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_017_img-03.png" /></media></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry><media id="eip-id1168468441002" alt="ગણિતની પદાવલી 9 - 2 સફેદ પૃષ્ઠભૂમિ પર કાળા અક્ષરમાં છે અને બાદબાકીનો પ્રશ્ન દર્શાવે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_017_img-04.png" /></media></entry>
  </row>
  <row>
    <entry>બાદબાકી કરો.</entry>
    <entry><media id="eip-id1168468441019" alt="સાદી સફેદ પૃષ્ઠભૂમિના નીચેના જમણા ખૂણામાં સંખ્યા 7 દેખાય છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_017_img-05.png" /></media></entry>
  </row>
</tbody>


</tgroup>
</table>
</para><para id="fs-id2216151">નોંધો કે ભાગ <span class="token">ⓐ</span> માં આપણે લખ્યું <m:math><m:mrow><m:mn>9</m:mn><m:mo>⋅</m:mo><m:mn>5</m:mn></m:mrow></m:math> અને ભાગ <span class="token">ⓑ</span> માં લખ્યું <m:math><m:mrow><m:mn>9</m:mn><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>.</m:mo></m:mrow></m:math> ટપકું અને કૌંસ બંને ગુણાકાર સૂચવે છે.</para></solution>
</exercise>
</example>
<note id="fs-id2761352" class="try">
<exercise id="fs-id1370240">
<problem id="fs-id1368058">
<para id="fs-id2451489">કિંમત શોધો:</para>
<para id="fs-id2136380"><m:math><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /></m:math>
<list id="eip-id1168469756827" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mspace width="0.2em" /><m:mspace width="0.2em" /></m:math></item>
<item>
<span class="token">ⓑ</span> 
<m:math><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:math></item>
</list></para></problem>
<solution id="fs-id1630183">
<para id="fs-id2670731"><list id="eip-id1168467257646" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> 13
</item>
<item>
<span class="token">ⓑ</span> 5
</item>
</list></para></solution>
</exercise>
</note>
<note id="fs-id1171103512900" class="try">
<exercise id="fs-id1792161">
<problem id="fs-id2420879">
<para id="fs-id1171105140307">કિંમત શોધો:</para>
<para id="fs-id1281318"><m:math><m:mn>4</m:mn><m:mi>y</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>,</m:mo><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /></m:math>
<list id="eip-id1168466004460" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> 
<m:math><m:mspace width="0.2em" /><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>3</m:mn><m:mspace width="0.2em" /><m:mspace width="0.2em" /></m:math>
</item>
<item>
<span class="token">ⓑ</span> 
<m:math>
<m:mspace width="0.2em" /><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:math></item>
</list></para></problem>
<solution id="fs-id2439809">
<para id="fs-id1333406"><list id="eip-id1168468610088" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> 8
</item>
<item>
<span class="token">ⓑ</span> 16
</item>
</list></para></solution>
</exercise>
</note>
<example id="fs-id1284366">
<exercise id="fs-id1610002">
<problem id="fs-id2756986">
<para id="fs-id1811335">કિંમત શોધો: <m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>  જ્યારે  <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>10</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2661268">
<title>ઉકેલ</title>
<para id="fs-id2214943">આ સંખ્યા મૂકીએ: <m:math><m:mrow><m:mn>10</m:mn></m:mrow></m:math> આ ચલની જગ્યાએ: <m:math><m:mi>x</m:mi><m:mo>,</m:mo></m:math> અને પછી પદાવલી સરળ કરીએ.<newline />

<table id="eip-id1168468538199" class="unnumbered unstyled" aria-label="ચિત્રમાં આપેલી પદાવલી xનો વર્ગ છે. xની જગ્યાએ 10 મૂકો. પદાવલી 10નો વર્ગ થાય છે. ઘાતાંકની વ્યાખ્યા પ્રમાણે 10નો વર્ગ એટલે 10 ગુણ્યા 10. ગુણાકાર કરતાં 100 મળે છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry><media id="eip-id1168468538220" alt="ચિત્રમાં ગણિતની પદાવલી x^2 છે. નાનો અક્ષર x છે અને સંખ્યા 2 ઉપર ઘાતાંક તરીકે છે; તે xનો વર્ગ દર્શાવે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_018_img-02.png" /></media></entry>
  </row>
  <row>
    <entry><media id="eip-id1168468538234" alt="ચિત્રમાં સૂચના છે: xની જગ્યાએ 10 મૂકો. સંખ્યા 10 લાલ છે અને બાકી લખાણ ઘેરા લીલાશ પડતા વાદળી રંગનું છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_018_img-01.png" /></media></entry>
    <entry><media id="eip-id1168468538245" alt="સંખ્યા 10 લાલ છે અને ઉપર ઘાતાંક 2 કાળો છે; તે 10નો વર્ગ અથવા 10ની 2જી ઘાત દર્શાવે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_018_img-03.png" /></media></entry>
  </row>
  <row>
    <entry>ઘાતાંકની વ્યાખ્યાનો ઉપયોગ કરો.</entry>
    <entry><media id="eip-id1168468538262" alt="ગણિતની પદાવલી 10 . 10 છે; તે દસનો દસ વડે ગુણાકાર દર્શાવે છે, જે એકસો બરાબર છે. સંખ્યાઓ ઘાટી છે અને સફેદ પૃષ્ઠભૂમિની વચ્ચે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_018_img-04.png" /></media></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry><media id="eip-id1168468538279" alt="સફેદ પૃષ્ઠભૂમિ પર સંખ્યા 100 ઘાટા કાળા અક્ષરમાં છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_018_img-05.png" /></media></entry>
  </row>
</tbody>


</tgroup>
</table></para><para id="fs-id2197016"> જ્યારે  <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>10</m:mn><m:mo>,</m:mo></m:mrow></m:math> ત્યારે પદાવલી <m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> ની કિંમત છે <m:math><m:mrow><m:mn>100</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</solution>
</exercise>
</example>
<note id="fs-id1474811" class="try">
<exercise id="fs-id1823892">
<problem id="fs-id1881940">
<para id="fs-id1283634">કિંમત શોધો:</para>
<para id="fs-id1498924"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>8</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2296111">
<para id="fs-id1806491">64</para>
</solution>
</exercise>
</note>
<note id="fs-id1171105339525" class="try">
<exercise id="fs-id902234">
<problem id="fs-id1498997">
<para id="fs-id1171105158454">કિંમત શોધો:</para>
<para id="fs-id1546580"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>6</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2201260">
<para id="fs-id1180287">216</para>
</solution>
</exercise>
</note>
<example id="fs-id1967863">
<exercise id="fs-id1567145">
<problem id="fs-id1863809">
<para id="fs-id1325186"><m:math><m:mrow><m:mtext>કિંમત શોધો:</m:mtext><m:mspace width="0.2em" /><m:msup><m:mn>2</m:mn><m:mi>x</m:mi></m:msup><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>5</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2784321">
<title>ઉકેલ</title>
<para id="fs-id1731877">આ પદાવલીમાં ચલ ઘાતાંક તરીકે છે.<newline />

<table id="eip-id1168469574741" class="unnumbered unstyled" aria-label="ચિત્રમાં આપેલી પદાવલી 2ની xમી ઘાત છે. xની જગ્યાએ 5 મૂકો. પદાવલી 2ની પાંચમી ઘાત થાય છે. ઘાતાંકની વ્યાખ્યા પ્રમાણે 2ની પાંચમી ઘાત એટલે 2 ગુણ્યા 2 ગુણ્યા 2 ગુણ્યા 2 ગુણ્યા 2, અથવા 5 અવયવો આ સંખ્યાના: 2. ડાબેથી જમણે ગુણાકાર કરતાં 32 મળે છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry><media id="eip-id1168469574762" alt="સફેદ પૃષ્ઠભૂમિ પર પદાવલી 2x કાળા અક્ષરમાં છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_019_img-02.png" /></media></entry>
  </row>
  <row>
    <entry><media id="eip-id1168469574776" alt="સફેદ પૃષ્ઠભૂમિ પર ઘેરા લીલાશ પડતા વાદળી અક્ષરમાં લખાણ છે: xની જગ્યાએ 5 મૂકો. સંખ્યા 5 લાલ છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_019_img-01.png" /></media></entry>
    <entry><media id="eip-id1168469574787" alt="ગણિતની પદાવલી 2^5 છે. સંખ્યા 2 કાળી છે અને ઘાતાંક 5 અલગ લાલ રંગનો છે; તે 2ની 5મી ઘાત દર્શાવે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_019_img-03.png" /></media></entry>
  </row>
  <row>
    <entry>ઘાતાંકની વ્યાખ્યાનો ઉપયોગ કરો.</entry>
    <entry><media id="eip-id1168469574804" alt="ગણિતની પદાવલીમાં સંખ્યા 2નો તે જ સંખ્યા વડે પાંચ વખત ગુણાકાર દર્શાવ્યો છે: 2 . 2 . 2 . 2 . 2, જે 32 અથવા 2^5 બરાબર છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_019_img-04.png" /></media></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry><media id="eip-id1168469574821" alt="સંખ્યા 32 દર્શાવેલી છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_019_img-05.png" /></media></entry>
  </row>
</tbody>


</tgroup>
</table></para><para id="fs-id1547737"> જ્યારે  <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>5</m:mn><m:mo>,</m:mo></m:mrow></m:math> ત્યારે પદાવલી <m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mi>x</m:mi></m:msup></m:mrow></m:math> ની કિંમત છે <m:math><m:mrow><m:mn>32</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</solution>
</exercise>
</example>
<note id="fs-id2134194" class="try">
<exercise id="fs-id1410068">
<problem id="fs-id2609710">
<para id="fs-id2630090">કિંમત શોધો:</para>
<para id="fs-id2130634"><m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mi>x</m:mi></m:msup><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>6</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2136192">
<para id="fs-id1824352">64</para>
</solution>
</exercise>
</note>
<note id="fs-id1171105139468" class="try">
<exercise id="fs-id1346408">
<problem id="fs-id4363755">
<para id="fs-id1171105090102">કિંમત શોધો:</para>
<para id="fs-id2657794"><m:math><m:mrow><m:msup><m:mn>3</m:mn><m:mi>x</m:mi></m:msup><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2691459">
<para id="fs-id2326737">81</para>
</solution>
</exercise>
</note>
<example id="fs-id1948577">
<exercise id="fs-id1408555">
<problem id="fs-id1891867">
<para id="fs-id2276108"><m:math><m:mrow><m:mtext>કિંમત શોધો:</m:mtext><m:mspace width="0.2em" /><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>y</m:mi><m:mo>−</m:mo><m:mn>6</m:mn><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>10</m:mn><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2439822">
<title>ઉકેલ</title>
<para id="fs-id2264342">આ પદાવલીમાં બે ચલ છે, તેથી બંનેની જગ્યાએ આપેલી કિંમત મૂકવી પડશે.<newline />

<table id="eip-id1168467158036" class="unnumbered unstyled" aria-label="ચિત્રમાં આપેલી પદાવલી ત્રણ x વત્તા ચાર y ઓછા 6 છે. xની જગ્યાએ 10 અને yની જગ્યાએ 2 મૂકો. પદાવલી 3 ગુણ્યા 10 વત્તા 4 ગુણ્યા 2 ઓછા 6 થાય છે. ડાબેથી જમણે ગુણાકાર કરો. ત્રણ ગુણ્યા 10 એટલે 30 અને 4 ગુણ્યા 2 એટલે 8. પદાવલી 30 વત્તા 8 ઓછા 6 થાય છે. ડાબેથી જમણે સરવાળો અને બાદબાકી કરો. ત્રીસ વત્તા 8 એટલે 38. આડત્રીસ ઓછા 6 એટલે 32."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry><media id="eip-id1168467237223" alt="સફેદ પૃષ્ઠભૂમિ પર ગણિતની પદાવલી 3x + 4y - 6 છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_020_img-02.png" /></media></entry>
  </row>
  <row>
    <entry><media id="eip-id1168467237237" alt="ચિત્રમાં લખાણ છે: xની જગ્યાએ 10 અને yની જગ્યાએ 2 મૂકો."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_020_img-01.png" /></media></entry>
    <entry><media id="eip-id1168467237247" alt="ગણિતની પદાવલી ત્રણ ગુણ્યા દસ, વત્તા ચાર ગુણ્યા બે, ઓછા છ એમ વંચાય છે. સંખ્યા 10 લાલ છે અને 2 આછા વાદળી રંગની છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_020_img-03.png" /></media></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry><media id="eip-id1168467237264" alt="ગણિતની પદાવલીમાં સંખ્યાઓ 30, 8 અને 6 વત્તા અને ઓછાની નિશાનીઓથી જોડાયેલી છે: 30 + 8 - 6."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_020_img-04.png" /></media></entry>
  </row>
  <row>
    <entry>ડાબેથી જમણે સરવાળો અને બાદબાકી કરો.</entry>
    <entry><media id="eip-id1168467237280" alt="સાદી સફેદ પૃષ્ઠભૂમિ પર સંખ્યા 32 કાળા અક્ષરમાં છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_020_img-05.png" /></media></entry>
  </row>
</tbody>


</tgroup>
</table>
</para><para id="fs-id1470900"> જ્યારે  <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mo>,</m:mo></m:mrow></m:math> ત્યારે પદાવલી <m:math><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>y</m:mi><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math> ની કિંમત છે <m:math><m:mrow><m:mn>32</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</solution>
</exercise>
</example>
<note id="fs-id1469854" class="try">
<exercise id="fs-id1369028">
<problem id="fs-id1549196">
<para id="fs-id2267372">કિંમત શોધો:</para>
<para id="fs-id1160292"><m:math><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>y</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>11</m:mn><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1630119">
<para id="fs-id1607848">33</para>
</solution>
</exercise>
</note>
<note id="fs-id1171103386153" class="try">
<exercise id="fs-id1812847">
<problem id="fs-id1603080">
<para id="fs-id1171105115923">કિંમત શોધો:</para>
<para id="fs-id1718253"><m:math><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>−</m:mo><m:mn>9</m:mn><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>7</m:mn><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1494384">
<para id="fs-id2555520">10</para>
</solution>
</exercise>
</note>
<example id="fs-id1791214"><exercise id="fs-id1788450">
<problem id="fs-id1785986">
<para id="fs-id2657506"><m:math><m:mrow><m:mtext>કિંમત શોધો:</m:mtext><m:mspace width="0.2em" /><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1383958">
<title>ઉકેલ</title>
<para id="fs-id2310003">પદાવલીમાં ચલને ઘાતાંક હોય ત્યારે કાળજી રાખવી જોઈએ. આ પદાવલીમાં <m:math><m:mrow><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> એટલે <m:math><m:mrow><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mi>x</m:mi><m:mo>⋅</m:mo><m:mi>x</m:mi></m:mrow></m:math> તે આ પદાવલીથી જુદી છે: <m:math><m:mrow><m:msup><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo stretchy="false">)</m:mo></m:mrow><m:mn>2</m:mn></m:msup><m:mo>,</m:mo></m:mrow></m:math> જેનો અર્થ છે <m:math><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>⋅</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>.</m:mo></m:mrow></m:math><newline />

<table id="eip-id1168466011069" class="unnumbered unstyled" aria-label="ચિત્રમાં આપેલી પદાવલી બે ગુણ્યા xનો વર્ગ વત્તા ત્રણ x વત્તા 8 છે. દરેક xની જગ્યાએ 4 મૂકો. પદાવલી 2 ગુણ્યા 4નો વર્ગ વત્તા 3 ગુણ્યા 4 વત્તા 8 થાય છે. પહેલાં ઘાતાંકવાળી પદાવલીઓ સરળ કરો. ચારનો વર્ગ એટલે 16, તેથી પદાવલી 2 ગુણ્યા 16 વત્તા 3 ગુણ્યા 4 વત્તા 8 થાય છે. પછી ડાબેથી જમણે ગુણાકાર કરો. બે ગુણ્યા 16 એટલે 32 અને 3 ગુણ્યા 4 એટલે 12. પદાવલી 32 વત્તા 12 વત્તા 8 થાય છે. ડાબેથી જમણે સરવાળો કરો. બત્રીસ વત્તા 12 એટલે 44. ચુમ્માલીસ વત્તા 8 એટલે 52.">
<label /><tgroup cols="2">
 <tbody>
  <row>
    <entry />
    <entry><media id="eip-id1168466011092" alt="ગણિતની પદાવલી 2x^2 + 3x + 8 સાદી સફેદ પૃષ્ઠભૂમિ પર સ્પષ્ટ ઘેરા રાખોડી અક્ષરમાં છે; તે સામાન્ય દ્વિઘાત સમીકરણ કે બહુપદી જેવી દેખાય છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_021_img-02.png" /></media></entry>
  </row>
  <row>
    <entry><media id="eip-id1168466011106" alt="ચિત્રમાં લખાણ છે: દરેક xની જગ્યાએ 4 મૂકો. સંખ્યા 4 લાલ છે અને બાકી લખાણ ઘેરા વાદળી રાખોડી રંગનું છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_021_img-01.png" /></media></entry>
    <entry><media id="eip-id1168466011116" alt="ચિત્ર પદાવલી 2x^2 + 3x + 8ની સંખ્યાત્મક કિંમત શોધવાનું દર્શાવે છે, જેમાં xની જગ્યાએ 4 મૂકેલો છે. સંખ્યા 4 બંને જગ્યાએ લાલ છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_021_img-03.png" /></media></entry>
  </row>
  <row>
    <entry>સરળ કરો: <m:math><m:msup><m:mn>4</m:mn><m:mn>2</m:mn></m:msup></m:math>.</entry>
    <entry><media id="eip-id1168466011141" alt="ગુણનફળો અને એક સંખ્યાનો સરવાળો દર્શાવતી ગણિતની પદાવલી: 2 ગુણ્યા 16, વત્તા 3 ગુણ્યા 4, વત્તા 8."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_021_img-04.png" /></media></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry><media id="eip-id1168466011158" alt="સફેદ પૃષ્ઠભૂમિ પર ઘેરા અક્ષરમાં ગણિતની પદાવલી 32 + 12 + 8 છે. દરેક સંખ્યા અને ક્રિયાનું પ્રતીક સ્પષ્ટ દેખાય છે અને સાદો સરવાળો બને છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_021_img-05.png" /></media></entry>
  </row>
  <row>
    <entry>સરવાળો કરો.</entry>
    <entry><media id="eip-id1168466011175" alt="સફેદ પૃષ્ઠભૂમિ પર સંખ્યા 52 કાળા, છેડા પર સેરિફ વગરના અક્ષરમાં છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_021_img-06.png" /></media></entry>
  </row>
</tbody>

</tgroup>
</table>
</para></solution>
</exercise>
</example><note id="fs-id1376925" class="try">
<exercise id="fs-id1834595">
<problem id="fs-id2454530">
<para id="fs-id2646106">કિંમત શોધો:</para>
<para id="fs-id2265086"><m:math><m:mrow><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2835764">
<para id="fs-id1299685">40</para>
</solution>
</exercise>
</note>
<note id="fs-id1171103817204" class="try">
<exercise id="fs-id2368432">
<problem id="fs-id1259006">
<para id="fs-id1171105115753">કિંમત શોધો:</para>
<para id="fs-id1605750"><m:math><m:mrow><m:mn>6</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>7</m:mn><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2466793">
<para id="fs-id2198152">9</para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1733229">
<title>પદ, સહગુણક અને સજાતીય પદો ઓળખો</title>
<para id="fs-id2487968">બીજગણિતની પદાવલીઓ <emphasis effect="italics">પદો</emphasis>ની બનેલી હોય છે. <term id="term-00004">પદ</term> કોઈ અચળ અથવા અચળ અને એક કે વધુ ચલનું ગુણનફળ છે. પદનાં કેટલાંક ઉદાહરણ છે <m:math><m:mrow><m:mn>7</m:mn><m:mo>,</m:mo><m:mi>y</m:mi><m:mo>,</m:mo><m:mn>5</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>9</m:mn><m:mi>a</m:mi><m:mo>,</m:mo><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>13</m:mn><m:mi>x</m:mi><m:mi>y</m:mi><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id1965867">પદમાં જે અચળનો ચલ કે ચલો સાથે ગુણાકાર થાય છે તેને કહે છે <term id="term-00005">સહગુણક</term>. સહગુણકને ચલની <emphasis effect="italics">આગળ લખેલી</emphasis> સંખ્યા તરીકે સમજી શકાય. આ પદનો સહગુણક: <m:math><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math> છે <m:math><m:mn>3</m:mn><m:mo>.</m:mo></m:math> જ્યારે આપણે લખીએ <m:math><m:mrow><m:mi>x</m:mi><m:mo>,</m:mo></m:mrow></m:math> ત્યારે સહગુણક છે <m:math><m:mrow><m:mn>1</m:mn><m:mo>,</m:mo></m:mrow></m:math> કારણ કે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>1</m:mn><m:mo>⋅</m:mo><m:mi>x</m:mi><m:mo>.</m:mo></m:mrow></m:math> <link target-id="fs-id2266631" /> માં ડાબા સ્તંભના દરેક પદનો સહગુણક આપેલો છે.</para>
<table id="fs-id2266631" aria-label="આ કોષ્ટકમાં પાંચ હરોળ અને બે સ્તંભ છે. પહેલી હરોળ શીર્ષકની છે; સ્તંભનાં નામ પદ અને સહગુણક છે. પછીની હરોળના પદના સ્તંભમાં 9 a અને સહગુણકના સ્તંભમાં 9 છે. પછીની હરોળમાં અક્ષર y અને તેનો સહગુણક 1 છે. છેલ્લી હરોળમાં પદ 5 ગુણ્યા xનો વર્ગ અને તેનો સહગુણક 5 છે.">
<tgroup cols="2">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<thead>
<row valign="top">
<entry align="center">પદ</entry>
<entry align="center">સહગુણક</entry>
</row>
</thead>
<tbody>
<row valign="top">
<entry align="center"><m:math><m:mrow><m:mn>9</m:mn><m:mi>a</m:mi></m:mrow></m:math></entry>
<entry align="left"><m:math><m:mn>9</m:mn></m:math></entry>
</row>
<row valign="top">
<entry align="center"><m:math><m:mi>y</m:mi></m:math></entry>
<entry align="left"><m:math><m:mn>1</m:mn></m:math></entry>
</row>
<row valign="top">
<entry align="center"><m:math><m:mrow><m:mn>5</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></entry>
<entry align="left"><m:math><m:mn>5</m:mn></m:math></entry>
</row>
</tbody>
</tgroup>
</table>
<para id="fs-id3011311">બીજગણિતની પદાવલી એક કે વધુ પદોના સરવાળા કે બાદબાકીની બનેલી હોઈ શકે. આ પ્રકરણમાં આપણે માત્ર એકબીજામાં ઉમેરેલાં પદો પર કામ કરીશું. <link target-id="fs-id1596496" /> માં જુદી જુદી સંખ્યાનાં પદો ધરાવતી પદાવલીઓનાં ઉદાહરણ છે. નોંધો કે પદની આગળનું ક્રિયાનું પ્રતીક પણ તે પદ સાથે રાખીએ છીએ.</para>
<table id="fs-id1596496" aria-label="આ કોષ્ટકમાં છ હરોળ અને બે સ્તંભ છે. પહેલી હરોળ શીર્ષકની છે; સ્તંભનાં નામ પદાવલી અને પદો છે. પછીની હરોળમાં પદાવલી 7 અને પદ 7 છે. પછીની હરોળમાં પદાવલી y અને પદ y છે. પછીની હરોળમાં પદાવલી x વત્તા 7 અને પદો x તથા 7 છે. પછીની હરોળમાં પદાવલી 2 x વત્તા 7 y વત્તા 4 અને પદો 2 x, 7 y તથા 4 છે. છેલ્લી હરોળમાં પદાવલી 3 ગુણ્યા xનો વર્ગ વત્તા 4 ગુણ્યા xનો વર્ગ વત્તા 5 y વત્તા 3 અને પદો 3 ગુણ્યા xનો વર્ગ, 4 ગુણ્યા xનો વર્ગ, 5 y તથા 3 છે.">
<tgroup cols="2">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<thead>
<row valign="top">
<entry align="center">પદાવલી</entry>
<entry align="center">પદો</entry>
</row>
</thead>
<tbody>
<row valign="top">
<entry align="left"><m:math><m:mn>7</m:mn></m:math></entry>
<entry align="left"><m:math><m:mn>7</m:mn></m:math></entry>
</row>
<row valign="top">
<entry align="left"><m:math><m:mi>y</m:mi></m:math></entry>
<entry align="left"><m:math><m:mi>y</m:mi></m:math></entry>
</row>
<row valign="top">
<entry align="left"><m:math><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn></m:mrow></m:math></entry>
<entry align="left"><m:math><m:mrow><m:mi>x</m:mi><m:mo>,</m:mo><m:mn>7</m:mn></m:mrow></m:math></entry>
</row>
<row valign="top">
<entry align="left"><m:math><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math></entry>
<entry align="left"><m:math><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>,</m:mo><m:mn>7</m:mn><m:mi>y</m:mi><m:mo>,</m:mo><m:mn>4</m:mn></m:mrow></m:math></entry>
</row>
<row valign="top">
<entry align="left"><m:math><m:mrow><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math></entry>
<entry align="left"><m:math><m:mrow><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>5</m:mn><m:mi>y</m:mi><m:mo>,</m:mo><m:mn>3</m:mn></m:mrow></m:math></entry>
</row>
</tbody>
</tgroup>
</table>
<example id="fs-id1302708">
<exercise id="fs-id4127959">
<problem id="fs-id1919072">
<para id="fs-id1512228">આ પદાવલીનું દરેક પદ ઓળખો: <m:math><m:mrow><m:mn>9</m:mn><m:mi>b</m:mi><m:mo>+</m:mo><m:mn>15</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mo>.</m:mo></m:mrow></m:math> પછી દરેક પદનો સહગુણક ઓળખો.</para>
</problem>
<solution id="fs-id1823248">
<title>ઉકેલ</title>
<para id="fs-id2581602">પદાવલીમાં ચાર પદ છે. તેઓ છે <m:math><m:mrow><m:mn>9</m:mn><m:mi>b</m:mi><m:mo>,</m:mo><m:mn>15</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mi>a</m:mi><m:mo>,</m:mo></m:mrow></m:math> અને <m:math><m:mrow><m:mn>6</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id1405969">આ પદનો સહગુણક: <m:math><m:mrow><m:mn>9</m:mn><m:mi>b</m:mi></m:mrow></m:math> છે <m:math><m:mrow><m:mn>9</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id2593979">આ પદનો સહગુણક: <m:math><m:mrow><m:mn>15</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> છે <m:math><m:mrow><m:mn>15</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id1944608">યાદ રાખો કે ચલની આગળ સંખ્યા ન લખી હોય તો સહગુણક છે <m:math><m:mrow><m:mn>1</m:mn><m:mo>.</m:mo></m:mrow></m:math> તેથી આ પદનો સહગુણક: <m:math><m:mi>a</m:mi></m:math> છે <m:math><m:mrow><m:mn>1</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id2265026">અચળનો સહગુણક તે અચળ જ છે, તેથી આ પદનો સહગુણક: <m:math><m:mn>6</m:mn></m:math> છે <m:math><m:mrow><m:mn>6</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</solution>
</exercise>
</example>
<note id="fs-id2626325" class="try">
<exercise id="fs-id1791962">
<problem id="fs-id2281474">
<para id="fs-id1620052">આપેલી પદાવલીનાં બધાં પદ અને તેમના સહગુણકો ઓળખો:</para>
<para id="fs-id2307665"><m:math><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>b</m:mi><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1534340">
<para id="fs-id2786022">પદો છે: 4<emphasis effect="italics">x</emphasis>, 3<emphasis effect="italics">b</emphasis>, અને 2. સહગુણકો 4, 3 અને 2 છે.</para>
</solution>
</exercise>
</note>
<note id="fs-id1171105154844" class="try">
<exercise id="fs-id1790324">
<problem id="fs-id1366955">
<para id="fs-id1171103838018">આપેલી પદાવલીનાં બધાં પદ અને તેમના સહગુણકો ઓળખો:</para>
<para id="fs-id1335442"><m:math><m:mrow><m:mn>9</m:mn><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>13</m:mn><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:msup><m:mi>a</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math></para>
</problem>
<solution id="fs-id1575179">
<para id="fs-id883422">પદો છે: 9<emphasis effect="italics">a</emphasis>, 13<emphasis effect="italics">a</emphasis><sup>2</sup>, અને <emphasis effect="italics">a</emphasis><sup>3</sup>. સહગુણકો 9, 13 અને 1 છે.</para>
</solution>
</exercise>
</note>
<para id="fs-id1543061">કેટલાંક પદોમાં સરખાં લક્ષણો હોય છે. નીચેના પદો જુઓ. કયા પદોનાં લક્ષણો સરખાં લાગે છે?</para>
<equation id="fs-id1827907" class="unnumbered"><label /><m:math><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>,</m:mo><m:mn>7</m:mn><m:mo>,</m:mo><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>4</m:mn><m:mo>,</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>,</m:mo><m:mn>9</m:mn><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></equation>
<para id="fs-id1283119">આમાંથી કયાં પદો સજાતીય પદો છે?</para>
<list id="fs-id1627987" list-type="bulleted" bullet-style="bullet">
<item>આ પદો <m:math><m:mn>7</m:mn></m:math> અને <m:math><m:mn>4</m:mn></m:math> બંને અચળ પદો છે.</item>
<item>આ પદો <m:math><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi></m:mrow></m:math> અને <m:math><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math> બંનેમાં છે <m:math><m:mrow><m:mi>x</m:mi><m:mo>.</m:mo></m:mrow></m:math></item>
<item>આ પદો <m:math><m:mrow><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> અને <m:math><m:mrow><m:mn>9</m:mn><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> બંનેમાં છે <m:math><m:mrow><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup><m:mo>.</m:mo></m:mrow></m:math></item>
</list>
<para id="fs-id1372814">સરખા ચલ અને તેમના સરખા ઘાતાંક ધરાવતાં પદોને કહે છે <term id="term-00006">સજાતીય પદો</term> . બધાં અચળ પદો પણ સજાતીય પદો છે. તેથી આ પદોમાં: <m:math><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>,</m:mo><m:mn>7</m:mn><m:mo>,</m:mo><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>4</m:mn><m:mo>,</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>,</m:mo><m:mn>9</m:mn><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo></m:mrow></m:math></para>
<equation id="fs-id2268628" class="unnumbered"><label /><m:math><m:mn>7</m:mn><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>4</m:mn><m:mspace width="0.2em" /><m:mtext>સજાતીય પદો છે.</m:mtext></m:math></equation>
<equation id="fs-id555738" class="unnumbered"><label /><m:math><m:mn>5</m:mn><m:mi>x</m:mi><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>3</m:mn><m:mi>x</m:mi><m:mspace width="0.2em" /><m:mtext>સજાતીય પદો છે.</m:mtext></m:math></equation>
<equation id="fs-id2662299" class="unnumbered"><label /><m:math><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>9</m:mn><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup><m:mspace width="0.2em" /><m:mtext>સજાતીય પદો છે.</m:mtext></m:math></equation>
<note id="fs-id2129414">
<title>સજાતીય પદો</title>
<para id="fs-id2275773">અચળ પદો અથવા સરખા ચલ અને તેમના સરખા ઘાતાંક ધરાવતાં પદો સજાતીય પદો છે.</para>
</note>
<example id="fs-id1594870">
<exercise id="fs-id1308316">
<problem id="fs-id1518702">
<para id="fs-id1410435">સજાતીય પદો ઓળખો:</para>
<para id="fs-id2647142"><list id="eip-id1168468588896" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup><m:mo>,</m:mo><m:mn>7</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>14</m:mn><m:mo>,</m:mo><m:mn>23</m:mn><m:mo>,</m:mo><m:mn>4</m:mn><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup><m:mo>,</m:mo><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>,</m:mo><m:mn>5</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:math>
</item>
<item>
<span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>40</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mi>y</m:mi></m:math>
</item></list></para></problem>
<solution id="fs-id2142618">
<title>ઉકેલ</title>
<para id="fs-id1190825"><span class="token">ⓐ</span> 
<m:math><m:mspace width="0.2em" /><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup><m:mo>,</m:mo><m:mn>7</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>14</m:mn><m:mo>,</m:mo><m:mn>23</m:mn><m:mo>,</m:mo><m:mn>4</m:mn><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup><m:mo>,</m:mo><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>,</m:mo><m:mn>5</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:math></para><para id="fs-id1335628">ચલ અને ઘાતાંક જુઓ. પદાવલીમાં છે <m:math><m:mrow><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup><m:mo>,</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mi>x</m:mi><m:mo>,</m:mo></m:mrow></m:math> અને અચળ.</para>
<para id="fs-id1587743">આ પદો <m:math><m:mrow><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math> અને <m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math> સજાતીય પદો છે, કારણ કે બંનેમાં છે <m:math><m:mrow><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id1408738">આ પદો <m:math><m:mrow><m:mn>7</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> અને <m:math><m:mrow><m:mn>5</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> સજાતીય પદો છે, કારણ કે બંનેમાં છે <m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id1531249">આ પદો <m:math><m:mrow><m:mn>14</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>23</m:mn></m:mrow></m:math> સજાતીય પદો છે, કારણ કે બંને અચળ છે.</para>
<para id="fs-id1245764">આ પદને <m:math><m:mrow><m:mn>9</m:mn><m:mi>x</m:mi></m:mrow></m:math> યાદીમાં કોઈ સજાતીય પદ નથી, કારણ કે બીજા કોઈ પદમાં ચલ <m:math><m:mi>x</m:mi></m:math> ની ઘાત આ નથી: <m:math><m:mrow><m:mn>1</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id2649666"><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>40</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mi>y</m:mi></m:math></para><para id="fs-id2495896">ચલ અને ઘાતાંક જુઓ. પદાવલીમાં આ પદો છે: <m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>,</m:mo><m:mn>5</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>,</m:mo><m:mn>40</m:mn><m:mi>x</m:mi><m:mo>,</m:mo><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>8</m:mn><m:mi>x</m:mi><m:mi>y</m:mi></m:mrow></m:math></para>
<para id="fs-id1462544">આ પદો <m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> અને <m:math><m:mrow><m:mn>5</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> સજાતીય પદો છે, કારણ કે બંનેમાં છે <m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id1194075">આ પદો <m:math><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>,</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>,</m:mo><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>40</m:mn><m:mi>x</m:mi></m:mrow></m:math> સજાતીય પદો છે, કારણ કે બધાંમાં છે <m:math><m:mrow><m:mi>x</m:mi><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id2173435">આ પદને <m:math><m:mrow><m:mn>8</m:mn><m:mi>x</m:mi><m:mi>y</m:mi></m:mrow></m:math> આપેલી પદાવલીમાં કોઈ સજાતીય પદ નથી, કારણ કે બીજા કોઈ પદમાં આ બંને ચલ નથી: <m:math><m:mrow><m:mi>x</m:mi><m:mi>y</m:mi><m:mo>.</m:mo></m:mrow></m:math></para>
</solution>
</exercise>
</example>
<note id="fs-id1543709" class="try">
<exercise id="fs-id2466455">
<problem id="fs-id2495818">
<para id="fs-id1581991">યાદી કે પદાવલીમાંનાં સજાતીય પદો ઓળખો:</para>
<para id="fs-id1335600"><m:math><m:mrow><m:mn>9</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mo>,</m:mo><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>8</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mo>,</m:mo><m:mn>15</m:mn><m:mo>,</m:mo><m:mn>9</m:mn><m:mi>y</m:mi><m:mo>,</m:mo><m:mn>11</m:mn><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
</problem>
<solution id="fs-id1886900">
<para id="fs-id2481939">9 અને 15; 2<emphasis effect="italics">x</emphasis><sup>3</sup> અને 8<emphasis effect="italics">x</emphasis><sup>3</sup>; <emphasis effect="italics">y</emphasis><sup>2</sup> અને 11<emphasis effect="italics">y</emphasis><sup>2</sup></para>
</solution>
</exercise>
</note>
<note id="fs-id1171103712503" class="try">
<exercise id="fs-id2284527">
<problem id="fs-id1249480">
<para id="fs-id1171103712513">યાદી કે પદાવલીમાંનાં સજાતીય પદો ઓળખો:</para>
<para id="fs-id1863655"><m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mo>+</m:mo><m:mn>8</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>19</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>24</m:mn><m:mo>+</m:mo><m:mn>6</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math></para>
</problem>
<solution id="fs-id2650561">
<para id="fs-id1397862">4<emphasis effect="italics">x</emphasis><sup>3</sup> અને 6<emphasis effect="italics">x</emphasis><sup>3</sup>; 8<emphasis effect="italics">x</emphasis><sup>2</sup> અને 3<emphasis effect="italics">x</emphasis><sup>2</sup>; 19 અને 24</para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1232396"><title>સજાતીય પદો ભેગાં કરીને પદાવલીઓ સરળ કરો</title><para id="fs-id1169528">આપણે પદાવલીમાં <term class="no-emphasis" id="term-00007">સજાતીય પદો</term> ભેગાં કરીને તેને સરળ કરી શકીએ. તમને શું લાગે છે, <m:math><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>x</m:mi></m:mrow></m:math> સરળ કરતાં શું મળે? જો તમે વિચાર્યું હોય <m:math><m:mrow><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>,</m:mo></m:mrow></m:math> તો તમારો જવાબ સાચો છે!</para>
<para id="fs-id1374385">બંને પદોને સરવાળા તરીકે લખવાથી આ રીત શા માટે ચાલે છે તે જોઈ શકીએ.</para>
<media id="fs-id2261867" alt="ચિત્રમાં પદાવલી 3 x વત્તા 6 x છે. આ પદ 3 x એટલે x વત્તા x વત્તા x. આ પદ 6 x એટલે x વત્તા x વત્તા x વત્તા x વત્તા x વત્તા x. પદાવલી 3 x વત્તા 6 x એટલે x વત્તા x વત્તા x વત્તા x વત્તા x વત્તા x વત્તા x વત્તા x વત્તા x. તેને સરળ કરતાં કુલ 9 x અથવા પદ 9 x મળે છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_02_02_001_img.jpg" />
</media>
<para id="fs-id1693610">સજાતીય પદોના <term class="no-emphasis" id="term-00008">સહગુણકો</term> નો સરવાળો કરો અને ચલ એ જ રાખો. આ નિયમ સાચો છે, ભલે <m:math><m:mi>x</m:mi></m:math> ની કિંમત ગમે તે હોય. જો તમારી પાસે કોઈ વસ્તુના <m:math><m:mn>3</m:mn></m:math> નંગ હોય અને એવી જ વસ્તુના <m:math><m:mn>6</m:mn></m:math> નંગ વધુ ઉમેરો તો પરિણામ <m:math><m:mn>9</m:mn></m:math> નંગ થાય. ઉદાહરણ તરીકે, <m:math><m:mn>3</m:mn></m:math> નારંગી વત્તા <m:math><m:mn>6</m:mn></m:math> નારંગી એટલે <m:math><m:mn>9</m:mn></m:math> નારંગી. આ પાછળના ગાણિતિક ગુણધર્મોની ચર્ચા આગળ કરીશું.</para>
<para id="fs-id1246712">આ પદાવલીમાં <m:math><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>x</m:mi></m:mrow></m:math> માત્ર બે પદ છે. પદાવલીમાં વધુ પદ હોય ત્યારે સજાતીય પદો એકસાથે આવે તેમ ફરી ગોઠવવાથી મદદ મળે. <term class="no-emphasis" id="term-00009">સરવાળાનો ક્રમવિનિમયનો ગુણધર્મ</term> જણાવે છે કે ઉમેરવાની સંખ્યાઓનો ક્રમ બદલીએ તો સરવાળો બદલાતો નથી. તેથી સજાતીય પદો ભેગાં કરતાં પહેલાં નીચેની પદાવલી ફરી ગોઠવી શકીએ.</para>
<media id="fs-id1605094" alt="ચિત્રમાં પદાવલી 3 x વત્તા 4 y વત્તા 2 x વત્તા 6 y છે. વચ્ચેનાં પદ 4 y અને 2 xની જગ્યા બદલી શકાય, જેથી પદાવલી 3 x વત્તા 2 x વત્તા 4 y વત્તા 6 y થાય છે. હવે xવાળાં પદો એકસાથે અને yવાળાં પદો એકસાથે છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_02_02_015_img.jpg" />
</media>
<para id="fs-id1364178">હવે કયાં સજાતીય પદો ભેગાં કરવાનાં છે તે વધુ સરળતાથી જોઈ શકાય છે.</para>
<note id="fs-id1883861" class="howto"><title>સજાતીય પદો ભેગાં કરો.</title><list id="eip-id1168466010921" list-type="enumerated" number-style="arabic" class="stepwise"><item> સજાતીય પદો ઓળખો.</item>
<item> સજાતીય પદો એકસાથે આવે તેમ પદાવલી ફરી ગોઠવો.</item>
<item> સજાતીય પદોના સહગુણકોનો સરવાળો કરો.</item></list></note><example id="fs-id1177028"><exercise id="fs-id1558860">
<problem id="fs-id2436213">
<para id="fs-id2466500">પદાવલી સરળ કરો: <m:math><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1547208">
<title>ઉકેલ</title>


<table id="eip-id1168468738000" class="unnumbered unstyled" aria-label="ચિત્રમાં પદાવલી 3 x વત્તા 7 વત્તા 4 x વત્તા 5 છે. ત્રણ x અને 4 x સજાતીય પદો છે, તેમ જ 7 અને 5 પણ. વચ્ચેનાં પદ 7 અને 4 x ફરી ગોઠવી શકાય, જેથી સજાતીય પદો એકસાથે આવે. પદાવલી 3 x વત્તા 4 x વત્તા 7 વત્તા 5 થાય છે. હવે સજાતીય પદોના સહગુણકોનો સરવાળો કરીને પદો ભેગાં કરી શકાય. ત્રણ x વત્તા 4 x એટલે 7 x અને 7 વત્તા 5 એટલે 12. પદાવલી 7 x વત્તા 12 થાય છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry><media id="eip-id1168468738019" alt="પદોનો સરવાળો દર્શાવતી ગણિતની પદાવલી: ત્રણ ગુણ્યા x, વત્તા સાત, વત્તા ચાર ગુણ્યા x, વત્તા પાંચ (3x + 7 + 4x + 5). સંખ્યાઓ અને ચલ x સફેદ પૃષ્ઠભૂમિ પર કાળાં છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_022_img-01.png" /></media></entry>
  </row>
  <row>
    <entry>સજાતીય પદો ઓળખો.</entry>
    <entry><media id="eip-id1168468738036" alt="બીજગણિતની પદાવલી 3x + 7 + 4x + 5 દર્શાવેલી છે. પદ 3x અને 4x લાલ છે, જ્યારે 7 અને 5 આછા વાદળી છે; તેમની વચ્ચેની વત્તાની નિશાનીઓ કાળી છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_022_img-02.png" /></media></entry>
  </row>
  <row>
    <entry>સજાતીય પદો એકસાથે આવે તેમ પદાવલી ફરી ગોઠવો.</entry>
    <entry><media id="eip-id1168468738052" alt="બે ચલવાળાં પદો (3x અને 4x) અને બે અચળ પદો (7 અને 5)નો સરવાળો દર્શાવતી ગણિતની પદાવલી, જે 3x + 4x + 7 + 5 તરીકે લખેલી છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_022_img-03.png" /></media></entry>
  </row>
  <row>
    <entry>સજાતીય પદોના સહગુણકોનો સરવાળો કરો.</entry>
    <entry><media id="eip-id1168468373750" alt="સજાતીય પદો ભેગાં કરીને બીજગણિતની પદાવલી સરળ થાય છે: 3x + 4x એટલે 7x અને 7 + 5 એટલે 12. અંતિમ સરળ સ્વરૂપ 7x + 12 છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_022_img-04.png" /></media></entry>
  </row>
  <row>
    <entry>મૂળ પદાવલી સરળ કરતાં મળે છે…</entry>
    <entry><media id="eip-id1168468373766" alt="ચિત્રમાં ગણિતની પદાવલી 7x + 12 સફેદ પૃષ્ઠભૂમિ પર સ્પષ્ટ ઘેરા અક્ષરમાં છે; તે બીજગણિતની રૈખિક દ્વિપદી દર્શાવે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_022_img-05.png" /></media></entry>
  </row>
</tbody>


</tgroup>
</table>

</solution>
</exercise></example><note id="fs-id1611433" class="try">
<exercise id="fs-id1198821">
<problem id="fs-id2678387">
<para id="fs-id1788985">સરળ કરો:</para>
<para id="fs-id1231921"><m:math><m:mrow><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn><m:mo>+</m:mo><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id2881634">
<para id="fs-id1207553">16<emphasis effect="italics">x</emphasis> + 17</para>
</solution>
</exercise>
</note>
<note id="fs-id1171103505074" class="try">
<exercise id="fs-id1369298">
<problem id="fs-id1967025">
<para id="fs-id1171105545984">સરળ કરો:</para>
<para id="fs-id1860576"><m:math><m:mrow><m:mn>5</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id2860845">
<para id="fs-id1205903">17<emphasis effect="italics">y</emphasis> + 7</para>
</solution>
</exercise>
</note><para id="fs-id1203903">કોઈ પદનો સહગુણક ઋણ હોય ત્યારે રીત એ જ રહે છે, પરંતુ સજાતીય પદો ભેગાં કરવા સરવાળાને બદલે બાદબાકી કરવી પડે. </para>
<example id="fs-id1365874"><exercise id="fs-id1336931">
<problem id="fs-id1496028">
<para id="fs-id793755">પદાવલી સરળ કરો: <m:math><m:mrow><m:mn>7</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>–</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>–</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2203129">
<title>ઉકેલ</title>
<table id="eip-id1168467195542" class="unnumbered unstyled" aria-label="ચિત્રમાં પદાવલી 7 ગુણ્યા xનો વર્ગ વત્તા 8 x વત્તા xનો વર્ગ વત્તા 4 x છે. સાત ગુણ્યા xનો વર્ગ અને xનો વર્ગ સજાતીય પદો છે, તેમ જ 8 x અને 4 x પણ. વચ્ચેનાં પદ 8 x અને xનો વર્ગ ફરી ગોઠવી શકાય, જેથી સજાતીય પદો એકસાથે આવે. પદાવલી 7 ગુણ્યા xનો વર્ગ વત્તા xનો વર્ગ વત્તા 8 x વત્તા 4 x થાય છે. હવે સજાતીય પદોના સહગુણકોનો સરવાળો કરીને પદો ભેગાં કરી શકાય. 7 ગુણ્યા xનો વર્ગ વત્તા xનો વર્ગ એટલે 8 ગુણ્યા xનો વર્ગ અને 8 x વત્તા 4 x એટલે 12 x. પદાવલી 8 ગુણ્યા xનો વર્ગ વત્તા 12 x થાય છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry><media id="eip-id1168467195560" alt="ચિત્રમાં ગણિતની પદાવલી 7x^2 + 8x - x^2 - 4x છે. આ બહુપદીમાં xના વર્ગ અને xવાળાં પદો છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_023_img-01.png" /></media></entry>
  </row>
  <row>
    <entry>સજાતીય પદો ઓળખો.</entry>
    <entry><media id="eip-id1168467195577" alt="ગણિતની પદાવલી: 7x^2 + 8x - x^2 - 4x. અહીં x^2વાળાં પદો લાલ અને xવાળાં પદો વાદળી છે. પદાવલી સરળ કરતાં 6x^2 + 4x મળે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_023_img-02.png" /></media></entry>
  </row>
  <row>
    <entry>સજાતીય પદો એકસાથે આવે તેમ પદાવલી ફરી ગોઠવો.</entry>
    <entry><media id="eip-id1168467195594" alt="બીજગણિતનાં પદો દર્શાવતી ગણિતની પદાવલી: 7x^2 - x^2 + 8x - 4x. સરળીકરણ માટે સજાતીય પદો બતાવવા x^2વાળાં પદો લાલ અને xવાળાં પદો વાદળી રંગે દર્શાવ્યાં છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_023_img-03.png" /></media></entry>
  </row>
  <row>
    <entry>સજાતીય પદોના સહગુણકોનો સરવાળો કરો.</entry>
    <entry><media id="eip-id1168468740579" alt="ચિત્રમાં ગણિતની પદાવલી 6x^2 + 4x છે; તેમાં 6x^2 લાલ અને 4x વાદળી છે, અને વચ્ચે કાળી વત્તાની નિશાની છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_02_023_img-04.png" /></media></entry>
  </row>
</tbody>


</tgroup>
</table>
<para id="fs-id2700417">આ સજાતીય પદો નથી, તેથી તેમને ભેગાં કરી શકાય નહીં. એટલે <m:math><m:mrow><m:mn>6</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>x</m:mi></m:mrow></m:math> સૌથી સરળ સ્વરૂપમાં છે.</para></solution>
</exercise></example><note id="fs-id1866889" class="try">
<exercise id="fs-id1531346">
<problem id="fs-id295588">
<para id="fs-id2702656">સરળ કરો:</para>
<para id="fs-id1605168"><m:math><m:mrow><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>x</m:mi></m:mrow></m:math></para>
</problem>
<solution id="fs-id1548701">
<para id="fs-id1858346">4<emphasis effect="italics">x</emphasis><sup>2</sup> + 14<emphasis effect="italics">x</emphasis></para>
</solution>
</exercise>
</note>
<note id="fs-id1171105528610" class="try">
<exercise id="fs-id1361054">
<problem id="fs-id1341641">
<para id="fs-id1171105113756">સરળ કરો:</para>
<para id="fs-id2375181"><m:math><m:mrow><m:mn>11</m:mn><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>y</m:mi></m:mrow></m:math></para>
</problem>
<solution id="fs-id1184392">
<para id="fs-id4445444">12<emphasis effect="italics">y</emphasis><sup>2</sup> + 15<emphasis effect="italics">y</emphasis></para>
</solution>
</exercise>
</note>
</section><section id="fs-id2707610">
<title>શબ્દોને બીજગણિતની પદાવલીઓમાં ફેરવો</title>
<para id="fs-id1951299">અગાઉના વિભાગમાં આપણે બીજગણિતમાં વપરાતાં ઘણાં ક્રિયાનાં પ્રતીકોની યાદી બનાવી અને પછી પદાવલીઓ તથા સમીકરણોને શબ્દસમૂહો અને વાક્યોમાં ફેરવ્યાં. હવે આ પ્રક્રિયા ઊલટી કરીને શબ્દસમૂહોને બીજગણિતની પદાવલીઓમાં ફેરવીશું. આપણે ચર્ચા કરેલાં પ્રતીકો અને ચલ આમાં મદદ કરશે. તેમનો સાર અહીં આપેલો છે: <link target-id="eip-386" />.</para><table id="eip-386">
<tgroup cols="3"><colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<colspec colnum="3" colname="c3" />
<thead>
<row valign="top">
<entry align="center">ક્રિયા</entry>
<entry align="center">શબ્દસમૂહ</entry>
<entry align="center">પદાવલી</entry>
</row>
</thead>
<tbody>
<row valign="top">
<entry align="left" valign="top"><emphasis effect="bold">સરવાળો</emphasis></entry>
<entry align="left"><m:math><m:mi>a</m:mi></m:math> વત્તા <m:math><m:mi>b</m:mi></m:math><newline />
આ સંખ્યાઓનો સરવાળો: <m:math><m:mi>a</m:mi></m:math> અને <m:math><m:mi>b</m:mi></m:math><newline />
<m:math><m:mi>a</m:mi></m:math> માં આટલો વધારો: <m:math><m:mi>b</m:mi></m:math><newline />
<m:math><m:mi>b</m:mi></m:math> જેટલો વધારો, મૂળ સંખ્યા: <m:math><m:mi>a</m:mi></m:math>
<newline />
આ સંખ્યાઓનો કુલ સરવાળો: <m:math><m:mi>a</m:mi></m:math> અને <m:math><m:mi>b</m:mi></m:math>
<newline />
<m:math><m:mi>b</m:mi></m:math> ઉમેરો, આમાં: <m:math><m:mi>a</m:mi></m:math>
</entry>
<entry valign="top" align="center"><m:math><m:mrow><m:mi>a</m:mi><m:mo>+</m:mo><m:mi>b</m:mi></m:mrow></m:math></entry>
</row>
<row valign="top">
<entry align="left" valign="top"><emphasis effect="bold">બાદબાકી</emphasis></entry>
<entry align="left"><m:math><m:mi>a</m:mi></m:math> ઓછા <m:math><m:mi>b</m:mi></m:math><newline />
આ સંખ્યાઓનો તફાવત: <m:math><m:mi>a</m:mi></m:math> અને <m:math><m:mi>b</m:mi></m:math><newline />
<m:math><m:mi>b</m:mi></m:math> બાદ કરો, આમાંથી: <m:math><m:mi>a</m:mi></m:math><newline />
<m:math><m:mi>a</m:mi></m:math> માં આટલો ઘટાડો: <m:math><m:mi>b</m:mi></m:math><newline />
<m:math><m:mi>b</m:mi></m:math> જેટલો ઘટાડો, મૂળ સંખ્યા: <m:math><m:mi>a</m:mi></m:math>
</entry>
<entry align="center" valign="top"><m:math><m:mrow><m:mi>a</m:mi><m:mo>−</m:mo><m:mi>b</m:mi></m:mrow></m:math></entry>
</row>
<row valign="top">
<entry align="left" valign="top"><emphasis effect="bold">ગુણાકાર</emphasis></entry>
<entry align="left"><m:math><m:mi>a</m:mi></m:math>  ગુણ્યા <m:math><m:mi>b</m:mi></m:math><newline />
આ સંખ્યાઓનું ગુણનફળ: <m:math><m:mi>a</m:mi></m:math> અને <m:math><m:mi>b</m:mi></m:math>
</entry>
<entry align="center" valign="top"><m:math><m:mi>a</m:mi><m:mo>⋅</m:mo><m:mi>b</m:mi></m:math>, <m:math><m:mi>a</m:mi><m:mi>b</m:mi></m:math>, <m:math><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>b</m:mi><m:mo stretchy="false">)</m:mo></m:math>, <m:math> <m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>b</m:mi><m:mo stretchy="false">)</m:mo></m:math>
</entry>
</row>
<row valign="top">
<entry align="left" valign="top"><emphasis effect="bold">ભાગાકાર</emphasis></entry>
<entry align="left"><m:math><m:mi>a</m:mi></m:math> ભાગ્યા <m:math><m:mi>b</m:mi></m:math>
<newline />
આ સંખ્યાઓનું ભાગફળ: <m:math><m:mi>a</m:mi></m:math> અને <m:math><m:mi>b</m:mi></m:math>
<newline />
આ સંખ્યાઓનો ગુણોત્તર: <m:math><m:mi>a</m:mi></m:math> અને <m:math><m:mi>b</m:mi></m:math>
<newline />
<m:math><m:mi>b</m:mi></m:math> વડે ભાગો આ સંખ્યાને: <m:math><m:mi>a</m:mi></m:math>
</entry>
<entry align="center" valign="top"><m:math><m:mi>a</m:mi><m:mo>÷</m:mo><m:mi>b</m:mi></m:math>, <m:math><m:mi>a</m:mi><m:mo stretchy="false">/</m:mo><m:mi>b</m:mi></m:math>, <m:math><m:mfrac><m:mi>a</m:mi><m:mi>b</m:mi></m:mfrac></m:math>, <m:math><m:mi>b</m:mi><m:menclose notation="longdiv"><m:mi>a</m:mi></m:menclose></m:math></entry>
</row>
</tbody>


</tgroup>
</table><para id="fs-id2908409">ચાર ક્રિયાઓ દર્શાવતા આ શબ્દસમૂહો ધ્યાનથી જુઓ:</para>
<list id="fs-id1171105561839" list-type="bulleted" bullet-style="bullet">
<item>સરવાળો <emphasis effect="italics">આ સંખ્યાઓનો:</emphasis> <m:math><m:mrow><m:mi>a</m:mi></m:mrow></m:math> <emphasis effect="italics">અને</emphasis> <m:math><m:mrow><m:mi>b</m:mi></m:mrow></m:math></item>
<item>તફાવત <emphasis effect="italics">આ સંખ્યાઓનો:</emphasis> <m:math><m:mrow><m:mi>a</m:mi></m:mrow></m:math> <emphasis effect="italics">અને</emphasis> <m:math><m:mrow><m:mi>b</m:mi></m:mrow></m:math></item>
<item>ગુણનફળ <emphasis effect="italics">આ સંખ્યાઓનું:</emphasis> <m:math><m:mrow><m:mi>a</m:mi></m:mrow></m:math> <emphasis effect="italics">અને</emphasis> <m:math><m:mrow><m:mi>b</m:mi></m:mrow></m:math></item>
<item>ભાગફળ <emphasis effect="italics">આ સંખ્યાઓનું:</emphasis> <m:math><m:mrow><m:mi>a</m:mi></m:mrow></m:math> <emphasis effect="italics">અને</emphasis> <m:math><m:mrow><m:mi>b</m:mi></m:mrow></m:math></item>
</list>
<para id="fs-id2267592">દરેક શબ્દસમૂહ બે સંખ્યાઓ પર ક્રિયા કરવાનું કહે છે. સંખ્યાઓ શોધવા અંગ્રેજીના આ શબ્દો જુઓ: <emphasis effect="bold"><emphasis effect="italics">ઑફ</emphasis></emphasis> અને <emphasis effect="bold"><emphasis effect="italics">ઍન્ડ</emphasis></emphasis> .</para>
<example id="fs-id2300719">
<exercise id="fs-id1717280">
<problem id="fs-id1736728">
<para id="fs-id2214080">દરેક શબ્દસમૂહને બીજગણિતની પદાવલીમાં ફેરવો:</para>
<para id="fs-id1311748"><list id="eip-id1168467166071" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> આ સંખ્યાઓનો તફાવત: <m:math><m:mrow><m:mn>20</m:mn></m:mrow></m:math> અને <m:math><m:mn>4</m:mn></m:math>
</item>
<item>
<span class="token">ⓑ</span> આ સંખ્યાઓનું ભાગફળ: <m:math><m:mrow><m:mn>10</m:mn><m:mi>x</m:mi></m:mrow></m:math> અને <m:math><m:mn>3</m:mn></m:math></item>
</list></para></problem>
<solution id="fs-id1761830">
<title>ઉકેલ</title>
<para id="fs-id2399214"><span class="token">ⓐ</span> મુખ્ય શબ્દ છે <emphasis effect="italics">તફાવત</emphasis> જે જણાવે છે કે ક્રિયા બાદબાકી છે. બાદ કરવાની સંખ્યાઓ શોધવા અંગ્રેજીના આ શબ્દો જુઓ: <emphasis effect="italics">ઑફ</emphasis> અને <emphasis effect="italics">ઍન્ડ</emphasis> .</para><para id="fs-id2208916"><m:math><m:mtable columnalign="left"><m:mtr /><m:mtr><m:mtd columnalign="left"><m:mtext>તફાવત</m:mtext><m:mspace width="0.2em" /><m:mstyle fontstyle="italic"><m:mtext>આ સંખ્યાઓનો:</m:mtext></m:mstyle><m:mspace width="0.2em" /><m:mn>20</m:mn><m:mspace width="0.2em" /><m:mi>a</m:mi><m:mi>n</m:mi><m:mi>d</m:mi><m:mspace width="0.2em" /><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>20</m:mn><m:mspace width="0.2em" /><m:mtext>ઓછા</m:mtext><m:mspace width="0.2em" /><m:mn>4</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>20</m:mn><m:mo>−</m:mo><m:mn>4</m:mn></m:mtd></m:mtr></m:mtable></m:math></para>
<para id="fs-id1269652"><span class="token">ⓑ</span> મુખ્ય શબ્દ છે <emphasis effect="italics">ભાગફળ</emphasis> જે જણાવે છે કે ક્રિયા ભાગાકાર છે.</para><para id="fs-id14671710"><m:math><m:mtable columnalign="left"><m:mtr /><m:mtr><m:mtd columnalign="left"><m:mtext>આ સંખ્યાઓનું ભાગફળ:</m:mtext><m:mspace width="0.2em" /><m:mn>10</m:mn><m:mi>x</m:mi><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>3</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>ભાગો આ સંખ્યાને:</m:mtext><m:mspace width="0.2em" /><m:mn>10</m:mn><m:mi>x</m:mi><m:mspace width="0.2em" /><m:mtext>આ વડે:</m:mtext><m:mspace width="0.2em" /><m:mn>3</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>10</m:mn><m:mi>x</m:mi><m:mo>÷</m:mo><m:mn>3</m:mn></m:mtd></m:mtr></m:mtable></m:math></para>
<para id="fs-id1171105493688">આને આ રીતે પણ લખી શકાય: <m:math><m:mtable columnalign="left"><m:mtr><m:mtd columnalign="left"><m:mrow><m:mn>10</m:mn><m:mi>x</m:mi><m:mo stretchy="false">/</m:mo><m:mn>3</m:mn><m:mspace width="0.2em" /><m:mtext>અથવા</m:mtext><m:mspace width="0.4em" /><m:mfrac><m:mrow><m:mn>10</m:mn><m:mi>x</m:mi></m:mrow><m:mn>3</m:mn></m:mfrac></m:mrow></m:mtd></m:mtr></m:mtable></m:math></para></solution>
</exercise>
</example>
<note id="fs-id1612722" class="try">
<exercise id="fs-id1373796">
<problem id="fs-id1973372">
<para id="fs-id2212147">આપેલા શબ્દસમૂહને બીજગણિતની પદાવલીમાં ફેરવો:</para>
<para id="fs-id1393887"><list id="eip-id1168466926674" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> આ સંખ્યાઓનો તફાવત: <m:math><m:mrow><m:mn>47</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>41</m:mn></m:mrow></m:math></item>
<item>
<span class="token">ⓑ</span> આ સંખ્યાઓનું ભાગફળ: <m:math><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi></m:mrow></m:math> અને <m:math><m:mn>2</m:mn></m:math></item></list></para></problem>
<solution id="fs-id1379011">
<para id="fs-id1792557"><list id="eip-id1168466200991" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> 47 − 41
</item>
<item>
<span class="token">ⓑ</span> 5<emphasis effect="italics">x</emphasis> ÷ 2
</item>
</list></para></solution>
</exercise>
</note>
<note id="fs-id1171105421711" class="try">
<exercise id="fs-id1881870">
<problem id="fs-id1614102">
<para id="fs-id1171105421723">આપેલા શબ્દસમૂહને બીજગણિતની પદાવલીમાં ફેરવો:</para>
<para id="fs-id2288049"><list id="eip-id1168465992356" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> આ સંખ્યાઓનો સરવાળો: <m:math><m:mrow><m:mn>17</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>19</m:mn></m:mrow></m:math>
</item>
<item>
<span class="token">ⓑ</span> આ સંખ્યાઓનું ગુણનફળ: <m:math><m:mn>7</m:mn></m:math> અને <m:math><m:mi>x</m:mi></m:math></item>
</list></para></problem>
<solution id="fs-id2150850">
<para id="fs-id1811748"><list id="eip-id1168466080789" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> 17 + 19
</item>
<item>
<span class="token">ⓑ</span> 7<emphasis effect="italics">x</emphasis>
</item>
</list></para></solution>
</exercise>
</note>
<para id="fs-id1627292">આઠ વર્ષ પછી તમારી ઉંમર કેટલી હશે? અત્યારની ઉંમર કરતાં આઠ વર્ષ વધુ એટલે કેટલી ઉંમર? શું તમે ઉમેર્યા <m:math><m:mn>8</m:mn></m:math> વર્ષ તમારી અત્યારની ઉંમરમાં? આઠ જેટલો <emphasis effect="italics">વધારો</emphasis> એટલે અત્યારની ઉંમરમાં આઠ ઉમેરવા.</para>
<para id="fs-id2495303">સાત વર્ષ પહેલાં તમારી ઉંમર કેટલી હતી? તે અત્યારની ઉંમર કરતાં સાત વર્ષ ઓછી છે. તમે બાદ કરો <m:math><m:mn>7</m:mn></m:math> વર્ષ તમારી અત્યારની ઉંમરમાંથી. સાત જેટલો <emphasis effect="italics">ઘટાડો</emphasis> એટલે અત્યારની ઉંમરમાંથી સાત બાદ કરવા.</para>
<example id="fs-id1563391">
<exercise id="fs-id2265706">
<problem id="fs-id2204468">
<para id="fs-id2700294">દરેક શબ્દસમૂહને બીજગણિતની પદાવલીમાં ફેરવો:</para>
<para id="fs-id1509761"><list id="eip-id1168467351341" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> આઠ જેટલો વધારો, મૂળ રાશિ: <m:math><m:mi>y</m:mi></m:math>
</item>
<item>
<span class="token">ⓑ</span> સાત જેટલો ઘટાડો, મૂળ રાશિ: <m:math><m:mrow><m:mn>9</m:mn><m:mi>z</m:mi></m:mrow></m:math>
</item></list></para></problem>
<solution id="fs-id1205457">
<title>ઉકેલ</title>
<para id="fs-id1374015"><span class="token">ⓐ</span> મુખ્ય શબ્દો છે <emphasis effect="italics">કરતાં વધુ</emphasis>. તેઓ જણાવે છે કે ક્રિયા સરવાળો છે. <emphasis effect="italics">કરતાં વધુ</emphasis> એટલે તેમાં ઉમેરેલું.</para><para id="fs-id2284969"><m:math><m:mtable columnalign="left"><m:mtr><m:mtd><m:mtext>આઠ જેટલો વધારો, મૂળ રાશિ:</m:mtext><m:mspace width="0.2em" /><m:mi>y</m:mi></m:mtd></m:mtr><m:mtr><m:mtd><m:mtext>આઠ ઉમેરો, આમાં:</m:mtext><m:mspace width="0.2em" /><m:mi>y</m:mi></m:mtd></m:mtr><m:mtr><m:mtd><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>8</m:mn></m:mtd></m:mtr></m:mtable></m:math></para>
<para id="fs-id2785746"><span class="token">ⓑ</span> મુખ્ય શબ્દો છે <emphasis effect="italics">કરતાં ઓછું</emphasis>. તેઓ જણાવે છે કે ક્રિયા બાદબાકી છે. <emphasis effect="italics">કરતાં ઓછું</emphasis> એટલે તેમાંથી બાદ કરેલું.</para><para id="fs-id2190936"><m:math><m:mtable columnalign="left"><m:mtr><m:mtd><m:mtext>સાત જેટલો ઘટાડો, મૂળ રાશિ:</m:mtext><m:mspace width="0.2em" /><m:mn>9</m:mn><m:mi>z</m:mi></m:mtd></m:mtr><m:mtr><m:mtd><m:mtext>સાત બાદ કરો, આમાંથી:</m:mtext><m:mspace width="0.2em" /><m:mn>9</m:mn><m:mi>z</m:mi></m:mtd></m:mtr><m:mtr><m:mtd><m:mn>9</m:mn><m:mi>z</m:mi><m:mo>−</m:mo><m:mn>7</m:mn></m:mtd></m:mtr></m:mtable></m:math></para>
</solution>
</exercise>
</example>
<note id="fs-id1278868" class="try">
<exercise id="fs-id1269389">
<problem id="fs-id2203045">
<para id="fs-id2266808">દરેક શબ્દસમૂહને બીજગણિતની પદાવલીમાં ફેરવો:</para>
<para id="fs-id1611460"><list id="eip-id1168468303099" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> અગિયાર જેટલો વધારો, મૂળ રાશિ: <m:math><m:mi>x</m:mi></m:math>
</item>
<item>
<span class="token">ⓑ</span> ચૌદ જેટલો ઘટાડો, મૂળ રાશિ: <m:math><m:mrow><m:mn>11</m:mn><m:mi>a</m:mi></m:mrow></m:math>
</item>
</list></para></problem>
<solution id="fs-id1748485">
<para id="fs-id2662143"><list id="eip-id1168469857801" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> <emphasis effect="italics">x</emphasis> + 11
</item>
<item>
<span class="token">ⓑ</span> 11<emphasis effect="italics">a</emphasis> − 14
</item>
</list></para></solution>
</exercise>
</note>
<note id="fs-id1171105461719" class="try">
<exercise id="fs-id2257971">
<problem id="fs-id1458006">
<para id="fs-id1171105138387">દરેક શબ્દસમૂહને બીજગણિતની પદાવલીમાં ફેરવો:</para>
<para id="fs-id2133452"><list id="eip-id1168468371000" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> <m:math><m:mrow><m:mn>19</m:mn></m:mrow></m:math> જેટલો વધારો આ સંખ્યામાં: <m:math><m:mi>j</m:mi></m:math>
</item>
<item>
<span class="token">ⓑ</span> <m:math><m:mrow><m:mn>21</m:mn></m:mrow></m:math> જેટલો ઘટાડો આ સંખ્યામાં: <m:math><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi></m:mrow></m:math>
</item>
</list></para></problem>
<solution id="fs-id1881448">
<para id="fs-id1363982"><list id="eip-id1168467258633" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> <emphasis effect="italics">j</emphasis> + 19
</item>
<item>
<span class="token">ⓑ</span> 2<emphasis effect="italics">x</emphasis> − 21
</item>
</list></para></solution>
</exercise>
</note>
<example id="fs-id1313657">
<exercise id="fs-id2670079">
<problem id="fs-id2206433">
<para id="fs-id1572229">દરેક શબ્દસમૂહને બીજગણિતની પદાવલીમાં ફેરવો:</para>
<para id="fs-id1402228"><list id="eip-id1168468738249" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> આ સંખ્યાઓના સરવાળાના પાંચ ગણા: <m:math><m:mi>m</m:mi></m:math> અને <m:math><m:mi>n</m:mi></m:math>
</item>
<item>
<span class="token">ⓑ</span> આ રાશિઓનો સરવાળો: પાંચ ગુણ્યા <m:math><m:mi>m</m:mi></m:math> અને <m:math><m:mi>n</m:mi></m:math>
</item></list></para></problem>
<solution id="fs-id2211545">
<title>ઉકેલ</title>
<para id="fs-id1630800"><span class="token">ⓐ</span> અહીં ક્રિયા દર્શાવતા બે શબ્દો છે: <emphasis effect="italics">ગુણ્યા</emphasis> ગુણાકાર કરવાનું કહે છે અને <emphasis effect="italics">સરવાળો</emphasis> ઉમેરવાનું કહે છે. આપણે આટલા ગણા કરીએ છીએ: <m:math><m:mrow><m:mn>5</m:mn></m:mrow></m:math> સરવાળાના, તેથી આ રાશિઓના સરવાળાની આસપાસ કૌંસ જોઈએ: <m:math><m:mrow><m:mi>m</m:mi></m:mrow></m:math> અને <m:math><m:mrow><m:mi>n</m:mi><m:mo>.</m:mo></m:mrow></m:math></para><para id="fs-id2299604">આ સંખ્યાઓના સરવાળાના પાંચ ગણા: <m:math><m:mi>m</m:mi></m:math> અને <m:math><m:mi>n</m:mi></m:math><newline />
<m:math><m:mrow><m:mtable><m:mtr /><m:mtr /><m:mtr><m:mtd columnalign="left"><m:mspace width="4em" /><m:mn>5</m:mn><m:mrow><m:mo>(</m:mo><m:mrow><m:mi>m</m:mi><m:mo>+</m:mo><m:mi>n</m:mi></m:mrow><m:mo>)</m:mo></m:mrow></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><para id="fs-id1582880"><span class="token">ⓑ</span> શું ઉમેરવાનું છે તે જાણવા અંગ્રેજીના આ શબ્દો જુઓ: <emphasis effect="italics">ઑફ</emphasis> અને <emphasis effect="italics">ઍન્ડ</emphasis> . અહીં આપણે સરવાળો લઈએ છીએ <emphasis effect="italics">આ રાશિઓનો:</emphasis> પાંચ ગુણ્યા <m:math><m:mrow><m:mi>m</m:mi></m:mrow></m:math> અને <m:math><m:mrow><m:mi>n</m:mi><m:mo>.</m:mo></m:mrow></m:math></para><para id="fs-id1823388">આ રાશિઓનો સરવાળો: પાંચ ગુણ્યા <m:math><m:mi>m</m:mi></m:math> અને <m:math><m:mi>n</m:mi></m:math><newline />
<m:math><m:mrow><m:mtable><m:mtr /><m:mtr /><m:mtr><m:mtd columnalign="left"><m:mspace width="4em" /><m:mn>5</m:mn><m:mrow><m:mrow><m:mi>m</m:mi><m:mo>+</m:mo><m:mi>n</m:mi></m:mrow></m:mrow></m:mtd></m:mtr></m:mtable></m:mrow></m:math></para><para id="fs-id2696230">કૌંસ વાપરવાથી પરિણામ કેવી રીતે બદલાય છે તે જુઓ. ભાગ <span class="token">ⓐ</span> માં પહેલાં સરવાળો કરીએ છીએ અને ભાગ <span class="token">ⓑ</span> માં પહેલાં ગુણાકાર કરીએ છીએ.</para></solution>
</exercise>
</example>
<note id="fs-id1971669" class="try">
<exercise id="fs-id1362744">
<problem id="fs-id2785111">
<para id="fs-id2642905">શબ્દસમૂહને બીજગણિતની પદાવલીમાં ફેરવો:</para>
<para id="fs-id2483381"><list id="eip-id1168468228349" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> 
 આ સંખ્યાઓના સરવાળાના ચાર ગણા: <m:math><m:mrow><m:mi>p</m:mi></m:mrow></m:math> અને <m:math><m:mi>q</m:mi></m:math>
</item>
<item>
<span class="token">ⓑ</span> 
આ રાશિઓનો સરવાળો: ચાર ગુણ્યા <m:math><m:mi>p</m:mi></m:math> અને <m:math><m:mi>q</m:mi></m:math></item></list></para></problem>
<solution id="fs-id2657948">
<para id="fs-id2603910"><list id="eip-id1168469868809" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> 4(<emphasis effect="italics">p</emphasis> + <emphasis effect="italics">q</emphasis>)
</item>
<item>
<span class="token">ⓐ</span> 4<emphasis effect="italics">p</emphasis> + <emphasis effect="italics">q</emphasis>
</item>
</list></para></solution>
</exercise>
</note>
<note id="fs-id1171103467243" class="try">
<exercise id="fs-id1909857">
<problem id="fs-id3399510">
<para id="fs-id1171101791128">શબ્દસમૂહને બીજગણિતની પદાવલીમાં ફેરવો:</para>
<para id="fs-id1808554"><list id="eip-id1168466313766" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> 
આ રાશિઓનો તફાવત: બે ગુણ્યા <m:math><m:mi>x</m:mi><m:mspace width="0.2em" /><m:mtext>અને 8</m:mtext><m:mspace width="0.2em" /></m:math></item>
<item>
<span class="token">ⓑ</span> 
આ સંખ્યાઓના તફાવતના બે ગણા: <m:math><m:mi>x</m:mi><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>8</m:mn></m:math>
</item></list></para></problem>
<solution id="fs-id2270755">
<para id="fs-id1401640"><list id="eip-id1168466165177" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> 
 2<emphasis effect="italics">x</emphasis> − 8
</item>
<item>
<span class="token">ⓑ</span> 
 2(<emphasis effect="italics">x</emphasis> − 8)
</item>
</list></para></solution>
</exercise>
</note>
<para id="fs-id2587636">આ અભ્યાસક્રમમાં આગળ બીજગણિતની કુશળતાથી સમીકરણો ઉકેલીશું. સામાન્ય રીતે શબ્દસમૂહને જે સ્વરૂપમાં ફેરવીને શરૂઆત કરીશું તે છે <term class="no-emphasis" id="term-00010">બીજગણિતની પદાવલી</term>. આ પદાવલી શું દર્શાવે છે તે સ્પષ્ટ હોવું જોઈએ. આગળનાં બે ઉદાહરણમાં આ કેવી રીતે કરવું તે જોઈશું.</para>
<example id="fs-id1683696"><exercise id="fs-id1620216">
<problem id="fs-id1932541">
<para id="fs-id1481031">લંબચોરસ બારીની ઊંચાઈમાં પહોળાઈની સરખામણીમાં <m:math><m:mn>6</m:mn></m:math> ઇંચનો ઘટાડો છે. ધારો કે <m:math><m:mi>w</m:mi></m:math> બારીની પહોળાઈ દર્શાવે છે. બારીની ઊંચાઈ માટે પદાવલી લખો.</para>
</problem>
<solution id="fs-id1258807">
<title>ઉકેલ</title>


<table id="eip-id1168466033010" class="unnumbered unstyled" summary="શબ્દસમૂહ “6 જેટલો ઘટાડો, મૂળ રાશિ પહોળાઈ”ને બીજગણિતની પદાવલી w - 6માં ફેરવવાનાં પગલાં.">
<label /><tgroup cols="2">
 <tbody>
  <row>
    <entry>ઊંચાઈ વિશે શબ્દસમૂહ લખો.</entry>
    <entry><m:math><m:mn>6</m:mn></m:math>  જેટલો ઘટાડો, મૂળ રાશિ પહોળાઈ</entry>
  </row>
  <row>
    <entry>આ અક્ષર મૂકો: <m:math><m:mi>w</m:mi></m:math> પહોળાઈની જગ્યાએ.</entry>
    <entry><m:math><m:mn>6</m:mn></m:math>  જેટલો ઘટાડો, મૂળ રાશિ: <m:math><m:mi>w</m:mi></m:math></entry>
  </row>
  <row>
    <entry>“કરતાં ઓછું”ને “આમાંથી બાદ કરો” તરીકે ફરી લખો.</entry>
    <entry><m:math><m:mn>6</m:mn></m:math> બાદ કરો, આમાંથી: <m:math><m:mi>w</m:mi></m:math></entry>
  </row>
  <row>
    <entry>શબ્દસમૂહને બીજગણિતની લખાવટમાં ફેરવો.</entry>
    <entry><m:math><m:mi>w</m:mi><m:mo>−</m:mo><m:mn>6</m:mn></m:math></entry>
  </row>
</tbody>

</tgroup>
</table>

</solution>
</exercise>
</example><note id="fs-id1602816" class="try">
<exercise id="fs-id2161945">
<problem id="fs-id2700289">
<para id="fs-id2274284">લંબચોરસની લંબાઈમાં પહોળાઈની સરખામણીમાં <m:math><m:mn>5</m:mn></m:math> ઇંચનો ઘટાડો છે. ધારો કે <m:math><m:mi>w</m:mi></m:math> લંબચોરસની પહોળાઈ દર્શાવે છે. લંબચોરસની લંબાઈ માટે પદાવલી લખો.</para>
</problem>
<solution id="fs-id1693128">
<para id="fs-id1693130"><emphasis effect="italics">w</emphasis> − 5</para>
</solution>
</exercise>
</note>
<note id="fs-id1171103365354" class="try">
<exercise id="fs-id2211820">
<problem id="fs-id2785833">
<para id="fs-id2785835">લંબચોરસની પહોળાઈમાં લંબાઈની સરખામણીમાં <m:math><m:mn>2</m:mn></m:math> મીટરનો વધારો છે. ધારો કે <m:math><m:mi>l</m:mi></m:math> લંબચોરસની લંબાઈ દર્શાવે છે. લંબચોરસની પહોળાઈ માટે પદાવલી લખો.</para>
</problem>
<solution id="fs-id1795902">
<para id="fs-id4120698"><emphasis effect="italics">l</emphasis> + 2</para>
</solution>
</exercise>
</note>
<example id="fs-id4222214"><exercise id="fs-id1866169">
<problem id="fs-id1866171">
<para id="fs-id2603709">બ્લાન્કાના પર્સમાં ડાઇમ (દસ સેન્ટના અમેરિકી સિક્કા) અને ક્વાર્ટર (પચીસ સેન્ટના અમેરિકી સિક્કા) છે. ડાઇમની સંખ્યામાં <m:math><m:mn>2</m:mn></m:math> જેટલો ઘટાડો છે, જેની સરખામણી કરીએ છીએ તે છે <m:math><m:mn>5</m:mn></m:math> ગુણ્યા ક્વાર્ટરની સંખ્યા. ધારો કે <m:math><m:mi>q</m:mi></m:math> ક્વાર્ટરની સંખ્યા દર્શાવે છે. ડાઇમની સંખ્યા માટે પદાવલી લખો.</para>
</problem>
<solution id="fs-id2451560">
<title>ઉકેલ</title>

<table id="eip-id1168467234223" class="unnumbered unstyled" summary="ડાઇમ અને ક્વાર્ટરની સંખ્યાની સરખામણી કરતા શબ્દસમૂહને બીજગણિતની પદાવલીમાં ફેરવવાની ક્રમશઃ માર્ગદર્શિકા."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry>ડાઇમની સંખ્યા વિશે શબ્દસમૂહ લખો.</entry>
    <entry>ક્વાર્ટરની સંખ્યાના પાંચ ગણામાંથી બે ઓછા</entry>
  </row>
  <row>
    <entry>આ અક્ષર મૂકો: <m:math><m:mi>q</m:mi></m:math> ક્વાર્ટરની સંખ્યાની જગ્યાએ.</entry>
    <entry><m:math><m:mn>2</m:mn></m:math>  જેટલો ઘટાડો, મૂળ રાશિ: પાંચ ગુણ્યા <m:math><m:mi>q</m:mi></m:math></entry>
  </row>
  <row>
    <entry>બીજગણિતમાં ફેરવો: <m:math><m:mn>5</m:mn></m:math> <emphasis effect="italics">ગુણ્યા</emphasis> <m:math><m:mi>q</m:mi></m:math>.</entry>
    <entry><m:math><m:mn>2</m:mn></m:math> જેટલો ઘટાડો, મૂળ રાશિ: <m:math><m:mn>5</m:mn><m:mi>q</m:mi></m:math></entry>
  </row>
  <row>
    <entry>શબ્દસમૂહને બીજગણિતની લખાવટમાં ફેરવો.</entry>
    <entry><m:math><m:mn>5</m:mn><m:mi>q</m:mi><m:mo>−</m:mo><m:mn>2</m:mn></m:math></entry>
  </row>
</tbody>




</tgroup>
</table></solution>
</exercise></example><note id="fs-id2661305" class="try">
<exercise id="fs-id2199400">
<problem id="fs-id2199402">
<para id="fs-id1737365">જેફ્રીના ખિસ્સામાં ડાઇમ અને ક્વાર્ટર છે. ડાઇમની સંખ્યા ક્વાર્ટરની સંખ્યાના છ ગણા કરતાં સાત ઓછી છે. ધારો કે <m:math><m:mi>q</m:mi></m:math> ક્વાર્ટરની સંખ્યા દર્શાવે છે. ડાઇમની સંખ્યા માટે પદાવલી લખો.</para>
</problem>
<solution id="fs-id1984837">
<para id="fs-id2644785">6<emphasis effect="italics">q</emphasis> − 7</para>
</solution>
</exercise>
</note>
<note id="fs-id1171105546797" class="try">
<exercise id="fs-id1816678">
<problem id="fs-id1816680">
<para id="fs-id2567774">લૉરેનના પર્સમાં ડાઇમ અને નિકલ (પાંચ સેન્ટના અમેરિકી સિક્કા) છે. ડાઇમની સંખ્યા નિકલની સંખ્યાના ચાર ગણા કરતાં આઠ વધુ છે. ધારો કે <m:math><m:mrow><m:mi>n</m:mi></m:mrow></m:math> નિકલની સંખ્યા દર્શાવે છે. ડાઇમની સંખ્યા માટે પદાવલી લખો.</para>
</problem>
<solution id="fs-id2389740">
<para id="fs-id2196387">4<emphasis effect="italics">n</emphasis> + 8</para>
</solution>
</exercise>
</note>
<note id="fs-id1860727" class="media-2"><title>વધારાનાં ઑનલાઇન સંસાધનો જુઓ</title><list id="fs-id2362976" display="block"><item><link url="https://openstaxcollege.org/l/24AlgExpvocab">બીજગણિતની પદાવલી માટેના શબ્દો</link></item>
</list></note></section>
<section id="fs-id2202182" class="key-concepts">
<title>મુખ્ય સંકલ્પનાઓ</title>
<list id="fs-id2626380" list-type="bulleted" bullet-style="bullet"><item><emphasis effect="strong">સજાતીય પદો ભેગાં કરો.</emphasis>
<list id="eip-id1168265179478" list-type="enumerated" number-style="arabic" class="stepwise"><item>સજાતીય પદો ઓળખો.</item>
<item>સજાતીય પદો એકસાથે આવે તેમ પદાવલી ફરી ગોઠવો.</item>
<item>સજાતીય પદોના સહગુણકોનો સરવાળો કરો.</item></list></item>
</list></section>
<section id="fs-id1609875" class="section-exercises">
<section id="fs-id1358784" class="practice-perfect">
<title>અભ્યાસથી નિપુણતા</title>
<para id="fs-id2296320"><emphasis effect="bold">બીજગણિતની પદાવલીઓની કિંમત શોધો</emphasis> </para><para id="eip-663">નીચેના અભ્યાસમાં આપેલી કિંમત માટે પદાવલીની કિંમત શોધો.</para><exercise id="fs-id2452980">
<problem id="fs-id2452982">
<para id="fs-id1621672"><m:math><m:mrow><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1684206">
<para id="fs-id1799533">22</para>
</solution>
</exercise>
<exercise id="fs-id1397750">
<problem id="fs-id1397752">
<para id="fs-id2607048"><m:math><m:mrow><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1610688">
<problem id="fs-id1610690">
<para id="fs-id2319943"><m:math><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>6</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id2388625">
<para id="fs-id1511551">26</para>
</solution>
</exercise>
<exercise id="fs-id1967559">
<problem id="fs-id2294101">
<para id="fs-id2294103"><m:math><m:mrow><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2491182">
<problem id="fs-id2491184">
<para id="fs-id1531701"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>12</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id2132092">
<para id="fs-id2620100">144</para>
</solution>
</exercise>
<exercise id="fs-id1231762">
<problem id="fs-id1512091">
<para id="fs-id1512093"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1983279">
<problem id="fs-id1983281">
<para id="fs-id2294335"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>5</m:mn></m:msup><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1932440">
<para id="fs-id2992988">32</para>
</solution>
</exercise>
<exercise id="fs-id2273469">
<problem id="fs-id2465782">
<para id="fs-id2465785"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>4</m:mn></m:msup><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1484724">
<problem id="fs-id1484726">
<para id="fs-id1370529"><m:math><m:mrow><m:msup><m:mn>3</m:mn><m:mi>x</m:mi></m:msup><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id2276376">
<para id="fs-id3228182">27</para>
</solution>
</exercise>
<exercise id="fs-id2161920">
<problem id="fs-id1262585">
<para id="fs-id1262587"><m:math><m:mrow><m:msup><m:mn>4</m:mn><m:mi>x</m:mi></m:msup><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1618320">
<problem id="fs-id1618322">
<para id="fs-id2275594"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>7</m:mn><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1480715">
<para id="fs-id1480717">21</para>
</solution>
</exercise>
<exercise id="fs-id1383279">
<problem id="fs-id1383281">
<para id="fs-id1756616"> <m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>8</m:mn><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>6</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2165554">
<problem id="fs-id2166642">
<para id="fs-id2166644"><m:math><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>y</m:mi><m:mo>−</m:mo><m:mn>5</m:mn><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>7</m:mn><m:mo>,</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id2925221">
<para id="fs-id2925223">41</para>
</solution>
</exercise>
<exercise id="fs-id2451275">
<problem id="fs-id2451277">
<para id="fs-id1578038"><m:math><m:mrow><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>y</m:mi><m:mo>−</m:mo><m:mn>9</m:mn><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2719101">
<problem id="fs-id2719104">
<para id="fs-id1405258"><m:math><m:mrow><m:msup><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow><m:mn>2</m:mn></m:msup><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>10</m:mn><m:mo>,</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1284881">
<para id="fs-id1284883">9</para>
</solution>
</exercise>
<exercise id="fs-id2298171">
<problem id="fs-id2298174">
<para id="fs-id1801683"><m:math><m:mrow><m:msup><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow><m:mn>2</m:mn></m:msup><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1982028">
<para id="fs-id1982030">225</para>
</solution>
</exercise>
<exercise id="fs-id1510944">
<problem id="fs-id1510946">
<para id="fs-id2215799"><m:math><m:mrow><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id2304198">
<para id="fs-id2304200">73</para>
</solution>
</exercise>
<exercise id="fs-id1735447">
<problem id="fs-id1735449">
<para id="fs-id1732685"><m:math><m:mrow><m:msup><m:mi>r</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:msup><m:mi>s</m:mi><m:mn>2</m:mn></m:msup><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>12</m:mn><m:mo>,</m:mo><m:mi>s</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2961545">
<problem id="fs-id1546644">
<para id="fs-id1546646"><m:math><m:mrow><m:mn>2</m:mn><m:mi>l</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>w</m:mi><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>l</m:mi><m:mo>=</m:mo><m:mn>15</m:mn><m:mo>,</m:mo><m:mi>w</m:mi><m:mo>=</m:mo><m:mn>12</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1321633">
<para id="fs-id1321635">54</para>
</solution>
</exercise>
<exercise id="fs-id2662922">
<problem id="fs-id2662924">
<para id="fs-id1562179"><m:math><m:mrow><m:mn>2</m:mn><m:mi>l</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>w</m:mi><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>l</m:mi><m:mo>=</m:mo><m:mn>18</m:mn><m:mo>,</m:mo><m:mi>w</m:mi><m:mo>=</m:mo><m:mn>14</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id1371527"><emphasis effect="bold">પદ, સહગુણક અને સજાતીય પદો ઓળખો</emphasis> </para><para id="eip-413">નીચેના અભ્યાસમાં આપેલી પદાવલીનાં પદોની યાદી બનાવો.</para><exercise id="fs-id1471893">
<problem id="fs-id2481744">
<para id="fs-id2481746"><m:math><m:mrow><m:mn>15</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1738938">
<para id="fs-id1738940">15<emphasis effect="italics">x</emphasis><sup>2</sup>, 6<emphasis effect="italics">x</emphasis>, 2</para>
</solution>
</exercise>
<exercise id="fs-id2628154">
<problem id="fs-id2628156">
<para id="fs-id3013643"><m:math><m:mrow><m:mn>11</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
<para id="fs-id3407666"><newline /></para>
</problem>
</exercise>
<exercise id="fs-id1722869">
<problem id="fs-id1722871">
<para id="fs-id2372762"><m:math><m:mrow><m:mn>10</m:mn><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup><m:mo>+</m:mo><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1828775">
<para id="fs-id1828777">10<emphasis effect="italics">y</emphasis><sup>3</sup>, <emphasis effect="italics">y</emphasis>, 2</para>
</solution>
</exercise>
<exercise id="fs-id2650034">
<problem id="fs-id2650037">
<para id="fs-id1762548"><m:math><m:mrow><m:mn>9</m:mn><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup><m:mo>+</m:mo><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id1213539">નીચેના અભ્યાસમાં આપેલા પદનો સહગુણક ઓળખો.</para>
<exercise id="fs-id1459626">
<problem id="fs-id1459628">
<para id="fs-id2486053"><m:math><m:mrow><m:mn>8</m:mn><m:mi>a</m:mi></m:mrow></m:math></para>
</problem>
<solution id="fs-id2219219">
<para id="fs-id1859580">8</para>
</solution>
</exercise>
<exercise id="fs-id2758784">
<problem id="fs-id2758787">
<para id="fs-id2849921"><m:math><m:mrow><m:mn>13</m:mn><m:mi>m</m:mi></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2924560">
<problem id="fs-id2202288">
<para id="fs-id2202290"><m:math><m:mrow><m:mn>5</m:mn><m:msup><m:mi>r</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
</problem>
<solution id="fs-id1613753">
<para id="fs-id1335935">5</para>
</solution>
</exercise>
<exercise id="fs-id2330814">
<problem id="fs-id2433778">
<para id="fs-id2433780"><m:math><m:mrow><m:mn>6</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id1515917">નીચેના અભ્યાસમાં સજાતીય પદોનાં બધાં જૂથ ઓળખો.</para>
<exercise id="fs-id1693521">
<problem id="fs-id2601375">
<para id="fs-id2601377"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mo>,</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>,</m:mo><m:mn>14</m:mn><m:mo>,</m:mo><m:mn>8</m:mn><m:mi>y</m:mi><m:mo>,</m:mo><m:mn>5</m:mn><m:mo>,</m:mo><m:mn>8</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math></para>
</problem>
<solution id="fs-id1364661">
<para id="fs-id1364663"><emphasis effect="italics">x</emphasis><sup>3</sup> અને 8<emphasis effect="italics">x</emphasis><sup>3</sup>; 14 અને 5</para>
</solution>
</exercise>
<exercise id="fs-id1461709">
<problem id="fs-id1547955">
<para id="fs-id1547957"><m:math><m:mrow><m:mn>6</m:mn><m:mi>z</m:mi><m:mo>,</m:mo><m:mn>3</m:mn><m:msup><m:mi>w</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mn>6</m:mn><m:msup><m:mi>z</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>4</m:mn><m:mi>z</m:mi><m:mo>,</m:mo><m:msup><m:mi>w</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2269831">
<problem id="fs-id2269833">
<para id="fs-id1547187"><m:math><m:mrow><m:mn>9</m:mn><m:mi>a</m:mi><m:mo>,</m:mo><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>16</m:mn><m:mi>a</m:mi><m:mi>b</m:mi><m:mo>,</m:mo><m:mn>16</m:mn><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>4</m:mn><m:mi>a</m:mi><m:mi>b</m:mi><m:mo>,</m:mo><m:mn>9</m:mn><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
</problem>
<solution id="fs-id2316095">
<para id="fs-id2316097">16<emphasis effect="italics">ab</emphasis> અને 4<emphasis effect="italics">ab</emphasis>; 16<emphasis effect="italics">b</emphasis><sup>2</sup> અને 9<emphasis effect="italics">b</emphasis><sup>2</sup></para>
</solution>
</exercise>
<exercise id="fs-id1510726">
<problem id="fs-id1395153">
<para id="fs-id1395156"><m:math><m:mrow><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>25</m:mn><m:msup><m:mi>r</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>10</m:mn><m:mi>s</m:mi><m:mo>,</m:mo><m:mn>10</m:mn><m:mi>r</m:mi><m:mo>,</m:mo><m:mn>4</m:mn><m:msup><m:mi>r</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>3</m:mn><m:mi>s</m:mi></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id2665538"><emphasis effect="bold">સજાતીય પદો ભેગાં કરીને પદાવલીઓ સરળ કરો</emphasis> </para><para id="eip-441">નીચેના અભ્યાસમાં સજાતીય પદો ભેગાં કરીને આપેલી પદાવલી સરળ કરો.</para><exercise id="fs-id2265620">
<problem id="fs-id2265623">
<para id="fs-id1339836"><m:math><m:mrow><m:mn>10</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math></para>
</problem>
<solution id="fs-id1609220">
<para id="fs-id2876678">13<emphasis effect="italics">x</emphasis></para>
</solution>
</exercise>
<exercise id="fs-id2630614">
<problem id="fs-id2630616">
<para id="fs-id2202282"><m:math><m:mrow><m:mn>15</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>x</m:mi></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1951243">
<problem id="fs-id1951245">
<para id="fs-id1257165"><m:math><m:mrow><m:mn>17</m:mn><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>9</m:mn><m:mi>a</m:mi></m:mrow></m:math></para>
</problem>
<solution id="fs-id2221895">
<para id="fs-id2221897">26<emphasis effect="italics">a</emphasis></para>
</solution>
</exercise>
<exercise id="fs-id2748396">
<problem id="fs-id1569776">
<para id="fs-id1569778"><m:math><m:mrow><m:mn>18</m:mn><m:mi>z</m:mi><m:mo>+</m:mo><m:mn>9</m:mn><m:mi>z</m:mi></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2777870">
<problem id="fs-id2256376">
<para id="fs-id2256378"><m:math><m:mrow><m:mn>4</m:mn><m:mi>c</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>c</m:mi><m:mo>+</m:mo><m:mi>c</m:mi></m:mrow></m:math></para>
</problem>
<solution id="fs-id1548404">
<para id="fs-id1548407">7<emphasis effect="italics">c</emphasis></para>
</solution>
</exercise>
<exercise id="fs-id2619852">
<problem id="fs-id2691776">
<para id="fs-id2691779"><m:math><m:mrow><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mi>y</m:mi></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2207889">
<problem id="fs-id1549877">
<para id="fs-id1549879"><m:math><m:mrow><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id2334132">
<para id="fs-id2455432">12<emphasis effect="italics">x</emphasis> + 8</para>
</solution>
</exercise>
<exercise id="fs-id1395665">
<problem id="fs-id1395667">
<para id="fs-id2466253"><m:math><m:mrow><m:mn>8</m:mn><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1787268">
<problem id="fs-id1787270">
<para id="fs-id2498318"><m:math><m:mrow><m:mn>7</m:mn><m:mi>u</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>u</m:mi><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1755026">
<para id="fs-id1755028">10<emphasis effect="italics">u</emphasis> + 3</para>
</solution>
</exercise>
<exercise id="fs-id1208549">
<problem id="fs-id1895014">
<para id="fs-id1895016"><m:math><m:mrow><m:mn>8</m:mn><m:mi>d</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>d</m:mi><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2214125">
<problem id="fs-id1841950">
<para id="fs-id1841952"><m:math><m:mrow><m:mn>7</m:mn><m:mi>p</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>p</m:mi><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id2671572">
<para id="fs-id1969342">12<emphasis effect="italics">p</emphasis> + 10</para>
</solution>
</exercise>
<exercise id="fs-id1569901">
<problem id="fs-id1569904">
<para id="fs-id2139128"><m:math><m:mrow><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2662762">
<problem id="fs-id2662764">
<para id="fs-id2630781"><m:math><m:mrow><m:mn>10</m:mn><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>a</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>a</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
<para id="fs-id1805537"><newline /></para>
</problem>
<solution id="fs-id2595037">
<para id="fs-id1406246">22<emphasis effect="italics">a</emphasis> + 1</para>
</solution>
</exercise>
<exercise id="fs-id1949302">
<problem id="fs-id1949304">
<para id="fs-id2199141"><m:math><m:mrow><m:mn>7</m:mn><m:mi>c</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>c</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>9</m:mn><m:mi>c</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2443073">
<problem id="fs-id1906528">
<para id="fs-id1906530"><m:math><m:mrow><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>12</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>11</m:mn><m:mo>+</m:mo><m:mn>14</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1823082">
<para id="fs-id1823084">17<emphasis effect="italics">x</emphasis><sup>2</sup> + 20<emphasis effect="italics">x</emphasis> + 16</para>
</solution>
</exercise>
<exercise id="fs-id1805488">
<problem id="fs-id1805490">
<para id="fs-id2649294"><m:math><m:mrow><m:mn>5</m:mn><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>9</m:mn><m:mi>b</m:mi><m:mo>+</m:mo><m:mn>10</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>b</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id1570837"><emphasis effect="bold">અંગ્રેજી શબ્દસમૂહોને બીજગણિતની પદાવલીઓમાં ફેરવો</emphasis> </para><para id="eip-583">નીચેના અભ્યાસમાં આપેલા શબ્દસમૂહને બીજગણિતની પદાવલીમાં ફેરવો.</para><exercise id="fs-id1376085">
<problem id="fs-id1376087">
<para id="fs-id2565045">આ સંખ્યાઓનો સરવાળો: 8 અને 12</para>
</problem>
<solution id="fs-id1739312">
<para id="fs-id1739314">8 + 12</para>
</solution>
</exercise>
<exercise id="fs-id2270947">
<problem id="fs-id2270949">
<para id="fs-id3294284">આ સંખ્યાઓનો સરવાળો: 9 અને 1</para>
</problem>
</exercise>
<exercise id="fs-id1935473">
<problem id="fs-id1935475">
<para id="fs-id2150798">આ સંખ્યાઓનો તફાવત: 14 અને 9</para>
</problem>
<solution id="fs-id2319381">
<para id="fs-id2319383">14 − 9</para>
</solution>
</exercise>
<exercise id="fs-id1966749">
<problem id="fs-id1966751">
<para id="fs-id2269891">8 જેટલો ઘટાડો, મૂળ સંખ્યા 19</para>
</problem>
</exercise>
<exercise id="fs-id2777756">
<problem id="fs-id2777758">
<para id="fs-id2392528">આ સંખ્યાઓનું ગુણનફળ: 9 અને 7</para>
</problem>
<solution id="fs-id2201054">
<para id="fs-id2201056">9 ⋅ 7</para>
</solution>
</exercise>
<exercise id="fs-id1580955">
<problem id="fs-id1580957">
<para id="fs-id1836366">આ સંખ્યાઓનું ગુણનફળ: 8 અને 7</para>
</problem>
</exercise>
<exercise id="fs-id1966910">
<problem id="fs-id1966912">
<para id="fs-id1579975">આ સંખ્યાઓનું ભાગફળ: 36 અને 9</para>
</problem>
<solution id="fs-id1517428">
<para id="fs-id1517430">36 ÷ 9</para>
</solution>
</exercise>
<exercise id="fs-id2141043">
<problem id="fs-id2141045">
<para id="fs-id588405">આ સંખ્યાઓનું ભાગફળ: 42 અને 7</para>
</problem>
</exercise>
<exercise id="fs-id1408808">
<problem id="fs-id1408810">
<para id="fs-id1798348">આ સંખ્યાઓનો તફાવત: <m:math><m:mrow><m:mi>x</m:mi></m:mrow></m:math> અને <m:math><m:mrow><m:mn>4</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1484887">
<para id="fs-id2173361"><emphasis effect="italics">x</emphasis> − 4</para>
</solution>
</exercise>
<exercise id="fs-id1362985">
<problem id="fs-id1362987">
<para id="fs-id4134513"><m:math><m:mrow><m:mn>3</m:mn></m:mrow></m:math> જેટલો ઘટાડો આ સંખ્યામાં: <m:math><m:mi>x</m:mi></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1605936">
<problem id="fs-id1605938">
<para id="fs-id2150125">આ સંખ્યાઓનું ગુણનફળ: <m:math><m:mrow><m:mn>6</m:mn></m:mrow></m:math> અને <m:math><m:mi>y</m:mi></m:math></para>
</problem>
<solution id="fs-id1724439">
<para id="fs-id1724442">6<emphasis effect="italics">y</emphasis></para>
</solution>
</exercise>
<exercise id="fs-id1578718">
<problem id="fs-id3400837">
<para id="fs-id3400839">આ સંખ્યાઓનું ગુણનફળ: <m:math><m:mrow><m:mn>9</m:mn></m:mrow></m:math> અને <m:math><m:mi>y</m:mi></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1407244">
<problem id="fs-id1337139">
<para id="fs-id1337141">આ સંખ્યાઓનો સરવાળો: <m:math><m:mrow><m:mn>8</m:mn><m:mi>x</m:mi></m:mrow></m:math> અને <m:math><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math></para>
</problem>
<solution id="fs-id2202747">
<para id="fs-id2202749">8<emphasis effect="italics">x</emphasis> + 3<emphasis effect="italics">x</emphasis></para>
</solution>
</exercise>
<exercise id="fs-id1515552">
<problem id="fs-id1612801">
<para id="fs-id1612803">આ સંખ્યાઓનો સરવાળો: <m:math><m:mrow><m:mn>13</m:mn><m:mi>x</m:mi></m:mrow></m:math> અને <m:math><m:mrow><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2202614">
<problem id="fs-id2202617">
<para id="fs-id2273252">આ સંખ્યાઓનું ભાગફળ: <m:math><m:mrow><m:mi>y</m:mi></m:mrow></m:math> અને <m:math><m:mrow><m:mn>3</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1728104">
<para id="fs-id1728106"><emphasis effect="italics">y</emphasis> ÷ 3</para>
</solution>
</exercise>
<exercise id="fs-id1517421">
<problem id="fs-id2165454">
<para id="fs-id2165456">આ સંખ્યાઓનું ભાગફળ: <m:math><m:mrow><m:mi>y</m:mi></m:mrow></m:math> અને <m:math><m:mrow><m:mn>8</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2643011">
<problem id="fs-id2643013">
<para id="fs-id1988044">આ સંખ્યાઓના તફાવતના આઠ ગણા: <m:math><m:mrow><m:mi>y</m:mi></m:mrow></m:math> અને નવ</para>
</problem>
<solution id="fs-id1841608">
<para id="fs-id1841610">8 (<emphasis effect="italics">y</emphasis> − 9)</para>
</solution>
</exercise>
<exercise id="fs-id1232705">
<problem id="fs-id1232707">
<para id="fs-id2817018">આ સંખ્યાઓના તફાવતના સાત ગણા: <m:math><m:mrow><m:mi>y</m:mi></m:mrow></m:math> અને એક</para>
</problem>
</exercise>
<exercise id="fs-id2370308">
<problem id="fs-id1568962">
<para id="fs-id1568964">આ સંખ્યાઓના સરવાળાના પાંચ ગણા: <m:math><m:mrow><m:mi>x</m:mi></m:mrow></m:math> અને <m:math><m:mrow><m:mi>y</m:mi></m:mrow></m:math></para>
</problem>
<solution id="fs-id2496668">
<para id="fs-id1892566">5 (<emphasis effect="italics">x</emphasis> + <emphasis effect="italics">y</emphasis>)</para>
</solution>
</exercise>
<exercise id="fs-id1311964">
<problem id="fs-id3447411">
<para id="fs-id3447413">આ ચલના બમણામાંથી પાંચ બાદ કરો અને પરિણામને નવ વડે ગુણો: <m:math><m:mrow><m:mi>x</m:mi></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id1334823">નીચેના અભ્યાસમાં બીજગણિતની પદાવલી લખો.</para>
<exercise id="fs-id2391056">
<problem id="fs-id2657818">
<para id="fs-id2657820">ઍડેલે સ્કર્ટ અને બ્લાઉઝ ખરીદ્યાં. બ્લાઉઝની કિંમતની સરખામણીમાં સ્કર્ટની કિંમતમાં <m:math><m:mrow><m:mtext>$15</m:mtext></m:mrow></m:math> નો વધારો હતો. ધારો કે <m:math><m:mrow><m:mi>b</m:mi></m:mrow></m:math> બ્લાઉઝની કિંમત દર્શાવે છે. સ્કર્ટની કિંમત માટે પદાવલી લખો.</para>
</problem>
<solution id="fs-id1800483">
<para id="fs-id1800486"><emphasis effect="italics">b</emphasis> + 15</para>
</solution>
</exercise>
<exercise id="fs-id783772">
<problem id="fs-id783774">
<para id="fs-id2139781">એરિકની કારમાં રૉક અને શાસ્ત્રીય સંગીતની સીડી છે. શાસ્ત્રીય સંગીતની સીડીની સંખ્યાની સરખામણીમાં રૉક સંગીતની સીડીની સંખ્યામાં <m:math><m:mrow><m:mn>3</m:mn></m:mrow></m:math> નો વધારો છે. ધારો કે <m:math><m:mrow><m:mi>c</m:mi></m:mrow></m:math> શાસ્ત્રીય સંગીતની સીડીની સંખ્યા દર્શાવે છે. રૉક સંગીતની સીડીની સંખ્યા માટે પદાવલી લખો.</para>
</problem>
</exercise>
<exercise id="fs-id2287979">
<problem id="fs-id2287981">
<para id="fs-id1465341">બીજા ધોરણના વર્ગમાં છોકરાઓની સંખ્યાની સરખામણીમાં છોકરીઓની સંખ્યામાં <m:math><m:mrow><m:mn>4</m:mn></m:mrow></m:math> નો ઘટાડો છે. ધારો કે <m:math><m:mrow><m:mi>b</m:mi></m:mrow></m:math> છોકરાઓની સંખ્યા દર્શાવે છે. છોકરીઓની સંખ્યા માટે પદાવલી લખો.</para>
</problem>
<solution id="fs-id1606964">
<para id="fs-id2820291"><emphasis effect="italics">b</emphasis> − 4</para>
</solution>
</exercise>
<exercise id="fs-id1398189">
<problem id="fs-id1760826">
<para id="fs-id1760828">માર્સેલાના કાકા, મામા, માસી કે ફોઈની દીકરીઓની સરખામણીમાં તેમના દીકરાઓની સંખ્યામાં <m:math><m:mrow><m:mn>6</m:mn></m:mrow></m:math> નો ઘટાડો છે. ધારો કે <m:math><m:mi>f</m:mi></m:math> આ બહેનોની સંખ્યા દર્શાવે છે. આ ભાઈઓની સંખ્યા માટે પદાવલી લખો.</para>
</problem>
</exercise>
<exercise id="fs-id3292991">
<problem id="fs-id3292993">
<para id="fs-id2431570">ગ્રેગના ખિસ્સામાં નિકલ અને પેની (એક સેન્ટના અમેરિકી સિક્કા) છે. પેનીની સંખ્યા નિકલની સંખ્યાના બમણા કરતાં સાત ઓછી છે. ધારો કે <m:math><m:mrow><m:mi>n</m:mi></m:mrow></m:math> નિકલની સંખ્યા દર્શાવે છે. પેનીની સંખ્યા માટે પદાવલી લખો.</para>
</problem>
<solution id="fs-id1386869">
<para id="fs-id1386871">2<emphasis effect="italics">n</emphasis> − 7</para>
</solution>
</exercise>
<exercise id="fs-id4344323">
<problem id="fs-id4344325">
<para id="fs-id1321698">જૅનેટના પાકીટમાં <m:math><m:mrow><m:mtext>$5</m:mtext></m:mrow></m:math> અને <m:math><m:mrow><m:mtext>$10</m:mtext></m:mrow></m:math> ની નોટો છે. પાંચ ડૉલરની નોટોની સંખ્યા દસ ડૉલરની નોટોની સંખ્યાના છ ગણા કરતાં ત્રણ વધુ છે. ધારો કે <m:math><m:mrow><m:mi>t</m:mi></m:mrow></m:math> દસ ડૉલરની નોટોની સંખ્યા દર્શાવે છે. પાંચ ડૉલરની નોટોની સંખ્યા માટે પદાવલી લખો.</para>
</problem>
</exercise>
</section>
<section id="fs-id2142270" class="everyday">
<title>રોજિંદા જીવનમાં ગણિત</title>
<para id="fs-id1487340">નીચેના અભ્યાસમાં પ્રશ્ન ઉકેલવા બીજગણિતની પદાવલીઓ વાપરો.</para>
<exercise id="fs-id2758209">
<problem id="fs-id2758211">
<para id="fs-id2758213"><emphasis effect="bold">કારનો વીમો</emphasis> જસ્ટિનના કારના વીમામાં દરેક ઘટના દીઠ તેણે પોતે ચૂકવવાની રકમ <m:math><m:mrow><m:mtext>$750</m:mtext></m:mrow></m:math> છે. એટલે તે ચૂકવે <m:math><m:mrow><m:mtext>$750</m:mtext></m:mrow></m:math> અને તેની વીમા કંપની આ રકમથી વધુનો બધો ખર્ચ ચૂકવે: <m:math><m:mrow><m:mtext>$750.</m:mtext></m:mrow></m:math> જસ્ટિન આટલી રકમનો દાવો કરે: <m:math><m:mrow><m:mtext>$2,100,</m:mtext></m:mrow></m:math> તો તે કેટલું ચૂકવશે અને તેની વીમા કંપની કેટલું ચૂકવશે?</para>
</problem>
<solution id="fs-id2132064">
<para id="fs-id2132066">તે $750 ચૂકવશે. તેની વીમા કંપની $1350 ચૂકવશે.</para>
</solution>
</exercise>
<exercise id="fs-id1467443">
<problem id="fs-id2216310">
<para id="fs-id2216312"><emphasis effect="bold">ઘરનો વીમો</emphasis> પૅમ અને આર્માન્ડોના ઘરના વીમામાં દરેક ઘટના દીઠ તેમણે પોતે ચૂકવવાની રકમ <m:math><m:mrow><m:mtext>$2,500</m:mtext></m:mrow></m:math> છે. એટલે તેઓ ચૂકવે <m:math><m:mrow><m:mtext>$2,500</m:mtext></m:mrow></m:math> અને તેમની વીમા કંપની આ રકમથી વધુનો બધો ખર્ચ ચૂકવે: <m:math><m:mrow><m:mtext>$2,500.</m:mtext></m:mrow></m:math> પૅમ અને આર્માન્ડો આટલી રકમનો દાવો કરે: <m:math><m:mrow><m:mtext>$19,400,</m:mtext></m:mrow></m:math> તો તેઓ કેટલું ચૂકવશે અને તેમની વીમા કંપની કેટલું ચૂકવશે?</para>
</problem>
</exercise>
</section>
<section id="fs-id1215436" class="writing">
<title>લેખન અભ્યાસ</title>
<exercise id="fs-id1880697">
<problem id="fs-id1880699">
<para id="fs-id2748406">શા માટે આ સંખ્યાઓનો સરવાળો: <emphasis effect="italics">x</emphasis> અને <emphasis effect="italics">y</emphasis> આ સંખ્યાઓના સરવાળા જેટલો જ છે: <emphasis effect="italics">y</emphasis> અને <emphasis effect="italics">x</emphasis> પણ આ સંખ્યાઓનો તફાવત: <emphasis effect="italics">x</emphasis> અને <emphasis effect="italics">y</emphasis> આ સંખ્યાઓના તફાવત જેટલો નથી: <emphasis effect="italics">y</emphasis> અને <emphasis effect="italics">x</emphasis> તે સમજાવો. સમજાવવામાં મદદ માટે આ ચલોની જગ્યાએ કોઈ પણ બે સંખ્યા મૂકવાનો પ્રયત્ન કરો: <m:math><m:mrow><m:mi>x</m:mi></m:mrow></m:math> અને <m:math><m:mrow><m:mi>y</m:mi></m:mrow></m:math> .</para></problem>
</exercise>
<exercise id="fs-id1461737">
<problem id="fs-id1378403">
<para id="fs-id1378405">આ બે શબ્દસમૂહનો તફાવત સમજાવો: <m:math><m:mrow><m:mtext>“4</m:mtext></m:mrow></m:math> ગણો સરવાળો આ સંખ્યાઓનો: <m:math><m:mrow><m:mi>x</m:mi></m:mrow></m:math> અને <m:math><m:mrow><m:mi>y</m:mi><m:mtext>”</m:mtext></m:mrow></m:math> તથા આ રાશિઓનો સરવાળો: <m:math><m:mrow><m:mn>4</m:mn></m:mrow></m:math> ગુણ્યા <m:math><m:mrow><m:mi>x</m:mi></m:mrow></m:math> અને <m:math><m:mrow><m:mi>y</m:mi><m:mtext>.”</m:mtext></m:mrow></m:math></para>
</problem>
</exercise></section><section id="eip-929" class="self-check"><title>સ્વમૂલ્યાંકન</title><para id="eip-id1168467158224"><span class="token">ⓐ</span> અભ્યાસ પૂરો કર્યા પછી આ વિભાગના હેતુઓ કેટલા સાધ્યા છે તે તપાસવા આ યાદી વાપરો.
</para>


<para id="eip-437"><figure id="eip-id1165721410744" class="unnumbered"><label /><media id="eip-id1165721410747" alt="બીજગણિતની કુશળતા અંગે સ્વમૂલ્યાંકનનું કોષ્ટક. સ્તંભનાં નામ છે: હું આ કરી શકું છું…, વિશ્વાસપૂર્વક, થોડી મદદથી અને ના—મને સમજાતું નથી! કુશળતામાં પદાવલીની કિંમત શોધવી, પદો ઓળખવાં, સરળ કરવું અને શબ્દસમૂહોને પદાવલીમાં ફેરવવાં સામેલ છે."><image mime-type="image/jpg" src="../../media/CNX_BMath_Figure_AppB_008.jpg" /></media></figure></para><para id="eip-id1168466075811"><span class="token">ⓑ</span> આ યાદી તપાસ્યા પછી બધા હેતુઓ અંગે વિશ્વાસ મેળવવા તમે શું કરશો?
</para></section>
</section>
</content>
<glossary>
<definition id="fs-id1503046">
<term>પદ</term>
<meaning id="fs-id1891510">પદ કોઈ અચળ અથવા અચળ અને એક કે વધુ ચલનું ગુણનફળ છે.</meaning>
</definition>
<definition id="fs-id2662318">
<term>સહગુણક</term>
<meaning id="fs-id1301322">પદમાં જે અચળનો ચલ કે ચલો સાથે ગુણાકાર થાય છે તેને સહગુણક કહે છે.</meaning>
</definition>
<definition id="fs-id2961409">
<term>સજાતીય પદો</term>
<meaning id="fs-id1294455">અચળ પદો અથવા સરખા ચલ અને તેમના સરખા ઘાતાંક ધરાવતાં પદો સજાતીય પદો છે.</meaning>
</definition>
<definition id="fs-id1549920">
<term>કિંમત શોધવી</term>
<meaning id="fs-id1753163">બીજગણિતની પદાવલીની કિંમત શોધવી એટલે ચલની જગ્યાએ આપેલી સંખ્યા મૂક્યા પછી પદાવલીની કિંમત શોધવી.</meaning>
</definition>
</glossary>
</document>