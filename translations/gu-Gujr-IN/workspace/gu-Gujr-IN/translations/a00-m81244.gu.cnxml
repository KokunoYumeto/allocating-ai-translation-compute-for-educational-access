<?xml version='1.0' encoding='utf-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" xmlns:md="http://cnx.rice.edu/mdml" xml:lang="gu-Gujr-IN">
<title>પૂર્ણ સંખ્યાઓનો સરવાળો કરો</title>
<metadata>
  <md:content-id>m81244</md:content-id>
  <md:title>પૂર્ણ સંખ્યાઓનો સરવાળો કરો</md:title>
  <md:abstract><para id="para-00001">આ વિભાગના અંતે તમે:</para><list id="list-00001">
<item>સરવાળાની લખાવટનો ઉપયોગ કરી શકશો.</item>
<item>પૂર્ણ સંખ્યાઓનો સરવાળો નમૂના દ્વારા દર્શાવી શકશો.</item>
<item>નમૂના વિના પૂર્ણ સંખ્યાઓનો સરવાળો કરી શકશો.</item>
<item>શબ્દોમાં આપેલી વાતને ગણિતની લખાવટમાં ફેરવી શકશો.</item>
<item>વ્યવહારુ પ્રશ્નોમાં પૂર્ણ સંખ્યાઓનો સરવાળો કરી શકશો.</item>
</list></md:abstract>
  <md:uuid>8069044b-6fb1-49bf-b03a-64988f9b1ddd</md:uuid>
</metadata>

<content>
<note id="fs-id2299412" class="be-prepared">
<para id="fs-id2646470">શરૂઆત કરતાં પહેલાં તૈયારી તપાસવાના આ પ્રશ્નો ઉકેલો.</para>
<exercise id="fs-idm207409024">
<problem id="fs-idm215457168">
<para id="fs-idm214637312">આ <m:math><m:mrow><m:mtext>આધાર-10</m:mtext></m:mrow></m:math> ના ખંડોથી કઈ સંખ્યા દર્શાવેલી છે?<newline />
<media id="fs-id2778433" alt="ચિત્રમાં ત્રણ પ્રકારના ભાગ છે. પહેલા ભાગમાં બે ચોરસ છે; દરેકમાં 100 ખંડ છે, 10 ખંડ પહોળાઈમાં અને 10 ખંડ ઊંચાઈમાં. બીજા ભાગમાં 10 ખંડ ધરાવતી એક આડી સળી છે. ત્રીજા ભાગમાં 5 અલગ ખંડ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_02_001_img.jpg" />
</media><newline />
જો આ પ્રશ્નમાં ભૂલ થઈ હોય, તો ફરી જુઓ: <link target-id="fs-id2222880" document="m81243" />.</para>
</problem>
<solution id="fs-idm219309424">
<para id="fs-idm216142416"><m:math><m:mrow><m:mn>215</m:mn></m:mrow></m:math></para>
</solution>
</exercise></note>
<note id="fs-id1122444" class="be-prepared">
<exercise id="fs-idm218505136">
<problem id="fs-idm221149472">
<para id="fs-idm218825920">ત્રણસો બેતાલીસ હજાર છ સંખ્યાને અંકોમાં લખો.<newline />
જો આ પ્રશ્નમાં ભૂલ થઈ હોય, તો ફરી જુઓ: <link target-id="fs-id3202693" document="m81243" />.</para>
</problem>
<solution id="fs-idm207579776">
<para id="fs-idm221421664"><m:math><m:mrow><m:mn>342</m:mn><m:mo>,</m:mo><m:mn>006</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<section id="fs-id2601285">
<title>સરવાળાની લખાવટનો ઉપયોગ કરો</title>
<para id="fs-id3165690">કૉલેજનો એક વિદ્યાર્થી અંશકાલીન નોકરી કરે છે. ગયા અઠવાડિયે તેણે સોમવારે <m:math><m:mn>3</m:mn></m:math> કલાક અને શુક્રવારે <m:math><m:mn>4</m:mn></m:math> કલાક કામ કર્યું. ગયા અઠવાડિયે તેણે કુલ કેટલા કલાક કામ કર્યું તે જાણવા તેણે ઉમેર્યા: <m:math><m:mn>3</m:mn></m:math> અને <m:math><m:mrow><m:mn>4</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id2606793">સંખ્યાઓને ભેગી કરવાની ક્રિયાથી મળતા પરિણામને <term id="term-00001">સરવાળો</term> કહે છે. સંખ્યાઓ <m:math><m:mn>3</m:mn></m:math> અને <m:math><m:mn>4</m:mn></m:math> નો સરવાળો આ રીતે લખીએ:</para>
<equation id="fs-id1474530" class="unnumbered"><label /><m:math><m:mrow><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math></equation>
<para id="fs-id2619407">આને આપણે <emphasis effect="italics">ત્રણ વત્તા ચાર</emphasis> વાંચીએ છીએ અને તેનું પરિણામ ત્રણ અને ચારનો સરવાળો છે. સંખ્યાઓ <m:math><m:mn>3</m:mn></m:math> અને <m:math><m:mn>4</m:mn></m:math> ને ઉમેરવાની સંખ્યાઓ કહે છે. સંખ્યાઓ અને ક્રિયાઓ ધરાવતા ગાણિતિક નિવેદનને પદાવલી કહે છે.</para><note id="fs-id1282344">
<title>સરવાળાની લખાવટ</title>
<para id="fs-id1966740">સરવાળો દર્શાવવા આપણે પ્રતીકો અને શબ્દો વાપરી શકીએ છીએ.</para>
<table id="fs-id2711498" class="unnumbered" aria-label="બે હરોળ અને પાંચ સ્તંભનું કોષ્ટક. ઉપરની હરોળ શીર્ષકની છે. ડાબેથી જમણે સ્તંભનાં નામ છે: ક્રિયા, લખાવટ, પદાવલીઓ, આ રીતે વાંચો અને પરિણામ. બીજી હરોળમાં ડાબેથી જમણે સરવાળો, વત્તાનું ચિહ્ન, પદાવલી 3 વત્તા ચાર, શબ્દોમાં ત્રણ વત્તા ચાર અને આ સંખ્યાઓનો સરવાળો છે: 3 અને 4.">
<label />
<tgroup cols="5">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<colspec colnum="3" colname="c3" />
<colspec colnum="4" colname="c4" />
<colspec colnum="5" colname="c5" />
<thead>
<row valign="top">
<entry align="left">ક્રિયા</entry>
<entry align="left">લખાવટ</entry>
<entry align="left">પદાવલી</entry>
<entry align="left">આ રીતે વાંચો</entry>
<entry align="left">પરિણામ</entry>
</row>
</thead>
<tbody>
<row valign="top">
<entry align="left">સરવાળો</entry>
<entry align="left"><m:math><m:mrow><m:mo>+</m:mo></m:mrow></m:math></entry>
<entry align="left"><m:math><m:mrow><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math></entry>
<entry align="left">ત્રણ વત્તા ચાર</entry>
<entry align="left">આ સંખ્યાઓનો સરવાળો: <m:math><m:mn>3</m:mn></m:math> અને <m:math><m:mn>4</m:mn></m:math></entry>
</row>
</tbody>
</tgroup>
</table>
</note>
<example id="fs-id1519902">
<exercise id="fs-id2294573"><problem id="fs-id1330068">
<para id="fs-id2703725">ગણિતની લખાવટને શબ્દોમાં ફેરવો:<list id="eip-id1168287109262" list-type="enumerated" class="circled" number-style="arabic"><item><span class="token">ⓐ</span> <m:math><m:mn>7</m:mn><m:mo>+</m:mo><m:mn>1</m:mn></m:math></item><item><span class="token">ⓑ</span> <m:math><m:mn>12</m:mn><m:mo>+</m:mo><m:mn>14</m:mn></m:math></item></list></para></problem>
<solution id="fs-id2294519">
<title>ઉકેલ</title><list id="eip-id1168287334447" list-type="labeled-item" class="circled"><item><span class="token">ⓐ</span> આ પદાવલીમાં ઉમેરવાની સંખ્યાઓ 7 અને 1ને વત્તાનું ચિહ્ન જોડે છે. તેને આપણે <emphasis effect="italics">સાત વત્તા એક</emphasis>વાંચીએ છીએ. પરિણામ છે <emphasis effect="italics">સાત અને એકનો સરવાળો</emphasis>.</item>
<item><span class="token">ⓑ</span> આ પદાવલીમાં ઉમેરવાની સંખ્યાઓ 12 અને 14ને વત્તાનું ચિહ્ન જોડે છે. તેને આપણે <emphasis effect="italics">બાર વત્તા ચૌદ</emphasis>વાંચીએ છીએ. પરિણામ છે <emphasis effect="italics">બાર અને ચૌદનો સરવાળો</emphasis>.</item></list></solution>
</exercise></example>
<note id="fs-id2202625" class="try">
<exercise id="fs-id1386428"><problem id="fs-id2842881">
<para id="fs-id1549906">ગણિતની લખાવટને શબ્દોમાં ફેરવો:</para>
<list id="eip-id1168289469583" list-type="enumerated" class="circled" number-style="arabic"><item><span class="token">ⓐ</span> <m:math><m:mn>8</m:mn><m:mo>+</m:mo><m:mn>4</m:mn></m:math></item><item><span class="token">ⓑ</span> <m:math><m:mn>18</m:mn><m:mo>+</m:mo><m:mn>11</m:mn></m:math></item></list></problem>
<solution id="fs-id1948344"><list id="eip-id1168288479736" list-type="labeled-item"><item><span class="token">ⓐ</span> આઠ વત્તા ચાર; આઠ અને ચારનો સરવાળો</item><item><span class="token">ⓑ</span> અઢાર વત્તા અગિયાર; અઢાર અને અગિયારનો સરવાળો</item></list></solution>
</exercise></note>
<note id="fs-id2216255" class="try">
<exercise id="fs-id2334163"><problem id="fs-id1525211">
<para id="fs-id1630183">ગણિતની લખાવટને શબ્દોમાં ફેરવો:</para>
<list id="eip-id1168289631763" list-type="enumerated" class="circled" number-style="arabic"><item><span class="token">ⓐ</span> <m:math><m:mn>21</m:mn><m:mo>+</m:mo><m:mn>16</m:mn></m:math></item><item><span class="token">ⓑ</span> <m:math><m:mn>100</m:mn><m:mo>+</m:mo><m:mn>200</m:mn></m:math></item></list></problem>
<solution id="fs-id1577525"><list id="eip-id1168288338262" list-type="enumerated" class="circled" number-style="arabic"><item><span class="token">ⓐ</span> એકવીસ વત્તા સોળ; એકવીસ અને સોળનો સરવાળો</item><item><span class="token">ⓑ</span> એકસો વત્તા બસો; એકસો અને બસોનો સરવાળો</item></list></solution>
</exercise></note>
</section>
<section id="fs-id2145437"><title>પૂર્ણ સંખ્યાઓનો સરવાળો નમૂના દ્વારા દર્શાવો</title><para id="fs-id1484984">સરવાળો એ હકીકતમાં ગણતરી જ છે. આપણે <m:math><m:mrow><m:mtext>આધાર-10</m:mtext></m:mrow></m:math> ના ખંડોથી સરવાળો દર્શાવીશું. યાદ રાખો, એક ખંડ દર્શાવે છે <m:math><m:mrow><m:mn>1</m:mn></m:mrow></m:math> અને એક સળી દર્શાવે છે <m:math><m:mrow><m:mn>10</m:mn><m:mo>.</m:mo></m:mrow></m:math> હમણાં જોયેલી સરવાળાની આ પદાવલીનો નમૂનો બનાવીને શરૂઆત કરીએ: <m:math><m:mrow><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id1567091">ઉમેરવાની દરેક સંખ્યા <m:math><m:mrow><m:mn>10</m:mn><m:mo>,</m:mo></m:mrow></m:math> કરતાં નાની છે, તેથી એકમના ખંડો વાપરી શકીએ છીએ.</para>
<table id="eip-167" class="unnumbered unstyled" aria-label="આ ચિત્રમાં બે સ્તંભ છે: ડાબે નોંધો અને જમણે આધારના ખંડો છે. ડાબી પહેલી લીટી કહે છે કે પહેલી સંખ્યાને ત્રણ ખંડથી દર્શાવવાનું શરૂ કરીએ; તેની સામે 3 છૂટા ખંડની નીચે 3 લખેલું છે. બીજી લીટી કહે છે કે બીજી સંખ્યાને ચાર ખંડથી દર્શાવીએ; તેની સામે ત્રણ છૂટા ખંડ, જગ્યા અને પછી 4 છૂટા ખંડ છે. ત્રણ ખંડની નીચે 3 અને ચાર ખંડની નીચે 4 લખેલું છે. છેલ્લી લીટી ખંડોની કુલ સંખ્યા ગણવાનું કહે છે; તેની સામે 7 છૂટા ખંડની નીચે 7 લખેલું છે.">
<tgroup cols="2"><tbody>
  <row>
    <entry>પહેલી સંખ્યાને 3 ખંડથી દર્શાવીને શરૂઆત કરીએ.</entry>
    <entry><media id="eip-id1168288475996" alt="સફેદ પૃષ્ઠભૂમિ પર અંક 3ની ઉપર ત્રણ ખાલી ચોરસ દેખાય છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_02_019_img-02.png" /></media></entry>
  </row>
  <row>
    <entry>પછી બીજી સંખ્યાને 4 ખંડથી દર્શાવીએ.</entry>
    <entry><media id="eip-id1168288501014" alt="ખાલી ચોરસના બે જૂથ છે. પહેલા જૂથમાં ત્રણ ચોરસ અને તેની નીચે “3” છે. બીજા જૂથમાં ચાર ચોરસ અને તેની નીચે “4” છે. તે મૂળભૂત ગણતરી અથવા જૂથ બનાવવાનું દર્શાવે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_02_019_img-03.png" /></media></entry>
  </row>
  <row>
    <entry>ખંડોની કુલ સંખ્યા ગણો.</entry>
    <entry><media id="eip-id1168288501034" alt="સાત ખાલી ચોરસની હરોળની નીચે અંક “7” લખેલો છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_02_019_img-04.png" /></media></entry>
  </row>
</tbody>




</tgroup>
</table><para id="fs-id1607848">કુલ <m:math><m:mn>7</m:mn></m:math> ખંડ છે. સરવાળો દર્શાવવા આપણે બરાબરનું ચિહ્ન <m:math><m:mrow><m:mtext>(=)</m:mtext></m:mrow></m:math> વાપરીએ છીએ. બે પદાવલીઓ સમાન છે એવું દર્શાવતા ગાણિતિક વાક્યને સમીકરણ કહે છે. આપણે આ દર્શાવ્યું છે: <m:math><m:mrow><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mo>=</m:mo><m:mn>7</m:mn><m:mo>.</m:mo></m:mrow></m:math></para><note id="fs-id1171103645619" class="manipulative-math">ગણિતનાં સાધનો સાથે કરવાની કાર્યપત્રિકાની “પૂર્ણ સંખ્યાઓનો સરવાળો નમૂના દ્વારા દર્શાવો” પ્રવૃત્તિ કરવાથી પૂર્ણ સંખ્યાઓના સરવાળાની વધુ સારી સમજ મળશે.</note><example id="fs-id1239606"><exercise id="fs-id1471255"><problem id="fs-id3961697">
<para id="fs-id1899387">આ સરવાળો નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>6</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1969376">
<title>ઉકેલ</title>
<para id="fs-id1883656"><m:math><m:mrow><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>6</m:mn></m:mrow></m:math> એટલે આ સંખ્યાઓનો સરવાળો: <m:math><m:mn>2</m:mn></m:math> અને <m:math><m:mn>6</m:mn></m:math></para><para id="eip-id1170195494564">ઉમેરવાની દરેક સંખ્યા 10 કરતાં નાની છે, તેથી એકમના ખંડો વાપરી શકીએ છીએ.</para>

<table id="eip-951" class="unnumbered unstyled" aria-label="આ ચિત્રમાં બે સ્તંભ છે: ડાબે નોંધો અને જમણે આધારના ખંડો છે. ડાબી પહેલી લીટી કહે છે કે પહેલી સંખ્યા 2 ખંડથી દર્શાવો; સામે બે છૂટા ખંડની નીચે 2 લખેલું છે. બીજી લીટી કહે છે કે બીજી સંખ્યા 6 ખંડથી દર્શાવો; સામે 2 છૂટા ખંડની નીચે 2 લખેલું છે, પછી અલગ છ છૂટા ખંડની હરોળની નીચે છ લખેલું છે. છેલ્લી લીટી ખંડોની કુલ સંખ્યા ગણવાનું કહે છે અને આઠ છૂટા ખંડની નીચે 8 લખેલું છે."><tgroup cols="3"><tbody>

  <row>
    <entry>પહેલી સંખ્યાને 2 ખંડથી દર્શાવો.</entry>
    <entry><media id="eip-id1168287484993" alt="સંખ્યા 2ની ઉપર આછા વાદળી રંગની કિનારીવાળા બે ચોરસ છે; તે બે વસ્તુની ગણતરી અથવા પસંદગી દર્શાવે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_02_016_img-02.png" /></media></entry>
  </row>
  <row>
    <entry>બીજી સંખ્યાને 6 ખંડથી દર્શાવો.</entry>
    <entry><media id="eip-id1168287042738" alt="ચિત્રમાં સંખ્યા 2ની ઉપર બે આછા વાદળી ચોરસ અને સંખ્યા 6ની ઉપર છ આછા વાદળી ચોરસ છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_02_016_img-03.png" /></media></entry>
  </row>
  <row>
    <entry>ખંડોની કુલ સંખ્યા ગણો.</entry>
    <entry><media id="eip-id1168287554343" alt="ચિત્રમાં સંખ્યા 8ની ઉપર આઠ આછા વાદળી ચોરસ છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_02_016_img-04.png" /></media><newline />કુલ <m:math><m:mrow><m:mn>8</m:mn></m:mrow></m:math> ખંડ છે, તેથી <m:math><m:mrow><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>6</m:mn><m:mo>=</m:mo><m:mn>8</m:mn><m:mo>.</m:mo></m:mrow></m:math></entry>
  </row>

</tbody>


</tgroup>
</table></solution>
</exercise></example><note id="fs-id1718496" class="try">
<exercise id="fs-id2792546">
<problem id="fs-id1404551">
<para id="fs-id1395632">નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>6</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1833338">
<para id="fs-id1171103910560"><newline /><media id="fs-id2198152" alt="ચિત્રમાં ત્રણ રાખોડી ચોરસ છે, પછી થોડી જગ્યા અને પછી બીજા છ રાખોડી ચોરસ છે. તેની નીચે “3 + 6 = 9” સમીકરણ ચોરસનો સરવાળો દર્શાવે છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_02_006_img.jpg" />
</media></para>
</solution>
</exercise>
</note>
<note id="fs-id2454904" class="try">
<exercise id="fs-id1886370">
<problem id="fs-id1374158">
<para id="fs-id1202710">નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>5</m:mn><m:mo>+</m:mo><m:mn>1</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1241970">
<para id="fs-id1171105209419"><newline /><media id="fs-id1790053" alt="ચિત્રમાં રાખોડી ચોરસથી 5 + 1નો સરવાળો દર્શાવેલો છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_02_007_img.jpg" />
</media></para>
</solution>
</exercise>
</note>
<para id="fs-id1825926">જ્યારે પરિણામમાં <m:math><m:mrow><m:mn>10</m:mn></m:mrow></m:math> અથવા વધુ એકમના ખંડ મળે, ત્યારે આપણે <m:math><m:mrow><m:mn>10</m:mn></m:mrow></m:math> ખંડના બદલામાં એક સળી લઈશું.</para>
<example id="fs-id998472"><exercise id="fs-id1792383">
<problem id="fs-id1569336">
<para id="fs-id1550016">આ સરવાળો નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>5</m:mn><m:mo>+</m:mo><m:mn>8</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1471782">
<title>ઉકેલ</title>
<para id="fs-id1171103442800"><m:math><m:mrow><m:mn>5</m:mn><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow></m:math> એટલે આ સંખ્યાઓનો સરવાળો: <m:math><m:mrow><m:mn>5</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>8</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>

<table id="eip-555" class="unnumbered unstyled" aria-label="આ ચિત્રમાં બે સ્તંભ છે: ડાબે નોંધો અને જમણે આધારના ખંડો છે. ડાબી પહેલી લીટી પહેલી સંખ્યા પાંચ ખંડથી દર્શાવવાનું કહે છે; સામે પાંચ છૂટા ખંડની નીચે 5 લખેલું છે. બીજી લીટી બીજી સંખ્યા 8 ખંડથી દર્શાવવાનું કહે છે; સામે 5 છૂટા ખંડ અને 8 છૂટા ખંડનાં અલગ જૂથ છે. તેમની નીચે અનુક્રમે 5 અને 8 લખેલું છે. પછીની લીટી પરિણામ ગણવાનું કહે છે. ત્યાં 10 કરતાં વધુ ખંડ હોવાથી 10 એકમના ખંડના બદલામાં 1 દશકનો ખંડ લઈએ છીએ. સામે 5 છૂટા ખંડ, પછી બીજા પાંચ છૂટા ખંડ અને ત્રણ છૂટા ખંડ છે. પહેલા દસ ખંડ વર્તુળમાં છે અને નીચે લાલ આધાર-દસના ખંડોના સમૂહ તરફ બતાવે છે; તેની બાજુમાં ત્રણ વાદળી ખંડ છે. છેલ્લી લીટી કહે છે કે હવે 1 દશક અને 3 એકમ છે, એટલે 13.">
<tgroup cols="2"><tbody>
  <row>
    <entry>ઉમેરવાની દરેક સંખ્યા 10 કરતાં નાની છે, તેથી એકમના ખંડો વાપરી શકીએ છીએ.</entry>
    <entry />
  </row>
  <row>
    <entry>પહેલી સંખ્યાને 5 ખંડથી દર્શાવો.</entry>
    <entry><media id="eip-id1168288219210" alt="ઘેરી કિનારીવાળા પાંચ ખાલી આછા રાખોડી ચોરસ આડી હરોળમાં છે. સફેદ પૃષ્ઠભૂમિ પર પાંચ ચોરસની વચ્ચે નીચે સંખ્યા “5” લખેલી છે, જે તેમની સંખ્યા દર્શાવે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_02_017_img-02.png" /></media></entry>
  </row>
  <row>
    <entry>બીજી સંખ્યાને 8 ખંડથી દર્શાવો.</entry>
    <entry><media id="eip-id1168288219228" alt="ચિત્રમાં કિનારીવાળા 5 રાખોડી ચોરસની નીચે સંખ્યા 5 છે. કિનારીવાળા આઠ રાખોડી ચોરસના જૂથની નીચે સંખ્યા 8 છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_02_017_img-03.png" /></media></entry>
  </row>
  <row>
    <entry>પરિણામ ગણો. 10 કરતાં વધુ ખંડ છે, તેથી 10 એકમના ખંડના બદલામાં 1 દશકની સળી લઈએ છીએ.</entry>
    <entry><media id="eip-id1168288217527" alt="આ ચિત્રમાં કિનારીવાળા 5 રાખોડી ચોરસનાં બે જૂથ અને કિનારીવાળા 3 રાખોડી ચોરસનું એક જૂથ છે. 5 ચોરસનાં બંને જૂથને વર્તુળમાં દર્શાવી તેમની નીચે 10 લાલ ખંડના એક જૂથમાં ફેરવેલાં છે. તેની બાજુમાં ત્રણ રાખોડી ચોરસનું જૂથ છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_02_017_img-04.png" /></media></entry>
  </row>
  <row>
    <entry>હવે આપણી પાસે 1 દશક અને 3 એકમ છે, એટલે 13.</entry>
    <entry>5 + 8 = 13</entry>
  </row>
</tbody>




</tgroup>
</table><para id="eip-571">ધ્યાન આપો કે આ નમૂનાઓને એકમના ખંડ અને દશકની સળી કહી શકીએ છીએ અથવા ટૂંકમાં <emphasis effect="italics">એકમ</emphasis> અને <emphasis effect="italics">દશક</emphasis> કહી શકીએ છીએ. હવે પછી ટૂંકાં નામ વાપરીશું, પણ તેમનો અર્થ એક જ છે તે યાદ રાખજો.</para></solution>
</exercise></example><note id="fs-id1762424" class="try">
<exercise id="fs-id2265162">
<problem id="fs-id2562850">
<para id="fs-id1827907">આ સરવાળો નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>5</m:mn><m:mo>+</m:mo><m:mn>7</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2140822">
<para id="fs-id1171105511335"><newline /><media id="fs-id4346927" alt="ચિત્રમાં ખંડોથી 5 + 7નો સરવાળો દર્શાવેલો છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_02_010_img.jpg" />
</media></para>
</solution>
</exercise>
</note>
<note id="fs-id1408852" class="try">
<exercise id="fs-id1863239">
<problem id="fs-id2496120">
<para id="fs-id1344440">આ સરવાળો નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>6</m:mn><m:mo>+</m:mo><m:mn>8</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2129995">
<para id="fs-id1171105491944"><newline /><media id="fs-id2171528" alt="ચિત્રમાં ખંડોથી 6 + 8નો સરવાળો દર્શાવેલો છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_02_011_img.jpg" />
</media></para>
</solution>
</exercise>
</note>
<para id="fs-id1608773">હવે બે અંકની સંખ્યાઓનો સરવાળો નમૂના દ્વારા દર્શાવીશું.
</para><example id="fs-id1392030"><exercise id="fs-id1939376"><problem id="fs-id1243266">
<para id="fs-id1372968">આ સરવાળો નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>17</m:mn><m:mo>+</m:mo><m:mn>26</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1966628">
<title>ઉકેલ</title>
<para id="eip-id2450011"><m:math><m:mn>17</m:mn><m:mo>+</m:mo><m:mn>26</m:mn></m:math> એટલે 17 અને 26નો સરવાળો.</para>
<table id="eip-93" class="unnumbered unstyled" aria-label="આ ચિત્રમાં ત્રણ સ્તંભ છે. ડાબો સ્તંભ કહે છે, 17નો નમૂનો બનાવો. વચ્ચે 1 દશક અને 7 એકમ લખેલું છે; જમણે 10 આધારના ખંડોની એક હરોળ અને 7 છૂટા ખંડ છે. પછીની લીટી કહે છે, 26નો નમૂનો બનાવો. વચ્ચે 2 દશક અને 6 એકમ લખેલું છે; સામે 2 આધાર-દસની સળીઓ એકની નીચે એક અને છ છૂટા ખંડ છે. પછી ભેગાં કરવાનું કહે છે. વચ્ચે 3 દશક અને 13 એકમ છે; સામે 3 આધાર-દસની સળીઓ અને 7 છૂટા ખંડની નીચે 6 છૂટા ખંડ છે. પછીની લીટી કહે છે, 10 એકમના બદલામાં 1 દશક લો; પછી 4 દશક અને 3 એકમ લખેલું છે, સામે આધાર-દસના ખંડોની 4 હરોળ અને ત્રણ છૂટા ખંડ છે."><label />
<tgroup cols="3"><tbody>
  <row>
    <entry>17ને દર્શાવો.</entry>
    <entry>1 દશક અને 7 એકમ</entry>
    <entry><media id="eip-id1168289477492" alt="આ ચિત્રમાં ડાબે 10 ખંડનું જૂથ અને જમણે 7 છૂટા ખંડનું જૂથ છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_02_018_img-02.png" /></media></entry>
  </row>
  <row>
    <entry>26ને દર્શાવો.</entry>
    <entry>2 દશક અને 6 એકમ</entry>
    <entry><media id="eip-id1168289477512" alt="આ ચિત્રમાં ડાબે કિનારીવાળા 10 ખંડનાં બે જૂથ અને જમણે 6 છૂટા ખંડ છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_02_018_img-03.png" /></media></entry>
  </row>
  <row>
    <entry>ભેગાં કરો.</entry>
    <entry>3 દશક અને 13 એકમ</entry>
    <entry><media id="eip-id1168289744408" alt="આ ચિત્રમાં જમણે કિનારીવાળા 10 ખંડનાં ત્રણ જૂથ અને જમણે 13 છૂટા ખંડ છે. જમણી બાજુના છૂટા ખંડમાંથી 10 લાલ રંગના છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_02_018_img-04.png" /></media></entry>
  </row>
  <row>
    <entry>10 એકમના બદલામાં 1 દશક લો.</entry>
    <entry>4 દશક અને 3 એકમ<newline />
    <m:math><m:mn>40</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>43</m:mn></m:math></entry>
    <entry><media id="eip-id1168289429860" alt="ચિત્રમાં ચોરસની હરોળો છે: દસ આછા વાદળી ચોરસની ત્રણ હરોળ અને તેમની નીચે દસ લાલ ચોરસની એક હરોળ છે. જમણે બીજા ત્રણ આછા વાદળી ચોરસ આડી હરોળમાં છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_02_018_img-05.png" /></media></entry>
  </row>
  <row>
    <entry>આપણે આ દર્શાવ્યું છે: <m:math><m:mn>17</m:mn><m:mo>+</m:mo><m:mn>26</m:mn><m:mo>=</m:mo><m:mn>43</m:mn></m:math></entry>
    <entry />
    <entry />
  </row>
</tbody>




</tgroup>
</table></solution>
</exercise></example><note id="fs-id1321704" class="try">
<exercise id="fs-id2137714">
<problem id="fs-id2645041">
<para id="fs-id1951300">આ સરવાળો નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>15</m:mn><m:mo>+</m:mo><m:mn>27</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2483638">
<para id="fs-id1171105493268"><newline /><media id="fs-id1546073" alt="આધાર-દસના ખંડોથી 15 + 27 = 42 દર્શાવ્યું છે; તેમાં ચાર દશક અને બે એકમ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_02_014_img.jpg" />
</media></para>
</solution>
</exercise>
</note>
<note id="fs-id1470537" class="try">
<exercise id="fs-id2813270">
<problem id="fs-id2379322">
<para id="fs-id2845299">આ સરવાળો નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>16</m:mn><m:mo>+</m:mo><m:mn>29</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2267850">
<para id="fs-id1171105192135"><newline /><media id="fs-id2197659" alt="આધાર-દસના ખંડોથી 16 + 29 = 45 દર્શાવેલું ચિત્ર. દસ ખંડની ચાર હરોળ 40 અને પાંચ છૂટા ખંડ 5 દર્શાવે છે, એટલે કુલ 45. ખંડોની નીચે સરવાળો લખેલો છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_02_015_img.jpg" />
</media></para>
</solution>
</exercise>
</note>
</section><section id="fs-id1385496"><title>નમૂના વિના પૂર્ણ સંખ્યાઓનો સરવાળો કરો</title><para id="fs-id2629808">અત્યાર સુધી આપણે નમૂનાની મદદથી સંખ્યાઓનો સરવાળો કર્યો. હવે નમૂના વિના સરવાળો કરી શકીએ છીએ. પહેલાં ખાતરી કરો કે એક અંકની સંખ્યાઓના બધા સરવાળા તમને આવડે છે. મોટી સંખ્યાઓ ઉમેરતી વખતે આ સરવાળાનો ઉપયોગ કરવો પડશે.</para>
<para id="fs-id2137623">કલ્પના કરો કે તમે આ કોષ્ટક ભરી રહ્યા છો: <link target-id="fs-id2300206" /> ડાબી બાજુની દરેક હરોળની સંખ્યામાં ઉપર આપેલી દરેક સ્તંભની સંખ્યા ઉમેરો. દર્શાવેલો દરેક સરવાળો તમને મળે છે તેની ખાતરી કરો. મુશ્કેલી પડે તો નમૂનો બનાવો. જે નાના સરવાળા તમને હજુ આવડતા નથી તેમને યાદ રાખવા જરૂરી છે, જેથી મોટી સંખ્યાઓનો સરવાળો કરતી વખતે ઝડપથી અને વિશ્વાસપૂર્વક તેમનો ઉપયોગ કરી શકો.</para>
