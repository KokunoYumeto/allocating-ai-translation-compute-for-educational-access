<?xml version='1.0' encoding='utf-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" xmlns:md="http://cnx.rice.edu/mdml" xml:lang="gu-Gujr-IN">

<title>અપૂર્ણાંકોનો સરવાળો અને બાદબાકી કરો</title>
<metadata>
  <md:content-id>m82457</md:content-id>
  <md:title>અપૂર્ણાંકોનો સરવાળો અને બાદબાકી કરો</md:title>
  <md:abstract><para id="para-00001">આ વિભાગના અંતે તમે નીચેનું કરી શકશો:</para>
<list id="list-00001">
<item>સમાન છેદવાળા અપૂર્ણાંકોનો સરવાળો કે બાદબાકી કરવી</item>
<item>જુદા છેદવાળા અપૂર્ણાંકોનો સરવાળો કે બાદબાકી કરવી</item>
<item>ક્રિયાઓનો ક્રમ વાપરીને જટિલ અપૂર્ણાંકોને સાદું રૂપ આપવું</item>
<item>અપૂર્ણાંકવાળી ચલ પદાવલીઓની કિંમત શોધવી</item>
</list></md:abstract>
  <md:uuid>e66747c7-79a1-4702-9997-019f59474d18</md:uuid>
</metadata>

<content>
<note id="fs-id1170655124148" class="be-prepared">
<para id="fs-id1170654997506">આ વિભાગના વિષયોનો વધુ વિગતવાર પરિચય <emphasis effect="italics">પૂર્વબીજગણિત</emphasis> પુસ્તકના આ પ્રકરણમાં મળે છે: <emphasis effect="bold">અપૂર્ણાંકો</emphasis>.</para>
</note>
<section id="fs-id1170654880149">
<title>સમાન છેદવાળા અપૂર્ણાંકોનો સરવાળો કે બાદબાકી કરો</title>
<para id="fs-id1170655354165">અપૂર્ણાંકોનો ગુણાકાર કરતી વખતે આપણે સીધા અંશોનો ગુણાકાર અને છેદોનો ગુણાકાર કર્યો હતો. અપૂર્ણાંકોનો સરવાળો કે બાદબાકી કરવા તેમના છેદ સમાન હોવા જોઈએ.</para>
<note id="fs-id1170654919725">
<title>અપૂર્ણાંકોનો સરવાળો અને બાદબાકી</title>
<para id="fs-id1170655188656">જો <m:math><m:mrow><m:mi>a</m:mi><m:mo>,</m:mo><m:mi>b</m:mi><m:mo>,</m:mo><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mi>c</m:mi></m:mrow></m:math> એવી સંખ્યાઓ હોય કે <m:math><m:mrow><m:mi>c</m:mi><m:mo>≠</m:mo><m:mn>0</m:mn><m:mo>,</m:mo></m:mrow></m:math> તો</para>
<equation id="fs-id1170655166745" class="unnumbered"><label /><m:math><m:mrow><m:mfrac><m:mi>a</m:mi><m:mi>c</m:mi></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mi>b</m:mi><m:mi>c</m:mi></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mi>a</m:mi><m:mo>+</m:mo><m:mi>b</m:mi></m:mrow><m:mi>c</m:mi></m:mfrac><m:mspace width="1em" /><m:mtext>અને</m:mtext><m:mspace width="1em" /><m:mfrac><m:mi>a</m:mi><m:mi>c</m:mi></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mi>b</m:mi><m:mi>c</m:mi></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mi>a</m:mi><m:mo>−</m:mo><m:mi>b</m:mi></m:mrow><m:mi>c</m:mi></m:mfrac></m:mrow></m:math></equation>
<para id="fs-id1170655157626">અપૂર્ણાંકોનો સરવાળો કે બાદબાકી કરવા અંશોનો સરવાળો કે બાદબાકી કરો અને પરિણામને સમાન છેદની ઉપર લખો.</para>
</note>
<note id="fs-id1166424803522" class="manipulative-math">હાથવગી સામગ્રીથી ગણિત શીખવાની પ્રવૃત્તિઓ ‘અપૂર્ણાંકોના સરવાળાનું નિરૂપણ’ અને ‘અપૂર્ણાંકોની બાદબાકીનું નિરૂપણ’ કરવાથી આ ક્રિયાઓ વધુ સારી રીતે સમજી શકશો.</note>
<example id="fs-id1170654957397"><exercise id="fs-id1170655204284">
<problem id="fs-id1170655202348">
<para id="fs-id1170655132751">સરવાળો શોધો: <m:math><m:mrow><m:mfrac><m:mi>x</m:mi><m:mn>3</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655126354">
<title>ઉકેલ</title>
<table id="eip-899" summary="સમાન છેદવાળા અપૂર્ણાંકોનો સરવાળો દર્શાવ્યો છે; ક્રિયા અને તેનાથી મળતી પદાવલી આપેલી છે.">
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry><m:math><m:mfrac><m:mi>x</m:mi><m:mn>3</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>અંશોનો સરવાળો કરો અને તેને સમાન છેદની ઉપર લખો.</entry>
    <entry><m:math><m:mfrac><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow><m:mn>3</m:mn></m:mfrac></m:math></entry>
  </row>
</tbody>
</tgroup>
</table>
</solution>
</exercise></example><note id="fs-id1170655190593" class="try">
<exercise id="fs-id1170654935284">
<problem id="fs-id1170655171769">
<para id="fs-id1170655219838">સરવાળો શોધો: <m:math><m:mrow><m:mfrac><m:mi>x</m:mi><m:mn>4</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655063055">
<para id="fs-id1170654965957"><m:math><m:mrow><m:mfrac><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170655113498" class="try">
<exercise id="fs-id1170655174670">
<problem id="fs-id1170655099386">
<para id="fs-id1170654914020">સરવાળો શોધો: <m:math><m:mrow><m:mfrac><m:mi>y</m:mi><m:mn>8</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655155229">
<para id="fs-id1170654860838"><m:math><m:mrow><m:mfrac><m:mrow><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<example id="fs-id1170655166985"><exercise id="fs-id1170655083064">
<problem id="fs-id1170654878890">
<para id="fs-id1170655029152">તફાવત શોધો: <m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>23</m:mn></m:mrow><m:mrow><m:mn>24</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>13</m:mn></m:mrow><m:mrow><m:mn>24</m:mn></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655120820">
<title>ઉકેલ</title>
<para id="fs-id1170655000479"><table id="eip-803" class="unnumbered unstyled" summary="આ કોષ્ટકમાં સમાન છેદવાળા અપૂર્ણાંકોની બાદબાકી અને અંતિમ જવાબને સાદું રૂપ આપવાનાં પગલાં છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry><m:math><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>23</m:mn></m:mrow><m:mrow><m:mn>24</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>13</m:mn></m:mrow><m:mrow><m:mn>24</m:mn></m:mrow></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>અંશોની બાદબાકી કરો અને તફાવતને સમાન છેદની ઉપર લખો.</entry>
    <entry><m:math><m:mfrac><m:mrow><m:mn>−23</m:mn><m:mo>−</m:mo><m:mn>13</m:mn></m:mrow><m:mrow><m:mn>24</m:mn></m:mrow></m:mfrac></m:math></entry>
  </row>
   <row>
    <entry>સાદું રૂપ આપો.</entry>
    <entry><m:math><m:mfrac><m:mrow><m:mn>−36</m:mn></m:mrow><m:mrow><m:mn>24</m:mn></m:mrow></m:mfrac></m:math></entry>
  </row>
   <row>
    <entry>સાદું રૂપ આપો. યાદ રાખો, <m:math><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mi>a</m:mi><m:mi>b</m:mi></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mtext>−</m:mtext><m:mi>a</m:mi></m:mrow><m:mi>b</m:mi></m:mfrac></m:math>.</entry>
    <entry><m:math><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>2</m:mn></m:mfrac></m:math></entry>
  </row>
</tbody>
</tgroup>
</table></para>
</solution>
</exercise></example><note id="fs-id1170654977626" class="try">
<exercise id="fs-id1170654977384">
<problem id="fs-id1170655107412">
<para id="fs-id1170654982582">તફાવત શોધો: <m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>19</m:mn></m:mrow><m:mrow><m:mn>28</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>28</m:mn></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654984424">
<para id="fs-id1170654977278"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>13</m:mn></m:mrow><m:mrow><m:mn>14</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170655117407" class="try">
<exercise id="fs-id1170654861951">
<problem id="fs-id1170655126513">
<para id="fs-id1170654943302">તફાવત શોધો: <m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>27</m:mn></m:mrow><m:mrow><m:mn>32</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>32</m:mn></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654925186">
<para id="fs-id1170655000121"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<example id="fs-id1170654958630"><exercise id="fs-id1170654863148">
<problem id="fs-id1170655171423">
<para id="fs-id1170655151277">સાદું રૂપ આપો: <m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>10</m:mn></m:mrow><m:mi>x</m:mi></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>4</m:mn><m:mi>x</m:mi></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655111995">
<title>ઉકેલ</title>
<para id="fs-id1170655113491"><table id="eip-689" class="unnumbered unstyled" summary="સમાન છેદવાળા બીજગણિતીય અપૂર્ણાંકોને પગલાંવાર સાદું રૂપ આપ્યું છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry><m:math><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>10</m:mn></m:mrow><m:mi>x</m:mi></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>4</m:mn><m:mi>x</m:mi></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>અંશોની બાદબાકી કરો અને તફાવતને સમાન છેદની ઉપર લખો.</entry>
    <entry><m:math><m:mfrac><m:mrow><m:mn>−14</m:mn></m:mrow><m:mi>x</m:mi></m:mfrac></m:math></entry>
  </row>
   <row>
    <entry>અપૂર્ણાંકની આગળ ચિહ્ન મૂકીને ફરી લખો.</entry>
    <entry><m:math><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>14</m:mn></m:mrow><m:mi>x</m:mi></m:mfrac></m:math></entry>
  </row>
</tbody>

</tgroup>
</table></para>
</solution>
</exercise></example><note id="fs-id1170655129792" class="try">
<exercise id="fs-id1170655027691">
<problem id="fs-id1170655157794">
<para id="fs-id1170655163014">તફાવત શોધો: <m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>9</m:mn><m:mi>x</m:mi></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>7</m:mn><m:mi>x</m:mi></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654983100">
<para id="fs-id1170654920902"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>16</m:mn></m:mrow><m:mi>x</m:mi></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170655000676" class="try">
<exercise id="fs-id1170655025544">
<problem id="fs-id1170654916783">
<para id="fs-id1170655105413">તફાવત શોધો: <m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mi>a</m:mi></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mi>a</m:mi></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655006907">
<para id="fs-id1170655111959"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>22</m:mn></m:mrow><m:mi>a</m:mi></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<para id="fs-id1170654981369">હવે સરવાળો અને બાદબાકી બંને ધરાવતું ઉદાહરણ કરીશું.</para>
<example id="fs-id1170654857518"><exercise id="fs-id1170654972339">
<problem id="fs-id1170654958831">
<para id="fs-id1170655132925">સાદું રૂપ આપો: <m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655127415">
<title>ઉકેલ</title>
<table id="eip-89" summary="આ કોષ્ટકમાં સમાન છેદવાળા અપૂર્ણાંકોના સરવાળા અને બાદબાકીનાં પગલાં છે.">
<tgroup cols="2"><tbody>
  <row>
    <entry>અપૂર્ણાંકોનો સરવાળો અને બાદબાકી—શું તેમના છેદ સમાન છે? હા. </entry>
    <entry><m:math><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>અંશોમાં સરવાળો અને બાદબાકી કરો અને મળેલા તફાવતને સમાન છેદની ઉપર લખો.</entry>
    <entry><m:math><m:mfrac><m:mrow><m:mn>3</m:mn><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>−5</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow><m:mn>8</m:mn></m:mfrac></m:math></entry>
  </row>
   <row>
    <entry>ડાબેથી જમણે સાદું રૂપ આપો.</entry>
    <entry><m:math><m:mfrac><m:mrow><m:mn>−2</m:mn><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow><m:mn>8</m:mn></m:mfrac></m:math></entry>
  </row>
     <row>
    <entry>સાદું રૂપ આપો.</entry>
    <entry><m:math><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac></m:math></entry>
  </row>
</tbody>
</tgroup>
</table>
</solution>
</exercise>
</example><note id="fs-id1170655162420" class="try">
<exercise id="fs-id1170655261591">
<problem id="fs-id1170655219867">
<para id="fs-id1170655197202">સાદું રૂપ આપો: <m:math><m:mrow><m:mo>−</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>9</m:mn></m:mfrac><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>4</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>7</m:mn><m:mn>9</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654972445">
<para id="fs-id1170654981205"><m:math><m:mrow><m:mn>−1</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170655218316" class="try">
<exercise id="fs-id1170655154844">
<problem id="fs-id1170654986125">
<para id="fs-id1170655029206">સાદું રૂપ આપો: <m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>9</m:mn></m:mfrac><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>4</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>7</m:mn><m:mn>9</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654957671">
<para id="fs-id1170655117362"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1170655021662">
<title>જુદા છેદવાળા અપૂર્ણાંકોનો સરવાળો કે બાદબાકી કરો</title>
<para id="fs-id1170655126325">આપણે જોયું છે કે અપૂર્ણાંકોનો સરવાળો કે બાદબાકી કરવા તેમના છેદ સમાન હોવા જોઈએ. આ <term id="term-00001">લઘુત્તમ સામાન્ય છેદ</term> (LCD) બે અપૂર્ણાંકો માટે એવી સૌથી નાની સંખ્યા છે જે તેમનો સામાન્ય <term class="no-emphasis" id="term-00002">છેદ</term> બની શકે. બે અપૂર્ણાંકોનો લઘુત્તમ સામાન્ય છેદ તેમના છેદોનો લઘુત્તમ સામાન્ય અવયવી (LCM) છે.</para>
<note id="fs-id1170655194149">
<title>લઘુત્તમ સામાન્ય છેદ</title>
<para id="fs-id1170654928069">બે અપૂર્ણાંકોનો લઘુત્તમ સામાન્ય છેદ (LCD) તેમના છેદોનો લઘુત્તમ સામાન્ય અવયવી (LCM) છે.</para>
</note>
<note id="fs-id1166424773242" class="manipulative-math">હાથવગી સામગ્રીથી ગણિત શીખવાની પ્રવૃત્તિ ‘લઘુત્તમ સામાન્ય છેદ શોધવો’ કરવાથી આ ખ્યાલ વધુ સારી રીતે સમજી શકશો.</note>
<para id="fs-id1170655061300">બે અપૂર્ણાંકોનો લઘુત્તમ સામાન્ય છેદ શોધ્યા પછી આપણે તેમને તે છેદવાળા સમ અપૂર્ણાંકોમાં ફેરવીએ છીએ. આ પગલાં સાથે કરવાથી સરવાળો કે બાદબાકી થઈ શકે છે, કારણ કે હવે તેમના છેદ સમાન છે!</para>
<example id="fs-id1170655399370">
<title>અપૂર્ણાંકોનો સરવાળો કે બાદબાકી કરવાની રીત</title>
<exercise id="fs-id1170654983383">
<problem id="fs-id1170654938746">
<para id="fs-id1170655112854">સરવાળો કરો: <m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>18</m:mn></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655216078"><title>ઉકેલ</title>
<media id="fs-id1170655396298" alt="કોષ્ટકમાં ડાબે સૂચનાઓ, વચ્ચે સૂચનો કે સમજૂતી અને જમણે ગણિત છે. પહેલી હરોળમાં ‘પગલું 1. શું છેદ સમાન છે? ના—દરેક અપૂર્ણાંકને લઘુત્તમ સામાન્ય છેદ સાથે ફરી લખો.’ છે. વચ્ચે ‘ના. 12 અને 18નો લઘુત્તમ સામાન્ય છેદ શોધો.’ છે. જમણે 12 = 2 × 2 × 3 અને 18 = 2 × 3 × 3 છે. તેથી લઘુત્તમ સામાન્ય છેદ = 2 × 2 × 3 × 3 = 36 છે. આગળ સૂચન છે: ‘લઘુત્તમ સામાન્ય છેદવાળા સમ અપૂર્ણાંકોમાં ફેરવો. આ સમ અપૂર્ણાંકોને સાદું રૂપ ન આપો! એમ કરશો તો મૂળ અપૂર્ણાંકો પાછા મળશે અને સમાન છેદ રહેશે નહીં!’ જમણે 7/12 + 5/18, પછી (7 × 3)/(12 × 3) + (5 × 2)/(18 × 2), અને પછી 21/36 + 10/36 છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_06_001a_new.jpg" />
</media>
<media id="fs-id1170654914425" alt="આગળ ‘પગલું 2. અપૂર્ણાંકોનો સરવાળો કે બાદબાકી કરો.’ છે. સૂચન છે ‘સરવાળો કરો.’ અને જવાબ 31/36 છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_06_001b_new.jpg" />
</media>
<media id="fs-id1170654931846" alt="છેલ્લે ‘પગલું 3. શક્ય હોય તો સાદું રૂપ આપો.’ છે. સમજૂતી છે: ‘31 અવિભાજ્ય સંખ્યા હોવાથી તેનો 36 સાથે 1 સિવાય કોઈ સામાન્ય અવયવ નથી. જવાબ સાદામાં સાદા રૂપમાં છે.’">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_06_001c_new.jpg" />
</media>
</solution>
</exercise>
</example>
<note id="fs-id1170655161634" class="try">
<exercise id="fs-id1170655111933">
<problem id="fs-id1170655123979">
<para id="fs-id1170655123981">સરવાળો કરો: <m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655223620">
<para id="fs-id1170655108732"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>79</m:mn></m:mrow><m:mrow><m:mn>60</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170655092253" class="try">
<exercise id="fs-id1170654903279">
<problem id="fs-id1170655194665">
<para id="fs-id1170655042204">સરવાળો કરો: <m:math><m:mrow><m:mfrac><m:mrow><m:mn>13</m:mn></m:mrow><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655062834">
<para id="fs-id1170655062836"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>103</m:mn></m:mrow><m:mrow><m:mn>60</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170655165144" class="howto">
<title>અપૂર્ણાંકોનો સરવાળો કે બાદબાકી કરો.</title>
<list id="fs-id1166424871688" list-type="enumerated" number-style="arabic" class="stepwise">
<item>શું તેમના છેદ સમાન છે?
<list id="fs-id1170655108352" list-type="bulleted" bullet-style="open-circle">
<item>હા—પગલું 2 પર જાઓ.</item>
<item>ના—દરેક અપૂર્ણાંકને લઘુત્તમ સામાન્ય છેદ સાથે ફરી લખો. પહેલાં લઘુત્તમ સામાન્ય છેદ શોધો. દરેક અપૂર્ણાંકને તે છેદવાળા સમ અપૂર્ણાંકમાં ફેરવો.</item>
</list></item>
<item>અપૂર્ણાંકોનો સરવાળો કે બાદબાકી કરો.</item>
<item>શક્ય હોય તો સાદું રૂપ આપો.</item>
</list>
</note>
<para id="fs-id1170655163653">સમાન છેદ બનાવવા જરૂરી સમ અપૂર્ણાંકો શોધતી વખતે અંશ અને છેદને કઈ સંખ્યા વડે ગુણવા તે ઝડપથી શોધી શકાય છે. લઘુત્તમ સામાન્ય છેદ અવિભાજ્ય અવયવીકરણથી શોધ્યો હોય તો આ રીત કામ કરે છે.</para>
<para id="fs-id1170654940613">લઘુત્તમ સામાન્ય છેદના અવયવો જુઓ અને પછી તે અવયવોની ઉપરની દરેક કૉલમ જુઓ. દરેક છેદમાં ‘ખૂટતા’ અવયવો જ આપણને જોઈતી સંખ્યાઓ છે.</para>
<media id="fs-id1170655102403" alt="12 = 2 × 2 × 3 અવયવીકરણમાં 3 પછી ખાલી જગ્યા છે. 18 = 2 × 3 × 3માં 2 અને પહેલા 3ની વચ્ચે ખાલી જગ્યા છે. આ જગ્યાઓને ચીંધતાં તીરો પાસે ‘ખૂટતા અવયવો’ લખેલું છે. લઘુત્તમ સામાન્ય છેદ = 2 × 2 × 3 × 3 = 36 છે. તેમાં 12 અને 18ના અવયવો છે; બંનેમાં સામાન્ય હોય તે અવયવો એક જ વાર લીધા છે—પહેલો 2 અને પહેલો 3.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_06_002_img_new.jpg" />
</media>
<para id="fs-id1170654967245">આ <link target-id="fs-id1170655399370" />માં લઘુત્તમ સામાન્ય છેદ 36 માટે 2ના બે અવયવો અને આ સંખ્યાના બે અવયવો છે: <m:math><m:mrow><m:mn>3</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id1170655175041">છેદ 12માં 2ના બે અવયવો છે પણ 3નો એક જ અવયવ છે. તેથી એક 3 ‘ખૂટે’ છે; અંશ અને છેદને 3 વડે ગુણીએ છીએ.</para>
<para id="fs-id1170655175044">છેદ 18માં 2નો એક અવયવ ‘ખૂટે’ છે; તેથી અંશ અને છેદને 2 વડે ગુણીએ છીએ.</para>
<para id="fs-id1170654972409">આ ઉદાહરણમાં અપૂર્ણાંકોની બાદબાકી કરતી વખતે આ રીત વાપરીશું: <link target-id="fs-id1170655126635" />.</para>
<example id="fs-id1170655126635">
<exercise id="fs-id1170655000684">
<problem id="fs-id1170655000686">
<para id="fs-id1170655081926">બાદબાકી કરો: <m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>19</m:mn></m:mrow><m:mrow><m:mn>24</m:mn></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655200456">
<title>ઉકેલ</title>
<para id="fs-id1170655150350">શું અપૂર્ણાંકોના છેદ સમાન છે? ના, એટલે લઘુત્તમ સામાન્ય છેદ શોધવો પડશે.<newline />
<table id="eip-id1169754059819" class="unnumbered unstyled can-break has-images" aria-label="પહેલી હરોળમાં 7/15 − 19/24 છે. પછી ‘લઘુત્તમ સામાન્ય છેદ શોધો.’ સૂચના છે. 15 = 3 × 5માં 3ની પહેલાં ત્રણ ખાલી જગ્યાઓ છે. 24 = 2 × 2 × 2 × 3માં 3ની પછી એક ખાલી જગ્યા છે. લઘુત્તમ સામાન્ય છેદ = 2 × 2 × 2 × 3 × 5 = 120 છે. આગળ સૂચના છે: ‘લઘુત્તમ સામાન્ય છેદ મેળવવા પહેલા અપૂર્ણાંકમાં 8 અને બીજામાં 5 વડે ગુણો.’ પછી ‘લઘુત્તમ સામાન્ય છેદવાળા સમ અપૂર્ણાંકો તરીકે ફરી લખો.’ છે. ગણતરી (7 × 8)/(15 × 8) − (19 × 5)/(24 × 5) છે. આગળ ‘દરેક અંશ અને છેદને સાદું રૂપ આપો.’ છે અને 56/120 − 95/120 મળે છે. પછી ‘બાદબાકી કરો.’ છે અને −39/120 મળે છે. આગળ ‘સામાન્ય અવયવ 3 દર્શાવીને ફરી લખો.’ છે અને −(13 × 3)/(40 × 3) મળે છે. છેલ્લે ‘સામાન્ય અવયવ દૂર કરીને સાદું રૂપ આપો.’ છે અને −13/40 મળે છે."><label /><tgroup cols="2">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
 <tbody>
  <row>
    <entry>લઘુત્તમ સામાન્ય છેદ શોધો.<m:math><m:mrow><m:mspace width="5em" /></m:mrow></m:math><media id="eip-id1169754362252" alt="7/15 અને 19/24નો લઘુત્તમ સામાન્ય છેદ શોધ્યો છે. 15 = 3 × 5 અને 24 = 2 × 2 × 2 × 3 અવિભાજ્ય અવયવીકરણથી લઘુત્તમ સામાન્ય છેદ 120 મળે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_003a_img_new.jpg" /></media></entry>
    <entry />
  </row>
  <row>
    <entry>ધ્યાન આપો: લઘુત્તમ સામાન્ય છેદના અવયવોમાંથી 15માં 2ના ત્રણ અવયવો ‘ખૂટે’ છે અને 24માં 5 ‘ખૂટે’ છે. તેથી લઘુત્તમ સામાન્ય છેદ મેળવવા પહેલા અપૂર્ણાંકમાં 8 અને બીજામાં 5 વડે ગુણીએ છીએ.</entry>
<entry />
  </row>
  <row>
    <entry>લઘુત્તમ સામાન્ય છેદવાળા સમ અપૂર્ણાંકો તરીકે ફરી લખો.</entry>
    <entry><media id="eip-id1169754058803" alt="બે અપૂર્ણાંકોની બાદબાકી છે: (7 × 8)/(15 × 8) − (19 × 5)/(24 × 5). બંને 8 અને બંને 5 લાલ રંગે દર્શાવ્યા છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_003b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>સાદું રૂપ આપો.</entry>
    <entry><media id="eip-id1169754058820" alt="સમાન છેદવાળા બે અપૂર્ણાંકોની બાદબાકી છે: 56/120 − 95/120."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_003c_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>બાદબાકી કરો.</entry>
    <entry><m:math><m:mspace width="2em" /><m:mn>−</m:mn><m:mspace width="0.2em" /><m:mfrac><m:mn>39</m:mn><m:mn>120</m:mn></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>જવાબને સાદું રૂપ આપી શકાય છે કે નહીં તે તપાસો.</entry>
    <entry><m:math><m:mspace width="2em" /><m:mn>−</m:mn><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>13</m:mn><m:mo>⋅</m:mo><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>40</m:mn><m:mo>⋅</m:mo><m:mn>3</m:mn></m:mrow></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>39 અને 120 બંનેમાં અવયવ 3 છે.</entry>
    <entry />
  </row>
  <row>
    <entry>સાદું રૂપ આપો.</entry>
    <entry><m:math><m:mspace width="2em" /><m:mn>−</m:mn><m:mspace width="0.2em" /><m:mfrac><m:mn>13</m:mn><m:mn>40</m:mn></m:mfrac></m:math></entry>
  </row>
 </tbody>
</tgroup>
</table><newline />
આ સમ અપૂર્ણાંકોને સાદું રૂપ ન આપો! એમ કરશો તો મૂળ અપૂર્ણાંકો પાછા મળશે અને સમાન છેદ રહેશે નહીં!</para></solution>
</exercise>
</example>
<note id="fs-id1170655203494" class="try">
<exercise id="fs-id1170654968268">
<problem id="fs-id1170654968270">
<para id="fs-id1170655175417">બાદબાકી કરો: <m:math><m:mrow><m:mfrac><m:mrow><m:mn>13</m:mn></m:mrow><m:mrow><m:mn>24</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mrow><m:mn>32</m:mn></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655164359">
<para id="fs-id1170655164361"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>96</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170654935512" class="try">
<exercise id="fs-id1170655081466">
<problem id="fs-id1170655098048">
<para id="fs-id1170655098050">બાદબાકી કરો: <m:math><m:mrow><m:mfrac><m:mrow><m:mn>21</m:mn></m:mrow><m:mrow><m:mn>32</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>28</m:mn></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655111921">
<para id="fs-id1170655111923"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>75</m:mn></m:mrow><m:mrow><m:mn>224</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<para id="fs-id1170655129917">આગળના ઉદાહરણમાં એક અપૂર્ણાંકના અંશમાં ચલ છે. ધ્યાન આપો કે બંને અંશમાં સંખ્યા હોય ત્યારે કરીએ તે જ પગલાં અહીં પણ કરીએ છીએ.</para>
<example id="fs-id1170655230251">
<exercise id="fs-id1170655230253">
<problem id="fs-id1170655201164">
<para id="fs-id1170655201167">સરવાળો કરો: <m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mi>x</m:mi><m:mn>8</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655114432">
<title>ઉકેલ</title>
<para id="fs-id1170655120660">અપૂર્ણાંકોના છેદ જુદા છે.<newline />
<table id="eip-id1169752964735" class="unnumbered unstyled can-break" aria-label="પહેલી હરોળમાં 3/5 + x/8 છે. પછી ‘લઘુત્તમ સામાન્ય છેદ શોધો.’ છે. 5 = 5માં 5ની પહેલાં ત્રણ ખાલી જગ્યાઓ છે; 8 = 2 × 2 × 2માં છેલ્લાં 2ની પછી એક ખાલી જગ્યા છે. લઘુત્તમ સામાન્ય છેદ = 2 × 2 × 2 × 5 = 40 છે. આગળ ‘લઘુત્તમ સામાન્ય છેદવાળા સમ અપૂર્ણાંકો તરીકે ફરી લખો.’ છે અને (3 × 8)/(5 × 8) + (x × 5)/(8 × 5) છે. પછી ‘સાદું રૂપ આપો.’ છે અને 24/40 + 5x/40 મળે છે. આગળ ‘સરવાળો કરો.’ છે અને (24 + 5x)/40 મળે છે."><label />
<tgroup cols="3"><tbody>
  <row>
    <entry />
    <entry />
    <entry><m:math><m:mrow><m:mspace width="2em" /></m:mrow></m:math><media id="eip-id1169752980194" alt="બે અપૂર્ણાંકોનો સરવાળો છે: 3/5 + x/8. સફેદ પૃષ્ઠભૂમિ પર સંખ્યાઓ અને ચલ કાળા રંગે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_004a_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>લઘુત્તમ સામાન્ય છેદ શોધો.<m:math><m:mrow><m:mspace width="4em" /></m:mrow></m:math><media id="eip-id1169752827456" alt="અવિભાજ્ય અવયવીકરણ વડે 5 અને 8નો લઘુત્તમ સામાન્ય છેદ શોધ્યો છે: 5 = 5, 8 = 2 × 2 × 2, અને લઘુત્તમ સામાન્ય છેદ = 2 × 2 × 2 × 5 = 40."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_004b_img_new.jpg" /></media></entry>
    <entry />
    <entry />
  </row>
  <row>
    <entry>લઘુત્તમ સામાન્ય છેદવાળા સમ અપૂર્ણાંકો તરીકે ફરી લખો.</entry>
    <entry />
    <entry><m:math><m:mrow><m:mspace width="2em" /></m:mrow></m:math><media id="eip-id1169753158504" alt="બે અપૂર્ણાંકોનો સરવાળો છે: (3 × 8)/(5 × 8) + (x × 5)/(8 × 5). 8 અને 5 લાલ રંગે દર્શાવેલા સામાન્ય અવયવો છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_004c_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>સાદું રૂપ આપો.</entry>
    <entry />
    <entry><m:math><m:mrow><m:mspace width="2em" /></m:mrow></m:math><media id="eip-id1169753130877" alt="બે અપૂર્ણાંકો 24/40 અને 5x/40નો સરવાળો છે. બંનેનો છેદ 40 છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_004d_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>સરવાળો કરો.</entry>
    <entry />
    <entry><m:math><m:mrow><m:mspace width="2em" /></m:mrow></m:math><media id="eip-id1169753130893" alt="અપૂર્ણાંક (24 + 5x)/40 દર્શાવ્યો છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_004e_img_new.jpg" /></media></entry>
  </row>
 </tbody>

</tgroup>
</table><newline />
યાદ રાખો કે માત્ર સજાતીય પદો જ ભેગાં કરી શકાય: 24 અને 5<emphasis effect="italics">x</emphasis> સજાતીય પદો નથી.</para></solution>
</exercise>
</example>
<note id="fs-id1170654939379" class="try">
<exercise id="fs-id1170655226885">
<problem id="fs-id1170655226887">
<para id="fs-id1170654954496">સરવાળો કરો: <m:math><m:mrow><m:mfrac><m:mi>y</m:mi><m:mn>6</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>7</m:mn><m:mn>9</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655224317">
<para id="fs-id1170655224319"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>3</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>14</m:mn></m:mrow><m:mrow><m:mn>18</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170655098900" class="try">
<exercise id="fs-id1170655111437">
<problem id="fs-id1170655111439">
<para id="fs-id1170654944107">સરવાળો કરો: <m:math><m:mrow><m:mfrac><m:mi>x</m:mi><m:mn>6</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654990354">
<para id="fs-id1170655150393"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>14</m:mn></m:mrow><m:mrow><m:mn>30</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<para id="fs-id1170655189510">હવે આપણે અપૂર્ણાંકો પરની ચારેય ક્રિયાઓ જાણીએ છીએ. <link target-id="fs-id1170655154397" />માં <term class="no-emphasis" id="term-00003">અપૂર્ણાંકો પરની ક્રિયાઓ</term>નો સારાંશ છે.</para>
<table id="fs-id1170655154397" aria-label="કોષ્ટકમાં ચાર ખાનાં છે. ગુણાકારના ખાનામાં (a/b) × (c/d) = ac/(bd) અને સૂચના છે: ‘અંશોનો ગુણાકાર કરો અને છેદોનો ગુણાકાર કરો.’ ભાગાકારના ખાનામાં (a/b) ÷ (c/d) = (a/b) × (d/c) અને સૂચના છે: ‘પહેલા અપૂર્ણાંકને બીજાના વ્યસ્ત વડે ગુણો.’ સરવાળાના ખાનામાં a/c + b/c = (a + b)/c અને સૂચના છે: ‘અંશોનો સરવાળો કરીને સમાન છેદની ઉપર લખો.’ બાદબાકીના ખાનામાં a/c − b/c = (a − b)/c અને સૂચના છે: ‘અંશોની બાદબાકી કરીને તફાવતને સમાન છેદની ઉપર લખો.’ નીચે બે સૂચનાઓ છે: ‘ગુણાકાર કે ભાગાકાર માટે લઘુત્તમ સામાન્ય છેદ જરૂરી નથી.’ અને ‘સરવાળા કે બાદબાકી માટે સમાન છેદ જરૂરી છે; લઘુત્તમ સામાન્ય છેદ લેવાથી ગણતરી સરળ રહે છે.’">
<tgroup cols="2">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<tbody>
<row valign="top">
<entry valign="top" align="left"><emphasis effect="bold">અપૂર્ણાંકોનો ગુણાકાર</emphasis></entry>
<entry valign="top" align="left"><emphasis effect="bold">અપૂર્ણાંકોનો ભાગાકાર</emphasis></entry>
</row>
<row valign="top">
<entry valign="top" align="left"><m:math><m:mrow><m:mfrac><m:mi>a</m:mi><m:mi>b</m:mi></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mi>c</m:mi><m:mi>d</m:mi></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mi>a</m:mi><m:mi>c</m:mi></m:mrow><m:mrow><m:mi>b</m:mi><m:mi>d</m:mi></m:mrow></m:mfrac></m:mrow></m:math><newline /><newline />અંશોનો ગુણાકાર કરો અને છેદોનો ગુણાકાર કરો</entry>
<entry valign="top" align="left"><m:math><m:mrow><m:mfrac><m:mi>a</m:mi><m:mi>b</m:mi></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mi>c</m:mi><m:mi>d</m:mi></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mi>a</m:mi><m:mi>b</m:mi></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mi>d</m:mi><m:mi>c</m:mi></m:mfrac></m:mrow></m:math><newline /><newline />પહેલા અપૂર્ણાંકને બીજા અપૂર્ણાંકના વ્યસ્ત વડે ગુણો.</entry>
</row>
<row valign="top">
<entry valign="top" align="left"><emphasis effect="bold">અપૂર્ણાંકોનો સરવાળો</emphasis></entry>
<entry valign="top" align="left"><emphasis effect="bold">અપૂર્ણાંકોની બાદબાકી</emphasis></entry>
</row>
<row valign="top">
<entry valign="top" align="left"><m:math><m:mrow><m:mfrac><m:mi>a</m:mi><m:mi>c</m:mi></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mi>b</m:mi><m:mi>c</m:mi></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mi>a</m:mi><m:mo>+</m:mo><m:mi>b</m:mi></m:mrow><m:mi>c</m:mi></m:mfrac></m:mrow></m:math><newline /><newline />અંશોનો સરવાળો કરો અને તેને સમાન છેદની ઉપર લખો.</entry>
<entry valign="top" align="left"><m:math><m:mrow><m:mfrac><m:mi>a</m:mi><m:mi>c</m:mi></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mi>b</m:mi><m:mi>c</m:mi></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mi>a</m:mi><m:mo>−</m:mo><m:mi>b</m:mi></m:mrow><m:mi>c</m:mi></m:mfrac></m:mrow></m:math><newline /><newline />અંશોની બાદબાકી કરો અને તફાવતને સમાન છેદની ઉપર લખો.</entry>
</row>
<row valign="top">
<entry align="center" valign="top" namest="c1" nameend="c2">અપૂર્ણાંકોના ગુણાકાર કે ભાગાકાર માટે લઘુત્તમ સામાન્ય છેદ જરૂરી નથી.<newline />
અપૂર્ણાંકોના સરવાળા કે બાદબાકી માટે સમાન છેદ જરૂરી છે; લઘુત્તમ સામાન્ય છેદ લેવાથી ગણતરી સરળ રહે છે.</entry>
</row>
</tbody>
</tgroup>
</table>
<example id="fs-id1170654972346"><exercise id="fs-id1170655061519">
<problem id="fs-id1170655061521">
<para id="fs-id1170655061523">સાદું રૂપ આપો: <span class="token">ⓐ</span> <m:math><m:mrow><m:mfrac><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi></m:mrow><m:mn>6</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mfrac><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi></m:mrow><m:mn>6</m:mn></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>3</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654944167">
<title>ઉકેલ</title>
<para id="fs-id1170654936746">પહેલાં પૂછો: ‘કઈ ક્રિયા કરવાની છે?’ ક્રિયા ઓળખવાથી નક્કી થશે કે સમાન છેદ જોઈએ કે નહીં. યાદ રાખો કે સરવાળા કે બાદબાકી માટે સમાન છેદ જોઈએ, પરંતુ ગુણાકાર કે ભાગાકાર માટે નહીં.</para><para id="eip-idm1338853152"><table id="eip-17" class="unnumbered unstyled" summary="અપૂર્ણાંકોની ક્રિયાઓ—બાદબાકી અને ગુણાકાર—શબ્દોમાં સમજૂતી અને પગલાંવાર ઉકેલો સાથે દર્શાવી છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry><span class="token">ⓐ</span> કઈ ક્રિયા છે? બાદબાકી કરવાની છે.
    <newline />શું અપૂર્ણાંકોના છેદ સમાન છે? ના.
    <newline />દરેક અપૂર્ણાંકને લઘુત્તમ સામાન્ય છેદવાળા સમ અપૂર્ણાંક તરીકે ફરી લખો.
    <newline />અંશોની બાદબાકી કરો અને તફાવતને સમાન છેદની ઉપર લખો.
    <newline />શક્ય હોય તો સાદું રૂપ આપો.
    <newline />1 સિવાય કોઈ સામાન્ય અવયવ નથી. અપૂર્ણાંક સાદામાં સાદા રૂપમાં છે.
	</entry>
    <entry><m:math><m:mtable>
    	<m:mtr><m:mtd><m:mfrac><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi></m:mrow><m:mn>6</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac></m:mtd></m:mtr>
    	<m:mtr><m:mtd><m:mfrac><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>·</m:mo><m:mn>5</m:mn></m:mrow><m:mrow><m:mn>6</m:mn><m:mo>·</m:mo><m:mn>5</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>10</m:mn><m:mo>·</m:mo><m:mn>3</m:mn></m:mrow></m:mfrac></m:mtd></m:mtr>
    	<m:mtr><m:mtd><m:mfrac><m:mrow><m:mn>25</m:mn><m:mi>x</m:mi></m:mrow><m:mrow><m:mn>30</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>30</m:mn></m:mrow></m:mfrac></m:mtd></m:mtr>
    	<m:mtr><m:mtd><m:mfrac><m:mrow><m:mn>25</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow><m:mrow><m:mn>30</m:mn></m:mrow></m:mfrac></m:mtd></m:mtr>
    </m:mtable></m:math></entry>
  </row>

  <row>
    <entry><span class="token">ⓑ</span> કઈ ક્રિયા છે? ગુણાકાર.
    <newline />અપૂર્ણાંકોનો ગુણાકાર કરવા અંશોનો ગુણાકાર કરો અને છેદોનો ગુણાકાર કરો.
    <newline />સામાન્ય અવયવો દર્શાવીને ફરી લખો. સામાન્ય અવયવો દૂર કરો.
    <newline />સાદું રૂપ આપો.
	</entry>
    <entry><m:math><m:mtable>
    	<m:mtr><m:mtd><m:mfrac><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi></m:mrow><m:mn>6</m:mn></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>3</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac></m:mtd></m:mtr>
    	<m:mtr><m:mtd><m:mfrac><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>·</m:mo><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>6</m:mn><m:mo>·</m:mo><m:mn>10</m:mn></m:mrow></m:mfrac></m:mtd></m:mtr>
    	<m:mtr><m:mtd><m:mfrac><m:mrow><m:menclose notation="updiagonalstrike"><m:mn>5</m:mn></m:menclose><m:mi>x</m:mi><m:mo>·</m:mo><m:menclose notation="updiagonalstrike"><m:mn>3</m:mn></m:menclose></m:mrow><m:mrow><m:mn>2</m:mn><m:mo>·</m:mo><m:menclose notation="updiagonalstrike"><m:mn>3</m:mn></m:menclose><m:mo>·</m:mo><m:mn>2</m:mn><m:mo>·</m:mo><m:menclose notation="updiagonalstrike"><m:mn>5</m:mn></m:menclose></m:mrow></m:mfrac></m:mtd></m:mtr>
    	<m:mtr><m:mtd><m:mfrac><m:mi>x</m:mi><m:mn>4</m:mn></m:mfrac></m:mtd></m:mtr>
    </m:mtable></m:math></entry>
  </row>
</tbody>
</tgroup>
</table></para>
<para id="fs-id1170655106844">ધ્યાન આપો કે આની બાદબાકી માટે સમાન છેદ મેળવવા લઘુત્તમ સામાન્ય છેદ વાપર્યો: <m:math><m:mrow><m:mfrac><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi></m:mrow><m:mn>6</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac><m:mo>,</m:mo></m:mrow></m:math> પરંતુ આના ગુણાકાર માટે નહીં: <m:math><m:mrow><m:mfrac><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi></m:mrow><m:mn>6</m:mn></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>3</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</solution>
</exercise></example><note id="fs-id1170655104899" class="try">
<exercise id="fs-id1170655195238">
<problem id="fs-id1170655195240">
<para id="fs-id1170655195242">સાદું રૂપ આપો: <span class="token">ⓐ</span> <m:math><m:mrow><m:mfrac><m:mrow><m:mn>3</m:mn><m:mi>a</m:mi></m:mrow><m:mn>4</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>8</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mfrac><m:mrow><m:mn>3</m:mn><m:mi>a</m:mi></m:mrow><m:mn>4</m:mn></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>8</m:mn><m:mn>9</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655199104">
<para id="fs-id1170655199106"><span class="token">ⓐ</span> <m:math><m:mrow><m:mfrac><m:mrow><m:mn>27</m:mn><m:mi>a</m:mi><m:mo>−</m:mo><m:mn>32</m:mn></m:mrow><m:mrow><m:mn>36</m:mn></m:mrow></m:mfrac></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mfrac><m:mrow><m:mn>2</m:mn><m:mi>a</m:mi></m:mrow><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170655395953" class="try">
<exercise id="fs-id1170655395956">
<problem id="fs-id1170655165629">
<para id="fs-id1170655165632">સાદું રૂપ આપો: <span class="token">ⓐ</span> <m:math><m:mrow><m:mfrac><m:mrow><m:mn>4</m:mn><m:mi>k</m:mi></m:mrow><m:mn>5</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mfrac><m:mrow><m:mn>4</m:mn><m:mi>k</m:mi></m:mrow><m:mn>5</m:mn></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655132961">
<para id="fs-id1170655132963"><span class="token">ⓐ</span> <m:math><m:mrow><m:mfrac><m:mrow><m:mn>24</m:mn><m:mi>k</m:mi><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow><m:mrow><m:mn>30</m:mn></m:mrow></m:mfrac></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mfrac><m:mrow><m:mn>2</m:mn><m:mi>k</m:mi></m:mrow><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1170655164985">
<title>ક્રિયાઓનો ક્રમ વાપરીને જટિલ અપૂર્ણાંકોને સાદું રૂપ આપો</title>
<para id="fs-id1170654969636">આપણે જોયું છે કે જટિલ અપૂર્ણાંકના અંશ કે છેદમાં અપૂર્ણાંક હોય છે. અપૂર્ણાંક રેખા <term class="no-emphasis" id="term-00004">ભાગાકાર</term> દર્શાવે છે. આપણે આ જટિલ અપૂર્ણાંકને સાદું રૂપ આપ્યું: <m:math><m:mrow><m:mfrac><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:mfrac></m:mrow></m:math> તેને ભાગાકાર તરીકે લખીને, <m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math>ને <m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math> વડે ભાગ્યું.</para>
<para id="fs-id1170655111615">હવે એવા જટિલ અપૂર્ણાંકો જોઈશું જેમના અંશ કે છેદમાં સાદું રૂપ આપી શકાય તેવી પદાવલી હોય. તેથી પહેલાં ક્રિયાઓના ક્રમ વડે અંશ અને છેદને અલગઅલગ સંપૂર્ણ સાદું રૂપ આપવું પડે. પછી અંશને છેદ વડે ભાગીએ છીએ.</para>
<example id="fs-id1170655111617">
<title>જટિલ અપૂર્ણાંકોને સાદું રૂપ આપવાની રીત</title>
<exercise id="fs-id1170655189464">
<problem id="fs-id1170655189466">
<para id="fs-id1170654962386">સાદું રૂપ આપો: <m:math><m:mrow><m:mfrac><m:mrow><m:msup><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow><m:mn>2</m:mn></m:msup></m:mrow><m:mrow><m:mn>4</m:mn><m:mo>+</m:mo><m:msup><m:mn>3</m:mn><m:mn>2</m:mn></m:msup></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654953233">
<title>ઉકેલ</title>
<media id="fs-id1170654968903" alt="કોષ્ટકમાં ડાબે સૂચનાઓ અને જમણે ગણિત છે. પહેલી હરોળમાં ‘પગલું 1. અંશને સાદું રૂપ આપો. યાદ રાખો કે અડધાનો વર્ગ એટલે અડધા ગુણ્યા અડધા.’ છે. જમણે ((1/2)²)/(4 + 3²) છે અને પછી (1/4)/(4 + 3²) છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_06_010a_new.jpg" />
</media>
<media id="fs-id1170655096686" alt="આગળ ‘પગલું 2. છેદને સાદું રૂપ આપો.’ છે. જમણે (1/4)/(4 + 9) અને તેની નીચે (1/4)/13 છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_06_010b_new.jpg" />
</media>
<media id="fs-id1170655090064" alt="છેલ્લે ‘પગલું 3. અંશને છેદ વડે ભાગો. શક્ય હોય તો સાદું રૂપ આપો. યાદ રાખો કે 13 = 13/1.’ છે. જમણે (1/4) ÷ 13, પછી (1/4) · (1/13), અને તેની નીચે અંતિમ જવાબ 1/52 છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_06_010c_new.jpg" />
</media>
</solution>
</exercise>
</example>
<note id="fs-id1170654962204" class="try">
<exercise id="fs-id1170654962207">
<problem id="fs-id1170655029722">
<para id="fs-id1170655029724">સાદું રૂપ આપો: <m:math><m:mrow><m:mfrac><m:mrow><m:msup><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow><m:mn>2</m:mn></m:msup></m:mrow><m:mrow><m:msup><m:mn>2</m:mn><m:mn>3</m:mn></m:msup><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655178937">
<para id="fs-id1170655178939"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>90</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170655207364" class="try">
<exercise id="fs-id1170654943857">
<problem id="fs-id1170654943859">
<para id="fs-id1170654943862">સાદું રૂપ આપો: <m:math><m:mrow><m:mfrac><m:mrow><m:mn>1</m:mn><m:mo>+</m:mo><m:msup><m:mn>4</m:mn><m:mn>2</m:mn></m:msup></m:mrow><m:mrow><m:msup><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow><m:mn>2</m:mn></m:msup></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655354060">
<para id="fs-id1170655213977"><m:math><m:mrow><m:mn>272</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170655062537" class="howto">
<title>જટિલ અપૂર્ણાંકોને સાદું રૂપ આપો.</title>
<list id="fs-id1166424845977" list-type="enumerated" number-style="arabic" class="stepwise">
<item>અંશને સાદું રૂપ આપો.</item>
<item>છેદને સાદું રૂપ આપો.</item>
<item>અંશને છેદ વડે ભાગો. શક્ય હોય તો સાદું રૂપ આપો.</item>
</list>
</note>
<example id="fs-id1170654968372"><exercise id="fs-id1170654968374">
<problem id="fs-id1170654968376">
<para id="fs-id1170655021220">સાદું રૂપ આપો: <m:math><m:mrow><m:mfrac><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655102612">
<title>ઉકેલ</title>
<para id="fs-id1170655102617">અંશ અને છેદની આસપાસ કૌંસ મૂકવાથી મદદ મળી શકે.</para>
<table id="eip-20" summary="આ કોષ્ટકમાં જટિલ અપૂર્ણાંકને સાદું રૂપ આપવાનાં પગલાં અને પદાવલીનું ક્રમશઃ બદલાતું સ્વરૂપ દર્શાવ્યાં છે.">
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry><m:math><m:mfrac><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>અંશને સાદું રૂપ આપો (લઘુત્તમ સામાન્ય છેદ = 6) અને છેદને સાદું રૂપ આપો (લઘુત્તમ સામાન્ય છેદ = 12).</entry>
    <entry><m:math><m:mfrac><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>4</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>2</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>સાદું રૂપ આપો.</entry>
    <entry><m:math><m:mfrac><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mfrac><m:mn>7</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>અંશને છેદ વડે ભાગો.</entry>
    <entry><m:math><m:mfrac><m:mn>7</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>સાદું રૂપ આપો.</entry>
    <entry><m:math><m:mfrac><m:mn>7</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mrow><m:mn>12</m:mn></m:mrow><m:mn>7</m:mn></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>સામાન્ય અવયવોનો ભાગાકાર કરીને તેમને દૂર કરો.</entry>
    <entry><m:math><m:mfrac><m:mrow><m:mn>7</m:mn><m:mo>·</m:mo><m:mn>6</m:mn><m:mo>·</m:mo><m:mn>2</m:mn></m:mrow><m:mrow><m:mn>6</m:mn><m:mo>·</m:mo><m:mn>7</m:mn></m:mrow></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>સાદું રૂપ આપો.</entry>
    <entry><m:math><m:mn>2</m:mn></m:math></entry>
  </row>
</tbody>
</tgroup>
</table>
</solution>
</exercise>
</example><note id="fs-id1170654866360" class="try">
<exercise id="fs-id1170655213968">
<problem id="fs-id1170655213970">
<para id="fs-id1170655213972">સાદું રૂપ આપો: <m:math><m:mrow><m:mfrac><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655166560">
<para id="fs-id1170655166563">2</para>
</solution>
</exercise>
</note>
<note id="fs-id1170655170172" class="try">
<exercise id="fs-id1170655027366">
<problem id="fs-id1170655027368">
<para id="fs-id1170655232373">સાદું રૂપ આપો: <m:math><m:mrow><m:mfrac><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655224374">
<para id="fs-id1170655154600"><m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>7</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1170654982278">
<title>અપૂર્ણાંકવાળી ચલ પદાવલીઓની કિંમત શોધો</title>
<para id="fs-id1170654943331">આપણે અગાઉ પદાવલીઓની કિંમત શોધી છે; હવે અપૂર્ણાંકવાળી પદાવલીઓની કિંમત શોધી શકીએ છીએ. યાદ રાખો કે પદાવલીની કિંમત શોધવા તેમાં ચલની કિંમત મૂકી પછી સાદું રૂપ આપીએ છીએ.</para>
<example id="fs-id1170654920098">
<exercise id="fs-id1170654920100">
<problem id="fs-id1170654920102">
<para id="fs-id1170655151128">કિંમત શોધો: <m:math><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math> જ્યારે <span class="token">ⓐ</span> <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655151791"><title>ઉકેલ</title>
<list id="fs-id1166425002264" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> પદાવલી <m:math><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math>ની કિંમત શોધવા, જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>,</m:mo></m:mrow></m:math> પદાવલીમાં મૂકવાની કિંમત છે <m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math>; આ કિંમત આ ચલની જગ્યાએ મૂકો: <m:math><m:mi>x</m:mi></m:math>.<newline />
<table id="eip-id1169754119484" class="unnumbered unstyled can-break" aria-label="પહેલી હરોળમાં x + 1/3 છે. પછી ‘xની જગ્યાએ −1/3 મૂકો.’ સૂચના છે અને −1/3 + 1/3 મળે છે. આગળ ‘સાદું રૂપ આપો.’ છે અને જવાબ 0 મળે છે."><label /><tgroup cols="2">
 <tbody>
  <row>
    <entry />
    <entry><media id="eip-id1169754119503" alt="x + 1/3 પદાવલી દર્શાવેલી છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_005b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry><media id="eip-id1169754119516" alt="ચિત્રમાં ‘xની જગ્યાએ −1/3 મૂકો.’ સૂચના છે; −1/3 લાલ રંગે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_005a_img_new.jpg" /></media> </entry>
    <entry><media id="eip-id1169754060494" alt="−1/3 + 1/3 પદાવલી દર્શાવે છે કે સંખ્યા અને તેની વિરોધી સંખ્યાનો સરવાળો શૂન્ય થાય છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_005c_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>સાદું રૂપ આપો.<m:math><m:mrow><m:mspace width="18em" /></m:mrow></m:math></entry>
    <entry align="center">0</entry>
  </row>
 </tbody>
</tgroup>
</table><newline /><newline /></item>
<item><span class="token">ⓑ</span> પદાવલી <m:math><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math>ની કિંમત શોધવા, જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>,</m:mo></m:mrow></m:math> પદાવલીમાં મૂકવાની કિંમત છે <m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math>; આ કિંમત આ ચલની જગ્યાએ મૂકો: <emphasis effect="italics">x</emphasis>.<newline />
<table id="eip-id1169752950666" class="unnumbered unstyled can-break" aria-label="પહેલી હરોળમાં x + 1/3 છે. પછી ‘xની જગ્યાએ −3/4 મૂકો.’ સૂચના છે અને −3/4 + 1/3 મળે છે. આગળ ‘લઘુત્તમ સામાન્ય છેદ 12વાળા સમ અપૂર્ણાંકો તરીકે ફરી લખો.’ છે અને −(3 × 3)/(4 × 3) + (1 × 4)/(3 × 4) મળે છે. પછી ‘સાદું રૂપ આપો.’ છે અને −9/12 + 4/12 મળે છે. છેલ્લે ‘સરવાળો કરો.’ છે અને −5/12 મળે છે."><label /><tgroup cols="2">
 <tbody>
  <row>
    <entry />
    <entry><media id="eip-id1169750875592" alt="સફેદ પૃષ્ઠભૂમિ પર કાળા રંગે x + 1/3 પદાવલી છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_006b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry><media id="eip-id1169750875606" alt="સૂચના: ‘xની જગ્યાએ −3/4 મૂકો.’ અપૂર્ણાંક −3/4 લાલ રંગે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_006a_img_new.jpg" /></media></entry>
    <entry><media id="eip-id1169750580487" alt="−3/4 + 1/3 પદાવલી છે. પહેલો આખો અપૂર્ણાંક −3/4, તેના ઋણ ચિહ્ન અને રેખા સહિત, લાલ છે; + અને 1/3 કાળા છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_006c_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>લઘુત્તમ સામાન્ય છેદ 12વાળા સમ અપૂર્ણાંકો તરીકે ફરી લખો.</entry>
    <entry><media id="eip-id1169750580506" alt="−3/4 અને 1/3નો સરવાળો કરવાનું પદાવલી છે. છેદ 12 બનાવવા અવયવો વડે ગુણ્યું છે: −(3 × 3)/(4 × 3) + (1 × 4)/(3 × 4)."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_006d_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>સાદું રૂપ આપો.</entry>
    <entry><media id="eip-id1169752933600" alt="સમાન છેદવાળા બે અપૂર્ણાંકોનો સરવાળો છે: −9/12 + 4/12."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_006e_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>સરવાળો કરો.</entry>
    <entry align="center"><m:math><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mn>12</m:mn></m:mfrac></m:math></entry>
  </row>
 </tbody>
</tgroup>
</table></item>
</list></solution>
</exercise>
</example>
<note id="fs-id1170654943572" class="try">
<exercise id="fs-id1170655029356">
<problem id="fs-id1170655029358">
<para id="fs-id1170655029360">કિંમત શોધો: <m:math><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math> જ્યારે <span class="token">ⓐ</span> <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>7</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655081366">
<para id="fs-id1170655081368"><span class="token">ⓐ</span> <m:math><m:mrow><m:mn>−1</m:mn></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170654937339" class="try">
<exercise id="fs-id1170654937342">
<problem id="fs-id1170654905739">
<para id="fs-id1170654905741">કિંમત શોધો: <m:math><m:mrow><m:mi>y</m:mi><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math> જ્યારે <span class="token">ⓐ</span> <m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655174530">
<para id="fs-id1170654953613"><span class="token">ⓐ</span> <m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>4</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<example id="fs-id1170655348072">
<exercise id="fs-id1170655348074"><problem id="fs-id1170655348076">
<para id="fs-id1170655192239">કિંમત શોધો: <m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>−</m:mo><m:mi>y</m:mi></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655029899">
<title>ઉકેલ</title>
<table id="eip-id1169750824026" class="unnumbered unstyled" aria-label="પહેલી હરોળમાં −5/6 − y છે. પછી ‘yની જગ્યાએ −2/3 મૂકો.’ સૂચના છે અને −5/6 − (−2/3) મળે છે. આગળ ‘લઘુત્તમ સામાન્ય છેદ 6વાળા સમ અપૂર્ણાંકો તરીકે ફરી લખો.’ છે અને −5/6 − (−4/6) મળે છે. પછી ‘બાદબાકી કરો.’ છે અને (−5 − (−4))/6 મળે છે. છેલ્લે ‘સાદું રૂપ આપો.’ છે અને −1/6 મળે છે."><label /><tgroup cols="2">
 <tbody>
  <row>
    <entry />
    <entry><media id="eip-id1169750785591" alt="સફેદ પૃષ્ઠભૂમિ પર કાળા રંગે −5/6 − y પદાવલી છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_007b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry><media id="eip-id1169750785605" alt="ચિત્રમાં કાળા સાદા અક્ષરે ‘yની જગ્યાએ −2/3 મૂકો.’ સૂચના છે; અપૂર્ણાંક −2/3 લાલ રંગે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_007a_img_new.jpg" /></media></entry>
    <entry><media id="eip-id1169750785615" alt="બે ઋણ અપૂર્ણાંકોની બાદબાકી −5/6 − (−2/3) છે. બીજો અપૂર્ણાંક −2/3 કૌંસમાં છે અને લાલ રંગે દર્શાવ્યો છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_007c_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>લઘુત્તમ સામાન્ય છેદ 6વાળા સમ અપૂર્ણાંકો તરીકે ફરી લખો.         </entry>
    <entry><media id="eip-id1169750995278" alt="−5/6 − (−4/6) બાદબાકી છે. બીજો અપૂર્ણાંક કૌંસમાં છે અને લાલ રંગે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_007d_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>બાદબાકી કરો.</entry>
    <entry><media id="eip-id1169750995294" alt="અપૂર્ણાંક (−5 − (−4))/6 દર્શાવ્યો છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_007e_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>સાદું રૂપ આપો.</entry>
    <entry align="center"><m:math><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac></m:math></entry>
  </row>
 </tbody>
</tgroup>
</table>
</solution>
</exercise></example>
<note id="fs-id1170654942701" class="try">
<exercise id="fs-id1170654942704">
<problem id="fs-id1170655166333">
<para id="fs-id1170655166336">કિંમત શોધો: <m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>−</m:mo><m:mi>y</m:mi></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655189969">
<para id="fs-id1170655189972"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170655232453" class="try">
<exercise id="fs-id1170655112591">
<problem id="fs-id1170655112594">
<para id="fs-id1170655112596">કિંમત શોધો: <m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>−</m:mo><m:mi>y</m:mi></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654972309">
<para id="fs-id1170654972312"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<example id="fs-id1170655120760">
<exercise id="fs-id1170655120762">
<problem id="fs-id1170655120764">
<para id="fs-id1170655108542">કિંમત શોધો: <m:math><m:mrow><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>y</m:mi></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math> અને <m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654969427">
<title>ઉકેલ</title>
<para id="fs-id1170655193059">પદાવલીમાં આપેલી કિંમતો મૂકો.<newline />
<table id="eip-id1169751865150" class="unnumbered unstyled" aria-label="પહેલી હરોળમાં 2x²y છે. પછી ‘xની જગ્યાએ 1/4 અને yની જગ્યાએ −2/3 મૂકો.’ સૂચના છે. તેથી 2(1/4)²(−2/3) મળે છે. આગળ ‘પહેલાં ઘાતોની કિંમત શોધો.’ છે અને 2(1/16)(−2/3) મળે છે. પછી ‘ગુણાકાર કરો. સામાન્ય અવયવોનો ભાગાકાર કરીને તેમને દૂર કરો.’ છે; સામાન્ય અવયવો પર રેખા દોરેલી છે. છેલ્લે ‘સાદું રૂપ આપો.’ છે અને −1/12 મળે છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry align="center"><m:math><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mi>y</m:mi></m:math></entry>
  </row>
  <row>
    <entry><media id="eip-id1169754068123" alt="સૂચના છે: ‘xની જગ્યાએ 1/4 અને yની જગ્યાએ −2/3 મૂકો.’ 1/4 લાલ અને −2/3 આછા વાદળી રંગે છે, બાકીનું લખાણ કાળું છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_008a_img_new.jpg" /></media></entry>
    <entry align="center"><media id="eip-id1169754138748" alt="2, (1/4)² અને −2/3નો ગુણાકાર છે. 1/4 લાલ અને −2/3 વાદળી રંગે દર્શાવ્યાં છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_008b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>પહેલાં ઘાતોની કિંમત શોધો.</entry>
    <entry align="center"><m:math><m:mn>2</m:mn><m:mo>(</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>16</m:mn></m:mfrac><m:mo>)</m:mo><m:mo>(</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>)</m:mo></m:math></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરો. સામાન્ય અવયવોનો ભાગાકાર કરીને તેમને દૂર કરો. ધ્યાન આપો કે 16ને લખીએ છીએ <m:math><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>4</m:mn></m:math> જેથી સામાન્ય અવયવો સહેલાઈથી દૂર કરી શકાય.</entry>
    <entry align="center"><m:math><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:menclose notation="updiagonalstrike"><m:mn>2</m:mn></m:menclose><m:mo>⋅</m:mo><m:mn>1</m:mn><m:mo>⋅</m:mo><m:menclose notation="updiagonalstrike"><m:mn>2</m:mn></m:menclose></m:mrow><m:mrow><m:menclose notation="updiagonalstrike"><m:mn>2</m:mn></m:menclose><m:mo>⋅</m:mo><m:menclose notation="updiagonalstrike"><m:mn>2</m:mn></m:menclose><m:mo>⋅</m:mo><m:mn>4</m:mn><m:mo>⋅</m:mo><m:mn>3</m:mn></m:mrow></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>સાદું રૂપ આપો.</entry>
    <entry align="center"><m:math><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>12</m:mn></m:mfrac></m:math></entry>
  </row>
 </tbody>

</tgroup>
</table></para></solution>
</exercise>
</example>
<note id="fs-id1170655162702" class="try">
<exercise id="fs-id1170655202090">
<problem id="fs-id1170655202092">
<para id="fs-id1170655202094">કિંમત શોધો: <m:math><m:mrow><m:mn>3</m:mn><m:mi>a</m:mi><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math> અને <m:math><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655189288">
<para id="fs-id1170655189290"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170655205660" class="try">
<exercise id="fs-id1170655205663">
<problem id="fs-id1170655205665">
<para id="fs-id1170655090914">કિંમત શોધો: <m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>c</m:mi><m:mn>3</m:mn></m:msup><m:mi>d</m:mi></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>c</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math> અને <m:math><m:mrow><m:mi>d</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>4</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655170246">
<para id="fs-id1170654939677"><m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<para id="fs-id1170654904864">આગળના ઉદાહરણમાં માત્ર ચલો હશે, અચળ સંખ્યાઓ નહીં.</para>
<example id="fs-id1170654904867">
<exercise id="fs-id1170654904870">
<problem id="fs-id1170655121184">
<para id="fs-id1170655121186">કિંમત શોધો: <m:math><m:mrow><m:mfrac><m:mrow><m:mi>p</m:mi><m:mo>+</m:mo><m:mi>q</m:mi></m:mrow><m:mi>r</m:mi></m:mfrac></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>p</m:mi><m:mo>=</m:mo><m:mn>−4</m:mn><m:mo>,</m:mo><m:mi>q</m:mi><m:mo>=</m:mo><m:mn>−2</m:mn><m:mo>,</m:mo><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>8</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655112870">
<title>ઉકેલ</title>
<para id="fs-id1170655189822">પદાવલી <m:math><m:mrow><m:mfrac><m:mrow><m:mi>p</m:mi><m:mo>+</m:mo><m:mi>q</m:mi></m:mrow><m:mi>r</m:mi></m:mfrac></m:mrow></m:math>ની કિંમત શોધવા આપેલી ચલકિંમતો વાપરીએ: <m:math><m:mrow><m:mi>p</m:mi><m:mo>=</m:mo><m:mn>−4</m:mn><m:mo>,</m:mo><m:mi>q</m:mi><m:mo>=</m:mo><m:mn>−2</m:mn><m:mo>,</m:mo><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>8</m:mn><m:mo>,</m:mo></m:mrow></m:math> આ કિંમતો પદાવલીમાં મૂકીએ.<newline /><table id="eip-id1169753258394" class="unnumbered unstyled" aria-label="પહેલી હરોળમાં (p + q)/r છે. પછી ‘pની જગ્યાએ −4, qની જગ્યાએ −2 અને rની જગ્યાએ 8 મૂકો.’ સૂચના છે. તેથી (−4 + (−2))/8 મળે છે. આગળ ‘પહેલાં અંશમાં સરવાળો કરો.’ છે અને −6/8 મળે છે. છેલ્લે ‘સાદું રૂપ આપો.’ છે અને −3/4 મળે છે.">
<label /><tgroup cols="2">
 <tbody>
  <row>
    <entry />
    <entry align="center"><m:math><m:mfrac><m:mrow><m:mi>p</m:mi><m:mo>+</m:mo><m:mi>q</m:mi></m:mrow><m:mi>r</m:mi></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry><media id="eip-id1169750995237" alt="સૂચના છે: ‘pની જગ્યાએ −4, qની જગ્યાએ −2 અને rની જગ્યાએ 8 મૂકો.’ −4 લાલ, −2 પીરોજી અને 8 પીળાશવાળા લીલા રંગે દર્શાવ્યાં છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_009a_img_new.jpg" /></media></entry>
    <entry align="center"><media id="eip-id1169750995249" alt="અપૂર્ણાંકમાં અંશ −4 + (−2) છે અને છેદ 8 છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_06_009b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>પહેલાં અંશમાં સરવાળો કરો.</entry>
    <entry align="center"><m:math><m:mfrac><m:mn>−6</m:mn><m:mn>8</m:mn></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>સાદું રૂપ આપો.</entry>
    <entry align="center"><m:math><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:math></entry>
  </row>
 </tbody>
</tgroup>
</table></para></solution>
</exercise>
</example>
<note id="fs-id1170655029554" class="try">
<exercise id="fs-id1170655121360">
<problem id="fs-id1170655121362">
<para id="fs-id1170655121364">કિંમત શોધો: <m:math><m:mrow><m:mfrac><m:mrow><m:mi>a</m:mi><m:mo>+</m:mo><m:mi>b</m:mi></m:mrow><m:mi>c</m:mi></m:mfrac></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>−8</m:mn><m:mo>,</m:mo><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>−7</m:mn><m:mo>,</m:mo><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mi>c</m:mi><m:mo>=</m:mo><m:mn>6</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654940661">
<para id="fs-id1170654977155"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170654941964" class="try">
<exercise id="fs-id1170654941968">
<problem id="fs-id1170654966036">
<para id="fs-id1170654966038">કિંમત શોધો: <m:math><m:mrow><m:mfrac><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi></m:mrow><m:mi>z</m:mi></m:mfrac></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>9</m:mn><m:mo>,</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>−18</m:mn><m:mo>,</m:mo><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mi>z</m:mi><m:mo>=</m:mo><m:mn>−6</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655083076">
<para id="fs-id1170655083078"><m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1170654936699" class="key-concepts">
<title>મુખ્ય ખ્યાલો</title>
<list id="fs-id1170655194091" list-type="bulleted" bullet-style="bullet">
<item><emphasis effect="bold">અપૂર્ણાંકોનો સરવાળો અને બાદબાકી:</emphasis> જો <m:math><m:mrow><m:mi>a</m:mi><m:mo>,</m:mo><m:mi>b</m:mi><m:mo>,</m:mo><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mi>c</m:mi></m:mrow></m:math> એવી સંખ્યાઓ હોય કે <m:math><m:mrow><m:mi>c</m:mi><m:mo>≠</m:mo><m:mn>0</m:mn><m:mo>,</m:mo></m:mrow></m:math> તો<newline />
<m:math><m:mrow><m:mfrac><m:mi>a</m:mi><m:mi>c</m:mi></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mi>b</m:mi><m:mi>c</m:mi></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mi>a</m:mi><m:mo>+</m:mo><m:mi>b</m:mi></m:mrow><m:mi>c</m:mi></m:mfrac></m:mrow></m:math> અને <m:math><m:mrow><m:mfrac><m:mi>a</m:mi><m:mi>c</m:mi></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mi>b</m:mi><m:mi>c</m:mi></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mi>a</m:mi><m:mo>−</m:mo><m:mi>b</m:mi></m:mrow><m:mi>c</m:mi></m:mfrac><m:mo>.</m:mo></m:mrow></m:math><newline />
અપૂર્ણાંકોનો સરવાળો કે બાદબાકી કરવા અંશોનો સરવાળો કે બાદબાકી કરો અને પરિણામને સમાન છેદની ઉપર લખો.</item>
<item><emphasis effect="bold">અપૂર્ણાંકોના સરવાળા કે બાદબાકી માટેની રીત</emphasis>
<list id="fs-id1170654966823" list-type="enumerated" number-style="arabic" class="stepwise">
<item>શું તેમના છેદ સમાન છે?<newline />
હા—પગલું 2 પર જાઓ.<newline />
ના—દરેક અપૂર્ણાંકને લઘુત્તમ સામાન્ય છેદ સાથે ફરી લખો. પહેલાં લઘુત્તમ સામાન્ય છેદ શોધો. દરેક અપૂર્ણાંકને તે છેદવાળા સમ અપૂર્ણાંકમાં ફેરવો.</item>
<item>અપૂર્ણાંકોનો સરવાળો કે બાદબાકી કરો.</item>
<item>શક્ય હોય તો સાદું રૂપ આપો. અપૂર્ણાંકોના ગુણાકાર કે ભાગાકાર માટે લઘુત્તમ સામાન્ય છેદ જરૂરી નથી. સરવાળા કે બાદબાકી માટે સમાન છેદ જરૂરી છે; લઘુત્તમ સામાન્ય છેદ લેવાથી ગણતરી સરળ રહે છે.</item>
</list></item>
<item><emphasis effect="bold">જટિલ અપૂર્ણાંકોને સાદું રૂપ આપો</emphasis>
<list id="fs-id1170655260316" list-type="enumerated" number-style="arabic" class="stepwise">
<item>અંશને સાદું રૂપ આપો.</item>
<item>છેદને સાદું રૂપ આપો.</item>
<item>અંશને છેદ વડે ભાગો. શક્ય હોય તો સાદું રૂપ આપો.</item>
</list></item></list>
</section>
<section id="fs-id1170655192791" class="section-exercises">
<section id="fs-id1170655192794" class="practice-perfect">
<title>અભ્યાસથી કુશળતા મેળવો</title>
<para id="fs-id1170654966718"><emphasis effect="bold">સમાન છેદવાળા અપૂર્ણાંકોનો સરવાળો અને બાદબાકી કરો</emphasis></para>
<para id="fs-id1166425099458">નીચેના અભ્યાસોમાં સરવાળો કરો.</para>
<exercise id="fs-id1170655121728">
<problem id="fs-id1170655121730">
<para id="fs-id1170655133079"><m:math><m:mrow><m:mfrac><m:mn>6</m:mn><m:mrow><m:mn>13</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>13</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655082222">
<para id="fs-id1170655082224"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>13</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170654953796">
<problem id="fs-id1170655174591">
<para id="fs-id1170655174593"><m:math><m:mrow><m:mfrac><m:mn>4</m:mn><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170654985926">
<problem id="fs-id1170654985929">
<para id="fs-id1170654985931"><m:math><m:mrow><m:mfrac><m:mi>x</m:mi><m:mn>4</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170653192982">
<para id="fs-id1170653192984"><m:math><m:mrow><m:mfrac><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655105587">
<problem id="fs-id1170655105589">
<para id="fs-id1170655201232"><m:math><m:mrow><m:mfrac><m:mn>8</m:mn><m:mi>q</m:mi></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>6</m:mn><m:mi>q</m:mi></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170654941110">
<problem id="fs-id1170654941112">
<para id="fs-id1170655082122"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mrow><m:mn>16</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>16</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654997468">
<para id="fs-id1170654997470"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655205344">
<problem id="fs-id1170655205346">
<para id="fs-id1170655083095"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>16</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>16</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655111878">
<problem id="fs-id1170655111880">
<para id="fs-id1170655111882"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>8</m:mn><m:mrow><m:mn>17</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>15</m:mn></m:mrow><m:mrow><m:mn>17</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655204353">
<para id="fs-id1170655204355"><m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>17</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655200842">
<problem id="fs-id1170655200844">
<para id="fs-id1170655200846"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>19</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mrow><m:mn>19</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655353585">
<problem id="fs-id1170655202442">
<para id="fs-id1170655202444"><m:math><m:mrow><m:mfrac><m:mn>6</m:mn><m:mrow><m:mn>13</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>10</m:mn></m:mrow><m:mrow><m:mn>13</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>12</m:mn></m:mrow><m:mrow><m:mn>13</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655065721">
<para id="fs-id1170655065723"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>16</m:mn></m:mrow><m:mrow><m:mn>13</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655202151">
<problem id="fs-id1170655202153">
<para id="fs-id1170655202156"><m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id1170655130423">નીચેના અભ્યાસોમાં બાદબાકી કરો.</para>
<exercise id="fs-id1170655130426">
<problem id="fs-id1170655155175">
<para id="fs-id1170655155177"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655192781">
<para id="fs-id1170654940837"><m:math><m:mrow><m:mfrac><m:mn>4</m:mn><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655188910">
<problem id="fs-id1170655188912">
<para id="fs-id1170654984722"><m:math><m:mrow><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>13</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>4</m:mn><m:mrow><m:mn>13</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655203668">
<problem id="fs-id1170655203670">
<para id="fs-id1170655203672"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654904475">
<para id="fs-id1170654904477"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655163411">
<problem id="fs-id1170654935862">
<para id="fs-id1170654935864"><m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655068168">
<problem id="fs-id1170655068170">
<para id="fs-id1170655068172"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>19</m:mn></m:mrow><m:mrow><m:mn>21</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>4</m:mn><m:mrow><m:mn>21</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654916576">
<para id="fs-id1170654916578"><m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>7</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170654972321">
<problem id="fs-id1170654972324">
<para id="fs-id1170654972326"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mrow><m:mn>21</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>8</m:mn><m:mrow><m:mn>21</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170654932258">
<problem id="fs-id1170654932260">
<para id="fs-id1170654932223"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>5</m:mn><m:mi>y</m:mi></m:mrow><m:mn>8</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655027865">
<para id="fs-id1170655027867"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>5</m:mn><m:mi>y</m:mi><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655028946">
<problem id="fs-id1170655028948">
<para id="fs-id1170655028950"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>11</m:mn><m:mi>z</m:mi></m:mrow><m:mrow><m:mn>13</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>8</m:mn><m:mrow><m:mn>13</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170654972393">
<problem id="fs-id1170654972395">
<para id="fs-id1170654972397"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>23</m:mn></m:mrow><m:mi>u</m:mi></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>15</m:mn></m:mrow><m:mi>u</m:mi></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655098624">
<para id="fs-id1170655098626"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>38</m:mn></m:mrow><m:mi>u</m:mi></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655171216">
<problem id="fs-id1170655171218">
<para id="fs-id1170655171221"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>29</m:mn></m:mrow><m:mi>v</m:mi></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>26</m:mn></m:mrow><m:mi>v</m:mi></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170654944502">
<problem id="fs-id1170654944504">
<para id="fs-id1170654944506"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>−</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655353283">
<para id="fs-id1170655353285"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170654966055">
<problem id="fs-id1170654943499">
<para id="fs-id1170654943501"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>7</m:mn></m:mfrac><m:mo>−</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mn>7</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655190185">
<problem id="fs-id1170655190187">
<para id="fs-id1170655190189"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>7</m:mn><m:mn>9</m:mn></m:mfrac><m:mo>−</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655000137">
<para id="fs-id1170655000139"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>2</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170654943999">
<problem id="fs-id1170654944001">
<para id="fs-id1170654944003"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>8</m:mn><m:mrow><m:mn>11</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>11</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id1170654972037"><emphasis effect="bold">મિશ્ર અભ્યાસ</emphasis></para>
<para id="fs-id1166422823760">નીચેના અભ્યાસોમાં સાદું રૂપ આપો.</para>
<exercise id="fs-id1170654972043">
<problem id="fs-id1170654944036">
<para id="fs-id1170654944038"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>18</m:mn></m:mrow></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655171317">
<para id="fs-id1170655171319"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655057916">
<problem id="fs-id1170655114398">
<para id="fs-id1170655114400"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mrow><m:mn>14</m:mn></m:mrow></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170654934947">
<problem id="fs-id1170654903556">
<para id="fs-id1170654903559"><m:math><m:mrow><m:mfrac><m:mi>n</m:mi><m:mn>5</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654942753">
<para id="fs-id1170654942755"><m:math><m:mrow><m:mfrac><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655160972">
<problem id="fs-id1170655097821">
<para id="fs-id1170655097823"><m:math><m:mrow><m:mfrac><m:mn>6</m:mn><m:mrow><m:mn>11</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mi>s</m:mi><m:mrow><m:mn>11</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170654972429">
<problem id="fs-id1170654972431">
<para id="fs-id1170654972433"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>24</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>2</m:mn><m:mrow><m:mn>24</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654943393">
<para id="fs-id1170654943395"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>24</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655067983">
<problem id="fs-id1170655067985">
<para id="fs-id1170655067987"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>18</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>18</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655092068">
<problem id="fs-id1170655092070">
<para id="fs-id1170655092072"><m:math><m:mrow><m:mfrac><m:mn>8</m:mn><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mrow><m:mn>12</m:mn></m:mrow><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655126706">
<para id="fs-id1170655126708"><m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170654903816">
<problem id="fs-id1170654903819">
<para id="fs-id1170654943964"><m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>28</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id1170654962676"><emphasis effect="bold">જુદા છેદવાળા અપૂર્ણાંકોનો સરવાળો કે બાદબાકી કરો</emphasis></para>
<para id="fs-id1166422823699">નીચેના અભ્યાસોમાં સરવાળો કે બાદબાકી કરો.</para>
<exercise id="fs-id1170654944250">
<problem id="fs-id1170654944252">
<para id="fs-id1170654944255"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>7</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655213300">
<para id="fs-id1170655221169"><m:math><m:mrow><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>14</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655098723">
<problem id="fs-id1170655098725">
<para id="fs-id1170655225635"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655225709">
<problem id="fs-id1170655225711">
<para id="fs-id1170655225713"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>−</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654966289">
<para id="fs-id1170654966291"><m:math><m:mrow><m:mfrac><m:mn>4</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655082102">
<problem id="fs-id1170655082104">
<para id="fs-id1170655082106"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>−</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655027579">
<problem id="fs-id1170655027581">
<para id="fs-id1170655161616"><m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654985164">
<para id="fs-id1170654985166"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>29</m:mn></m:mrow><m:mrow><m:mn>24</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655124155">
<problem id="fs-id1170655124157">
<para id="fs-id1170655124160"><m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170654967234">
<problem id="fs-id1170654967236">
<para id="fs-id1170654967238"><m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>16</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655025293">
<para id="fs-id1170655025295"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>48</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655089091">
<problem id="fs-id1170655089093">
<para id="fs-id1170655089095"><m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>16</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655200806">
<problem id="fs-id1170655200808">
<para id="fs-id1170655200810"><m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654981980">
<para id="fs-id1170654981982"><m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>24</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655260332">
<problem id="fs-id1170655228704">
<para id="fs-id1170655228706"><m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655154378">
<problem id="fs-id1170655154380">
<para id="fs-id1170655154383"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>30</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>27</m:mn></m:mrow><m:mrow><m:mn>40</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655213332">
<para id="fs-id1170655213335"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>37</m:mn></m:mrow><m:mrow><m:mn>120</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655106783">
<problem id="fs-id1170655106785">
<para id="fs-id1170655106788"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mrow><m:mn>30</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655218228">
<problem id="fs-id1170655218231">
<para id="fs-id1170655218233"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>13</m:mn></m:mrow><m:mrow><m:mn>30</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>25</m:mn></m:mrow><m:mrow><m:mn>42</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655208056">
<para id="fs-id1170655208058"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>17</m:mn></m:mrow><m:mrow><m:mn>105</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655081183">
<problem id="fs-id1170655081185">
<para id="fs-id1170655081187"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>23</m:mn></m:mrow><m:mrow><m:mn>30</m:mn></m:mrow></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>48</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655353992">
<problem id="fs-id1170655353994">
<para id="fs-id1170655353996"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>39</m:mn></m:mrow><m:mrow><m:mn>56</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>22</m:mn></m:mrow><m:mrow><m:mn>35</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655353482">
<para id="fs-id1170655353484"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>53</m:mn></m:mrow><m:mrow><m:mn>40</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655220460">
<problem id="fs-id1170655178180">
<para id="fs-id1170655178182"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>33</m:mn></m:mrow><m:mrow><m:mn>49</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>18</m:mn></m:mrow><m:mrow><m:mn>35</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655354205">
<problem id="fs-id1170655354207">
<para id="fs-id1170655354210"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>−</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655201148">
<para id="fs-id1170655201150"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655154758">
<problem id="fs-id1170655154760">
<para id="fs-id1170655154762"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>−</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655229868">
<problem id="fs-id1170655229871">
<para id="fs-id1170655229873"><m:math><m:mrow><m:mn>1</m:mn><m:mo>+</m:mo><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654910191">
<para id="fs-id1170654910193"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>15</m:mn></m:mrow><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655200945">
<problem id="fs-id1170655200947">
<para id="fs-id1170655192446"><m:math><m:mrow><m:mn>1</m:mn><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655133636">
<problem id="fs-id1170655133638">
<para id="fs-id1170655133640"><m:math><m:mrow><m:mfrac><m:mi>x</m:mi><m:mn>3</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655202021">
<para id="fs-id1170655202023"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655027018">
<problem id="fs-id1170655027020">
<para id="fs-id1170655027022"><m:math><m:mrow><m:mfrac><m:mi>y</m:mi><m:mn>2</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655343886">
<problem id="fs-id1170655343888">
<para id="fs-id1170655343890"><m:math><m:mrow><m:mfrac><m:mi>y</m:mi><m:mn>4</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654966423">
<para id="fs-id1170654966425"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>5</m:mn><m:mi>y</m:mi><m:mo>−</m:mo><m:mn>12</m:mn></m:mrow><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655204255">
<problem id="fs-id1170655068764">
<para id="fs-id1170655068766"><m:math><m:mrow><m:mfrac><m:mi>x</m:mi><m:mn>5</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id1170655098762"><emphasis effect="bold">મિશ્ર અભ્યાસ</emphasis></para>
<para id="fs-id1166424777198">નીચેના અભ્યાસોમાં સાદું રૂપ આપો.</para>
<exercise id="fs-id1170655098768">
<problem id="fs-id1170655098770">
<para id="fs-id1170655098772"><span class="token">ⓐ</span> <m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654983142">
<para id="fs-id1170654983144"><span class="token">ⓐ</span> <m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math> <span class="token">ⓑ</span> 4</para>
</solution>
</exercise>
<exercise id="fs-id1170655041719">
<problem id="fs-id1170655041721">
<para id="fs-id1170655041723"><span class="token">ⓐ</span> <m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655105139">
<problem id="fs-id1170655188992">
<para id="fs-id1170655188994"><span class="token">ⓐ</span> <m:math><m:mrow><m:mfrac><m:mrow><m:mn>5</m:mn><m:mi>n</m:mi></m:mrow><m:mn>6</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>8</m:mn><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mfrac><m:mrow><m:mn>5</m:mn><m:mi>n</m:mi></m:mrow><m:mn>6</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>8</m:mn><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654956948">
<para id="fs-id1170654956950"><span class="token">ⓐ</span> <m:math><m:mrow><m:mfrac><m:mrow><m:mn>25</m:mn><m:mi>n</m:mi></m:mrow><m:mrow><m:mn>16</m:mn></m:mrow></m:mfrac></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mfrac><m:mrow><m:mn>25</m:mn><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>16</m:mn></m:mrow><m:mrow><m:mn>30</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170654986152">
<problem id="fs-id1170654986154">
<para id="fs-id1170654986156"><span class="token">ⓐ</span> <m:math><m:mrow><m:mfrac><m:mrow><m:mn>3</m:mn><m:mi>a</m:mi></m:mrow><m:mn>8</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mfrac><m:mrow><m:mn>3</m:mn><m:mi>a</m:mi></m:mrow><m:mn>8</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655098138">
<problem id="fs-id1170655098140">
<para id="fs-id1170655098142"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>÷</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654942717">
<para id="fs-id1170654942719"><m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170654903422">
<problem id="fs-id1170654903424">
<para id="fs-id1170654903426"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac><m:mo>÷</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655026625">
<problem id="fs-id1170655026627">
<para id="fs-id1170655026629"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655163031">
<para id="fs-id1170655163033"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>24</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655178139">
<problem id="fs-id1170655178141">
<para id="fs-id1170655178143"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170654944656">
<problem id="fs-id1170655085542">
<para id="fs-id1170655085544"><m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654944148">
<para id="fs-id1170654944151"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>13</m:mn></m:mrow><m:mrow><m:mn>18</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655083928">
<problem id="fs-id1170655083930">
<para id="fs-id1170655083932"><m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>9</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170654943928">
<problem id="fs-id1170654943930">
<para id="fs-id1170654943932"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mi>y</m:mi><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654903226">
<para id="fs-id1170654903228"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>−28</m:mn><m:mo>−</m:mo><m:mn>15</m:mn><m:mi>y</m:mi></m:mrow><m:mrow><m:mn>60</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170654966208">
<problem id="fs-id1170654966210">
<para id="fs-id1170654966212"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mi>x</m:mi><m:mrow><m:mn>11</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170654924538">
<problem id="fs-id1170654924540">
<para id="fs-id1170654924542"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>12</m:mn><m:mi>a</m:mi></m:mrow></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mrow><m:mn>9</m:mn><m:mi>a</m:mi></m:mrow><m:mrow><m:mn>16</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654905523">
<para id="fs-id1170654905525"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>33</m:mn></m:mrow><m:mrow><m:mn>64</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170654943686">
<problem id="fs-id1170654943688">
<para id="fs-id1170654943690"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>10</m:mn><m:mi>y</m:mi></m:mrow><m:mrow><m:mn>13</m:mn></m:mrow></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>8</m:mn><m:mrow><m:mn>15</m:mn><m:mi>y</m:mi></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id1170655203631"><emphasis effect="bold">ક્રિયાઓનો ક્રમ વાપરીને જટિલ અપૂર્ણાંકોને સાદું રૂપ આપો</emphasis></para>
<para id="fs-id1166422535949">નીચેના અભ્યાસોમાં સાદું રૂપ આપો.</para>
<exercise id="fs-id1170654962656">
<problem id="fs-id1170654962658">
<para id="fs-id1170654962660"><m:math><m:mrow><m:mfrac><m:mrow><m:msup><m:mn>2</m:mn><m:mn>3</m:mn></m:msup><m:mo>+</m:mo><m:msup><m:mn>4</m:mn><m:mn>2</m:mn></m:msup></m:mrow><m:mrow><m:msup><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow><m:mn>2</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655089912">
<para id="fs-id1170655106752">54</para>
</solution>
</exercise>
<exercise id="fs-id1170655106757">
<problem id="fs-id1170655106759">
<para id="fs-id1170655106762"><m:math><m:mrow><m:mfrac><m:mrow><m:msup><m:mn>3</m:mn><m:mn>3</m:mn></m:msup><m:mo>−</m:mo><m:msup><m:mn>3</m:mn><m:mn>2</m:mn></m:msup></m:mrow><m:mrow><m:msup><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow><m:mn>2</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655068053">
<problem id="fs-id1170655068056">
<para id="fs-id1170655068058"><m:math><m:mrow><m:mfrac><m:mrow><m:msup><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow><m:mn>2</m:mn></m:msup></m:mrow><m:mrow><m:msup><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>7</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow><m:mn>2</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655218531">
<para id="fs-id1170655218533"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>49</m:mn></m:mrow><m:mrow><m:mn>25</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170654962648">
<problem id="fs-id1170654962650">
<para id="fs-id1170654962573"><m:math><m:mrow><m:mfrac><m:mrow><m:msup><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow><m:mn>2</m:mn></m:msup></m:mrow><m:mrow><m:msup><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow><m:mn>2</m:mn></m:msup></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655161753">
<problem id="fs-id1170655161755">
<para id="fs-id1170655114586"><m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654904194">
<para id="fs-id1170654904197"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>15</m:mn></m:mrow><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655075787">
<problem id="fs-id1170655075790">
<para id="fs-id1170655075792"><m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655399662">
<problem id="fs-id1170655399664">
<para id="fs-id1170655399666"><m:math><m:mrow><m:mfrac><m:mrow><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655207980">
<para id="fs-id1170654903585"><m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>21</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170654903598">
<problem id="fs-id1170655130167">
<para id="fs-id1170655130170"><m:math><m:mrow><m:mfrac><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655125698">
<problem id="fs-id1170654904205">
<para id="fs-id1170654904207"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654905644">
<para id="fs-id1170654905646"><m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170654905658">
<problem id="fs-id1170655068693">
<para id="fs-id1170655068695"><m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>·</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655076403">
<problem id="fs-id1170655076405">
<para id="fs-id1170655076407"><m:math><m:mrow><m:mn>1</m:mn><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655076434">
<para id="fs-id1170655171087"><m:math><m:mrow><m:mn>−5</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655171096">
<problem id="fs-id1170655171098">
<para id="fs-id1170655171100"><m:math><m:mrow><m:mn>1</m:mn><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>÷</m:mo><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655232559">
<problem id="fs-id1170655232561">
<para id="fs-id1170655232563"><m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655074337">
<para id="fs-id1170655074340"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>19</m:mn></m:mrow><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170654962256">
<problem id="fs-id1170654962258">
<para id="fs-id1170654962261"><m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655133613">
<problem id="fs-id1170655133615">
<para id="fs-id1170655133617"><m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655124175">
<para id="fs-id1170655124177"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>23</m:mn></m:mrow><m:mrow><m:mn>24</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655205620">
<problem id="fs-id1170655205622">
<para id="fs-id1170655205625"><m:math><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655220415">
<problem id="fs-id1170655220417">
<para id="fs-id1170655220419"><m:math><m:mrow><m:mn>12</m:mn><m:mrow><m:mo>(</m:mo><m:mrow><m:mfrac><m:mn>9</m:mn><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>4</m:mn><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655076623">
<para id="fs-id1170655076625"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655216009">
<problem id="fs-id1170655216011">
<para id="fs-id1170655216013"><m:math><m:mrow><m:mn>8</m:mn><m:mrow><m:mo>(</m:mo><m:mrow><m:mfrac><m:mrow><m:mn>15</m:mn></m:mrow><m:mrow><m:mn>16</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655096364">
<problem id="fs-id1170655096366">
<para id="fs-id1170655170263"><m:math><m:mrow><m:mfrac><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow><m:mrow><m:mfrac><m:mrow><m:mn>19</m:mn></m:mrow><m:mrow><m:mn>24</m:mn></m:mrow></m:mfrac></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655193920">
<para id="fs-id1170655193922">1</para>
</solution>
</exercise>
<exercise id="fs-id1170655193927">
<problem id="fs-id1170655193929">
<para id="fs-id1170655193932"><m:math><m:mrow><m:mfrac><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>3</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac></m:mrow><m:mrow><m:mfrac><m:mrow><m:mn>14</m:mn></m:mrow><m:mrow><m:mn>30</m:mn></m:mrow></m:mfrac></m:mrow></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170654985378">
<problem id="fs-id1170654985380">
<para id="fs-id1170654985382"><m:math><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>9</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>÷</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654878303">
<para id="fs-id1170654878305"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>13</m:mn></m:mrow><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170654915619">
<problem id="fs-id1170654915621">
<para id="fs-id1170655201500"><m:math><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac><m:mo>+</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>÷</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id1170654962554"><emphasis effect="bold">અપૂર્ણાંકવાળી ચલ પદાવલીઓની કિંમત શોધો</emphasis></para>
<para id="fs-id1166422832732">નીચેના અભ્યાસોમાં કિંમત શોધો.</para>
<exercise id="fs-id1170654962561">
<problem id="fs-id1170654962563">
<para id="fs-id1170654962565"><m:math><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math> જ્યારે<newline /><span class="token">ⓐ</span> <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math><newline /><span class="token">ⓑ</span> <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>6</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655098979">
<para id="fs-id1170655155308"><span class="token">ⓐ</span> <m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mn>−1</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655068186">
<problem id="fs-id1170655068188">
<para id="fs-id1170655068190"><m:math><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math> જ્યારે<newline /><span class="token">ⓐ</span> <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>11</m:mn></m:mrow><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac></m:mrow></m:math><span class="token">ⓑ</span> <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655208010">
<problem id="fs-id1170655207239">
<para id="fs-id1170655207242"><m:math><m:mrow><m:mi>x</m:mi><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>2</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math> જ્યારે <span class="token">ⓐ</span> <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655092730">
<para id="fs-id1170655162990"><span class="token">ⓐ</span> <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mn>−1</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655150662">
<problem id="fs-id1170655150664">
<para id="fs-id1170655150666"><m:math><m:mrow><m:mi>x</m:mi><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math> જ્યારે <span class="token">ⓐ</span> <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655084158">
<problem id="fs-id1170655084160">
<para id="fs-id1170655084163"><m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mi>w</m:mi></m:mrow></m:math> જ્યારે <span class="token">ⓐ</span> <m:math><m:mrow><m:mi>w</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mi>w</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655199118">
<para id="fs-id1170655199120"><span class="token">ⓐ</span> <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mfrac><m:mn>6</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655096152">
<problem id="fs-id1170655215512">
<para id="fs-id1170655215514"><m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>12</m:mn></m:mrow></m:mfrac><m:mo>−</m:mo><m:mi>w</m:mi></m:mrow></m:math> જ્યારે <span class="token">ⓐ</span> <m:math><m:mrow><m:mi>w</m:mi><m:mo>=</m:mo><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mi>w</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170654964911">
<problem id="fs-id1170654964913">
<para id="fs-id1170654964915"><m:math><m:mrow><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac></m:mrow></m:math> અને <m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655353873">
<para id="fs-id1170655353875"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>9</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655098040">
<problem id="fs-id1170655098043">
<para id="fs-id1170655098045"><m:math><m:mrow><m:mn>8</m:mn><m:msup><m:mi>u</m:mi><m:mn>2</m:mn></m:msup><m:msup><m:mi>v</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>u</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math> અને <m:math><m:mrow><m:mi>v</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655084210">
<problem id="fs-id1170655061622">
<para id="fs-id1170655061624"><m:math><m:mrow><m:mfrac><m:mrow><m:mi>a</m:mi><m:mo>+</m:mo><m:mi>b</m:mi></m:mrow><m:mrow><m:mi>a</m:mi><m:mo>−</m:mo><m:mi>b</m:mi></m:mrow></m:mfrac></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>−3</m:mn><m:mo>,</m:mo><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655066763">
<para id="fs-id1170655066765"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>11</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655074880">
<problem id="fs-id1170655074882">
<para id="fs-id1170655074884"><m:math><m:mrow><m:mfrac><m:mrow><m:mi>r</m:mi><m:mo>−</m:mo><m:mi>s</m:mi></m:mrow><m:mrow><m:mi>r</m:mi><m:mo>+</m:mo><m:mi>s</m:mi></m:mrow></m:mfrac></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>10</m:mn><m:mo>,</m:mo><m:mi>s</m:mi><m:mo>=</m:mo><m:mn>−5</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
</section>
<section id="fs-id1170655004087" class="everyday">
<title>રોજિંદા જીવનમાં ગણિત</title>
<exercise id="fs-id1170655188977">
<problem id="fs-id1170655188979">
<para id="fs-id1170655188981"><emphasis effect="bold">સુશોભન</emphasis> લરોન્ડા તેના સોફાનાં નાનાં તકિયા માટે કવર બનાવે છે. દરેક કવર માટે તેને જોઈએ છે <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math> યાર્ડ છાપેલું કાપડ અને <m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math> યાર્ડ એકરંગી કાપડ. દરેક કવર માટે લરોન્ડાને કુલ કેટલું કાપડ જોઈશે?</para>
</problem>
<solution id="fs-id1170655091245">
<para id="fs-id1170655114732"><m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math> યાર્ડ</para>
</solution>
</exercise>
<exercise id="fs-id1170655114745">
<problem id="fs-id1170655114747">
<para id="fs-id1170655351777"><emphasis effect="bold">બેકિંગ</emphasis> વનેસા ચૉકલેટ ચિપ કૂકીઝ અને ઓટમીલ કૂકીઝ બનાવે છે. તેને જોઈએ છે <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>2</m:mn></m:mfrac></m:mrow></m:math> કપ ખાંડ ચૉકલેટ ચિપ કૂકીઝ માટે અને <m:math><m:mrow><m:mfrac><m:mn>1</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math> કપ ખાંડ ઓટમીલ કૂકીઝ માટે. તેને કુલ કેટલી ખાંડ જોઈશે?</para>
</problem>
</exercise>
</section>
<section id="fs-id1170655025600" class="writing">
<title>લેખન અભ્યાસ</title>
<exercise id="fs-id1170655025605">
<problem id="fs-id1170655025607">
<para id="fs-id1170655025610">અપૂર્ણાંકોનો સરવાળો કે બાદબાકી કરવા સમાન છેદ શા માટે જોઈએ? સમજાવો.</para>
</problem>
<solution id="fs-id1170655207387">
<para id="fs-id1170655207389">જવાબો જુદા હોઈ શકે</para>
</solution>
</exercise>
<exercise id="fs-id1170655207395">
<problem id="fs-id1170655207397">
<para id="fs-id1170655207399">બે અપૂર્ણાંકોનો લઘુત્તમ સામાન્ય છેદ કેવી રીતે શોધશો?</para>
</problem>
</exercise>
</section>
<section id="fs-id1170654944689">
<title>સ્વતપાસ</title>
<para id="fs-id1170654962508"><span class="token">ⓐ</span> અભ્યાસ પૂરો કર્યા પછી આ યાદી વડે તપાસો કે વિભાગનાં ઉદ્દેશ્યો તમે કેટલાં સારી રીતે શીખ્યા છો.</para>
<media id="fs-id1170654962520" alt="પાંચ હરોળ અને ચાર કૉલમવાળું કોષ્ટક છે. મથાળાની પહેલી હરોળમાં ડાબેથી ‘હું કરી શકું છું…’, ‘આત્મવિશ્વાસથી’, ‘થોડી મદદથી’ અને ‘ના—મને સમજાયું નથી!’ છે. પહેલી કૉલમની આગળની હરોળોમાં ‘જુદા છેદવાળા અપૂર્ણાંકોનો સરવાળો અને બાદબાકી કરવી’, ‘અપૂર્ણાંકો પરની ક્રિયાઓ ઓળખવી અને વાપરવી’, ‘ક્રિયાઓનો ક્રમ વાપરીને જટિલ અપૂર્ણાંકોને સાદું રૂપ આપવું’ અને ‘અપૂર્ણાંકવાળી ચલ પદાવલીઓની કિંમત શોધવી’ છે. બાકીનાં ખાનાં ખાલી છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_06_201_img_new.jpg" />
</media>
<para id="fs-id1170654962943"><span class="token">ⓑ</span> યાદી જોયા પછી તમને લાગે છે કે તમે આગળના પ્રકરણ માટે તૈયાર છો? શા માટે, અથવા શા માટે નહીં?</para>
</section>
</section>
</content>
<glossary>
<definition id="fs-id1166424922293">
<term>લઘુત્તમ સામાન્ય છેદ</term>
<meaning id="fs-id1166424922299">બે અપૂર્ણાંકોનો લઘુત્તમ સામાન્ય છેદ (LCD) તેમના છેદોનો લઘુત્તમ સામાન્ય અવયવી (LCM) છે.</meaning>
</definition>
</glossary>
</document>