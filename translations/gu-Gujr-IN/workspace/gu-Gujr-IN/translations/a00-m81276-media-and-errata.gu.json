  "source_alt_errata": [
    {
      "media_id": "eip-id1166566427476",
      "source_alt_en": "This figure shows two rows of counter circles. The first row has 2 dark pink circles, representing negative counters. The second row has 4 light pink circles, representing positive counters.",
      "faithful_source_alt_gu": "ચિત્રમાં કાઉન્ટરનાં વર્તુળની બે હરોળ છે. પહેલી હરોળમાં ઋણ કાઉન્ટર દર્શાવતાં 2 ઘેરાં ગુલાબી વર્તુળ અને બીજી હરોળમાં ધન કાઉન્ટર દર્શાવતાં 4 આછાં ગુલાબી વર્તુળ છે.",
      "actual_image_and_math_correction_gu": "ચિત્રમાં ઉપરની હરોળમાં 2 વાદળી ધન કાઉન્ટર અને નીચેની હરોળમાં 4 લાલ ઋણ કાઉન્ટર છે. બે શૂન્ય બનાવતી જોડીઓ દૂર કરતાં 2 ઋણ કાઉન્ટર બચે છે, તેથી 2 + (−4) = −2.",
      "handling": "Faithful CNXML retains the translated source alt; reader integration should surface the corrected alternative with a source note."
    },
    {
      "media_id": "fs-id1166761493978",
      "source_alt_en": "This figure shows two rows of counter circles. The first row has 2 light pink circles, representing positive counters. The second row has 4 dark pink circles, representing negative counters.",
      "faithful_source_alt_gu": "ચિત્રમાં કાઉન્ટરનાં વર્તુળની બે હરોળ છે. પહેલી હરોળમાં ધન કાઉન્ટર દર્શાવતાં 2 આછાં ગુલાબી વર્તુળ અને બીજી હરોળમાં ઋણ કાઉન્ટર દર્શાવતાં 4 ઘેરાં ગુલાબી વર્તુળ છે.",
      "actual_image_and_math_correction_gu": "ચિત્રમાં ઉપરની હરોળમાં 2 લાલ ઋણ કાઉન્ટર અને નીચેની હરોળમાં 4 વાદળી ધન કાઉન્ટર છે. બે શૂન્ય બનાવતી જોડીઓ દૂર કરતાં 2 ધન કાઉન્ટર બચે છે, તેથી (−2) + 4 = 2.",
      "handling": "Faithful CNXML retains the translated source alt; reader integration should surface the corrected alternative with a source note."
    },
    {
      "media_id": "eip-id1166567972149",
      "source_alt_en": "This figure shows two rows of counters. The first row shows 2 dark pink circles, representing negative counters. The second row has 5 light pink circles, representing negative counters. The neutral pairs of one positive and one negative counter are circled leaving three positive counters.",
      "faithful_source_alt_gu": "ચિત્રમાં કાઉન્ટરની બે હરોળ છે. પહેલી હરોળમાં ઋણ કાઉન્ટર દર્શાવતાં 2 ઘેરાં ગુલાબી વર્તુળ છે. બીજી હરોળમાં ઋણ કાઉન્ટર દર્શાવતાં 5 આછાં ગુલાબી વર્તુળ છે. એક ધન અને એક ઋણ કાઉન્ટરની શૂન્ય બનાવતી જોડીઓ ઘેરેલી છે અને ત્રણ ધન કાઉન્ટર બાકી રહે છે.",
      "actual_image_and_math_correction_gu": "ચિત્રમાં ઉપરની હરોળમાં 2 લાલ ઋણ કાઉન્ટર અને નીચેની હરોળમાં 5 વાદળી ધન કાઉન્ટર છે. બે શૂન્ય બનાવતી જોડીઓ ઘેરેલી છે અને 3 ધન કાઉન્ટર બચે છે, તેથી (−2) + 5 = 3.",
      "handling": "Faithful CNXML retains the translated source alt; reader integration should surface the corrected alternative with a source note."
    },
    {
      "media_id": "eip-id1166566346715",
      "source_alt_en": "Two distinct groups of dark-outlined gray circles are displayed on a white background: a set of three on the left and a set of five on the right.",
      "faithful_source_alt_gu": "સફેદ પૃષ્ઠભૂમિ પર ઘેરી કિનારીવાળાં રાખોડી વર્તુળનાં બે અલગ જૂથ છે: ડાબે ત્રણ અને જમણે પાંચ વર્તુળ.",
      "actual_image_and_math_correction_gu": "ત્રણ ધન કાઉન્ટર અને ચાર ધન કાઉન્ટરનાં અલગ જૂથ છે; કુલ 7 ધન કાઉન્ટર છે, તેથી 3 + 4 = 7.",
      "handling": "Faithful CNXML retains the translated source alt; reader integration should surface the corrected alternative with a source note."
    },
    {
      "media_id": "eip-id1166567843376",
      "source_alt_en": "An abstract image featuring two rows of dark grey oval shapes, with three on the left and five on the right, against a stark white background.",
      "faithful_source_alt_gu": "સફેદ પૃષ્ઠભૂમિ પર ઘેરાં રાખોડી અંડાકારની બે હરોળ છે: ડાબે ત્રણ અને જમણે પાંચ.",
      "actual_image_and_math_correction_gu": "ઉપરની હરોળમાં 4 ધન કાઉન્ટર અને નીચેની હરોળમાં 6 ઋણ કાઉન્ટર છે; ચાર શૂન્ય બનાવતી જોડીઓ દૂર કરતાં 2 ઋણ કાઉન્ટર બચે છે, તેથી 4 + (−6) = −2.",
      "handling": "Faithful CNXML retains the translated source alt; reader integration should surface the corrected alternative with a source note."
    },
    {
      "media_id": "eip-id1166568120807",
      "source_alt_en": "A row of dark grey and light grey oval shapes on a white background, with a gap separating the first two darker shapes from the subsequent lighter shapes.",
      "faithful_source_alt_gu": "સફેદ પૃષ્ઠભૂમિ પર ઘેરા અને આછા રાખોડી અંડાકારની હરોળ છે; પહેલાં બે ઘેરા અંડાકાર પછીનાં આછા અંડાકારથી અલગ છે.",
      "actual_image_and_math_correction_gu": "3 ઋણ કાઉન્ટર અને 7 ધન કાઉન્ટર છે; ત્રણ શૂન્ય બનાવતી જોડીઓ દૂર કરતાં 4 ધન કાઉન્ટર બચે છે, તેથી −3 + 7 = 4.",
      "handling": "Faithful CNXML retains the translated source alt; reader integration should surface the corrected alternative with a source note."
    },
    {
      "media_id": "eip-id1166568669200",
      "source_alt_en": "An abstract pattern featuring a row of oval shapes. Two lighter grey ovals are on the left, separated by a white space from nine darker, blue-grey ovals that continue to the right.",
      "faithful_source_alt_gu": "અંડાકારની હરોળમાં ડાબે બે આછા રાખોડી અંડાકાર અને થોડા અંતર પછી જમણી તરફ નવ ઘેરા વાદળી-રાખોડી અંડાકાર છે.",
      "actual_image_and_math_correction_gu": "2 ધન કાઉન્ટર અને 8 ઋણ કાઉન્ટર છે; બે શૂન્ય બનાવતી જોડીઓ દૂર કરતાં 6 ઋણ કાઉન્ટર બચે છે, તેથી 2 + (−8) = −6.",
      "handling": "Faithful CNXML retains the translated source alt; reader integration should surface the corrected alternative with a source note."
    },
    {
      "media_id": "eip-id1166568669215",
