<?xml version='1.0' encoding='utf-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" xml:lang="gu-Gujr-IN"><title>પૂર્ણ સંખ્યાઓનો પરિચય: વિભાગનો અભ્યાસ</title><content><section id="fs-id2279009" class="section-exercises">
<section id="fs-id2318815" class="practice-perfect">
<title>અભ્યાસથી નિપુણતા</title>
<para id="fs-id2686876"><emphasis effect="bold">ગણતરીની સંખ્યાઓ અને પૂર્ણ સંખ્યાઓ ઓળખો</emphasis> </para><para id="eip-498">નીચેના અભ્યાસમાં આપેલી સંખ્યાઓમાંથી કઈ <span class="token">ⓐ</span> ગણતરીની સંખ્યાઓ <span class="token">ⓑ</span> પૂર્ણ સંખ્યાઓ છે તે નક્કી કરો.</para><exercise id="fs-id1617693"><problem id="fs-id2475713">
<para id="fs-id1029877"><m:math><m:mrow><m:mn>0</m:mn><m:mo>,</m:mo><m:mfrac><m:mn>2</m:mn><m:mn>3</m:mn></m:mfrac><m:mo>,</m:mo><m:mn>5</m:mn><m:mo>,</m:mo><m:mn>8.1</m:mn><m:mo>,</m:mo><m:mn>125</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id2686692">
<list id="fs-id1933041" list-type="enumerated" number-style="lower-alpha" class="circled"><item><span class="token">ⓐ</span> 5, 125</item>
<item><span class="token">ⓑ</span> 0, 5, 125</item></list></solution>
</exercise><exercise id="fs-id834824">
<problem id="fs-id1566499">
<para id="fs-id1321421"><m:math><m:mrow><m:mn>0</m:mn><m:mo>,</m:mo><m:mfrac><m:mn>7</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac><m:mo>,</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>20.5</m:mn><m:mo>,</m:mo><m:mn>300</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2925019"><problem id="fs-id2186619">
<para id="fs-id1717367"><m:math><m:mrow><m:mn>0</m:mn><m:mo>,</m:mo><m:mfrac><m:mn>4</m:mn><m:mn>9</m:mn></m:mfrac><m:mo>,</m:mo><m:mn>3.9</m:mn><m:mo>,</m:mo><m:mn>50</m:mn><m:mo>,</m:mo><m:mn>221</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1932107">
<list id="fs-id2278021" list-type="enumerated" number-style="lower-alpha" class="circled"><item><span class="token">ⓐ</span> 50, 221</item>
<item><span class="token">ⓑ</span> 0, 50, 221</item></list>
</solution>
</exercise><exercise id="fs-id2134956">
<problem id="fs-id1367088">
<para id="fs-id2452665"><m:math><m:mrow><m:mn>0</m:mn><m:mo>,</m:mo><m:mfrac><m:mn>3</m:mn><m:mn>5</m:mn></m:mfrac><m:mo>,</m:mo><m:mn>10</m:mn><m:mo>,</m:mo><m:mn>303</m:mn><m:mo>,</m:mo><m:mn>422.6</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id2960237"><emphasis effect="bold">પૂર્ણ સંખ્યાઓને નમૂના દ્વારા દર્શાવો</emphasis> </para><para id="eip-954">નીચેના અભ્યાસમાં સ્થાનકિંમતની લખાવટનો ઉપયોગ કરીને <m:math><m:mrow><m:mtext>આધાર-10</m:mtext></m:mrow></m:math> ના ખંડોથી દર્શાવેલી સંખ્યાનું મૂલ્ય શોધો.</para><exercise id="fs-id1224988"><problem id="fs-id2437093">
<media id="fs-id1393361" alt="ચિત્રમાં ત્રણ પ્રકારના ભાગ છે. પહેલા ભાગમાં પાંચ ચોરસ છે; દરેક ચોરસમાં 100 ખંડ છે, 10 ખંડ પહોળાઈમાં અને 10 ખંડ ઊંચાઈમાં. બીજા ભાગમાં છ આડી સળીઓ છે; દરેકમાં 10 ખંડ છે. ત્રીજા ભાગમાં 1 અલગ ખંડ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_01_201_img.jpg" />
</media>
</problem>
<solution id="fs-id1385187">
<para id="fs-id2590572">561</para>
</solution>
</exercise><exercise id="fs-id2646862"><problem id="fs-id2805128">
<media id="fs-id1284927" alt="ચિત્રમાં ત્રણ પ્રકારના ભાગ છે. પહેલા ભાગમાં ત્રણ ચોરસ છે; દરેક ચોરસમાં 100 ખંડ છે, 10 ખંડ પહોળાઈમાં અને 10 ખંડ ઊંચાઈમાં. બીજા ભાગમાં આઠ આડી સળીઓ છે; દરેકમાં 10 ખંડ છે. ત્રીજા ભાગમાં 4 અલગ ખંડ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_01_202_img.jpg" />
</media>
</problem>
</exercise><exercise id="fs-id1462995"><problem id="fs-id2946657">
<media id="fs-id2675330" alt="ચિત્રમાં બે પ્રકારના ભાગ છે. પહેલા ભાગમાં ચાર ચોરસ છે; દરેક ચોરસમાં 100 ખંડ છે, 10 ખંડ પહોળાઈમાં અને 10 ખંડ ઊંચાઈમાં. બીજા ભાગમાં 7 અલગ ખંડ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_01_203_img.jpg" />
</media>
</problem>
<solution id="fs-id2669520">
<para id="fs-id1988320">407</para>
</solution>
</exercise><exercise id="fs-id1339977"><problem id="fs-id1577980">
<media id="fs-id2716627" alt="ચિત્રમાં બે પ્રકારના ભાગ છે. પહેલા ભાગમાં છ ચોરસ છે; દરેક ચોરસમાં 100 ખંડ છે, 10 ખંડ પહોળાઈમાં અને 10 ખંડ ઊંચાઈમાં. બીજા ભાગમાં 2 આડી સળીઓ છે; દરેકમાં 10 ખંડ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_01_204_img.jpg" />
</media>
</problem>
</exercise><para id="fs-id1362956"><emphasis effect="bold">અંકની સ્થાનકિંમત ઓળખો</emphasis> </para><para id="eip-439">નીચેના અભ્યાસમાં આપેલા અંકોની સ્થાનકિંમત શોધો.</para><exercise id="fs-id2466117"><problem id="fs-id1238472">
<para id="fs-id2375962"><m:math><m:mrow><m:mn>579,601</m:mn></m:mrow></m:math></para>
<list id="eip-id1168289429789" class="circled" list-type="enumerated" number-style="lower-alpha"><item><span class="token">ⓐ</span> 9</item>
<item><span class="token">ⓑ</span> 6</item>
<item><span class="token">ⓒ</span> 0</item>
<item><span class="token">ⓓ</span> 7</item>
<item><span class="token">ⓔ</span> 5</item>
</list>
</problem>
<solution id="fs-id2279435">
<list id="eip-id1168289429815" list-type="enumerated" class="circled" number-style="arabic"><item><span class="token">ⓐ</span> હજારનું સ્થાન</item>
<item><span class="token">ⓑ</span> સોનું સ્થાન</item>
<item><span class="token">ⓒ</span> દશકનું સ્થાન</item>
<item><span class="token">ⓓ</span> દસ હજારનું સ્થાન</item>
<item><span class="token">ⓔ</span> સો હજારનું સ્થાન</item>
</list>
</solution>
</exercise><exercise id="fs-id1522372"><problem id="fs-id1684233">
<para id="fs-id2208962"><m:math><m:mrow><m:mn>398,127</m:mn></m:mrow></m:math></para>
<list id="eip-id1168287380517" class="circled" list-type="enumerated" number-style="arabic"><item><span class="token">ⓐ</span> 9</item>
<item><span class="token">ⓑ</span> 3</item>
<item><span class="token">ⓒ</span> 2</item>
<item><span class="token">ⓓ</span> 8</item>
<item><span class="token">ⓔ</span> 7</item>
</list>
</problem>
</exercise><exercise id="fs-id2197876"><problem id="fs-id2273409">
<para id="fs-id2494777"><m:math><m:mrow><m:mn>56,804,379</m:mn></m:mrow></m:math></para>
<list id="eip-id1168288321948" class="circled" list-type="enumerated" number-style="arabic"><item><span class="token">ⓐ</span> 8</item>
<item><span class="token">ⓑ</span> 6</item>
<item><span class="token">ⓒ</span> 4</item>
<item><span class="token">ⓓ</span> 7</item>
<item><span class="token">ⓔ</span> 0</item>
</list>
</problem>
<solution id="fs-id2323011">
<list id="eip-id1168288327374" class="circled" list-type="enumerated" number-style="arabic"><item><span class="token">ⓐ</span> સો હજારનું સ્થાન</item>
<item><span class="token">ⓑ</span> મિલિયનનું સ્થાન</item>
<item><span class="token">ⓒ</span> હજારનું સ્થાન</item>
<item><span class="token">ⓓ</span> દશકનું સ્થાન</item>
<item><span class="token">ⓔ</span> દસ હજારનું સ્થાન</item>
</list>

</solution>
</exercise><exercise id="fs-id1350682"><problem id="fs-id1464316">
<para id="fs-id1948506"><m:math><m:mrow><m:mn>78,320,465</m:mn></m:mrow></m:math></para>
<list id="eip-id1168288227448" class="circled" list-type="enumerated" number-style="arabic"><item><span class="token">ⓐ</span> 8</item>
<item><span class="token">ⓑ</span> 4</item>
<item><span class="token">ⓒ</span> 2</item>
<item><span class="token">ⓓ</span> 6</item>
<item><span class="token">ⓔ</span> 7</item>
</list>
</problem>
</exercise><para id="fs-id769116"><emphasis effect="bold">સ્થાનકિંમતનો ઉપયોગ કરીને પૂર્ણ સંખ્યાઓ શબ્દોમાં કહો</emphasis> </para><para id="eip-882">નીચેના અભ્યાસમાં દરેક સંખ્યા શબ્દોમાં કહો.</para><exercise id="fs-id2221898">
<problem id="fs-id1336694">
<para id="fs-id1176880"><m:math><m:mrow><m:mn>1,078</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1231920">
<para id="fs-id1578269">એક હજાર, અઠ્ઠોતેર</para>
</solution>
</exercise>
<exercise id="fs-id1190749">
<problem id="fs-id1629686">
<para id="fs-id2702545"><m:math><m:mrow><m:mn>5,902</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1222581">
<problem id="fs-id2466500">
<para id="fs-id1193988"><m:math><m:mrow><m:mn>364,510</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id2137703">
<para id="fs-id1841547">ત્રણસો ચોસઠ હજાર, પાંચસો દસ</para>
</solution>
</exercise>
<exercise id="fs-id1822153">
<problem id="fs-id2276526">
<para id="fs-id1581240"><m:math><m:mrow><m:mn>146,023</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2908841">
<problem id="fs-id2483981">
<para id="fs-id2767318"><m:math><m:mrow><m:mn>5,846,103</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id2953088">
<para id="fs-id2703955">પાંચ મિલિયન, આઠસો છેતાલીસ હજાર, એકસો ત્રણ</para>
</solution>
</exercise>
<exercise id="fs-id1798411">
<problem id="fs-id1946634">
<para id="fs-id1611308"><m:math><m:mrow><m:mn>1,458,398</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2159905">
<problem id="fs-id2772277">
<para id="fs-id1862644"><m:math><m:mrow><m:mn>37,889,005</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1009593">
<para id="fs-id1236756">સાડત્રીસ મિલિયન, આઠસો નેવ્યાસી હજાર, પાંચ</para>
</solution>
</exercise>
<exercise id="fs-id1166761301603">
<problem id="fs-id1020409">
<para id="fs-id1543134"><m:math><m:mrow><m:mn>62,008,465</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2562890">
<problem id="fs-id3402452">
<para id="fs-id2678387">રેનિયર પર્વતની ઊંચાઈ <m:math><m:mrow><m:mn>14,410</m:mn></m:mrow></m:math> ફૂટ છે.</para>
</problem>
<solution id="fs-id2669011">
<para id="fs-id3398681">ચૌદ હજાર, ચારસો દસ</para>
</solution>
</exercise>
<exercise id="fs-id3014390">
<problem id="fs-id1213910">
<para id="fs-id4286399">એડમ્સ પર્વતની ઊંચાઈ <m:math><m:mrow><m:mn>12,276</m:mn></m:mrow></m:math> ફૂટ છે.</para>
</problem>
</exercise>
<exercise id="fs-id1341564">
<problem id="fs-id2495818">
<para id="fs-id3202675">સિત્તેર વર્ષમાં <m:math><m:mrow><m:mn>613,200</m:mn></m:mrow></m:math> કલાક થાય છે.</para>
</problem>
<solution id="fs-id1891547">
<para id="fs-id1358066">છસો તેર હજાર, બસો</para>
</solution>
</exercise>
<exercise id="fs-id1300121">
<problem id="fs-id2223819">
<para id="fs-id1633813">એક વર્ષમાં <m:math><m:mrow><m:mn>525,600</m:mn></m:mrow></m:math> મિનિટ થાય છે.</para>
</problem>
</exercise>
<exercise id="fs-id1249481">
<problem id="fs-id2198126">
<para id="fs-id1177694">અમેરિકાની વસ્તીગણતરી મુજબ માયામી-ડેડ કાઉન્ટીની વસ્તીનો અંદાજ હતો: <m:math><m:mrow><m:mn>2,617,176</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1215917">
<para id="fs-id1193287">બે મિલિયન, છસો સત્તર હજાર, એકસો છોતેર</para>
</solution>
</exercise>
<exercise id="fs-id1386002">
<problem id="fs-id1172613">
<para id="fs-id2754303">શિકાગોની વસ્તી હતી: <m:math><m:mrow><m:mn>2,718,782</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1611785">
<problem id="fs-id1893505">
<para id="fs-id1515209">આગામી પાંચ વર્ષમાં અમેરિકાની કૉલેજો અને યુનિવર્સિટીઓમાં <m:math><m:mrow><m:mn>23,867,000</m:mn></m:mrow></m:math> વિદ્યાર્થીઓ હશે એવો અંદાજ છે.</para>
</problem>
<solution id="fs-id2261866">
<para id="fs-id1166481">તેવીસ મિલિયન, આઠસો સડસઠ હજાર</para>
</solution>
</exercise>
<exercise id="fs-id1362934">
<problem id="fs-id1239323">
<para id="fs-id2670940">લગભગ બાર વર્ષ પહેલાં કેલિફોર્નિયામાં <m:math><m:mrow><m:mn>20,665,415</m:mn></m:mrow></m:math> નોંધાયેલાં મોટર વાહનો હતાં.</para>
</problem>
</exercise>
<exercise id="fs-id1339309">
<problem id="fs-id1546274">
<para id="fs-id1860576">ચીનની વસ્તી <m:math><m:mrow><m:mn>1,377,583,156</m:mn></m:mrow></m:math> સુધી પહોંચવાનો અંદાજ છે, વર્ષ <m:math><m:mrow><m:mn>2016</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1263173">
<para id="fs-id2221988">એક બિલિયન, ત્રણસો સિત્તોતેર મિલિયન, પાંચસો ત્ર્યાસી હજાર, એકસો છપ્પન</para>
</solution>
</exercise>
<exercise id="fs-id1544452">
<problem id="fs-id2443426">
<para id="fs-id2344514">ભારતની વસ્તીનો અંદાજ <m:math><m:mrow><m:mn>1,267,401,849</m:mn></m:mrow></m:math> છે, જુલાઈ <m:math><m:mrow><m:mn>1</m:mn><m:mo>,</m:mo><m:mn>2014</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id1714165"><emphasis effect="bold">સ્થાનકિંમતનો ઉપયોગ કરીને પૂર્ણ સંખ્યાઓ અંકોમાં લખો</emphasis> </para><para id="eip-849">નીચેના અભ્યાસમાં દરેક પૂર્ણ સંખ્યા અંકોમાં લખો.</para><exercise id="fs-id226532">
<problem id="fs-id1217055">
<para id="fs-id1388718">ચારસો બાર</para>
</problem>
<solution id="fs-id1227127">
<para id="fs-id3324386">412</para>
</solution>
</exercise>
<exercise id="fs-id1384471">
<problem id="fs-id1221829">
<para id="fs-id2291517">બસો ત્રેપન</para>
</problem>
</exercise>
<exercise id="fs-id1633028">
<problem id="fs-id2957960">
<para id="fs-id2135363">પાંત્રીસ હજાર, નવસો પંચોતેર</para>
</problem>
<solution id="fs-id1693609">
<para id="fs-id1828858">35,975</para>
</solution>
</exercise>
<exercise id="fs-id2760170">
<problem id="fs-id1265455">
<para id="fs-id2288048">એકસઠ હજાર, ચારસો પંદર</para>
</problem>
</exercise>
<exercise id="fs-id1609639">
<problem id="fs-id2319610">
<para id="fs-id2491175">અગિયાર મિલિયન, ચુમ્માલીસ હજાર, એકસો સડસઠ</para>
</problem>
<solution id="fs-id2474599">
<para id="fs-id2277386">11,044,167</para>
</solution>
</exercise>
<exercise id="fs-id2353124">
<problem id="fs-id1387432">
<para id="fs-id1397862">અઢાર મિલિયન, એકસો બે હજાર, સાતસો ત્ર્યાસી</para>
</problem>
</exercise>
<exercise id="fs-id328342">
<problem id="fs-id1325594">
<para id="fs-id1612747">ત્રણ બિલિયન, બસો છવ્વીસ મિલિયન, પાંચસો બાર હજાર, સત્તર</para>
</problem>
<solution id="fs-id1883860">
<para id="fs-id4126359">3,226,512,017</para>
</solution>
</exercise>
<exercise id="fs-id2241247">
<problem id="fs-id1892005">
<para id="fs-id2171400">અગિયાર બિલિયન, ચારસો એકોતેર મિલિયન, છત્રીસ હજાર, એકસો છ</para>
</problem>
</exercise>
<exercise id="fs-id1825926">
<problem id="fs-id1242968">
<para id="fs-id2211384">વિશ્વની વસ્તીનો અંદાજ સાત બિલિયન, એકસો તોતેર મિલિયન લોકોનો હતો.</para>
</problem>
<solution id="fs-id1617818">
<para id="fs-id2486210">7,173,000,000</para>
</solution>
</exercise>
<exercise id="fs-id2926292">
<problem id="fs-id1863618">
<para id="fs-id1517446">સૂર્યમંડળની ઉંમરનો અંદાજ ચાર બિલિયન, પાંચસો અડસઠ મિલિયન વર્ષ છે.</para>
</problem>
</exercise>
<exercise id="fs-id1733890">
<problem id="fs-id3204832">
<para id="fs-id1576329">ટાહો સરોવરમાં ઓગણચાલીસ ટ્રિલિયન ગૅલન પાણી સમાઈ શકે છે.</para>
</problem>
<solution id="fs-id2700417">
<para id="fs-id2202290">39,000,000,000,000</para>
</solution>
</exercise>
<exercise id="fs-id1572155">
<problem id="fs-id2261957">
<para id="fs-id2214935">કેન્દ્ર સરકારનું બજેટ ત્રણ ટ્રિલિયન, પાંચસો બિલિયન ડૉલર હતું.</para>
</problem>
</exercise>
<para id="fs-id3228060"><emphasis effect="bold">પૂર્ણ સંખ્યાઓને નજીકની સ્થાનકિંમતમાં ફેરવો</emphasis> </para><para id="eip-406">નીચેના અભ્યાસમાં સંખ્યાઓને દર્શાવેલી સૌથી નજીકની સ્થાનકિંમતમાં ફેરવો.</para><exercise id="fs-id2188696"><problem id="fs-id2751447">
<para id="fs-id1348283">સૌથી નજીકના દશકમાં ફેરવો: <list id="eip-id1168288303519" list-type="enumerated" class="circled" number-style="arabic"><item><span class="token">ⓐ</span> <m:math><m:mn>386</m:mn></m:math> </item><item><span class="token">ⓑ</span> <m:math><m:mn>2,931</m:mn></m:math></item></list></para></problem>
<solution id="fs-id1383942">
<list id="fs-id825804" list-type="enumerated" class="circled"><item><span class="token">ⓐ</span> 390</item>
<item><span class="token">ⓑ</span> 2,930</item>
</list></solution>
</exercise><exercise id="fs-id1621308">
<problem id="fs-id1190161">
<para id="fs-id1465181">સૌથી નજીકના દશકમાં ફેરવો: <list id="eip-id1168287165376" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mn>792</m:mn></m:math> </item><item><span class="token">ⓑ</span> <m:math><m:mn>5,647</m:mn></m:math></item></list></para></problem>
</exercise>
<exercise id="fs-id1341642"><problem id="fs-id1965804">
<para id="fs-id2475738">સૌથી નજીકના સોમાં ફેરવો: <list id="eip-id1168287251240" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mn>13,748</m:mn></m:math> </item><item><span class="token">ⓑ</span> <m:math><m:mn>391,794</m:mn></m:math></item></list></para>
</problem>
<solution id="fs-id1742262">
<list id="fs-id2433804" class="circled" list-type="enumerated">
<item><span class="token">ⓐ</span> 13,700</item>
<item><span class="token">ⓑ</span> 391,800</item>
</list>
</solution>
</exercise><exercise id="fs-id2240116">
<problem id="fs-id1573732">
<para id="fs-id1246712">સૌથી નજીકના સોમાં ફેરવો:<list id="eip-id1168287190960" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mn>28,166</m:mn></m:math> </item><item><span class="token">ⓑ</span> <m:math><m:mn>481,628</m:mn></m:math></item></list></para></problem>
</exercise>
<exercise id="fs-id1387845"><problem id="fs-id1161100">
<para id="fs-id1136960">સૌથી નજીકના દશકમાં ફેરવો:</para>  <list id="eip-id1168287180632" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mn>1,492</m:mn></m:math> </item><item><span class="token">ⓑ</span> <m:math><m:mn>1,497</m:mn></m:math></item></list></problem>
<solution id="fs-id1574330">
<list id="fs-id1973719" list-type="enumerated" class="circled"><item><span class="token">ⓐ</span> 1,490</item>
<item><span class="token">ⓑ</span> 1,500</item>
</list>
</solution>
</exercise><exercise id="fs-id1516723">
<problem id="fs-id2926660">
<para id="fs-id1357237">સૌથી નજીકના હજારમાં ફેરવો: <list id="eip-id1168288217775" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mn>2,391</m:mn></m:math> </item><item><span class="token">ⓑ</span> <m:math><m:mn>2,795</m:mn></m:math> </item></list></para></problem>
</exercise>
<exercise id="fs-id1185521"><problem id="fs-id2626750">
<para id="fs-id1608098">સૌથી નજીકના સોમાં ફેરવો: <list id="eip-id1168288182229" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mn>63,994</m:mn></m:math></item> <item><span class="token">ⓑ</span> <m:math><m:mn>63,949</m:mn></m:math>  </item></list></para></problem>
<solution id="fs-id1560808">
<para id="fs-id1177121"><list id="eip-id1168287109226" list-type="enumerated" class="circled" number-style="arabic"><item><span class="token">ⓐ</span> <m:math><m:mn>64,000</m:mn></m:math></item><item><span class="token">ⓑ</span> <m:math><m:mn>63,900</m:mn></m:math></item></list></para></solution>
</exercise><exercise id="fs-id1372149"><problem id="fs-id1605093">
<para id="fs-id892326">સૌથી નજીકના હજારમાં ફેરવો:<list id="eip-id1168288177128" list-type="enumerated" class="circled" number-style="arabic"><item><span class="token">ⓐ</span> <m:math><m:mn>163,584</m:mn></m:math></item><item><span class="token">ⓑ</span> <m:math><m:mn>163,246</m:mn></m:math></item></list></para></problem>
</exercise></section>
<section id="fs-id1717629" class="everyday">
<title>રોજિંદા જીવનમાં ગણિત</title>
<exercise id="fs-id1294881">
<problem id="fs-id1744657">
<para id="fs-id2692049"><emphasis effect="bold">ચેક લખવો</emphasis> હોર્હેએ કાર ખરીદી. તેની કિંમત હતી: <m:math><m:mrow><m:mtext>$24,493</m:mtext><m:mo>.</m:mo></m:mrow></m:math> તેણે કારની કિંમત ચેકથી ચૂકવી. ખરીદકિંમત શબ્દોમાં લખો.</para>
</problem>
<solution id="fs-id764785">
<para id="fs-id2587177">ચોવીસ હજાર, ચારસો ત્રાણું ડૉલર</para>
</solution>
</exercise>
<exercise id="fs-id2610406">
<problem id="fs-id1899511">
<para id="fs-id2390911"><emphasis effect="bold">ચેક લખવો</emphasis> મરિસાના રસોડાના નવીનીકરણનો ખર્ચ હતો: <m:math><m:mrow><m:mtext>$18,549</m:mtext><m:mo>.</m:mo></m:mrow></m:math> તેણે કોન્ટ્રાક્ટરને ચેક લખી આપ્યો. ચૂકવેલી રકમ શબ્દોમાં લખો.</para>
</problem>
</exercise>
<exercise id="fs-id2792494"><problem id="fs-id1816472">
<para id="fs-id1317952"><emphasis effect="bold">કાર ખરીદવી</emphasis> હોર્હેએ કાર ખરીદી. તેની કિંમત હતી: <m:math><m:mrow><m:mtext>$24,493</m:mtext><m:mo>.</m:mo></m:mrow></m:math> કિંમતને નીચે દર્શાવેલી સૌથી નજીકની સ્થાનકિંમતમાં ફેરવો:</para>
<list id="eip-id1168288191463" list-type="enumerated" class="circled" number-style="arabic"><item><span class="token">ⓐ</span> દસ ડૉલર</item>
<item><span class="token">ⓑ</span> સો ડૉલર</item>
<item><span class="token">ⓒ</span> હજાર ડૉલર</item>
<item><span class="token">ⓓ</span> દસ હજાર ડૉલર</item></list></problem>
<solution id="fs-id1154314">
<list id="eip-id1168288210369" list-type="enumerated" class="circled" number-style="arabic"><item><span class="token">ⓐ</span> $24,490</item><item><span class="token">ⓑ</span> $24,500 </item><item><span class="token">ⓒ</span> $24,000 </item><item><span class="token">ⓓ</span> $20,000</item></list></solution>
</exercise><exercise id="fs-id1604312"><problem id="fs-id1166211">
<para id="fs-id1932966"><emphasis effect="bold">રસોડાનું નવીનીકરણ</emphasis> મરિસાના રસોડાના નવીનીકરણનો ખર્ચ હતો: <m:math><m:mrow><m:mtext>$18,549</m:mtext><m:mo>.</m:mo></m:mrow></m:math> ખર્ચને નીચે દર્શાવેલી સૌથી નજીકની સ્થાનકિંમતમાં ફેરવો:</para>
<list id="eip-id1168287387980" list-type="enumerated" class="circled" number-style="arabic"><item><span class="token">ⓐ</span> દસ ડૉલર</item>
<item><span class="token">ⓑ</span> સો ડૉલર</item>
<item><span class="token">ⓒ</span> હજાર ડૉલર</item>
<item><span class="token">ⓓ</span> દસ હજાર ડૉલર</item></list></problem>
</exercise><exercise id="fs-id2609369"><problem id="fs-id2058233">
<para id="fs-id4171773"><emphasis effect="bold">વસ્તી</emphasis> ચીનની વસ્તી <m:math><m:mrow><m:mn>1,355,692,544</m:mn></m:mrow></m:math> હતી, વર્ષ <m:math><m:mrow><m:mn>2014</m:mn><m:mo>.</m:mo></m:mrow></m:math> વસ્તીને નીચે દર્શાવેલી સૌથી નજીકની સ્થાનકિંમતમાં ફેરવો:</para><list id="eip-id1168289677973" list-type="enumerated" class="circled" number-style="arabic"><item><span class="token">ⓐ</span> બિલિયન લોકો</item>
<item><span class="token">ⓑ</span> સો મિલિયન લોકો</item>
<item><span class="token">ⓒ</span> મિલિયન લોકો</item></list></problem>
<solution id="fs-id1177141"><list id="eip-id1168289677990" list-type="enumerated" class="circled" number-style="arabic"><item><span class="token">ⓐ</span> <m:math><m:mn>1,000,000,000</m:mn></m:math></item><item><span class="token">ⓑ</span> <m:math><m:mn>1,400,000,000</m:mn></m:math></item><item><span class="token">ⓒ</span> <m:math><m:mn>1,356,000,000</m:mn></m:math></item></list></solution>
</exercise><exercise id="fs-id1806959"><problem id="fs-id1792359">
<para id="fs-id1270274"><emphasis effect="bold">ખગોળશાસ્ત્ર</emphasis> પૃથ્વી અને સૂર્ય વચ્ચેનું સરેરાશ અંતર <m:math><m:mrow><m:mn>149,597,888</m:mn></m:mrow></m:math> કિલોમીટર છે. અંતરને નીચે દર્શાવેલી સૌથી નજીકની સ્થાનકિંમતમાં ફેરવો:</para><list id="eip-id1168288211528" list-type="enumerated" class="circled" number-style="arabic"><item><span class="token">ⓐ</span> સો મિલિયન કિલોમીટર</item>
<item><span class="token">ⓑ</span> દસ મિલિયન કિલોમીટર</item>
<item><span class="token">ⓒ</span> મિલિયન કિલોમીટર</item></list></problem>
</exercise></section>
<section id="fs-id1345943" class="writing">
<title>લેખન અભ્યાસ</title>
<exercise id="fs-id3202450">
<problem id="fs-id2410682">
<para id="fs-id1946666">ગણતરીની સંખ્યાઓ અને પૂર્ણ સંખ્યાઓ વચ્ચેનો તફાવત તમારા પોતાના શબ્દોમાં સમજાવો.</para>
</problem>
<solution id="fs-id1948767">
<para id="fs-id2701563">જવાબો જુદા હોઈ શકે છે. ગણતરીની સંખ્યાઓ સાથે શૂન્યનો સમાવેશ કરતાં પૂર્ણ સંખ્યાઓ મળે છે.</para>
</solution>
</exercise>
<exercise id="fs-id1258379">
<problem id="fs-id4295295">
<para id="fs-id1350802">તમારા રોજિંદા જીવનમાંથી એવું ઉદાહરણ આપો જેમાં સંખ્યાઓને નજીકની સ્થાનકિંમતમાં ફેરવવાથી મદદ મળે.</para>
</problem>
</exercise></section><section id="eip-823" class="self-check"><title>સ્વમૂલ્યાંકન</title><para id="eip-949"><span class="token">ⓐ</span> અભ્યાસ પૂરો કર્યા પછી આ વિભાગનાં શીખવાનાં લક્ષ્યો તમે કેટલાં સિદ્ધ કર્યાં તે જાણવા આ તપાસયાદીનો ઉપયોગ કરો. </para>

<figure id="eip-id1165721974706" class="unnumbered"><label /><media id="eip-id1165721974707" alt="પૂર્ણ સંખ્યાઓ, સ્થાનકિંમત અને સંખ્યાઓને ગોળ કરવાની સમજનું મૂલ્યાંકન કરવા માટેનું કોષ્ટક. દરેક કૌશલ્ય માટે વિકલ્પો છે: વિશ્વાસપૂર્વક, થોડી મદદથી, અથવા ના—મને સમજાતું નથી!"><image mime-type="image/jpg" src="../../media/CNX_BMath_Figure_AppB_001.jpg" /></media></figure>


<para id="eip-id1168469895457"><span class="token">ⓑ</span> જો તમે સૌથી વધુ નિશાની આ વિકલ્પમાં કરી હોય તો... </para>
<para id="eip-id1168469895465">…વિશ્વાસપૂર્વક. અભિનંદન! તમે આ વિભાગનાં શીખવાનાં લક્ષ્યો સિદ્ધ કર્યાં છે. તમે અભ્યાસની કઈ રીતો અપનાવી તે વિચારો, જેથી આગળ પણ તેનો ઉપયોગ કરી શકો. આ કામો તમે કરી શકશો એવો વિશ્વાસ કેળવવા તમે શું કર્યું? ચોક્કસ રીતે જણાવો.</para>
<para id="eip-id1168469895472">…થોડી મદદથી. આ બાબતે જલદી ધ્યાન આપવું જરૂરી છે, કારણ કે જે વિષયો તમને બરાબર સમજાયા નથી તે તમારી સફળતાના માર્ગમાં અવરોધ બની શકે છે. ગણિતમાં દરેક વિષય અગાઉ શીખેલી બાબતો પર આધાર રાખે છે. આગળ વધતાં પહેલાં તમારો પાયો મજબૂત છે તેની ખાતરી કરવી જરૂરી છે. તમે કોની મદદ માગી શકો? તમારા સહાધ્યાયીઓ અને શિક્ષક મદદ કરી શકે છે. શું તમારી શિક્ષણસંસ્થામાં ગણિતનું માર્ગદર્શન આપનારા શિક્ષકો મળે એવી કોઈ જગ્યા છે? શું તમે અભ્યાસ કરવાની તમારી રીતો સુધારી શકો? </para>
<para id="eip-id1168466338968">…ના—મને સમજાતું નથી! આ ચેતવણી છે અને તમારે તેને અવગણવી જોઈએ નહીં. તરત મદદ લો, નહીં તો ટૂંક સમયમાં અભ્યાસનો ભાર તમને વધુ લાગશે. તમારી સ્થિતિ વિશે વાત કરવા બને તેટલા વહેલા તમારા શિક્ષકને મળો. તમને જરૂરી મદદ મળે તે માટે તમે બંને સાથે મળીને યોજના બનાવી શકો છો.</para></section></section>
</content></document>