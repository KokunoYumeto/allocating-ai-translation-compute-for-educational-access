<?xml version='1.0' encoding='utf-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" xmlns:ns1="http://cnx.rice.edu/mdml" xml:lang="gu-Gujr-IN">
<title>પૂર્ણ સંખ્યાઓની બાદબાકી કરો</title>
<metadata>
  <ns1:content-id>m81245</ns1:content-id>
  <ns1:title>પૂર્ણ સંખ્યાઓની બાદબાકી કરો</ns1:title>
  <ns1:abstract><para id="para-00001">આ વિભાગના અંતે તમે:</para><list id="list-00001">
<item>બાદબાકીની લખાવટનો ઉપયોગ કરી શકશો.</item>
<item>પૂર્ણ સંખ્યાઓની બાદબાકી નમૂના દ્વારા દર્શાવી શકશો.</item>
<item>પૂર્ણ સંખ્યાઓની બાદબાકી કરી શકશો.</item>
<item>શબ્દોમાં આપેલી વાતને ગણિતની લખાવટમાં ફેરવી શકશો.</item>
<item>વ્યવહારુ પ્રશ્નોમાં પૂર્ણ સંખ્યાઓની બાદબાકી કરી શકશો.</item>
</list></ns1:abstract>
  <ns1:uuid>b7b437ef-73c1-446d-a42c-7a7ebe933114</ns1:uuid>
</metadata>

<content>
<note id="fs-id2649398" class="be-prepared">
<para id="fs-id1376163">શરૂઆત કરતાં પહેલાં તૈયારી તપાસવાના આ પ્રશ્નો ઉકેલો.</para>
<exercise id="fs-idm325648832"><problem id="fs-idm333083312">
<para id="fs-idm342720096">નમૂનો બનાવો: <m:math><m:mrow><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math> આધાર-દસના ખંડો વાપરો.<newline />
જો આ પ્રશ્નમાં ભૂલ થઈ હોય, તો ફરી જુઓ: <link document="m81244" target-id="fs-id1239606" />.</para>
</problem>
<solution id="fs-idm341787200">
<media id="eip-id1168468728290" alt="ગુલાબી ચોરસથી 3 + 4 = 7નો સરવાળો દર્શાવેલો છે: ત્રણ ચોરસમાં ચાર ચોરસ ઉમેરવાથી સાત ચોરસ થાય છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_03_001_img.jpeg" /></media>
</solution>
</exercise></note>
<note id="fs-id1122445" class="be-prepared">
<exercise id="fs-idm326061088">
<problem id="fs-idm342895408">
<para id="fs-idm349152624">સરવાળો કરો: <m:math><m:mrow><m:mn>324</m:mn><m:mo>+</m:mo><m:mn>586</m:mn><m:mo>.</m:mo></m:mrow></m:math><newline />
જો આ પ્રશ્નમાં ભૂલ થઈ હોય, તો ફરી જુઓ: <link document="m81244" target-id="fs-id1988116" />.</para>
</problem>
<solution id="fs-idm343972784">
<para id="fs-idm331022384"><m:math><m:mrow><m:mn>910</m:mn></m:mrow></m:math></para>
</solution>
</exercise></note>
<section id="fs-id1799687">
<title>બાદબાકીની લખાવટનો ઉપયોગ કરો</title>
<para id="fs-id1885623">ધારો કે વાટકામાં સાત કેળાં છે. એલાના તેમાંથી ત્રણ કેળાં વાપરીને સ્મૂધી બનાવે છે. વાટકામાં કેટલાં કેળાં બાકી રહે? જવાબ મેળવવા સાતમાંથી ત્રણ બાદ કરીએ. બાદબાકી કરતી વખતે એક સંખ્યામાંથી બીજી સંખ્યા દૂર કરવાથી મળતા પરિણામને <term id="term-00001">તફાવત</term> કહે છે. આ સંખ્યાને બાદ કરવા માટે: <m:math><m:mn>3</m:mn></m:math> આ સંખ્યામાંથી: <m:math><m:mn>7</m:mn></m:math> આપણે આ લખાવટ વાપરીએ છીએ:</para>
<equation id="fs-id1467448" class="unnumbered"><label /><m:math><m:mrow><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math></equation>
<para id="fs-id2670515">આપણે <m:math><m:mrow><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math> ને <emphasis effect="italics">સાત ઓછા ત્રણ</emphasis> વાંચીએ છીએ અને પરિણામ છે <emphasis effect="italics">સાત અને ત્રણનો તફાવત</emphasis>.</para>
<note id="fs-id1718072">
<title>બાદબાકીની લખાવટ</title>
<para id="fs-id1499865">બાદબાકી દર્શાવવા પ્રતીકો અને શબ્દો વાપરી શકીએ છીએ.</para>
<table id="fs-id2434601" class="unnumbered" aria-label="બે હરોળ અને પાંચ સ્તંભનું કોષ્ટક. ઉપરની હરોળ શીર્ષકની છે. ડાબેથી જમણે સ્તંભનાં નામ ક્રિયા, લખાવટ, પદાવલી, આ રીતે વાંચો અને પરિણામ છે. ક્રિયામાં બાદબાકી, લખાવટમાં ઓછાનું ચિહ્ન, પદાવલીમાં સાત ઓછા ત્રણ, વાંચનમાં સાત ઓછા ત્રણ શબ્દો અને પરિણામમાં આ સંખ્યાઓનો તફાવત લખેલું છે: 7 અને 3.">
<label />
<tgroup cols="5">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<colspec colnum="3" colname="c3" />
<colspec colnum="4" colname="c4" />
<colspec colnum="5" colname="c5" />
<thead>
<row valign="top">
<entry align="left">ક્રિયા</entry>
<entry align="left">લખાવટ</entry>
<entry align="left">પદાવલી</entry>
<entry align="left">આ રીતે વાંચો</entry>
<entry align="left">પરિણામ</entry>
</row>
</thead>
<tbody>
<row valign="top">
<entry align="left">બાદબાકી</entry>
<entry align="left"><m:math><m:mrow><m:mo>−</m:mo></m:mrow></m:math></entry>
<entry align="left"><m:math><m:mrow><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math></entry>
<entry align="left">સાત ઓછા ત્રણ</entry>
<entry align="left">આ સંખ્યાઓનો તફાવત: <m:math><m:mrow><m:mn>7</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>3</m:mn></m:mrow></m:math></entry>
</row>
</tbody>
</tgroup>
</table>
</note>
<example id="fs-id2300581">
<exercise id="fs-id2218104"><problem id="fs-id2702122">
<para id="fs-id1465049">ગણિતની લખાવટને શબ્દોમાં ફેરવો: <span class="token">ⓐ</span> <m:math><m:mn>8</m:mn><m:mo>−</m:mo><m:mn>1</m:mn></m:math> <span class="token">ⓑ</span> <m:math><m:mn>26</m:mn><m:mo>−</m:mo><m:mn>14</m:mn></m:math>.</para>
</problem>
<solution id="fs-id4303008">
<title>ઉકેલ</title>
<list id="eip-id1168289601814" list-type="labeled-item" class="circled"><item><span class="token">ⓐ</span> આને આપણે <emphasis effect="italics">આઠ ઓછા એક</emphasis> વાંચીએ છીએ. પરિણામ છે <emphasis effect="italics">આઠ અને એકનો તફાવત</emphasis>.</item>
<item><span class="token">ⓑ</span> આને આપણે <emphasis effect="italics">છવ્વીસ ઓછા ચૌદ</emphasis> વાંચીએ છીએ. પરિણામ છે <emphasis effect="italics">છવ્વીસ અને ચૌદનો તફાવત</emphasis>.</item></list></solution>
</exercise></example>
<note id="fs-id1572252" class="try">
<para id="fs-id2134775">ગણિતની લખાવટને શબ્દોમાં ફેરવો:</para>
<exercise id="fs-id1402228"><problem id="fs-id1931803">
<list id="eip-id1168288638005" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mn>12</m:mn><m:mo>−</m:mo><m:mn>4</m:mn></m:math></item><item><span class="token">ⓑ</span> <m:math><m:mn>29</m:mn><m:mo>−</m:mo><m:mn>11</m:mn></m:math></item></list>
</problem>
<solution id="fs-id1627288">
<list id="eip-id1168287497635" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> બાર ઓછા ચાર; બાર અને ચારનો તફાવત </item><item><span class="token">ⓑ</span> ઓગણત્રીસ ઓછા અગિયાર; ઓગણત્રીસ અને અગિયારનો તફાવત</item></list></solution>
</exercise></note>
<note id="fs-id1357992" class="try">
<para id="fs-id1406214">ગણિતની લખાવટને શબ્દોમાં ફેરવો:</para>
<exercise id="fs-id2650087"><problem id="fs-id3242039">
<list id="eip-id1168288312416" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mn>11</m:mn><m:mo>−</m:mo><m:mn>2</m:mn></m:math></item><item><span class="token">ⓑ</span> <m:math><m:mn>29</m:mn><m:mo>−</m:mo><m:mn>12</m:mn></m:math></item></list></problem>
<solution id="fs-id1474721">
<list id="eip-id1168288179457" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> અગિયાર ઓછા બે; અગિયાર અને બેનો તફાવત </item><item><span class="token">ⓑ</span> ઓગણત્રીસ ઓછા બાર; ઓગણત્રીસ અને બારનો તફાવત</item></list></solution>
</exercise></note>
</section>
<section id="fs-id1824154"><title>પૂર્ણ સંખ્યાઓની બાદબાકી નમૂના દ્વારા દર્શાવો</title><para id="fs-id1515766">સરવાળાની જેમ બાદબાકીની ક્રિયા સમજવામાં પણ નમૂનો મદદ કરે છે. ફરી આપણે <m:math><m:mrow><m:mtext>આધાર-10</m:mtext></m:mrow></m:math> ના ખંડો વાપરીશું. યાદ રાખો, એક ખંડ 1 અને એક સળી 10 દર્શાવે છે. હમણાં જોયેલી બાદબાકીની પદાવલીનો નમૂનો બનાવીને શરૂઆત કરીએ: <m:math><m:mrow><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>.</m:mo></m:mrow></m:math></para><table id="eip-696" class="unnumbered unstyled" summary="આ કોષ્ટક ખંડો વડે બાદ કરવાનું દર્શાવે છે: 3, આ સંખ્યામાંથી: 7. શરૂઆતનો નમૂનો બનાવવાથી લઈને અંતિમ ગાણિતિક પરિણામ સુધીનું દરેક પગલું ચિત્રથી સમજાવેલું છે."><label /><tgroup cols="3"><tbody>
  <row>
    <entry>પહેલી સંખ્યા 7નો નમૂનો બનાવીને શરૂઆત કરીએ.</entry>
    <entry><media id="eip-id1168287103791" alt="ચિત્રમાં કિનારીવાળા સાત રાખોડી ચોરસ છે અને તેમની નીચે સંખ્યા 7 લખેલી છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_018_img-02.png" /></media></entry>
  </row>
  <row>
    <entry>હવે બીજી સંખ્યા 3 દૂર કરો. આ 3 ખંડ દૂર કરવાના છે તે દર્શાવવા તેમની આસપાસ વર્તુળ દોરીશું.</entry>

    <entry><media id="eip-id1168289649847" alt="ચિત્રમાં કિનારીવાળા ત્રણ રાખોડી ચોરસ લાલ વર્તુળમાં છે; પછી થોડી જગ્યા અને પછી કિનારીવાળા બીજા ચાર રાખોડી ચોરસ છે, જે વર્તુળમાં નથી."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_018_img-03.png" /></media></entry>
  </row>
  <row>
    <entry>બાકી રહેલા ખંડોની સંખ્યા ગણો.</entry>
    <entry><media id="eip-id1168287507388" alt="સફેદ પૃષ્ઠભૂમિ પર ઘેરી કિનારી અને આછા પડછાયાવાળા ચાર આછા રાખોડી ચોરસ આડી હરોળમાં છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_018_img-04.png" /></media></entry>
  </row>
  <row>
    <entry>એકમના 4 ખંડ બાકી છે.</entry>
    <entry>આપણે આ દર્શાવ્યું છે: <m:math><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>4</m:mn></m:math>.</entry>
  </row>
</tbody>




</tgroup>
</table>
<example id="fs-id1607526">
<exercise id="fs-id1542638"><problem id="fs-id2908746">
<para id="fs-id1684104">આ બાદબાકી નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>8</m:mn><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2587738">
<title>ઉકેલ</title>
<table id="eip-35" class="unnumbered unstyled" aria-label="ચિત્રમાં બે સ્તંભ છે. ડાબે નોંધો અને જમણે આધાર-દસના ખંડો છે. ડાબે લખેલું છે: 8 ઓછા 2 એટલે આ સંખ્યાઓનો તફાવત: 8 અને 2. પહેલી સંખ્યા 8નો નમૂનો બનાવો; તેની સામે 8 છૂટા ખંડની નીચે 8 લખેલું છે. પછીની લીટી બીજી સંખ્યા 2 દૂર કરવાનું કહે છે. સામે તે જ 8 છૂટા ખંડમાંથી પહેલા 2ની આસપાસ વર્તુળ છે. પછી બાકી રહેલા ખંડ ગણવાનું કહે છે અને સામે છ છૂટા ખંડ છે. છેલ્લે છ એકમના ખંડ બાકી હોવાનું અને આપણે 8 ઓછા 2 બરાબર 6 દર્શાવ્યું હોવાનું લખેલું છે."><label /><tgroup cols="3"><tbody>
  <row>
    <entry><m:math><m:mn>8</m:mn><m:mo>−</m:mo><m:mn>2</m:mn></m:math> એટલે 8 અને 2નો તફાવત.</entry>

    <entry />
  </row>
  <row>
    <entry>પહેલી સંખ્યા 8નો નમૂનો બનાવો.</entry>

    <entry align="right"><media id="eip-id1168288533358" alt="ઘેરી કિનારીવાળા આછા વાદળી રંગના આઠ ચોરસની હરોળ છે. સફેદ પૃષ્ઠભૂમિ પર તેમની વચ્ચે નીચે સંખ્યા “8” લખેલી છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_019_img-02.png" /></media></entry>
  </row>
  <row>
    <entry>બીજી સંખ્યા 2 દૂર કરો.</entry>

    <entry align="right"><media id="eip-id1168288533378" alt="ઘેરી કિનારીવાળા આછા વાદળી રંગના આઠ ચોરસની હરોળ છે. પહેલા બે ચોરસ લાલ વર્તુળમાં છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_019_img-03.png" /></media></entry>
  </row>
  <row>
    <entry>બાકી રહેલા ખંડોની સંખ્યા ગણો.</entry>

    <entry align="right"><media id="eip-id1168288508023" alt="ઘેરી કિનારીવાળા આછા વાદળી રંગના છ ચોરસની હરોળ."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_019_img-04.png" /></media></entry>
  </row>
  <row>
    <entry>એકમના 6 ખંડ બાકી છે.</entry>

    <entry>આપણે આ દર્શાવ્યું છે: <m:math><m:mn>8</m:mn><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>6</m:mn></m:math>.</entry>
  </row>
</tbody>



</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id1825040" class="try">
<exercise id="fs-id1613938">
<problem id="fs-id1384402">
<para id="fs-id2174662">નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>9</m:mn><m:mo>−</m:mo><m:mn>6</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1546209">
<para id="fs-id1171105575889"><newline /><media id="fs-id2262938" alt="ચિત્રમાં ખંડોથી 9 – 6ની બાદબાકી દર્શાવેલી છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_03_006.jpg" />
</media></para></solution>
</exercise>
</note>
<note id="fs-id1371643" class="try">
<exercise id="fs-id873971">
<problem id="fs-id1224533">
<para id="fs-id1516112">નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>6</m:mn><m:mo>−</m:mo><m:mn>1</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2269751">
<para id="fs-id1171105216187"><newline /><media id="fs-id2793179" alt="ચિત્રમાં ખંડોથી 9 – 6ની બાદબાકી દર્શાવેલી છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_03_007.jpg" />
</media></para></solution>
</exercise>
</note>
<example id="fs-id2202888"><exercise id="fs-id2334164"><problem id="fs-id2274296">
<para id="fs-id2597279">આ બાદબાકી નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>13</m:mn><m:mo>−</m:mo><m:mn>8</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id577210">
<title>ઉકેલ</title>




<table id="eip-811" class="unnumbered unstyled" aria-label="ચિત્રમાં બે સ્તંભ છે. ડાબે નોંધો અને જમણે આધાર-દસના ખંડો છે. ડાબે લખેલું છે: પહેલી સંખ્યા 13નો નમૂનો બનાવો. આપણે 1 દશક અને 3 એકમ વાપરીએ છીએ. સામે 10 ખંડની એક હરોળ અને 3 છૂટા ખંડ છે. પછીની લીટી બીજી સંખ્યા 8 દૂર કરવાનું કહે છે. પણ આઠ એકમ નથી, તેથી 1 દશકના બદલામાં 10 એકમ લઈશું. સામે તે જ 10 છૂટા ખંડ અને ત્રણ છૂટા ખંડ છે. પછી હવે 8 એકમ દૂર કરી શકીએ એવું લખેલું છે; સામે 10 છૂટા ખંડ, પછી બે છૂટા ખંડ અને ત્રણ છૂટા ખંડ છે, જેમાં 10 છૂટા ખંડની આસપાસ વર્તુળ છે. પછી બાકી રહેલા ખંડ ગણવાનું કહે છે; સામે 2 છૂટા ખંડ અને પછી ત્રણ છૂટા ખંડ છે. છેલ્લી લીટી પાંચ એકમના ખંડ બાકી હોવાનું અને આપણે 13 ઓછા 8 બરાબર 5 દર્શાવ્યું હોવાનું કહે છે."><label /><tgroup cols="3"><tbody>
  <row>
    <entry>પહેલી સંખ્યા 13નો નમૂનો બનાવો. આપણે 1 દશક અને 3 એકમ વાપરીએ છીએ.</entry>

    <entry><media id="eip-id1168288669333" alt="આછા વાદળી રંગના દસ ખંડ આડી હરોળમાં છે, પછી થોડી જગ્યા અને પછી બીજા ત્રણ ખંડ છે. આ સાદું ચિત્ર જથ્થા, માહિતીના ભાગ કે ક્રમશઃ પ્રક્રિયા દર્શાવતું હોઈ શકે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_020_img-02.png" /></media></entry>
  </row>
  <row>
    <entry>બીજી સંખ્યા 8 દૂર કરો. પણ આપણી પાસે 8 એકમ નથી, તેથી 1 દશકના બદલામાં 10 એકમ લઈશું.</entry>

    <entry><media id="eip-id1168288455204" alt="સફેદ પૃષ્ઠભૂમિ પર ઘેરી કિનારીવાળા આછા વાદળી ચોરસનાં બે જૂથ છે. એક જૂથમાં 10 ચોરસ અને બીજામાં 3 ચોરસ છે. તેમની નીચે અનુક્રમે 10 અને 3 લખેલું છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_020_img-03.png" /></media></entry>
  </row>
  <row>
    <entry>હવે આપણે 8 એકમ દૂર કરી શકીએ છીએ.</entry>

    <entry><media id="eip-id1168288455224" alt="આછા વાદળી ચોરસની હરોળ. દસ ચોરસ જાંબલી અંડાકારમાં છે અને તેની નીચે ડાબે બતાવતું તીર ચક્ર અથવા પુનરાવર્તન દર્શાવે છે. જમણે બીજા ચાર ચોરસ છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_020_img-04.png" /></media></entry>
  </row>
  <row>
    <entry>બાકી રહેલા ખંડો ગણો.</entry>

    <entry><media id="eip-id1168288455244" alt="ઘેરી કિનારીવાળા પાંચ આછા વાદળી ચોરસની હરોળ. પહેલા બે ચોરસ અને બાકીના ત્રણ ચોરસ વચ્ચે થોડી જગ્યા છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_020_img-05.png" /></media></entry>
  </row>
  <row>
    <entry>પાંચ એકમ બાકી છે.</entry>

    <entry>આપણે આ દર્શાવ્યું છે: <m:math><m:mn>13</m:mn><m:mo>−</m:mo><m:mn>8</m:mn><m:mo>=</m:mo><m:mn>5</m:mn></m:math>.</entry>
  </row>
</tbody>




</tgroup>
</table><para id="fs-id1328228">સરવાળામાં કર્યું તેમ, આ નમૂનાને એકમના ખંડ અને દશકની સળી કહી શકીએ છીએ અથવા ટૂંકમાં એકમ અને દશક કહી શકીએ છીએ.</para>
</solution>
</exercise></example><note id="fs-id2263240" class="try">
<exercise id="fs-id2687887">
<problem id="fs-id1578480">
<para id="fs-id1799661">આ બાદબાકી નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>12</m:mn><m:mo>−</m:mo><m:mn>7</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2563009">
<para id="fs-id1171103469437"><newline /><media id="fs-id2774892" alt="ચિત્રમાં ખંડો વડે 12 – 7ની બાદબાકીનું સમીકરણ દર્શાવેલું છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_03_011_img.jpg" />
</media></para></solution>
</exercise>
</note>
<note id="fs-id2773418" class="try">
<exercise id="fs-id2483714">
<problem id="fs-id2220439">
<para id="fs-id1785004">આ બાદબાકી નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>14</m:mn><m:mo>−</m:mo><m:mn>8</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1804344">
<para id="fs-id1171105153945"><newline /><media id="fs-id1727244" alt="ચિત્રમાં ખંડો વડે 14 – 8ની બાદબાકીનું સમીકરણ દર્શાવેલું છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_03_012_img.jpg" />
</media></para>
</solution>
</exercise>
</note>
<example id="fs-id1288084">
<exercise id="fs-id2340048">
<problem id="fs-id1578323">
<para id="fs-id3459337">આ બાદબાકી નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>43</m:mn><m:mo>−</m:mo><m:mn>26</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1206516">
<title>ઉકેલ</title>
<para id="fs-id1169751">કારણ કે <m:math><m:mrow><m:mn>43</m:mn><m:mo>−</m:mo><m:mn>26</m:mn></m:mrow></m:math> એટલે <m:math><m:mrow><m:mn>43</m:mn></m:mrow></m:math> માંથી દૂર કરો <m:math><m:mrow><m:mn>26</m:mn><m:mo>,</m:mo></m:mrow></m:math> તેથી શરૂઆતમાં આ સંખ્યાનો નમૂનો બનાવીએ: <m:math><m:mrow><m:mn>43</m:mn><m:mo>.</m:mo></m:mrow></m:math><newline />
<media id="fs-id1611327" alt="ચિત્રમાં બે પ્રકારના ભાગ છે. પહેલા ભાગમાં 4 આડી સળીઓ છે; દરેકમાં 10 ખંડ છે. બીજા ભાગમાં 3 છૂટા ખંડ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_03_013_img.jpg" />
</media></para><para id="fs-id2316259">હવે આપણે દૂર કરવાના છે <m:math><m:mrow><m:mn>26</m:mn><m:mo>,</m:mo></m:mrow></m:math> એટલે <m:math><m:mn>2</m:mn></m:math> દશક અને <m:math><m:mn>6</m:mn></m:math> એકમ. આપણે દૂર કરી શકતા નથી <m:math><m:mn>6</m:mn></m:math> એકમ, જો આપણી પાસે માત્ર <m:math><m:mrow><m:mn>3</m:mn></m:mrow></m:math> એકમ હોય. તેથી આપણે <m:math><m:mn>1</m:mn></m:math> દશકના બદલામાં <m:math><m:mrow><m:mn>10</m:mn></m:mrow></m:math> એકમ લઈએ છીએ.<newline />
<media id="fs-id1376326" alt="આકૃતિમાં બે જૂથ છે. ડાબા પહેલા જૂથમાં 3 વાદળી હરોળમાં આધાર-10ના ખંડો અને 1 લાલ હરોળમાં 10 ખંડ છે. તેની લખાવટ 4 દશક છે. દસ ખંડની પહેલી હરોળની બાજુમાં 3 છૂટા ખંડ છે. તેની લખાવટ 3 એકમ છે. તીર જમણે બીજા જૂથ તરફ બતાવે છે. ત્યાં 10 ખંડની ત્રણ હરોળ છે, જેની લખાવટ 3 દશક છે. તેની બાજુમાં 3 વાદળી છૂટા ખંડની એક હરોળ અને લાલ રંગના પાંચ-પાંચ છૂટા ખંડની બે હરોળ છે. તેની લખાવટ 13 એકમ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_03_014_img.jpg" />
</media></para><para id="fs-id3330866">હવે આપણે દૂર કરી શકીએ છીએ <m:math><m:mn>2</m:mn></m:math> દશક અને <m:math><m:mn>6</m:mn></m:math> એકમ.<newline />
<media id="fs-id1549996" alt="ચિત્રની ઉપર આધાર-દસના ખંડોની એક હરોળ છે અને તેની બાજુમાં સાત છૂટા ખંડ છે. નીચે આધાર-દસના ખંડોની બે હરોળ અને 3 છૂટા ખંડની બે હરોળને એક વર્તુળમાં દર્શાવ્યાં છે. તીર જમણે બતાવે છે, જ્યાં દસ ખંડની એક હરોળ અને તેની નીચે સાત છૂટા ખંડ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_03_015_img.jpg" />
</media></para><para id="fs-id2825677">બાકી રહેલા ખંડોની સંખ્યા ગણો. ત્યાં છે <m:math><m:mn>1</m:mn></m:math> દશક અને <m:math><m:mn>7</m:mn></m:math> એકમ, એટલે <m:math><m:mrow><m:mn>17</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id3407420"><m:math><m:mrow><m:mn>43</m:mn><m:mo>−</m:mo><m:mn>26</m:mn><m:mo>=</m:mo><m:mn>17</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</example>
<note id="fs-id2208961" class="try">
<exercise id="fs-id2297200">
<problem id="fs-id2443471">
<para id="fs-id2486354">આ બાદબાકી નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>42</m:mn><m:mo>−</m:mo><m:mn>27</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1547971">
<para id="fs-id1171105202604"><newline /><media id="fs-id2425624" alt="આ ચિત્રમાં આધાર-દસના ખંડોથી 42 - 27 = 15ની બાદબાકી દર્શાવેલી છે. શરૂઆતની સંખ્યામાં 4 દશક અને 2 એકમ છે; પછી તેને બાદ કરાતી સંખ્યા (27) અને પરિણામ (15)માં વહેંચેલાં છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_03_016_img.jpg" />
</media></para></solution>
</exercise>
</note>
<note id="fs-id2956827" class="try">
<exercise id="fs-id1484755">
<problem id="fs-id1242400">
<para id="fs-id1366955">આ બાદબાકી નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>45</m:mn><m:mo>−</m:mo><m:mn>29</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1312188">
<para id="fs-id1171105081052"><newline /><media id="fs-id2643011" alt="આધાર-દસના ખંડો વાપરીને 29ને 45માંથી બાદ કરતું ચિત્ર. શરૂઆતમાં 4 દશક અને 5 એકમ છે. તેમાંથી 2 દશક અને 9 એકમને વર્તુળમાં દર્શાવી દૂર કરતાં 1 દશક અને 6 એકમ બાકી રહે છે. તે 45 - 29 = 16 દર્શાવે છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_03_017_img.jpg" />
</media></para></solution>
</exercise>
</note>
</section><section id="fs-id1185692">
<title>પૂર્ણ સંખ્યાઓની બાદબાકી કરો</title>
<para id="fs-id2197106">સરવાળો અને બાદબાકી એકબીજાની વિપરીત ક્રિયાઓ છે. સરવાળો બાદબાકીની અસર દૂર કરે છે અને બાદબાકી સરવાળાની અસર દૂર કરે છે.</para><para id="fs-id2609724">આપણે જાણીએ છીએ કે <m:math><m:mrow><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math> કારણ કે <m:math><m:mrow><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>7</m:mn><m:mo>.</m:mo></m:mrow></m:math> બધા નાના સરવાળા આવડતા હોય તો બાદબાકી કરવામાં મદદ મળે છે. પછી સરવાળો કરીને બાદબાકીની ચકાસણી કરી શકીએ છીએ. ઉપરનાં ઉદાહરણોની બાદબાકી સરવાળો કરીને તપાસી શકાય છે.</para>
<equation id="fs-id2898525" class="unnumbered"><label /><m:math><m:mtable><m:mtr><m:mtd columnalign="left"><m:mspace width="1em" /><m:mrow><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mtext>કારણ કે</m:mtext></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mspace width="1em" /><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>7</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mspace width="0.5em" /><m:mn>13</m:mn><m:mo>−</m:mo><m:mn>8</m:mn><m:mo>=</m:mo><m:mn>5</m:mn></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mtext>કારણ કે</m:mtext></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mspace width="1em" /><m:mn>5</m:mn><m:mo>+</m:mo><m:mn>8</m:mn><m:mo>=</m:mo><m:mn>13</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mn>43</m:mn><m:mo>−</m:mo><m:mn>26</m:mn><m:mo>=</m:mo><m:mn>17</m:mn></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mtext>કારણ કે</m:mtext></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mn>17</m:mn><m:mo>+</m:mo><m:mn>26</m:mn><m:mo>=</m:mo><m:mn>43</m:mn></m:mtd></m:mtr></m:mtable></m:math></equation>
<example id="fs-id1977308">
<exercise id="fs-id2587230"><problem id="fs-id1381184">
<para id="fs-id1960002">બાદબાકી કરો અને પછી સરવાળો કરીને તપાસો:<list id="eip-id1168288203278" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mn>9</m:mn><m:mo>−</m:mo><m:mn>7</m:mn></m:math></item><item><span class="token">ⓑ</span> <m:math><m:mn>8</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>.</m:mo></m:math></item></list></para>
</problem>
<solution id="fs-id1604624">
<title>ઉકેલ</title>
<table id="eip-id1168287570371" class="unnumbered unstyled" summary="બાદ કરવાનું ઉદાહરણ: 7, આ સંખ્યામાંથી: 9. પદાવલી, પરિણામ અને સરવાળા દ્વારા ચકાસણી સાથે."><label /><tgroup cols="3"><tbody>
  <row><entry><span class="token">ⓐ</span> </entry><entry /></row>
  <row>
    <entry />
    <entry><m:math><m:mn>9</m:mn><m:mo>−</m:mo><m:mn>7</m:mn></m:math></entry>
  </row>
  <row>
    <entry>બાદ કરો 7, આ સંખ્યામાંથી: 9.</entry>
    <entry><m:math><m:mn>2</m:mn></m:math></entry>
  </row>
<row><entry>સરવાળો કરીને તપાસો.<newline /><m:math><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>7</m:mn><m:mo>=</m:mo><m:mn>9</m:mn><m:mo>✓</m:mo></m:math></entry>
<entry /></row>

</tbody>


</tgroup>
</table><table id="eip-id1168288181719" class="unnumbered unstyled" summary="આ કોષ્ટક બાદ કરવાનું દર્શાવે છે: 3, આ સંખ્યામાંથી: 8. તેમાં પ્રશ્ન, પરિણામ અને ચકાસણીનું પગલું છે."><label /><tgroup cols="3"><tbody>
<row><entry><span class="token">ⓑ</span> </entry><entry /></row>
<row>
    <entry />
    <entry><m:math><m:mn>8</m:mn><m:mo>−</m:mo><m:mn>3</m:mn></m:math></entry>
  </row>
  <row>
    <entry>બાદ કરો 3, આ સંખ્યામાંથી: 8.</entry>

    <entry><m:math><m:mn>5</m:mn></m:math></entry>
  </row>
<row><entry>સરવાળો કરીને તપાસો.<newline /><m:math><m:mn>5</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>8</m:mn><m:mo>✓</m:mo></m:math></entry><entry /></row>

</tbody>

</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id2719276" class="try">
<exercise id="fs-id2912373">
<problem id="fs-id1210785">
<para id="fs-id1629685">બાદબાકી કરો અને પછી સરવાળો કરીને તપાસો:</para>
<para id="fs-id1560767"><m:math><m:mrow><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>0</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1951537">
<para id="fs-id693621">7 − 0 = 7; 7 + 0 = 7</para>
</solution>
</exercise>
</note>
<note id="fs-id1171103437810" class="try">
<exercise id="fs-id2188831">
<problem id="fs-id2159977">
<para id="fs-id1171105095937">બાદબાકી કરો અને પછી સરવાળો કરીને તપાસો:</para>
<para id="fs-id1578849"><m:math><m:mrow><m:mn>6</m:mn><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id2426512">
<para id="fs-id2633348">6 − 2 = 4; 2 + 4 = 6</para>
</solution>
</exercise>
</note>
<para id="fs-id2845428">એક કરતાં વધુ અંકની સંખ્યાઓની બાદબાકી કરવા માટે સરવાળાની જેમ સંખ્યાઓને સ્તંભમાં ઊભી ગોઠવીને લખવું સામાન્ય રીતે સરળ પડે છે. સ્થાનકિંમત પ્રમાણે અંકો એકની નીચે એક ગોઠવો. પછી એકમથી શરૂ કરીને ડાબે જતાં દરેક સ્તંભની બાદબાકી કરો.</para>
<example id="fs-id2475555"><exercise id="fs-id2296830">
<problem id="fs-id2296304">
<para id="fs-id1461696">બાદબાકી કરો અને પછી સરવાળો કરીને તપાસો: <m:math><m:mrow><m:mn>89</m:mn><m:mo>−</m:mo><m:mn>61</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1410339">
<title>ઉકેલ</title>
<table id="eip-458" class="unnumbered unstyled" summary="બે અંકની સંખ્યાઓની બાદબાકીની ક્રમશઃ રીત દર્શાવતું કોષ્ટક: અંકો ગોઠવવા, સ્થાનકિંમત પ્રમાણે બાદબાકી કરવી અને સરવાળાથી તપાસવું."><tgroup cols="3"><tbody>
  <row>
    <entry>એકમ અને દશકના અંકો એકની નીચે એક આવે તેમ સંખ્યાઓ લખો.</entry>

    <entry><m:math><m:mtable><m:mtr>

    <m:mtd columnalign="right"><m:mn>89</m:mn><m:mspace width="0.2em" /></m:mtd></m:mtr>
<m:mtr>
    <m:mtd columnalign="right"><m:munder accentunder="true"><m:mrow><m:mo>−</m:mo><m:mn>61</m:mn></m:mrow><m:mtext>____</m:mtext></m:munder></m:mtd>
</m:mtr></m:mtable></m:math></entry>
  </row>
  <row>
    <entry>દરેક સ્થાનકિંમતના અંકોની બાદબાકી કરો.<newline /><newline />એકમની બાદબાકી કરો: <m:math><m:mn>9</m:mn><m:mo>-</m:mo><m:mn>1</m:mn><m:mo>=</m:mo><m:mn>8</m:mn></m:math><newline />દશકની બાદબાકી કરો: <m:math><m:mn>8</m:mn><m:mo>-</m:mo><m:mn>6</m:mn><m:mo>=</m:mo><m:mn>2</m:mn></m:math></entry>

    <entry><m:math><m:mtable><m:mtr>

    <m:mtd columnalign="right"><m:mn>89</m:mn><m:mspace width="0.2em" /></m:mtd></m:mtr>
<m:mtr>
    <m:mtd columnalign="right"><m:munder accentunder="true"><m:mrow><m:mo>−</m:mo><m:mn>61</m:mn></m:mrow><m:mtext>____</m:mtext></m:munder></m:mtd>
</m:mtr><m:mtr>
    <m:mtd columnalign="right"><m:mn>28</m:mn><m:mspace width="0.2em" /></m:mtd>
</m:mtr></m:mtable></m:math></entry>
  </row>
<row>

<entry>સરવાળો કરીને તપાસો.<newline /><m:math><m:mtable><m:mtr>
    <m:mtd columnalign="right"><m:mn>28</m:mn><m:mspace width="0.2em" /></m:mtd>
</m:mtr>
<m:mtr>
    <m:mtd columnalign="right"><m:munder accentunder="true"><m:mrow><m:mo>+</m:mo><m:mn>61</m:mn></m:mrow><m:mtext>____</m:mtext></m:munder></m:mtd>
</m:mtr>
<m:mtr>
    <m:mtd columnalign="right"><m:mn>89</m:mn><m:mspace width="0.2em" /></m:mtd>
</m:mtr></m:mtable></m:math></entry><entry />

</row>
</tbody>






</tgroup>
</table><para id="fs-id1361693">આપણો જવાબ સાચો છે.</para>
</solution>
</exercise></example><note id="fs-id1360708" class="try">
<exercise id="fs-id1629443">
<problem id="fs-id1910909">
<para id="fs-id1525494">બાદબાકી કરો અને પછી સરવાળો કરીને તપાસો: <m:math><m:mrow><m:mn>86</m:mn><m:mo>−</m:mo><m:mn>54</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1410435">
<para id="fs-id2820396">86 − 54 = 32 કારણ કે 54 + 32 = 86</para>
</solution>
</exercise>
</note>
<note id="fs-id1223489" class="try">
<exercise id="fs-id2815009">
<problem id="fs-id2620973">
<para id="fs-id3218912">બાદબાકી કરો અને પછી સરવાળો કરીને તપાસો: <m:math><m:mrow><m:mn>99</m:mn><m:mo>−</m:mo><m:mn>74</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2748218">
<para id="fs-id1800833">99 − 74 = 25 કારણ કે 74 + 25 = 99</para>
</solution>
</exercise>
</note>
<para id="fs-id1166761303752">જ્યારે આપણે બાદ કરવાનું નમૂના દ્વારા દર્શાવ્યું: <m:math><m:mrow><m:mn>26</m:mn></m:mrow></m:math> ને આ સંખ્યામાંથી: <m:math><m:mrow><m:mn>43</m:mn><m:mo>,</m:mo></m:mrow></m:math> ત્યારે આપણે <m:math><m:mn>1</m:mn></m:math> દશકના બદલામાં <m:math><m:mrow><m:mn>10</m:mn></m:mrow></m:math> એકમ લીધા. નમૂના વિના આ કરીએ ત્યારે કહીએ છીએ કે આપણે <m:math><m:mn>1</m:mn></m:math> દશકના સ્થાનેથી લઈએ છીએ અને <m:math><m:mrow><m:mn>10</m:mn></m:mrow></m:math> એકમના સ્થાને ઉમેરીએ છીએ.</para>
<note id="fs-id1731638" class="howto"><title>પૂર્ણ સંખ્યાઓનો તફાવત શોધો.</title><list id="eip-id1168289617573" list-type="enumerated" number-style="arabic" class="stepwise"><item>સરખી સ્થાનકિંમતના અંકો એકની નીચે એક આવે તેમ સંખ્યાઓ લખો.</item>
<item>દરેક સ્થાનકિંમતના અંકોની બાદબાકી કરો. એકમના સ્થાનથી શરૂ કરીને જમણેથી ડાબે જાઓ. ઉપરનો અંક નીચેના અંક કરતાં નાનો હોય, તો જરૂર પ્રમાણે ડાબેના સ્થાનમાંથી લો.</item>
<item>જમણેથી ડાબે દરેક સ્થાનકિંમતની બાદબાકી કરતા જાઓ અને જરૂર પડે ત્યારે ડાબેના સ્થાનમાંથી લો.</item>
<item>સરવાળો કરીને તપાસો.</item></list></note><example id="fs-id1275385"><exercise id="fs-id1613753"><problem id="fs-id2164078">
<para id="fs-id1577749">બાદબાકી કરો: <m:math><m:mrow><m:mn>43</m:mn><m:mo>−</m:mo><m:mn>26</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1348086">
<title>ઉકેલ</title>
<table id="eip-640" class="unnumbered unstyled" summary="ડાબેના સ્થાનેથી લઈને સંખ્યાઓની બાદબાકી કરવાની ક્રમશઃ ચિત્રમય માર્ગદર્શિકા, જેમાં લખેલી સૂચનાઓ અને સંબંધિત ચિત્રો છે."><label /><tgroup cols="3">
  <tbody>
    <row>
      <entry>સરખી સ્થાનકિંમતના અંકો એકની નીચે એક આવે તેમ સંખ્યાઓ લખો.</entry>
      <entry><media id="eip-id1168287387607" alt="ઊભી ગોઠવણીમાં 43 ઓછા 26ની બાદબાકી હાથેથી ગણતરી કરવા માટે બતાવેલી છે. નીચેની આડી રેખા દર્શાવે છે કે જવાબ ક્યાં લખાશે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_029_img-01.png" /></media></entry>
    </row>
    <row>
      <entry>એકમની બાદબાકી કરો. આપણે બાદ કરી શકતા નથી 6, જો એકમ માત્ર 3 હોય. તેથી 1 દશક લઈએ છીએ. હવે 3 દશક અને 13 એકમ થાય છે. દરેક સ્થાનની ઉપર આ સંખ્યાઓ લખીએ અને મૂળ અંકો છેકી નાખીએ.</entry>
      <entry><media id="eip-id1168289655873" alt="ઊભી ગોઠવણીમાં 43 ઓછા 26 માટે ફરી જૂથ બનાવીને ડાબેના સ્થાનેથી લેવાની રીત બતાવેલી છે. 4ને 3 અને 3ને 13 તરીકે દર્શાવી બાદબાકીની તૈયારી કરી છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_029_img-02.png" /></media></entry>
    </row>
    <row>
      <entry>હવે એકમની બાદબાકી કરી શકીએ છીએ. <m:math><m:mn>13</m:mn><m:mo>−</m:mo><m:mn>6</m:mn><m:mo>=</m:mo><m:mn>7.</m:mn></m:math> તફાવતમાં એકમના સ્થાને 7 લખીએ છીએ.</entry>
      <entry><media id="eip-id1168287220447" alt="ઊભી ગોઠવણીમાં 43 ઓછા 26 માટે ફરી જૂથ બનાવીને ડાબેના સ્થાનેથી લેવાની રીત બતાવેલી છે. 4ને 3 અને 3ને 13 તરીકે દર્શાવી બાદબાકી કરીને જવાબ 7 મેળવવાની તૈયારી કરી છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_029_img-03.png" /></media></entry>
    </row>
    <row>
      <entry>હવે દશકની બાદબાકી કરીએ. <m:math><m:mn>3</m:mn><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>1.</m:mn></m:math> તફાવતમાં દશકના સ્થાને 1 લખીએ છીએ.</entry>
      <entry><media id="eip-id1168287397473" alt="ડાબેના સ્થાનેથી લઈને બાદબાકી કરવાનું હાથેથી લખેલું ઉદાહરણ: 43 ઓછા 26 બરાબર 17."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_029_img-04.png" /></media></entry>
    </row>
    <row>
      <entry align="left">સરવાળો કરીને તપાસો.<newline /><newline /><media id="eip-id1168287108984" alt="ઊભી ગોઠવણીમાં સરવાળો 17 વત્તા 26 બરાબર 43 દર્શાવેલો છે. જવાબ સાચો છે તે કાળા ખરાના ચિહ્નથી દર્શાવ્યું છે. અંકો એકની નીચે એક ગોઠવી મૂળભૂત અંકગણિતની ક્રિયા દર્શાવી છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_029_img-05.png" /></media><newline /> આપણો જવાબ સાચો છે.</entry>
                        <entry />
    </row>
  </tbody>
</tgroup></table></solution>
</exercise></example><note id="fs-id2150843" class="try">
<exercise id="fs-id1742261">
<problem id="fs-id1701846">
<para id="fs-id2303950">બાદબાકી કરો અને પછી સરવાળો કરીને તપાસો: <m:math><m:mrow><m:mn>93</m:mn><m:mo>−</m:mo><m:mn>58</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id3317038">
<para id="fs-id2135460">93 − 58 = 35 કારણ કે 58 + 35 = 93</para>
</solution>
</exercise>
</note>
<note id="fs-id1171105187191" class="try">
<exercise id="fs-id2840420">
<problem id="fs-id2221864">
<para id="fs-id1378267">બાદબાકી કરો અને પછી સરવાળો કરીને તપાસો: <m:math><m:mrow><m:mn>81</m:mn><m:mo>−</m:mo><m:mn>39</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1693021">
<para id="fs-id2207092">81 − 39 = 42 કારણ કે 42 + 39 = 81</para>
</solution>
</exercise>
</note>
<example id="fs-id1342104"><exercise id="fs-id2170154"><problem id="fs-id2626383">
<para id="fs-id2326446">બાદબાકી કરો અને પછી સરવાળો કરીને તપાસો: <m:math><m:mrow><m:mn>207</m:mn><m:mo>−</m:mo><m:mn>64</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1239022">
<title>ઉકેલ</title>
<table id="eip-274" class="unnumbered unstyled has-images" summary="આ કોષ્ટક એકથી વધુ અંકની સંખ્યાઓની બાદબાકીમાં ડાબેના સ્થાનેથી લેવાની ક્રમશઃ રીત અને પછી ચકાસણીનું પગલું દર્શાવે છે."><label /><tgroup cols="3"><tbody>
  <row>
    <entry>સરખી સ્થાનકિંમતના અંકો એકની નીચે એક આવે તેમ સંખ્યાઓ લખો. </entry>

    <entry><media id="eip-id1168288438042" alt="ઊભી ગોઠવણીમાં 207 ઓછા 64ની બાદબાકી છે. જવાબ નીચે લખવા માટે રેખા આપેલી છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_030-01.png" /></media></entry>
  </row>

<row><entry>એકમની બાદબાકી કરો. <m:math><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>=</m:mo><m:mn>3.</m:mn></m:math> <newline /> તફાવતમાં એકમના સ્થાને 3 લખો.</entry>
<entry><media id="eip-id1168288437405" alt="ઊભી ગોઠવણીમાં 207 - 64ની બાદબાકીમાં શરૂઆતમાં સોના સ્થાનેથી દશકના સ્થાને લેવાનું અને એકમનો અંક 3 મેળવવાનું દર્શાવ્યું છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_030-02.png" /></media></entry></row>

<row><entry>દશકની બાદબાકી કરો. આપણે બાદ કરી શકતા નથી 6, જો દશક 0 હોય. તેથી 1 સો લઈએ છીએ અને 10 દશકને આપણી પાસેના 0 દશકમાં ઉમેરીએ છીએ. હવે કુલ 10 દશક થાય છે. દશકના સ્થાનની ઉપર 10 લખીએ અને 0 છેકી નાખીએ. પછી સોના સ્થાનનો 2 છેકીને તેની ઉપર 1 લખીએ.</entry>
<entry><media id="eip-id1168288437422" alt="ઊભી ગોઠવણીમાં 207 - 64ની બાદબાકીમાં શરૂઆતમાં સોના સ્થાનેથી દશકના સ્થાને લેવાનું અને એકમનો અંક 3 મેળવવાનું દર્શાવ્યું છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_030-03.png" /></media></entry></row>

<row><entry>હવે દશકની બાદબાકી કરીએ. <m:math><m:mn>10</m:mn><m:mo>−</m:mo><m:mn>6</m:mn><m:mo>=</m:mo><m:mn>4.</m:mn></m:math> તફાવતમાં દશકના સ્થાને 4 લખીએ છીએ.</entry>
<entry><media id="eip-id1168286359298" alt="ઊભી ગોઠવણીની બાદબાકીમાં ડાબેના સ્થાનેથી લેવાની રીત દર્શાવેલી છે. ગણતરીમાં 107 ઓછા 64નું પરિણામ 43 બતાવ્યું છે. છેકેલા અંકો અને તેમની ઉપરનાં નવાં મૂલ્યો ફરી જૂથ બનાવવાનું દર્શાવે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_030-04.png" /></media></entry></row>

<row><entry>અંતે સોની બાદબાકી કરો. નીચેની સંખ્યામાં સોના સ્થાને કોઈ અંક નથી, તેથી તે સ્થાને 0 હોવાનું ધારી શકીએ છીએ. કારણ કે <m:math><m:mn>1</m:mn><m:mo>−</m:mo><m:mn>0</m:mn><m:mo>=</m:mo><m:mn>1,</m:mn></m:math> તેથી તફાવતમાં સોના સ્થાને 1 લખીએ છીએ.</entry><entry><media id="eip-id1168286107560" alt="ઊભી ગોઠવણીમાં 207 ઓછા 64ની બાદબાકી છે. ડાબેના સ્થાનેથી લેવાનાં પગલાં સાથે જવાબ 143 દર્શાવેલો છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_030-05.png" /></media></entry></row>

<row><entry align="left">સરવાળો કરીને તપાસો.

<newline /><media id="eip-id1168286107574" alt="ઊભી ગોઠવણીમાં 143 + 64નો સરવાળો છે. એક 1 મૂકેલો છે પહેલા અંક 1ની ઉપર, જે સંખ્યા 143નો ભાગ છે. પરિણામ 207 છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_030-06.png" /></media><newline />આપણો જવાબ સાચો છે.</entry>
<entry /></row>

</tbody>

</tgroup>
</table></solution>
</exercise></example><note id="fs-id1346520" class="try">
<exercise id="fs-id1917427">
<problem id="fs-id1828463">
<para id="fs-id1597739">બાદબાકી કરો અને પછી સરવાળો કરીને તપાસો: <m:math><m:mrow><m:mn>439</m:mn><m:mo>−</m:mo><m:mn>52</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1583263">
<para id="fs-id2241359">439 − 52 = 387 કારણ કે 387 + 52 = 439</para>
</solution>
</exercise>
</note>
<note id="fs-id1270084" class="try">
<exercise id="fs-id1827735">
<problem id="fs-id1968857">
<para id="fs-id2304206">બાદબાકી કરો અને પછી સરવાળો કરીને તપાસો: <m:math><m:mrow><m:mn>318</m:mn><m:mo>−</m:mo><m:mn>75</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1581788">
<para id="fs-id2375206">318 − 75 = 243 કારણ કે 243 + 75 = 318</para>
</solution>
</exercise>
</note>
<example id="fs-id1945438">
<exercise id="fs-id2279338"><problem id="fs-id1394122">
<para id="fs-id1358072">બાદબાકી કરો અને પછી સરવાળો કરીને તપાસો: <m:math><m:mrow><m:mn>910</m:mn><m:mo>−</m:mo><m:mn>586</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1633271">
<title>ઉકેલ</title>
<table id="eip-537" class="unnumbered unstyled has-images" summary="એકથી વધુ અંકની સંખ્યાઓની બાદબાકીમાં ડાબેના સ્થાનેથી લેવાની ક્રમશઃ માર્ગદર્શિકા, જેમાં સૂચનાઓની બાજુમાં ચિત્રરૂપ ઉદાહરણો અને અંતિમ ચકાસણી છે."><label /><tgroup cols="3"><tbody>
  <row>
    <entry>સરખી સ્થાનકિંમતના અંકો એકની નીચે એક આવે તેમ સંખ્યાઓ લખો.</entry>

    <entry><media id="eip-id1168286000380" alt="ઊભી ગોઠવણીમાં બાદબાકી આપેલી છે: ઉપર 910 અને નીચે 586 છે. તેમની નીચે આડી રેખા છે અને 586ની ડાબે ઓછાનું ચિહ્ન ક્રિયા દર્શાવે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_031-01.png" /></media></entry>
  </row>
<row><entry>એકમની બાદબાકી કરો. આપણે બાદ કરી શકતા નથી 6, જો એકમ 0 હોય. તેથી 1 દશક લઈને 10 એકમને આપણી પાસેના 0 એકમમાં ઉમેરીએ છીએ. હવે 10 એકમ થાય છે. દશકના સ્થાનની ઉપર 0 લખીને 1 છેકીએ. એકમના સ્થાનની ઉપર 10 લખીને 0 છેકીએ. હવે એકમની બાદબાકી કરી શકીએ છીએ. <m:math><m:mn>10</m:mn><m:mo>−</m:mo><m:mn>6</m:mn><m:mo>=</m:mo><m:mn>4.</m:mn></m:math></entry><entry><media id="eip-id1168286081647" alt="ઊભી ગોઠવણીમાં 910 ઓછા 586ની બાદબાકી છે. એકમના સ્તંભ માટે ડાબેના સ્થાનેથી લેવાનું પહેલું પગલું બતાવ્યું છે: દશકના સ્થાનનો “1” બદલાઈને “0” અને એકમનો “0” બદલાઈને “10” થાય છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_031-02.png" /></media></entry></row>

  <row>
    <entry>તફાવતમાં એકમના સ્થાને 4 લખો.</entry>

    <entry><media id="eip-id1168286081662" alt="ઊભી ગોઠવણીમાં 910 ઓછા 586ની બાદબાકી છે. એકમના સ્તંભ માટે ડાબેના સ્થાનેથી લેવાનું પહેલું પગલું બતાવ્યું છે: દશકના સ્થાનનો “1” બદલાઈને “0” અને એકમનો “0” બદલાઈને “10” થાય છે; જવાબ 4 મળે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_031-03.png" /></media></entry>
  </row>
  <row>
    <entry>દશકની બાદબાકી કરો. આપણે બાદ કરી શકતા નથી 8, જો દશક 0 હોય. તેથી 1 સો લઈને 10 દશકને આપણી પાસેના 0 દશકમાં ઉમેરીએ છીએ; હવે 10 દશક થાય છે. સોના સ્થાનની ઉપર 8 લખીને 9 છેકો. દશકના સ્થાનની ઉપર 10 લખો.</entry>

    <entry><media id="eip-id1168286001486" alt="ઊભી ગોઠવણીમાં 910 ઓછા 586ની બાદબાકી છે. એકમના સ્તંભ માટે ડાબેના સ્થાનેથી લેવાનું પહેલું પગલું બતાવ્યું છે: સોના સ્થાનનો “9” બદલાઈને “8”, દશકનો “1” બદલાઈને “10” અને એકમનો “0” બદલાઈને “10” થાય છે. જવાબ 4 મળે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_031-04.png" /></media></entry>
  </row>
  <row>
    <entry>હવે દશકની બાદબાકી કરી શકીએ છીએ. <m:math><m:mn>10</m:mn><m:mo>−</m:mo><m:mn>8</m:mn><m:mo>=</m:mo><m:mn>2</m:mn></m:math>.</entry>

    <entry><media id="eip-id1168286120643" alt="ઊભી ગોઠવણીમાં ડાબેના સ્થાનેથી લઈને કરાતી બાદબાકીનું ચિત્ર: 910 ઓછા 586. એકમ અને દશક માટે લેવાનાં પગલાં બતાવ્યાં છે, જેમાં અનુક્રમે 4 અને 2 મળે છે. પણ અંતિમ પરિણામ 24 ખોટું છે, કારણ કે તે 324 હોવું જોઈએ."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_031-05.png" /></media></entry>
  </row>
    <row>
    <entry>સોના સ્થાનની બાદબાકી કરો. <m:math><m:mn>8</m:mn><m:mo>−</m:mo><m:mn>5</m:mn><m:mo>=</m:mo><m:mn>3</m:mn></m:math> તફાવતમાં સોના સ્થાને 3 લખો.</entry>

    <entry><media id="eip-id1168286048977" alt="ઊભી ગોઠવણીમાં 910 - 586 = 324ની બાદબાકી; તેને ઉકેલવા માટે ફરી જૂથ બનાવવાની રીત દર્શાવી છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_031-06.png" /></media></entry></row>
   <row>
    <entry align="left">સરવાળો કરીને તપાસો. <newline /><newline /><media id="eip-id1170325408185" alt="ઊભી ગોઠવણીમાં 324 વત્તા 586 બરાબર 910નો સરવાળો છે. આગળના સ્થાને લઈ જવાતા અંકો સંખ્યાઓની ઉપર દર્શાવ્યા છે અને ખરાનું ચિહ્ન સરવાળો સાચો હોવાનું બતાવે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_031-07.png" /></media><newline /><newline />આપણો જવાબ સાચો છે.</entry><entry />
  </row></tbody>



</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id1971918" class="try">
<exercise id="fs-id2276824">
<problem id="fs-id1168988">
<para id="fs-id2129521">બાદબાકી કરો અને પછી સરવાળો કરીને તપાસો: <m:math><m:mrow><m:mn>832</m:mn><m:mo>−</m:mo><m:mn>376</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2498289">
<para id="fs-id4163390">832 − 376 = 456 કારણ કે 456 + 376 = 832</para>
</solution>
</exercise>
</note>
<note id="fs-id1171105576258" class="try">
<exercise id="fs-id1585831">
<problem id="fs-id2650144">
<para id="fs-id1579616">બાદબાકી કરો અને પછી સરવાળો કરીને તપાસો: <m:math><m:mrow><m:mn>847</m:mn><m:mo>−</m:mo><m:mn>578</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2642642">
<para id="fs-id1249841">847 − 578 = 269 કારણ કે 269 + 578 = 847</para>
</solution>
</exercise>
</note>
<example id="fs-id1569033">
<exercise id="fs-id1392397"><problem id="fs-id146504482">
<para id="fs-id238844637">બાદબાકી કરો અને પછી સરવાળો કરીને તપાસો: <m:math><m:mrow><m:mn>2,162</m:mn><m:mo>−</m:mo><m:mn>479</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id178447819">
<title>ઉકેલ</title>
<table id="eip-7544534" class="unnumbered unstyled" aria-label="ચિત્રમાં બે સ્તંભ છે: ડાબે નોંધો અને જમણે ગાણિતિક પદાવલીઓ. પહેલી લીટી સરખી સ્થાનકિંમતના અંકો એકની નીચે એક આવે તેમ સંખ્યાઓ લખવાનું કહે છે. સામે 2,162 ઓછા 479 ઊભી ગોઠવણીમાં છે. પછીની લીટી એકમની બાદબાકી કરવાનું કહે છે. બાદ કરી શકતા નથી 9, જો માત્ર 2 એકમ હોય; તેથી 1 દશક લઈને 10 એકમને આપણી પાસેના 2 એકમમાં ઉમેરતાં 12 એકમ થાય છે. દશકની ઉપર 5 લખીને 6 છેકો. એકમની ઉપર 5 લખીને 2 છેકો. એકમની ઉપર 12 લખીને 2 છેકો. બાજુમાં 2,162 ઓછા 479ની ઊભી પદાવલીમાં 6 છેકીને 5 અને 2 છેકીને 12 કરેલું છે. પછી હવે એકમની બાદબાકી કરી શકીએ એવું લખેલું છે; સામે 12 ઓછા 9 બરાબર 3 છે. પછી તફાવતમાં એકમના સ્થાને 3 લખવાનું કહે છે. બાજુમાં 2,162 ઓછા 479ની પદાવલીના એકમના સ્તંભમાં ત્રણ મૂકેલું છે. પછી દશકની બાદબાકી કરવાનું કહે છે. બાદ કરી શકતા નથી 7, જો માત્ર 5 દશક હોય; તેથી 1 સો લઈને 10 દશકને આપણી પાસેના 5 દશકમાં ઉમેરતાં કુલ 15 દશક થાય છે. સોના સ્થાનની ઉપર 0 લખીને 1 છેકો. દશકની ઉપર 15 લખો. સામે તે જ ઊભી પદાવલીમાં અગાઉ લખેલો 5 છેકીને 15 અને એક છેકીને 0 કરેલું છે. પછી હવે દશકની બાદબાકી કરી શકીએ એવું લખેલું છે; સામે 15 ઓછા 7 બરાબર 8 છે. પછી તફાવતમાં દશકના સ્થાને 8 લખવાનું કહે છે. બાજુમાં તે જ ઊભી પદાવલીના દશકના સ્થાને 8 છે. પછી સોની બાદબાકી કરવાનું કહે છે. બાદ કરી શકતા નથી 4, જો સો 0 હોય; તેથી 1 હજાર લઈને 10 સો આપણી પાસેના 0 સોમાં ઉમેરતાં કુલ 10 સો થાય છે. હજારની ઉપર 1 લખીને 2 છેકો. સોની ઉપર 10 લખો. સામે તે જ પદાવલીમાં અગાઉ લખેલો શૂન્ય છેકીને 10 અને 2 છેકીને 1 કરેલું છે. પછી હવે સોની બાદબાકી કરી શકીએ એવું લખેલું છે; સામે 10 ઓછા 4 બરાબર 6 છે. પછી તફાવતમાં સોના સ્થાને 6 લખવાનું કહે છે. બાજુમાં પદાવલીના સોના સ્થાને હવે 6 છે. છેલ્લે હજારની બાદબાકી કરવાનું કહે છે. નીચેની સંખ્યામાં હજારના સ્થાને અંક નથી, તેથી ત્યાં 0 હોવાનું ધારીએ છીએ. 1 ઓછા 0 બરાબર 1. તફાવતમાં હજારના સ્થાને 1 લખો. બાજુમાં તે જ ઊભી પદાવલી સાથે પૂરો જવાબ 1, 683 છે."><label /><tgroup cols="3"><tbody>
  <row>
    <entry>સરખી સ્થાનકિંમતના અંકો એકની નીચે એક આવે તેમ સંખ્યાઓ લખો.</entry>

    <entry><media id="eip-id11682884288577" alt="ઊભી ગોઠવણીમાં 2162 ઓછા 479ની બાદબાકી."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_028_img-02.png" /></media></entry>
  </row>
  <row>
    <entry>એકમની બાદબાકી કરો. બાદ કરી શકતા નથી 9, જો એકમ માત્ર 2 હોય. તેથી 1 દશક લઈને 10 એકમને 2 એકમમાં ઉમેરો, જેથી 12 એકમ થાય. દશકના સ્થાનની ઉપર 5 લખીને 6 છેકો. એકમના સ્થાનની ઉપર 12 લખીને 2 છેકો.</entry>

    <entry><media id="eip-id11682848234234288577" alt="ઊભી ગોઠવણીમાં 2162 ઓછા 479ની બાદબાકી અને ડાબેના સ્થાનેથી લેવાની પ્રક્રિયા. એકમના સ્થાનનો “2” બદલાઈને “12” થાય છે; તે માટે દશકના સ્થાનના “6”માંથી લેવાતાં ત્યાં “5” થાય છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_028_img-03.png" /></media></entry>
  </row>
  <row>
    <entry>હવે એકમની બાદબાકી કરી શકીએ છીએ.</entry>
    <entry><m:math><m:mn>12</m:mn><m:mo>−</m:mo><m:mn>9</m:mn><m:mo>=</m:mo><m:mn>3</m:mn></m:math></entry>
  </row>
  <row>
    <entry>તફાવતમાં એકમના સ્થાને 3 લખો.</entry>
    <entry><media id="eip-id11682882344278787834288577" alt="ઊભી ગોઠવણીમાં 2162માંથી 479 બાદ થાય છે. ડાબેના સ્થાનેથી લેવાનું પહેલું પગલું બતાવ્યું છે: એકમના સ્થાનનો “2” બદલાઈને “12” અને દશકના સ્થાનનો “6” બદલાઈને “5” થાય છે. એકમના સ્તંભમાં “3” મળે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_028_img-04.png" /></media></entry>
  </row>
<row>
<entry>દશકની બાદબાકી કરો. બાદ કરી શકતા નથી 7, જો દશક માત્ર 5 હોય. તેથી 1 સો લઈને 10 દશકને 5 દશકમાં ઉમેરો, જેથી 15 દશક થાય. સોના સ્થાનની ઉપર 0 લખીને 1 છેકો. દશકના સ્થાનની ઉપર 15 લખો.</entry><entry><media id="eip-id17878447168284288577" alt="ઊભી ગોઠવણીમાં 2162માંથી 479 બાદ થાય છે. ડાબેના સ્થાનેથી લેવાનાં પગલાં બતાવ્યાં છે: એકમનો “2” બદલાઈને “12” અને દશકનો “6” બદલાઈને “5” થાય છે. પછી તેને છેકીને “15” કરાય છે અને સોના સ્થાનનો “1” બદલાઈને “0” થાય છે. જવાબના એકમના સ્થાને “3” લખાય છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_028_img-05.png" /></media></entry></row>
<row><entry>હવે દશકની બાદબાકી કરી શકીએ છીએ.</entry><entry><m:math><m:mn>15</m:mn><m:mo>−</m:mo><m:mn>7</m:mn><m:mo>=</m:mo><m:mn>8</m:mn></m:math></entry></row>
<row>
<entry>તફાવતમાં દશકના સ્થાને 8 લખો.</entry><entry><media id="eip-id17878716828823427878784434288577" alt="ઊભી ગોઠવણીમાં 2162માંથી 479 બાદ થાય છે. ડાબેના સ્થાનેથી લેવાનાં પગલાં બતાવ્યાં છે: એકમનો “2” બદલાઈને “12”, દશકનો “6” બદલાઈને “15” અને સોનો “1” બદલાઈને “0” થાય છે. જવાબના એકમના સ્થાને “3” અને દશકના સ્થાને “8” લખાય છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_028_img-06.png" /></media></entry></row>

<row><entry>હવે સોની બાદબાકી કરી શકીએ છીએ.</entry><entry><media id="eip-id1787878989448284288577" alt="ઊભી ગોઠવણીમાં બાદબાકીની ક્રમશઃ રીત ડાબેના સ્થાનેથી લઈને અથવા ફરી જૂથ બનાવીને દર્શાવી છે. 2062 ઓછા 479નું પરિણામ 1583 છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_028_img-07.png" /></media></entry></row>
<row><entry>તફાવતમાં સોના સ્થાને 6 લખો.</entry><entry><media id="eip-id1787428844577" alt="ઊભી ગોઠવણીમાં 2162 ઓછા 479ની બાદબાકીમાં ડાબેના સ્થાનેથી લેવાનું દર્શાવ્યું છે; પરિણામ 1683 છે. અંતિમ જવાબ 1683નો એક ભાગ (“6”) લાલ રંગમાં છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_028_img-08.png" /></media></entry></row>
<row><entry>હજારની બાદબાકી કરો. નીચેની સંખ્યામાં હજારના સ્થાને કોઈ અંક નથી, તેથી ત્યાં 0 હોવાનું ધારીએ છીએ. <m:math><m:mn>1</m:mn><m:mo>−</m:mo><m:mn>0</m:mn><m:mo>=</m:mo><m:mn>1.</m:mn></m:math> તફાવતમાં હજારના સ્થાને 1 લખો.</entry><entry><media id="eip-id178744428858277" alt="ઊભી ગોઠવણીમાં 2162 ઓછા 479ની બાદબાકીમાં ડાબેના સ્થાનેથી લેવાનું દર્શાવ્યું છે; પરિણામ 1683 છે. અંતિમ જવાબ 1683નો એક ભાગ (“1”) લાલ રંગમાં છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_028_img-09.png" /></media></entry></row>
<row><entry>સરવાળો કરીને તપાસો.<newline /><newline /><m:math><m:mrow><m:mtable><m:mtr /><m:mtr><m:mtd columnalign="left"><m:mspace width="1em" /><m:mover><m:mn>1</m:mn><m:mn mathsize="small">1</m:mn></m:mover><m:mo>,</m:mo><m:mover><m:mn>6</m:mn><m:mn mathsize="small">1</m:mn></m:mover><m:mover><m:mn>8</m:mn><m:mn mathsize="small">1</m:mn></m:mover><m:mn>3</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mspace width="0.71em" /><m:munder accentunder="true"><m:mrow><m:mo>+</m:mo><m:mspace width="0.55em" /><m:mn>479</m:mn></m:mrow><m:mtext>______</m:mtext></m:munder></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mspace width="1.1em" /><m:mn>2,</m:mn><m:mspace width="0.3em" /><m:mn>162</m:mn><m:mo>✓</m:mo></m:mtd></m:mtr></m:mtable></m:mrow></m:math></entry><entry />
</row>
</tbody>








</tgroup>
</table><para id="fs-id2687501">આપણો જવાબ સાચો છે.</para>
</solution>
</exercise></example>
<note id="fs-id2593949" class="try">
<exercise id="fs-id1388321">
<problem id="fs-id1715649">
<para id="fs-id1263162">બાદબાકી કરો અને પછી સરવાળો કરીને તપાસો: <m:math><m:mrow><m:mn>4,585</m:mn><m:mo>−</m:mo><m:mn>697</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1575932">
<para id="fs-id1632703">4,585 − 697 = 3,888 કારણ કે 3,888 + 697 = 4,585</para>
</solution>
</exercise>
</note>
<note id="fs-id1789710" class="try">
<exercise id="fs-id1397173">
<problem id="fs-id1351192">
<para id="fs-id2339954">બાદબાકી કરો અને પછી સરવાળો કરીને તપાસો: <m:math><m:mrow><m:mn>5,637</m:mn><m:mo>−</m:mo><m:mn>899</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1410058">
<para id="fs-id2284283">5,637 − 899 = 4,738 કારણ કે 4,738 + 899 = 5,637</para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id2567736">
<title>શબ્દોમાં આપેલી વાતને ગણિતની લખાવટમાં ફેરવો</title>
<para id="fs-id2171599">સરવાળાની જેમ, <term class="no-emphasis" id="term-00002">શબ્દસમૂહો</term>  પણ બે સંખ્યાઓની બાદબાકી કરવાની સૂચના આપી શકે છે. શબ્દોમાં આપેલી વાતને ગણિતની લખાવટમાં ફેરવવા માટે બાદબાકી સૂચવતા મુખ્ય શબ્દો શોધીએ છીએ. બાદબાકી સૂચવતા કેટલાક શબ્દો અહીં આપેલા છે: <link target-id="fs-id1549826" />.</para>
<table id="fs-id1549826" aria-label="આ કોષ્ટકમાં બે હરોળ અને પાંચ સ્તંભ છે. પહેલી હરોળ શીર્ષકની છે. ડાબેથી જમણે સ્તંભનાં નામ ક્રિયા, શબ્દસમૂહ, ઉદાહરણ અને પદાવલી છે. બીજી હરોળમાં ક્રિયાના સ્તંભમાં બાદબાકી લખેલું છે. શબ્દસમૂહમાં ઓછા, તફાવત, ઘટાડો, કરતાં ઓછું અને આમાંથી બાદ કરો છે. ઉદાહરણોની યાદી છે: 5 ઓછા 2; આ સંખ્યાઓનો તફાવત: 9 અને 4; આ સંખ્યામાં ઘટાડો: 7, ઘટાડાની સંખ્યા: 3; આટલો ઘટાડો: 5, મૂળ સંખ્યા: 8; બાદ કરો 1, આ સંખ્યામાંથી: 6. પદાવલીની યાદી છે: 5 ઓછા 1, 9 ઓછા 4, 7 ઓછા 3, 8 ઓછા 5, 6 ઓછા 1."><tgroup cols="4"><colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<colspec colnum="3" colname="c3" />
<colspec colnum="4" colname="c4" />
<thead>
<row valign="top">
<entry align="left">ક્રિયા</entry>
<entry align="left">શબ્દસમૂહ</entry>
<entry align="left">ઉદાહરણ</entry>
<entry align="left">પદાવલી</entry>
</row>
</thead>
<tbody>
<row valign="top">
  <entry valign="top" align="left">બાદબાકી</entry>
<entry valign="top" align="left">ઓછા</entry>
<entry><m:math><m:mn>5</m:mn></m:math> ઓછા <m:math><m:mn>1</m:mn></m:math></entry>
<entry><m:math><m:mrow><m:mn>5</m:mn><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math></entry>
</row>
<row>
<entry />
  <entry>તફાવત</entry>
  <entry>આ સંખ્યાઓનો તફાવત: <m:math><m:mn>9</m:mn></m:math> અને <m:math><m:mn>4</m:mn></m:math></entry>
  <entry><m:math><m:mrow><m:mn>9</m:mn><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></entry>
</row>
<row>
<entry />
  <entry>માં ઘટાડો કરો:</entry>
  <entry><m:math><m:mrow><m:mn>7</m:mn></m:mrow></m:math> માં ઘટાડો કરો: <m:math><m:mrow><m:mn>3</m:mn></m:mrow></m:math></entry>
  <entry><m:math><m:mrow><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math></entry>

</row>
<row>
<entry />
  <entry>જેટલો ઘટાડો આ સંખ્યામાં:</entry>
  <entry><m:math><m:mrow><m:mn>5</m:mn></m:mrow></m:math> જેટલો ઘટાડો આ સંખ્યામાં: <m:math><m:mrow><m:mn>8</m:mn></m:mrow></m:math></entry>
  <entry><m:math><m:mrow><m:mn>8</m:mn><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math></entry>
  </row>
  <row>
<entry />
    <entry>બાદ કરો આ સંખ્યામાંથી:</entry>

<entry valign="top" align="left"><m:math><m:mrow><m:mn>1</m:mn></m:mrow></m:math> બાદ કરો આ સંખ્યામાંથી: <m:math><m:mrow><m:mn>6</m:mn></m:mrow></m:math></entry>

<entry valign="top" align="left"><m:math><m:mrow><m:mn>6</m:mn><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math></entry>
</row>
</tbody>

</tgroup>
</table><example id="fs-id2297604">
<exercise id="fs-id2564560"><problem id="fs-id1474802">
<para id="fs-id1270867">ગણિતની લખાવટમાં ફેરવો અને પછી સરળ કરો:</para>
<list id="eip-id1168287211491" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> આ સંખ્યાઓનો તફાવત: <m:math><m:mrow><m:mn>13</m:mn></m:mrow></m:math> અને <m:math><m:mn>8</m:mn></m:math></item>
<item><span class="token">ⓑ</span> બાદ કરો: <m:math><m:mrow><m:mn>24</m:mn></m:mrow></m:math> આ સંખ્યામાંથી: <m:math><m:mrow><m:mn>43</m:mn></m:mrow></m:math></item></list></problem>
<solution id="fs-id1594955">
<title>ઉકેલ</title>
<list id="eip-id1168287211527" list-type="labeled-item" class="circled"><item><span class="token">ⓐ</span> <para id="eip-id1168287211532">આ <emphasis effect="italics">તફાવત</emphasis>  શબ્દ બંને સંખ્યાની બાદબાકી કરવાનું કહે છે. સંખ્યાઓનો ક્રમ શબ્દસમૂહમાં આપેલા ક્રમ જેવો જ રહે છે.</para>
<table id="eip-id1168289460345" class="unnumbered unstyled" summary="શબ્દોમાં આપેલી ગાણિતિક વાતને પદાવલીમાં ફેરવીને સરળ કરી તેનું સંખ્યાત્મક મૂલ્ય મેળવવાનાં પગલાં."><label /><tgroup cols="3"><tbody>
  <row>

    <entry />
    <entry>13 અને 8નો તફાવત </entry>
  </row>
  <row>
    <entry>ગણિતની લખાવટમાં ફેરવો.</entry>

    <entry><m:math><m:mn>13</m:mn><m:mo>−</m:mo><m:mn>8</m:mn></m:math></entry>
  </row>
  <row>
    <entry>સરળ કરો.</entry>

    <entry>5</entry>
  </row>
</tbody>

</tgroup>
</table></item>
<item><span class="token">ⓑ</span> <para id="eip-id1168288218378">આ શબ્દો <emphasis effect="italics">બાદ કરો</emphasis> <emphasis effect="italics">આ સંખ્યામાંથી</emphasis>  કહે છે કે પહેલી સંખ્યાને બીજી સંખ્યામાંથી દૂર કરવાની છે. ક્રમ સાચો રાખવા કાળજી લેવી જરૂરી છે.</para>
<table id="eip-id1168287585454" class="unnumbered unstyled" summary="આ કોષ્ટકમાં શબ્દોમાં આપેલા પ્રશ્નને ગાણિતિક પદાવલીમાં ફેરવીને સરળ કરી સંખ્યાત્મક પરિણામ મેળવવાનાં પગલાં દર્શાવ્યાં છે."><label /><tgroup cols="3"><tbody>
  <row>
    <entry />

    <entry>બાદ કરો 24, આ સંખ્યામાંથી: 43 </entry>
  </row>
  <row>
    <entry>ગણિતની લખાવટમાં ફેરવો.</entry>

    <entry><m:math><m:mn>43</m:mn><m:mo>−</m:mo><m:mn>24</m:mn></m:math></entry>
  </row>
  <row>
    <entry>સરળ કરો.</entry>

    <entry>19</entry>
  </row>
</tbody>

</tgroup>
</table></item></list></solution>
</exercise></example>
<note id="fs-id1368904" class="try">
<exercise id="fs-id2262948"><problem id="fs-id3400211">
<para id="fs-id1788606">ગણિતની લખાવટમાં ફેરવો અને સરળ કરો:</para>
<list id="eip-id1168287201538" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> આ સંખ્યાઓનો તફાવત: <m:math><m:mrow><m:mn>14</m:mn></m:mrow></m:math> અને <m:math><m:mn>9</m:mn></m:math> </item><item><span class="token">ⓑ</span> બાદ કરો: <m:math><m:mrow><m:mn>21</m:mn></m:mrow></m:math> આ સંખ્યામાંથી: <m:math><m:mrow><m:mn>37</m:mn></m:mrow></m:math></item></list></problem>
<solution id="fs-id2619048">
<list id="eip-id1168289744400" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> 14 − 9 = 5 </item><item><span class="token">ⓑ</span> 37 − 21 = 16</item></list></solution>
</exercise></note>
<note id="fs-id1171103491683" class="try">
<exercise id="fs-id1508933"><problem id="fs-id1246927">
<para id="fs-id1171105193959">ગણિતની લખાવટમાં ફેરવો અને સરળ કરો:</para>
<list id="eip-id1168288492687" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mn>11</m:mn></m:math> માં ઘટાડો કરો: <m:math><m:mn>6</m:mn></m:math></item><item><span class="token">ⓑ</span> <m:math><m:mn>18</m:mn></m:math> જેટલો ઘટાડો આ સંખ્યામાં: <m:math><m:mn>67</m:mn></m:math></item></list></problem>
<solution id="fs-id1544573">
<list id="eip-id1168288224096" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> 11 − 6 = 5 </item><item><span class="token">ⓑ</span> 67 − 18 = 49</item></list></solution>
</exercise></note>
</section>
<section id="fs-id1828922">
<title>વ્યવહારુ પ્રશ્નોમાં પૂર્ણ સંખ્યાઓની બાદબાકી કરો</title>
<para id="fs-id1842344">બાદબાકીના <term class="no-emphasis" id="term-00003">વ્યવહારુ પ્રશ્નો</term>  ઉકેલવા માટે સરવાળામાં વાપરેલી યોજના જ વાપરીશું. પહેલાં શું શોધવાનું પૂછ્યું છે તે નક્કી કરવું જરૂરી છે. પછી તે શોધવા માટેની માહિતી શબ્દોમાં લખીએ. શબ્દોમાં આપેલી વાતને ગણિતની લખાવટમાં ફેરવીને સરળ કરીએ અને જવાબ મેળવીએ. અંતે યોગ્ય એકમ વાપરીને પ્રશ્નના જવાબનું વાક્ય લખીએ.</para>
<example id="fs-id1827542"><exercise id="fs-id1827544"><problem id="fs-id768604">
<para id="fs-id768606">શિકાગોમાં એક સવારે તાપમાન <m:math><m:mrow><m:mn>73</m:mn></m:mrow></m:math> ડિગ્રી ફેરનહાઇટ હતું. ઠંડી હવાના મોરચાના આગમન પછી બપોર સુધીમાં તાપમાન <m:math><m:mrow><m:mn>27</m:mn></m:mrow></m:math> ડિગ્રી ફેરનહાઇટ થયું. સવાર અને બપોરના તાપમાન વચ્ચે કેટલો તફાવત હતો?</para>
</problem>
<solution id="fs-id1397059">
<title>ઉકેલ</title>
<para id="fs-id1151361">સવાર અને બપોરના તાપમાન વચ્ચેનો તફાવત શોધવાનું પૂછ્યું છે.</para>
<table id="eip-505" class="unnumbered unstyled" summary="આ કોષ્ટકમાં શબ્દસમૂહને બાદબાકીના પ્રશ્નમાં ફેરવીને સંખ્યાઓનો તફાવત ગણવાની ક્રમશઃ રીત દર્શાવી છે."><label /><tgroup cols="3"><tbody>
  <row>
    <entry>શબ્દોમાં લખો.</entry>

    <entry>73 અને 27નો તફાવત</entry>
  </row>
  <row>
    <entry>ગણિતની લખાવટમાં ફેરવો. <emphasis effect="italics">તફાવત</emphasis>  શબ્દ બાદબાકી કરવાનું કહે છે.</entry>

    <entry><m:math><m:mn>73</m:mn><m:mo>−</m:mo><m:mn>27</m:mn></m:math></entry>
  </row>
  <row>
    <entry>પછી બાદબાકી કરીએ.</entry>

    <entry align="left"><media id="eip-id1168287251681" alt="ઊભી ગોઠવણીમાં 73માંથી 27 બાદ કરતાં 46 મળે છે. દશકના સ્થાનેથી લેવાનું સ્પષ્ટ દર્શાવ્યું છે: 7 બદલાઈને 6 અને 3 બદલાઈને 13 થાય છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_032.png" /></media></entry>
  </row>
  <row>
    <entry>પ્રશ્નનો જવાબ આપવા વાક્ય લખો.</entry>

    <entry>તાપમાનનો તફાવત 46 ડિગ્રી ફેરનહાઇટ હતો.</entry>
  </row>
</tbody>


</tgroup>
</table></solution>
</exercise>
</example><note id="fs-id2626691" class="try">
<exercise id="fs-id1862405">
<problem id="fs-id1233159">
<para id="fs-id1233161">તારીખ <m:math><m:mrow><m:mtext>જૂન</m:mtext><m:mspace width="0.2em" /><m:msup><m:mn>1</m:mn><m:mtext>લી</m:mtext></m:msup></m:mrow></m:math> એ બૉસ્ટનનું મહત્તમ તાપમાન <m:math><m:mrow><m:mn>77</m:mn></m:mrow></m:math> ડિગ્રી ફેરનહાઇટ અને લઘુત્તમ તાપમાન <m:math><m:mrow><m:mn>58</m:mn></m:mrow></m:math> ડિગ્રી ફેરનહાઇટ હતું. મહત્તમ અને લઘુત્તમ તાપમાન વચ્ચે કેટલો તફાવત હતો?</para>
</problem>
<solution id="fs-id1631128">
<para id="fs-id2265563">તફાવત 19 ડિગ્રી ફેરનહાઇટ છે.</para>
</solution>
</exercise>
</note>
<note id="fs-id3959711" class="try">
<exercise id="fs-id4133018">
<problem id="fs-id1731487">
<para id="fs-id1731489">જૂન <m:math><m:mn>2</m:mn></m:math> એ સેન્ટ લુઇસ માટે હવામાનની આગાહી મુજબ મહત્તમ તાપમાન <m:math><m:mrow><m:mn>90</m:mn></m:mrow></m:math> ડિગ્રી ફેરનહાઇટ અને લઘુત્તમ તાપમાન <m:math><m:mrow><m:mn>73</m:mn></m:mrow></m:math> ડિગ્રી ફેરનહાઇટ રહેશે. આગાહીમાં આપેલાં મહત્તમ અને લઘુત્તમ તાપમાન વચ્ચે કેટલો તફાવત છે?</para>
</problem>
<solution id="fs-id1509608">
<para id="fs-id2582634">તફાવત 17 ડિગ્રી ફેરનહાઇટ છે.</para>
</solution>
</exercise>
</note>
<example id="fs-id942857"><exercise id="fs-id3016565">
<problem id="fs-id3016567">
<para id="fs-id1342007">વૉશિંગ મશીનની સેલમાં કિંમત છે <m:math><m:mrow><m:mtext>$399</m:mtext><m:mo>.</m:mo></m:mrow></m:math> તેની સામાન્ય કિંમત છે <m:math><m:mrow><m:mtext>$588</m:mtext><m:mo>.</m:mo></m:mrow></m:math> સામાન્ય કિંમત અને સેલની કિંમત વચ્ચે કેટલો તફાવત છે?</para>
</problem>
<solution id="fs-id1568270">
<title>ઉકેલ</title>
<para id="fs-id2256365">સામાન્ય કિંમત અને સેલની કિંમત વચ્ચેનો તફાવત શોધવાનું પૂછ્યું છે.</para>
<table id="eip-366" class="unnumbered unstyled" summary="આ કોષ્ટકમાં શબ્દોમાં આપેલો બાદબાકીનો પ્રશ્ન ઉકેલવાની ક્રમશઃ રીત છે: શબ્દોમાં લખવાથી લઈને અંતિમ જવાબ સુધી."><label /><tgroup cols="3"><tbody>
  <row>
    <entry>શબ્દોમાં લખો.</entry>

    <entry>588 અને 399 વચ્ચેનો તફાવત</entry>
  </row>
  <row>
    <entry>ગણિતની લખાવટમાં ફેરવો.</entry>

    <entry><m:math><m:mn>588</m:mn><m:mo>−</m:mo><m:mn>399</m:mn></m:math></entry>
  </row>
  <row>
    <entry>બાદબાકી કરો.</entry>

    <entry align="left"><media id="eip-id1168288553773" alt="ત્રણ સ્તંભમાં 588 ઓછા 399ની બાદબાકી ગોઠવેલી છે. ડાબેના સ્થાનેથી લેવાનું દર્શાવ્યું છે અને જવાબ 189 છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_03_033.png" /></media></entry>
  </row>
  <row>
    <entry>પ્રશ્નનો જવાબ આપવા વાક્ય લખો.</entry>

    <entry>સામાન્ય કિંમત અને સેલની કિંમત વચ્ચેનો તફાવત $189 છે.</entry>
  </row>
</tbody>


</tgroup>
</table></solution>
</exercise>
</example><note id="fs-id2202283" class="try">
<exercise id="fs-id1582423">
<problem id="fs-id1620294">
<para id="fs-id1620296">ટેલિવિઝનની સેલમાં કિંમત છે <m:math><m:mrow><m:mtext>$499</m:mtext><m:mo>.</m:mo></m:mrow></m:math> તેની સામાન્ય કિંમત છે <m:math><m:mrow><m:mtext>$648</m:mtext><m:mo>.</m:mo></m:mrow></m:math> સામાન્ય કિંમત અને સેલની કિંમત વચ્ચે કેટલો તફાવત છે?</para>
</problem>
<solution id="fs-id2771860">
<para id="fs-id2771862">તફાવત $149 છે.</para>
</solution>
</exercise>
</note>
<note id="fs-id1632827" class="try">
<exercise id="fs-id2150255">
<problem id="fs-id2150257">
<para id="fs-id1298092">આંગણામાં રાખવાના ફર્નિચરના સેટની સેલમાં કિંમત છે <m:math><m:mrow><m:mtext>$149</m:mtext><m:mo>.</m:mo></m:mrow></m:math> તેની સામાન્ય કિંમત છે <m:math><m:mrow><m:mtext>$285</m:mtext><m:mo>.</m:mo></m:mrow></m:math> સામાન્ય કિંમત અને સેલની કિંમત વચ્ચે કેટલો તફાવત છે?</para>
</problem>
<solution id="fs-id1258293">
<para id="fs-id2976317">તફાવત $136 છે.</para>
</solution>
</exercise>
</note>
<note id="fs-id1580677" class="media-2"><title>વધારાનાં ઑનલાઇન સંસાધનો જુઓ</title><list id="fs-id2877317" display="block">
<item><link url="https://www.openstax.org/l/24sub2dignum">બે અંકની પૂર્ણ સંખ્યાઓની બાદબાકી નમૂના દ્વારા દર્શાવો</link></item>
<item><link url="https://www.openstax.org/l/24sub3dignum">ત્રણ અંકની પૂર્ણ સંખ્યાઓની બાદબાકી નમૂના દ્વારા દર્શાવો</link></item>
<item><link url="https://www.openstax.org/l/24subwholenum">પૂર્ણ સંખ્યાઓની બાદબાકી કરો</link></item>
</list>
</note></section>
<section id="fs-id1379009" class="key-concepts"><title>મુખ્ય સંકલ્પનાઓ</title><table id="eip-id1170326137930" class="unnumbered" aria-label="બે હરોળ અને પાંચ સ્તંભનું કોષ્ટક. ઉપરની હરોળ શીર્ષકની છે. ડાબેથી જમણે સ્તંભનાં નામ ક્રિયા, લખાવટ, પદાવલી, આ રીતે વાંચો અને પરિણામ છે. ક્રિયામાં બાદબાકી, લખાવટમાં ઓછાનું ચિહ્ન, પદાવલીમાં સાત ઓછા ત્રણ, વાંચનમાં સાત ઓછા ત્રણ શબ્દો અને પરિણામમાં આ સંખ્યાઓનો તફાવત લખેલું છે: 7 અને 3.">
<label />
<tgroup cols="5">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<colspec colnum="3" colname="c3" />
<colspec colnum="4" colname="c4" />
<colspec colnum="5" colname="c5" />
<thead>
<row valign="top">
<entry align="left">ક્રિયા</entry>
<entry align="left">લખાવટ</entry>
<entry align="left">પદાવલી</entry>
<entry align="left">આ રીતે વાંચો</entry>
<entry align="left">પરિણામ</entry>
</row>
</thead>
<tbody>
<row valign="top">
<entry align="left">બાદબાકી</entry>
<entry align="left"><m:math><m:mrow><m:mo>−</m:mo></m:mrow></m:math></entry>
<entry align="left"><m:math><m:mrow><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math></entry>
<entry align="left">સાત ઓછા ત્રણ</entry>
<entry align="left">આ સંખ્યાઓનો તફાવત: <m:math><m:mrow><m:mn>7</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>3</m:mn></m:mrow></m:math></entry>
</row>
</tbody>
</tgroup>
</table>
<list id="eip-222"><item><emphasis>પૂર્ણ સંખ્યાઓની બાદબાકી કરો.</emphasis>
<list id="eip-id1170325125107" list-type="enumerated" number-style="arabic" class="stepwise"><item>સરખી સ્થાનકિંમતના અંકો એકની નીચે એક આવે તેમ સંખ્યાઓ લખો.</item>
<item>દરેક સ્થાનકિંમતના અંકોની બાદબાકી કરો. એકમના સ્થાનથી શરૂ કરીને જમણેથી ડાબે જાઓ. ઉપરનો અંક નીચેના અંક કરતાં નાનો હોય, તો જરૂર પ્રમાણે ડાબેના સ્થાનમાંથી લો.</item>
<item>જમણેથી ડાબે દરેક સ્થાનકિંમતની બાદબાકી કરતા જાઓ અને જરૂર પડે ત્યારે ડાબેના સ્થાનમાંથી લો.</item>
<item>સરવાળો કરીને તપાસો.</item></list></item>
</list></section><section id="fs-id2649429" class="section-exercises"><section id="fs-id2908415" class="practice-perfect">
<title>અભ્યાસથી નિપુણતા</title>
<para id="fs-id2219786"><emphasis effect="bold">બાદબાકીની લખાવટનો ઉપયોગ કરો</emphasis> </para><para id="eip-987">નીચેના અભ્યાસમાં ગણિતની લખાવટને શબ્દોમાં ફેરવો.</para><exercise id="fs-id1852234">
<problem id="fs-id1852236">
<para id="fs-id2431916"><m:math><m:mrow><m:mn>15</m:mn><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1885585">
<para id="fs-id1885587">પંદર ઓછા નવ; પંદર અને નવનો તફાવત</para>
</solution>
</exercise>
<exercise id="fs-id1730448">
<problem id="fs-id1969228">
<para id="fs-id1969230"><m:math><m:mrow><m:mn>18</m:mn><m:mo>−</m:mo><m:mn>16</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1367647">
<problem id="fs-id2629662">
<para id="fs-id2629664"><m:math><m:mrow><m:mn>42</m:mn><m:mo>−</m:mo><m:mn>35</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1522283">
<para id="fs-id1340527">બેતાલીસ ઓછા પાંત્રીસ; બેતાલીસ અને પાંત્રીસનો તફાવત</para>
</solution>
</exercise>
<exercise id="fs-id1372720">
<problem id="fs-id1372722">
<para id="fs-id1379209"><m:math><m:mrow><m:mn>83</m:mn><m:mo>−</m:mo><m:mn>64</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1627318">
<problem id="fs-id1627320">
<para id="fs-id2711486"><m:math><m:mrow><m:mn>675</m:mn><m:mo>−</m:mo><m:mn>350</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id3335833">
<para id="fs-id3335835">છસો પંચોતેર ઓછા ત્રણસો પચાસ; છસો પંચોતેર અને ત્રણસો પચાસનો તફાવત</para>
</solution>
</exercise>
