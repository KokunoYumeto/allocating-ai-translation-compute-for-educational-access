<?xml version='1.0' encoding='utf-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" xmlns:ns1="http://cnx.rice.edu/mdml" xml:lang="gu-Gujr-IN">

<title>બીજગણિતની ભાષાનો ઉપયોગ કરો</title>
<metadata>
  <ns1:content-id>m82453</ns1:content-id>
  <ns1:title>બીજગણિતની ભાષાનો ઉપયોગ કરો</ns1:title>
  <ns1:abstract><para id="para-00001">આ વિભાગના અંતે તમે આ કરી શકશો:</para>
<list id="list-00001">
<item>ચલ અને બીજગણિતીય સંકેતોનો ઉપયોગ કરવો</item>
<item>ક્રિયાઓના ક્રમથી પદાવલીઓનું સાદું રૂપ આપવું</item>
<item>પદાવલીની કિંમત શોધવી</item>
<item>સજાતીય પદો ઓળખવા અને ભેગાં કરવા</item>
<item>અંગ્રેજી શબ્દસમૂહને બીજગણિતીય પદાવલીમાં ફેરવવો</item>
</list></ns1:abstract>
  <ns1:uuid>7c6afafa-02d2-4a6b-8aa7-26905730d112</ns1:uuid>
</metadata>

<content>
<note id="fs-id1170654939047" class="be-prepared">
<para id="fs-id1170654883472">આ વિભાગના વિષયોનો વધુ વિગતવાર પરિચય <emphasis effect="italics">પૂર્વબીજગણિત</emphasis> પુસ્તકના આ પ્રકરણમાં મળે છે: <emphasis effect="bold">બીજગણિતની ભાષા</emphasis>.</para>
</note>
<section id="fs-id1170655150800"><title>ચલ અને બીજગણિતીય સંકેતોનો ઉપયોગ કરો</title><para id="fs-id1170655151082">ધારો કે આ વર્ષે ગ્રેગની ઉંમર 20 વર્ષ અને એલેક્સની 23 વર્ષ છે. તમે જાણો છો કે એલેક્સ ગ્રેગ કરતાં 3 વર્ષ મોટો છે. ગ્રેગ 12 વર્ષનો હતો ત્યારે એલેક્સ 15 વર્ષનો હતો. ગ્રેગ 35 વર્ષનો થશે ત્યારે એલેક્સ 38 વર્ષનો થશે. ગ્રેગની ઉંમર ગમે તેટલી હોય, એલેક્સની ઉંમર હંમેશાં 3 વર્ષ વધારે હશે, ખરું ને? બીજગણિતની ભાષામાં કહીએ તો ગ્રેગ અને એલેક્સની ઉંમરોને <term id="term-00001">ચલ</term><emphasis effect="bold" /> અને 3ને <term id="term-00002">અચળ</term> કહીએ છીએ. બંને ઉંમરો બદલાય (“ચલે”) છે, પરંતુ તેમની વચ્ચેનો 3 વર્ષનો તફાવત હંમેશાં સરખો (“અચળ”) રહે છે. ગ્રેગ અને એલેક્સની ઉંમરમાં હંમેશાં 3 વર્ષનો તફાવત હોવાથી 3 એ <emphasis effect="italics">અચળ</emphasis> છે.</para>
<para id="fs-id1170655059811">બીજગણિતમાં ચલ દર્શાવવા મૂળાક્ષરના અક્ષરો વાપરીએ છીએ. જો ગ્રેગની ઉંમરને <emphasis effect="italics">g</emphasis> કહીએ, તો એલેક્સની ઉંમર <m:math><m:mrow><m:mi>g</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math> વડે દર્શાવી શકીએ. જુઓ <link target-id="fs-id1170654967711" />.</para>
<table id="fs-id1170654967711" aria-label="આ કોષ્ટકમાં પાંચ હરોળ અને બે સ્તંભ છે. પહેલી હરોળ મથાળાની છે. પહેલું મથાળું “ગ્રેગની ઉંમર” અને બીજું “એલેક્સની ઉંમર” છે. “ગ્રેગની ઉંમર” નીચે 12, 20, 35 અને g છે. “એલેક્સની ઉંમર” નીચે 15, 23, 38 અને g + 3 પદાવલી છે.">
<tgroup cols="2">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<thead>
<row valign="top">
<entry align="center" valign="top">ગ્રેગની ઉંમર</entry>
<entry align="center" valign="top">એલેક્સની ઉંમર</entry>
</row>
</thead>
<tbody>
<row valign="top">
<entry align="center" valign="top"><m:math><m:mrow><m:mn>12</m:mn></m:mrow></m:math></entry>
<entry align="center" valign="top"><m:math><m:mrow><m:mn>15</m:mn></m:mrow></m:math></entry>
</row>
<row valign="top">
<entry align="center" valign="top"><m:math><m:mrow><m:mn>20</m:mn></m:mrow></m:math></entry>
<entry align="center" valign="top"><m:math><m:mrow><m:mn>23</m:mn></m:mrow></m:math></entry>
</row>
<row valign="top">
<entry align="center" valign="top"><m:math><m:mrow><m:mn>35</m:mn></m:mrow></m:math></entry>
<entry align="center" valign="top"><m:math><m:mrow><m:mn>38</m:mn></m:mrow></m:math></entry>
</row>
<row valign="top">
<entry align="center" valign="top"><m:math><m:mtext mathvariant="bold-italic">g</m:mtext></m:math></entry>
<entry align="center" valign="top"><m:math><m:mrow><m:mtext mathvariant="bold-italic">g</m:mtext><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math></entry>
</row>
</tbody>
</tgroup>
</table>
<para id="fs-id1170655195814">આ બદલાતી ઉંમરો દર્શાવતા અક્ષરોને <emphasis effect="italics">ચલ</emphasis> કહે છે. ચલ માટે સૌથી વધુ વપરાતા અક્ષરો <emphasis effect="italics">x</emphasis>, <emphasis effect="italics">y</emphasis>, <emphasis effect="italics">a</emphasis>, <emphasis effect="italics">b</emphasis> અને <emphasis effect="italics">c</emphasis> છે.</para>
<note id="fs-id1170654997446">
<title>ચલ</title>
<para id="fs-id1170655128406"> <term id="term-00003">ચલ</term> એવો અક્ષર છે જે એવી સંખ્યા દર્શાવે છે જેનું મૂલ્ય બદલાઈ શકે.</para>
</note>
<note id="fs-id1170655160769">
<title>અચળ</title>
<para id="fs-id1170655189845"> <term id="term-00004">અચળ</term> એવી સંખ્યા છે જેનું મૂલ્ય હંમેશાં સરખું રહે છે.</para>
</note>
<para id="fs-id1170655224522">બીજગણિતીય રીતે લખવા માટે સંખ્યાઓ અને ચલો ઉપરાંત ક્રિયાના સંકેતો પણ જોઈએ. આપણે અનેક પ્રકારના સંકેતો વાપરીશું.</para>
<para id="fs-id1170654981807">અંકગણિતની ચાર પાયાની <term class="no-emphasis" id="term-00005">ક્રિયાઓ</term>: <term class="no-emphasis" id="term-00006">સરવાળો</term>, <term class="no-emphasis" id="term-00007">બાદબાકી</term>, <term class="no-emphasis" id="term-00008">ગુણાકાર</term>, અને <term class="no-emphasis" id="term-00009">ભાગાકાર</term> છે. નીચેના કોષ્ટકમાં આ ક્રિયાઓ દર્શાવતા સંકેતો આપેલા છે. તેમાંના કેટલાક તમે કદાચ ઓળખતા હશો.</para>
<table id="fs-id1170655178881" class="unnumbered" aria-label="આ કોષ્ટકમાં પાંચ હરોળ અને ચાર સ્તંભ છે. પહેલી મથાળાની હરોળ છે. મથાળાં છે: “ક્રિયા”, “સંકેતલિપિ”, “વાંચો” અને “પરિણામ છે…”. “ક્રિયા” સ્તંભમાં સરવાળો, બાદબાકી, ગુણાકાર અને ભાગાકાર છે. “સંકેતલિપિ”માં બીજગણિતીય પદાવલીઓ છે. પહેલી હરોળ a વત્તા b અને બીજી a ઓછા b બતાવે છે. પછીની હરોળમાં ચાર ગુણાકારરૂપો છે: a ગુણ્યા-બિંદુ b; કૌંસમાં a અને કૌંસમાં b; a પછી કૌંસમાં b; અને કૌંસમાં ab. છેલ્લી હરોળમાં ચાર ભાગાકારરૂપો છે: a ભાગ્યા b; a સ્લેશ b; અપૂર્ણાંકમાં ઉપર a અને નીચે b; અને લાંબા ભાગાકારમાં બહાર b અને અંદર a. “વાંચો” સ્તંભમાં “a વત્તા b”, “a ઓછા b”, “a ગુણ્યા b” અને “a ભાગ્યા b” છે. “પરિણામ છે…” સ્તંભમાં “a અને bનો સરવાળો”, “a અને bનો તફાવત”, “a અને bનો ગુણાકાર” અને “aને b વડે ભાગ્યાનું ભાગફળ; aને ભાજ્ય અને bને ભાજક કહે છે” છે.">
<tgroup cols="4">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<colspec colnum="3" colname="c3" />
<colspec colnum="4" colname="c4" />
<thead>
<row valign="top">
<entry valign="top" align="left">ક્રિયા</entry>
<entry valign="top" align="left">સંકેતલિપિ</entry>
<entry valign="top" align="left">વાંચો:</entry>
<entry valign="top" align="left">પરિણામ છે…</entry>
</row>
</thead>
<tbody>
<row valign="top">
<entry valign="top" align="left">સરવાળો</entry>
<entry valign="top" align="left"><m:math><m:mrow><m:mi>a</m:mi><m:mo>+</m:mo><m:mi>b</m:mi></m:mrow></m:math></entry>
<entry valign="top" align="left"><emphasis effect="italics">a</emphasis> વત્તા <emphasis effect="italics">b</emphasis></entry>
<entry valign="top" align="left"><emphasis effect="italics">a</emphasis> અને <emphasis effect="italics">b</emphasis> નો સરવાળો</entry>
</row>
<row valign="top">
<entry valign="top" align="left">બાદબાકી</entry>
<entry valign="top" align="left"><m:math><m:mrow><m:mi>a</m:mi><m:mo>−</m:mo><m:mi>b</m:mi></m:mrow></m:math></entry>
<entry valign="top" align="left"><emphasis effect="italics">a</emphasis> ઓછા <emphasis effect="italics">b</emphasis></entry>
<entry valign="top" align="left"><emphasis effect="italics">a</emphasis> અને <emphasis effect="italics">b</emphasis> વચ્ચેનો તફાવત</entry>
</row>
<row valign="top">
<entry valign="top" align="left">ગુણાકાર</entry>
<entry valign="top" align="left"><m:math><m:mrow><m:mi>a</m:mi><m:mo>·</m:mo><m:mi>b</m:mi><m:mo>,</m:mo><m:mi>a</m:mi><m:mi>b</m:mi><m:mo>,</m:mo><m:mrow><m:mo>(</m:mo><m:mi>a</m:mi><m:mo>)</m:mo></m:mrow><m:mrow><m:mo>(</m:mo><m:mi>b</m:mi><m:mo>)</m:mo></m:mrow><m:mo>,</m:mo></m:mrow></m:math> <m:math><m:mrow><m:mrow><m:mo>(</m:mo><m:mi>a</m:mi><m:mo>)</m:mo></m:mrow><m:mi>b</m:mi><m:mo>,</m:mo><m:mi>a</m:mi><m:mrow><m:mo>(</m:mo><m:mi>b</m:mi><m:mo>)</m:mo></m:mrow></m:mrow></m:math></entry>
<entry valign="top" align="left"><emphasis effect="italics">a</emphasis> ગુણ્યા <emphasis effect="italics">b</emphasis></entry>
<entry valign="top" align="left"><emphasis effect="italics">a</emphasis> અને <emphasis effect="italics">b</emphasis> નો ગુણાકાર</entry>
</row>
<row valign="top">
<entry valign="top" align="left">ભાગાકાર</entry>
<entry valign="top" align="left"><m:math><m:mrow><m:mi>a</m:mi><m:mo>÷</m:mo><m:mi>b</m:mi><m:mo>,</m:mo><m:mi>a</m:mi><m:mtext>/</m:mtext><m:mi>b</m:mi><m:mo>,</m:mo><m:mfrac><m:mi>a</m:mi><m:mi>b</m:mi></m:mfrac><m:mo>,</m:mo><m:mi>b</m:mi><m:menclose notation="longdiv"><m:mi>a</m:mi></m:menclose></m:mrow></m:math></entry>
<entry valign="top" align="left"><emphasis effect="italics">a</emphasis> ભાગ્યા <emphasis effect="italics">b</emphasis></entry>
<entry valign="top" align="left"><emphasis effect="italics">a</emphasis> અને <emphasis effect="italics">b</emphasis> નું ભાગફળ; <emphasis effect="italics">a</emphasis> ને ભાજ્ય અને <emphasis effect="italics">b</emphasis> ને ભાજક કહે છે.</entry>
</row>
</tbody>
</tgroup>
</table>
<para id="fs-id1170655126801">આ ક્રિયાઓ બે સંખ્યાઓ પર કરીએ છીએ. સાંકેતિક રૂપને શબ્દોમાં કે શબ્દોને સાંકેતિક રૂપમાં ફેરવતી વખતે “નો/નું” અને “અને” શબ્દો ધ્યાનથી વાંચો.</para>
<list id="fs-id1166424846753" list-type="bulleted" bullet-style="bullet">
<item> <emphasis effect="italics">તફાવત</emphasis> 9 અને 2નો એટલે 9માંથી 2 બાદ કરવા; બીજા શબ્દોમાં 9 ઓછા 2. સંકેતમાં લખીએ છીએ <m:math><m:mrow><m:mn>9</m:mn><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>.</m:mo></m:mrow></m:math></item>
<item> <emphasis effect="italics">ગુણાકાર</emphasis> 4 અને 8નો એટલે 4 અને 8નો ગુણાકાર કરવા; બીજા શબ્દોમાં 4 ગુણ્યા 8. સંકેતમાં લખીએ છીએ <m:math><m:mrow><m:mn>4</m:mn><m:mo>·</m:mo><m:mn>8</m:mn><m:mo>.</m:mo></m:mrow></m:math></item>
</list>
<para id="fs-id1170655004454">બીજગણિતમાં ગુણાકાર દર્શાવવા ક્રોસનો સંકેત <m:math><m:mrow><m:mo>×</m:mo><m:mo>,</m:mo></m:mrow></m:math> વાપરતા નથી, કારણ કે તે ગૂંચવણ ઊભી કરી શકે. શું 3<emphasis effect="italics">xy</emphasis> નો અર્થ છે <m:math><m:mrow><m:mn>3</m:mn><m:mspace width="0.2em" /><m:mo>×</m:mo><m:mspace width="0.2em" /><m:mi>y</m:mi></m:mrow></m:math> (“ત્રણ ગુણ્યા <emphasis effect="italics">y</emphasis>”) કે <m:math><m:mrow><m:mn>3</m:mn><m:mo>·</m:mo><m:mi>x</m:mi><m:mo>·</m:mo><m:mi>y</m:mi></m:mrow></m:math> (ત્રણ ગુણ્યા <emphasis effect="italics">x</emphasis> ગુણ્યા <emphasis effect="italics">y</emphasis>)? વાત સ્પષ્ટ રાખવા ગુણાકાર માટે વાપરો <m:math><m:mrow><m:mo>·</m:mo></m:mrow></m:math> અથવા કૌંસ.</para>
<para id="fs-id1171789687379"><newline /></para>
<para id="fs-id1170655208137">બે રાશિઓનાં મૂલ્યો સરખાં હોય ત્યારે તેમને સમાન કહીએ અને તેમની વચ્ચે <term id="term-00010">સમાનતાની નિશાની</term> મૂકીએ.</para>
<note id="fs-id1170655025665">
<title>સમાનતાનો સંકેત</title>
<para id="fs-id1170654990403"><m:math><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mi>b</m:mi></m:mrow></m:math> ને “<emphasis effect="italics">a</emphasis> બરાબર <emphasis effect="italics">b</emphasis>” તરીકે વાંચીએ છીએ.</para>
<para id="fs-id1170655126926">આ સંકેત <m:math><m:mrow><m:mo>“=”</m:mo></m:mrow></m:math> ને <emphasis effect="bold">સમાનતાની નિશાની</emphasis> કહે છે.</para>
</note>
<para id="fs-id1170655108736">સંખ્યારેખા પર ડાબેથી જમણે જતાં સંખ્યાઓ મોટી થાય છે. “&lt;” અને “&gt;” સંકેતો સમજાવવા સંખ્યારેખાનો ઉપયોગ કરી શકાય છે.</para>
<note id="fs-id1170655207857">
<title>અસમાનતા</title>
<equation id="fs-id1167270244162" class="unnumbered"><label /><m:math><m:mrow><m:mtable><m:mtr /><m:mtr /><m:mtr><m:mtd columnalign="left"><m:mi>a</m:mi><m:mo>&lt;</m:mo><m:mi>b</m:mi><m:mspace width="0.2em" /><m:mtext> ને “</m:mtext><m:mi>a</m:mi><m:mspace width="0.2em" /><m:mtext> એ </m:mtext><m:mspace width="0.2em" /><m:mi>b</m:mi><m:mtext> કરતાં નાનું છે” તરીકે વાંચીએ છીએ.</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mi>a</m:mi><m:mspace width="0.2em" /><m:mtext> એ સંખ્યારેખા પર </m:mtext><m:mspace width="0.2em" /><m:mi>b</m:mi><m:mspace width="0.2em" /><m:mtext> ની ડાબી બાજુએ છે.</m:mtext></m:mtd></m:mtr></m:mtable></m:mrow></m:math></equation>
<media id="fs-id1170652623871" alt="a અને b બિંદુઓ દર્શાવતી સંખ્યારેખા.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_02_001_img_new.jpg" />
</media>
<equation id="fs-id1167269909313" class="unnumbered"><label /><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="left"><m:mi>a</m:mi><m:mo>&gt;</m:mo><m:mi>b</m:mi><m:mspace width="0.2em" /><m:mtext> ને “</m:mtext><m:mi>a</m:mi><m:mspace width="0.2em" /><m:mtext> એ </m:mtext><m:mspace width="0.2em" /><m:mi>b</m:mi><m:mtext> કરતાં મોટું છે” તરીકે વાંચીએ છીએ.</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mi>a</m:mi><m:mspace width="0.2em" /><m:mtext> એ સંખ્યારેખા પર </m:mtext><m:mspace width="0.2em" /><m:mi>b</m:mi><m:mspace width="0.2em" /><m:mtext> ની જમણી બાજુએ છે.</m:mtext></m:mtd></m:mtr></m:mtable></m:mrow></m:math></equation>
<media id="fs-id1167269961954" alt="b અને a બિંદુઓ દર્શાવતી અંકિત રેખા.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_02_002_img_new.jpg" />
</media>
</note>
<para id="fs-id1170655155145">પદાવલીઓ <emphasis effect="italics">a</emphasis> &lt; b અથવા a &gt; <emphasis effect="italics">b</emphasis> ને ડાબેથી જમણે કે જમણેથી ડાબે વાંચી શકાય છે; જોકે અંગ્રેજીમાં આપણે સામાન્ય રીતે ડાબેથી જમણે વાંચીએ છીએ (<link target-id="fs-id1170655178120" />). સામાન્ય રીતે, <emphasis effect="italics">a</emphasis> &lt; b એ b &gt; <emphasis effect="italics">a</emphasis> ને સમકક્ષ છે. ઉદાહરણ તરીકે 7 &lt; 11 એ 11 &gt; 7ને સમકક્ષ છે. અને <emphasis effect="italics">a</emphasis> &gt; <emphasis effect="italics">b</emphasis> એ <emphasis effect="italics">b</emphasis> &lt; a ને સમકક્ષ છે. ઉદાહરણ તરીકે 17 &gt; 4 એ 4 &lt; 17ને સમકક્ષ છે.</para>
<table id="fs-id1170655178120" aria-label="આ કોષ્ટકમાં છ હરોળ અને બે સ્તંભ છે. પહેલી મથાળાની હરોળ છે. મથાળાં “અસમાનતાના સંકેતો” અને “શબ્દો” છે. “અસમાનતાના સંકેતો” નીચે આ પદાવલીઓ છે: a બરાબર નથી b; a કરતાં નાનું b; a કરતાં નાનું અથવા બરાબર b; a કરતાં મોટું b; અને a કરતાં મોટું અથવા બરાબર b. “શબ્દો” નીચે આ વાક્યો છે: “a એ bની બરાબર નથી”, “a એ b કરતાં નાનું છે”, “a એ b કરતાં નાનું અથવા તેની બરાબર છે”, “a એ b કરતાં મોટું છે” અને “a એ b કરતાં મોટું અથવા તેની બરાબર છે”.">
<label />
<tgroup cols="2">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<thead>
<row valign="top">
<entry valign="top" align="left">અસમાનતાના સંકેતો</entry>
<entry valign="top" align="left">શબ્દો</entry>
</row>
</thead>
<tbody>
<row valign="top">
<entry valign="top" align="left"><m:math><m:mrow><m:mi>a</m:mi><m:mo>≠</m:mo><m:mi>b</m:mi></m:mrow></m:math></entry>
<entry valign="top" align="left"><emphasis effect="italics">a</emphasis> એ <emphasis effect="italics" /><emphasis effect="italics">b</emphasis> ની બરાબર નથી</entry>
</row>
<row valign="top">
<entry valign="top" align="left"><emphasis effect="italics">a</emphasis> &lt; <emphasis effect="italics">b</emphasis></entry>
<entry valign="top" align="left"><emphasis effect="italics">a</emphasis> એ <emphasis effect="italics" /><emphasis effect="italics">b</emphasis> કરતાં નાનું છે</entry>
</row>
<row valign="top">
<entry valign="top" align="left"><m:math><m:mrow><m:mi>a</m:mi><m:mo>≤</m:mo><m:mi>b</m:mi></m:mrow></m:math></entry>
<entry valign="top" align="left"><emphasis effect="italics">a</emphasis> એ <emphasis effect="italics" /><emphasis effect="italics">b</emphasis> કરતાં નાનું અથવા તેની બરાબર છે</entry>
</row>
<row valign="top">
<entry valign="top" align="left"><emphasis effect="italics">a &gt; b</emphasis></entry>
<entry valign="top" align="left"><emphasis effect="italics">a</emphasis> એ <emphasis effect="italics" /><emphasis effect="italics">b</emphasis> કરતાં મોટું છે</entry>
</row>
<row valign="top">
<entry valign="top" align="left"><m:math><m:mrow><m:mi>a</m:mi><m:mo>≥</m:mo><m:mi>b</m:mi></m:mrow></m:math></entry>
<entry valign="top" align="left"><emphasis effect="italics">a</emphasis> એ <emphasis effect="italics" /><emphasis effect="italics">b</emphasis> કરતાં મોટું અથવા તેની બરાબર છે</entry>
</row>
</tbody>
</tgroup>
</table>
<example id="fs-id1170655113222">
<exercise id="fs-id1170654999980">
<problem id="fs-id1170655020482">
<para id="fs-id1170654984453">બીજગણિતમાંથી શબ્દોમાં ફેરવો:</para>
<para id="fs-id1170654989586"><span class="token">ⓐ</span> <m:math><m:mrow><m:mn>17</m:mn><m:mo>≤</m:mo><m:mn>26</m:mn></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mn>8</m:mn><m:mo>≠</m:mo><m:mn>17</m:mn><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math> <span class="token">ⓒ</span> <m:math><m:mrow><m:mn>12</m:mn><m:mo>&gt;</m:mo><m:mn>27</m:mn><m:mo>÷</m:mo><m:mn>3</m:mn></m:mrow></m:math> <span class="token">ⓓ</span> <m:math><m:mrow><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mo>&lt;</m:mo><m:mn>19</m:mn></m:mrow></m:math></para></problem>
<solution id="fs-id1170655105413">
<title>ઉકેલ</title>
<para id="fs-id1166424795899"><span class="token">ⓐ</span> <m:math><m:mrow><m:mn>17</m:mn><m:mo>≤</m:mo><m:mn>26</m:mn></m:mrow></m:math><newline />
17 એ 26 કરતાં નાનું અથવા તેની બરાબર છે<newline /><newline />
<span class="token">ⓑ</span> <m:math><m:mrow><m:mn>8</m:mn><m:mo>≠</m:mo><m:mn>17</m:mn><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math><newline />
8 એ 17 ઓછા 3ની બરાબર નથી<newline /><newline />
<span class="token">ⓒ</span> <m:math><m:mrow><m:mn>12</m:mn><m:mo>&gt;</m:mo><m:mn>27</m:mn><m:mo>÷</m:mo><m:mn>3</m:mn></m:mrow></m:math><newline />
12 એ 27 ભાગ્યા 3 કરતાં મોટું છે<newline /><newline />
<span class="token">ⓓ</span> <m:math><m:mrow><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mo>&lt;</m:mo><m:mn>19</m:mn></m:mrow></m:math><newline />
<emphasis effect="italics">y</emphasis> વત્તા 7 એ 19 કરતાં નાનું છે</para></solution>
</exercise>
</example>
<note id="fs-id1170654935250" class="try">
<exercise id="fs-id1170655166352">
<problem id="fs-id1170654985390">
<para id="fs-id1170654943066">બીજગણિતમાંથી શબ્દોમાં ફેરવો:</para>
<para id="fs-id1170655190264"><span class="token">ⓐ</span> <m:math><m:mrow><m:mn>14</m:mn><m:mo>≤</m:mo><m:mn>27</m:mn></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mn>19</m:mn><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>≠</m:mo><m:mn>8</m:mn></m:mrow></m:math> <span class="token">ⓒ</span> <m:math><m:mrow><m:mn>12</m:mn><m:mo>&gt;</m:mo><m:mn>4</m:mn><m:mo>÷</m:mo><m:mn>2</m:mn></m:mrow></m:math> <span class="token">ⓓ</span> <m:math><m:mrow><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>7</m:mn><m:mo>&lt;</m:mo><m:mn>1</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654943209">
<para id="fs-id1170655353526"><span class="token">ⓐ</span> 14 એ 27 કરતાં નાનું અથવા તેની બરાબર છે <span class="token">ⓑ</span> 19 ઓછા 2 એ 8ની બરાબર નથી <span class="token">ⓒ</span> 12 એ 4 ભાગ્યા 2 કરતાં મોટું છે <span class="token">ⓓ</span> <emphasis effect="italics">x</emphasis> ઓછા 7 એ 1 કરતાં નાનું છે</para>
</solution>
</exercise>
</note>
<note id="fs-id1170655124058" class="try">
<exercise id="fs-id1170655205783">
<problem id="fs-id1170655166119">
<para id="fs-id1170655203511">બીજગણિતમાંથી શબ્દોમાં ફેરવો:</para>
<para id="fs-id1170655174550"><span class="token">ⓐ</span> <m:math><m:mrow><m:mn>19</m:mn><m:mo>≥</m:mo><m:mn>15</m:mn></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mn>7</m:mn><m:mo>=</m:mo><m:mn>12</m:mn><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow></m:math> <span class="token">ⓒ</span> <m:math><m:mrow><m:mn>15</m:mn><m:mo>÷</m:mo><m:mn>3</m:mn><m:mo>&lt;</m:mo><m:mn>8</m:mn></m:mrow></m:math> <span class="token">ⓓ</span> <m:math><m:mrow><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>&gt;</m:mo><m:mn>6</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655192260">
<para id="fs-id1170655222902"><span class="token">ⓐ</span> 19 એ 15 કરતાં મોટું અથવા તેની બરાબર છે <span class="token">ⓑ</span> 7 એ 12 ઓછા 5ની બરાબર છે <span class="token">ⓒ</span> 15 ભાગ્યા 3 એ 8 કરતાં નાનું છે <span class="token">ⓓ</span> <emphasis effect="italics">y</emphasis> વત્તા 3 એ 6 કરતાં મોટું છે</para>
</solution>
</exercise>
</note>
<para id="fs-id1170654957487">બીજગણિતમાં જૂથ દર્શાવતા સંકેતોનું કામ ગુજરાતી કે અંગ્રેજીમાં અલ્પવિરામ, દ્વિબિંદુ અને બીજા વિરામચિહ્નો જેવું છે. તેઓ સ્પષ્ટ કરે છે કે કઈ પદાવલીઓ સાથે રાખવાની અને કઈ બીજી પદાવલીઓથી અલગ રાખવાની છે. અત્યારે ત્રણ પ્રકાર રજૂ કરીએ છીએ.</para>
<note id="fs-id1170655219760">
<title>જૂથ દર્શાવતા સંકેતો</title>
<equation id="fs-id1167269979347" class="unnumbered"><label /><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="left"><m:mtext>ગોળ કૌંસ</m:mtext></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mspace width="0.15em" /><m:mrow><m:mo>(</m:mo><m:mrow /><m:mo>)</m:mo></m:mrow></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>ચોરસ કૌંસ</m:mtext></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mspace width="0.15em" /><m:mrow><m:mo>[</m:mo><m:mrow /><m:mo>]</m:mo></m:mrow></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>વાંકિયા કૌંસ</m:mtext></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mrow><m:mo>{</m:mo><m:mrow /><m:mo>}</m:mo></m:mrow></m:mtd></m:mtr></m:mtable></m:mrow></m:math></equation>
</note>
<para id="fs-id1170654880176">અહીં કેટલીક પદાવલીઓ છે જેમાં <term class="no-emphasis" id="term-00011">જૂથ દર્શાવતા સંકેતો</term> આવે છે. આ વિભાગમાં આગળ આવી પદાવલીઓને સાદું રૂપ આપીશું.</para>
<equation id="fs-id1170654936322" class="unnumbered"><label /><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="center"><m:mn>8</m:mn><m:mo stretchy="false">(</m:mo><m:mn>14</m:mn><m:mo>−</m:mo><m:mn>8</m:mn><m:mo stretchy="false">)</m:mo></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="center"><m:mn>21</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mo stretchy="false">[</m:mo><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mo>−</m:mo><m:mn>8</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">]</m:mo></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="center"><m:mn>24</m:mn><m:mo>÷</m:mo><m:mo>{</m:mo><m:mn>13</m:mn><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">[</m:mo><m:mn>1</m:mn><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo>−</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>4</m:mn><m:mo stretchy="false">]</m:mo><m:mo>}</m:mo></m:mtd></m:mtr></m:mtable></m:mrow></m:math></equation>
<para id="fs-id1166424830424"><newline /></para>
<para id="fs-id1170654957085">ભાષામાં શબ્દસમૂહ અને વાક્ય વચ્ચે શું તફાવત છે? શબ્દસમૂહ એક એવો વિચાર રજૂ કરે છે જે પોતાની રીતે અધૂરો છે, જ્યારે વાક્ય સંપૂર્ણ વિધાન કરે છે. “ખૂબ ઝડપથી દોડતો” શબ્દસમૂહ છે, પરંતુ “ફૂટબૉલનો ખેલાડી ખૂબ ઝડપથી દોડતો હતો” વાક્ય છે. વાક્યમાં કર્તા અને ક્રિયાપદ હોય છે. બીજગણિતમાં આપણી પાસે છે <emphasis effect="italics">પદાવલીઓ</emphasis> અને <emphasis effect="italics">સમીકરણો</emphasis>.</para>
<note id="fs-id1170655102379">
<title>પદાવલી</title>
<para id="fs-id1170654958000"> <term id="term-00012">પદાવલી (અભિવ્યક્તિ)</term> એ સંખ્યા, ચલ અથવા ક્રિયાના સંકેતો વાપરતું સંખ્યાઓ અને ચલોનું સંયોજન છે.</para>
</note>
<para id="fs-id1170654988522"> <emphasis effect="bold">પદાવલી</emphasis> ભાષાના શબ્દસમૂહ જેવી છે. પદાવલીઓના કેટલાક દાખલા:</para>
<table id="fs-id1170655221887" class="unnumbered" aria-label="આ કોષ્ટકમાં ત્રણ સ્તંભ અને પાંચ હરોળ છે. પહેલી મથાળાની હરોળ છે. મથાળાં “પદાવલી”, “શબ્દો” અને “ભાષાનો શબ્દસમૂહ” છે. “પદાવલી” નીચે 3 વત્તા 5; n ઓછા 1; 6 ગુણ્યા-બિંદુ 7; અને x સ્લેશ y છે. “શબ્દો” નીચે “3 વત્તા પાંચ”, “n ઓછા એક”, “6 ગુણ્યા 7” અને “x ભાગ્યા y” છે. “ભાષાનો શબ્દસમૂહ” નીચે “ત્રણ અને પાંચનો સરવાળો”, “n અને એકનો તફાવત”, “છ અને સાતનો ગુણાકાર” અને “x અને yનું ભાગફળ” છે.">
<label />
<tgroup cols="3">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<colspec colnum="3" colname="c3" />
<thead>
<row valign="top">
<entry valign="top" align="left">પદાવલી</entry>
<entry valign="top" align="left">શબ્દો</entry>
<entry valign="top" align="left">ભાષાનો શબ્દસમૂહ</entry>
</row>
</thead>
<tbody>
<row valign="top">
<entry valign="top" align="left"><m:math><m:mrow><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></entry>
<entry valign="top" align="left">3 વત્તા 5</entry>
<entry valign="top" align="left">ત્રણ અને પાંચનો સરવાળો</entry>
</row>
<row valign="top">
<entry valign="top" align="left"><m:math><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math></entry>
<entry valign="top" align="left"><emphasis effect="italics">n</emphasis> ઓછા એક</entry>
<entry valign="top" align="left"><emphasis effect="italics">n</emphasis> અને એક વચ્ચેનો તફાવત</entry>
</row>
<row valign="top">
<entry valign="top" align="left"><m:math><m:mrow><m:mn>6</m:mn><m:mo>·</m:mo><m:mn>7</m:mn></m:mrow></m:math></entry>
<entry valign="top" align="left">6 ગુણ્યા 7</entry>
<entry valign="top" align="left">છ અને સાતનો ગુણાકાર</entry>
</row>
<row valign="top">
<entry valign="top" align="left"><m:math><m:mrow><m:mfrac><m:mi>x</m:mi><m:mi>y</m:mi></m:mfrac></m:mrow></m:math></entry>
<entry valign="top" align="left"><emphasis effect="italics">x</emphasis> ભાગ્યા <emphasis effect="italics">y</emphasis></entry>
<entry valign="top" align="left"><emphasis effect="italics">x</emphasis> અને <emphasis effect="italics">y</emphasis> નું ભાગફળ</entry>
</row>
</tbody>
</tgroup>
</table>
<para id="fs-id1170655003585">ધ્યાન આપો કે આ શબ્દસમૂહો સંપૂર્ણ વાક્ય બનાવતા નથી, કારણ કે તેમાં ક્રિયાપદ નથી.</para>
<para id="fs-id1170654938230"> <emphasis effect="bold">સમીકરણ</emphasis> એ આ સંકેતથી જોડાયેલી બે પદાવલીઓ છે: <term class="no-emphasis" id="term-00013">સમાનતાની નિશાની</term>. સમીકરણના સંકેતો દર્શાવતા શબ્દો વાંચો ત્યારે સંપૂર્ણ વાક્ય બને છે. સમાનતાની નિશાની ક્રિયાપદ પૂરું પાડે છે.</para>
<note id="fs-id1170655118064">
<title>સમીકરણ</title>
<para id="fs-id1170655170220"> <term id="term-00014">સમીકરણ</term> એ સમાનતાની નિશાનીથી જોડાયેલી બે પદાવલીઓ છે.</para>
</note>
<para id="fs-id1170655111405">સમીકરણોનાં કેટલાક ઉદાહરણ અહીં છે.</para>
<table id="fs-id1170655090988" class="unnumbered" aria-label="આ કોષ્ટકમાં બે સ્તંભ અને છ હરોળ છે. પહેલી મથાળાની હરોળ છે. મથાળાં “સમીકરણ” અને “ભાષાનું વાક્ય” છે. “સમીકરણ” નીચે 3 વત્તા 5 બરાબર 8; n ઓછા 1 બરાબર 14; 6 ગુણ્યા 7 બરાબર 42; x બરાબર 53; અને y વત્તા 9 બરાબર 2y ઓછા 3 છે. “ભાષાનું વાક્ય” નીચે “ત્રણ અને પાંચનો સરવાળો આઠની બરાબર છે”, “n ઓછા એક બરાબર ચૌદ”, “છ અને સાતનો ગુણાકાર બેતાલીસની બરાબર છે”, “x ત્રેપનની બરાબર છે” અને “y વત્તા નવ બરાબર બે y ઓછા ત્રણ” છે.">
<label />
<tgroup cols="2">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<thead>
<row valign="top">
<entry valign="top" align="left">સમીકરણ</entry>
<entry valign="top" align="left">ભાષાનું વાક્ય</entry>
</row>
</thead>
<tbody>
<row valign="top">
<entry valign="top" align="left"><m:math><m:mrow><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>5</m:mn><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math></entry>
<entry valign="top" align="left">ત્રણ અને પાંચનો સરવાળો આઠની બરાબર છે.</entry>
</row>
<row valign="top">
<entry valign="top" align="left"><m:math><m:mrow><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo>=</m:mo><m:mn>14</m:mn></m:mrow></m:math></entry>
<entry valign="top" align="left"><emphasis effect="italics">n</emphasis> ઓછા એક બરાબર ચૌદ.</entry>
</row>
<row valign="top">
<entry valign="top" align="left"><m:math><m:mrow><m:mn>6</m:mn><m:mo>·</m:mo><m:mn>7</m:mn><m:mo>=</m:mo><m:mn>42</m:mn></m:mrow></m:math></entry>
<entry valign="top" align="left">છ અને સાતનો ગુણાકાર બેતાલીસની બરાબર છે.</entry>
</row>
<row valign="top">
<entry valign="top" align="left"><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>53</m:mn></m:mrow></m:math></entry>
<entry valign="top" align="left"><emphasis effect="italics">x</emphasis> ત્રેપનની બરાબર છે.</entry>
</row>
<row valign="top">
<entry valign="top" align="left"><m:math><m:mrow><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>9</m:mn><m:mo>=</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math></entry>
<entry valign="top" align="left"><emphasis effect="italics">y</emphasis> વત્તા નવ બરાબર બે <emphasis effect="italics">y</emphasis> ઓછા ત્રણ.</entry>
</row>
</tbody>
</tgroup>
</table>
<example id="fs-id1170654953357"><exercise id="fs-id1170654953360">
<problem id="fs-id1170655229951">
<para id="fs-id1170655162511">દરેક પદાવલી છે કે સમીકરણ તે નક્કી કરો:</para>
<para id="fs-id1170655153999"><span class="token">ⓐ</span> <m:math><m:mrow><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>10</m:mn></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mi>y</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow></m:math> <span class="token">ⓒ</span> <m:math><m:mrow><m:mi>x</m:mi><m:mo>÷</m:mo><m:mn>25</m:mn></m:mrow></m:math> <span class="token">ⓓ</span> <m:math><m:mrow><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mo>=</m:mo><m:mn>40</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655111791">
<title>ઉકેલ</title>
<table id="eip-10" class="unnumbered unstyled" summary="આ કોષ્ટક ગણિતીય પદાવલીઓ અને સમીકરણો વચ્ચેનો તફાવત ઉદાહરણો અને સમજૂતી વડે બતાવે છે.">
<tgroup cols="2"><tbody>
  <row>
    <entry><span class="token">ⓐ</span> <m:math><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>10</m:mn></m:math></entry>
    <entry>આ એક <emphasis effect="italics">સમીકરણ</emphasis>છે—બે પદાવલીઓને સમાનતાની નિશાનીથી જોડેલી છે.</entry>
  </row>

<row>
    <entry><span class="token">ⓑ</span> <m:math><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mi>y</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>+</m:mo><m:mn>1</m:mn></m:math></entry>
    <entry>આ એક <emphasis effect="italics">પદાવલી</emphasis>છે—સમાનતાની નિશાની નથી.</entry>
  </row>

<row>
    <entry><span class="token">ⓒ</span> <m:math><m:mi>x</m:mi><m:mo>÷</m:mo><m:mn>25</m:mn></m:math></entry>
   <entry>આ એક <emphasis effect="italics">પદાવલી</emphasis>છે—સમાનતાની નિશાની નથી.</entry>
  </row>

<row>
    <entry><span class="token">ⓓ</span> <m:math><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mo>=</m:mo><m:mn>40</m:mn></m:math></entry>
    <entry>આ એક <emphasis effect="italics">સમીકરણ</emphasis>છે—બે પદાવલીઓને સમાનતાની નિશાનીથી જોડેલી છે.</entry>
  </row>
</tbody>



</tgroup>
</table></solution>
</exercise>
</example><note id="fs-id1170655166808" class="try">
<exercise id="fs-id1170654924234">
<problem id="fs-id1170654924237">
<para id="fs-id1170655124883">દરેક પદાવલી છે કે સમીકરણ તે નક્કી કરો: <span class="token">ⓐ</span> <m:math><m:mrow><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>27</m:mn></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mn>5</m:mn><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mi>y</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math>.</para>
</problem>
<solution id="fs-id1170655226888">
<para id="fs-id1170655120617"><span class="token">ⓐ</span> સમીકરણ <span class="token">ⓑ</span> પદાવલી</para>
</solution>
</exercise>
</note>
<note id="fs-id1170655205588" class="try">
<exercise id="fs-id1170655022136">
<problem id="fs-id1170655027224">
<para id="fs-id1170655027226">દરેક પદાવલી છે કે સમીકરણ તે નક્કી કરો: <span class="token">ⓐ</span> <m:math><m:mrow><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup><m:mo>÷</m:mo><m:mn>14</m:mn></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn><m:mo>=</m:mo><m:mn>22</m:mn></m:mrow></m:math>.</para>
</problem>
<solution id="fs-id1170654959582">
<para id="fs-id1170654959584"><span class="token">ⓐ</span> પદાવલી <span class="token">ⓑ</span> સમીકરણ</para>
</solution>
</exercise>
</note>
<para id="fs-id1170654982105">ધારો કે 2ને અવયવ તરીકે નવ વખત લખીને તેમનો ગુણાકાર કરવાનો છે. તેને આ રીતે લખી શકીએ: <m:math><m:mrow><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>2</m:mn><m:mo>.</m:mo></m:mrow></m:math> આ લાંબું પડે અને કેટલા 2 લખ્યા તેનો હિસાબ રાખવો મુશ્કેલ બની શકે, તેથી ઘાતાંક વાપરીએ છીએ. <m:math><m:mrow><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>2</m:mn></m:mrow></m:math> ને આ રીતે લખીએ: <m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mn>3</m:mn></m:msup></m:mrow></m:math> અને <m:math><m:mrow><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>2</m:mn></m:mrow></m:math> ને આ રીતે લખીએ: <m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mn>9</m:mn></m:msup><m:mo>.</m:mo></m:mrow></m:math> આવી પદાવલીમાં, જેમ કે <m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mn>3</m:mn></m:msup><m:mo>,</m:mo></m:mrow></m:math> 2ને <emphasis effect="italics">આધાર</emphasis> અને 3ને <emphasis effect="italics">ઘાતાંક</emphasis> કહે છે. ઘાતાંક બતાવે છે કે આધારને અવયવ તરીકે કેટલી વખત લખવાનો છે.</para>
<media id="fs-id1170655219218" alt="સંખ્યા બેની ઉપર જમણે ત્રણ લખેલું છે. બે તરફ તીર છે અને તેની પાસે “આધાર” લખ્યું છે; ઉપરના ત્રણ તરફ બીજું તીર છે અને તેની પાસે “ઘાતાંક” લખ્યું છે. તેનો અર્થ બેનો પોતાની સાથે ત્રણ વખત ગુણાકાર, એટલે 2 ગુણ્યા 2 ગુણ્યા 2 થાય છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_02_003_img_new.jpg" />
</media>
<para id="fs-id1166420392829"><m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mn>3</m:mn></m:msup></m:mrow></m:math> ને “બેની ત્રીજી ઘાત” અથવા “બેનો ઘન” તરીકે વાંચીએ છીએ.</para>
<para id="fs-id1170654953415"><m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mn>3</m:mn></m:msup></m:mrow></m:math> એ <emphasis effect="italics">ઘાત સ્વરૂપ</emphasis> માં અને <m:math><m:mrow><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>2</m:mn></m:mrow></m:math> એ <emphasis effect="italics">વિસ્તૃત ગુણાકાર સ્વરૂપ</emphasis> માં છે.</para>
<note id="fs-id1170655107718">
<title>ઘાત સ્વરૂપ</title>
<para id="fs-id1170655213989"><m:math><m:mrow><m:msup><m:mi>a</m:mi><m:mi>n</m:mi></m:msup></m:mrow></m:math> નો અર્થ: <emphasis effect="italics">a</emphasis> ને અવયવ તરીકે <emphasis effect="italics">n</emphasis> વખત લખીને ગુણાકાર કરવો.</para>
<media id="fs-id1170655111941" alt="aની ઉપર જમણે n લખેલું છે. a તરફ તીર “આધાર” અને ઉપરના n તરફ તીર “ઘાતાંક” બતાવે છે. નીચે aની n ઘાત બરાબર a ગુણ્યા a ગુણ્યા લોપચિહ્ન ગુણ્યા a લખ્યું છે, એટલે aનો અનિશ્ચિત n વખત ગુણાકાર થાય છે. ગુણાકારમાં આવેલા aઓ નીચે કૌંસ છે અને “n અવયવો” લખ્યું છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_02_004_img_new.jpg" />
</media>
<para id="fs-id1170655228836">પદાવલી <m:math><m:mrow><m:msup><m:mi>a</m:mi><m:mi>n</m:mi></m:msup></m:mrow></m:math> ને <emphasis effect="italics">a</emphasis> ની <m:math><m:mrow><m:msup><m:mi>n</m:mi><m:mrow><m:mi>t</m:mi><m:mi>h</m:mi></m:mrow></m:msup></m:mrow></m:math> ઘાત તરીકે વાંચીએ છીએ; અહીં અંગ્રેજી ક્રમવાચક અંત “th”નો અર્થ n-મી ઘાત છે.</para>
</note>
<para id="fs-id1170654937018"><m:math><m:mrow><m:msup><m:mi>a</m:mi><m:mi>n</m:mi></m:msup></m:mrow></m:math> ને “<emphasis effect="italics">a</emphasis> ની <m:math><m:mrow><m:msup><m:mi>n</m:mi><m:mrow><m:mi>t</m:mi><m:mi>h</m:mi></m:mrow></m:msup></m:mrow></m:math> ઘાત” તરીકે વાંચીએ છીએ, પરંતુ નીચેની ઘાતો માટે સામાન્ય રીતે આ શબ્દો વાપરીએ છીએ:</para>
<list id="fs-id1166424875923" list-type="bulleted" bullet-style="bullet">
<item><m:math><m:mrow><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> “<emphasis effect="italics">a</emphasis> નો વર્ગ”</item>
<item><m:math><m:mrow><m:msup><m:mi>a</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math> “<emphasis effect="italics">a</emphasis> નો ઘન”</item>
</list>
<para id="fs-id1170655195218">આપણે આગળ જોઈશું કે શા માટે <m:math><m:mrow><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> અને <m:math><m:mrow><m:msup><m:mi>a</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math> નાં ખાસ નામ છે.</para>
<para id="fs-id1170655112606"><link target-id="fs-id1170654954100" /> માં ઘાતાંકવાળી કેટલીક પદાવલીઓ કેવી રીતે વાંચવી તે બતાવ્યું છે.</para>
<table id="fs-id1170654954100" aria-label="આ કોષ્ટકમાં પાંચ હરોળ અને બે સ્તંભ છે. પહેલી મથાળાની હરોળ છે. મથાળાં “પદાવલી” અને “શબ્દોમાં” છે. બીજી હરોળમાં 7ની ઉપર2 અને “7ની બીજી ઘાત અથવા7નો વર્ગ” છે. પછી 5ની ઉપર3 અને “5ની ત્રીજી ઘાત અથવા5નો ઘન” છે. પછી 9ની ઉપર4 અને “9ની ચોથી ઘાત” છે. છેલ્લી હરોળમાં 12ની ઉપર5 અને “12ની પાંચમી ઘાત” છે.">
<tgroup cols="2">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<thead>
<row valign="top">
<entry align="center" valign="top">પદાવલી</entry>
<entry valign="top" align="left">શબ્દોમાં</entry>
</row>
</thead>
<tbody>
<row valign="top">
<entry align="center" valign="top"><m:math><m:mrow><m:msup><m:mn>7</m:mn><m:mn>2</m:mn></m:msup></m:mrow></m:math></entry>
<entry valign="top" align="left">7ની બીજી ઘાત અથવા 7નો વર્ગ</entry>
</row>
<row valign="top">
<entry align="center" valign="top"><m:math><m:mrow><m:msup><m:mn>5</m:mn><m:mn>3</m:mn></m:msup></m:mrow></m:math></entry>
<entry valign="top" align="left">5ની ત્રીજી ઘાત અથવા 5નો ઘન</entry>
</row>
<row valign="top">
<entry align="center" valign="top"><m:math><m:mrow><m:msup><m:mn>9</m:mn><m:mn>4</m:mn></m:msup></m:mrow></m:math></entry>
<entry valign="top" align="left">9ની ચોથી ઘાત</entry>
</row>
<row valign="top">
<entry align="center" valign="top"><m:math><m:mrow><m:msup><m:mrow><m:mn>12</m:mn></m:mrow><m:mn>5</m:mn></m:msup></m:mrow></m:math></entry>
<entry valign="top" align="left"><m:math><m:mrow><m:mn>12</m:mn></m:mrow></m:math> ની પાંચમી ઘાત</entry>
</row>
</tbody>
</tgroup>
</table>
<example id="fs-id1170655121051"><exercise id="fs-id1170655121053">
<problem id="fs-id1170654954435">
<para id="fs-id1170654954437">સાદું રૂપ આપો: <m:math><m:mrow><m:msup><m:mn>3</m:mn><m:mn>4</m:mn></m:msup><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655003298">
<title>ઉકેલ</title>
<table id="eip-958" class="unnumbered unstyled" summary="3^4 ઘાતવાળી પદાવલીની પગલાંવાર કિંમત.">
<tgroup cols="2"><tbody>
  <row>
    <entry> </entry>
    <entry><m:math><m:msup><m:mn>3</m:mn><m:mn>4</m:mn></m:msup></m:math></entry>
  </row>
  <row>
    <entry>પદાવલીને વિસ્તૃત ગુણાકાર સ્વરૂપે લખો.</entry>
    <entry><m:math><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>3</m:mn></m:math></entry>
  </row>
  <row>
    <entry>ડાબેથી જમણે ગુણાકાર કરો.</entry>
    <entry><m:math><m:mn>9</m:mn><m:mo>·</m:mo><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>3</m:mn></m:math></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry><m:math><m:mn>27</m:mn><m:mo>·</m:mo><m:mn>3</m:mn></m:math></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry>81</entry>
  </row>
</tbody>
</tgroup>
</table>
</solution>
</exercise>
</example><note id="fs-id1170655196165" class="try">
<exercise id="fs-id1170655197165">
<problem id="fs-id1170655197167">
<para id="fs-id1170655102365">સાદું રૂપ આપો: <span class="token">ⓐ</span> <m:math><m:mrow><m:msup><m:mn>5</m:mn><m:mn>3</m:mn></m:msup></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:msup><m:mn>1</m:mn><m:mn>7</m:mn></m:msup><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654954209">
<para id="fs-id1170654954211"><span class="token">ⓐ</span> 125 <span class="token">ⓑ</span> 1</para>
</solution>
</exercise>
</note>
<note id="fs-id1170655102894" class="try">
<exercise id="fs-id1170655194687">
<problem id="fs-id1170655194690">
<para id="fs-id1170655025314">સાદું રૂપ આપો: <span class="token">ⓐ</span> <m:math><m:mrow><m:msup><m:mn>7</m:mn><m:mn>2</m:mn></m:msup></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:msup><m:mn>0</m:mn><m:mn>5</m:mn></m:msup><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655114557">
<para id="fs-id1170655114560"><span class="token">ⓐ</span> 49 <span class="token">ⓑ</span> 0</para>
</solution>
</exercise>
</note>
</section><section id="fs-id1170654953465">
<title>ક્રિયાઓના ક્રમથી પદાવલીઓને સાદું રૂપ આપો</title>
<para id="fs-id1170655225397"> <term id="term-00015">પદાવલીને સાદું રૂપ આપવું</term> એટલે શક્ય હોય તે બધી ગણતરી કરવી. દાખલા તરીકે, આને સાદું રૂપ આપવા <m:math><m:mrow><m:mn>4</m:mn><m:mo>·</m:mo><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow></m:math> આપણે પહેલાં ગુણાકાર કરીએ <m:math><m:mrow><m:mn>4</m:mn><m:mo>·</m:mo><m:mn>2</m:mn></m:mrow></m:math> અને 8 મેળવીએ, પછી તેમાં 1 ઉમેરી 9 મેળવીએ. દરેક પગલું અગાઉના પગલાની નીચે લખીને પાનાં પર નીચે તરફ કામ કરવાની સારી ટેવ પાડો. હમણાં વર્ણવેલું ઉદાહરણ આ રીતે દેખાય:</para>
<equation id="fs-id1170655083428" class="unnumbered"><label /><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="center"><m:mn>4</m:mn><m:mo>·</m:mo><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>1</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mn>8</m:mn><m:mo>+</m:mo><m:mn>1</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mn>9</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math></equation>
<para id="fs-id1170654905788">પદાવલીને સાદું રૂપ આપતી વખતે <term class="no-emphasis" id="term-00016">સમાનતાની નિશાની</term> નો ઉપયોગ ન કરવાથી પદાવલી અને સમીકરણ વચ્ચે ગૂંચવણ થતી ટાળી શકાય છે.</para>
<note id="fs-id1170654905792">
<title>પદાવલીને સાદું રૂપ આપો</title>
<para id="fs-id1170655107395"><emphasis effect="bold">પદાવલીને સાદું રૂપ આપવું</emphasis> એટલે તેમાં આપેલી બધી ક્રિયાઓ કરવી.</para>
</note>
<para id="fs-id1170655351594">બીજગણિતમાં વપરાતા મોટા ભાગના સંકેતો અને સંકેતલિપિ રજૂ કરી ચૂક્યા છીએ, પરંતુ હવે ક્રિયાઓનો ક્રમ સ્પષ્ટ કરવો જરૂરી છે. નહીં તો એક જ પદાવલીના જુદા અર્થ અને જુદા મૂલ્યો થઈ શકે. ઉદાહરણ તરીકે, આ પદાવલી જુઓ:</para>
<equation id="fs-id1170655125718" class="unnumbered"><label /><m:math><m:mrow><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>7</m:mn></m:mrow></m:math></equation>
<para id="fs-id1170654942450">આ પદાવલીને સાદું રૂપ આપો તો શું મળે?</para>
<para id="fs-id1170654942453">કેટલાક વિદ્યાર્થી 49 કહે છે,</para>
<equation id="fs-id1170655178023" class="unnumbered"><label /><m:math><m:mrow><m:mtable><m:mtr><m:mtd /><m:mtd /><m:mtd /><m:mtd /><m:mtd /><m:mtd columnalign="center"><m:mspace width="0.8em" /><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>7</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>કારણ કે</m:mtext><m:mspace width="0.2em" /><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mspace width="0.2em" /><m:mtext>આપે છે</m:mtext><m:mspace width="0.2em" /><m:mn>7</m:mn><m:mo>.</m:mo></m:mtd><m:mtd /><m:mtd /><m:mtd /><m:mtd /><m:mtd columnalign="center"><m:mspace width="0.8em" /><m:mn>7</m:mn><m:mo>·</m:mo><m:mn>7</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>7</m:mn><m:mo>·</m:mo><m:mn>7</m:mn><m:mspace width="0.2em" /><m:mtext>છે</m:mtext><m:mspace width="0.2em" /><m:mn>49</m:mn><m:mo>.</m:mo></m:mtd><m:mtd /><m:mtd /><m:mtd /><m:mtd /><m:mtd columnalign="center"><m:mspace width="0.8em" /><m:mn>49</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math></equation>
<para id="fs-id1170654906230">બીજા 25 કહે છે,</para>
<equation id="fs-id1170654906233" class="unnumbered"><label /><m:math><m:mrow><m:mtable><m:mtr><m:mtd /><m:mtd /><m:mtd /><m:mtd /><m:mtd /><m:mtd columnalign="center"><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>7</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>કારણ કે</m:mtext><m:mspace width="0.2em" /><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>7</m:mn><m:mspace width="0.2em" /><m:mtext>છે</m:mtext><m:mspace width="0.2em" /><m:mn>21</m:mn><m:mo>.</m:mo></m:mtd><m:mtd /><m:mtd /><m:mtd /><m:mtd /><m:mtd columnalign="center"><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>21</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>21</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mspace width="0.2em" /><m:mtext>કારણ કે આ આપે છે</m:mtext><m:mspace width="0.2em" /><m:mn>25</m:mn><m:mo>.</m:mo></m:mtd><m:mtd /><m:mtd /><m:mtd /><m:mtd /><m:mtd columnalign="center"><m:mn>25</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math></equation>
<para id="fs-id1170655150670">કલ્પના કરો કે દરેક દાખલાના અનેક જુદા સાચા જવાબ હોય તો આપણી બૅન્ક વ્યવસ્થામાં કેટલી ગૂંચવણ થાય!</para>
<para id="fs-id1170655150674">એક જ પદાવલીનું પરિણામ સરખું આવવું જોઈએ. તેથી ગણિતશાસ્ત્રીઓએ બહુ પહેલાં કેટલીક માર્ગદર્શિકાઓ નક્કી કરી, જેને કહે છે <term class="no-emphasis" id="term-00017">ક્રિયાઓનો ક્રમ</term>.</para>
<note id="fs-id1170654985585" class="howto">
<title>ક્રિયાઓના ક્રમ મુજબ કરો.</title>
<list id="fs-id1166422648602" list-type="enumerated" number-style="arabic" class="stepwise">
<item>ગોળ કૌંસ અને જૂથ દર્શાવતા બીજા સંકેતો
<list id="fs-id1170655082463" list-type="bulleted" bullet-style="bullet">
<item>ગોળ કૌંસ કે જૂથ દર્શાવતા બીજા સંકેતોની અંદરની બધી પદાવલીઓને સાદું રૂપ આપો; સૌથી અંદરના કૌંસથી શરૂ કરો.</item>
</list></item>
<item>ઘાતાંક
<list id="fs-id1170654914692" list-type="bulleted" bullet-style="bullet">
<item>ઘાતાંકવાળી બધી પદાવલીઓને સાદું રૂપ આપો.</item>
</list></item>
<item>ગુણાકાર અને ભાગાકાર
<list id="fs-id1170655178958" list-type="bulleted" bullet-style="bullet">
<item>બધા ગુણાકાર અને ભાગાકાર ડાબેથી જમણે ક્રમમાં કરો. બંને ક્રિયાની પ્રાથમિકતા સરખી છે.</item>
</list></item>
<item>સરવાળો અને <emphasis effect="bold">બ</emphasis>ાદબાકી
<list id="fs-id1170654943796" list-type="bulleted" bullet-style="bullet">
<item>બધા સરવાળા અને બાદબાકી ડાબેથી જમણે ક્રમમાં કરો. બંને ક્રિયાની પ્રાથમિકતા સરખી છે.</item>
</list></item>
</list>
</note>
<note id="fs-id1166425080552" class="manipulative-math">વસ્તુઓની મદદથી ગણિત શીખવાની “24ની રમત” પ્રવૃત્તિ કરવાથી ક્રિયાઓના ક્રમનો અભ્યાસ થશે.</note>
<para id="fs-id1170654938531">વિદ્યાર્થીઓ વારંવાર પૂછે છે, “ક્રમ કેવી રીતે યાદ રાખવો?” અંગ્રેજી મુખ્ય શબ્દોના પહેલા અક્ષરોમાંથી “Please Excuse My Dear Aunt Sally” એવું યાદ રાખવાનું વાક્ય બને છે. નીચે તેનો અર્થ પણ સાથે આપ્યો છે.</para>
<equation id="fs-id1170654007218" class="unnumbered"><label /><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="left"><m:mtext mathvariant="bold">P</m:mtext><m:mtext>arentheses—ગોળ કૌંસ</m:mtext></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mtext mathvariant="bold">P</m:mtext><m:mtext>lease</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext mathvariant="bold">E</m:mtext><m:mtext>xponents—ઘાતાંક</m:mtext></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mtext mathvariant="bold">E</m:mtext><m:mtext>xcuse</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext mathvariant="bold">M</m:mtext><m:mtext>ultiplication—ગુણાકાર</m:mtext><m:mspace width="0.2em" /><m:mtext mathvariant="bold">D</m:mtext><m:mtext>ivision—ભાગાકાર</m:mtext></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mtext mathvariant="bold">M</m:mtext><m:mtext>y</m:mtext><m:mspace width="0.2em" /><m:mtext mathvariant="bold">D</m:mtext><m:mtext>ear</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mtext mathvariant="bold">A</m:mtext><m:mtext>ddition—સરવાળો</m:mtext><m:mspace width="0.2em" /><m:mtext mathvariant="bold">S</m:mtext><m:mtext>ubtraction—બાદબાકી</m:mtext></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mtext mathvariant="bold">A</m:mtext><m:mtext>unt</m:mtext><m:mspace width="0.2em" /><m:mtext mathvariant="bold">S</m:mtext><m:mtext>ally</m:mtext></m:mtd></m:mtr></m:mtable></m:mrow></m:math></equation>
<para id="fs-id1170654932101">અંગ્રેજી યાદવાક્યમાં “<emphasis effect="bold">M</emphasis>y <emphasis effect="bold">D</emphasis>ear” જોડે આવે છે; તેથી <emphasis effect="bold">ગુ</emphasis>ણાકાર અને <emphasis effect="bold">ભા</emphasis>ગાકારને સરખી પ્રાથમિકતા છે તે યાદ રહે છે. આપણે હંમેશાં ગુણાકારને ભાગાકાર પહેલાં કે ભાગાકારને ગુણાકાર પહેલાં કરતા નથી. બંને ડાબેથી જમણે ક્રમમાં કરીએ છીએ.</para>
<para id="fs-id1170654914381">એ જ રીતે અંગ્રેજી યાદવાક્યમાં “<emphasis effect="bold">A</emphasis>unt <emphasis effect="bold">S</emphasis>ally” જોડે આવે છે; તેથી <emphasis effect="bold">સ</emphasis>રવાળો અને <emphasis effect="bold">બા</emphasis>દબાકીને પણ સરખી પ્રાથમિકતા છે અને બંને ડાબેથી જમણે ક્રમમાં કરીએ છીએ તે યાદ રહે છે.</para>
<para id="fs-id1170654928166">ચાલો એક ઉદાહરણ કરીએ.</para>
<example id="fs-id1170654928169">
<exercise id="fs-id1170654954598">
<problem id="fs-id1170654954600">
<para id="fs-id1170654954602">સાદું રૂપ આપો: <span class="token">ⓐ</span> <m:math><m:mrow><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>7</m:mn></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo>·</m:mo><m:mn>7</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654939340">
<title>ઉકેલ</title>
<para id="fs-id1167836283034"><span class="token">ⓐ</span> <newline />
<table id="fs-id1167833022118" class="unnumbered unstyled can-break" aria-label="આ આકૃતિમાં બે સ્તંભ છે: ડાબે લખાણ અને જમણે ગણતરી. જમણા સ્તંભની પહેલી લીટીમાં 4 વત્તા 3 ગુણ્યા 7 છે. પછી ડાબે લખ્યું છે: “કોઈ ગોળ કૌંસ છે? ના. કોઈ ઘાતાંક છે? ના. કોઈ ગુણાકાર કે ભાગાકાર છે? હા.” અંગ્રેજી PEMDAS ક્રમના પહેલા ચાર અક્ષરો બતાવવા Parentheses, Exponents, Multiplication અને Divisionના પહેલા અક્ષરો ઘાટા છે. પછી ડાબે “પહેલાં ગુણાકાર કરો” લખ્યું છે. જમણે ફરી 4 વત્તા 3 ગુણ્યા 7 છે, જેમાં 3 ગુણ્યા 7 લાલ છે. પછી ડાબે “સરવાળો કરો” અને જમણે 4 વત્તા 21 છે. તેની નીચે 4 અને 21નો સરવાળો 25 છે."><label /><tgroup cols="2">
 <tbody>
  <row>
    <entry />
    <entry><media id="fs-id1167836282522" alt="સફેદ પૃષ્ઠભૂમિ પર કાળા રંગમાં 4 + 3·7 ગણિતીય પદાવલી છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_005a_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>શું કોઈ <emphasis effect="bold">ગો</emphasis>ળ કૌંસ છે? ના.</entry>
    <entry />
  </row>
  <row>
    <entry>શું કોઈ <emphasis effect="bold">ઘા</emphasis>તાંક છે? ના.</entry>
    <entry />
  </row>
  <row>
    <entry>શું કોઈ <emphasis effect="bold">ગુ</emphasis>ણાકાર કે <emphasis effect="bold">ભા</emphasis>ગાકાર છે? હા.</entry>
    <entry />
  </row>
  <row>
    <entry>પહેલાં ગુણાકાર કરો.</entry>
    <entry><media id="fs-id1167836477496" alt="સફેદ પૃષ્ઠભૂમિ પર 4 + 3·7 છે. 4 અને વત્તાની નિશાની કાળી છે; 3, ગુણાકાર-બિંદુ અને 7 લાલ છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_005b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>સરવાળો કરો.</entry>
    <entry><media id="fs-id1167833397265" alt="સફેદ પૃષ્ઠભૂમિ પર કાળા રંગમાં 4 + 21 ગણિતીય પદાવલી છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_005c_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry />
    <entry><media id="fs-id1167836477509" alt="સાદી સફેદ પૃષ્ઠભૂમિ પર ઘેરા રાખોડી રંગમાં 25 છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_005d_img_new.jpg" /></media></entry>
  </row>
</tbody>
</tgroup>
</table>
</para>
<para id="fs-id1167836522115"><span class="token">ⓑ</span> <newline />
<table id="fs-id1167829713618" class="unnumbered unstyled" aria-label="આ આકૃતિમાં બે સ્તંભ છે: ડાબે લખાણ અને જમણે ગણતરી. જમણે પહેલી લીટીમાં કૌંસમાં 4 વત્તા 3, પછી ગુણ્યા 7 છે; કૌંસમાંનું 4 + 3 લાલ છે. પછી ડાબે લખ્યું છે: “કોઈ ગોળ કૌંસ છે? હા.” અંગ્રેજી PEMDASનો P દર્શાવવા Parenthesisનો p ઘાટો છે. પછી “કૌંસની અંદર સાદું રૂપ આપો.” જમણે કૌંસમાં લાલ 7 પછી કાળો 7 છે. પછી ડાબે “કોઈ ઘાતાંક છે? ના. કોઈ ગુણાકાર કે ભાગાકાર છે? હા.” PEMDASના બીજા, ત્રીજા અને ચોથા અક્ષર માટે Exponents, Multiplication અને Divisionના પહેલા અક્ષરો ઘાટા છે. છેલ્લે ડાબે “ગુણાકાર કરો” અને જમણે 49 છે."><label /><tgroup cols="2">
 <tbody>
  <row>
    <entry />
    <entry><media id="fs-id1167836700561" alt="ગોળ કૌંસમાં 4 + 3નો સરવાળો છે અને તેનો 7 વડે ગુણાકાર દર્શાવેલો છે: (4 + 3) · 7."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_006a_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>શું કોઈ <emphasis effect="bold">ગો</emphasis>ળ કૌંસ છે? હા.</entry>
    <entry><media id="fs-id1167824617198" alt="(4 + 3) · 7 પદાવલીમાં 4, વત્તાની નિશાની અને 3 લાલ છે; બંને કૌંસ, ગુણાકાર-બિંદુ અને છેલ્લો 7 કાળા છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_006b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>કૌંસની અંદર સાદું રૂપ આપો.</entry>
    <entry><media id="fs-id1167836329648" alt="7 બે વાર બતાવેલો છે; પહેલો લાલ 7 કૌંસમાં છે અને પછી કાળો 7 છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_006c_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>શું કોઈ <emphasis effect="bold">ઘા</emphasis>તાંક છે? ના.</entry>
    <entry />
  </row>
  <row>
    <entry>શું કોઈ <emphasis effect="bold">ગુ</emphasis>ણાકાર કે <emphasis effect="bold">ભા</emphasis>ગાકાર છે? હા.</entry>
    <entry />
  </row>
  <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry><media id="fs-id1167829808043" alt="સાદી સફેદ પૃષ્ઠભૂમિ પર ઘેરા રાખોડી કે કાળા રંગમાં 49 છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_006d_img_new.jpg" /></media></entry>
  </row>
</tbody>
</tgroup>
</table>
</para>
</solution>
</exercise>
</example>
<note id="fs-id1170654944310" class="try">
<exercise id="fs-id1170654936731">
<problem id="fs-id1170654936733">
<para id="fs-id1170654936735">સાદું રૂપ આપો: <span class="token">ⓐ</span> <m:math><m:mrow><m:mn>12</m:mn><m:mo>−</m:mo><m:mn>5</m:mn><m:mo>·</m:mo><m:mn>2</m:mn></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>12</m:mn><m:mo>−</m:mo><m:mn>5</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>·</m:mo><m:mn>2</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654942949">
<para id="fs-id1170654942951"><span class="token">ⓐ</span> 2 <span class="token">ⓑ</span> 14</para>
</solution>
</exercise>
</note>
<note id="fs-id1170654941665" class="try">
<exercise id="fs-id1170655164725">
<problem id="fs-id1170655164727">
<para id="fs-id1170655164730">સાદું રૂપ આપો: <span class="token">ⓐ</span> <m:math><m:mrow><m:mn>8</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>9</m:mn></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>8</m:mn><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>·</m:mo><m:mn>9</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655213403">
<para id="fs-id1170654966589"><span class="token">ⓐ</span> 35 <span class="token">ⓑ</span> 99</para>
</solution>
</exercise>
</note>
<example id="fs-id1170654942986">
<exercise id="fs-id1170654942988">
<problem id="fs-id1170654942990">
<para id="fs-id1170654944773">સાદું રૂપ આપો: <m:math><m:mrow><m:mn>18</m:mn><m:mo>÷</m:mo><m:mn>6</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>5</m:mn><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655114295">
<title>ઉકેલ</title>
<table id="fs-id1167836375645" class="unnumbered unstyled can-break" aria-label="આ આકૃતિમાં બે સ્તંભ છે: ડાબે લખાણ અને જમણે ગણતરી. પહેલી લીટીમાં 18 ભાગ્યા 6 વત્તા 4 ગુણ્યા કૌંસમાં 5 ઓછા 2 છે; કૌંસમાંનું 5 − 2 લાલ છે. પછી ડાબે “કૌંસ છે? હા, પહેલાં બાદબાકી કરો.” અને જમણે 18 ભાગ્યા 6 વત્તા 4 ગુણ્યા કૌંસમાં 3 છે. પછી ડાબે “ઘાતાંક છે? ના. ગુણાકાર કે ભાગાકાર છે? હા. પહેલાં ભાગાકાર કરો, કારણ કે ગુણાકાર અને ભાગાકાર ડાબેથી જમણે કરીએ છીએ.” જમણે 3 વત્તા 4 ગુણ્યા કૌંસમાં 3 છે; 4 અને કૌંસમાંનો 3 લાલ છે. પછી ડાબે “બીજો ગુણાકાર કે ભાગાકાર છે? હા. ગુણાકાર કરો.” જમણે 3 વત્તા 12 લાલ છે. પછી ડાબે “બીજો ગુણાકાર કે ભાગાકાર છે? ના. સરવાળો કે બાદબાકી છે? હા.” જમણે સાદું રૂપ 15 છે."><label /><tgroup cols="2">
 <tbody>
  <row>
    <entry align="left" valign="top">કૌંસ છે? હા, પહેલાં બાદબાકી કરો.</entry>
    <entry><m:math><m:mrow><m:mn>18</m:mn><m:mo>÷</m:mo><m:mn>6</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>5</m:mn><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math><newline /><m:math><m:mrow><m:mspace width="0.2em" /></m:mrow></m:math><media id="fs-id1167836598935" alt="18 ભાગ્યા 6 વત્તા 4 ગુણ્યા 3 દર્શાવતી પદાવલી: 18 ÷ 6 + 4(3)."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_007b_img.jpg" /></media></entry>
  </row>
  <row>
    <entry>ઘાતાંક છે? ના.</entry>
    <entry />
  </row>
  <row>
    <entry>ગુણાકાર કે ભાગાકાર છે? હા.</entry>
    <entry><media id="fs-id1171791418206" alt="સફેદ પૃષ્ઠભૂમિ પર 18 ÷ 6 + 4(3) પદાવલી છે. 18 ÷ 6 અને 4(3) લાલ છે, જ્યારે વચ્ચેની વત્તાની નિશાની કાળી છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_007f_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>પહેલાં ભાગાકાર કરો, કારણ કે ગુણાકાર અને ભાગાકાર ડાબેથી જમણે કરીએ છીએ.</entry>
    <entry><media id="fs-id1167833349691" alt="3 + 4(3) પદાવલીમાં 4(3) લાલ છે; સરવાળા પહેલાં આ ગુણાકાર કરવો તે દર્શાવે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_007c_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>બીજો કોઈ ગુણાકાર કે ભાગાકાર છે? હા.</entry>
    <entry />
  </row>
  <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry><media id="fs-id1167836622811" alt="સફેદ પૃષ્ઠભૂમિ પર ઘેરા રંગમાં 3 + 12 પદાવલી છે; તે સરવાળો દર્શાવે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_007d_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>બીજો કોઈ ગુણાકાર કે ભાગાકાર છે? ના.</entry>
    <entry />
  </row>
  <row>
    <entry>કોઈ સરવાળો કે બાદબાકી છે? હા.</entry>
    <entry><media id="fs-id1167829596718" alt="સફેદ પૃષ્ઠભૂમિ પર ઘેરા રાખોડી રંગમાં 15 છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_007e_img_new.jpg" /></media></entry>
  </row>
</tbody>
</tgroup>
</table>
</solution>
</exercise>
</example>
<note id="fs-id1170655128975" class="try">
<exercise id="fs-id1170655117790">
<problem id="fs-id1170655117792">
<para id="fs-id1170655117794">સાદું રૂપ આપો: <m:math><m:mrow><m:mn>30</m:mn><m:mo>÷</m:mo><m:mn>5</m:mn><m:mo>+</m:mo><m:mn>10</m:mn><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>3</m:mn><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654943705">
<para id="fs-id1170654936134">16</para>
</solution>
</exercise>
</note>
<note id="fs-id1170654928200" class="try">
<exercise id="fs-id1170654928204">
<problem id="fs-id1170655232374">
<para id="fs-id1170655232376">સાદું રૂપ આપો: <m:math><m:mrow><m:mn>70</m:mn><m:mo>÷</m:mo><m:mn>10</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>6</m:mn><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655288151">
<para id="fs-id1170655288153">23</para>
</solution>
</exercise>
</note>
<para id="fs-id1170654928809">જૂથ દર્શાવતા અનેક સંકેતો હોય ત્યારે સૌથી અંદરના કૌંસથી શરૂ કરીને બહાર તરફ સાદું રૂપ આપીએ છીએ.</para>
<example id="fs-id1170655174684">
<exercise id="fs-id1170655174686">
<problem id="fs-id1170655228886">
<para id="fs-id1170655228888">સાદું રૂપ આપો: <m:math><m:mrow><m:mn>5</m:mn><m:mo>+</m:mo><m:msup><m:mn>2</m:mn><m:mn>3</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mrow><m:mo>[</m:mo><m:mrow><m:mn>6</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>4</m:mn><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow><m:mo>]</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654914329">
<title>ઉકેલ</title>
<table id="fs-id1167829840981" class="unnumbered unstyled can-break" aria-label="આ આકૃતિમાં બે સ્તંભ છે: ડાબે લખાણ અને જમણે ગણતરી. શરૂઆતની પદાવલી 5 + 2ની ત્રીજી ઘાત + 3[6 − 3(4 − 2)] છે. ડાબે “કોઈ કૌંસ કે જૂથસંકેત છે? હા. ચોરસ કૌંસની અંદરના ગોળ કૌંસ પર ધ્યાન આપો.” જમણે એ જ પદાવલીમાં (4 − 2) લાલ છે. “પહેલાં બાદબાકી કરો” પછી 5 + 2ની ત્રીજી ઘાત + 3[6 − 3(2)] છે; કૌંસમાંનો 2 લાલ છે. “ચોરસ કૌંસની અંદર આગળ ગુણાકાર કરો” પછી 5 + 2ની ત્રીજી ઘાત + 3[6 − 6] છે; [6 − 6] લાલ છે. “આગળ બાદબાકી કરો” પછી 5 + 2ની ત્રીજી ઘાત + 3[0] છે; 0 લાલ છે. “ચોરસ કૌંસમાં હવે વધુ સાદું રૂપ નથી. ઘાતાંક છે? હા. ઘાતનું સાદું રૂપ આપો.” પછી એ જ પદાવલીમાં 2ની ત્રીજી ઘાત લાલ છે. “ગુણાકાર કે ભાગાકાર છે? હા. ગુણાકાર કરો.” પછી 5 + 8 + 3[0]માં 3[0] લાલ છે. “સરવાળો કે બાદબાકી છે? હા. સરવાળો કરો.” પછી 5 + 8 + 0માં 5 + 8 લાલ છે. “સરવાળો કરો” પછી લાલ 13 + 0 અને અંતે સાદું રૂપ 13 છે."><label /><tgroup cols="2">
 <tbody>
  <row>
    <entry />
    <entry><media id="fs-id1167836287043" alt="ગોળ અને ચોરસ કૌંસમાં ગોઠવેલી સરવાળા, બાદબાકી, ઘાત અને ગુણાકારની પદાવલી: 5 + 2^3 + 3[6 − 3(4 − 2)]."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_008a_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>કોઈ ગોળ કૌંસ કે જૂથ દર્શાવતો બીજો સંકેત છે? હા.</entry>
    <entry />
  </row>
  <row>
    <entry>ચોરસ કૌંસની અંદરના ગોળ કૌંસ પર ધ્યાન આપો.</entry>
    <entry><media id="fs-id1167836326514" alt="5 + 2³ + 3[6 − 3(4 − 2)] પદાવલીમાં સૌથી અંદરનું (4 − 2) જૂથ, બંને કૌંસ સહિત, લાલ છે. બાકી બધું કાળું છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_008b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>બાદબાકી કરો.</entry>
    <entry><media id="fs-id1167836578693" alt="5 + 2^3 + 3[6 − 3(2)] પદાવલીમાં “3(2)” લાલ છે અને આગળના પગલાનું ધ્યાન ત્યાં દોરે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_008c_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>ચોરસ કૌંસની અંદર આગળ ગુણાકાર કરો.</entry>
    <entry><media id="fs-id1167833142573" alt="5 + 2³ + 3[6 − 6] પદાવલીમાં ચોરસ કૌંસની અંદર પહેલો 6 કાળો છે, જ્યારે પછીનું −6 લાલ છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_008d_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>ચોરસ કૌંસની અંદર આગળ બાદબાકી કરો.</entry>
    <entry><media id="fs-id1167824720931" alt="5 + 2^3 + 3[0] પદાવલીમાં ચોરસ કૌંસનો 0 લાલ છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_008e_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>ચોરસ કૌંસની અંદરની પદાવલીને હવે વધુ સાદું રૂપ આપવાની જરૂર નથી.</entry>
    <entry />
  </row>
  <row>
    <entry>કોઈ ઘાતાંક છે? હા.</entry>
    <entry><media id="fs-id1167836571320" alt="5 + 2³ + 3(0) પદાવલીમાં 2³ લાલ છે; બાકીનાં ચિહ્નો અને સંખ્યાઓ કાળાં છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_008f_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>ઘાતાંકવાળી પદાવલીને સાદું રૂપ આપો.</entry>
    <entry><media id="fs-id1167836363366" alt="સફેદ પૃષ્ઠભૂમિ પર 5 + 8 + 3[0] છે; 3[0] લાલ છે અને આગળનું ધ્યાન ત્યાં દોરે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_008g_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>કોઈ ગુણાકાર કે ભાગાકાર છે? હા.</entry>
    <entry />
  </row>
  <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry><media id="fs-id1167836628989" alt="5 + 8 + 0 પદાવલીમાં 5, 8 અને પહેલું વત્તાનું ચિહ્ન લાલ છે; બીજું વત્તાનું ચિહ્ન અને 0 કાળાં છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_008h_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>કોઈ સરવાળો કે બાદબાકી છે? હા.</entry>
    <entry />
  </row>
  <row>
    <entry>સરવાળો કરો.</entry>
    <entry><media id="fs-id1167836408301" alt="સફેદ પૃષ્ઠભૂમિ પર લાલ રંગમાં 13 + 0 છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_008i_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>સરવાળો કરો.</entry>
    <entry><media id="fs-id1167836321064" alt="13"><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_008j_img_new.jpg" /></media></entry>
  </row>
</tbody>
</tgroup>
</table>
</solution>
</exercise>
</example>
<note id="fs-id1170655222643" class="try">
<exercise id="fs-id1170655222647">
<problem id="fs-id1170654924513">
<para id="fs-id1170654924515">સાદું રૂપ આપો: <m:math><m:mrow><m:mn>9</m:mn><m:mo>+</m:mo><m:msup><m:mn>5</m:mn><m:mn>3</m:mn></m:msup><m:mo>−</m:mo><m:mrow><m:mo>[</m:mo><m:mrow><m:mn>4</m:mn><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>9</m:mn><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow><m:mo>]</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655201328">
<para id="fs-id1170655201331">86</para>
</solution>
</exercise>
</note>
<note id="fs-id1170654936028" class="try">
<exercise id="fs-id1170654942628">
<problem id="fs-id1170654942630">
<para id="fs-id1170654942632">સાદું રૂપ આપો: <m:math><m:mrow><m:msup><m:mn>7</m:mn><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>2</m:mn><m:mrow><m:mo>[</m:mo><m:mrow><m:mn>4</m:mn><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>5</m:mn><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow><m:mo>]</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655163264">
<para id="fs-id1170654940244">1</para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1170654889475">
<title>પદાવલીની કિંમત શોધો</title>
<para id="fs-id1170654968998">છેલ્લાં થોડાં ઉદાહરણોમાં આપણે ક્રિયાઓના ક્રમથી પદાવલીઓને સાદું રૂપ આપ્યું. હવે ફરી ક્રિયાઓના ક્રમને અનુસરીને પદાવલીઓની કિંમત શોધીશું. <emphasis effect="bold">પદાવલીની કિંમત શોધવી</emphasis> એટલે ચલની જગ્યાએ આપેલી સંખ્યા મૂકી પદાવલીનું મૂલ્ય શોધવું.</para>
<note id="fs-id1170654969001">
<title>પદાવલીની કિંમત શોધો</title>
<para id="fs-id1170655161751"> <term id="term-00018">પદાવલીની કિંમત શોધવી</term> એટલે ચલની જગ્યાએ આપેલી સંખ્યા મૂકી પદાવલીનું મૂલ્ય શોધવું.</para>
</note>
<para id="fs-id1170655353204">પદાવલીની કિંમત શોધવા તેમાં ચલની જગ્યાએ આપેલી સંખ્યા મૂકો અને પછી પદાવલીને સાદું રૂપ આપો.</para>
<example id="fs-id1170654889272">
<exercise id="fs-id1170654889274">
<problem id="fs-id1170655154711">
<para id="fs-id1170655154713">કિંમત શોધો: <m:math><m:mrow><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>,</m:mo></m:mrow></m:math> જ્યારે <span class="token">ⓐ</span> <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math> અને <span class="token">ⓑ</span> <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>1</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655177952">
<title>ઉકેલ</title>
<para id="fs-id1166424830192"><span class="token">ⓐ</span> <newline />
<table id="fs-id1167836329359" class="unnumbered unstyled" aria-label="આકૃતિમાં ડાબે સૂચનાઓ અને જમણે ગણતરી છે. ડાબે “જ્યારે x બરાબર 5” અને જમણે 7x ઓછા 4 છે. નીચે xની જગ્યાએ 5 મૂકીને 7(5) − 4 છે. પછી ડાબે “ગુણાકાર કરો” અને જમણે 35 − 4 છે. પછી ડાબે “બાદબાકી કરો” અને જમણે સાદું રૂપ 31 છે."><label /><tgroup cols="2">
 <tbody>
  <row>
    <entry><media id="fs-id1167836295066" alt="સફેદ પૃષ્ઠભૂમિ પર “જ્યારે x = 5” છે; 5 હળવા લાલ રંગે દર્શાવ્યો છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_009a_img_new.jpg" /></media></entry>
    <entry><media id="fs-id1167829597558" alt="સફેદ પૃષ્ઠભૂમિ પર 7x − 4 પદાવલી છે; તેમાં 7, ચલ x, ઓછાની નિશાની અને 4 છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_009b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry />
    <entry><media id="fs-id1167833076771" alt="7 ગુણ્યા 5 ઓછા 4 દર્શાવતી 7(5) − 4 પદાવલીમાં 5 લાલ છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_009c_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry><media id="fs-id1167836554298" alt="સફેદ પૃષ્ઠભૂમિ પર ઘેરા રાખોડી રંગમાં 35 − 4 છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_009d_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>બાદબાકી કરો.</entry>
    <entry><media id="fs-id1167836507263" alt="સાદી સફેદ પૃષ્ઠભૂમિના ઉપર જમણા ખૂણે 31 સ્પષ્ટ દેખાય છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_009e_img_new.jpg" /></media></entry>
  </row>
</tbody>
</tgroup>
</table>
</para>
<para id="fs-id1167829683833"><span class="token">ⓑ</span> <newline />
<table id="fs-id1167833047529" class="unnumbered unstyled" aria-label="આકૃતિમાં ડાબે સૂચનાઓ અને જમણે ગણતરી છે. ડાબે “જ્યારે x બરાબર 1” અને જમણે 7x ઓછા 4 છે. નીચે xની જગ્યાએ 1 મૂકીને 7(1) − 4 છે. પછી ડાબે “ગુણાકાર કરો” અને જમણે 7 − 4 છે. પછી ડાબે “બાદબાકી કરો” અને જમણે સાદું રૂપ 3 છે."><label /><tgroup cols="2">
 <tbody>
  <row>
    <entry><media id="fs-id1167829597755" alt="સફેદ પૃષ્ઠભૂમિ પર “જ્યારે x = 1” છે; 1 લાલ રંગે દર્શાવ્યો છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_010a_img_new.jpg" /></media></entry>
    <entry><media id="fs-id1167836492302" alt="સફેદ પૃષ્ઠભૂમિ પર 7x − 4 પદાવલી છે; તેમાં 7, ચલ x, ઓછાની નિશાની અને 4 છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_010b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry />
    <entry><media id="fs-id1167836296392" alt="7(1) − 4 પદાવલીમાં 1 લાલ છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_010c_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry><media id="fs-id1167836294733" alt="સફેદ પૃષ્ઠભૂમિ પર 7 − 4 સંખ્યાઓ છે; તે સાદી બાદબાકી દર્શાવે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_010d_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>બાદબાકી કરો.</entry>
    <entry><media id="fs-id1167833014906" alt="સ્વચ્છ સફેદ પૃષ્ઠભૂમિ પર ઘેરો રાખોડી મોટો અંક 3 છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_010e_img_new.jpg" /></media></entry>
  </row>
</tbody>
</tgroup>
</table></para>
</solution>
</exercise>
</example>
<note id="fs-id1170654936461" class="try">
<exercise id="fs-id1170654920156">
<problem id="fs-id1170654920158">
<para id="fs-id1170655196807">કિંમત શોધો: <m:math><m:mrow><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>,</m:mo></m:mrow></m:math> જ્યારે <span class="token">ⓐ</span> <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math> અને <span class="token">ⓑ</span> <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>1</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654913926">
<para id="fs-id1170654913929"><span class="token">ⓐ</span> 13 <span class="token">ⓑ</span> 5</para>
</solution>
</exercise>
</note>
<note id="fs-id1170654968085" class="try">
<exercise id="fs-id1170654928390">
<problem id="fs-id1170654928392">
<para id="fs-id1170654928394">કિંમત શોધો: <m:math><m:mrow><m:mn>4</m:mn><m:mi>y</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>,</m:mo></m:mrow></m:math> જ્યારે <span class="token">ⓐ</span> <m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math> અને <span class="token">ⓑ</span> <m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>5</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654941204">
<para id="fs-id1170655068157"><span class="token">ⓐ</span> 8 <span class="token">ⓑ</span> 16</para>
</solution>
</exercise>
</note>
<example id="fs-id1170655213474">
<exercise id="fs-id1170655213476">
<problem id="fs-id1170655213478">
<para id="fs-id1170655129489">જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mo>,</m:mo></m:mrow></m:math> ત્યારે નીચેની પદાવલીઓની કિંમત શોધો: <span class="token">ⓐ</span> <m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>; <span class="token">ⓑ</span> <m:math><m:mrow><m:msup><m:mn>3</m:mn><m:mi>x</m:mi></m:msup><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654943583">
<title>ઉકેલ</title>
<para id="fs-id1166424780807"><span class="token">ⓐ</span> <newline />
<table id="fs-id1167829717426" class="unnumbered unstyled" aria-label="આકૃતિમાં ડાબે સૂચનાઓ અને જમણે ગણતરી છે. ડાબે “xની જગ્યાએ 4 મૂકો” અને જમણે xનો વર્ગ છે. પછી ડાબે “ઘાતાંકની વ્યાખ્યા વાપરો” અને જમણે 4નો વર્ગ છે. પછી ડાબે “સાદું રૂપ આપો” અને જમણે 4 ગુણ્યા 4 છે. તેની નીચે xની જગ્યાએ4 મૂક્યાનું પરિણામ16 છે."><label /><tgroup cols="2">
 <tbody>
  <row>
<entry />
<entry align="center"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></entry>
  </row>
  <row>
    <entry><media id="fs-id1167826170152" alt="સાદી સફેદ પૃષ્ઠભૂમિ પર રાખોડી લખાણમાં “xની જગ્યાએ 4 મૂકો” છે; 4 લાલ છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_011a_img_new.jpg" /></media></entry>
    <entry align="center"><media id="fs-id1167836526102" alt="લાલ રંગના મોટા 4ની ઉપર જમણે ઘાતાંક 2 છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_011b_img_new.jpg" /></media></entry>
  </row>
  <row>
<entry>ઘાતાંકની વ્યાખ્યા વાપરો. </entry>
<entry align="center"><m:math><m:mrow><m:mn>4</m:mn><m:mo>·</m:mo><m:mn>4</m:mn></m:mrow></m:math></entry>
  </row>
  <row>
<entry>સાદું રૂપ આપો.</entry>
<entry align="center"><m:math><m:mrow><m:mn>16</m:mn></m:mrow></m:math></entry>
  </row>
</tbody>
</tgroup>
</table></para>
<para id="fs-id1167836730046"><span class="token">ⓑ</span> <newline />
<table id="fs-id1167836504155" class="unnumbered unstyled" aria-label="આકૃતિમાં ડાબે સૂચનાઓ અને જમણે ગણતરી છે. ડાબે “xની જગ્યાએ 4 મૂકો” અને જમણે 3ની ચોથી ઘાત છે. પછી ડાબે “ઘાતાંકની વ્યાખ્યા વાપરો” અને જમણે 3 ગુણ્યા 3 ગુણ્યા 3 ગુણ્યા 3 છે. પછી ડાબે “સાદું રૂપ આપો” અને જમણે 81 છે; આ 3ની x ઘાતમાં xની જગ્યાએ4 મૂક્યાનું પરિણામ છે."><label /><tgroup cols="2">
 <tbody>
  <row>
<entry />
<entry align="center"><m:math><m:mrow><m:msup><m:mn>3</m:mn><m:mtext>x</m:mtext></m:msup></m:mrow></m:math></entry>
  </row>
  <row>
    <entry><media id="fs-id1167829692365" alt="ડિજિટલ લખાણમાં “xની જગ્યાએ 4 મૂકો” છે; “xની જગ્યાએ” ઘેરા રાખોડી, 4 લાલ-નારંગી અને પછીનું પૂર્ણવિરામ ઘેરું રાખોડી છે. પૃષ્ઠભૂમિ સફેદ છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_012a_img_new.jpg" /></media></entry>
    <entry align="center"><media id="fs-id1167836692989" alt="3ની ઉપર જમણે ચલ x લખીને 3^x ઘાતવાળી પદાવલી બતાવી છે; 3 આધાર અને x ઘાતાંક છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_02_012b_img_new.jpg" /></media></entry>
  </row>
  <row>
<entry>ઘાતાંકની વ્યાખ્યા વાપરો.</entry>
<entry align="center"><m:math><m:mrow><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>3</m:mn></m:mrow></m:math></entry>
  </row>
  <row>
<entry>સાદું રૂપ આપો.</entry>
<entry align="center"><m:math><m:mrow><m:mn>81</m:mn></m:mrow></m:math></entry>
  </row>
</tbody>
</tgroup>
</table>
</para>
</solution>
</exercise>
</example>
<note id="fs-id1170655120535" class="try">
<exercise id="fs-id1170655120539">
<problem id="fs-id1170655202547">
<para id="fs-id1170655202549">જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn><m:mo>,</m:mo></m:mrow></m:math> ત્યારે નીચેની પદાવલીઓની કિંમત શોધો: <span class="token">ⓐ</span> <m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math>; <span class="token">ⓑ</span> <m:math><m:mrow><m:msup><m:mn>4</m:mn><m:mi>x</m:mi></m:msup><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654965432">
<para id="fs-id1170654931966"><span class="token">ⓐ</span> <m:math><m:mrow><m:mn>9</m:mn></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mn>64</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170655353747" class="try">
<exercise id="fs-id1170655353751">
<problem id="fs-id1170655133647">
<para id="fs-id1170655133650">જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>6</m:mn><m:mo>,</m:mo></m:mrow></m:math> ત્યારે નીચેની પદાવલીઓની કિંમત શોધો: <span class="token">ⓐ</span> <m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math>; <span class="token">ⓑ</span> <m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mi>x</m:mi></m:msup><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655126552">
<para id="fs-id1170654958705"><span class="token">ⓐ</span> <m:math><m:mrow><m:mn>216</m:mn></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mn>64</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<example id="fs-id1170655171250">
<exercise id="fs-id1170655171252">
<problem id="fs-id1170655171254">
<para id="fs-id1170654957369">કિંમત શોધો: <m:math><m:mrow><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655200587">
<title>ઉકેલ</title>
<para id="fs-id1169149281503"><table id="fs-id1169148881010" class="unnumbered unstyled" aria-label="આકૃતિમાં ડાબે સૂચનાઓ અને જમણે ગણતરી છે. ઉપર જમણે 2xનો વર્ગ વત્તા 3x વત્તા 8 છે. ડાબે “x = 4 મૂકો” અને જમણે 2(4)નો વર્ગ + 3(4) + 8 છે. પછી ડાબે “ક્રિયાઓનો ક્રમ અનુસરો” અને જમણે 2(16) + 3(4) + 8 છે. તેની નીચે 32 + 12 + 8 અને પછી પરિણામ 52 છે.">
<label />
<tgroup cols="2">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<tbody>
<row valign="top">
<entry valign="top" align="left" />
<entry align="center" valign="top"><m:math><m:mrow><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow></m:math></entry>
</row>
<row valign="top">
<entry valign="top" align="left"><media id="fs-id1169149357522" alt="“x = 4 મૂકો” લખ્યું છે; 4 લાલ રંગે દર્શાવ્યો છે."><image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_02_013a_img_new.jpg" /></media></entry>
<entry align="center" valign="top"><media id="fs-id1169149089480" alt="સફેદ પૃષ્ઠભૂમિ પર કાળા રંગમાં 2xનો વર્ગ વત્તા 3x વત્તા 8 પદાવલી છે."><image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_02_013b_img_new.jpg" /></media></entry>
</row>
<row valign="top">
<entry valign="top" align="left">ક્રિયાઓનો ક્રમ અનુસરો.</entry>
<entry align="center" valign="top"><m:math><m:mrow><m:mn>2</m:mn><m:mo>(</m:mo><m:mn>16</m:mn><m:mo>)</m:mo><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>(</m:mo><m:mn>4</m:mn><m:mo>)</m:mo><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow></m:math></entry>
</row>
<row valign="top">
<entry valign="top" align="left" />
<entry align="center" valign="top"><m:math><m:mrow><m:mn>32</m:mn><m:mo>+</m:mo><m:mn>12</m:mn><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow></m:math></entry>
</row>
<row valign="top">
<entry valign="top" align="left" />
<entry align="center" valign="top"><m:math><m:mrow><m:mn>52</m:mn></m:mrow></m:math></entry>
</row>
</tbody>
</tgroup>
</table></para>
</solution>
</exercise>
</example>
<note id="fs-id1170655160606" class="try">
<exercise id="fs-id1170655160609">
<problem id="fs-id1170654942304">
<para id="fs-id1170654942306">કિંમત શોધો: <m:math><m:mrow><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655209422">
<para id="fs-id1170655209424">40</para>
</solution>
</exercise>
</note>
<note id="fs-id1170655197213" class="try">
<exercise id="fs-id1170655197217">
<problem id="fs-id1170655163499">
<para id="fs-id1170655163501">કિંમત શોધો: <m:math><m:mrow><m:mn>6</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655106382">
<para id="fs-id1170655106384">9</para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1170655163482">
<title>સજાતીય પદો ઓળખો અને ભેગાં કરો</title><para id="fs-id1170655355506">બીજગણિતીય પદાવલીઓ પદોની બનેલી હોય છે. <emphasis effect="bold">પદ</emphasis> એ અચળ અથવા એક કે વધુ ચલો અને અચળનો ગુણાકાર છે.</para>
<note id="fs-id1170655355510">
<title>પદ</title>
<para id="fs-id1170655081102"> <term id="term-00019">પદ</term> એ અચળ અથવા એક કે વધુ ચલો અને અચળનો ગુણાકાર છે.</para>
</note>
<para id="fs-id1170655106479">પદોનાં ઉદાહરણ છે <m:math><m:mrow><m:mn>7</m:mn><m:mo>,</m:mo><m:mi>y</m:mi><m:mo>,</m:mo><m:mn>5</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>9</m:mn><m:mi>a</m:mi><m:mo>,</m:mo><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:msup><m:mi>b</m:mi><m:mn>5</m:mn></m:msup><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id1170654944550">ચલ સાથે ગુણાતી અચળ સંખ્યાને કહે છે <emphasis effect="bold">સહગુણક</emphasis>.</para>
<para id="fs-id1171789962795"><newline /><newline /></para>
<note id="fs-id1170654944554">
<title>સહગુણક</title>
<para id="fs-id1170655190285"> <term id="term-00020">સહગુણક</term> એ પદમાં ચલ સાથે ગુણાતી અચળ સંખ્યા છે.</para>
</note>
<para id="fs-id1170655108012">સહગુણકને ચલની આગળની સંખ્યા સમજો. 3<emphasis effect="italics">x</emphasis> પદનો સહગુણક 3 છે. જ્યારે આપણે <emphasis effect="italics">x</emphasis> લખીએ ત્યારે સહગુણક 1 છે, કારણ કે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>1</m:mn><m:mo>·</m:mo><m:mi>x</m:mi><m:mo>.</m:mo></m:mrow></m:math></para>
<example id="fs-id1170654958635">
<exercise id="fs-id1170654958637">
<problem id="fs-id1170654958640">
<para id="fs-id1170655199112">દરેક પદનો સહગુણક ઓળખો: <span class="token">ⓐ</span> 14<emphasis effect="italics">y</emphasis> <span class="token">ⓑ</span> <m:math><m:mrow><m:mn>15</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> <span class="token">ⓒ</span> <emphasis effect="italics">a</emphasis>.</para>
</problem>
<solution id="fs-id1170655353600">
<title>ઉકેલ</title>
<para id="fs-id1166425225066"><span class="token">ⓐ</span> 14<emphasis effect="italics">y</emphasis> નો સહગુણક 14 છે.<newline /><newline />
<span class="token">ⓑ</span> <m:math><m:mrow><m:mn>15</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> નો સહગુણક 15 છે.<newline /><newline />
<span class="token">ⓒ</span> <emphasis effect="italics">a</emphasis> નો સહગુણક 1 છે, કારણ કે <m:math><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>1</m:mn><m:mspace width="0.2em" /><m:mi>a</m:mi><m:mo>.</m:mo></m:mrow></m:math></para>
</solution>
</exercise>
</example>
<note id="fs-id1170654942248" class="try">
<exercise id="fs-id1170654942251">
<problem id="fs-id1170654942254">
<para id="fs-id1170654942256">દરેક પદનો સહગુણક ઓળખો: <span class="token">ⓐ</span> <m:math><m:mrow><m:mn>17</m:mn><m:mi>x</m:mi></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mn>41</m:mn><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> <span class="token">ⓒ</span> <emphasis effect="italics">z</emphasis>.</para>
</problem>
<solution id="fs-id1170654943070">
<para id="fs-id1170654943072"><span class="token">ⓐ</span> 17 <span class="token">ⓑ</span> 41 <span class="token">ⓒ</span> 1</para>
</solution>
</exercise>
</note>
<note id="fs-id1170654941712" class="try">
<exercise id="fs-id1170654941715">
<problem id="fs-id1170654941718">
<para id="fs-id1170654941720">દરેક પદનો સહગુણક ઓળખો: <span class="token">ⓐ</span> 9<emphasis effect="italics">p</emphasis> <span class="token">ⓑ</span> <m:math><m:mrow><m:mn>13</m:mn><m:msup><m:mi>a</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math> <span class="token">ⓒ</span> <m:math><m:mrow><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654941893">
<para id="fs-id1170654941895"><span class="token">ⓐ</span> 9 <span class="token">ⓑ</span> 13 <span class="token">ⓒ</span> 1</para>
</solution>
</exercise>
</note>
<para id="fs-id1170654944001">કેટલાક પદોનાં લક્ષણો સરખાં હોય છે. નીચેના 6 પદો જુઓ. કયાં પદોનાં લક્ષણો સરખાં લાગે છે?</para>
<equation id="fs-id1170655066427" class="unnumbered"><label /><m:math><m:mrow><m:mtable><m:mtr><m:mtd columnalign="left"><m:mn>5</m:mn><m:mi>x</m:mi></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mn>7</m:mn></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mn>4</m:mn></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mn>3</m:mn><m:mi>x</m:mi></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mn>9</m:mn><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup></m:mtd></m:mtr></m:mtable></m:mrow></m:math></equation>
<para id="fs-id1170654943858">7 અને 4 બંને અચળ પદો છે.</para>
<para id="fs-id1170654943862"><emphasis effect="italics">5x</emphasis> અને 3<emphasis effect="italics">x</emphasis> બંને પદોમાં <emphasis effect="italics">x</emphasis> છે.</para>
<para id="fs-id1170654944183"><m:math><m:mrow><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> અને <m:math><m:mrow><m:mn>9</m:mn><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> બંનેમાં આ જ ચલ અને ઘાતાંક છે: <m:math><m:mrow><m:msup><m:mi>n</m:mi><m:mn>2</m:mn></m:msup><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id1170655192776">બે પદો અચળ હોય અથવા બંનેમાં સરખો ચલ અને સરખો ઘાતાંક હોય ત્યારે તેમને કહીએ છીએ <emphasis effect="bold">સજાતીય પદો</emphasis>.</para>
<list id="fs-id1166422559187" list-type="bulleted" bullet-style="bullet">
<item>7 અને 4 સજાતીય પદો છે.</item>
<item>5<emphasis effect="italics">x</emphasis> અને 3<emphasis effect="italics">x</emphasis> સજાતીય પદો છે.</item>
<item><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> અને <m:math><m:mrow><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> સજાતીય પદો છે.</item>
</list>
<note id="fs-id1170654936881">
<title>સજાતીય પદો</title>
<para id="fs-id1170654936541">જે પદો બંને અચળ હોય અથવા જેમના સરખા ચલોની ઘાતો સરખી હોય તેમને કહે છે <term id="term-00021">સજાતીય પદો</term>.</para>
</note>
<example id="fs-id1170654936780">
<exercise id="fs-id1170654936782">
<problem id="fs-id1170654936784">
<para id="fs-id1170654936786">સજાતીય પદો ઓળખો: <m:math><m:mrow><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup><m:mo>,</m:mo></m:mrow></m:math> <m:math><m:mrow><m:mn>7</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo></m:mrow></m:math> 14, 23, <m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup><m:mo>,</m:mo></m:mrow></m:math> 9<emphasis effect="italics">x</emphasis>, <m:math><m:mrow><m:mn>5</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655189504">
<title>ઉકેલ</title>
<para id="fs-id1170654942212"><m:math><m:mrow><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math> અને <m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math> સજાતીય પદો છે, કારણ કે બંનેમાં છે <m:math><m:mrow><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup><m:mo>;</m:mo></m:mrow></m:math> ; ચલ અને ઘાતાંક બંને સરખાં છે.</para>
<para id="fs-id1170654940949"><m:math><m:mrow><m:mn>7</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> અને <m:math><m:mrow><m:mn>5</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> સજાતીય પદો છે, કારણ કે બંનેમાં છે <m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>;</m:mo></m:mrow></m:math> ; ચલ અને ઘાતાંક બંને સરખાં છે.</para>
<para id="fs-id1170654935536">14 અને 23 સજાતીય પદો છે, કારણ કે બંને અચળ છે.</para>
<para id="fs-id1170655195762">9 જેવું બીજું કોઈ પદ નથી<emphasis effect="italics">x</emphasis>.</para>
</solution>
</exercise>
</example>
<note id="fs-id1170654932190" class="try">
<exercise id="fs-id1170655163424">
<problem id="fs-id1170655163426">
<para id="fs-id1170655163428">સજાતીય પદો ઓળખો: <m:math><m:mrow><m:mn>9</m:mn><m:mo>,</m:mo></m:mrow></m:math> <m:math><m:mrow><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mo>,</m:mo></m:mrow></m:math> <m:math><m:mrow><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo></m:mrow></m:math> <m:math><m:mrow><m:mn>8</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mo>,</m:mo></m:mrow></m:math> <m:math><m:mrow><m:mn>15</m:mn><m:mo>,</m:mo></m:mrow></m:math> <m:math><m:mrow><m:mn>9</m:mn><m:mi>y</m:mi><m:mo>,</m:mo></m:mrow></m:math> <m:math><m:mrow><m:mn>11</m:mn><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654932121">
<para id="fs-id1170654936607">9 અને 15, <m:math><m:mrow><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> અને <m:math><m:mrow><m:mn>11</m:mn><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo></m:mrow></m:math> <m:math><m:mrow><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math> અને <m:math><m:mrow><m:mn>8</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170654942110" class="try">
<exercise id="fs-id1170654942820">
<problem id="fs-id1170654942822">
<para id="fs-id1170654942824">સજાતીય પદો ઓળખો: <m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mo>,</m:mo></m:mrow></m:math> <m:math><m:mrow><m:mn>8</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo></m:mrow></m:math> 19, <m:math><m:mrow><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo></m:mrow></m:math> 24, <m:math><m:mrow><m:mn>6</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655162912">
<para id="fs-id1170654936398">19 અને 24, <m:math><m:mrow><m:mn>8</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> અને <m:math><m:mrow><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo></m:mrow></m:math> <m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math> અને <m:math><m:mrow><m:mn>6</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<para id="fs-id1170655174214">પદોનો સરવાળો કે બાદબાકી કરવાથી પદાવલી બને છે. <m:math><m:mrow><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mo>,</m:mo></m:mrow></m:math> પદાવલીમાં (જુઓ <link target-id="fs-id1170655171250" />), ત્રણ પદો છે: <m:math><m:mrow><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>,</m:mo></m:mrow></m:math> અને 8.</para>
<example id="fs-id1170654944433">
<exercise id="fs-id1170654944435">
<problem id="fs-id1170654940658">
<para id="fs-id1170654940660">દરેક પદાવલીનાં પદો ઓળખો.</para>
<list id="fs-id1166422654836" list-type="enumerated" number-style="arabic" class="circled">
<item><span class="token">ⓐ</span> <m:math><m:mrow><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>12</m:mn></m:mrow></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mrow><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>y</m:mi></m:mrow></m:math></item>
</list>
</problem>
<solution id="fs-id1170654941538">
<title>ઉકેલ</title>
<list id="fs-id1166422254836" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> આ પદાવલીનાં પદો <m:math><m:mrow><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>12</m:mn></m:mrow></m:math> છે <m:math><m:mrow><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo></m:mrow></m:math> 7<emphasis effect="italics">x</emphasis>અને 12.<newline /><newline />
</item>
<item><span class="token">ⓑ</span> આ પદાવલીનાં પદો <m:math><m:mrow><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>y</m:mi></m:mrow></m:math> છે 8<emphasis effect="italics">x</emphasis> અને 3<emphasis effect="italics">y</emphasis>.</item></list>
</solution>
</exercise>
</example>
<note id="fs-id1170654944577" class="try">
<exercise id="fs-id1170654944216">
<problem id="fs-id1170654944218">
<para id="fs-id1170654944220">આ પદાવલીનાં પદો ઓળખો: <m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>17</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654942970">
<para id="fs-id1170654942642"><m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>,</m:mo><m:mn>17</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170654943428" class="try">
<exercise id="fs-id1170654943433">
<problem id="fs-id1170654943435">
<para id="fs-id1170654943822">આ પદાવલીનાં પદો ઓળખો: <m:math><m:mrow><m:mn>5</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>y</m:mi><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654940732">
<para id="fs-id1170654940734">5<emphasis effect="italics">x</emphasis>, 2<emphasis effect="italics">y</emphasis></para>
</solution>
</exercise>
</note>
<para id="fs-id1170654943110">પદાવલીમાં સજાતીય પદો હોય તો તેમને ભેગાં કરીને પદાવલીને સાદું રૂપ આપી શકાય છે. તમારા મત મુજબ <m:math><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>x</m:mi></m:mrow></m:math> નું સાદું રૂપ શું થાય? જો તમે 12<emphasis effect="italics">x</emphasis> વિચાર્યું હોય તો તમે સાચા છો!</para>
<equation id="fs-id1170654940806" class="unnumbered"><label /><m:math><m:mtable><m:mtr><m:mtd columnalign="center"><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>x</m:mi></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>x</m:mi><m:mspace width="1em" /><m:mo>+</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>x</m:mi><m:mspace width="1em" /><m:mo>+</m:mo><m:mi>x</m:mi></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mn>12</m:mn><m:mi>x</m:mi></m:mtd></m:mtr></m:mtable></m:math></equation>
<para id="fs-id1170654936709">સહગુણકોનો સરવાળો કરો અને એ જ ચલ રાખો. ચલ <emphasis effect="italics">x</emphasis> ગમે તે દર્શાવતો હોય—કોઈ વસ્તુના 4માં એ જ વસ્તુનાં વધુ 7 અને પછી વધુ 1 ઉમેરીએ તો તે વસ્તુઓની સંખ્યા 12 થાય. ઉદાહરણ તરીકે 4 નારંગી વત્તા 7 નારંગી વત્તા 1 નારંગી બરાબર 12 નારંગી. તેની પાછળના ગણિતીય ગુણધર્મોની ચર્ચા આગળ કરીશું.</para>
<para id="fs-id1170654940628">સાદું રૂપ આપો: <m:math><m:mrow><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>x</m:mi><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id1170654936258">સહગુણકોનો સરવાળો કરો. 12<emphasis effect="italics">x</emphasis></para>
<example id="fs-id1170654940588">
<title>સજાતીય પદો કેવી રીતે ભેગાં કરવા</title>
<exercise id="fs-id1170654940590">
<problem id="fs-id1170654940592">
<para id="fs-id1170654941823">સાદું રૂપ આપો: <m:math><m:mrow><m:mn>2</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mo>+</m:mo><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654941968">
<title>ઉકેલ</title>
<media id="fs-id1170655224688" alt="આ ખંડમાં ડાબે “પગલું 1. સજાતીય પદો ઓળખો” સૂચના અને જમણે પદાવલીની બે હરોળ છે. પહેલી હરોળમાં 2x² + 3x + 7 + x² + 4x + 5 છે. બીજી હરોળમાં એ જ પદાવલી રંગોથી વર્ગીકૃત છે: 2x² અને x² લાલ; 3x અને 4x વાદળી; 7 અને 5 લીલા છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_02_014a_new.jpg" />
</media>
<media id="fs-id1170653192952" alt="ડાબે બીજી સૂચના: “પગલું 2. પદાવલીને ફરી ગોઠવો જેથી સજાતીય પદો સાથે આવે.” સામે મૂળ પદાવલી સજાતીય પદોને બાજુબાજુ રાખીને છે: લાલ રંગમાં 2x² + x², વાદળી રંગમાં + 3x + 4x અને લીલા રંગમાં + 7 + 5.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_02_014b_new.jpg" />
</media>
<media id="fs-id1170655041754" alt="ડાબે ત્રીજી સૂચના: “પગલું 3. સજાતીય પદો ભેગાં કરો.” સામે ભેગાં કરેલા સજાતીય પદોની પદાવલી છે: લાલ રંગમાં 3x², વાદળી રંગમાં + 7x અને લીલા રંગમાં + 12.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_02_014c_new.jpg" />
</media>
</solution>
</exercise>
</example>
<note id="fs-id1170655124954" class="try">
<exercise id="fs-id1170655165458">
<problem id="fs-id1170655165461">
<para id="fs-id1170655165463">સાદું રૂપ આપો: <m:math><m:mrow><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn><m:mo>+</m:mo><m:mn>7</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>9</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654944751">
<para id="fs-id1170654944753"><m:math><m:mrow><m:mn>10</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>16</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>17</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170655106279" class="try">
<exercise id="fs-id1170655106283">
<problem id="fs-id1170655206781">
<para id="fs-id1170655206783">સાદું રૂપ આપો: <m:math><m:mrow><m:mn>4</m:mn><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>8</m:mn><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654924801">
<para id="fs-id1170654936363"><m:math><m:mrow><m:mn>12</m:mn><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>9</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170655205372" class="howto">
<title>સજાતીય પદો ભેગાં કરો.</title>
<list id="fs-id1166425014151" list-type="enumerated" number-style="arabic" class="stepwise">
<item>સજાતીય પદો ઓળખો.</item>
<item>પદાવલીને ફરી ગોઠવો જેથી સજાતીય પદો સાથે આવે.</item>
<item>સજાતીય પદોના દરેક જૂથમાં સહગુણકોનો સરવાળો કે બાદબાકી કરો અને એ જ ચલ રાખો.</item>
</list>
</note>
</section>
<section id="fs-id1170654942537">
<title>અંગ્રેજી શબ્દસમૂહને બીજગણિતીય પદાવલીમાં ફેરવો</title>
<para id="fs-id1170655163394">છેલ્લા વિભાગમાં આપણે બીજગણિતમાં વપરાતા અનેક ક્રિયાસંકેતોની યાદી બનાવી અને પછી પદાવલીઓ તથા સમીકરણોને અંગ્રેજી શબ્દસમૂહો અને વાક્યોમાં ફેરવ્યાં. હવે આ પ્રક્રિયા ઉલટી કરીશું: અંગ્રેજી શબ્દસમૂહોને બીજગણિતીય પદાવલીઓમાં ફેરવીશું. અગાઉ ચર્ચેલા સંકેતો અને ચલો તેમાં મદદ કરશે. <link target-id="fs-id1170655166578" /> માં તેમનો સાર આપ્યો છે.</para>
<table id="fs-id1170655166578" aria-label="આ કોષ્ટકમાં પાંચ હરોળ અને ત્રણ સ્તંભ છે. પહેલી મથાળાની હરોળ છે. મથાળાં “ક્રિયા”, “શબ્દસમૂહ” અને “પદાવલી” છે. સરવાળાની હરોળમાં શબ્દસમૂહો a વત્તા b; a અને bનો સરવાળો; aમાં bનો વધારો; a કરતાં b વધારે; a અને bનો કુલ સરવાળો; અને aમાં b ઉમેરેલા છે. પદાવલી a + b છે. બાદબાકીની હરોળમાં a ઓછા b; a અને bનો તફાવત; aમાં bનો ઘટાડો; a કરતાં b ઓછું; અને aમાંથી b બાદ કરેલા છે. પદાવલી a − b છે. ગુણાકારની હરોળમાં a ગુણ્યા b; a અને bનો ગુણાકાર; અને aનું બમણું છે. પદાવલીઓ a·b; ab; a(b); (a)(b); અને બમણા a માટે 2a છે. ભાગાકારની હરોળમાં a ભાગ્યા b; a અને bનું ભાગફળ; a અને bનો ગુણોત્તર; અને aને b વડે ભાગેલા છે. પદાવલીઓ a ÷ b; a/b; ઉપર a અને નીચે bનો અપૂર્ણાંક; અને લાંબા ભાગાકારમાં બહાર b તથા અંદર a છે.">
<tgroup cols="3">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<colspec colnum="3" colname="c3" />
<thead>
<row valign="top">
<entry valign="middle" align="left">ક્રિયા</entry>
<entry valign="middle" align="left">શબ્દસમૂહ</entry>
<entry valign="middle" align="left">પદાવલી</entry>
</row>
</thead>
<tbody>
<row valign="top">
<entry valign="top" align="left">સરવાળો</entry>
<entry valign="top" align="left"><emphasis effect="italics">a</emphasis> વત્તા <emphasis effect="italics">b</emphasis><newline />
<m:math><m:mi>a</m:mi></m:math> અને <emphasis effect="italics">b</emphasis> નો સરવાળો<newline />
<m:math><m:mrow><m:mi>a</m:mi></m:mrow></m:math> માં <emphasis effect="italics">b</emphasis> નો વધારો<newline />
<emphasis effect="italics">b</emphasis> જેટલો વધારો ધરાવતું <m:math><m:mi>a</m:mi></m:math><newline />
<m:math><m:mi>a</m:mi></m:math> અને <emphasis effect="italics">b</emphasis> નો કુલ સરવાળો<newline />
<emphasis effect="italics">b</emphasis> ઉમેરેલું હોય તેવું <m:math><m:mi>a</m:mi></m:math></entry>
<entry valign="top" align="left"><m:math><m:mrow><m:mi>a</m:mi><m:mo>+</m:mo><m:mi>b</m:mi></m:mrow></m:math></entry>
</row>
<row valign="top">
<entry valign="top" align="left">બાદબાકી</entry>
<entry valign="top" align="left"><m:math><m:mi>a</m:mi></m:math> ઓછા <emphasis effect="italics">b</emphasis><newline />
<m:math><m:mi>a</m:mi></m:math> અને <emphasis effect="italics">b</emphasis> વચ્ચેનો તફાવત<newline />
<m:math><m:mi>a</m:mi></m:math> માંથી <emphasis effect="italics">b</emphasis> ઘટાડેલું<newline />
<emphasis effect="italics">b</emphasis> જેટલો ઘટાડો ધરાવતું <m:math><m:mi>a</m:mi></m:math><newline />
<emphasis effect="italics">b</emphasis> બાદ કરેલું હોય તેવું <m:math><m:mi>a</m:mi></m:math></entry>
<entry valign="top" align="left"><m:math><m:mrow><m:mi>a</m:mi><m:mo>−</m:mo><m:mi>b</m:mi></m:mrow></m:math></entry>
</row>
<row valign="top">
<entry valign="top" align="left">ગુણાકાર</entry>
<entry valign="top" align="left"><m:math><m:mi>a</m:mi></m:math> ગુણ્યા <emphasis effect="italics">b</emphasis><newline />
<m:math><m:mi>a</m:mi></m:math> અને <emphasis effect="italics">b</emphasis> નો ગુણાકાર<newline />
<m:math><m:mi>a</m:mi></m:math> નું બમણું</entry>
<entry valign="top" align="left"><m:math><m:mrow><m:mi>a</m:mi><m:mo>·</m:mo><m:mi>b</m:mi><m:mo>,</m:mo><m:mi>a</m:mi><m:mi>b</m:mi><m:mo>,</m:mo><m:mi>a</m:mi><m:mo stretchy="false">(</m:mo><m:mi>b</m:mi><m:mo stretchy="false">)</m:mo><m:mo>,</m:mo><m:mo stretchy="false">(</m:mo><m:mi>a</m:mi><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mi>b</m:mi><m:mo stretchy="false">)</m:mo></m:mrow></m:math><newline /><newline />
2<emphasis effect="italics">a</emphasis></entry>
</row>
<row valign="top">
<entry valign="top" align="left">ભાગાકાર</entry>
<entry valign="top" align="left"><m:math><m:mi>a</m:mi></m:math> ભાગ્યા <emphasis effect="italics">b</emphasis><newline />
<m:math><m:mi>a</m:mi></m:math> અને <emphasis effect="italics">b</emphasis> નું ભાગફળ<newline />
<m:math><m:mi>a</m:mi></m:math> અને <emphasis effect="italics">b</emphasis> નો ગુણોત્તર<newline />
<emphasis effect="italics">b</emphasis> વડે ભાગેલું હોય તેવું <m:math><m:mi>a</m:mi></m:math></entry>
<entry valign="top" align="left"><m:math><m:mrow><m:mi>a</m:mi><m:mo>÷</m:mo><m:mi>b</m:mi><m:mo>,</m:mo><m:mi>a</m:mi><m:mtext>/</m:mtext><m:mi>b</m:mi><m:mo>,</m:mo><m:mfrac><m:mi>a</m:mi><m:mi>b</m:mi></m:mfrac><m:mo>,</m:mo><m:mi>b</m:mi><m:menclose notation="longdiv"><m:mi>a</m:mi></m:menclose></m:mrow></m:math></entry>
</row>
</tbody>
</tgroup>
</table>
<para id="fs-id1170655190784">ચાર ક્રિયાઓ વાપરતા આ શબ્દસમૂહોને ધ્યાનથી જુઓ:</para>
<media id="fs-id1170655105929" alt="ચાર શબ્દસમૂહ છે. પહેલો “a અને bનો સરવાળો”, બીજો “a અને bનો તફાવત”, ત્રીજો “a અને bનો ગુણાકાર” અને ચોથો “a અને bનું ભાગફળ” છે. દરેકમાં અંગ્રેજી “of” અને “and”ને અનુરૂપ સંબંધદર્શક શબ્દો લાલ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_02_015_img_new.jpg" />
</media>
<para id="fs-id1170655227649">દરેક શબ્દસમૂહ બે સંખ્યાઓ પર ક્રિયા કરવાનું કહે છે. સંખ્યાઓ શોધવા અંગ્રેજીમાં <emphasis effect="italics">“of”</emphasis> અને <emphasis effect="italics">“and”</emphasis> શબ્દો શોધો.</para>
<example id="fs-id1170655354222">
<exercise id="fs-id1170655354224">
<problem id="fs-id1170655355492">
<para id="fs-id1170655355494">દરેક અંગ્રેજી શબ્દસમૂહને બીજગણિતીય પદાવલીમાં ફેરવો: <span class="token">ⓐ</span> તફાવત: <m:math><m:mrow><m:mn>17</m:mn><m:mi>x</m:mi></m:mrow></m:math> અને <m:math><m:mn>5</m:mn></m:math>; <span class="token">ⓑ</span> ભાગફળ: <m:math><m:mrow><m:mn>10</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> અને <m:math><m:mn>7</m:mn><m:mo>.</m:mo></m:math></para>
</problem>
<solution id="fs-id1170655117312">
<title>ઉકેલ</title>
<list id="fs-id1166425197914" list-type="enumerated" number-style="arabic" class="circled">
<item><span class="token">ⓐ</span> મુખ્ય શબ્દ <emphasis effect="italics">difference (તફાવત)</emphasis> છે, જે બતાવે છે કે ક્રિયા બાદબાકી છે. બાદ કરવાની સંખ્યાઓ શોધવા અંગ્રેજીમાં <emphasis effect="italics">“of”</emphasis> અને <emphasis effect="italics">“and”</emphasis> શબ્દો જુઓ.<newline />
<media id="fs-id1170655127844" alt="“17x અને 5નો તફાવત” શબ્દસમૂહમાં અંગ્રેજી “of” અને “and” લાલ છે. તેની નીચે “17x ઓછા 5” અને અંતે 17x − 5 લખ્યું છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_02_016_img_new.jpg" />
</media><newline /><newline /></item>
<item><span class="token">ⓑ</span> મુખ્ય શબ્દ “quotient—ભાગફળ” છે, જે બતાવે છે કે ક્રિયા ભાગાકાર છે.</item>
</list>
<media id="fs-id1170655111048" alt="મૂળ અંગ્રેજી શબ્દસમૂહ “10x² અને 7નું ભાગફળ” દર્શાવે છે; તેમાં “of” અને “and” લાલ છે. તેની નીચે 10x²ને 7 વડે ભાગવાની સૂચના અને અંતે 10x² ÷ 7 છે. 10x²નો અર્થ 10 ગુણ્યા xનો વર્ગ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_02_018_img_new.jpg" />
</media>
<para id="fs-id1167265670725">આને આ રીતે પણ લખી શકાય: <m:math><m:mrow><m:mn>10</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mtext>/</m:mtext><m:mn>7</m:mn><m:mspace width="0.2em" /><m:mtext>અથવા</m:mtext><m:mspace width="0.2em" /><m:mfrac><m:mrow><m:mn>10</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow><m:mn>7</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</solution>
</exercise>
</example>
<note id="fs-id1170655163327" class="try">
<exercise id="fs-id1170655163331">
<problem id="fs-id1170655163333">
<para id="fs-id1170655208557">અંગ્રેજી શબ્દસમૂહને બીજગણિતીય પદાવલીમાં ફેરવો: <span class="token">ⓐ</span> <m:math><m:mrow><m:mn>14</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> અને 13 વચ્ચેનો તફાવત; <span class="token">ⓑ</span> 12<emphasis effect="italics">x</emphasis> અને 2નું ભાગફળ.</para>
</problem>
<solution id="fs-id1170655215532">
<para id="fs-id1170655215534"><span class="token">ⓐ</span> <m:math><m:mrow><m:mn>14</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>13</m:mn></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mn>12</m:mn><m:mi>x</m:mi><m:mo>÷</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170655351939" class="try">
<exercise id="fs-id1170655161309">
<problem id="fs-id1170655161311">
<para id="fs-id1170655161313">અંગ્રેજી શબ્દસમૂહને બીજગણિતીય પદાવલીમાં ફેરવો: <span class="token">ⓐ</span> સરવાળો: <m:math><m:mrow><m:mn>17</m:mn><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> અને <m:math><m:mrow><m:mn>19</m:mn></m:mrow></m:math>; <span class="token">ⓑ</span> ગુણાકારનું પરિણામ: <m:math><m:mn>7</m:mn></m:math> અને <m:math><m:mi>y</m:mi><m:mo>.</m:mo></m:math></para>
</problem>
<solution id="fs-id1170655106926">
<para id="fs-id1170655106928"><span class="token">ⓐ</span> <m:math><m:mrow><m:mn>17</m:mn><m:msup><m:mi>y</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>19</m:mn></m:mrow></m:math> <span class="token">ⓑ</span> 7<emphasis effect="italics">y</emphasis></para>
</solution>
</exercise>
</note>
<para id="fs-id1170655207371">આઠ વર્ષ પછી તમારી ઉંમર કેટલી હશે? હાલની ઉંમર કરતાં આઠ વર્ષ વધારે કેટલી ઉંમર થાય? શું તમે હાલની ઉંમરમાં 8 ઉમેર્યા? “આઠ વધારે” એટલે હાલની ઉંમરમાં 8 ઉમેરેલા. સાત વર્ષ પહેલાં તમારી ઉંમર કેટલી હતી? તે હાલની ઉંમર કરતાં 7 વર્ષ ઓછી છે. હાલની ઉંમરમાંથી 7 બાદ કરો. “સાત ઓછું” એટલે હાલની ઉંમરમાંથી 7 બાદ કરેલા.</para>

<example id="fs-id1170655207375">
<exercise id="fs-id1170655166193">
<problem id="fs-id1170654972284">
<para id="fs-id1170654972286">અંગ્રેજી શબ્દસમૂહને બીજગણિતીય પદાવલીમાં ફેરવો: <span class="token">ⓐ</span> <emphasis effect="italics">y</emphasis> કરતાં સત્તર વધારે; <span class="token">ⓑ</span> આ પદાવલીથી નવ ઓછું: <m:math><m:mrow><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655229585">
<title>ઉકેલ</title>
<list id="fs-id1166424865853" list-type="enumerated" number-style="arabic" class="circled">
<item><span class="token">ⓐ</span> મુખ્ય શબ્દો છે <emphasis effect="italics">કરતાં વધારે.</emphasis> તેઓ જણાવે છે કે ક્રિયા સરવાળો છે. <emphasis effect="italics">કરતાં વધારે</emphasis> નો અર્થ “માં ઉમેરેલું” થાય છે.<newline />
<equation id="fs-id1166424900029" class="unnumbered"><label /><m:math><m:mtable><m:mtr><m:mtd columnalign="center"><m:mtext>આ સંખ્યાથી સત્તર વધારે:</m:mtext><m:mspace width="0.2em" /><m:mi>y</m:mi></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mtext>આ સંખ્યામાં સત્તર ઉમેરો:</m:mtext><m:mspace width="0.2em" /><m:mi>y</m:mi></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>17</m:mn></m:mtd></m:mtr></m:mtable></m:math></equation></item>
<item><span class="token">ⓑ</span> મુખ્ય શબ્દો છે <emphasis effect="italics">કરતાં નાનું</emphasis>. તેઓ જણાવે છે કે બાદબાકી કરવાની છે. <emphasis effect="italics">કરતાં ઓછું</emphasis> નો અર્થ “માંથી બાદ કરેલું” થાય છે.<newline />
<equation id="fs-id1166424997640" class="unnumbered"><label /><m:math><m:mtable><m:mtr /><m:mtr /><m:mtr /><m:mtr><m:mtd columnalign="center"><m:mspace width="5em" /><m:mtext>આ પદાવલીથી નવ ઓછું:</m:mtext><m:mspace width="0.2em" /><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mspace width="5em" /><m:mtext>આ પદાવલીમાંથી નવ બાદ કરો:</m:mtext><m:mspace width="0.2em" /><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mspace width="5em" /><m:mn>9</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>9</m:mn></m:mtd></m:mtr></m:mtable></m:math></equation></item>
</list>
</solution>
</exercise>
</example>
<note id="fs-id1170655204422" class="try">
<exercise id="fs-id1170655204426">
<problem id="fs-id1170655204428">
<para id="fs-id1170655204430">અંગ્રેજી શબ્દસમૂહને બીજગણિતીય પદાવલીમાં ફેરવો: <span class="token">ⓐ</span> <m:math><m:mi>x</m:mi></m:math> કરતાં અગિયાર વધારે; <span class="token">ⓑ</span> આ પદાવલીથી ચૌદ ઓછું: <m:math><m:mrow><m:mn>11</m:mn><m:mi>a</m:mi><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655200450">
<para id="fs-id1170655200452"><span class="token">ⓐ</span> <m:math><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>11</m:mn></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mn>11</m:mn><m:mi>a</m:mi><m:mo>−</m:mo><m:mn>14</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170655164739" class="try">
<exercise id="fs-id1170655164744">
<problem id="fs-id1170655164746">
<para id="fs-id1170655164748">અંગ્રેજી શબ્દસમૂહને બીજગણિતીય પદાવલીમાં ફેરવો: <span class="token">ⓐ</span> <emphasis effect="italics">z</emphasis> કરતાં 13 વધારે; <span class="token">ⓑ</span> 8<emphasis effect="italics">x</emphasis> કરતાં 18 ઓછું.</para>
</problem>
<solution id="fs-id1170655129023">
<para id="fs-id1170655129025"><span class="token">ⓐ</span> <m:math><m:mrow><m:mi>z</m:mi><m:mo>+</m:mo><m:mn>13</m:mn></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>18</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<example id="fs-id1170655104992">
<exercise id="fs-id1170655104994">
<problem id="fs-id1170655104997">
<para id="fs-id1170655104999">અંગ્રેજી શબ્દસમૂહને બીજગણિતીય પદાવલીમાં ફેરવો: <span class="token">ⓐ</span> <emphasis effect="italics">m</emphasis> અને <emphasis effect="italics">n</emphasis> ના સરવાળાનું 5 ગણું; <span class="token">ⓑ</span> 5<emphasis effect="italics">m</emphasis> અને <emphasis effect="italics">n</emphasis> નો સરવાળો.</para>
</problem>
<solution id="fs-id1170655190682">
<title>ઉકેલ</title>
<para id="fs-id1170655114108">અહીં ક્રિયા દર્શાવતા બે શબ્દો છે—<emphasis effect="italics">ગુણ્યા</emphasis> ગુણાકાર કરવા કહે છે અને <emphasis effect="italics">સરવાળો</emphasis> ઉમેરવા કહે છે.</para>
<list id="fs-id1166424761248" list-type="enumerated" number-style="arabic" class="circled">
<item><span class="token">ⓐ</span> સરવાળાનું 5 ગણું કરવાનું હોવાથી સરવાળાની આસપાસ કૌંસ જોઈએ: <emphasis effect="italics">m</emphasis> અને <emphasis effect="italics">n</emphasis>, <m:math><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mi>m</m:mi><m:mo>+</m:mo><m:mi>n</m:mi></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math> આ કૌંસથી પહેલાં સરવાળો જ કરવો પડે છે. (ક્રિયાઓનો ક્રમ યાદ રાખો.)<newline />
<equation id="fs-id1166420322683" class="unnumbered"><label /><m:math><m:mtable><m:mtr /><m:mtr /><m:mtr><m:mtd columnalign="center"><m:mtext>સરવાળાનું પાંચ ગણું:</m:mtext><m:mspace width="0.2em" /><m:mi>m</m:mi><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mi>n</m:mi></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mn>5</m:mn><m:mspace width="0.2em" /><m:mo stretchy="false">(</m:mo><m:mi>m</m:mi><m:mo>+</m:mo><m:mi>n</m:mi><m:mo stretchy="false">)</m:mo></m:mtd></m:mtr></m:mtable></m:math></equation></item>
<item><span class="token">ⓑ</span> સરવાળો ઓળખવા અંગ્રેજી શબ્દસમૂહમાં “of” અને “and” જોઈએ. અહીં સરવાળો <emphasis effect="italics">“of”</emphasis> પછીના 5<emphasis effect="italics">m</emphasis> અને <emphasis effect="italics">n</emphasis> નો છે.<newline />
<equation id="fs-id1166424760024" class="unnumbered"><label /><m:math><m:mtable><m:mtr><m:mtd columnalign="center"><m:mtext>સરવાળો</m:mtext><m:mspace width="0.2em" /><m:mtext>of</m:mtext><m:mspace width="0.2em" /><m:mtext>પાંચ ગણું</m:mtext><m:mspace width="0.2em" /><m:mi>m</m:mi><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mi>n</m:mi></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mn>5</m:mn><m:mi>m</m:mi><m:mo>+</m:mo><m:mi>n</m:mi></m:mtd></m:mtr></m:mtable></m:math></equation></item>
</list>
</solution>
</exercise>
</example>
<note id="fs-id1170655171042" class="try">
<exercise id="fs-id1170655177754">
<problem id="fs-id1170655177756">
<para id="fs-id1170655177758">અંગ્રેજી શબ્દસમૂહને બીજગણિતીય પદાવલીમાં ફેરવો: <span class="token">ⓐ</span> <emphasis effect="italics">p</emphasis> અને <emphasis effect="italics">q</emphasis> ના સરવાળાનું 4 ગણું; <span class="token">ⓑ</span> 4<emphasis effect="italics">p</emphasis> અને <emphasis effect="italics">q</emphasis> નો સરવાળો.</para>
</problem>
<solution id="fs-id1170655197238">
<para id="fs-id1170655197241"><span class="token">ⓐ</span> <m:math><m:mrow><m:mn>4</m:mn><m:mrow><m:mo>(</m:mo><m:mrow><m:mi>p</m:mi><m:mo>+</m:mo><m:mi>q</m:mi></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mn>4</m:mn><m:mi>p</m:mi><m:mo>+</m:mo><m:mi>q</m:mi></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170654989451" class="try">
<exercise id="fs-id1170655113787">
<problem id="fs-id1170655113789">
<para id="fs-id1170655113791">અંગ્રેજી શબ્દસમૂહને બીજગણિતીય પદાવલીમાં ફેરવો: <span class="token">ⓐ</span> 2<emphasis effect="italics">x</emphasis> અને 8 વચ્ચેનો તફાવત; <span class="token">ⓑ</span> <emphasis effect="italics">x</emphasis> અને 8 વચ્ચેના તફાવતનું 2 ગણું.</para>
</problem>
<solution id="fs-id1170655157598">
<para id="fs-id1170655099451"><span class="token">ⓐ</span> <m:math><m:mrow><m:mn>2</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>8</m:mn></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mn>2</m:mn><m:mrow><m:mo>(</m:mo><m:mrow><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>8</m:mn></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<para id="fs-id1170655121539">આ અભ્યાસક્રમમાં આગળ ઉપયોગવાળા પ્રશ્નો ઉકેલવા બીજગણિતની કુશળતાઓ લાગુ કરીશું. પહેલું પગલું અંગ્રેજી શબ્દસમૂહને બીજગણિતીય પદાવલીમાં ફેરવવાનું હશે. આગળનાં બે ઉદાહરણોમાં તે કેવી રીતે કરવું તે જોઈશું.</para>
<example id="fs-id1170655121545"><exercise id="fs-id1170655121547">
<problem id="fs-id1170655121549">
<para id="fs-id1170655120589">લંબચોરસની પહોળાઈ તેની લંબાઈ કરતાં 6 ઓછી છે. ધારો <emphasis effect="italics">l</emphasis> લંબચોરસની લંબાઈ દર્શાવે છે. લંબચોરસની પહોળાઈ માટે પદાવલી લખો.</para>
</problem>
<solution id="fs-id1170655162128">
<title>ઉકેલ</title>
<table id="eip-72" class="unnumbered unstyled" summary="આ કોષ્ટક “લંબાઈ કરતાં 6 ઓછું” શબ્દસમૂહને l − 6 બીજગણિતીય પદાવલીમાં ફેરવવાની પગલાંવાર પ્રક્રિયા બતાવે છે.">
<tgroup cols="2"><tbody>
  <row>
    <entry>લંબચોરસની પહોળાઈ વિશે શબ્દસમૂહ લખો.</entry>
    <entry>લંબાઈ કરતાં 6 ઓછું</entry>
  </row>
  <row>
    <entry>“લંબાઈ” માટે <m:math><m:mi>l</m:mi></m:math> મૂકો.</entry>
    <entry><m:math><m:mi>l</m:mi></m:math> કરતાં 6 ઓછું</entry>
  </row>
  <row>
    <entry>“કરતાં ઓછું”ને “માંથી બાદ કરેલું” તરીકે ફરી લખો.</entry>
    <entry><m:math><m:mi>l</m:mi></m:math> માંથી 6 બાદ કરેલું</entry>
  </row>
  <row>
    <entry>શબ્દસમૂહને બીજગણિતમાં ફેરવો.</entry>
    <entry><m:math><m:mi>l</m:mi><m:mo>−</m:mo><m:mn>6</m:mn></m:math></entry>
  </row>
</tbody>


</tgroup>
</table>

</solution>
</exercise></example><note id="fs-id1170655332442" class="try">
<exercise id="fs-id1170655332446">
<problem id="fs-id1170655332449">
<para id="fs-id1170655190394">લંબચોરસની લંબાઈ તેની પહોળાઈ કરતાં 7 ઓછી છે. ધારો <emphasis effect="italics">w</emphasis> લંબચોરસની પહોળાઈ દર્શાવે છે. લંબચોરસની લંબાઈ માટે પદાવલી લખો.</para>
</problem>
<solution id="fs-id1170655190404">
<para id="fs-id1170654937336"><m:math><m:mrow><m:mi>w</m:mi><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170655270004" class="try">
<exercise id="fs-id1170655270008">
<problem id="fs-id1170655270010">
<para id="fs-id1170655270012">લંબચોરસની પહોળાઈ તેની લંબાઈ કરતાં 6 ઓછી છે. ધારો <emphasis effect="italics">l</emphasis> લંબચોરસની લંબાઈ દર્શાવે છે. લંબચોરસની પહોળાઈ માટે પદાવલી લખો.</para>
</problem>
<solution id="fs-id1170655207305">
<para id="fs-id1170655207307"><m:math><m:mrow><m:mi>l</m:mi><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<example id="fs-id1170655189882"><exercise id="fs-id1170655189045">
<problem id="fs-id1170655189047">
<para id="fs-id1170655189049">જૂન પાસે થેલીમાં ડાઇમ અને ક્વાર્ટર સિક્કા છે. ડાઇમની સંખ્યા ક્વાર્ટરની સંખ્યાના ચાર ગણાથી ત્રણ ઓછી છે. ધારો <emphasis effect="italics">q</emphasis> ક્વાર્ટરની સંખ્યા દર્શાવે છે. ડાઇમની સંખ્યા માટે પદાવલી લખો.</para>
</problem>
<solution id="fs-id1170655352055">
<title>ઉકેલ</title>
<table id="eip-470" class="unnumbered unstyled" summary="ડાઇમ વિશેના શબ્દસમૂહને બીજગણિતીય પદાવલીમાં ફેરવવાની પગલાંવાર પ્રક્રિયા.">
<tgroup cols="2"><tbody>
  <row>
    <entry>ડાઇમની સંખ્યા વિશે શબ્દસમૂહ લખો.</entry>
    <entry>ક્વાર્ટરની સંખ્યાના ચાર ગણાથી ત્રણ ઓછું</entry>
  </row>
  <row>
    <entry>ક્વાર્ટરની સંખ્યા માટે <m:math><m:mi>q</m:mi></m:math> મૂકો.</entry>
    <entry>4 ગુણ્યા <m:math><m:mi>q</m:mi></m:math> કરતાં 3 ઓછું</entry>
</row>
  <row>
    <entry>“4 ગુણ્યા <m:math><m:mi>q</m:mi></m:math>”ને બીજગણિતીય પદાવલીમાં ફેરવો.</entry>
    <entry><m:math><m:mn>4</m:mn><m:mi>q</m:mi></m:math> કરતાં 3 ઓછું</entry>
  </row>
<row>
    <entry>શબ્દસમૂહને બીજગણિતમાં ફેરવો.</entry>
    <entry><m:math><m:mn>4</m:mn><m:mi>q</m:mi><m:mo>−</m:mo><m:mn>3</m:mn></m:math></entry>
  </row>
</tbody>

</tgroup>
</table>
</solution>
</exercise>
</example><note id="fs-id1170654919848" class="try">
<exercise id="fs-id1170654919852">
<problem id="fs-id1170654919854">
<para id="fs-id1170654919856">જેફ્રીના ખિસ્સામાં ડાઇમ અને ક્વાર્ટર છે. ડાઇમની સંખ્યા ક્વાર્ટરની સંખ્યાના ચાર ગણાથી આઠ ઓછી છે. ધારો <emphasis effect="italics">q</emphasis> ક્વાર્ટરની સંખ્યા દર્શાવે છે. ડાઇમની સંખ્યા માટે પદાવલી લખો.</para>
</problem>
<solution id="fs-id1170655195241">
<para id="fs-id1170655195243"><m:math><m:mrow><m:mn>4</m:mn><m:mi>q</m:mi><m:mo>−</m:mo><m:mn>8</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170655020555" class="try">
<exercise id="fs-id1170655020559">
<problem id="fs-id1170655020561">
<para id="fs-id1170655020563">લોરેનની થેલીમાં ડાઇમ અને નિકલ સિક્કા છે. ડાઇમની સંખ્યા નિકલની સંખ્યાના સાત ગણાથી ત્રણ વધારે છે. ધારો <emphasis effect="italics">n</emphasis> નિકલની સંખ્યા દર્શાવે છે. ડાઇમની સંખ્યા માટે પદાવલી લખો.</para>
</problem>
<solution id="fs-id1170654940350">
<para id="fs-id1170654940352"><m:math><m:mrow><m:mn>7</m:mn><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1170655188891" class="key-concepts">
<title>મુખ્ય ખ્યાલો</title>
<list id="fs-id1170655221346" list-type="bulleted" bullet-style="bullet">
<item><emphasis effect="bold">સંકેતલિપિ                                             પરિણામ છે…</emphasis><newline /><newline />
<m:math><m:mtable><m:mtr><m:mtd columnalign="left"><m:mspace width="1.8em" /><m:mo>∘</m:mo><m:mspace width="0.6em" /><m:mi>a</m:mi><m:mo>+</m:mo><m:mi>b</m:mi></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mspace width="3em" /><m:mtext>સરવાળો:</m:mtext><m:mspace width="0.2em" /><m:mi>a</m:mi><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mi>b</m:mi></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mspace width="1.8em" /><m:mo>∘</m:mo><m:mspace width="0.6em" /><m:mi>a</m:mi><m:mo>−</m:mo><m:mi>b</m:mi></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mspace width="3em" /><m:mtext>તફાવત:</m:mtext><m:mspace width="0.2em" /><m:mi>a</m:mi><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mi>b</m:mi></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mspace width="1.8em" /><m:mo>∘</m:mo><m:mspace width="0.6em" /><m:mi>a</m:mi><m:mo>·</m:mo><m:mi>b</m:mi><m:mo>,</m:mo><m:mi>a</m:mi><m:mi>b</m:mi><m:mo>,</m:mo><m:mrow><m:mo>(</m:mo><m:mi>a</m:mi><m:mo>)</m:mo></m:mrow><m:mrow><m:mo>(</m:mo><m:mi>b</m:mi><m:mo>)</m:mo></m:mrow><m:mspace width="0.2em" /><m:mrow><m:mo>(</m:mo><m:mi>a</m:mi><m:mo>)</m:mo></m:mrow><m:mi>b</m:mi><m:mo>,</m:mo><m:mi>a</m:mi><m:mrow><m:mo>(</m:mo><m:mi>b</m:mi><m:mo>)</m:mo></m:mrow></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mspace width="3em" /><m:mtext>ગુણાકારનું પરિણામ:</m:mtext><m:mspace width="0.2em" /><m:mi>a</m:mi><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mi>b</m:mi></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mspace width="1.8em" /><m:mo>∘</m:mo><m:mspace width="0.6em" /><m:mi>a</m:mi><m:mo>÷</m:mo><m:mi>b</m:mi><m:mo>,</m:mo><m:mi>a</m:mi><m:mtext>/</m:mtext><m:mi>b</m:mi><m:mo>,</m:mo><m:mfrac><m:mi>a</m:mi><m:mi>b</m:mi></m:mfrac><m:mo>,</m:mo><m:mi>b</m:mi><m:menclose notation="longdiv"><m:mi>a</m:mi></m:menclose></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mspace width="3em" /><m:mtext>ભાગફળ:</m:mtext><m:mspace width="0.2em" /><m:mi>a</m:mi><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mi>b</m:mi></m:mtd></m:mtr></m:mtable></m:math></item>
<item><emphasis effect="bold">અસમાનતા</emphasis><newline /><newline />
<m:math><m:mtable><m:mtr><m:mtd columnalign="left"><m:mspace width="1.8em" /><m:mo>∘</m:mo><m:mspace width="0.6em" /><m:mi>a</m:mi><m:mo>&lt;</m:mo><m:mi>b</m:mi><m:mspace width="0.2em" /><m:mtext> ને </m:mtext><m:mspace width="0.2em" /><m:mtext>“</m:mtext><m:mi>a</m:mi><m:mspace width="0.2em" /><m:mtext> એ </m:mtext><m:mspace width="0.2em" /><m:mi>b</m:mi><m:mtext> કરતાં નાનું છે” તરીકે વાંચીએ છીએ.</m:mtext></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mi>a</m:mi><m:mspace width="0.2em" /><m:mtext> એ સંખ્યારેખા પર </m:mtext><m:mspace width="0.2em" /><m:mi>b</m:mi><m:mspace width="0.2em" /><m:mtext> ની ડાબી બાજુએ છે.</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mspace width="1.8em" /><m:mo>∘</m:mo><m:mspace width="0.6em" /><m:mi>a</m:mi><m:mo>&gt;</m:mo><m:mi>b</m:mi><m:mspace width="0.2em" /><m:mtext> ને </m:mtext><m:mspace width="0.2em" /><m:mtext>“</m:mtext><m:mi>a</m:mi><m:mspace width="0.2em" /><m:mtext> એ </m:mtext><m:mspace width="0.2em" /><m:mi>b</m:mi><m:mtext> કરતાં મોટું છે” તરીકે વાંચીએ છીએ.</m:mtext></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mi>a</m:mi><m:mspace width="0.2em" /><m:mtext> એ સંખ્યારેખા પર </m:mtext><m:mspace width="0.2em" /><m:mi>b</m:mi><m:mspace width="0.2em" /><m:mtext> ની જમણી બાજુએ છે.</m:mtext></m:mtd></m:mtr></m:mtable></m:math></item>
<item><emphasis effect="bold">અસમાનતાના સંકેતો                                     શબ્દો</emphasis><newline /><newline />
<m:math><m:mtable><m:mtr><m:mtd columnalign="left"><m:mspace width="1.8em" /><m:mo>∘</m:mo><m:mspace width="0.6em" /><m:mi>a</m:mi><m:mo>≠</m:mo><m:mi>b</m:mi></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mspace width="11em" /><m:mi>a</m:mi><m:mspace width="0.2em" /><m:mtext /><m:mspace width="0.2em" /><m:mtext mathvariant="bold"> નીચે આપેલી સંખ્યાની બરાબર નથી: </m:mtext><m:mspace width="0.2em" /><m:mi>b</m:mi></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mspace width="1.8em" /><m:mo>∘</m:mo><m:mspace width="0.6em" /><m:mi>a</m:mi><m:mo>&lt;</m:mo><m:mi>b</m:mi></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mspace width="11em" /><m:mi>a</m:mi><m:mspace width="0.2em" /><m:mtext /><m:mspace width="0.2em" /><m:mtext mathvariant="bold"> નીચે આપેલી સંખ્યા કરતાં નાનું છે: </m:mtext><m:mspace width="0.2em" /><m:mi>b</m:mi></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mspace width="1.8em" /><m:mo>∘</m:mo><m:mspace width="0.6em" /><m:mi>a</m:mi><m:mo>≤</m:mo><m:mi>b</m:mi></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mspace width="11em" /><m:mi>a</m:mi><m:mspace width="0.2em" /><m:mtext /><m:mspace width="0.2em" /><m:mtext mathvariant="bold"> નીચે આપેલી સંખ્યા કરતાં નાનું અથવા તેની બરાબર છે: </m:mtext><m:mspace width="0.2em" /><m:mi>b</m:mi></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mspace width="1.8em" /><m:mo>∘</m:mo><m:mspace width="0.6em" /><m:mi>a</m:mi><m:mo>&gt;</m:mo><m:mi>b</m:mi></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mspace width="11em" /><m:mi>a</m:mi><m:mspace width="0.2em" /><m:mtext /><m:mspace width="0.2em" /><m:mtext mathvariant="bold"> નીચે આપેલી સંખ્યા કરતાં મોટું છે: </m:mtext><m:mspace width="0.2em" /><m:mi>b</m:mi></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mspace width="1.8em" /><m:mo>∘</m:mo><m:mspace width="0.6em" /><m:mi>a</m:mi><m:mo>≥</m:mo><m:mi>b</m:mi></m:mtd><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mspace width="11em" /><m:mi>a</m:mi><m:mspace width="0.2em" /><m:mtext /><m:mspace width="0.2em" /><m:mtext mathvariant="bold"> નીચે આપેલી સંખ્યા કરતાં મોટું અથવા તેની બરાબર છે: </m:mtext><m:mspace width="0.2em" /><m:mi>b</m:mi></m:mtd></m:mtr></m:mtable></m:math></item>
<item><emphasis effect="bold">જૂથ દર્શાવતા સંકેતો</emphasis>
<list id="fs-id1170655355366" list-type="bulleted" bullet-style="open-circle">
<item>ગોળ કૌંસ <m:math><m:mrow><m:mrow><m:mo>(</m:mo><m:mtext /><m:mspace width="0.2em" /><m:mo>)</m:mo></m:mrow></m:mrow></m:math></item>
<item>ચોરસ કૌંસ <m:math><m:mrow><m:mrow><m:mo>[</m:mo><m:mtext /><m:mspace width="0.2em" /><m:mo>]</m:mo></m:mrow></m:mrow></m:math></item>
<item>વાંકિયા કૌંસ <m:math><m:mrow><m:mrow><m:mo>{</m:mo><m:mtext /><m:mspace width="0.2em" /><m:mo>}</m:mo></m:mrow></m:mrow></m:math></item>
</list></item>
<item><emphasis effect="bold">ઘાત સ્વરૂપ</emphasis>
<list id="fs-id1170655207980" list-type="bulleted" bullet-style="open-circle">
<item><m:math><m:mrow><m:msup><m:mi>a</m:mi><m:mi>n</m:mi></m:msup></m:mrow></m:math> નો અર્થ છે ગુણાકાર કરવો <m:math><m:mi>a</m:mi></m:math> નો પોતાની સાથે, <m:math><m:mi>n</m:mi></m:math> વખત. પદાવલી <m:math><m:mrow><m:msup><m:mi>a</m:mi><m:mi>n</m:mi></m:msup></m:mrow></m:math> વાંચીએ છીએ <m:math><m:mi>a</m:mi></m:math> ની <m:math><m:mrow><m:msup><m:mi>n</m:mi><m:mrow><m:mi>t</m:mi><m:mi>h</m:mi></m:mrow></m:msup></m:mrow></m:math> ઘાત.</item>
</list></item>
<item><emphasis effect="bold">ક્રિયાઓનો ક્રમ:</emphasis> ગણિતીય પદાવલીઓને સાદું રૂપ આપતી વખતે આ ક્રમમાં ક્રિયાઓ કરો:
<list id="fs-id1170655232459" list-type="enumerated" number-style="arabic" class="stepwise">
<item>ગોળ કૌંસ અને જૂથ દર્શાવતા બીજા સંકેતો: અંદરની બધી પદાવલીઓને સાદું રૂપ આપો; સૌથી અંદરના કૌંસથી શરૂ કરો.</item>
<item>ઘાતાંક: ઘાતાંકવાળી બધી પદાવલીઓને સાદું રૂપ આપો.</item>
<item>ગુણાકાર અને ભાગાકાર: બધા ગુણાકાર અને ભાગાકાર ડાબેથી જમણે ક્રમમાં કરો. બંનેની પ્રાથમિકતા સરખી છે.</item>
<item>સરવાળો અને બાદબાકી: બધા સરવાળા અને બાદબાકી ડાબેથી જમણે ક્રમમાં કરો. બંનેની પ્રાથમિકતા સરખી છે.</item>
</list></item>
<item><emphasis effect="bold">સજાતીય પદો ભેગાં કરો</emphasis>
<list id="fs-id1170655352201" list-type="enumerated" number-style="arabic" class="stepwise">
<item>સજાતીય પદો ઓળખો.</item>
<item>પદાવલીને ફરી ગોઠવો જેથી સજાતીય પદો સાથે આવે.</item>
<item>સજાતીય પદોના દરેક જૂથમાં સહગુણકોનો સરવાળો કે બાદબાકી કરો અને એ જ ચલ રાખો.</item>
</list></item></list>
</section>
<section id="fs-id1170655353907" class="section-exercises">
<section id="fs-id1170655353911" class="practice-perfect"><title>અભ્યાસથી કુશળતા</title><para id="fs-id1170655221311"><emphasis effect="bold">ચલ અને બીજગણિતીય સંકેતોનો ઉપયોગ કરો</emphasis></para>
<para id="fs-id1166422865053">નીચેના અભ્યાસમાં, બીજગણિતમાંથી શબ્દોમાં ફેરવો.</para>
<exercise id="fs-id1170655221319">
<problem id="fs-id1170655221321">
<para id="fs-id1170655201516"><m:math><m:mrow><m:mn>16</m:mn><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655217215">
<para id="fs-id1170655217218">16 ઓછા 9; સોળ અને નવનો તફાવત</para>
</solution>
</exercise>
<exercise id="fs-id1170655217223">
<problem id="fs-id1170655217225">
<para id="fs-id1170655217227"><m:math><m:mrow><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170654939174">
<problem id="fs-id1170654939176">
<para id="fs-id1170654939178"><m:math><m:mrow><m:mn>28</m:mn><m:mo>÷</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655204216">
<para id="fs-id1170655204219">28 ભાગ્યા 4; અઠ્ઠાવીસ અને ચારનું ભાગફળ</para>
</solution>
</exercise>
<exercise id="fs-id1170655216122">
<problem id="fs-id1170655216124">
<para id="fs-id1170655216126"><m:math><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>11</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655224728">
<problem id="fs-id1170655199175">
<para id="fs-id1170655199177"><m:math><m:mrow><m:mrow><m:mo>(</m:mo><m:mn>2</m:mn><m:mo>)</m:mo></m:mrow><m:mrow><m:mo>(</m:mo><m:mn>7</m:mn><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655204282">
<para id="fs-id1170655204284">2 ગુણ્યા 7; બે અને સાતનો ગુણાકાર</para>
</solution>
</exercise>
<exercise id="fs-id1170655195272">
<problem id="fs-id1170655195274">
<para id="fs-id1170655195276"><m:math><m:mrow><m:mrow><m:mo>(</m:mo><m:mn>4</m:mn><m:mo>)</m:mo></m:mrow><m:mrow><m:mo>(</m:mo><m:mn>8</m:mn><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655202266">
<problem id="fs-id1170654920098">
<para id="fs-id1170654920100"><m:math><m:mrow><m:mn>14</m:mn><m:mo>&lt;</m:mo><m:mn>21</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654932704">
<para id="fs-id1170654932706">ચૌદ એ એકવીસ કરતાં નાનું છે</para>
</solution>
</exercise>
<exercise id="fs-id1170654932712">
<problem id="fs-id1170654932714">
<para id="fs-id1170655353322"><m:math><m:mrow><m:mn>17</m:mn><m:mo>&lt;</m:mo><m:mn>35</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655222292">
<problem id="fs-id1170655222294">
<para id="fs-id1170655222297"><m:math><m:mrow><m:mn>36</m:mn><m:mo>≥</m:mo><m:mn>19</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655165043">
<para id="fs-id1170655165045">છત્રીસ એ ઓગણીસ કરતાં મોટું અથવા તેની બરાબર છે</para>
</solution>
</exercise>
<exercise id="fs-id1170654939768">
<problem id="fs-id1170654939770">
<para id="fs-id1170654939772"><m:math><m:mrow><m:mn>6</m:mn><m:mi>n</m:mi><m:mo>=</m:mo><m:mn>36</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655352156">
<problem id="fs-id1170655352158">
<para id="fs-id1170655352160"><m:math><m:mrow><m:mi>y</m:mi><m:mo>−</m:mo><m:mn>1</m:mn><m:mo>&gt;</m:mo><m:mn>6</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655229724">
<para id="fs-id1170655229726"><emphasis effect="italics">y</emphasis> ઓછા 1 એ 6 કરતાં મોટું છે; આનો તફાવત <emphasis effect="italics">y</emphasis> અને એક એ છ કરતાં મોટું છે</para>
</solution>
</exercise>
<exercise id="fs-id1170655164985">
<problem id="fs-id1170655164987">
<para id="fs-id1170655164989"><m:math><m:mrow><m:mi>y</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>&gt;</m:mo><m:mn>8</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655222038">
<problem id="fs-id1170655222040">
<para id="fs-id1170655222043"><m:math><m:mrow><m:mn>2</m:mn><m:mo>≤</m:mo><m:mn>18</m:mn><m:mo>÷</m:mo><m:mn>6</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655263775">
<para id="fs-id1170655263777">2 એ 18 ભાગ્યા 6 કરતાં નાનું અથવા તેની બરાબર છે; 2 એ અઢાર અને છના ભાગફળ કરતાં નાનું અથવા તેની બરાબર છે</para>
</solution>
</exercise>
<exercise id="fs-id1170655162298">
<problem id="fs-id1170655162300">
<para id="fs-id1170655162302"><m:math><m:mrow><m:mi>a</m:mi><m:mo>≠</m:mo><m:mn>1</m:mn><m:mo>·</m:mo><m:mn>12</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id1170654924071">નીચેના અભ્યાસમાં, દરેક પદાવલી છે કે સમીકરણ તે નક્કી કરો.</para>
<exercise id="fs-id1170654924074">
<problem id="fs-id1170654924076">
<para id="fs-id1170654924079"><m:math><m:mrow><m:mn>9</m:mn><m:mo>·</m:mo><m:mn>6</m:mn><m:mo>=</m:mo><m:mn>54</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655197070">
<para id="fs-id1170655197072">સમીકરણ</para>
</solution>
</exercise>
<exercise id="fs-id1170655197077">
<problem id="fs-id1170655197079">
<para id="fs-id1170655197082"><m:math><m:mrow><m:mn>7</m:mn><m:mo>·</m:mo><m:mn>9</m:mn><m:mo>=</m:mo><m:mn>63</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170654953638">
<problem id="fs-id1170654953640">
<para id="fs-id1170655199135"><m:math><m:mrow><m:mn>5</m:mn><m:mo>·</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655208585">
<para id="fs-id1170655208588">પદાવલી</para>
</solution>
</exercise>
<exercise id="fs-id1170655208593">
<problem id="fs-id1170655228666">
<para id="fs-id1170655228668"><m:math><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655192248">
<problem id="fs-id1170655192251">
<para id="fs-id1170655353132"><m:math><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655174526">
<para id="fs-id1170655174528">પદાવલી</para>
</solution>
</exercise>
<exercise id="fs-id1170655174533">
<problem id="fs-id1170655174536">
<para id="fs-id1170655174538"><m:math><m:mrow><m:mi>y</m:mi><m:mo>−</m:mo><m:mn>5</m:mn><m:mo>=</m:mo><m:mn>25</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id1170655201109"><emphasis effect="bold">ક્રિયાઓના ક્રમથી પદાવલીઓને સાદું રૂપ આપો</emphasis></para>
<para id="fs-id1166424802765">નીચેના અભ્યાસમાં, દરેક પદાવલીને સાદું રૂપ આપો.</para>
<exercise id="fs-id1170655269971">
<problem id="fs-id1170655269973">
<para id="fs-id1170655269975"><m:math><m:mrow><m:msup><m:mn>5</m:mn><m:mn>3</m:mn></m:msup></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655207782">
<para id="fs-id1170655207784">125</para>
</solution>
</exercise>
<exercise id="fs-id1170655219574">
<problem id="fs-id1170655219576">
<para id="fs-id1170655219578"><m:math><m:mrow><m:msup><m:mn>8</m:mn><m:mn>3</m:mn></m:msup></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655219548">
<problem id="fs-id1170655215864">
<para id="fs-id1170655215866"><m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mn>8</m:mn></m:msup></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655190694">
<para id="fs-id1170655190696">256</para>
</solution>
</exercise>
<exercise id="fs-id1170655190701">
<problem id="fs-id1170655190704">
<para id="fs-id1170655190706"><m:math><m:mrow><m:msup><m:mrow><m:mn>10</m:mn></m:mrow><m:mn>5</m:mn></m:msup></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id1170655201078">નીચેના અભ્યાસમાં, ક્રિયાઓના ક્રમથી સાદું રૂપ આપો.</para>
<exercise id="fs-id1170655201082">
<problem id="fs-id1170655201084">
<para id="fs-id1170655224768"><span class="token">ⓐ</span> <m:math><m:mrow><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>8</m:mn><m:mo>·</m:mo><m:mn>5</m:mn></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>·</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655226536">
<para id="fs-id1170654940316"><span class="token">ⓐ</span> 43 <span class="token">ⓑ</span> 55</para>
</solution>
</exercise>
<exercise id="fs-id1170654940321">
<problem id="fs-id1170654940323">
<para id="fs-id1170654940326"><span class="token">ⓐ</span> <m:math><m:mrow><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>6</m:mn><m:mo>·</m:mo><m:mn>3</m:mn></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>6</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>·</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170654928239">
<problem id="fs-id1170654928241">
<para id="fs-id1170654928243"><m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mn>3</m:mn></m:msup><m:mo>−</m:mo><m:mn>12</m:mn><m:mo>÷</m:mo><m:mo stretchy="false">(</m:mo><m:mn>9</m:mn><m:mo>−</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655232415">
<para id="fs-id1170655232417">5</para>
</solution>
</exercise>
<exercise id="fs-id1170655232422">
<problem id="fs-id1170655232425">
<para id="fs-id1170655195940"><m:math><m:mrow><m:msup><m:mn>3</m:mn><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>18</m:mn><m:mo>÷</m:mo><m:mo stretchy="false">(</m:mo><m:mn>11</m:mn><m:mo>−</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655288215">
<problem id="fs-id1170655288217">
<para id="fs-id1170655288219"><m:math><m:mrow><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>8</m:mn><m:mo>+</m:mo><m:mn>5</m:mn><m:mo>·</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655125092">
<para id="fs-id1170655125095">34</para>
</solution>
</exercise>
<exercise id="fs-id1170655125100">
<problem id="fs-id1170655125102">
<para id="fs-id1170655162923"><m:math><m:mrow><m:mn>4</m:mn><m:mo>·</m:mo><m:mn>7</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655222691">
<problem id="fs-id1170655222693">
<para id="fs-id1170655222695"><m:math><m:mrow><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>8</m:mn><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo>+</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655353228">
<para id="fs-id1170655353230">58</para>
</solution>
</exercise>
<exercise id="fs-id1170655220389">
<problem id="fs-id1170655220391">
<para id="fs-id1170655220393"><m:math><m:mrow><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>6</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170654944713">
<problem id="fs-id1170654944715">
<para id="fs-id1170654944718"><m:math><m:mrow><m:mn>4</m:mn><m:mo>·</m:mo><m:mn>12</m:mn><m:mtext>/</m:mtext><m:mn>8</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654944471">
<para id="fs-id1170655132880">6</para>
</solution>
</exercise>
<exercise id="fs-id1170655132885">
<problem id="fs-id1170655132887">
<para id="fs-id1170655132889"><m:math><m:mrow><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>36</m:mn><m:mtext>/</m:mtext><m:mn>6</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170654932261">
<problem id="fs-id1170654932263">
<para id="fs-id1170655206797"><m:math><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>6</m:mn><m:mo>+</m:mo><m:mn>10</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>÷</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655207262">
<para id="fs-id1170655207264">4</para>
</solution>
</exercise>
<exercise id="fs-id1170655204244">
<problem id="fs-id1170655204246">
<para id="fs-id1170655204248"><m:math><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>9</m:mn><m:mo>+</m:mo><m:mn>12</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>÷</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655348669">
<problem id="fs-id1170655348671">
<para id="fs-id1170655348673"><m:math><m:mrow><m:mn>20</m:mn><m:mo>÷</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>6</m:mn><m:mo>·</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655106120">
<para id="fs-id1170655106122">35</para>
</solution>
</exercise>
<exercise id="fs-id1170655106128">
<problem id="fs-id1170655106130">
<para id="fs-id1170655106132"><m:math><m:mrow><m:mn>33</m:mn><m:mo>÷</m:mo><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>8</m:mn><m:mo>·</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655106764">
<problem id="fs-id1170655209466">
<para id="fs-id1170655209468"><m:math><m:mrow><m:msup><m:mn>3</m:mn><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:msup><m:mn>7</m:mn><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654941862">
<para id="fs-id1170654941864">58</para>
</solution>
</exercise>
<exercise id="fs-id1170655188921">
<problem id="fs-id1170655188923">
<para id="fs-id1170655188925"><m:math><m:mrow><m:msup><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>7</m:mn></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655353540">
<problem id="fs-id1170655353543">
<para id="fs-id1170655353545"><m:math><m:mrow><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mn>1</m:mn><m:mo>+</m:mo><m:mn>9</m:mn><m:mo>·</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:msup><m:mn>4</m:mn><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655162440">
<para id="fs-id1170655162442">149</para>
</solution>
</exercise>
<exercise id="fs-id1170655178388">
<problem id="fs-id1170655178390">
<para id="fs-id1170655178393"><m:math><m:mrow><m:mn>5</m:mn><m:mo stretchy="false">(</m:mo><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>8</m:mn><m:mo>·</m:mo><m:mn>4</m:mn><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:msup><m:mn>7</m:mn><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655212647">
<problem id="fs-id1170655212649">
<para id="fs-id1170655212651"><m:math><m:mrow><m:mn>2</m:mn><m:mrow><m:mo>[</m:mo><m:mrow><m:mn>1</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>10</m:mn><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow><m:mo>]</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654944652">
<para id="fs-id1170654944654">50</para>
</solution>
</exercise>
<exercise id="fs-id1170655203624">
<problem id="fs-id1170655203626">
<para id="fs-id1170655203628"><m:math><m:mrow><m:mn>5</m:mn><m:mrow><m:mo>[</m:mo><m:mrow><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>3</m:mn><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow><m:mo>]</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id1170655201501"><emphasis effect="bold">પદાવલીની કિંમત શોધો</emphasis></para>
<para id="fs-id1166424861751">નીચેના અભ્યાસમાં, આપેલી પદાવલીઓની કિંમત શોધો.</para>
<exercise id="fs-id1170655201507">
<problem id="fs-id1170655201509">
<para id="fs-id1170655201511"><m:math><m:mrow><m:mn>7</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655204396">
<para id="fs-id1170655204398">22</para>
</solution>
</exercise>
<exercise id="fs-id1170655204403">
<problem id="fs-id1170655207238">
<para id="fs-id1170655207240"><m:math><m:mrow><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655201482">
<problem id="fs-id1170655201485">
<para id="fs-id1170655201487"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>12</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655192284">
<para id="fs-id1170655192286">144</para>
</solution>
</exercise>
<exercise id="fs-id1170655218665">
<problem id="fs-id1170655218667">
<para id="fs-id1170655218669"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655175070">
<problem id="fs-id1170655175073">
<para id="fs-id1170655175075"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>5</m:mn></m:msup></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655215521">
<para id="fs-id1170655215523">32</para>
</solution>
</exercise>
<exercise id="fs-id1170655105066">
<problem id="fs-id1170655105068">
<para id="fs-id1170655105070"><m:math><m:mrow><m:msup><m:mn>4</m:mn><m:mi>x</m:mi></m:msup></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655117048">
<problem id="fs-id1170655117051">
<para id="fs-id1170655117053"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655351914">
<para id="fs-id1170655351917">21</para>
</solution>
</exercise>
<exercise id="fs-id1170655351922">
<problem id="fs-id1170655351924">
<para id="fs-id1170655351926"><m:math><m:mrow><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>y</m:mi><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math> જ્યારે<newline /><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170654989848">
<problem id="fs-id1170654989850">
<para id="fs-id1170654989853"><m:math><m:mrow><m:msup><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>−</m:mo><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow><m:mn>2</m:mn></m:msup></m:mrow></m:math> જ્યારે<newline /><m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>10</m:mn><m:mo>,</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655165854">
<para id="fs-id1170655165856">9</para>
</solution>
</exercise>
<exercise id="fs-id1170655165861">
<problem id="fs-id1170655165863">
<para id="fs-id1170655165865"><m:math><m:mrow><m:msup><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow><m:mn>2</m:mn></m:msup></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655178029">
<problem id="fs-id1170655178031">
<para id="fs-id1170655178033"><m:math><m:mrow><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655118295">
<para id="fs-id1170655118297">73</para>
</solution>
</exercise>
<exercise id="fs-id1170655127450">
<problem id="fs-id1170655127452">
<para id="fs-id1170655127454"><m:math><m:mrow><m:msup><m:mi>r</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:msup><m:mi>s</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>r</m:mi><m:mo>=</m:mo><m:mn>12</m:mn><m:mo>,</m:mo><m:mi>s</m:mi><m:mo>=</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655113949">
<problem id="fs-id1170655113951">
<para id="fs-id1170655113953"><m:math><m:mrow><m:mn>2</m:mn><m:mi>l</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>w</m:mi></m:mrow></m:math> જ્યારે<newline /><m:math><m:mrow><m:mi>l</m:mi><m:mo>=</m:mo><m:mn>15</m:mn><m:mo>,</m:mo><m:mi>w</m:mi><m:mo>=</m:mo><m:mn>12</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654977071">
<para id="fs-id1170654977073">54</para>
</solution>
</exercise>
<exercise id="fs-id1170654977079">
<problem id="fs-id1170655179444">
<para id="fs-id1170655179446"><m:math><m:mrow><m:mn>2</m:mn><m:mi>l</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>w</m:mi></m:mrow></m:math> જ્યારે<newline /><m:math><m:mrow><m:mi>l</m:mi><m:mo>=</m:mo><m:mn>18</m:mn><m:mo>,</m:mo><m:mi>w</m:mi><m:mo>=</m:mo><m:mn>14</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id1170654985745"><emphasis effect="bold">સજાતીય પદો ભેગાં કરીને પદાવલીઓને સાદું રૂપ આપો</emphasis></para>
<para id="fs-id1166422542494">નીચેના અભ્યાસમાં, દરેક પદનો સહગુણક ઓળખો.</para>
<exercise id="fs-id1170654985751">
<problem id="fs-id1170654985753">
<para id="fs-id1170655206232">8<emphasis effect="italics">a</emphasis></para>
</problem>
<solution id="fs-id1170655206240">
<para id="fs-id1170655206242">8</para>
</solution>
</exercise>
<exercise id="fs-id1170655206247">
<problem id="fs-id1170655206250">
<para id="fs-id1170655189188">13<emphasis effect="italics">m</emphasis></para>
</problem>
</exercise>
<exercise id="fs-id1170655189203">
<problem id="fs-id1170655189205">
<para id="fs-id1170655189207"><m:math><m:mrow><m:mn>5</m:mn><m:msup><m:mi>r</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655332464">
<para id="fs-id1170655332466">5</para>
</solution>
</exercise>
<exercise id="fs-id1170655332471">
<problem id="fs-id1170655106164">
<para id="fs-id1170655106166"><m:math><m:mrow><m:mn>6</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id1170655121559">નીચેના અભ્યાસમાં, સજાતીય પદો ઓળખો.</para>
<exercise id="fs-id1170655121562">
<problem id="fs-id1170655121564">
<para id="fs-id1170655121566"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mo>,</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>,</m:mo><m:mn>14</m:mn><m:mo>,</m:mo><m:mn>8</m:mn><m:mi>y</m:mi><m:mo>,</m:mo><m:mn>5</m:mn><m:mo>,</m:mo><m:mn>8</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655105988">
<para id="fs-id1170655105990"><m:math><m:mrow><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>8</m:mn><m:msup><m:mi>x</m:mi><m:mn>3</m:mn></m:msup><m:mo>,</m:mo><m:mn>14</m:mn><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>5</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655105815">
<problem id="fs-id1170655105818">
<para id="fs-id1170655105820"><m:math><m:mrow><m:mn>6</m:mn><m:mi>z</m:mi><m:mo>,</m:mo><m:mn>3</m:mn><m:msup><m:mi>w</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mn>6</m:mn><m:msup><m:mi>z</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>4</m:mn><m:mi>z</m:mi><m:mo>,</m:mo><m:msup><m:mi>w</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655125128">
<problem id="fs-id1170655125130">
<para id="fs-id1170655125133"><m:math><m:mrow><m:mn>9</m:mn><m:mi>a</m:mi><m:mo>,</m:mo><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>16</m:mn><m:mo>,</m:mo><m:mn>16</m:mn><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>4</m:mn><m:mo>,</m:mo><m:mn>9</m:mn><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655020508">
<para id="fs-id1170655020510"><m:math><m:mrow><m:mn>16</m:mn><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>4</m:mn><m:mo>,</m:mo><m:mn>16</m:mn><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>9</m:mn><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655228745">
<problem id="fs-id1170655228747">
<para id="fs-id1170655224251"><m:math><m:mrow><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>25</m:mn><m:msup><m:mi>r</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>10</m:mn><m:mi>s</m:mi><m:mo>,</m:mo><m:mn>10</m:mn><m:mi>r</m:mi><m:mo>,</m:mo><m:mn>4</m:mn><m:msup><m:mi>r</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>3</m:mn><m:mi>s</m:mi></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id1170655353112">નીચેના અભ્યાસમાં, દરેક પદાવલીનાં પદો ઓળખો.</para>
<exercise id="fs-id1170655353115">
<problem id="fs-id1170655353118">
<para id="fs-id1170655353120"><m:math><m:mrow><m:mn>15</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655163298">
<para id="fs-id1170655163300"><m:math><m:mrow><m:mn>15</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>,</m:mo><m:mn>6</m:mn><m:mi>x</m:mi><m:mo>,</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655222848">
<problem id="fs-id1170655233736">
<para id="fs-id1170655233738"><m:math><m:mrow><m:mn>11</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655150570">
<problem id="fs-id1170655150572">
<para id="fs-id1170655150574"><m:math><m:mrow><m:mn>10</m:mn><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup><m:mo>+</m:mo><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654952715">
<para id="fs-id1170654952718"><m:math><m:mrow><m:mn>10</m:mn><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup><m:mo>,</m:mo><m:mi>y</m:mi><m:mo>,</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655037446">
<problem id="fs-id1170655037448">
<para id="fs-id1170655037450"><m:math><m:mrow><m:mn>9</m:mn><m:msup><m:mi>y</m:mi><m:mn>3</m:mn></m:msup><m:mo>+</m:mo><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id1170655163117">નીચેના અભ્યાસમાં, સજાતીય પદો ભેગાં કરીને પદાવલીઓને સાદું રૂપ આપો.</para>
<exercise id="fs-id1170655163120">
<problem id="fs-id1170655163122">
<para id="fs-id1170655163124"><m:math><m:mrow><m:mn>10</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655163140">
<para id="fs-id1170655206105">13<emphasis effect="italics">x</emphasis></para>
</solution>
</exercise>
<exercise id="fs-id1170655206113">
<problem id="fs-id1170655206115">
<para id="fs-id1170655206118"><m:math><m:mrow><m:mn>15</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>x</m:mi></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655194166">
<problem id="fs-id1170655194168">
<para id="fs-id1170655194171"><m:math><m:mrow><m:mn>4</m:mn><m:mi>c</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>c</m:mi><m:mo>+</m:mo><m:mi>c</m:mi></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655353945">
<para id="fs-id1170655353947">7<emphasis effect="italics">c</emphasis></para>
</solution>
</exercise>
<exercise id="fs-id1170655353956">
<problem id="fs-id1170655206254">
<para id="fs-id1170655206256"><m:math><m:mrow><m:mn>6</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>y</m:mi><m:mo>+</m:mo><m:mi>y</m:mi></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655353656">
<problem id="fs-id1170655353658">
<para id="fs-id1170655353660"><m:math><m:mrow><m:mn>7</m:mn><m:mi>u</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>u</m:mi><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654925642">
<para id="fs-id1170654925644"><m:math><m:mrow><m:mn>10</m:mn><m:mi>u</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655353364">
<problem id="fs-id1170655353366">
<para id="fs-id1170655353368"><m:math><m:mrow><m:mn>8</m:mn><m:mi>d</m:mi><m:mo>+</m:mo><m:mn>6</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>d</m:mi><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655221209">
<problem id="fs-id1170655221211">
<para id="fs-id1170655192086"><m:math><m:mrow><m:mn>10</m:mn><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mo>+</m:mo><m:mn>5</m:mn><m:mi>a</m:mi><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>7</m:mn><m:mi>a</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655192383">
<para id="fs-id1170655192385"><m:math><m:mrow><m:mn>22</m:mn><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655192400">
<problem id="fs-id1170655195848">
<para id="fs-id1170655195850"><m:math><m:mrow><m:mn>7</m:mn><m:mi>c</m:mi><m:mo>+</m:mo><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>6</m:mn><m:mi>c</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>9</m:mn><m:mi>c</m:mi><m:mo>−</m:mo><m:mn>1</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1170655218501" class="material-set-2">
<problem id="fs-id1170655218503">
<para id="fs-id1170655226029"><m:math><m:mrow><m:mn>3</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>12</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>11</m:mn><m:mo>+</m:mo><m:mn>14</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654983200">
<para id="fs-id1170654983202"><m:math><m:mrow><m:mn>17</m:mn><m:msup><m:mi>x</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>20</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>16</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655175442" class="material-set-2">
<problem id="fs-id1170655175444">
<para id="fs-id1170655175446"><m:math><m:mrow><m:mn>5</m:mn><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>9</m:mn><m:mi>b</m:mi><m:mo>+</m:mo><m:mn>10</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:msup><m:mi>b</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>b</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<para id="fs-id1170655189636"><emphasis effect="bold">અંગ્રેજી શબ્દસમૂહને બીજગણિતીય પદાવલીમાં ફેરવો</emphasis></para>
<para id="fs-id1166422560874">નીચેના અભ્યાસમાં, શબ્દસમૂહોને બીજગણિતીય પદાવલીઓમાં ફેરવો.</para>
<exercise id="fs-id1170655189643">
<problem id="fs-id1170655189646">
<para id="fs-id1170655189648">14 અને 9નો તફાવત</para>
</problem>
<solution id="fs-id1170655166646">
<para id="fs-id1170655166648"><m:math><m:mrow><m:mn>14</m:mn><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655166661">
<problem id="fs-id1170655166663">
<para id="fs-id1170655166665">19 અને 8નો તફાવત</para>
</problem>
</exercise>
<exercise id="fs-id1170655167087">
<problem id="fs-id1170655167089">
<para id="fs-id1170655167091">9 અને 7નો ગુણાકાર</para>
</problem>
<solution id="fs-id1170655167096">
<para id="fs-id1170655167098"><m:math><m:mrow><m:mn>9</m:mn><m:mo>·</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655113347">
<problem id="fs-id1170655113350">
<para id="fs-id1170655113352">8 અને 7નો ગુણાકાર</para>
</problem>
</exercise>
<exercise id="fs-id1170655113371">
<problem id="fs-id1170655194052">
<para id="fs-id1170655194054">36 અને 9નું ભાગફળ</para>
</problem>
<solution id="fs-id1170655194058">
<para id="fs-id1170655194060"><m:math><m:mrow><m:mn>36</m:mn><m:mo>÷</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655194073">
<problem id="fs-id1170655194075">
<para id="fs-id1170655194077">42 અને 7નું ભાગફળ</para>
</problem>
</exercise>
<exercise id="fs-id1170655201624">
<problem id="fs-id1170655201626">
<para id="fs-id1170655201628"><emphasis effect="italics">8x</emphasis> અને 3<emphasis effect="italics">x</emphasis> નો સરવાળો</para>
</problem>
<solution id="fs-id1170655196315">
<para id="fs-id1170655196317"><m:math><m:mrow><m:mn>8</m:mn><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>3</m:mn><m:mi>x</m:mi></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655196334">
<problem id="fs-id1170655196336">
<para id="fs-id1170655196339"><emphasis effect="italics">13x</emphasis> અને 3<emphasis effect="italics">x</emphasis> નો સરવાળો</para>
</problem>
</exercise>
<exercise id="fs-id1170655150288">
<problem id="fs-id1170655150291">
<para id="fs-id1170655150293"><emphasis effect="italics">y</emphasis> અને 3નું ભાગફળ</para>
</problem>
<solution id="fs-id1170655229777">
<para id="fs-id1170655229780"><m:math><m:mrow><m:mfrac><m:mi>y</m:mi><m:mn>3</m:mn></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655229791">
<problem id="fs-id1170655229793">
<para id="fs-id1170655229796"><emphasis effect="italics">y</emphasis> અને 8નું ભાગફળ</para>
</problem>
</exercise>
<exercise id="fs-id1170655114661">
<problem id="fs-id1170655114663">
<para id="fs-id1170655114665"><emphasis effect="italics">y</emphasis> અને નવ વચ્ચેના તફાવતનું આઠ ગણું</para>
</problem>
<solution id="fs-id1170655114675">
<para id="fs-id1170655114677"><m:math><m:mrow><m:mn>8</m:mn><m:mrow><m:mo>(</m:mo><m:mrow><m:mi>y</m:mi><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170654888986">
<problem id="fs-id1170654888988">
<para id="fs-id1170654888990"><emphasis effect="italics">y</emphasis> અને એક વચ્ચેના તફાવતનું સાત ગણું</para>
</problem>
</exercise>
<exercise id="fs-id1170655193829">
<problem id="fs-id1170655193831">
<para id="fs-id1170655193834">એરિકની કારમાં રોક અને શાસ્ત્રીય સંગીતની સીડી છે. રોક સીડીની સંખ્યા શાસ્ત્રીય સીડી કરતાં 3 વધારે છે. ધારો <emphasis effect="italics">c</emphasis> શાસ્ત્રીય સીડીની સંખ્યા દર્શાવે છે. રોક સીડીની સંખ્યા માટે પદાવલી લખો.</para>
</problem>
<solution id="fs-id1170655193844">
<para id="fs-id1170655193846"><m:math><m:mrow><m:mi>c</m:mi><m:mo>+</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655221232">
<problem id="fs-id1170655221234">
<para id="fs-id1170655221237">બીજા ધોરણના વર્ગમાં છોકરીઓની સંખ્યા છોકરાઓ કરતાં 4 ઓછી છે. ધારો <emphasis effect="italics">b</emphasis> છોકરાઓની સંખ્યા દર્શાવે છે. છોકરીઓની સંખ્યા માટે પદાવલી લખો.</para>
</problem>
</exercise>
<exercise id="fs-id1170655221261">
<problem id="fs-id1170655221263">
<para id="fs-id1170655351967">ગ્રેગના ખિસ્સામાં નિકલ અને પેની સિક્કા છે. પેનીની સંખ્યા નિકલની સંખ્યાના બમણાથી સાત ઓછી છે. ધારો <m:math><m:mi>n</m:mi></m:math> નિકલની સંખ્યા દર્શાવે છે. પેનીની સંખ્યા માટે પદાવલી લખો.</para>
</problem>
<solution id="fs-id1170655351976">
<para id="fs-id1170655351978"><m:math><m:mrow><m:mn>2</m:mn><m:mi>n</m:mi><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-id1170655351993">
<problem id="fs-id1170655351995">
<para id="fs-id1170655351998">જેનેટના પાકીટમાં $5 અને $10ની નોટો છે. પાંચની નોટોની સંખ્યા દસની નોટોની સંખ્યાના છ ગણાથી ત્રણ વધારે છે. ધારો <emphasis effect="italics">t</emphasis> દસની નોટોની સંખ્યા દર્શાવે છે. પાંચની નોટોની સંખ્યા માટે પદાવલી લખો.</para>
</problem>
</exercise>
</section><section id="fs-id1170655222132" class="everyday">
<title>રોજિંદા જીવનમાં ગણિત</title>
<exercise id="fs-id1170655222137">
<problem id="fs-id1170655222139">
<para id="fs-id1170655222142"><emphasis effect="bold">કારનો વીમો</emphasis> જસ્ટિનની કારના વીમામાં દરેક ઘટના માટે $750ની કપાતપાત્ર રકમ છે. એટલે તે $750 ચૂકવે છે અને $750થી વધારે ખર્ચ વીમા કંપની ચૂકવે છે. જસ્ટિન $2,100નો દાવો કરે તો:</para>
<list id="fs-id1166425097679" list-type="enumerated" number-style="arabic" class="circled">
<item><span class="token">ⓐ</span> તે કેટલી રકમ ચૂકવશે?</item>
<item><span class="token">ⓑ</span> તેની વીમા કંપની કેટલી રકમ ચૂકવશે?</item>
</list>
</problem>
<solution id="fs-id1170655304728">
<para id="fs-id1170655304730"><span class="token">ⓐ</span> $750 <span class="token">ⓑ</span> $1,350</para>
</solution>
</exercise>
<exercise id="fs-id1170655304735">
<problem id="fs-id1170655304738">
<para id="fs-id1170655304740"><emphasis effect="bold">ઘરનો વીમો</emphasis> આર્માન્ડોના ઘરના વીમામાં દરેક ઘટના માટે $2,500ની કપાતપાત્ર રકમ છે. એટલે તે $2,500 ચૂકવે છે અને તેનાથી વધારે ખર્ચ વીમા કંપની ચૂકવે છે. આર્માન્ડો $19,400નો દાવો કરે તો:</para><list id="fs-id1166425288602" list-type="enumerated" number-style="arabic" class="circled">
<item><span class="token">ⓐ</span> તે કેટલી રકમ ચૂકવશે?</item>
<item><span class="token">ⓑ</span> વીમા કંપની કેટલી રકમ ચૂકવશે?</item>
</list>
</problem>
</exercise>
</section>
<section id="fs-id1170654932596" class="writing">
<title>લેખિત અભ્યાસ</title>
<exercise id="fs-id1170654932601">
<problem id="fs-id1170654932603">
<para id="fs-id1170654932606">પદાવલી અને સમીકરણ વચ્ચેનો તફાવત સમજાવો.</para>
</problem>
<solution id="fs-id1170654932610">
<para id="fs-id1170654932612">જવાબો જુદા હોઈ શકે</para>
</solution>
</exercise>
<exercise id="fs-id1170654932617">
<problem id="fs-id1170654932619">
<para id="fs-id1170654932622">પદાવલીને સાદું રૂપ આપવા ક્રિયાઓના ક્રમનો ઉપયોગ કરવો શા માટે જરૂરી છે?</para>
</problem>
</exercise>
<exercise id="fs-id1170654932633">
<problem id="fs-id1170654932635">
<para id="fs-id1170655150830">આ પદાવલીમાં સજાતીય પદો કેવી રીતે ઓળખશો તે સમજાવો: <m:math><m:mrow><m:mn>8</m:mn><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup><m:mo>+</m:mo><m:mn>4</m:mn><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>9</m:mn><m:mo>−</m:mo><m:msup><m:mi>a</m:mi><m:mn>2</m:mn></m:msup><m:mo>−</m:mo><m:mn>1</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655150868">
<para id="fs-id1170655150870">જવાબો જુદા હોઈ શકે</para>
</solution>
</exercise>
<exercise id="fs-id1170655150876">
<problem id="fs-id1170655150878">
<para id="fs-id1170655150880">“<emphasis effect="italics">x</emphasis> અને <emphasis effect="italics">y</emphasis> ના સરવાળાનું 4 ગણું” તથા “4<emphasis effect="italics">x</emphasis> અને <emphasis effect="italics">y</emphasis> નો સરવાળો” શબ્દસમૂહો વચ્ચેનો તફાવત સમજાવો.</para>
</problem>
</exercise>
</section>
<section id="fs-id1170655332505">
<title>જાતે ચકાસો</title>
<para id="fs-id1170655332514"><span class="token">ⓐ</span> આ વિભાગનાં લક્ષ્યો પર તમારી પકડનું મૂલ્યાંકન કરવા આ યાદી વાપરો.</para>
<media id="fs-id1170655332525" alt="કોષ્ટકમાં ચાર સ્તંભ અને છ હરોળ છે. મથાળાં છે “હું કરી શકું છું…”, “આત્મવિશ્વાસથી”, “થોડી મદદથી” અને “ના—મને સમજાતું નથી!”. પહેલા સ્તંભમાં લખ્યું છે: “ચલ અને બીજગણિતીય સંકેતોનો ઉપયોગ કરવો”, “ક્રિયાઓના ક્રમથી પદાવલીઓને સાદું રૂપ આપવું”, “પદાવલીની કિંમત શોધવી”, “સજાતીય પદો ઓળખવા અને ભેગાં કરવા” અને “અંગ્રેજી શબ્દસમૂહોને બીજગણિતીય પદાવલીઓમાં ફેરવવા”.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_02_201_img_new.jpg" />
</media>
<para id="fs-id1170655229103"><span class="token">ⓑ</span> આ યાદી જોયા પછી બધાં લક્ષ્યો માટે આત્મવિશ્વાસ મેળવવા તમે શું કરશો?</para>
</section>
</section>
</content>
<glossary>
<definition id="fs-id1166422871117">
<term>સહગુણક</term>
<meaning id="fs-id1166422871122">પદનો સહગુણક એ પદમાં ચલ સાથે ગુણાતી અચળ સંખ્યા છે.</meaning>
</definition>
<definition id="fs-id1166422871132">
<term>અચળ</term>
<meaning id="fs-id1166422863899">અચળ એવી સંખ્યા છે જેનું મૂલ્ય હંમેશાં સરખું રહે છે.</meaning>
</definition>
<definition id="fs-id1166422863909">
<term>સમાનતાનો સંકેત</term>
<meaning id="fs-id1166422863914">“<m:math><m:mtext>=</m:mtext></m:math>” ને સમાનતાની નિશાની કહે છે. <m:math><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mi>b</m:mi></m:mrow></m:math> ને “<m:math><m:mi>a</m:mi></m:math> બરાબર <m:math><m:mi>b</m:mi></m:math>” તરીકે વાંચીએ છીએ.</meaning>
</definition>
<definition id="fs-id1166424997537">
<term>સમીકરણ</term>
<meaning id="fs-id1166424997542">સમીકરણ એ સમાનતાની નિશાનીથી જોડાયેલી બે પદાવલીઓ છે.</meaning>
</definition>
<definition id="fs-id1166422656693">
<term>પદાવલીની કિંમત શોધવી</term>
<meaning id="fs-id1166422656699">પદાવલીની કિંમત શોધવી એટલે ચલની જગ્યાએ આપેલી સંખ્યા મૂકી પદાવલીનું મૂલ્ય શોધવું.</meaning>
</definition>
<definition id="fs-id1166425263319">
<term>પદાવલી</term>
<meaning id="fs-id1166425263325">પદાવલી એ સંખ્યા, ચલ અથવા ક્રિયાના સંકેતો વાપરતું સંખ્યાઓ અને ચલોનું સંયોજન છે.</meaning>
</definition>
<definition id="fs-id1166424807195">
<term>સજાતીય પદો</term>
<meaning id="fs-id1166424807200">જે પદો બંને અચળ હોય અથવા જેમના સરખા ચલોની ઘાતો સરખી હોય તેમને સજાતીય પદો કહે છે.</meaning>
</definition>
<definition id="fs-id1166424807211">
<term>પદાવલીને સાદું રૂપ આપવું</term>
<meaning id="fs-id1166425009640">પદાવલીને સાદું રૂપ આપવા તેમાં આપેલી બધી ક્રિયાઓ કરો.</meaning>
</definition>
<definition id="fs-id1166425009650">
<term>પદ</term>
<meaning id="fs-id1166422862227">પદ એ અચળ અથવા એક કે વધુ ચલો અને અચળનો ગુણાકાર છે.</meaning>
</definition>
<definition id="fs-id1166422862236">
<term>ચલ</term>
<meaning id="fs-id1166422862241">ચલ એવો અક્ષર છે જે એવી સંખ્યા દર્શાવે છે જેનું મૂલ્ય બદલાઈ શકે.</meaning>
</definition>
</glossary>
</document>