</problem>
</exercise>
<exercise id="fs-id1519788">
<problem id="fs-id1519790">
<para id="fs-id1459254"><m:math><m:mrow><m:mn>82</m:mn><m:mo>−</m:mo><m:mn>59</m:mn></m:mrow></m:math></para>
