<?xml version='1.0' encoding='utf-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" xmlns:md="http://cnx.rice.edu/mdml" xml:lang="gu-Gujr-IN">
<title>પૂર્ણ સંખ્યાઓનો ભાગાકાર કરો</title>
<metadata>
  <md:content-id>m81256</md:content-id>
  <md:title>પૂર્ણ સંખ્યાઓનો ભાગાકાર કરો</md:title>
  <md:abstract><para id="para-00001">આ વિભાગના અંતે તમે:</para>
<list id="list-00001">
<item>ભાગાકારની લખાવટનો ઉપયોગ કરી શકશો.</item>
<item>પૂર્ણ સંખ્યાઓનો ભાગાકાર નમૂના દ્વારા દર્શાવી શકશો.</item>
<item>પૂર્ણ સંખ્યાઓનો ભાગાકાર કરી શકશો.</item>
<item>શબ્દોમાં આપેલી વાતને ગણિતની લખાવટમાં ફેરવી શકશો.</item>
<item>વ્યવહારુ પ્રશ્નોમાં પૂર્ણ સંખ્યાઓનો ભાગાકાર કરી શકશો.</item>
</list></md:abstract>
  <md:uuid>f7446efa-8302-4ef6-9e5a-bdc05acb3613</md:uuid>
</metadata>

<content>
<note id="fs-id1339369" class="be-prepared">
<para id="fs-id2281092">શરૂઆત કરતાં પહેલાં તૈયારી તપાસવાના આ પ્રશ્નો ઉકેલો.</para>
<exercise id="fs-idm325602928">
<problem id="fs-idm325708544">
<para id="fs-idm345783520">ગુણાકાર કરો: <m:math><m:mrow><m:mn>27</m:mn><m:mo>·</m:mo><m:mn>3</m:mn><m:mo>.</m:mo></m:mrow></m:math><newline />
જો આ પ્રશ્નમાં ભૂલ થઈ હોય, તો ફરી જુઓ: <link target-id="fs-id1233452" document="m81255" />.</para>
</problem>
<solution id="fs-idm320596224">
<para id="fs-idm323357056"><m:math><m:mrow><m:mn>81</m:mn></m:mrow></m:math></para>
</solution>
</exercise></note>
<note id="fs-id1339361" class="be-prepared">
<exercise id="fs-idm353635184">
<problem id="fs-idm334758464">
<para id="fs-idm349907632">બાદબાકી કરો: <m:math><m:mrow><m:mn>43</m:mn><m:mo>−</m:mo><m:mn>26</m:mn><m:mo>.</m:mo></m:mrow></m:math><newline />
જો આ પ્રશ્નમાં ભૂલ થઈ હોય, તો ફરી જુઓ: <link target-id="fs-id1275385" document="m81245" /></para>
</problem>
<solution id="fs-idm347717632">
<para id="fs-idm323600672"><m:math><m:mrow><m:mn>17</m:mn></m:mrow></m:math></para>
</solution>
</exercise></note>
<note id="fs-id1339362" class="be-prepared">
<exercise id="fs-idm352016192">
<problem id="fs-idm350482176">
<para id="fs-idm351364800">ગુણાકાર કરો: <m:math><m:mrow><m:mn>62</m:mn><m:mo stretchy="false">(</m:mo><m:mn>87</m:mn><m:mo stretchy="false">)</m:mo><m:mo>.</m:mo></m:mrow></m:math><newline />
જો આ પ્રશ્નમાં ભૂલ થઈ હોય, તો ફરી જુઓ: <link target-id="fs-id2830372" document="m81255" />.</para>
</problem>
<solution id="fs-idm343048528">
<para id="fs-idm351242192"><m:math><m:mrow><m:mn>5</m:mn><m:mo>,</m:mo><m:mn>394</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<section id="fs-id2294519"><title>ભાગાકારની લખાવટનો ઉપયોગ કરો</title><para id="fs-id1563789">અત્યાર સુધી સરવાળો, બાદબાકી અને ગુણાકાર શીખ્યા. હવે ભાગાકાર વિશે વિચારીએ. ધારો કે તમારી પાસે <m:math><m:mrow><m:mn>12</m:mn></m:mrow></m:math> કૂકી છે, જે અહીં દર્શાવેલી છે: <link target-id="CNX_BMath_Figure_01_05_001" /> તમે તેમને થેલીઓમાં મૂકવા માગો છો, જેમાં દરેક થેલીમાં <m:math><m:mn>4</m:mn></m:math> કૂકી હોય. આપણને કેટલી થેલી જોઈએ?</para>
<figure id="CNX_BMath_Figure_01_05_001">
<media id="fs-id2170048" alt="ચાર કૂકીની ત્રણ હરોળમાં કુલ બાર કૂકી દર્શાવેલી છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_05_001.jpg" />
</media>
</figure>
<para id="fs-id1614746">તમે પહેલી થેલીમાં <m:math><m:mn>4</m:mn></m:math> કૂકી, બીજી થેલીમાં <m:math><m:mn>4</m:mn></m:math> કૂકી અને એમ બધી કૂકી પૂરી થાય ત્યાં સુધી મૂકશો. આમ કરવાથી <m:math><m:mn>3</m:mn></m:math> થેલી ભરાશે.</para>
<media id="fs-id2353237" alt="કૂકીની 3 થેલી છે; દરેક થેલીમાં 4 કૂકી છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_05_042.jpg" />
</media>
<para id="fs-id1792383">બીજા શબ્દોમાં, શરૂઆતની <m:math><m:mrow><m:mn>12</m:mn></m:mrow></m:math> કૂકીમાંથી દરેક વખતે <m:math><m:mn>4</m:mn></m:math> કૂકી દૂર કરશો અથવા બાદ કરશો. જેમ ગુણાકાર પુનરાવર્તિત સરવાળો દર્શાવે છે, તેમ ભાગાકાર પુનરાવર્તિત બાદબાકી દર્શાવે છે.</para>
<para id="fs-id2310660">વારંવાર આ સંખ્યાને બાદ કરવાને બદલે: <m:math><m:mn>4</m:mn></m:math> આપણે આ રીતે લખી શકીએ:</para>
<equation id="fs-id1395694" class="unnumbered"><label /><m:math><m:mrow><m:mn>12</m:mn><m:mo>÷</m:mo><m:mn>4</m:mn></m:mrow></m:math></equation>
<para id="fs-id2221649">આને આપણે <emphasis effect="italics">બાર ભાગ્યા ચાર</emphasis> વાંચીએ છીએ. પરિણામને <term id="term-00001">ભાગફળ</term> કહે છે; અહીં તે આ સંખ્યાઓનું છે: <m:math><m:mrow><m:mn>12</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>4</m:mn><m:mo>.</m:mo></m:mrow></m:math> ભાગફળ છે <m:math><m:mn>3</m:mn></m:math> કારણ કે <m:math><m:mn>4</m:mn></m:math> ને <m:math><m:mrow><m:mn>12</m:mn></m:mrow></m:math> માંથી બરાબર <m:math><m:mn>3</m:mn></m:math> વખત બાદ કરી શકીએ છીએ. જે સંખ્યાનો ભાગાકાર કરવાનો હોય તેને <term id="term-00002">ભાજ્ય</term> અને જે સંખ્યા વડે ભાગાકાર કરીએ તેને <term id="term-00003">ભાજક</term> કહીએ છીએ. અહીં ભાજ્ય છે <m:math><m:mrow><m:mn>12</m:mn></m:mrow></m:math> અને ભાજક છે <m:math><m:mrow><m:mn>4</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id2133242">તમે અગાઉ આ લખાવટ વાપરી હશે: <m:math><m:mrow><m:mn>4</m:mn><m:menclose notation="longdiv"><m:mrow><m:mn>12</m:mn></m:mrow></m:menclose></m:mrow></m:math>પરંતુ આ ભાગાકાર આ રીતે પણ લખી શકાય: <m:math><m:mrow><m:mn>12</m:mn><m:mo>÷</m:mo><m:mn>4</m:mn><m:mo>,</m:mo><m:mspace width="0.2em" /><m:mn>12</m:mn><m:mtext>/</m:mtext><m:mn>4</m:mn><m:mo>,</m:mo><m:mfrac><m:mrow><m:mn>12</m:mn></m:mrow><m:mn>4</m:mn></m:mfrac><m:mo>.</m:mo></m:mrow></m:math> દરેક કિસ્સામાં <m:math><m:mrow><m:mn>12</m:mn></m:mrow></m:math> ભાજ્ય છે અને <m:math><m:mn>4</m:mn></m:math> ભાજક છે.</para><note id="fs-id1381461"><title>ભાગાકારની ક્રિયાનાં પ્રતીકો</title><para id="fs-id1510263">ભાગાકાર દર્શાવવા અને સમજાવવા પ્રતીકો અને શબ્દો વાપરી શકીએ છીએ.</para>
<table id="eip-id3140794" aria-label="5 સ્તંભ અને 1 હરોળનું કોષ્ટક. પહેલા સ્તંભનું શીર્ષક “ક્રિયા” અને મૂલ્ય “ભાગાકાર” છે. બીજા સ્તંભનું શીર્ષક “લખાવટ” છે અને તેમાં ત્રણ મૂલ્ય છે: x ગુણાકારનું પ્રતીક, ટપકાનું ગુણાકાર પ્રતીક અને કૌંસનું ગુણાકાર પ્રતીક. ત્રીજા સ્તંભનું શીર્ષક “પદાવલી” છે અને તેમાં ત્રણ મૂલ્ય છે: 3 ગુણ્યા 8, બીજા સ્તંભનાં અલગ અલગ ગુણાકાર પ્રતીકો સાથે. ચોથા સ્તંભનું શીર્ષક “આમ વાંચો” અને મૂલ્ય “ત્રણ ગુણ્યા આઠ” છે. પાંચમા સ્તંભનું શીર્ષક “પરિણામ” અને મૂલ્ય “3 અને 8નું ગુણનફળ” છે." class="unnumbered"><label />
<tgroup cols="5"><colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<colspec colnum="3" colname="c3" />
<colspec colnum="4" colname="c4" />
<colspec colnum="5" colname="c5" />
<thead>
<row valign="top">
<entry align="left">ક્રિયા</entry>
<entry align="left">લખાવટ</entry>
<entry align="left">પદાવલી</entry>
<entry align="left">આ રીતે વાંચો</entry>
<entry align="left">પરિણામ</entry>
</row>
</thead>
<tbody>
<row valign="top">
<entry valign="top" align="left"><m:math><m:mrow><m:mtext>ભાગાકાર</m:mtext></m:mrow></m:math></entry>
<entry valign="top" align="left"><m:math><m:mrow><m:mo>÷</m:mo></m:mrow></m:math><newline />
<m:math><m:mrow><m:mfrac><m:mi>a</m:mi><m:mi>b</m:mi></m:mfrac></m:mrow></m:math><newline />
<m:math><m:mrow><m:mi>b</m:mi><m:menclose notation="longdiv"><m:mrow><m:mi>a</m:mi></m:mrow></m:menclose></m:mrow></m:math><newline /><m:math><m:mi>a</m:mi><m:mo>/</m:mo><m:mi>b</m:mi></m:math>

</entry>
<entry valign="top" align="left"><m:math><m:mrow><m:mn>12</m:mn><m:mo>÷</m:mo><m:mn>4</m:mn></m:mrow></m:math>
<newline /><m:math><m:mrow><m:mfrac><m:mn>12</m:mn><m:mn>4</m:mn></m:mfrac></m:mrow></m:math>
<newline /><m:math><m:mrow><m:mn>4</m:mn><m:menclose notation="longdiv"><m:mrow><m:mn>12</m:mn></m:mrow></m:menclose></m:mrow></m:math><newline /><m:math><m:mn>12</m:mn><m:mo>/</m:mo><m:mn>4</m:mn></m:math>

</entry>
<entry valign="top" align="left"><m:math><m:mrow><m:mtext>બાર ભાગ્યા ચાર</m:mtext></m:mrow></m:math></entry>
<entry valign="top" align="left"><m:math><m:mrow><m:mtext>12 અને 4નું ભાગફળ</m:mtext></m:mrow></m:math></entry>
</row>
</tbody>











</tgroup>
</table>
<para id="eip-id1169380684673">એક સમયે બે સંખ્યાઓનો ભાગાકાર કરવામાં આવે છે. ગણિતની લખાવટને અંગ્રેજી શબ્દોમાં કે અંગ્રેજી શબ્દોને ગણિતની લખાવટમાં ફેરવતી વખતે સંખ્યાઓ ઓળખવા આ શબ્દો શોધો: <emphasis effect="italics">ઑફ</emphasis> અને <emphasis effect="italics">ઍન્ડ</emphasis> .</para></note><example id="fs-id2666153"><exercise id="fs-id1859185"><problem id="fs-id1828136">
<para id="fs-id2270111">ગણિતની લખાવટને શબ્દોમાં ફેરવો.</para>
<para id="fs-id1629002"><span class="token">ⓐ</span> <m:math><m:mn>64</m:mn><m:mo>÷</m:mo><m:mn>8</m:mn></m:math> <span class="token">ⓑ</span> <m:math><m:mfrac><m:mrow><m:mn>42</m:mn></m:mrow><m:mn>7</m:mn></m:mfrac></m:math> <span class="token">ⓒ</span> <m:math><m:mn>4</m:mn><m:menclose notation="longdiv"><m:mrow><m:mn>28</m:mn></m:mrow></m:menclose></m:math></para>
</problem>
<solution id="fs-id2220863">
<title>ઉકેલ</title>
<list id="eip-id1168289650120" list-type="labeled-item" class="circled"><item><span class="token">ⓐ</span> આને આપણે <emphasis effect="italics">ચોસઠ ભાગ્યા આઠ</emphasis> વાંચીએ છીએ અને પરિણામ છે <emphasis effect="italics">ચોસઠ અને આઠનું ભાગફળ</emphasis>.</item>
<item><span class="token">ⓑ</span> આને આપણે <emphasis effect="italics">બેતાલીસ ભાગ્યા સાત</emphasis> વાંચીએ છીએ અને પરિણામ છે <emphasis effect="italics">બેતાલીસ અને સાતનું ભાગફળ</emphasis>.</item>
<item><span class="token">ⓒ</span> આને આપણે <emphasis effect="italics">અઠ્ઠાવીસ ભાગ્યા ચાર</emphasis> વાંચીએ છીએ અને પરિણામ છે <emphasis effect="italics">અઠ્ઠાવીસ અને ચારનું ભાગફળ</emphasis>.</item></list></solution>
</exercise></example><note id="fs-id4114854" class="try">
<exercise id="fs-id1397949"><problem id="fs-id1259513">
<para id="fs-id1808449">ગણિતની લખાવટને શબ્દોમાં ફેરવો:</para>
<para id="fs-id1408876"><span class="token">ⓐ</span> <m:math><m:mn>84</m:mn><m:mo>÷</m:mo><m:mn>7</m:mn></m:math> <span class="token">ⓑ</span> <m:math><m:mfrac><m:mrow><m:mn>18</m:mn></m:mrow><m:mn>6</m:mn></m:mfrac></m:math> <span class="token">ⓒ</span> <m:math><m:mn>8</m:mn><m:menclose notation="longdiv"><m:mrow><m:mn>24</m:mn></m:mrow></m:menclose></m:math></para></problem>
<solution id="fs-id2213905">
<list id="eip-id1168289599609" list-type="labeled-item"><item><span class="token">ⓐ</span> ચોર્યાસી ભાગ્યા સાત; ચોર્યાસી અને સાતનું ભાગફળ</item><item><span class="token">ⓑ</span> અઢાર ભાગ્યા છ; અઢાર અને છનું ભાગફળ.</item><item><span class="token">ⓒ</span> ચોવીસ ભાગ્યા આઠ; ચોવીસ અને આઠનું ભાગફળ</item></list></solution>
</exercise></note>
<note id="fs-id1890702" class="try">
<exercise id="fs-id2173763"><problem id="fs-id1732080">
<para id="fs-id1910466">ગણિતની લખાવટને શબ્દોમાં ફેરવો:</para>
<para id="fs-id2266699"><span class="token">ⓐ</span> <m:math><m:mn>72</m:mn><m:mo>÷</m:mo><m:mn>9</m:mn></m:math> <span class="token">ⓑ</span> <m:math><m:mfrac><m:mrow><m:mn>21</m:mn></m:mrow><m:mn>3</m:mn></m:mfrac></m:math> <span class="token">ⓒ</span> <m:math><m:mn>6</m:mn><m:menclose notation="longdiv"><m:mrow><m:mn>54</m:mn></m:mrow></m:menclose></m:math></para></problem>
<solution id="fs-id1142294">
<list id="eip-id1168288418709" list-type="labeled-item"><item><span class="token">ⓐ</span> બોતેર ભાગ્યા નવ; બોતેર અને નવનું ભાગફળ</item> <item><span class="token">ⓑ</span> એકવીસ ભાગ્યા ત્રણ; એકવીસ અને ત્રણનું ભાગફળ</item><item><span class="token">ⓒ</span> ચોપન ભાગ્યા છ; ચોપન અને છનું ભાગફળ</item></list></solution>
</exercise></note>
</section><section id="fs-id2375603">
<title>પૂર્ણ સંખ્યાઓનો ભાગાકાર નમૂના દ્વારા દર્શાવો</title>
<para id="fs-id1919598">ગુણાકારની જેમ ભાગાકારનો નમૂનો બનાવવા પણ ગણતરીની ચકતીઓ વાપરીશું. ભાગાકારની ક્રિયા વસ્તુઓને સરખાં જૂથમાં ગોઠવવામાં મદદ કરે છે: ભાજ્ય જેટલી વસ્તુઓથી શરૂઆત કરીને ભાજક જેટલી સંખ્યા વારંવાર બાદ કરીએ છીએ.</para>
<note id="fs-id1168289315788" class="manipulative-math"> ગણિતની વસ્તુઓ વડે કરવાની કાર્યપત્રક પ્રવૃત્તિ “પૂર્ણ સંખ્યાઓનો ભાગાકાર નમૂના દ્વારા દર્શાવો” કરવાથી પૂર્ણ સંખ્યાઓના ભાગાકાર વિશેની સમજ વધશે.</note>
<example id="fs-id1918047">
<exercise id="fs-id2165553">
<problem id="fs-id2275767">
<para id="fs-id2922357">આ ભાગાકાર નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>24</m:mn><m:mo>÷</m:mo><m:mn>8</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2594141">
<title>ઉકેલ</title>
<para id="fs-id2496080">આ ભાગફળ શોધવા માટે: <m:math><m:mrow><m:mn>24</m:mn><m:mo>÷</m:mo><m:mn>8</m:mn><m:mo>,</m:mo></m:mrow></m:math> આપણે જાણવા માગીએ છીએ કે <m:math><m:mn>8</m:mn></m:math> વસ્તુવાળાં કેટલાં જૂથ બની શકે, આ સંખ્યામાંથી: <m:math><m:mrow><m:mn>24</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id2710696">ભાજ્યનો નમૂનો બનાવો. શરૂઆતમાં <m:math><m:mrow><m:mn>24</m:mn></m:mrow></m:math> ચકતીઓ લો.<newline />
<media id="fs-id3369757" alt="છૂટી મૂકેલી 24 ચકતીઓ.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_05_003_img.jpg" />
</media></para><para id="fs-id1732745">ભાજક દરેક જૂથમાં કેટલી ચકતીઓ જોઈએ તે જણાવે છે. દરેકમાં <m:math><m:mn>8</m:mn></m:math> ચકતીઓ હોય એવાં જૂથ બનાવો.<newline />
<media id="fs-id2197367" alt="24 ચકતીઓ 3 બંધ આકારમાં છે; દરેક આકારમાં 8 ચકતીઓ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_05_004_img.jpg" />
</media></para><para id="fs-id1207553">જૂથની સંખ્યા ગણો. કુલ <m:math><m:mn>3</m:mn></m:math> જૂથ છે.</para>
<para id="fs-id2314397"><m:math><m:mrow><m:mn>24</m:mn><m:mo>÷</m:mo><m:mn>8</m:mn><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</example>
<note id="fs-id1825932" class="try">
<exercise id="fs-id1805388">
<problem id="fs-id1882744">
<para id="fs-id1569277">નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>24</m:mn><m:mo>÷</m:mo><m:mn>6</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2661124">
<para id="fs-id1171103979421"><newline /><media id="fs-id2150327" alt="કોષ્ટક જેવી ગોઠવણીમાં ચાર અનિયમિત આકાર છે; દરેકમાં સાત રાખોડી વર્તુળ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_05_006_img.jpg" />
</media></para>
</solution>
</exercise>
</note>
<note id="fs-id1608097" class="try">
<exercise id="fs-id3340619">
<problem id="fs-id2300580">
<para id="fs-id1409139">નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>42</m:mn><m:mo>÷</m:mo><m:mn>7</m:mn><m:mo>.</m:mo></m:mrow></m:math></para></problem>
<solution id="fs-id1631311">
<para id="fs-id1171103194475"><newline /><media id="fs-id2606965" alt="છ અનિયમિત આકાર છૂટા ગોઠવેલા છે; દરેકમાં કેટલાંક નાનાં રાખોડી વર્તુળ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_05_007_img.jpg" />
</media></para></solution>
</exercise>
</note>
</section>
<section id="fs-id1861858"><title>પૂર્ણ સંખ્યાઓનો ભાગાકાર કરો</title><para id="fs-id1225369">આપણે કહ્યું કે સરવાળો અને બાદબાકી વિપરીત ક્રિયાઓ છે, કારણ કે એક ક્રિયા બીજી ક્રિયાની અસર દૂર કરે છે. તેવી જ રીતે ભાગાકાર ગુણાકારની વિપરીત ક્રિયા છે. આપણે જાણીએ છીએ કે <m:math><m:mrow><m:mn>12</m:mn><m:mo>÷</m:mo><m:mn>4</m:mn><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math> કારણ કે <m:math><m:mrow><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>4</m:mn><m:mo>=</m:mo><m:mn>12</m:mn><m:mo>.</m:mo></m:mrow></m:math> ભાગાકાર કરતી વખતે નાના ગુણાકારનાં બધાં પરિણામ આવડવાં ખૂબ જરૂરી છે.</para>
<para id="fs-id1279045">ભાગફળનો ભાજક વડે ગુણાકાર કરીને પરિણામ ભાજ્ય જેટલું થાય છે કે નહીં તે જોઈને ભાગાકારનો જવાબ તપાસીએ છીએ. આ ઉદાહરણમાં: <link target-id="fs-id1918047" />આપણે જાણીએ છીએ કે <m:math><m:mrow><m:mn>24</m:mn><m:mo>÷</m:mo><m:mn>8</m:mn><m:mo>=</m:mo><m:mn>3</m:mn></m:mrow></m:math> સાચું છે, કારણ કે <m:math><m:mrow><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>8</m:mn><m:mo>=</m:mo><m:mn>24</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<example id="fs-id1258127">
<exercise id="fs-id1512149"><problem id="fs-id2214838">
<para id="fs-id1373672">ભાગાકાર કરો. પછી ગુણાકાર કરીને તપાસો. <span class="token">ⓐ</span> <m:math><m:mn>42</m:mn><m:mo>÷</m:mo><m:mn>6</m:mn></m:math> <span class="token">ⓑ</span> <m:math><m:mfrac><m:mrow><m:mn>72</m:mn></m:mrow><m:mn>9</m:mn></m:mfrac></m:math> <span class="token">ⓒ</span> <m:math><m:mn>7</m:mn><m:menclose notation="longdiv"><m:mrow><m:mn>63</m:mn></m:mrow></m:menclose></m:math></para></problem>
<solution id="fs-id2287905">
<title>ઉકેલ</title>
<list id="eip-id1168288582694" list-type="labeled-item" class="circled"><item>
<table id="eip-id1168287031935" class="unnumbered unstyled" summary="42નો 6 વડે ભાગાકાર, ગણતરી અને ચકાસણીનાં પગલાં સાથે."><label /><tgroup cols="3"><tbody>
  <row><entry><span class="token">ⓐ</span> </entry><entry /></row>
<row>
    <entry />
    <entry><m:math><m:mrow><m:mn>42</m:mn><m:mo>÷</m:mo><m:mn>6</m:mn></m:mrow></m:math></entry>
  </row>
  <row>
    <entry>42નો 6 વડે ભાગાકાર કરો.</entry>
    <entry><m:math><m:mn>7</m:mn></m:math></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરીને તપાસો.<newline />
    <m:math><m:mn>7</m:mn><m:mo>·</m:mo><m:mn>6</m:mn></m:math></entry>
    <entry />
  </row>
  <row>
    <entry><m:math><m:mn>42</m:mn><m:mo>✓</m:mo></m:math></entry>
    <entry />
  </row>
</tbody>
</tgroup></table></item><item>
<table id="eip-id11682870335" class="unnumbered unstyled" summary="72નો 9 વડે ભાગાકાર, ગણતરી અને ચકાસણીનાં પગલાં સાથે."><label /><tgroup cols="3"><tbody>
  <row><entry><span class="token">ⓑ</span> </entry><entry /></row><row>
    <entry />
    <entry><m:math><m:mfrac><m:mrow><m:mn>72</m:mn></m:mrow><m:mn>9</m:mn></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>72નો 9 વડે ભાગાકાર કરો.</entry>
    <entry><m:math><m:mn>8</m:mn></m:math></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરીને તપાસો.<newline /><m:math><m:mn>8</m:mn><m:mo>·</m:mo><m:mn>9</m:mn></m:math></entry>
    <entry />
  </row>
  <row>
    <entry><m:math><m:mn>72</m:mn><m:mo>✓</m:mo></m:math></entry>
    <entry />
  </row>
</tbody>
</tgroup></table></item>
<item>
<table id="eip-id11670335" class="unnumbered unstyled" summary="63નો 7 વડે લાંબો ભાગાકાર કરવાનાં પગલાં, ગુણાકારથી ચકાસણી સહિત."><label /><tgroup cols="3"><tbody>
  <row><entry><span class="token">ⓒ</span> </entry><entry /></row><row>
    <entry />
    <entry><m:math><m:mn>7</m:mn><m:menclose notation="longdiv"><m:mrow><m:mn>63</m:mn></m:mrow></m:menclose></m:math></entry>
  </row>
  <row>
    <entry>63નો 7 વડે ભાગાકાર કરો.</entry>
    <entry><m:math><m:mn>9</m:mn></m:math></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરીને તપાસો.<newline />
    <m:math><m:mn>9</m:mn><m:mo>·</m:mo><m:mn>7</m:mn></m:math></entry>
    <entry />
  </row>
  <row>
    <entry><m:math><m:mn>63</m:mn><m:mo>✓</m:mo></m:math></entry>
    <entry />
  </row>
</tbody>
</tgroup>
</table></item></list>
</solution>
</exercise></example>
<note id="fs-id1960047" class="try">
<exercise id="fs-id1614042"><problem id="fs-id4160856">
<para id="fs-id2204458">ભાગાકાર કરો. પછી ગુણાકાર કરીને તપાસો:</para>
<para id="fs-id4876861"><span class="token">ⓐ</span> <m:math><m:mn>54</m:mn><m:mo>÷</m:mo><m:mn>6</m:mn></m:math> <span class="token">ⓑ</span> <m:math><m:mfrac><m:mrow><m:mn>27</m:mn></m:mrow><m:mn>9</m:mn></m:mfrac></m:math></para></problem>
<solution id="fs-id1607894">
<para id="eip-id1167977176469"> <span class="token">ⓐ</span> 9 <span class="token">ⓑ</span> 3</para></solution>
</exercise></note>
<note id="fs-id2199415" class="try">
<exercise id="fs-id1582307"><problem id="fs-id1777516">
<para id="fs-id3219784">ભાગાકાર કરો. પછી ગુણાકાર કરીને તપાસો:</para>
<para id="fs-id2323218"><span class="token">ⓐ</span> <m:math><m:mfrac><m:mrow><m:mn>36</m:mn></m:mrow><m:mn>9</m:mn></m:mfrac></m:math> <span class="token">ⓑ</span> <m:math><m:mn>8</m:mn><m:menclose notation="longdiv"><m:mrow><m:mn>40</m:mn></m:mrow></m:menclose></m:math></para></problem>
<solution id="fs-id2224558">
<para id="eip-id1169988674807"><span class="token">ⓐ</span> 4 <span class="token">ⓑ</span> 5</para></solution>
</exercise></note>
<para id="fs-id2202156">સંખ્યાનો તે જ સંખ્યા વડે ભાગાકાર કરતાં ભાગફળ કેટલું મળે?</para>
<equation id="fs-id2333898" class="unnumbered"><label /><m:math><m:mrow><m:mfrac><m:mrow><m:mn>15</m:mn></m:mrow><m:mrow><m:mn>15</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mn>1</m:mn><m:mspace width="0.2em" /><m:mtext>કારણ કે</m:mtext><m:mspace width="0.2em" /><m:mn>1</m:mn><m:mo>·</m:mo><m:mn>15</m:mn><m:mo>=</m:mo><m:mn>15</m:mn></m:mrow></m:math></equation><para id="fs-id2555680">કોઈ પણ સંખ્યાનો <m:math><m:mrow><m:mtext>(0 સિવાય)</m:mtext></m:mrow></m:math> તે જ સંખ્યા વડે ભાગાકાર કરતાં ભાગફળ મળે છે <m:math><m:mrow><m:mn>1</m:mn><m:mo>.</m:mo></m:mrow></m:math> તેમ જ કોઈ પણ સંખ્યાનો <m:math><m:mn>1</m:mn></m:math> વડે ભાગાકાર કરતાં એ જ સંખ્યા ભાગફળ તરીકે મળે છે. આ બે વાત એકને લગતા ભાગાકારના ગુણધર્મોમાં કહી છે.</para><note id="fs-id1774822"><title>એકને લગતા ભાગાકારના ગુણધર્મો</title><table id="eip-735" summary="આ કોષ્ટકમાં ભાગાકારના મૂળભૂત ગુણધર્મોના નિયમો અને તેમને અનુરૂપ ગણિતની પદાવલીઓ છે."><label />
<tgroup cols="3"><tbody>
  <row>
    <entry>કોઈ પણ સંખ્યા (0 સિવાય)નો તે જ સંખ્યા વડે ભાગાકાર કરતાં એક મળે છે.</entry>
    <entry><m:math><m:mi>a</m:mi><m:mo>÷</m:mo><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>1</m:mn></m:math></entry>
  </row>
  <row>
    <entry>કોઈ પણ સંખ્યાનો એક વડે ભાગાકાર કરતાં એ જ સંખ્યા મળે છે.</entry>
    <entry><m:math><m:mi>a</m:mi><m:mo>÷</m:mo><m:mi>1</m:mi><m:mo>=</m:mo><m:mn>a</m:mn></m:math></entry>
  </row>

</tbody>

</tgroup>
</table>
</note><example id="fs-id1893326"><exercise id="fs-id2418744"><problem id="fs-id1568881">
<para id="fs-id2371">ભાગાકાર કરો. પછી ગુણાકાર કરીને તપાસો:</para>
<list id="eip-id1168288568257" list-type="enumerated" number-style="arabic" class="circled"><item> <span class="token">ⓐ</span> <m:math><m:mn>11</m:mn><m:mo>÷</m:mo><m:mn>11</m:mn></m:math></item>
<item> <span class="token">ⓑ</span> <m:math><m:mfrac><m:mrow><m:mn>19</m:mn></m:mrow><m:mn>1</m:mn></m:mfrac></m:math></item>
<item> <span class="token">ⓒ</span> <m:math><m:mn>1</m:mn><m:menclose notation="longdiv"><m:mn>7</m:mn></m:menclose></m:math></item></list>
</problem>

<solution id="fs-id1851628">
<title>ઉકેલ</title>
<list id="eip-id1168288687352" list-type="labeled-item" class="circled"><item>


<table id="eip-id1168288480300" aria-label="ટી" class="unnumbered unstyled"><label /><tgroup cols="3"><tbody>
  <row><entry><span class="token">ⓐ</span> </entry><entry /></row>
<row>
    <entry />
    <entry><m:math><m:mn>11</m:mn><m:mo>÷</m:mo><m:mn>11</m:mn></m:math></entry>
  </row>
  <row>
    <entry>કોઈ સંખ્યાનો તે જ સંખ્યા વડે ભાગાકાર કરતાં 1 મળે છે.</entry>
    <entry><m:math><m:mn>1</m:mn></m:math></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરીને તપાસો.<newline /><m:math><m:mn>1</m:mn><m:mo>·</m:mo><m:mn>11</m:mn></m:math></entry>
    <entry />
  </row>
  <row>
    <entry><m:math><m:mn>11</m:mn><m:mo>✓</m:mo></m:math></entry>
    <entry />
  </row>
</tbody>

</tgroup>
</table></item>


<item>
<table id="eip-id1168288536381" aria-label="ટી" class="unnumbered unstyled"><label /><tgroup cols="3"><tbody>
  <row><entry><span class="token">ⓑ</span> </entry><entry /></row><row>
    <entry />
    <entry><m:math><m:mfrac><m:mrow><m:mn>19</m:mn></m:mrow><m:mrow><m:mn>1</m:mn></m:mrow></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>કોઈ સંખ્યાનો 1 વડે ભાગાકાર કરતાં એ જ સંખ્યા મળે છે.</entry>
    <entry><m:math><m:mn>19</m:mn></m:math></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરીને તપાસો.<newline /><m:math><m:mn>19</m:mn><m:mo>·</m:mo><m:mn>1</m:mn></m:math></entry>
    <entry />
  </row>
  <row>
    <entry><m:math><m:mn>19</m:mn><m:mo>✓</m:mo></m:math></entry>
    <entry />
  </row>
</tbody>

</tgroup>
</table></item>

<item>

<table id="eip-id1168289599719" aria-label="ટી" class="unnumbered unstyled"><label /><tgroup cols="3"><tbody>
  <row><entry><span class="token">ⓒ</span> </entry><entry /></row><row>
    <entry />
    <entry><m:math><m:mn>1</m:mn><m:menclose notation="longdiv"><m:mn>7</m:mn></m:menclose></m:math></entry>
  </row>
  <row>
    <entry>કોઈ સંખ્યાનો 1 વડે ભાગાકાર કરતાં એ જ સંખ્યા મળે છે.</entry>
    <entry><m:math><m:mn>7</m:mn></m:math></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરીને તપાસો.<newline /><m:math><m:mn>7</m:mn><m:mo>·</m:mo><m:mn>1</m:mn></m:math></entry>
    <entry />
  </row>
  <row>
    <entry><m:math><m:mn>7</m:mn><m:mo>✓</m:mo></m:math></entry>
    <entry />
  </row>
</tbody>


</tgroup>
</table></item>
</list></solution>
</exercise></example><note id="fs-id1409826" class="try">
<exercise id="fs-id1881615"><problem id="fs-id1746950">
<para id="fs-id1842669">ભાગાકાર કરો. પછી ગુણાકાર કરીને તપાસો:</para>
<para id="fs-id2140926"><span class="token">ⓐ</span> <m:math><m:mn>14</m:mn><m:mo>÷</m:mo><m:mn>14</m:mn></m:math> <span class="token">ⓑ</span> <m:math><m:mfrac><m:mrow><m:mn>27</m:mn></m:mrow><m:mn>1</m:mn></m:mfrac></m:math></para></problem>
<solution id="fs-id2325887">
<list id="eip-id1168288469568" class="circled" list-type="enumerated" number-style="arabic"><item><span class="token">ⓐ</span> 1</item><item><span class="token">ⓑ</span> 27</item></list></solution>
</exercise></note>
<note id="fs-id2835516" class="try">
<exercise id="fs-id2149691"><problem id="fs-id1285554">
<para id="fs-id2379661">ભાગાકાર કરો. પછી ગુણાકાર કરીને તપાસો:</para>
<para id="fs-id2607122"><span class="token">ⓐ</span> <m:math><m:mfrac><m:mrow><m:mn>16</m:mn></m:mrow><m:mn>1</m:mn></m:mfrac></m:math> <span class="token">ⓑ</span> <m:math><m:mn>1</m:mn><m:menclose notation="longdiv"><m:mn>4</m:mn></m:menclose></m:math></para></problem>
<solution id="fs-id2486533">
<list id="eip-id1168287219231" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> 16</item><item><span class="token">ⓑ</span> 4</item></list></solution>
</exercise></note>
<para id="fs-id1508917">ધારો કે આપણી પાસે <m:math><m:mrow><m:mtext>$0</m:mtext><m:mo>,</m:mo></m:mrow></m:math> છે અને તેને <m:math><m:mn>3</m:mn></m:math> વ્યક્તિઓમાં વહેંચવા માગીએ છીએ. દરેક વ્યક્તિને કેટલું મળે? દરેક વ્યક્તિને મળે <m:math><m:mrow><m:mtext>$0</m:mtext><m:mo>.</m:mo></m:mrow></m:math> શૂન્યનો કોઈ પણ સંખ્યા વડે ભાગાકાર કરતાં મળે છે <m:math><m:mrow><m:mn>0</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id1595186">હવે ધારો કે આપણે ભાગાકાર કરવા માગીએ છીએ: <m:math><m:mrow><m:mtext>$1</m:mtext><m:mn>0</m:mn></m:mrow></m:math> ભાગ્યા <m:math><m:mrow><m:mn>0</m:mn><m:mo>.</m:mo></m:mrow></m:math> એટલે એવી સંખ્યા શોધવી પડે કે જેનો ગુણાકાર <m:math><m:mn>0</m:mn></m:math> વડે કરતાં મળે <m:math><m:mrow><m:mn>10</m:mn><m:mo>.</m:mo></m:mrow></m:math> આ થઈ શકે નહીં, કારણ કે <m:math><m:mn>0</m:mn></m:math> ગુણ્યા કોઈ પણ સંખ્યા બરાબર <m:math><m:mrow><m:mn>0</m:mn><m:mo>.</m:mo></m:mrow></m:math> શૂન્ય વડે ભાગાકાર વિશે આપણે કહીએ છીએ કે તે <emphasis effect="italics">વ્યાખ્યાયિત નથી</emphasis>.</para>
<para id="fs-id2684817">આ બે વાત શૂન્યને લગતા ભાગાકારના ગુણધર્મો છે.</para><note id="fs-id2291485"><title>શૂન્યને લગતા ભાગાકારના ગુણધર્મો</title><table id="eip-158" summary="શૂન્યવાળા ભાગાકારના નિયમો, શબ્દોમાં વર્ણન અને અનુરૂપ ગણિતની પદાવલીઓ સાથે."><label />
<tgroup cols="3"><tbody>
  <row>
    <entry>શૂન્યનો કોઈ પણ સંખ્યા વડે ભાગાકાર કરતાં 0 મળે છે.</entry>
    <entry><m:math><m:mi>0</m:mi><m:mo>÷</m:mo><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>0</m:mn></m:math></entry>
  </row>
  <row>
    <entry>કોઈ સંખ્યાનો શૂન્ય વડે ભાગાકાર વ્યાખ્યાયિત નથી.</entry>
    <entry><m:math><m:mi>a</m:mi><m:mo>÷</m:mo><m:mi>0</m:mi></m:math> વ્યાખ્યાયિત નથી</entry>
  </row>
</tbody>

</tgroup>
</table>
</note><para id="fs-id2751522">શૂન્ય વડે ભાગાકાર કેમ વ્યાખ્યાયિત નથી તે સમજવાની બીજી રીત એ યાદ રાખવું છે કે ભાગાકાર ખરેખર પુનરાવર્તિત બાદબાકી છે. આ સંખ્યા કેટલી વાર બાદ કરી શકાય: <m:math><m:mn>0</m:mn></m:math> આ સંખ્યામાંથી: <m:math><m:mrow><m:mn>10</m:mn><m:mo>?</m:mo></m:mrow></m:math> કારણ કે <m:math><m:mn>0</m:mn></m:math> બાદ કરવાથી કુલ સંખ્યા ક્યારેય બદલાતી નથી, આપણને જવાબ ક્યારેય નહીં મળે. તેથી કોઈ સંખ્યાનો ભાગાકાર આ સંખ્યા વડે કરી શકાતો નથી: <m:math><m:mrow><m:mn>0</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<example id="fs-id2626690">
<exercise id="fs-id1361945"><problem id="fs-id1549268">
<para id="fs-id1318625">ભાગાકાર કરો. ગુણાકાર કરીને તપાસો: <span class="token">ⓐ</span> <m:math><m:mn>0</m:mn><m:mo>÷</m:mo><m:mn>3</m:mn></m:math> <span class="token">ⓑ</span> <m:math><m:mn>10</m:mn><m:mo stretchy="false">/</m:mo><m:mn>0</m:mn><m:mo>.</m:mo></m:math></para></problem>
<solution id="fs-id3265010">
<title>ઉકેલ</title>
<list id="eip-id1168288542862" list-type="labeled-item" class="circled"><item>
<table id="eip-id1168288542869" class="unnumbered unstyled" summary="શૂન્યનો શૂન્ય સિવાયની કોઈ પણ સંખ્યા વડે ભાગાકાર કરતાં શૂન્ય મળે છે, એ ગુણધર્મનું દર્શન અને ચકાસણી."><label /><tgroup cols="3">
<tbody>
  <row><entry><span class="token">ⓐ</span> </entry><entry /></row><row>
    <entry />
    <entry><m:math><m:mn>0</m:mn><m:mo>÷</m:mo><m:mn>3</m:mn></m:math></entry>
  </row>
  <row>
    <entry>શૂન્યનો કોઈ પણ સંખ્યા વડે ભાગાકાર કરતાં શૂન્ય મળે છે.</entry>
    <entry><m:math><m:mn>0</m:mn></m:math></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરીને તપાસો.<newline /><m:math><m:mn>0</m:mn><m:mo>·</m:mo><m:mn>3</m:mn></m:math></entry>
    <entry />
  </row>
  <row>
    <entry><m:math><m:mn>0</m:mn><m:mo>✓</m:mo></m:math></entry>
    <entry />
  </row>
</tbody>
</tgroup>
</table></item>
<item>
<table id="eip-id1168288419363" class="unnumbered unstyled" summary="શૂન્ય વડે ભાગાકાર વ્યાખ્યાયિત નથી: ગણિતની પદાવલી અને તેની પરિણામી સ્થિતિ."><label /><tgroup cols="3">
<tbody>
  <row><entry><span class="token">ⓑ</span> </entry><entry /></row><row>
    <entry />
    <entry><m:math><m:mn>10</m:mn><m:mo stretchy="false">/</m:mo><m:mn>0</m:mn></m:math></entry>
  </row>
  <row>
    <entry>શૂન્ય વડે ભાગાકાર વ્યાખ્યાયિત નથી.</entry>
    <entry>વ્યાખ્યાયિત નથી</entry>
  </row>
</tbody>
</tgroup></table></item>

</list></solution>
</exercise></example>
<note id="fs-id1973417" class="try">
<exercise id="fs-id1491870"><problem id="fs-id1890678">
<para id="fs-id2297273">ભાગાકાર કરો. પછી ગુણાકાર કરીને તપાસો:</para>
<para id="fs-id2197190"><span class="token">ⓐ</span> <m:math><m:mn>0</m:mn><m:mo>÷</m:mo><m:mn>2</m:mn></m:math> <span class="token">ⓑ</span> <m:math><m:mn>17</m:mn><m:mo stretchy="false">/</m:mo><m:mn>0</m:mn></m:math></para></problem>
<solution id="fs-id4428703">
<para id="eip-id1796438"><span class="token">ⓐ</span> 0 <span class="token">ⓑ</span> વ્યાખ્યાયિત નથી</para></solution>
</exercise></note>
<note id="fs-id1826030" class="try">
<exercise id="fs-id1972877"><problem id="fs-id2942872">
<para id="fs-id2597517">ભાગાકાર કરો. પછી ગુણાકાર કરીને તપાસો:</para>
<para id="fs-id1348278"><span class="token">ⓐ</span> <m:math><m:mn>0</m:mn><m:mo>÷</m:mo><m:mn>6</m:mn></m:math> <span class="token">ⓑ</span> <m:math><m:mn>13</m:mn><m:mo stretchy="false">/</m:mo><m:mn>0</m:mn></m:math></para></problem>
<solution id="fs-id3320410">
<para id="eip-id1172102234480"><span class="token">ⓐ</span> 0 <span class="token">ⓑ</span> વ્યાખ્યાયિત નથી</para></solution>
</exercise></note>
<para id="fs-id2384199">ભાજક કે ભાજ્યમાં એક કરતાં વધારે અંક હોય ત્યારે સામાન્ય રીતે આ લખાવટ વાપરવી સહેલી પડે છે: <m:math><m:mrow><m:mn>4</m:mn><m:menclose notation="longdiv"><m:mrow><m:mn>12</m:mn></m:mrow></m:menclose></m:mrow></m:math> . આ પ્રક્રિયાને લાંબો ભાગાકાર કહે છે. ચાલો, આ પ્રક્રિયાથી <m:math><m:mrow><m:mn>78</m:mn></m:mrow></m:math> નો ભાગાકાર કરીએ, આ સંખ્યા વડે: <m:math><m:mrow><m:mn>3</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>

<table id="eip-244" class="unnumbered unstyled" aria-label="આ ચિત્રમાં 2 સ્તંભ છે. ડાબા સ્તંભમાં સૂચનાઓ અને જમણા સ્તંભમાં પદાવલીઓ છે. ઉકેલાતો પ્રશ્ન 78 ભાગ્યા 3 છે. પહેલી પંક્તિ કહે છે: ભાજ્યના પહેલા અંક 7નો ભાજક 3 વડે ભાગાકાર કરો. આગળની પંક્તિ કહે છે: ભાજક 3ને 7માંથી બે વાર બાદ કરી શકાય, કારણ કે 2 ગુણ્યા 3 બરાબર 6. ભાગફળમાં 2ને 7ની ઉપર લખો. તેની પાસે 3 ભાગ્યા 78ની પદાવલીમાં ભાગફળનો બે સાતની ઉપર છે. આગળની પંક્તિ કહે છે: ભાગફળના 2નો 3 વડે ગુણાકાર કરો અને ગુણનફળ 6ને 7ની નીચે લખો. હવે પદાવલીમાં 6 સાતની નીચે છે. આગળની પંક્તિ કહે છે: તે ગુણનફળ ભાજ્યના પહેલા અંકમાંથી બાદ કરો. 7 ઓછા 6 કરો. તફાવત 1ને ભાજ્યના પહેલા અંકની નીચે લખો. હવે પદાવલીમાં 6ને 7માંથી બાદ કરતાં તફાવત 1 દર્શાવેલો છે. આગળની પંક્તિ ભાજ્યનો આગળનો અંક નીચે ઉતારવાનું કહે છે. 8ને નીચે ઉતારો. હવે પદાવલીમાં 8ને 1ની પાસે નીચે ઉતારેલો છે. આગળની પંક્તિમાં 18નો ભાજક 3 વડે ભાગાકાર કરવાનું કહે છે. ભાજક 3ને 18માંથી છ વાર બાદ કરી શકાય. ભાગફળમાં 6ને 8ની ઉપર લખો. પદાવલીમાં ભાગફળનો 6, અંક 8ની ઉપર છે. છેલ્લે ભાગફળના 6નો ભાજક વડે ગુણાકાર કરીને ગુણનફળ 18ને ભાજ્યની નીચે લખવાનું કહે છે. 18ને 18માંથી બાદ કરો. લાંબા ભાગાકારમાં 18 ઓછા 18 બરાબર શૂન્ય દર્શાવેલું છે."><label /><tgroup cols="3"><tbody>
  <row>
    <entry>ભાજ્યના પહેલા અંક 7નો ભાજક 3 વડે ભાગાકાર કરો.</entry>
    <entry />
  </row>
  <row>
    <entry>ભાજક 3ને 7માંથી બે વાર બાદ કરી શકાય, કારણ કે <m:math><m:mn>2</m:mn><m:mo>×</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>6</m:mn></m:math>. ભાગફળમાં 2ને 7ની ઉપર લખો.</entry>
     <entry><media id="eip-id1168289669181" alt="78નો 3 વડે લાંબો ભાગાકાર. શરૂઆતમાં 7નો 3 વડે ભાગાકાર કરતાં ભાગફળનો પહેલો અંક 2 મળે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_05_043_img-02.png" /></media></entry>
  </row>
  <row>
     <entry>ભાગફળના 2નો 3 વડે ગુણાકાર કરો અને ગુણનફળ 6ને 7ની નીચે લખો.</entry>
    <entry><media id="eip-id1168287242183" alt="78નો 3 વડે લાંબો ભાગાકાર કરવાનું પહેલું પગલું. અંક 7નો 3 વડે ભાગાકાર કરતાં ભાગફળ 2 અને શેષ 1 મળે છે, જ્યારે 6 બાદ કરવામાં આવે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_05_043_img-03.png" /></media></entry>
  </row>
  <row>
    <entry>તે ગુણનફળ ભાજ્યના પહેલા અંકમાંથી બાદ કરો. બાદબાકી કરો: <m:math><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>6</m:mn></m:math>. તફાવત 1ને ભાજ્યના પહેલા અંકની નીચે લખો.</entry>
       <entry><media id="eip-id1168289488126" alt="78નો 3 વડે લાંબો ભાગાકાર કરવાનું પહેલું પગલું. અંક 7નો 3 વડે ભાગાકાર કરતાં ભાગફળ 2 અને શેષ 1 મળે છે, જ્યારે 6 બાદ કરવામાં આવે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_05_043_img-04.png" /></media></entry>
  </row>
  <row>
<entry>ભાજ્યનો આગળનો અંક નીચે ઉતારો. 8ને નીચે ઉતારો.</entry>
     <entry><media id="eip-id1168288521347" alt="78નો 3 વડે લાંબો ભાગાકાર કરવાનું આગળનું પગલું. અંક 6ને 7માંથી બાદ કરતાં 1 મળે છે. અંક 8 નીચે ઉતારતાં 18 બને છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_05_043_img-05.png" /></media></entry>
  </row>

  <row>
<entry>18નો ભાજક 3 વડે ભાગાકાર કરો. ભાજક 3ને 18માંથી છ વાર બાદ કરી શકાય.
    </entry>
    <entry morerows="1"><media id="eip-id1168288636395" alt="78નો 3 વડે લાંબો ભાગાકાર કરવાનું આગળનું પગલું. આ પગલામાં 18નો 3 વડે ભાગાકાર કરીએ છીએ. મળેલો અંક 6 ભાગાકારની ઉપર લખવાથી આખો જવાબ 26 મળે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_05_043_img-06.png" /></media></entry>
  </row>

  <row>
  <entry valign="bottom">    ભાગફળમાં 6ને 8ની ઉપર લખો.</entry>
  <entry />
  </row>

  <row>
<entry>ભાગફળના 6નો ભાજક વડે ગુણાકાર કરો અને ગુણનફળ 18ને ભાજ્યની નીચે લખો. 18માંથી 18 બાદ કરો.</entry>
    <entry><media id="eip-id1168288418374" alt="78નો 3 વડે લાંબો ભાગાકાર કરવાનું છેલ્લું પગલું. 18નો 3 વડે નિઃશેષ ભાગાકાર થાય છે; શેષ શૂન્ય અને આખો જવાબ 26 મળે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_05_043_img-07.png" /></media></entry>
  </row>
</tbody>





</tgroup>
</table><para id="fs-id2168392">ભાજ્યમાં નીચે ઉતારવા માટે કોઈ અંક બાકી ન રહે ત્યાં સુધી આ પ્રક્રિયા ફરી કરતા જઈએ. આ પ્રશ્નમાં નીચે ઉતારવા માટે કોઈ અંક બાકી નથી, તેથી ભાગાકાર પૂરો થયો.</para>
<equation id="fs-id1372054" class="unnumbered"><label /><m:math><m:mrow><m:mtext>તેથી</m:mtext><m:mspace width="0.2em" /><m:mn>78</m:mn><m:mo>÷</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>26</m:mn><m:mo>.</m:mo></m:mrow></m:math></equation>
<para id="fs-id1894799">ભાગફળનો ભાજક વડે ગુણાકાર કરતાં ભાજ્ય મળે છે કે નહીં તે તપાસો. ગુણાકાર કરો: <m:math><m:mrow><m:mn>26</m:mn><m:mspace width="0.2em" /><m:mo>×</m:mo><m:mspace width="0.2em" /><m:mn>3</m:mn></m:mrow></m:math> . તેનું ગુણનફળ ભાજ્ય જેટલું છે કે નહીં તે ખાતરી કરો: <m:math><m:mrow><m:mn>78</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<equation id="eip-id1167115915449" class="unnumbered"><m:math><m:mtable><m:mtr><m:mtd columnalign="right"><m:mover><m:mn>2</m:mn><m:mn mathsize="small">1</m:mn></m:mover><m:mn>6</m:mn><m:mspace width="1.3em" /></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:munder accentunder="true"><m:mrow><m:mo>×</m:mo><m:mn>3</m:mn></m:mrow><m:mtext>___</m:mtext></m:munder><m:mspace width="1.1em" /></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>78</m:mn><m:mo>✓</m:mo></m:mtd></m:mtr></m:mtable></m:math></equation><para id="fs-id2261231">તે ભાજ્ય જેટલું જ છે, તેથી આપણો જવાબ સાચો છે.</para>
<note id="fs-id1969382" class="howto"><title>પૂર્ણ સંખ્યાઓનો ભાગાકાર કરો.</title><list id="eip-id1168288534169" list-type="enumerated" number-style="arabic" class="stepwise"><item>ભાજ્યના પહેલા અંકનો ભાજક વડે ભાગાકાર કરો.
<newline />જો ભાજક ભાજ્યના પહેલા અંક કરતાં મોટો હોય, તો ભાજ્યના પહેલા બે અંકથી બનતી સંખ્યાનો ભાજક વડે ભાગાકાર કરો; જરૂર પડે તો એ જ રીતે આગળ વધો.</item>

<item>ભાગફળ ભાજ્યની ઉપર લખો.</item>
<item>ભાગફળનો ભાજક વડે ગુણાકાર કરો અને ગુણનફળ ભાજ્યની નીચે લખો.</item>
<item>તે ગુણનફળ ભાજ્યમાંથી બાદ કરો.</item>
<item>ભાજ્યનો આગળનો અંક નીચે ઉતારો.</item>
<item>ભાજ્યમાં નીચે ઉતારવા માટે કોઈ અંક બાકી ન રહે ત્યાં સુધી પગલું 1થી ફરી કરો.</item>
<item>ભાગફળનો ભાજક વડે ગુણાકાર કરીને તપાસો.</item>
</list></note><example id="fs-id2817427"><exercise id="fs-id1231874"><problem id="fs-id3217661">
<para id="fs-id2146634">ભાગાકાર કરો: <m:math><m:mrow><m:mn>2,596</m:mn><m:mo>÷</m:mo><m:mn>4</m:mn><m:mo>.</m:mo></m:mrow></m:math> ગુણાકાર કરીને તપાસો:</para>
</problem>
<solution id="fs-id3408306">
<title>ઉકેલ</title>
<table id="eip-287" class="unnumbered unstyled" aria-label="આ ચિત્રમાં 4 ભાગ્યા 2,596ની પદાવલી ઉકેલવા લાંબો ભાગાકાર છે. પહેલી પંક્તિ ભાજ્યના પહેલા અંક 2નો ભાજક 4 વડે ભાગાકાર કરવાનું કહે છે. પદાવલીમાં 2 લાલ રંગનો છે. આગળની પંક્તિ કહે છે કે 4ને 2માંથી એક વાર પણ બાદ ન કરી શકાય, તેથી ભાજ્યના પહેલા બે અંકથી બનેલી સંખ્યા 25નો 4 વડે ભાગાકાર કરીએ. ભાજક 4ને 25માંથી છ વાર બાદ કરી શકાય. ભાગફળમાં છને 5ની ઉપર લખીએ. હવે પદાવલીમાં ભાગફળનો 6, અંક 5ની ઉપર છે. પછી ભાગફળના 6નો ભાજક 4 વડે ગુણાકાર કરો અને ગુણનફળ 24ને ભાજ્યના પહેલા બે અંકની નીચે લખો. પદાવલીમાં 24, સંખ્યા 25ની નીચે છે. 25 ઓછા 4 કરો. તફાવત 1ને ભાજ્યના બીજા અંકની નીચે લખો. લાંબા ભાગાકારમાં 25 ઓછા 24 બરાબર 1 છે. હવે 9ને નીચે ઉતારો અને આ પગલાં ફરી કરો. ચારના 4 જૂથ 19માં સમાય છે. 4ને 9ની ઉપર લખો. 4નો 4 વડે ગુણાકાર કરો અને આ ગુણનફળ 19માંથી બાદ કરો. હવે લાંબા ભાગાકારમાં ભાજ્યનો 9, અંક 1ની પાસે નીચે ઉતારવાથી 19 બને છે; ભાગફળનો 4, અંક 9ની ઉપર છે. 19ની નીચે 16 છે અને તફાવત 3 છે. આગળની પંક્તિ 6ને નીચે ઉતારી આ પગલાં ફરી કરવાનું કહે છે. ચારના 9 જૂથ 36માં સમાય છે. 9ને 6ની ઉપર લખો. 9નો 4 વડે ગુણાકાર કરો અને આ ગુણનફળ 36માંથી બાદ કરો. લાંબા ભાગાકારમાં 6ને 3ની પાસે નીચે ઉતારવાથી 36 બને છે. ભાગફળનો 9, અંક 6ની ઉપર છે અને જવાબ 649 છે."><label /><tgroup cols="3"><tbody>
  <row>
    <entry>લાંબો ભાગાકાર કરવા માટે પ્રશ્ન ફરી ગોઠવીને લખીએ.</entry>
    <entry><media id="eip-id1168287469438" alt="2596નો 4 વડે લાંબો ભાગાકાર કરવા માટે ગોઠવેલો પ્રશ્ન."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_05_044_img-01.png" /></media></entry>
  </row>
  <row>
    <entry>ભાજ્યના પહેલા અંક 2નો ભાજક 4 વડે ભાગાકાર કરો.</entry>
    <entry><media id="eip-id1168288487381" alt="2596નો 4 વડે લાંબો ભાગાકાર કરવા માટે ગોઠવેલો પ્રશ્ન. પહેલો અંક 2 લાલ રંગનો છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_05_044_img-02.png" /></media></entry>
  </row>
  <row>
    <entry valign="bottom">4ને 2માંથી એક વાર પણ બાદ ન કરી શકાય, તેથી ભાજ્યના પહેલા બે અંકથી બનેલી સંખ્યા 25નો 4 વડે ભાગાકાર કરીએ. ભાજક 4ને 25માંથી છ વાર બાદ કરી શકાય.</entry>
    <entry />
  </row>

  <row>
    <entry>ભાગફળમાં 6ને 5ની ઉપર લખીએ.</entry>
    <entry><media id="eip-id1168288233789" alt="2596નો 4 વડે લાંબો ભાગાકાર. ભાગફળનો પહેલો અંક 6, અંક 5ની ઉપર છે; તે 25 ભાગ્યા 4 બરાબર 6 દર્શાવે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_05_044_img-03.png" /></media></entry>
  </row>
  <row>
    <entry>ભાગફળના 6નો ભાજક 4 વડે ગુણાકાર કરો અને ગુણનફળ 24ને ભાજ્યના પહેલા બે અંકની નીચે લખો.</entry>
    <entry><media id="eip-id1168288285828" alt="2596નો 4 વડે લાંબો ભાગાકાર. પહેલા પગલામાં 4ને 25માંથી છ વાર બાદ કરી શકાય છે; લાલ રંગે 24ને 25ની નીચે લખેલું છે, જે 4 અને 6નું ગુણનફળ દર્શાવે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_05_044_img-04.png" /></media></entry>
  </row>
  <row>
    <entry>તે ગુણનફળ ભાજ્યના પહેલા બે અંકથી બનેલી સંખ્યામાંથી બાદ કરો. બાદબાકી કરો: <m:math><m:mn>25</m:mn><m:mo>−</m:mo><m:mn>24</m:mn></m:math>. તફાવત 1ને ભાજ્યના બીજા અંકની નીચે લખો.</entry>
    <entry><media id="eip-id1168288286036" alt="2596નો 4 વડે લાંબો ભાગાકાર. પહેલા પગલામાં 4ને 25માંથી છ વાર બાદ કરી શકાય છે; લાલ રંગે 24ને 25ની નીચે લખેલું છે, જે 4 અને 6નું ગુણનફળ દર્શાવે છે. 24ને 25માંથી બાદ કરતાં શેષ 1 રહે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_05_044_img-05.png" /></media></entry>
  </row>
  <row>
    <entry>હવે 9ને નીચે ઉતારો અને આ પગલાં ફરી કરો. ચારના 4 જૂથ 19માં સમાય છે. 4ને 9ની ઉપર લખો. 4નો 4 વડે ગુણાકાર કરો અને આ ગુણનફળ 19માંથી બાદ કરો.</entry>
    <entry><media id="eip-id1168288541565" alt="2596નો 4 વડે લાંબો ભાગાકાર. આગળના પગલામાં ભાગફળનો ત્રીજો અંક 9 નીચે ઉતારતાં 19 બને છે; હવે તેનો 4 વડે ભાગાકાર કરવાનો છે. 4ને 19માંથી ચાર વાર બાદ કરી શકાય છે (16ને 19ની નીચે લખેલું છે). ચારને 2596ની ઉપર લખેલું છે. છેલ્લે 19 ઓછા 16 કરતાં શેષ 3 રહે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_05_044_img-06.png" /></media></entry>
  </row>
  <row>
    <entry>6ને નીચે ઉતારો અને આ પગલાં ફરી કરો. ચારના 9 જૂથ 36માં સમાય છે. 9ને 6ની ઉપર લખો. 9નો 4 વડે ગુણાકાર કરો અને આ ગુણનફળ 36માંથી બાદ કરો. </entry>
    <entry><media id="eip-id1168288361738" alt="2596નો 4 વડે લાંબો ભાગાકાર, જેમાં શેષ વિના 649 મળે છે અને ભાગાકારનાં પગલાં દર્શાવેલાં છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_05_044_img-07.png" /></media></entry>
  </row>
  <row>
     <entry>તેથી <m:math><m:mn>2,596</m:mn><m:mo>÷</m:mo><m:mn>4</m:mn><m:mo>=</m:mo><m:mn>649</m:mn></m:math>.</entry>
     <entry />
  </row>
  <row>
    <entry>ગુણાકાર કરીને તપાસો.<newline /><media id="eip-id1168289429498" alt="649નો 4 વડે ગુણાકાર કરતાં 2596 મળે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_01_05_044_img-08.png" /></media></entry>
    <entry />
  </row>
</tbody>





</tgroup>
</table><para id="fs-id3294278">આ ભાજ્ય જેટલું છે, તેથી આપણો જવાબ સાચો છે.</para>
</solution>
</exercise></example><note id="fs-id1404611" class="try">
