</problem>
</exercise>
<exercise id="fs-id1224228">
<problem id="fs-id1224231">
<para id="fs-id1798725"><m:math><m:mrow><m:mn>1,020</m:mn><m:mo>−</m:mo><m:mn>640</m:mn></m:mrow></m:math></para>
