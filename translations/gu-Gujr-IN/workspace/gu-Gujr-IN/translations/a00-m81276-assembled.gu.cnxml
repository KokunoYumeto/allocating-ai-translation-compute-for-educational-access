<?xml version='1.0' encoding='utf-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" xmlns:ns1="http://cnx.rice.edu/mdml" xml:lang="gu-Gujr-IN">
<title>પૂર્ણાંકોનો સરવાળો કરો</title>
<metadata>
  <ns1:content-id>m81276</ns1:content-id>
  <ns1:title>પૂર્ણાંકોનો સરવાળો કરો</ns1:title>
  <ns1:abstract><para id="para-00001">આ વિભાગના અંતે તમે આ કરી શકશો:</para>
<list id="list-00001">
<item>પૂર્ણાંકોના સરવાળાને નમૂના દ્વારા દર્શાવી શકશો</item>
<item>પૂર્ણાંકો ધરાવતી પદાવલીઓ સરળ કરી શકશો</item>
<item>પૂર્ણાંકો ધરાવતી ચલ પદાવલીઓની કિંમત શોધી શકશો</item>
<item>શબ્દસમૂહોને બીજગણિતીય પદાવલીઓમાં ફેરવી શકશો</item>
<item>વ્યવહારુ પ્રશ્નોમાં પૂર્ણાંકોનો સરવાળો કરી શકશો</item>
</list></ns1:abstract>
  <ns1:uuid>8a49b727-d592-4930-8e54-9b30c1eba914</ns1:uuid>
</metadata>

<content>
<note id="fs-id1345758" class="be-prepared"><para id="fs-id1619045">શરૂઆત કરતાં પહેલાં તૈયારીની આ કસોટી કરો.</para>
<exercise id="fs-idm348977680">
<problem id="fs-idm321812832">
<para id="fs-idm329709424">કિંમત શોધો <m:math><m:mrow><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>6</m:mn><m:mo>.</m:mo></m:mrow></m:math><newline />
જો આ પ્રશ્નનો જવાબ ન મળ્યો હોય, તો ફરી જુઓ <link target-id="fs-id2202625" document="m81270" />.</para>
</problem>
<solution id="fs-idm352199760">
<para id="fs-idm324616304"><m:math><m:mrow><m:mn>14</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-idm352813440">
<problem id="fs-idm326298720">
<para id="fs-idm320129008">સરળ કરો: <m:math><m:mrow><m:mn>8</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>5</m:mn><m:mo>+</m:mo><m:mn>1</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math><newline />
જો આ પ્રશ્નનો જવાબ ન મળ્યો હોય, તો ફરી જુઓ <link target-id="fs-id1949613" document="m81268" />.</para>
</problem>
<solution id="fs-idm319789344">
<para id="fs-idm345642416"><m:math><m:mrow><m:mn>20</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
<exercise id="fs-idm349179216">
<problem id="fs-idm335249888">
<para id="fs-idm321825280">ફેરવો <emphasis effect="italics">આનો સરવાળો:</emphasis> <m:math><m:mrow><m:mi>3</m:mi></m:mrow></m:math> <emphasis effect="italics">અને ઋણ</emphasis> <m:math><m:mrow><m:mi>7</m:mi></m:mrow></m:math> ને બીજગણિતીય પદાવલીમાં ફેરવો.<newline />
આ પ્રશ્ન ન આવડ્યો હોય તો ફરી જુઓ: <link target-id="eip-386" document="m81270" /></para>
</problem>
<solution id="fs-idm352263264">
<para id="fs-idm348436240"><m:math><m:mrow><m:mn>3</m:mn><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</solution>
</exercise>
</note><section id="fs-id1166761433818">
<title>પૂર્ણાંકોના સરવાળાને નમૂના દ્વારા દર્શાવો</title>
<para id="eip-438">હવે આપણે સંખ્યારેખા પર ધન અને ઋણ સંખ્યાઓનાં સ્થાન દર્શાવી ચૂક્યા છીએ, તેથી હવે <term class="no-emphasis" id="term-00001">પૂર્ણાંકો સાથેની અંકગણિતની ક્રિયાઓની ચર્ચા કરવાનો સમય છે</term>.</para><para id="eip-165">મોટા ભાગના વિદ્યાર્થીઓને ધન સંખ્યાઓના સરવાળા અને બાદબાકીના તથ્યો સારી રીતે આવડે છે. પરંતુ ધન અને ઋણ બંને સંખ્યાઓ સાથે સરવાળો કે બાદબાકી કરવી વધુ મુશ્કેલ લાગી શકે છે. આ મુશ્કેલી મગજ શીખે છે તેની રીત સાથે જોડાયેલી છે.</para><para id="fs-id1166761426725">મગજ રોજિંદા જીવનની વસ્તુઓ સાથે કામ કરીને અને પછી તેમાંથી અમૂર્ત ખ્યાલ તારવીને સૌથી સારી રીતે શીખે છે. નાનાં બાળકો તરત શીખે છે કે તેમની પાસે બે બિસ્કિટ હોય અને તેમનો મોટો ભાઈ એક લઈ લે, તો તેમની પાસે માત્ર એક બચે છે. આ તેનું મૂર્ત ઉદાહરણ છે: <m:math><m:mrow><m:mn>2</m:mn><m:mo>−</m:mo><m:mn>1</m:mn><m:mo>.</m:mo></m:mrow></m:math> બાળકો રોજિંદા જીવનના અનુભવોમાંથી સરવાળા અને બાદબાકીનાં મૂળભૂત તથ્યો શીખે છે. અંતે તેઓ બિસ્કિટ પર આધાર રાખ્યા વિના સંખ્યાનાં તથ્યો જાણી લે છે.</para><para id="fs-id1166761420837">ઋણ સંખ્યાઓના સરવાળા અને બાદબાકીનાં રોજિંદા જીવનમાં આપણને અર્થપૂર્ણ લાગે એવાં ઉદાહરણો ઓછાં છે. આ ખ્યાલોને મૂર્ત બનાવવા ગણિતના શિક્ષકો સંખ્યારેખા, બૅન્કિંગ, તાપમાન વગેરે જેવી જુદી જુદી રીતો વાપરે છે.</para>
<para id="fs-id1166761477082">આપણે બે રંગના કાઉન્ટર વડે ઋણ સંખ્યાઓના સરવાળા અને બાદબાકીના નમૂના બનાવીશું. વાદળી કાઉન્ટર ધન સંખ્યા અને લાલ કાઉન્ટર ઋણ સંખ્યા દર્શાવે છે.</para>
<media id="fs-id1166761481032" alt="ચિત્રમાં “ધન” લખેલું એક વાદળી વર્તુળ અને “ઋણ” લખેલું એક લાલ વર્તુળ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_024_img.jpg" />
</media>
<para id="fs-id1166761480980">આપણી પાસે એક ધન અને એક ઋણ કાઉન્ટર હોય, તો આ જોડીનું મૂલ્ય શૂન્ય છે. તેઓ બનાવે છે એક <term class="no-emphasis" id="term-00002">શૂન્ય બનાવતી જોડી</term>. આ જોડીનું મૂલ્ય શૂન્ય છે, જેનો સાર આગળની આકૃતિમાં આપ્યો છે <link target-id="CNX_BMath_Figure_03_02_001" />.</para>
<figure id="CNX_BMath_Figure_03_02_001">
<media id="fs-id1166761426480" alt="ચિત્રમાં વાદળી વર્તુળની નીચે લાલ વર્તુળ છે. તેમની બાજુમાં 1 + (−1) = 0 લખેલું છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_001.jpg" />
</media>
<caption>વાદળી કાઉન્ટર દર્શાવે છે <m:math><m:mrow><m:mo>+</m:mo><m:mn>1</m:mn><m:mo>.</m:mo></m:mrow></m:math> લાલ કાઉન્ટર દર્શાવે છે <m:math><m:mrow><m:mn>−1</m:mn><m:mo>.</m:mo></m:mrow></m:math> બંનેનો સરવાળો શૂન્ય થાય છે.</caption>
</figure>
<note id="eip-425" class="manipulative-math">“નિશાનીવાળી સંખ્યાઓનો સરવાળો” નામની હેરફેરની વસ્તુઓ વડે ગણિતની પ્રવૃત્તિ કરવાથી પૂર્ણાંકોનો સરવાળો વધુ સારી રીતે સમજવામાં મદદ મળશે.</note><para id="fs-id1166761426642">આપણે આ સંખ્યાઓ વડે સરવાળાનાં ચાર તથ્યોના નમૂના બનાવીશું:  <m:math><m:mrow><m:mn>5</m:mn><m:mo>,</m:mo><m:mn>−5</m:mn><m:mspace width="0.2em" /><m:mtext> અને </m:mtext><m:mspace width="0.2em" /><m:mn>3</m:mn><m:mspace width="0.2em" /><m:mo>,</m:mo><m:mn>−3</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<equation id="fs-id1166761433872" class="unnumbered"><label /><m:math><m:mrow><m:mn>5</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mspace width="1em" /><m:mn>−5</m:mn><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>−3</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mspace width="1em" /><m:mn>−5</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mspace width="1em" /><m:mn>5</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></equation>
<example id="fs-id1166761468356"><exercise id="fs-id1166761480099">
<problem id="fs-id1166761477197">
<para id="fs-id1166761477199">નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>5</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>.</m:mo></m:mrow></m:math>
</para>
</problem>
<solution id="fs-id1166761430553">
<title>ઉકેલ</title>
<table id="eip-id1168469436825" class="unnumbered unstyled" aria-label="ચિત્રમાં પાંચ હરોળ છે. પહેલી હરોળ પદાવલીનો અર્થ સમજવાનું કહે છે: 5 + 3 એટલે 5 અને 3નો સરવાળો. બીજી હરોળ પ્રથમ સંખ્યાનો નમૂનો બનાવવાનું અને 5 ધન કાઉન્ટરથી શરૂ કરવાનું કહે છે; તેમાં 5 વાદળી વર્તુળ છે. ત્રીજી હરોળ બીજી સંખ્યાનો નમૂનો બનાવી 3 ધન કાઉન્ટર ઉમેરવાનું કહે છે; તેમાં 5 વાદળી વર્તુળ પછી 3 વાદળી વર્તુળ છે. પછીની હરોળ કુલ કાઉન્ટર ગણવાનું કહે છે અને તેની પછી 8 વાદળી વર્તુળ છે. પાંચમી હરોળ કહે છે કે 5 અને 3નો સરવાળો 8 છે અને પછી 5 + 3 = 8 દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry>પદાવલીનો અર્થ સમજો.</entry>
   <entry><m:math><m:mn>5</m:mn><m:mo>+</m:mo><m:mn>3</m:mn></m:math> એટલે આનો સરવાળો: <m:math><m:mn>5</m:mn></m:math> અને <m:math><m:mn>3</m:mn></m:math>.</entry>
 </row>
 <row>
   <entry>પ્રથમ સંખ્યાનો નમૂનો બનાવો. 5 ધન કાઉન્ટરથી શરૂ કરો.</entry>
   <entry><media id="eip-id1168469859334" alt="પાંચ આછાં વાદળી વર્તુળ આડી હરોળમાં છે અને વચ્ચેના વર્તુળની સીધી નીચે “5” લખેલું છે, જે વર્તુળોની કુલ સંખ્યા દર્શાવે છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_025_img-01.png" /></media></entry>
 </row>
 <row>
   <entry>બીજી સંખ્યાનો નમૂનો બનાવો. 3 ધન કાઉન્ટર ઉમેરો.</entry>
   <entry><media id="eip-id1168469855190" alt="સફેદ પૃષ્ઠભૂમિ પર આછાં વાદળી વર્તુળનાં બે જૂથ છે. પહેલા જૂથમાં પાંચ વર્તુળની નીચે “5” અને બીજા જૂથમાં ત્રણ વર્તુળની નીચે “3” લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_025_img-02.png" /></media></entry>
 </row>
 <row>
   <entry>કાઉન્ટરની કુલ સંખ્યા ગણો.</entry>
   <entry><media id="eip-id1168466267334" alt="આઠ આછાં વાદળી વર્તુળ હરોળમાં છે અને તેમની નીચે “8 ધન” લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_025_img-03.png" /></media></entry>
 </row>
 <row>
   <entry>5 અને 3નો સરવાળો 8 છે.</entry>
   <entry><m:math><m:mn>5</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>8</m:mn></m:math></entry>
 </row>

</tbody>









</tgroup>
</table></solution>
</exercise></example><note id="fs-id1166761468534" class="try">
<exercise id="fs-id1166761429874">
<problem id="fs-id1166761429876">
<para id="fs-id1166761430510">પદાવલીને નમૂના દ્વારા દર્શાવો.</para><para id="fs-id1166761430513"><m:math><m:mrow><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761420551">
<para id="fs-id1171103820346"><newline />
<media id="fs-id1166761441332" alt="ચિત્રમાં ધન કાઉન્ટર દર્શાવતાં છ ગુલાબી વર્તુળ હરોળમાં છે. પહેલાં બે વર્તુળ પછીનાં ચાર વર્તુળથી અલગ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_005_img.jpg" />
</media><newline />
6</para>
</solution>
</exercise>
</note>
<note id="fs-id1171105072761" class="try">
<exercise id="fs-id1166761477094">
<problem id="fs-id1166761429482">
<para id="fs-id1171105262331">પદાવલીને નમૂના દ્વારા દર્શાવો.</para><para id="fs-id1166761429484"><m:math><m:mrow><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761455579">
<para id="fs-id1171103455945"><newline />
<media id="fs-id1166761455584" alt="ચિત્રમાં ધન કાઉન્ટર દર્શાવતાં સાત ગુલાબી વર્તુળ હરોળમાં છે. બે વર્તુળ પછીનાં 5 વર્તુળથી અલગ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_006_img.jpg" />
</media><newline />
7</para>
</solution>
</exercise>
</note>
<example id="fs-id1166761483066"><exercise id="fs-id1166761430254">
<problem id="fs-id1166761430256">
<para id="fs-id1166761430258">નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>−5</m:mn><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>−3</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761483098">
<title>ઉકેલ</title>
<table id="eip-id1168466019221" class="unnumbered unstyled" aria-label="ચિત્રમાં પાંચ હરોળ છે. પહેલી હરોળ પદાવલીનો અર્થ સમજવાનું કહે છે: ઋણ 5 + ઋણ 3 એટલે ઋણ 5 અને ઋણ 3નો સરવાળો. બીજી હરોળ પ્રથમ સંખ્યાનો નમૂનો બનાવી 5 ઋણ કાઉન્ટરથી શરૂ કરવાનું કહે છે અને તેની પછી 5 લાલ વર્તુળ છે. ત્રીજી હરોળ બીજી સંખ્યાનો નમૂનો બનાવી 3 ઋણ કાઉન્ટર ઉમેરવાનું કહે છે અને તેની પછી 5 લાલ વર્તુળ તથા 3 લાલ વર્તુળની હરોળ છે. ચોથી હરોળ કુલ કાઉન્ટર ગણવાનું કહે છે અને તેની પછી 8 લાલ વર્તુળ છે. પાંચમી હરોળ કહે છે કે ઋણ 5 અને ઋણ 3નો સરવાળો ઋણ 8 છે અને પછી ઋણ 5 + ઋણ 3 = ઋણ 8 દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry>પદાવલીનો અર્થ સમજો.</entry>
   <entry><m:math><m:mn>−5</m:mn><m:mo>+</m:mo><m:mo>(</m:mo><m:mn>−3</m:mn><m:mo>)</m:mo></m:math> એટલે આનો સરવાળો: <m:math><m:mn>−5</m:mn></m:math> અને <m:math><m:mn>−3</m:mn></m:math>.</entry>
 </row>
 <row>
   <entry>પ્રથમ સંખ્યાનો નમૂનો બનાવો. 5 ઋણ કાઉન્ટરથી શરૂ કરો.</entry>
   <entry><media id="eip-id1168466052777" alt="સફેદ પૃષ્ઠભૂમિ પર પાંચ આછાં લાલ વર્તુળ આડી હરોળમાં છે અને તેમની વચ્ચેની નીચે “−5” લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_026_img-01.png" /></media></entry>
 </row>
 <row>
   <entry>બીજી સંખ્યાનો નમૂનો બનાવો. 3 ઋણ કાઉન્ટર ઉમેરો.</entry>
   <entry><media id="eip-id1168469344019" alt="સફેદ પૃષ્ઠભૂમિ પર પાંચ લાલ વર્તુળનું જૂથ −5 અને તેનાથી અલગ ત્રણ લાલ વર્તુળનું જૂથ −3 દર્શાવે છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_026_img-02.png" /></media></entry>
 </row>
 <row>
   <entry>કાઉન્ટરની કુલ સંખ્યા ગણો.</entry>
   <entry><media id="eip-id1168469757105" alt="આછાં લાલ રંગનાં અને લાલ કિનારીવાળાં આઠ વર્તુળ હરોળમાં છે. તેમની નીચે “8 ઋણ” લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_026_img-03.png" /></media></entry>
 </row>
 <row>
   <entry>−5 અને −3નો સરવાળો −8 છે.</entry>
   <entry><m:math><m:mn>−5</m:mn><m:mo>+</m:mo><m:mn>−3</m:mn><m:mo>=</m:mo><m:mn>−8</m:mn></m:math></entry>
 </row>

</tbody>

</tgroup>
</table>
</solution>
</exercise></example><note id="fs-id1166761429438" class="try">
<exercise id="fs-id1166761493510">
<problem id="fs-id1166761493513">
<para id="fs-id1166761493515">પદાવલીને નમૂના દ્વારા દર્શાવો.</para><para id="fs-id1166761493518"><m:math><m:mrow><m:mn>−2</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761477116">
<para id="fs-id1171105154659"><newline />
<media id="fs-id1166761468494" alt="ચિત્રમાં ઋણ કાઉન્ટર દર્શાવતાં 6 ઘેરા ગુલાબી વર્તુળની હરોળ છે. તેમાં પહેલાં 2 અને પછી 4 વર્તુળનાં અલગ જૂથ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_010_img.jpg" />
</media><newline />−6</para>
</solution>
</exercise>
</note>
<note id="fs-id1171105177651" class="try">
<exercise id="fs-id1166761468509">
<problem id="fs-id1166761468511">
<para id="fs-id1171103661383">પદાવલીને નમૂના દ્વારા દર્શાવો.</para><para id="fs-id1166761468513"><m:math><m:mrow><m:mn>−2</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761420491">
<para id="fs-id1171103452522"><newline />
<media id="fs-id1166761420494" alt="ચિત્રમાં ઋણ કાઉન્ટર દર્શાવતાં 7 ઘેરા ગુલાબી વર્તુળની હરોળ છે. તેમાં પહેલાં 2 અને પછી 5 વર્તુળનાં અલગ જૂથ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_011_img.jpg" />
</media><newline />−7</para>
</solution>
</exercise>
</note>
<para id="fs-id1166761429358"><link target-id="fs-id1166761468356" /> બંને ઉદાહરણો <link target-id="fs-id1166761483066" /> ઘણાં સરખાં છે. પહેલા ઉદાહરણમાં <m:math><m:mrow><m:mn>5</m:mn></m:mrow></m:math> ધન કાઉન્ટર અને <m:math><m:mrow><m:mn>3</m:mn></m:mrow></m:math> ધન કાઉન્ટર—બંને ધન—ઉમેરાય છે. બીજા ઉદાહરણમાં <m:math><m:mrow><m:mn>5</m:mn></m:mrow></m:math> ઋણ કાઉન્ટર અને <m:math><m:mrow><m:mn>3</m:mn></m:mrow></m:math> ઋણ કાઉન્ટર—બંને ઋણ—ઉમેરાય છે. બંને કિસ્સામાં પરિણામ મળ્યું છે <m:math><m:mrow><m:mtext>8—એટલે કે </m:mtext><m:mspace width="0.2em" /><m:mn>8</m:mn></m:mrow></m:math>  ધન કાઉન્ટર અથવા  <m:math><m:mrow><m:mn>8</m:mn></m:mrow></m:math>  ઋણ કાઉન્ટર. નિશાનીઓ સમાન હોય ત્યારે બધા કાઉન્ટરનો રંગ સરખો હોય છે.</para>
<para id="fs-id1166761429371">હવે જોઈએ કે નિશાનીઓ જુદી હોય ત્યારે શું થાય છે.</para>
<example id="fs-id1166761471996"><exercise id="fs-id1166761471998">
<problem id="fs-id1166761472000">
<para id="fs-id1166761472002">નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>−5</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761472018">
<title>ઉકેલ</title>
<table id="eip-id1168468228028" class="unnumbered unstyled" aria-label="ચિત્રમાં છ હરોળ છે. પહેલી હરોળ પદાવલીનો અર્થ સમજવાનું કહે છે: ઋણ 5 + 3 એટલે ઋણ 5 અને 3નો સરવાળો. બીજી હરોળ પ્રથમ સંખ્યાનો નમૂનો બનાવી 5 ઋણ કાઉન્ટરથી શરૂ કરવાનું કહે છે; તેની પછી 5 લાલ વર્તુળ છે. ત્રીજી હરોળ બીજી સંખ્યાનો નમૂનો બનાવી 3 ધન કાઉન્ટર ઉમેરવાનું કહે છે; તેની પછી 5 લાલ વર્તુળ અને 3 વાદળી વર્તુળ છે. ચોથી હરોળ શૂન્ય બનાવતી જોડીઓ દૂર કરવાનું કહે છે; 5 લાલ વર્તુળની નીચે 3 વાદળી વર્તુળ છે અને પહેલી ત્રણ લાલ-વાદળી જોડીઓ ઘેરેલી છે. પાંચમી હરોળ પરિણામ ગણવાનું કહે છે અને તેમાં 2 લાલ વર્તુળ છે. છઠ્ઠી હરોળ કહે છે કે ઋણ 5 અને 3નો સરવાળો ઋણ 2 છે અને પછી ઋણ 5 + 3 = ઋણ 2 દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry>પદાવલીનો અર્થ સમજો.</entry>
   <entry><m:math><m:mn>−5</m:mn><m:mo>+</m:mo><m:mn>3</m:mn></m:math> એટલે આનો સરવાળો: <m:math><m:mn>−5</m:mn></m:math> અને <m:math><m:mn>3</m:mn></m:math>.</entry>
 </row>
 <row>
   <entry>પ્રથમ સંખ્યાનો નમૂનો બનાવો. 5 ઋણ કાઉન્ટરથી શરૂ કરો.</entry>
   <entry><media id="eip-id1168468254933" alt="સફેદ પૃષ્ઠભૂમિ પર પાંચ આછાં લાલ વર્તુળ સરખા અંતરે આડી હરોળમાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_027_img-01.png" /></media></entry>
 </row>
 <row>
   <entry>બીજી સંખ્યાનો નમૂનો બનાવો. 3 ધન કાઉન્ટર ઉમેરો.</entry>
   <entry><media id="eip-id1168468668824" alt="સફેદ પૃષ્ઠભૂમિ પર પાંચ લાલ વર્તુળની આડી હરોળની નીચે ત્રણ આછાં વાદળી વર્તુળની આડી હરોળ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_027_img-02.png" /></media></entry>
 </row>
 <row>
 <entry>શૂન્ય બનાવતી બધી જોડીઓ દૂર કરો.</entry>
 <entry><media id="eip-id1168468525673" alt="ત્રણ જાંબલી અંડાકારમાં એક લાલ અને એક વાદળી વર્તુળની જોડી છે; તેમની બાજુમાં બે અલગ લાલ વર્તુળ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_027_img-03.png" /></media></entry>
 </row>
 <row>
   <entry>પરિણામ ગણો.</entry>
   <entry><media id="eip-id1168468436066" alt="ચિત્રમાં લાલ કિનારીવાળાં બે ગુલાબી વર્તુળ બાજુબાજુ છે અને તેમની નીચે “2 ઋણ” લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_027_img-04.png" /></media></entry>
 </row>
 <row>
   <entry>−5 અને 3નો સરવાળો −2 છે.</entry>
   <entry><m:math><m:mn>−5</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>−2</m:mn></m:math></entry>
 </row>

</tbody>
</tgroup>
</table>

<para id="fs-id1575267">ધ્યાન આપો કે ધન કરતાં ઋણ કાઉન્ટર વધુ હતાં, તેથી પરિણામ ઋણ છે.</para>
</solution>
</exercise>
</example><note id="fs-id1166761472038" class="try"><exercise id="eip-id1166566427443">
<problem id="eip-id1166566427445">
<para id="eip-id1166566427447">પદાવલીને નમૂના દ્વારા દર્શાવો અને પછી સરળ કરો:</para>
<para id="eip-id1166566427450"><m:math><m:mrow><m:mn>2</m:mn><m:mo>+</m:mo><m:mo>(</m:mo><m:mn>−4</m:mn><m:mo>)</m:mo></m:mrow></m:math></para></problem>
<solution id="eip-id1166566427470">
<para id="eip-id1166566427472"><newline />
<media id="eip-id1166566427476" alt="ચિત્રમાં કાઉન્ટરનાં વર્તુળની બે હરોળ છે. પહેલી હરોળમાં ઋણ કાઉન્ટર દર્શાવતાં 2 ઘેરાં ગુલાબી વર્તુળ અને બીજી હરોળમાં ધન કાઉન્ટર દર્શાવતાં 4 આછાં ગુલાબી વર્તુળ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_016_img.jpg" />
</media><newline />−2</para></solution>
</exercise>
</note><note id="fs-id1171105226199" class="try"><exercise id="eip-id1166566305604">
<problem id="eip-id1166566305607">
<para id="eip-id1166566305609">પદાવલીને નમૂના દ્વારા દર્શાવો અને પછી સરળ કરો:</para>
<para id="eip-id1166566305612"><m:math><m:mrow><m:mn>2</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
<solution id="eip-id1166566305632">
<para id="eip-id1166566305634"><newline />
<media id="eip-id1166566305638" alt="ચિત્રમાં કાઉન્ટરનાં વર્તુળની બે હરોળ છે. પહેલી હરોળમાં ધન કાઉન્ટર દર્શાવતાં 2 આછાં ગુલાબી વર્તુળ અને બીજી હરોળમાં ઋણ કાઉન્ટર દર્શાવતાં 5 ઘેરાં ગુલાબી વર્તુળ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_023_img.jpg" />
</media><newline />−3</para>
</solution>
</exercise>
</note><example id="fs-id1166761421624"><exercise id="fs-id1166761421626">
<problem id="fs-id1166761421628">
<para id="fs-id1166761421630">નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>5</m:mn><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>−3</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761421653">
<title>ઉકેલ</title>
<table id="eip-id1168468738226" class="unnumbered unstyled" aria-label="ચિત્રમાં છ હરોળ છે. પહેલી હરોળ પદાવલીનો અર્થ સમજવાનું કહે છે: 5 + ઋણ 3 એટલે 5 અને ઋણ 3નો સરવાળો. બીજી હરોળ પ્રથમ સંખ્યાનો નમૂનો બનાવી 5 ધન કાઉન્ટરથી શરૂ કરવાનું કહે છે; તેની પછી 5 વાદળી વર્તુળ છે. ત્રીજી હરોળ બીજી સંખ્યાનો નમૂનો બનાવી 3 ઋણ કાઉન્ટર ઉમેરવાનું કહે છે; તેની પછી 5 વાદળી વર્તુળ અને 3 લાલ વર્તુળ છે. ચોથી હરોળ શૂન્ય બનાવતી જોડીઓ દૂર કરવાનું કહે છે; 5 વાદળી વર્તુળની નીચે 3 લાલ વર્તુળ છે અને પહેલી ત્રણ લાલ-વાદળી જોડીઓ ઘેરેલી છે. પાંચમી હરોળ પરિણામ ગણવાનું કહે છે અને તેમાં 2 વાદળી વર્તુળ છે. છઠ્ઠી હરોળ કહે છે કે 5 અને ઋણ 3નો સરવાળો 2 છે અને પછી પાંચ + ઋણ 3 = 2 દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry>પદાવલીનો અર્થ સમજો.</entry>
   <entry><m:math><m:mn>5</m:mn><m:mo>+</m:mo><m:mo>(</m:mo><m:mn>−3</m:mn><m:mo>)</m:mo></m:math> એટલે આનો સરવાળો: <m:math><m:mn>5</m:mn></m:math> અને <m:math><m:mn>−3</m:mn></m:math>.</entry>
 </row>
 <row>
   <entry>પ્રથમ સંખ્યાનો નમૂનો બનાવો. 5 ધન કાઉન્ટરથી શરૂ કરો.</entry>
   <entry><media id="eip-id1168468458435" alt="સફેદ પૃષ્ઠભૂમિ પર ઘેરી વાદળી કિનારીવાળાં પાંચ આછાં વાદળી વર્તુળ આડી હરોળમાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_028_img-01.png" /></media></entry>
 </row>
 <row>
   <entry>બીજી સંખ્યાનો નમૂનો બનાવો. 3 ઋણ કાઉન્ટર ઉમેરો.</entry>
   <entry><media id="eip-id1168467120318" alt="ચિત્રમાં ઉપરની હરોળમાં પાંચ આછાં વાદળી અને નીચેની હરોળમાં ત્રણ લાલ વર્તુળ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_028_img-02.png" /></media></entry>
 </row>
 <row>
 <entry>શૂન્ય બનાવતી બધી જોડીઓ દૂર કરો.</entry>
 <entry><media id="eip-id1168467199701" alt="ત્રણ જાંબલી અંડાકારમાં એક આછા વાદળી અને એક લાલ વર્તુળની જોડી છે; તેમની બાજુમાં બે અલગ આછાં વાદળી વર્તુળ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_028_img-03.png" /></media></entry>
 </row>
 <row>
   <entry>પરિણામ ગણો.</entry>
   <entry><media id="eip-id1168468437854" alt="સફેદ પૃષ્ઠભૂમિ પર બે આછાં વાદળી વર્તુળની નીચે “2 ધન” લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_028_img-04.png" /></media></entry>
 </row>
 <row>
   <entry>5 અને −3નો સરવાળો 2 છે.</entry>
   <entry><m:math><m:mn>5</m:mn><m:mo>+</m:mo><m:mo>(</m:mo><m:mn>−3</m:mn><m:mo>)</m:mo><m:mo>=</m:mo><m:mn>2</m:mn></m:math></entry>
 </row>

</tbody>
</tgroup>
</table>
</solution>
</exercise>

</example><note id="fs-id1166761421670" class="try">
<exercise id="fs-id1166761421674">
<problem id="fs-id1166761493948">
<para id="fs-id11667614939510">પદાવલીને નમૂના દ્વારા દર્શાવો અને પછી સરળ કરો:</para>
<para id="fs-id1171105491910"><m:math><m:mrow><m:mo>(</m:mo><m:mn>−2</m:mn><m:mo>)</m:mo><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math></para></problem>
<solution id="fs-id1166761493976">
<para id="fs-id1171105119798"><newline />
<media id="fs-id1166761493978" alt="ચિત્રમાં કાઉન્ટરનાં વર્તુળની બે હરોળ છે. પહેલી હરોળમાં ધન કાઉન્ટર દર્શાવતાં 2 આછાં ગુલાબી વર્તુળ અને બીજી હરોળમાં ઋણ કાઉન્ટર દર્શાવતાં 4 ઘેરાં ગુલાબી વર્તુળ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_022_img.jpg" />
</media><newline />2</para>
</solution>
</exercise>
</note>
<note id="fs-id1171105494132" class="try"><exercise id="eip-id1166568757581">
<problem id="eip-id1166568757583">
<para id="eip-id1166568757586">પદાવલીને નમૂના દ્વારા દર્શાવો:</para>
<para id="eip-id1166568757589"><m:math><m:mrow><m:mo>(</m:mo><m:mn>−2</m:mn><m:mo>)</m:mo><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para></problem>
<solution id="eip-id1166567972144">
<para id="eip-id1166567972146"><newline />
<media id="eip-id1166567972149" alt="ચિત્રમાં કાઉન્ટરની બે હરોળ છે. પહેલી હરોળમાં ઋણ કાઉન્ટર દર્શાવતાં 2 ઘેરાં ગુલાબી વર્તુળ છે. બીજી હરોળમાં ઋણ કાઉન્ટર દર્શાવતાં 5 આછાં ગુલાબી વર્તુળ છે. એક ધન અને એક ઋણ કાઉન્ટરની શૂન્ય બનાવતી જોડીઓ ઘેરેલી છે અને ત્રણ ધન કાઉન્ટર બાકી રહે છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_017_img.jpg" />
</media><newline />3</para>
</solution>
</exercise></note></section>
<example id="eip-410"><title>ધન અને ઋણ પૂર્ણાંકોના સરવાળાને નમૂના દ્વારા દર્શાવવો</title><para id="eip-878">
દરેક સરવાળાને નમૂના દ્વારા દર્શાવો.
</para><exercise id="eip-495"><problem id="eip-351">
  <para id="eip-387"><list id="eip-id1168468273422" list-type="enumerated" number-style="arabic" class="circled"><item>  ⓐ 4 + 2 </item>
<item>  ⓑ −3 + 6 </item>
<item>  ⓒ 4 + (−5) </item>
<item>  ⓓ -2 + (−3) </item>
</list></para></problem>

<solution id="eip-842">
  <para id="eip-14"><table id="eip-id1168468294641" class="unnumbered unstyled" summary="કોષ્ટક 4 + 2નો સરવાળો વર્ણન, ગાણિતિક લખાવટ અને કાઉન્ટરના નમૂના સાથે પગલે પગલે દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓐ</span> </entry>
<entry />
</row>
<row>
<entry />
   <entry><m:math><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>2</m:mn></m:math></entry>
 </row>
 <row>
   <entry>4 ધન કાઉન્ટરથી શરૂ કરો.</entry>
   <entry><media id="eip-id1168468714743" alt="સફેદ પૃષ્ઠભૂમિ પર વાદળી કિનારીવાળાં ચાર આછાં વાદળી વર્તુળ આડી હરોળમાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_035_img-01.png" /></media></entry>
 </row>
 <row>
   <entry>બે ધન કાઉન્ટર ઉમેરો.</entry>
   <entry><media id="eip-id1168468574137" alt="સફેદ પૃષ્ઠભૂમિ પર વાદળી કિનારીવાળાં છ આછાં વાદળી વર્તુળની આડી હરોળમાં ચાર અને બે વર્તુળનાં અલગ જૂથ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_035_img-02.png" /></media></entry>
 </row>
 <row>
 <entry>તમારી પાસે કેટલા કાઉન્ટર છે?</entry>
 <entry><m:math><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>6</m:mn></m:math></entry>
</row>

</tbody>


















</tgroup>
</table><table id="eip-id1168468679001" class="unnumbered unstyled" summary="પૂર્ણાંકોના સરવાળા −3 + 6ની પગલે પગલે પ્રક્રિયા અને પરિણામ કાઉન્ટર વડે દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓑ</span> </entry>
   <entry />
</row>
<row>
<entry />
<entry><m:math><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>+</m:mo><m:mn>6</m:mn></m:math></entry>
 </row>
 <row>
   <entry>3 ઋણ કાઉન્ટરથી શરૂ કરો.</entry>
   <entry><media id="eip-id1168468414987" alt="સફેદ પૃષ્ઠભૂમિ પર ઘેરી લાલ કિનારીવાળાં ત્રણ આછાં લાલ વર્તુળ આડી હરોળમાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_036_img-01.png" /></media></entry>
 </row>
 <row>
   <entry>6 ધન કાઉન્ટર ઉમેરો.</entry>
   <entry><media id="eip-id1168467363206" alt="ચિત્રમાં ઉપરની હરોળમાં 3 લાલ અને નીચેની હરોળમાં 6 વાદળી વર્તુળ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_036_img-02.png" /></media></entry>
 </row>
<row>
<entry>શૂન્ય બનાવતી જોડીઓ દૂર કરો.</entry>
<entry><media id="eip-id1168468516794" alt="3 લાલ અને 3 વાદળી વર્તુળની જોડીઓ તીરવાળા અંડાકારથી ઘેરેલી છે; તેમની પછી 3 વધુ વાદળી વર્તુળ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_036_img-03.png" /></media></entry>
</row>
 <row>
 <entry>કેટલા કાઉન્ટર બાકી રહ્યા?</entry>
<entry><media id="eip-id1168466078308" alt="સફેદ પૃષ્ઠભૂમિ પર વાદળી કિનારીવાળાં ત્રણ આછાં વાદળી વર્તુળ આડી હરોળમાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_036_img-04.png" /></media></entry>
</row>
<row>
<entry />
 <entry><m:math><m:mn>3</m:mn></m:math>. <m:math><m:mn>−3</m:mn><m:mo>+</m:mo><m:mn>6</m:mn><m:mo>=</m:mo><m:mn>3</m:mn></m:math></entry>
</row>

</tbody>


















</tgroup>
</table><table id="eip-id1168467662609" class="unnumbered unstyled" summary="કાઉન્ટરનાં ચિત્રો વડે 4 અને −5 ઉમેરવાની પગલે પગલે પ્રક્રિયા અને પરિણામ −1 દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓒ</span> </entry>
<entry />
</row>
<row>
<entry />
<entry><m:math><m:mn>4</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−5</m:mn><m:mo stretchy="false">)</m:mo></m:math></entry>
 </row>
 <row>
   <entry>4 ધન કાઉન્ટરથી શરૂ કરો.</entry>
   <entry><media id="eip-id1168467475161" alt="સફેદ પૃષ્ઠભૂમિ પર થોડી ઘેરી વાદળી કિનારીવાળાં ચાર આછાં વાદળી વર્તુળ આડી હરોળમાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_037_img-01.png" /></media></entry>
 </row>
 <row>
   <entry>5 ઋણ કાઉન્ટર ઉમેરો.</entry>
   <entry><media id="eip-id1168467293990" alt="સફેદ પૃષ્ઠભૂમિ પર ઉપરની હરોળમાં ચાર આછાં વાદળી અને નીચેની હરોળમાં પાંચ લાલ વર્તુળ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_037_img-02.png" /></media></entry>
 </row>
<row>
<entry>શૂન્ય બનાવતી જોડીઓ દૂર કરો.</entry>
<entry><media id="eip-id1168468412654" alt="ચાર વાદળી અને ચાર લાલ વર્તુળની શૂન્ય બનાવતી જોડીઓ એક અંડાકારમાં ઘેરેલી છે અને એક લાલ વર્તુળ અલગ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_037_img-03.png" /></media></entry>
</row>
 <row>
 <entry>કેટલા કાઉન્ટર બાકી રહ્યા?</entry>
<entry><media id="eip-id1168466093043" alt="સફેદ પૃષ્ઠભૂમિની વચ્ચે ઘેરી લાલ કિનારીવાળું એક આછું ગુલાબી અથવા લાલ વર્તુળ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_037_img-04.png" /></media></entry>
</row>
<row>
<entry />
 <entry><m:math><m:mn>−1</m:mn></m:math>. <m:math><m:mn>4</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−5</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>−1</m:mn></m:math></entry>
</row>

</tbody>















</tgroup>
</table><table id="eip-id1168468388113" class="unnumbered unstyled" summary="વર્ણન, ગણિત અને કાઉન્ટર વડે ઋણ પૂર્ણાંકોનો સરવાળો −2 + (−3) = −5 પગલે પગલે દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓓ</span> </entry>
<entry />
</row>
<row>
<entry />
   <entry><m:math><m:mn>−2</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−3</m:mn><m:mo stretchy="false">)</m:mo></m:math></entry>
 </row>
 <row>
   <entry>2 ઋણ કાઉન્ટરથી શરૂ કરો.</entry>
   <entry><media id="eip-id1168468748343" alt="સફેદ પૃષ્ઠભૂમિ પર પાતળી ઘેરી લાલ કિનારીવાળાં બે આછાં લાલ વર્તુળ આડા અને નજીક છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_038_img-01.png" /></media></entry>
 </row>
 <row>
   <entry>3 ઋણ કાઉન્ટર ઉમેરો.</entry>
   <entry><media id="eip-id1168468706755" alt="સફેદ પૃષ્ઠભૂમિ પર ડાબી તરફનાં બે આછાં લાલ વર્તુળ અને જમણી તરફનાં ત્રણ આછાં લાલ વર્તુળ વચ્ચે જગ્યા છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_038_img-02.png" /></media></entry>
 </row>

 <row>
 <entry>તમારી પાસે કેટલા કાઉન્ટર છે?</entry>
 <entry><m:math><m:mn>−5</m:mn></m:math>. <m:math><m:mn>−2</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−3</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>−5</m:mn></m:math></entry>
</row>

</tbody>















</tgroup>
</table></para></solution>
</exercise></example>

<note id="eip-513" class="try"><exercise id="eip-337"><problem id="eip-272">
  <para id="eip-155">દરેક સરવાળાને નમૂના દ્વારા દર્શાવો.<newline />

<list id="eip-id1168469481502" list-type="enumerated" number-style="arabic" class="circled"><item> <span class="token">ⓐ</span> 3 + 4 </item>
<item> <span class="token">ⓑ</span> −1 + 4 </item>
<item> <span class="token">ⓒ</span> 4 + (−6) </item>
<item> <span class="token">ⓓ</span> −2 + (−2) </item>
</list></para></problem>

<solution id="eip-789">
  <para id="eip-950"><list id="eip-id1168469817624" list-type="enumerated" number-style="arabic" class="circled"><item> <span class="token">ⓐ</span> <newline /><media id="eip-id1166566346715" alt="સફેદ પૃષ્ઠભૂમિ પર ઘેરી કિનારીવાળાં રાખોડી વર્તુળનાં બે અલગ જૂથ છે: ડાબે ત્રણ અને જમણે પાંચ વર્તુળ.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_039_img.jpg" />
</media> </item>

<item> <span class="token">ⓑ</span>  <newline /><media id="eip-id1166567843361" alt="ઘેરું વાદળી વર્તુળ અલગ છે અને તેની પછી આછાં રાખોડી ચાર વર્તુળ હરોળમાં છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_040_img.jpg" />
</media>
<newline /></item>

<item> <span class="token">ⓒ</span> <newline /><media id="eip-id1166567843376" alt="સફેદ પૃષ્ઠભૂમિ પર ઘેરાં રાખોડી અંડાકારની બે હરોળ છે: ડાબે ત્રણ અને જમણે પાંચ.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_041_img.jpg" />
</media>
<newline /></item>
<item> <span class="token">ⓓ</span>  <newline /><media id="eip-id1166567843391" alt="સફેદ પૃષ્ઠભૂમિ પર ચાર ઘેરાં રાખોડી વર્તુળ બે-બેના બે જૂથમાં છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_042_img.jpg" />
</media></item>
</list></para></solution>
</exercise></note>

<note id="eip-id1166568120776" class="try"><exercise id="eip-id1166568120779"><problem id="eip-id1166568120780">
  <para id="eip-id1166568120782"><list id="eip-id1168469429098" list-type="enumerated" number-style="arabic" class="circled"><item> <span class="token">ⓐ</span> 5 + 1 </item>
<item> <span class="token">ⓑ</span> −3 + 7 </item>
<item> <span class="token">ⓒ</span> 2 + (−8)</item>
<item> <span class="token">ⓓ</span> −3 + (−4)</item>
</list></para></problem>

<solution id="eip-id1166568120787">
  <para id="eip-id1166568120789"><list id="eip-id1168468609987" list-type="enumerated" number-style="arabic" class="circled"><item> <span class="token">ⓐ</span> <newline /><media id="eip-id1166568120792" alt="પાંચ સાથે જોડાયેલાં અને એક અલગ એમ છ રાખોડી વર્તુળ હરોળમાં છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_043_img.jpg" />
</media><newline /></item>

<item> <span class="token">ⓑ</span> <newline /><media id="eip-id1166568120807" alt="સફેદ પૃષ્ઠભૂમિ પર ઘેરા અને આછા રાખોડી અંડાકારની હરોળ છે; પહેલાં બે ઘેરા અંડાકાર પછીનાં આછા અંડાકારથી અલગ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_044_img.jpg" />
</media><newline /></item>

<item> <span class="token">ⓒ</span> <newline /><media id="eip-id1166568669200" alt="અંડાકારની હરોળમાં ડાબે બે આછા રાખોડી અંડાકાર અને થોડા અંતર પછી જમણી તરફ નવ ઘેરા વાદળી-રાખોડી અંડાકાર છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_045_img.jpg" />
</media><newline /></item>
<item> <span class="token">ⓓ</span> <newline /><media id="eip-id1166568669215" alt="સફેદ પૃષ્ઠભૂમિ પર આઠ ઘેરા વાદળી-રાખોડી વર્તુળ ચાર-ચારના બે જૂથમાં છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_046_img.jpg" />
</media></item>

</list></para></solution>
</exercise></note>


<section id="fs-id1166761433959">
<title>પૂર્ણાંકો ધરાવતી પદાવલીઓ સરળ કરો</title>
<para id="fs-id1166761433964">હવે તમે નાના ધન અને ઋણ પૂર્ણાંકોના સરવાળાને નમૂના દ્વારા દર્શાવ્યો છે, તેથી મનમાં નમૂનાનું ચિત્ર બનાવીને તમે કોઈ પણ પૂર્ણાંક ધરાવતી <term class="no-emphasis" id="term-00003">પદાવલીઓ</term> સરળ કરી શકો છો. </para><para id="eip-171">ઉદાહરણ તરીકે, તમારે આ પદાવલીનો સરવાળો કરવો હોય: <m:math><m:mrow><m:mn>37</m:mn><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>−53</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>,</m:mo></m:mrow></m:math> તો <m:math><m:mrow><m:mn>37</m:mn></m:mrow></m:math> વાદળી કાઉન્ટર અને <m:math><m:mrow><m:mn>53</m:mn></m:mrow></m:math> લાલ કાઉન્ટર એક-એક કરીને ગણવાની જરૂર નથી. </para><para id="eip-866">મનમાં <m:math><m:mrow><m:mn>37</m:mn></m:mrow></m:math> વાદળી કાઉન્ટરનું ચિત્ર બનાવો અને તેની નીચે <m:math><m:mrow><m:mn>53</m:mn></m:mrow></m:math> લાલ કાઉન્ટર હરોળમાં ગોઠવો. ધન કાઉન્ટર કરતાં ઋણ કાઉન્ટર વધુ હોવાથી સરવાળો ઋણ થશે. કારણ કે <m:math><m:mrow><m:mn>53</m:mn><m:mn>−37</m:mn><m:mo>=</m:mo><m:mn>16</m:mn><m:mo>,</m:mo></m:mrow></m:math> તેથી <m:math><m:mrow><m:mn>16</m:mn></m:mrow></m:math> ઋણ કાઉન્ટર વધુ છે.</para><equation id="fs-id1166761483126" class="unnumbered"><label /><m:math><m:mrow><m:mn>37</m:mn><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>−53</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>=</m:mo><m:mn>−16</m:mn></m:mrow></m:math></equation>
<para id="fs-id1166761483151">ચાલો, બીજો દાખલો કરીએ. આપણે આનો સરવાળો કરીશું: <m:math><m:mrow><m:mn>−74</m:mn><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>−27</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math> આ માટે <m:math><m:mrow><m:mn>74</m:mn></m:mrow></m:math> લાલ કાઉન્ટર અને બીજા <m:math><m:mrow><m:mn>27</m:mn></m:mrow></m:math> લાલ કાઉન્ટરની કલ્પના કરો; એટલે કુલ <m:math><m:mrow><m:mn>101</m:mn></m:mrow></m:math> લાલ કાઉન્ટર થાય. તેથી સરવાળો છે <m:math><m:mrow><m:mtext>−101.</m:mtext></m:mrow></m:math></para>
<equation id="fs-id1166761433993" class="unnumbered"><label /><m:math><m:mrow><m:mn>−74</m:mn><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>−27</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>=</m:mo><m:mn>−101</m:mn></m:mrow></m:math></equation>
<para id="eip-242">આમાં મળેલાં પરિણામો ફરી જુઓ: <link target-id="fs-id1166761468356" /> - <link target-id="fs-id1166761421624" />.</para><table id="eip-663"><label /><title>ધન અને ઋણ પૂર્ણાંકોનો સરવાળો</title><tgroup cols="3"> <colspec colnum="1" colname="c1" />
    <colspec colnum="2" colname="c2" />
    <colspec colnum="3" colname="c3" /><tbody>
  <row>
    <entry align="center"><m:math><m:mn>5</m:mn><m:mo>+</m:mo><m:mn>3</m:mn></m:math></entry>
    <entry align="center"><m:math><m:mn>−5</m:mn><m:mo>+</m:mo><m:mo>(</m:mo><m:mn>−3</m:mn><m:mo>)</m:mo></m:math></entry>
  </row>
  <row>
    <entry align="center">બંને ધન, સરવાળો ધન</entry>
    <entry align="center">બંને ઋણ, સરવાળો ઋણ</entry>
  </row>
<row>
<entry align="center" namest="c1" nameend="c2">નિશાનીઓ સમાન હોય ત્યારે બધા કાઉન્ટર એક જ રંગના હોય છે, તેથી તેમનો સરવાળો કરો.</entry>
</row>
 <row>
 <entry align="center"><m:math><m:mn>−5</m:mn><m:mo>+</m:mo><m:mn>3</m:mn></m:math></entry>
    <entry align="center"><m:math><m:mn>5</m:mn><m:mo>+</m:mo><m:mo>(</m:mo><m:mn>−3</m:mn><m:mo>)</m:mo></m:math></entry>
  </row>
<row>
<entry align="center">જુદી નિશાનીઓ, ઋણ વધુ</entry>
<entry align="center">જુદી નિશાનીઓ, ધન વધુ</entry>
</row>
<row>
<entry align="center">સરવાળો ઋણ</entry>
<entry align="center">સરવાળો ધન</entry>
</row>
<row><entry align="center" namest="c1" nameend="c2">નિશાનીઓ જુદી હોય ત્યારે કેટલાક કાઉન્ટર શૂન્ય બનાવતી જોડીઓ બનાવે છે; કેટલા બાકી રહે છે તે જોવા બાદબાકી કરો.</entry>
</row>
</tbody>
</tgroup>
</table><example id="fs-id1166761426960">
<exercise id="fs-id1166761426964">
<problem id="fs-id1166761426966">
<para id="fs-id1166761426968">સરળ કરો:
<list id="eip-id1168469837506" list-type="enumerated" number-style="arabic" class="circled"><item> <span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>19</m:mn><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>−47</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mspace width="1em" /></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−32</m:mn><m:mo>+</m:mo><m:mn>40</m:mn></m:math></item>
</list></para></problem>
<solution id="fs-id1166761427012">
<title>ઉકેલ</title>
<para id="fs-id1166761427014"><span class="token">ⓐ</span> નિશાનીઓ જુદી હોવાથી આ બે સંખ્યાનો તફાવત શોધીએ છીએ: <m:math><m:mrow><m:mn>19</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>47</m:mn><m:mo>.</m:mo></m:mrow></m:math> ધન કરતાં ઋણ સંખ્યાઓ વધુ હોવાથી જવાબ ઋણ થશે.</para><equation id="fs-id1166761427018" class="unnumbered"><label /><m:math><m:mrow><m:mtable><m:mtr><m:mtd><m:mn>19</m:mn><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>−47</m:mn></m:mrow><m:mo>)</m:mo></m:mrow></m:mtd></m:mtr><m:mtr><m:mtd><m:mn>−28</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math></equation>
<para id="fs-id1166761458613"><span class="token">ⓑ</span> નિશાનીઓ જુદી હોવાથી આ બે સંખ્યાનો તફાવત શોધીએ છીએ: <m:math><m:mrow><m:mn>32</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>40</m:mn><m:mo>.</m:mo></m:mrow></m:math> ઋણ કરતાં ધન સંખ્યાઓ વધુ હોવાથી જવાબ ધન થશે.</para><equation id="fs-id1166761458617" class="unnumbered"><label /><m:math><m:mrow><m:mtable><m:mtr><m:mtd><m:mn>−32</m:mn><m:mo>+</m:mo><m:mn>40</m:mn></m:mtd></m:mtr><m:mtr><m:mtd><m:mn>8</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math></equation>
</solution>
</exercise>
</example>
<note id="fs-id1166761458640" class="try">
<exercise id="fs-id1166761458645"><problem id="fs-id1166761458647">
<para id="fs-id11667614586490">દરેક પદાવલી સરળ કરો:</para>
<list id="eip-id1168468668742" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>15</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−32</m:mn><m:mo stretchy="false">)</m:mo><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−19</m:mn><m:mo>+</m:mo><m:mn>76</m:mn></m:math></item>

</list></problem>
<solution id="fs-id1166761458697">
<list id="eip-id1168469725051" list-type="enumerated" number-style="arabic" class="circled"><item> ⓐ −17 </item>
<item>  ⓑ 57 </item>
</list></solution>
</exercise></note>
<note id="fs-id1171105462410" class="try">
<exercise id="fs-id1166761458704">
<problem id="fs-id1166761458706">
<para id="fs-id1166761458649">દરેક પદાવલી સરળ કરો:</para>
<para id="fs-id1166761458708"><list id="eip-id1168467334033" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>−55</m:mn><m:mo>+</m:mo><m:mn>9</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>43</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−17</m:mn><m:mo stretchy="false">)</m:mo></m:math></item>

</list></para></problem>
<solution id="fs-id1166761472163">
<para id="fs-id1166761472165"><list id="eip-id1168468535430" list-type="enumerated" number-style="arabic" class="circled"><item> ⓐ −46 </item>
<item> ⓑ 26 </item>
</list></para></solution>
</exercise>
</note>
<example id="fs-id1166761472172">
<exercise id="fs-id1166761472174">
<problem id="fs-id1166761472176">
<para id="fs-id1166761472178">સરળ કરો: <m:math><m:mrow><m:mn>−14</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−36</m:mn><m:mo stretchy="false">)</m:mo><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761472204">
<title>ઉકેલ</title>
<para id="fs-id1166761472206">નિશાનીઓ સમાન હોવાથી સરવાળો કરીએ છીએ. માત્ર ઋણ સંખ્યાઓ હોવાથી જવાબ ઋણ થશે.</para>
<equation id="fs-id1166761472210" class="unnumbered"><label /><m:math><m:mrow><m:mtable><m:mtr><m:mtd><m:mn>−14</m:mn><m:mo>+</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>−36</m:mn></m:mrow><m:mo>)</m:mo></m:mrow></m:mtd></m:mtr><m:mtr><m:mtd><m:mn>−50</m:mn></m:mtd></m:mtr></m:mtable></m:mrow></m:math></equation>
</solution>
</exercise>
</example>
<note id="fs-id1166761472244" class="try">
<exercise id="fs-id1166761472248">
<problem id="fs-id1166761472250">
<para id="fs-id11667614722520">પદાવલી સરળ કરો:</para>
<para id="fs-id1166761472256"><m:math><m:mrow><m:mn>−31</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−19</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761435856">
<para id="fs-id1166761435859">−50</para>
</solution>
</exercise>
</note>
<note id="fs-id1171105069974" class="try">
<exercise id="fs-id1166761435864">
<problem id="fs-id1166761435866">
<para id="fs-id1166761472252">પદાવલી સરળ કરો:</para>
<para id="fs-id1166761435868"><m:math><m:mrow><m:mn>−42</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−28</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761435892">
<para id="fs-id1166761435895">−70</para>
</solution>
</exercise>
</note>
<para id="eip-427">અત્યાર સુધી વાપરેલી રીતો વધુ જટિલ પદાવલીઓમાં પણ લાગુ પડે છે. ક્રિયાઓનો ક્રમ અનુસરવાનું યાદ રાખો.</para><example id="fs-id1166761435901">
<exercise id="fs-id1166761435903"><problem id="fs-id1166761435905">
<para id="fs-id1166761435907">સરળ કરો: <m:math><m:mrow><m:mn>−5</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mn>−2</m:mn><m:mo>+</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761435941">
<title>ઉકેલ</title>
<table id="eip-id1168466125594" class="unnumbered unstyled" summary="કોષ્ટક ક્રિયાઓના ક્રમ મુજબ પદાવલી −5 + 3(−2 + 7)ને પગલે પગલે સરળ કરવાની પ્રક્રિયા દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry />
   <entry><m:math><m:mn>−5</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>(</m:mo><m:mn>−2</m:mn><m:mo>+</m:mo><m:mn>7</m:mn><m:mo>)</m:mo></m:math></entry>
 </row>
 <row>
   <entry>કૌંસની અંદર સરળ કરો.</entry>
   <entry><m:math><m:mn>−5</m:mn><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>(</m:mo><m:mn>5</m:mn><m:mo>)</m:mo></m:math></entry>
 </row>
 <row>
   <entry>ગુણાકાર કરો.</entry>
   <entry><m:math><m:mn>−5</m:mn><m:mo>+</m:mo><m:mn>15</m:mn></m:math></entry>
 </row>
<row>
 <entry>ડાબેથી જમણે સરવાળો કરો.</entry>
 <entry><m:math><m:mn>10</m:mn></m:math></entry>
</row>

</tbody>


</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id1166761436067" class="try">
<exercise id="fs-id1166761436071">
<problem id="fs-id1166761436073">
<para id="fs-id11667614360760">પદાવલી સરળ કરો:</para>
<para id="fs-id1166761436079"><m:math><m:mrow><m:mn>−2</m:mn><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">(</m:mo><m:mn>−4</m:mn><m:mo>+</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761429513">
<para id="fs-id1166761429515">13</para>
</solution>
</exercise>
</note>
<note id="fs-id1171105501702" class="try">
<exercise id="fs-id1166761429520">
<problem id="fs-id1166761429522">
<para id="fs-id1166761436076">પદાવલી સરળ કરો:</para>
<para id="fs-id1166761429524"><m:math><m:mrow><m:mn>−4</m:mn><m:mo>+</m:mo><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>−3</m:mn><m:mo>+</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761429555">
<para id="fs-id1166761429557">0</para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1166761429565">
<title>પૂર્ણાંકો ધરાવતી ચલ પદાવલીઓની કિંમત શોધો</title>
<para id="fs-id1166761429570">યાદ રાખો કે પદાવલીની કિંમત શોધવી એટલે પદાવલીમાં આપેલા <term class="no-emphasis" id="term-00004">ચલની</term> જગ્યાએ સંખ્યા મૂકવી. હવે ધન ઉપરાંત ઋણ સંખ્યાઓ ધરાવતી <term class="no-emphasis" id="term-00005">પદાવલીઓની કિંમત પણ શોધી શકીએ છીએ</term>.</para>
<example id="fs-id1166761429575">
<exercise id="fs-id1166761429579"><problem id="fs-id1166761429581">
<para id="fs-id1166761429583">કિંમત શોધો <m:math><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mspace width="0.2em" /><m:mtext>જ્યારે</m:mtext><m:mspace width="0.2em" /></m:math>

<list id="eip-id1168469561833" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>−2</m:mn><m:mspace width="0.2em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>−11</m:mn><m:mo>.</m:mo></m:math></item>

</list></para></problem>
<solution id="fs-id1166761429640">
<title>ઉકેલ</title>
<para id="fs-id1166761429642"><table id="eip-id1168466176237" class="unnumbered unstyled" aria-label="ત્રણ હરોળમાં x + 7 છે; xની જગ્યાએ −2 મૂકતાં −2 + 7 અને સરળ કરતાં 5 મળે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓐ</span> કિંમત શોધો <m:math><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn></m:math> જ્યારે <m:math><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>−2</m:mn></m:math></entry>
<entry />
</row>
<row>
<entry />
   <entry><media id="eip-id1164271928310" alt="ચિત્રમાં ગાણિતિક પદાવલી −2 + 7 છે. તેમાં −2 લાલ અને વત્તાની નિશાની તથા 7 કાળાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_029_img-03.png" /></media></entry>
 </row>
 <row>
   <entry align="left"><media id="eip-id1168466176267" alt="ચિત્રમાં ચલ xની જગ્યાએ −2 મૂકવાની સૂચના છે; તેમાં −2 લાલ છે અને મૂકવાની કિંમત −2 દર્શાવે છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_029_img-01.png" /></media></entry>
   <entry><media id="eip-id1168466636259" alt="ચિત્રમાં ગાણિતિક પદાવલી −2 + 7 છે. તેમાં −2 લાલ અને વત્તાની નિશાની તથા 7 કાળાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_029_img-03.png" /></media></entry>
 </row>
 <row>
   <entry>સરળ કરો.</entry>
   <entry><media id="eip-id1164271928355" alt="સફેદ પૃષ્ઠભૂમિના ઉપર જમણા ખૂણે કાળા રંગમાં 5 લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_029_img-04.png" /></media></entry>
 </row>


</tbody>











</tgroup>
</table><table id="eip-id1168466985462" class="unnumbered unstyled" aria-label="ત્રણ હરોળમાં x + 7 છે; xની જગ્યાએ −11 મૂકતાં −11 + 7 અને સરળ કરતાં −4 મળે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓑ</span> કિંમત શોધો <m:math><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>7</m:mn></m:math> જ્યારે <m:math><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>−11</m:mn></m:math></entry>
<entry />
</row>
<row>
<entry />
   <entry><media id="eip-id1168466985503" alt="સફેદ પૃષ્ઠભૂમિ પર ગાણિતિક પદાવલી x + 7 છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_030_img-02.png" /></media></entry>
 </row>
 <row>
   <entry align="left"><media id="eip-id1168466985492" alt="ચિત્રમાં ચલ xની જગ્યાએ −11 મૂકવાની સૂચના છે; તેમાં −11 લાલ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_030_img-01.png" /></media></entry>
   <entry><media id="eip-id1164272074334" alt="ચિત્રમાં ઋણ અગિયાર અને ધન સાતનો સરવાળો −11 + 7 લખેલો છે; તેમાં ઋણ સંખ્યા લાલ અને વત્તાની નિશાની તથા સાત કાળાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_030_img-03.png" /></media></entry>
 </row>
 <row>
   <entry>સરળ કરો.</entry>
   <entry><media id="eip-id1164272074351" alt="સફેદ પૃષ્ઠભૂમિ પર કાળા રંગમાં −4 લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_030_img-04.png" /></media></entry>
 </row>


</tbody>








</tgroup>
</table></para></solution>
</exercise></example>
<note id="fs-id1166761429699" class="try">
<exercise id="fs-id1166761429703"><problem id="fs-id1166761429705">
<para id="fs-id11667614297070">આપેલી કિંમતો માટે દરેક પદાવલીની કિંમત શોધો:</para><para id="fs-id1171105261484"><m:math><m:mi>x</m:mi><m:mo>+</m:mo><m:mn>5</m:mn><m:mspace width="0.2em" /><m:mtext>જ્યારે</m:mtext><m:mspace width="0.2em" /></m:math>
<list id="eip-id1168468269142" list-type="enumerated" number-style="arabic" class="circled"><item> <span class="token">ⓐ</span> <m:math>
<m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>−3</m:mn><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /></m:math></item>

<item> <span class="token">ⓑ</span> <m:math>
<m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>−17</m:mn><m:mspace width="0.2em" /></m:math>
</item>

</list></para>
</problem>
<solution id="fs-id1166761429766">
<para id="fs-id1166761429768"><list id="eip-id1168469505917" list-type="enumerated" number-style="arabic" class="circled"><item> ⓐ 2 </item>
<item>ⓑ −12 </item>
</list></para>
</solution>
</exercise></note>
<note id="fs-id1171105201287" class="try">
<exercise id="fs-id1166761429774">
<problem id="fs-id1166761429776">
<para id="fs-id1166761429707">આપેલી કિંમતો માટે દરેક પદાવલીની કિંમત શોધો: <m:math><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>7</m:mn><m:mspace width="0.2em" /></m:math> જ્યારે
<list id="eip-id1168469868395" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mspace width="0.2em" /><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>−5</m:mn><m:mspace width="0.2em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>−8</m:mn><m:mspace width="0.2em" /></m:math></item>

</list></para></problem>
<solution id="fs-id1166761458752">
<para id="fs-id1166761458754"><list id="eip-id1168467164180" list-type="enumerated" number-style="arabic" class="circled"><item>ⓐ 2 </item>
<item>ⓑ −1 </item>
</list></para></solution>
</exercise>
</note>
<example id="fs-id1166761458761">
<exercise id="fs-id1166761458765">
<problem id="fs-id1166761458767">
<para id="fs-id1166761458769">જ્યારે <m:math><m:mi>n</m:mi><m:mo>=</m:mo><m:mn>−5</m:mn><m:mo>,</m:mo></m:math> ત્યારે કિંમત શોધો: <m:math />

<list id="eip-id1168468297583" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mspace width="0.2em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mo>−</m:mo><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>1</m:mn><m:mo>.</m:mo></m:math></item>

</list></para></problem>
<solution id="fs-id1166761458816">
<title>ઉકેલ</title>
<para id="fs-id1166761458818"><table id="eip-id1168466711125" class="unnumbered unstyled" aria-label="ત્રણ હરોળમાં n + 1 છે; nની જગ્યાએ −5 મૂકતાં −5 + 1 અને સરળ કરતાં −4 મળે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓐ</span> કિંમત શોધો <m:math><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>1</m:mn></m:math> જ્યારે <m:math><m:mi>n</m:mi><m:mo>=</m:mo><m:mn>−5</m:mn></m:math></entry>
<entry />
</row>
<row>
<entry />
   <entry><media id="eip-id1168466230188" alt="સફેદ પૃષ્ઠભૂમિ પર કાળા ઘેરા અક્ષરમાં ગાણિતિક પદાવલી n + 1 છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_031_img-02.png" /></media></entry>
 </row>
 <row>
   <entry><media id="eip-id1168466230178" alt="ચિત્રમાં ચલ nની જગ્યાએ −5 મૂકવાની સૂચના છે; એટલે nની જગ્યાએ −5 મૂકવાનું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_031_img-01.png" /></media></entry>
   <entry><media id="eip-id1164270935486" alt="ચિત્રમાં ગાણિતિક પદાવલી −5 + 1 છે; તેમાં −5 લાલ અને +1 કાળું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_031_img-03.png" /></media></entry>
 </row>
 <row>
   <entry>સરળ કરો.</entry>
   <entry><media id="eip-id1164270935503" alt="સફેદ પૃષ્ઠભૂમિ પર ઋણ ચાર એટલે −4 લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_031_img-04.png" /></media></entry>
 </row>


</tbody>














</tgroup>
</table><table id="eip-id1168468416600" class="unnumbered unstyled" aria-label="ચાર હરોળમાં −n + 1 છે; nની જગ્યાએ −5 મૂકતાં કૌંસમાંના −5ની પહેલાં ઋણ નિશાની અને પછી વત્તા એક છે; સરળ કરતાં 5 + 1 અને સરવાળો કરતાં 6 મળે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓑ</span> કિંમત શોધો <m:math><m:mo>−</m:mo><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>1</m:mn></m:math> જ્યારે <m:math><m:mi>n</m:mi><m:mo>=</m:mo><m:mn>−5</m:mn></m:math></entry>
<entry />
</row>
<row>
<entry />
   <entry><media id="eip-id1168468714690" alt="સફેદ પૃષ્ઠભૂમિ પર ગાણિતિક પદાવલી −n + 1 છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_032_img-02.png" /></media></entry>
 </row>
 <row>
   <entry><media id="eip-id1168468744712" alt="ચિત્રમાં ચલ nની જગ્યાએ −5 મૂકવાની સૂચના છે; તેમાં −5 લાલ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_032_img-01.png" /></media></entry>
   <entry><media id="eip-id1164270965514" alt="ચિત્રની પદાવલીમાં બહાર ઋણ નિશાની, કૌંસની અંદર ઋણ પાંચ અને પછી વત્તા એક છે; તેમાં અંદરની ઋણ નિશાની અને 5 લાલ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_032_img-03.png" /></media></entry>
 </row>
 <row>
   <entry>સરળ કરો.</entry>
   <entry><media id="eip-id1164270965531" alt="સફેદ પૃષ્ઠભૂમિ પર કાળા રંગમાં ગાણિતિક પદાવલી 5 + 1 છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_032_img-04.png" /></media></entry>
 </row>
 <row>
 	<entry>સરવાળો કરો.</entry>
 	<entry><media id="eip-id1164270965548" alt="સફેદ પૃષ્ઠભૂમિના ઉપર જમણા ખૂણે ઝાંખું 6 લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_032_img-05.png" /></media></entry>
 </row>

</tbody>






</tgroup>
</table></para></solution>
</exercise>
</example>
<note id="fs-id1166761458897" class="try">
<exercise id="fs-id1166761458901">
<problem id="fs-id1166761458903">
<para id="fs-id1166761458905">જ્યારે <m:math><m:mi>n</m:mi><m:mo>=</m:mo><m:mn>−8</m:mn><m:mo>,</m:mo></m:math> ત્યારે કિંમત શોધો:

<list id="eip-id1168469483154" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mspace width="0.2em" /><m:mtext /><m:mspace width="0.2em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mo>−</m:mo><m:mi>n</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mspace width="0.2em" /></m:math></item>

</list></para></problem>
<solution id="fs-id1166761458956">
<para id="fs-id1166761458958"><list id="eip-id1168469768879" list-type="enumerated" number-style="arabic" class="circled"><item> ⓐ −6 </item>
<item> ⓑ 10 </item>
</list></para></solution>
</exercise>
</note>
<note id="fs-id1171105200814" class="try">
<exercise id="fs-id1166761458963">
<problem id="fs-id1166761458965">
<para id="fs-id1166761458967"><m:math><m:mtext>જ્યારે</m:mtext><m:mspace width="0.2em" /><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>−9</m:mn><m:mo>,</m:mo><m:mspace width="0.2em" /><m:mtext>ત્યારે કિંમત શોધો:</m:mtext><m:mspace width="0.2em" /></m:math>

<list id="eip-id1168466124914" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mo>−</m:mo><m:mi>y</m:mi><m:mo>+</m:mo><m:mn>8</m:mn><m:mo>.</m:mo></m:math></item>

</list></para></problem>
<solution id="fs-id1166761459005">
<para id="fs-id1166761459007"><list id="eip-id1168468267324" list-type="enumerated" number-style="arabic" class="circled"><item>ⓐ −1 </item>
<item>ⓑ 17 </item>
</list></para></solution>
</exercise>
</note>
<para id="eip-652">હવે આપણે બે ચલ ધરાવતી પદાવલીની કિંમત શોધીશું.</para><example id="fs-id1166761459013">
<exercise id="fs-id1166761459015">
<problem id="fs-id1166761459018">
<para id="fs-id1166761459020">કિંમત શોધો <m:math><m:mrow><m:mn>3</m:mn><m:mi>a</m:mi><m:mo>+</m:mo><m:mi>b</m:mi></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>12</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>−30</m:mn><m:mo>.</m:mo></m:mrow></m:math></para></problem>
<solution id="fs-id1166761459055">
<title>ઉકેલ</title>
<para id="fs-id1166761459057"><table id="eip-id1168466080012" class="unnumbered unstyled" aria-label="ચાર હરોળમાં 3a + b છે; aની જગ્યાએ 12 અને bની જગ્યાએ −30 મૂકતાં 3(12) + (−30), ગુણાકાર કરતાં 36 + (−30) અને સરવાળો કરતાં 6 મળે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry />
   <entry><media id="eip-id1168469884281" alt="સફેદ પૃષ્ઠભૂમિ પર ગાણિતિક પદાવલી 3a + b છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_033_img-02.png" /></media></entry>
 </row>
 <row>
   <entry><media id="eip-id1168466080036" alt="સફેદ પૃષ્ઠભૂમિ પર ચલ aની જગ્યાએ 12 અને bની જગ્યાએ −30 મૂકવાની સૂચના છે; 12 લાલ અને −30 આછું વાદળી છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_033_img-01.png" /></media></entry>
   <entry><media id="eip-id1164271011747" alt="ગાણિતિક પદાવલી 3(12) + (−30)માં 12 લાલ અને −30 વાદળી છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_033_img-03.png" /></media></entry>
 </row>
 <row>
   <entry>ગુણાકાર કરો.</entry>
   <entry><media id="eip-id1164271011764" alt="સફેદ પૃષ્ઠભૂમિ પર ગાણિતિક પદાવલી 36 + (−30) છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_033_img-04.png" /></media></entry>
 </row>
 <row>
 	<entry>સરવાળો કરો.</entry>
 	<entry><media id="eip-id1164271011781" alt="સફેદ પૃષ્ઠભૂમિના ઉપર જમણા ખૂણે ઝાંખું 6 લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_033_img-05.png" /></media></entry>
 </row>

</tbody>




</tgroup>
</table></para></solution>
</exercise>
</example>
<note id="fs-id1166761448238" class="try">
<exercise id="fs-id1166761448242">
<problem id="fs-id1166761448244">
<para id="fs-id1166761448246">પદાવલીની કિંમત શોધો:</para>
<para id="fs-id1171105180786"><m:math><m:mrow><m:mi>a</m:mi><m:mo>+</m:mo><m:mn>2</m:mn><m:mi>b</m:mi><m:mspace width="0.2em" /><m:mtext>જ્યારે</m:mtext><m:mspace width="0.2em" /><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>−19</m:mn><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>14</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761448293">
<para id="fs-id1166761448296">9</para>
</solution>
</exercise>
</note>
<note id="fs-id1171098432596" class="try">
<exercise id="fs-id1166761448301">
<problem id="fs-id1166761448303">
<para id="fs-id1171105504182">પદાવલીની કિંમત શોધો:</para>
<para id="fs-id1171105050977"><m:math><m:mrow><m:mn>5</m:mn><m:mi>p</m:mi><m:mo>+</m:mo><m:mi>q</m:mi><m:mspace width="0.2em" /><m:mtext>જ્યારે</m:mtext><m:mspace width="0.2em" /><m:mi>p</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mi>q</m:mi><m:mo>=</m:mo><m:mn>−7</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761448352">
<para id="fs-id1166761448354">13</para>
</solution>
</exercise>
</note>
<example id="fs-id1166761448360">
<exercise id="fs-id1166761448362">
<problem id="fs-id1166761448364">
<para id="fs-id1166761448366">કિંમત શોધો <m:math><m:mrow><m:msup><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow><m:mn>2</m:mn></m:msup></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>−18</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>24</m:mn><m:mo>.</m:mo></m:mrow></m:math></para></problem>
<solution id="fs-id1166761448414">
<title>ઉકેલ</title>
<para id="fs-id1166761448416">આ પદાવલીમાં બે ચલ છે. પહેલી આપેલી કિંમત <m:math><m:mrow><m:mn>−18</m:mn></m:mrow></m:math> છે; તે નીચેના ચલ માટે છે: <m:math><m:mrow><m:mi>x</m:mi></m:mrow></m:math> અને બીજી આપેલી કિંમત <m:math><m:mrow><m:mn>24</m:mn></m:mrow></m:math> છે; તે નીચેના ચલ માટે છે: <m:math><m:mrow><m:mi>y</m:mi><m:mo>.</m:mo></m:mrow></m:math><newline />

<table id="eip-id1168466250152" class="unnumbered unstyled" aria-label="4 હરોળમાં (x + y)² છે; xની જગ્યાએ −18 અને yની જગ્યાએ 24 મૂકતાં (−18 + 24)², કૌંસની અંદર સરવાળો કરતાં (6)² અને સરળ કરતાં 36 મળે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry />
   <entry align="right"><m:math><m:mrow><m:msup><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow><m:mn>2</m:mn></m:msup></m:mrow></m:math></entry>
 </row>
 <row>
   <entry><media id="eip-id1168466166478" alt="ચિત્રમાં ચલ xની જગ્યાએ −18 અને yની જગ્યાએ 24 મૂકવાની સૂચના છે; −18 લાલ અને 24 આછું વાદળી છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_034_img-01.png" /></media></entry>
   <entry align="right"><m:math><m:mrow><m:msup><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>−18</m:mn><m:mo>+</m:mo><m:mn>24</m:mn><m:mo stretchy="false">)</m:mo></m:mrow><m:mn>2</m:mn></m:msup></m:mrow></m:math></entry>
 </row>
 <row>
   <entry>કૌંસની અંદર સરવાળો કરો.</entry>
   <entry align="right"><m:math><m:mrow><m:msup><m:mrow><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo></m:mrow><m:mn>2</m:mn></m:msup></m:mrow></m:math></entry>
 </row>
 <row>
 	<entry>સરળ કરો.</entry>
 	<entry align="right"><m:math><m:mn>36</m:mn></m:math></entry>
 </row>

</tbody>






</tgroup>
</table></para></solution>
</exercise>
</example>
<note id="fs-id1166761448452" class="try">
<exercise id="fs-id1166761448456">
<problem id="fs-id1166761448459">
<para id="fs-id1166761448461">કિંમત શોધો:</para>
<para id="fs-id1166761448464"><m:math><m:mrow><m:msup><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow><m:mn>2</m:mn></m:msup></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>−15</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>29</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761448510">
<para id="fs-id1166761448512">196</para>
</solution>
</exercise>
</note>
<note id="fs-id1171105475936" class="try">
<exercise id="fs-id1166761448517">
<problem id="fs-id1166761448519">
<para id="fs-id1171105170392">કિંમત શોધો:</para>
<para id="fs-id1166761448521"><m:math><m:mrow><m:msup><m:mrow><m:mo stretchy="false">(</m:mo><m:mi>x</m:mi><m:mo>+</m:mo><m:mi>y</m:mi><m:mo stretchy="false">)</m:mo></m:mrow><m:mn>3</m:mn></m:msup></m:mrow></m:math> જ્યારે <m:math><m:mrow><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>−8</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>10</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761448567">
<para id="fs-id1166761448569">8</para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1166761448576">
<title>શબ્દસમૂહોને બીજગણિતીય પદાવલીઓમાં ફેરવો</title>
<para id="fs-id1166761448582">શબ્દસમૂહોને બીજગણિતીય પદાવલીઓમાં ફેરવવાનું અગાઉનું બધું કાર્ય ધન અને ઋણ બંને સંખ્યાઓ ધરાવતી પદાવલીઓને પણ લાગુ પડે છે. યાદ રાખો કે “ <emphasis effect="italics">સરવાળો</emphasis> ” શબ્દ સરવાળાની ક્રિયા દર્શાવે છે.</para>
<example id="fs-id1166761494022"><exercise id="fs-id1166761494024">
<problem id="fs-id1166761494027">
<para id="fs-id1166761494029">ગણિતની લખાવટમાં ફેરવીને સરળ કરો. આ સંખ્યાઓનો સરવાળો: <m:math><m:mrow><m:mn>−9</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>5</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761494041">
<title>ઉકેલ</title>
<table id="eip-id1168468649947" class="unnumbered unstyled" summary="શબ્દોમાં આપેલા ગાણિતિક શબ્દસમૂહને પદાવલીમાં ફેરવીને સરળ કરવાનાં પગલાં દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry>−9 અને 5નો સરવાળો સરવાળાની ક્રિયા દર્શાવે છે.</entry>
   <entry>આનો સરવાળો: <m:math><m:mn>−9</m:mn></m:math> અને <m:math><m:mn>5</m:mn></m:math></entry>
 </row>
 <row>
   <entry>ફેરવો.</entry>
   <entry><m:math><m:mn>−9</m:mn><m:mo>+</m:mo><m:mn>5</m:mn></m:math></entry>
 </row>
 <row>
   <entry>સરળ કરો.</entry>
   <entry><m:math><m:mn>−4</m:mn></m:math></entry>
 </row>


</tbody>




</tgroup>
</table></solution>
</exercise>
</example><note id="fs-id1166761494136" class="try">
<exercise id="fs-id1166761494140">
<problem id="fs-id1166761494142">
<para id="fs-id1166761494144">પદાવલીને ફેરવો અને સરળ કરો:</para>
<para id="fs-id1171105217567">આ સંખ્યાઓનો સરવાળો: <m:math><m:mrow><m:mn>−7</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>4</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761494158">
<para id="fs-id1166761494160">−7 + 4 = −3</para>
</solution>
</exercise>
</note>
<note id="fs-id1171105157383" class="try">
<exercise id="fs-id1166761494166">
<problem id="fs-id1166761494168">
<para id="fs-id1171105047541">પદાવલીને ફેરવો અને સરળ કરો:</para>
<para id="fs-id1166761494170">આ સંખ્યાઓનો સરવાળો: <m:math><m:mrow><m:mn>−8</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>−6</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761494188">
<para id="fs-id1166761494190">−8 + (−6) = −14</para>
</solution>
</exercise>
</note>
<example id="fs-id1166761494197">
<exercise id="fs-id1166761494199"><problem id="fs-id1166761494201">
<para id="fs-id1166761494203">ગણિતની લખાવટમાં ફેરવીને સરળ કરો. આ સંખ્યાઓનો સરવાળો: <m:math><m:mrow><m:mn>8</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>−12</m:mn><m:mo>,</m:mo></m:mrow></m:math> વધારવાથી <m:math><m:mrow><m:mn>3</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761494215">
<title>ઉકેલ</title>
<para id="fs-id1166761494217">“ <emphasis effect="italics">વધારવાથી</emphasis> ” શબ્દસમૂહ સરવાળાની ક્રિયા દર્શાવે છે.</para>
<table id="eip-id1168468229407" class="unnumbered unstyled" summary="ગાણિતિક શબ્દસમૂહને પદાવલીમાં ફેરવીને તેની સંખ્યાત્મક કિંમત મેળવવા સરળ કરવાનાં પગલાં દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry />
   <entry>આનો સરવાળો: <m:math><m:mn>8</m:mn></m:math> અને <m:math><m:mn>−12</m:mn></m:math>; તેમાં આટલો વધારો: <m:math><m:mn>3</m:mn></m:math></entry>
 </row>
 <row>
   <entry>ફેરવો.</entry>
   <entry><m:math><m:mo>[</m:mo><m:mn>8</m:mn><m:mo>+</m:mo><m:mo>(</m:mo><m:mn>−12</m:mn><m:mo>)</m:mo><m:mo>]</m:mo><m:mo>+</m:mo><m:mn>3</m:mn></m:math></entry>
 </row>
 <row>
   <entry>સરળ કરો.</entry>
   <entry><m:math><m:mn>−4</m:mn><m:mo>+</m:mo><m:mn>3</m:mn></m:math></entry>
 </row>
<row>
<entry>સરવાળો કરો.</entry>
<entry><m:math><m:mn>−1</m:mn></m:math></entry>
</row>

</tbody>



</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id1166761494347" class="try">
<exercise id="fs-id1166761494351">
<problem id="fs-id1166761494353">
<para id="fs-id1166761494355">ફેરવો અને સરળ કરો:</para>
<para id="fs-id1171105512698">આ સંખ્યાઓનો સરવાળો: <m:math><m:mrow><m:mn>9</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>−16</m:mn><m:mo>,</m:mo></m:mrow></m:math> વધારવાથી <m:math><m:mrow><m:mn>4</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761494370">
<para id="fs-id1166761494372">[9 + (−16)] + 4 = −3</para>
</solution>
</exercise>
</note>
<note id="fs-id1171105070011" class="try">
<exercise id="fs-id1166761494378">
<problem id="fs-id1166761494380">
<para id="fs-id1171105089370">ફેરવો અને સરળ કરો:</para>
<para id="fs-id1166761494382">આ સંખ્યાઓનો સરવાળો: <m:math><m:mrow><m:mn>−8</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>−12</m:mn><m:mo>,</m:mo></m:mrow></m:math> વધારવાથી <m:math><m:mrow><m:mn>7</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761494401">
<para id="fs-id1166761494403">[−8 + (−12)] + 7 = −13</para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1166761494412">
<title>વ્યવહારુ પ્રશ્નોમાં પૂર્ણાંકોનો સરવાળો કરો</title>
<para id="fs-id1166761494417">યાદ કરો કે રોજિંદા જીવનમાં તાપમાન, બૅન્કિંગ અને રમતગમત જેવી કેટલીક પરિસ્થિતિઓમાં ધન અને ઋણ સંખ્યાઓ વપરાય છે. ઉદાહરણ તરીકે, <m:math><m:mrow><m:mtext>$5</m:mtext></m:mrow></m:math> નું દેવું આ રીતે દર્શાવી શકાય: <m:math><m:mrow><m:mtext>−$5.</m:mtext></m:mrow></m:math> ચાલો, કેટલાક વ્યવહારુ પ્રશ્નો ફેરવીને ઉકેલવાની પ્રેક્ટિસ કરીએ.</para>
<para id="fs-id1166761494424">યોજના હોય તો વ્યવહારુ પ્રશ્નો ઉકેલવા સરળ છે. પહેલાં શું શોધવાનું છે તે નક્કી કરીએ. પછી તે શોધવા જરૂરી માહિતી આપતો શબ્દસમૂહ લખીએ. શબ્દસમૂહને ગાણિતિક લખાવટમાં ફેરવીને જવાબ મેળવવા તેને સરળ કરીએ. અંતે પ્રશ્નનો જવાબ આપતું વાક્ય લખીએ.</para>
<example id="fs-id1166761492962"><exercise id="fs-id1166761492964">
<problem id="fs-id1166761492966">
<para id="fs-id1166761492968">ન્યૂ યૉર્કના બફેલોમાં એક સવારે તાપમાન શૂન્યથી <m:math><m:mrow><m:mn>7</m:mn><m:mspace width="0.2em" /><m:mtext>ડિગ્રી</m:mtext></m:mrow></m:math>  ફેરનહાઇટ નીચે હતું. બપોર સુધીમાં તાપમાનનો વધારો થયો: <m:math><m:mrow><m:mn>12</m:mn><m:mspace width="0.2em" /><m:mtext>ડિગ્રી</m:mtext><m:mo>.</m:mo></m:mrow></m:math> બપોરે તાપમાન કેટલું હતું?</para>
</problem>
<solution id="fs-id1166761492974">
<title>ઉકેલ</title>
<para id="fs-id1166761492976">આપણે બપોરનું તાપમાન શોધવાનું છે.</para>

<table id="eip-id1168469630355" class="unstyled" summary="તાપમાનના વ્યવહારુ પ્રશ્નને શબ્દસમૂહ અને ગાણિતિક લખાવટમાં ફેરવી, સરળ કરી અને જવાબનું વાક્ય લખવાની પગલે પગલે પ્રક્રિયા દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry>તાપમાન માટે શબ્દસમૂહ લખો.</entry>
    <entry>તાપમાનમાં 12 ડિગ્રી વધારો થયો; શરૂઆતનું તાપમાન શૂન્યથી 7 ડિગ્રી નીચે હતું.</entry>
  </row>
  <row>
    <entry>ગાણિતિક લખાવટમાં ફેરવો.</entry>
    <entry>−7 + 12</entry>
  </row>
  <row>
    <entry>સરળ કરો.</entry>
    <entry>5</entry>
  </row>

  <row>
    <entry>પ્રશ્નનો જવાબ આપવા વાક્ય લખો.</entry>
    <entry>બપોરે તાપમાન 5 ડિગ્રી ફેરનહાઇટ હતું.</entry>
  </row>
</tbody>



</tgroup>
</table></solution>
</exercise></example><note id="fs-id1166761493052" class="try">
<exercise id="fs-id1166761493057">
<problem id="fs-id1166761493059">
<para id="fs-id1166761493061">શિકાગોમાં સવારે 5 વાગ્યે તાપમાન શૂન્યથી <m:math><m:mrow><m:mn>10</m:mn><m:mspace width="0.2em" /><m:mtext>ડિગ્રી</m:mtext></m:mrow></m:math>  સેલ્સિયસ નીચે હતું. છ કલાક પછી તાપમાનનો વધારો થયો: <m:math><m:mrow><m:mtext>14 ડિગ્રી સેલ્સિયસ.</m:mtext></m:mrow></m:math> સવારે 11 વાગ્યે તાપમાન કેટલું છે?</para>
</problem>
<solution id="fs-id1166761493067">
<para id="fs-id1166761493069">4 ડિગ્રી સેલ્સિયસ</para>
</solution>
</exercise>
</note>
<note id="fs-id1171105475735" class="try">
<exercise id="fs-id1166761493074">
<problem id="fs-id1166761493076">
<para id="fs-id1166761493078">એક સ્કૂબા ડાઇવર પાણીની સપાટીથી <m:math><m:mrow><m:mtext>16 ફૂટ</m:mtext></m:mrow></m:math> નીચે તરી રહી હતી અને પછી વધુ <m:math><m:mrow><m:mtext>17 ફૂટ</m:mtext></m:mrow></m:math> નીચે ગઈ. હવે તેની નવી ઊંડાઈ કેટલી છે?</para>
</problem>
<solution id="fs-id1166761493084">
<para id="fs-id1166761493086">−33 ફૂટ</para>
</solution>
</exercise>
</note>
<example id="fs-id1166761493092">
<exercise id="fs-id1166761493094"><problem id="fs-id1166761493096">
<para id="fs-id1166761493099">ફૂટબૉલ ટીમે પોતાની <m:math><m:mrow><m:mtext>42-યાર્ડ રેખા પર દડો મેળવ્યો.</m:mtext></m:mrow></m:math> પછીની ત્રણ ચાલમાં તેમણે <m:math><m:mrow><m:mtext>6 યાર્ડ ગુમાવ્યા,</m:mtext></m:mrow></m:math> પછી <m:math><m:mrow><m:mtext>4 યાર્ડ મેળવ્યા</m:mtext></m:mrow></m:math> અને અંતે <m:math><m:mrow><m:mtext>8 યાર્ડ ગુમાવ્યા.</m:mtext></m:mrow></m:math> ત્રણેય ચાલના અંતે દડો કઈ યાર્ડ રેખા પર હતો?</para>
</problem>
<solution id="fs-id1166761493105">
<title>ઉકેલ</title>
<para id="fs-id1166761493107">આપણે ત્રણ ચાલના અંતે દડો કઈ યાર્ડ રેખા પર હતો તે શોધવાનું છે.</para>
<table id="eip-id1168468536362" class="unstyled" summary="દડાના સ્થાનનો વ્યવહારુ પ્રશ્ન ગાણિતિક લખાવટમાં ફેરવી, સરળ કરી અને અંતિમ જવાબનું વાક્ય લખવાનાં પગલાં દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry>દડાના સ્થાન માટે શબ્દસમૂહ લખો.</entry>
    <entry>42થી શરૂ કરો, પછી 6 ગુમાવો, 4 મેળવો અને 8 ગુમાવો.</entry>
  </row>
  <row>
    <entry>ગાણિતિક લખાવટમાં ફેરવો.</entry>
    <entry>42 − 6 + 4 − 8</entry>
  </row>
  <row>
    <entry>સરળ કરો.</entry>
    <entry>32</entry>
  </row>

  <row>
    <entry>પ્રશ્નનો જવાબ આપવા વાક્ય લખો.</entry>
    <entry>ત્રણેય ચાલના અંતે દડો 32-યાર્ડ રેખા પર છે.</entry>
  </row>
</tbody>





</tgroup>
</table></solution>

</exercise></example>
<note id="fs-id1166761493176" class="try">
<exercise id="fs-id1166761493180">
<problem id="fs-id1166761493182">
<para id="fs-id1166761493184">બેયર્સે પોતાની <m:math><m:mrow><m:mtext>20-યાર્ડ રેખા પર દડો મેળવ્યો.</m:mtext></m:mrow></m:math> પછીની ત્રણ ચાલમાં તેમણે <m:math><m:mrow><m:mtext>9 યાર્ડ ગુમાવ્યા,</m:mtext></m:mrow></m:math> પછી <m:math><m:mrow><m:mtext>7 યાર્ડ મેળવ્યા</m:mtext></m:mrow></m:math> અને અંતે <m:math><m:mrow><m:mtext>4 યાર્ડ ગુમાવ્યા.</m:mtext></m:mrow></m:math> ત્રણેય ચાલના અંતે દડો કઈ યાર્ડ રેખા પર હતો?</para>
</problem>
<solution id="fs-id1166761493190">
<para id="fs-id1166761493192">14-યાર્ડ રેખા</para>
</solution>
</exercise>
</note>
<note id="fs-id1171105140220" class="try">
<exercise id="fs-id1166761493198">
<problem id="fs-id1166761493200">
<para id="fs-id1166761493202">ચાર્જર્સે દડા સાથે પોતાની <m:math><m:mrow><m:mtext>25-યાર્ડ રેખાથી શરૂઆત કરી.</m:mtext></m:mrow></m:math> પછીની ત્રણ ચાલમાં તેમણે <m:math><m:mrow><m:mtext>5 યાર્ડ મેળવ્યા,</m:mtext></m:mrow></m:math> પછી <m:math><m:mrow><m:mtext>8 યાર્ડ ગુમાવ્યા</m:mtext></m:mrow></m:math> અને અંતે <m:math><m:mrow><m:mtext>15 યાર્ડ મેળવ્યા.</m:mtext></m:mrow></m:math> આ ચાલના અંતે દડો ક્યાં હતો?</para>
</problem>
<solution id="fs-id1166761493208">
<para id="fs-id1166761493210">37-યાર્ડ રેખા</para>
</solution>
</exercise>
</note>
<note id="fs-id1166761493216" class="media-2"><title>વધારાનાં ઑનલાઇન સાધનો જુઓ</title><list id="fs-id1166761493225" display="block">
<item><link url="https://openstaxcollege.org/l/24samesigncount">રંગીન કાઉન્ટર વડે સમાન નિશાનીવાળા પૂર્ણાંકોનો સરવાળો</link></item>
<item><link url="https://openstaxcollege.org/l/24diffsigncount">કાઉન્ટર વડે જુદી નિશાનીવાળા પૂર્ણાંકોનો સરવાળો</link></item>
<item><link url="https://openstaxcollege.org/l/24Ex1Add">ઉદાહરણ 1: પૂર્ણાંકોનો સરવાળો</link></item>
<item><link url="https://openstaxcollege.org/l/24Ex2Add">ઉદાહરણ 2: પૂર્ણાંકોનો સરવાળો</link></item>
</list>
</note></section>
<section id="fs-id1166761493264" class="key-concepts">
<title>મુખ્ય ખ્યાલો</title>
<list id="fs-id1166761493271" list-type="bulleted" bullet-style="bullet"><item><emphasis effect="bold">ધન અને ઋણ પૂર્ણાંકોનો સરવાળો</emphasis>
<table id="eip-id1168466149317" class="unnumbered" summary="કોષ્ટક સમાન અને જુદી નિશાનીઓ ધરાવતી સંખ્યાઓનાં ઉદાહરણો તથા પરિણામો વડે પૂર્ણાંકોના સરવાળાના નિયમો દર્શાવે છે."><label /><tgroup cols="2"><colspec colnum="1" colname="c1" />
    <colspec colnum="2" colname="c2" />
    <colspec colnum="3" colname="c3" /><tbody>
  <row>
    <entry align="center"><m:math><m:mn>5</m:mn><m:mo>+</m:mo><m:mn>3</m:mn></m:math></entry>
    <entry align="center"><m:math><m:mn>−5</m:mn><m:mo>+</m:mo><m:mo>(</m:mo><m:mn>−3</m:mn><m:mo>)</m:mo></m:math></entry>
  </row>
  <row>
    <entry align="center">બંને ધન, સરવાળો ધન</entry>
    <entry align="center">બંને ઋણ, સરવાળો ઋણ</entry>
  </row>
<row>
<entry align="center" namest="c1" nameend="c2">નિશાનીઓ સમાન હોય ત્યારે બધા કાઉન્ટર એક જ રંગના હોય છે, તેથી તેમનો સરવાળો કરો.</entry>
</row>
 <row>
 <entry align="center"><m:math><m:mn>−5</m:mn><m:mo>+</m:mo><m:mn>3</m:mn></m:math></entry>
    <entry align="center"><m:math><m:mn>5</m:mn><m:mo>+</m:mo><m:mo>(</m:mo><m:mn>−3</m:mn><m:mo>)</m:mo></m:math></entry>
  </row>
<row>
<entry align="center">જુદી નિશાનીઓ, ઋણ વધુ</entry>
<entry align="center">જુદી નિશાનીઓ, ધન વધુ</entry>
</row>
<row>
<entry align="center">સરવાળો ઋણ</entry><entry align="center">સરવાળો ધન</entry>
</row>
<row><entry align="center" namest="c1" nameend="c2">નિશાનીઓ જુદી હોય ત્યારે કેટલાક કાઉન્ટર શૂન્ય બનાવતી જોડીઓ બનાવે છે; કેટલા બાકી રહે છે તે જોવા બાદબાકી કરો.</entry>
</row>
</tbody>
</tgroup>
</table></item>
</list></section>
<section id="fs-id1166761493305" class="section-exercises">
<section id="fs-id1584663" class="practice-perfect"><title>અભ્યાસથી નિપુણતા મળે</title><para id="fs-id1542968"><emphasis effect="bold">પૂર્ણાંકોના સરવાળાને નમૂના દ્વારા દર્શાવો</emphasis> </para><para id="eip-536">નીચેના અભ્યાસમાં પદાવલીને સરળ કરવા તેનો નમૂનો બનાવો.</para><exercise id="fs-id1166761493321">
<problem id="fs-id1166761493324">
<para id="fs-id1166761493326"><m:math><m:mrow><m:mn>7</m:mn><m:mo>+</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761493337">
<para id="fs-id1171103414219"><newline />
<media id="fs-id1166761493340" alt="ચિત્રમાં ધન કાઉન્ટર દર્શાવતાં 11 આછાં ગુલાબી વર્તુળની હરોળ છે. તેમાં સાત અને ચાર વર્તુળનાં અલગ જૂથ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_201_img.jpg" />
</media><newline />11</para>
</solution>
</exercise>
<exercise id="fs-id1166761493357">
<problem id="fs-id1166761493359">
<para id="fs-id1166761493361"><m:math><m:mrow><m:mn>8</m:mn><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1166761493374">
<problem id="fs-id1166761493376">
<para id="fs-id1166761493378"><m:math><m:mrow><m:mn>−6</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761493402">
<para id="fs-id1171105198092"><newline />
<media id="fs-id1166761493404" alt="ચિત્રમાં ઋણ કાઉન્ટર દર્શાવતાં 9 ઘેરાં ગુલાબી વર્તુળની હરોળ છે. તેમાં છ અને ત્રણ વર્તુળનાં અલગ જૂથ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_203_img.jpg" />
</media><newline />−9</para>
</solution>
</exercise>
<exercise id="fs-id1166761493421">
<problem id="fs-id1166761493424">
<para id="fs-id1166761493426"><m:math><m:mrow><m:mn>−5</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1166761493451">
<problem id="fs-id1166761493453">
<para id="fs-id1166761493455"><m:math><m:mrow><m:mn>−7</m:mn><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1166761493469">
<para id="fs-id1171105519846"><newline />
<media id="fs-id1166761493471" alt="ચિત્રમાં વર્તુળની બે હરોળ છે. ઉપરની હરોળમાં ઋણ કાઉન્ટર દર્શાવતાં 7 ઘેરાં ગુલાબી વર્તુળ અને નીચેની હરોળમાં ધન કાઉન્ટર દર્શાવતાં 5 આછાં ગુલાબી વર્તુળ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_205_img.jpg" />
</media><newline />−2</para>
</solution>
</exercise>
<exercise id="fs-id1987723">
<problem id="fs-id1302504">
<para id="fs-id1827109"><m:math><m:mrow><m:mn>−9</m:mn><m:mo>+</m:mo><m:mn>6</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1365970">
<problem id="fs-id1787690">
<para id="fs-id2472190"><m:math><m:mrow><m:mn>8</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−7</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2486708">
<para id="fs-id1171105216252"><newline />
<media id="fs-id1388604" alt="ચિત્રમાં વર્તુળની બે હરોળ છે. ઉપરની હરોળમાં ધન કાઉન્ટર દર્શાવતાં 8 આછાં ગુલાબી વર્તુળ અને નીચેની હરોળમાં ઋણ કાઉન્ટર દર્શાવતાં 7 આછાં ગુલાબી વર્તુળ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_02_207_img.jpg" />
</media><newline />1</para>
</solution>
</exercise>
