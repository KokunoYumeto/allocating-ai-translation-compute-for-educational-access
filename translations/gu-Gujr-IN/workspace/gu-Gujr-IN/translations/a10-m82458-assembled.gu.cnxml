</problem>
</exercise>
<exercise id="fs-id1170655003382">
<problem id="fs-id1170655092407">
<para id="fs-id1170655092410">0.0875</para>
</problem>
<solution id="fs-id1170655092414">
<para id="fs-id1170655076444">8.75%</para>
</solution>
</exercise>
<exercise id="fs-id1170655076449">
<problem id="fs-id1170655076451">
<para id="fs-id1170655225645">0.0625</para>
</problem>
</exercise>
<exercise id="fs-id1170655189505">
<problem id="fs-id1170655189507">
<para id="fs-id1170655188665">2.254</para>
</problem>
<solution id="fs-id1170655188669">
<para id="fs-id1170655188671">225.4%</para>
</solution>
