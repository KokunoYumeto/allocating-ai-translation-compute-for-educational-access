<?xml version='1.0' encoding='utf-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" xmlns:ns1="http://cnx.rice.edu/mdml" xml:lang="gu-Gujr-IN">

<title>દશાંશ</title>
<metadata>
  <ns1:content-id>m82458</ns1:content-id>
  <ns1:title>દશાંશ</ns1:title>
  <ns1:abstract><para id="para-00001">આ વિભાગના અંતે તમે આ કરી શકશો:</para>
<list id="list-00001">
<item>દશાંશને શબ્દોમાં અને અંકોમાં લખવા</item>
<item>દશાંશને નજીકની આપેલી સ્થાનકિંમતમાં ફેરવવા</item>
<item>દશાંશનો સરવાળો અને બાદબાકી કરવા</item>
<item>દશાંશનો ગુણાકાર અને ભાગાકાર કરવા</item>
<item>દશાંશ, અપૂર્ણાંક અને ટકાને એકબીજાના સ્વરૂપમાં ફેરવવા</item>
</list></ns1:abstract>
  <ns1:uuid>cf181a65-4991-4731-8f57-56f92ba6ae42</ns1:uuid>
</metadata>

<content>
<note id="fs-id1170655027416" class="be-prepared">
<para id="fs-id1170655083922">આ વિભાગના વિષયોનો વધુ વિગતવાર પરિચય <emphasis effect="italics">પૂર્વબીજગણિત</emphasis> પુસ્તકના આ પ્રકરણમાં મળે છે: <emphasis effect="bold">દશાંશ</emphasis>.</para>
</note>
<section id="fs-id1170654884238">
<title>દશાંશને શબ્દોમાં અને અંકોમાં લખો</title>
<para id="fs-id1170655162670"><emphasis effect="bold">દશાંશ</emphasis> એ એવા <term class="no-emphasis" id="term-00001">અપૂર્ણાંક</term>ને લખવાની બીજી રીત છે, જેમના છેદ 10ની ઘાત હોય છે.</para>
<equation id="fs-id1170654967853" class="unnumbered"><label /><m:math><m:mtable><m:mtr><m:mtd columnalign="right"><m:mn>0.1</m:mn></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac></m:mtd><m:mtd /><m:mtd /><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mn>0.1</m:mn><m:mspace width="0.2em" /><m:mtext>એટલે “એક દશાંશ”</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>0.01</m:mn></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>100</m:mn></m:mrow></m:mfrac></m:mtd><m:mtd /><m:mtd /><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mn>0.01</m:mn><m:mspace width="0.2em" /><m:mtext>એટલે “એક શતાંશ”</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>0.001</m:mn></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>1,000</m:mn></m:mrow></m:mfrac></m:mtd><m:mtd /><m:mtd /><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mtext>0.001 એટલે “એક સહસ્રાંશ”</m:mtext></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:mn>0.0001</m:mn></m:mtd><m:mtd columnalign="left"><m:mo>=</m:mo></m:mtd><m:mtd columnalign="left"><m:mfrac><m:mn>1</m:mn><m:mrow><m:mn>10,000</m:mn></m:mrow></m:mfrac></m:mtd><m:mtd /><m:mtd /><m:mtd /><m:mtd /><m:mtd columnalign="left"><m:mtext>0.0001 એટલે “એક દસ-સહસ્રાંશ”</m:mtext></m:mtd></m:mtr></m:mtable></m:math></equation>
<para id="fs-id1170655082460">ધ્યાન આપો: અંગ્રેજી “ten thousand” એટલે દસ હજાર, જે એક કરતાં મોટી સંખ્યા છે; પણ “one ten-thousand<emphasis effect="bold">th</emphasis>” એટલે દસ હજારમો ભાગ, જે એક કરતાં નાનો છે. આ અંગ્રેજી નામના અંતે “th” આવવાથી અહીં એક કરતાં નાનો ભાગ સૂચવાય છે.</para>
<para id="fs-id1170655157626">પૂર્ણ સંખ્યાનું નામ તેની સ્થાનકિંમત પ્રમાણે હોય છે, જે દસની ઘાતો પર આધારિત છે. આપણે 10,000ને “દસ હજાર” અને 10,000,000ને “દસ મિલિયન” વાંચીએ છીએ. એ જ રીતે, <term class="no-emphasis" id="term-00002">દશાંશ</term> સ્થાનોનાં નામ તેમની અપૂર્ણાંક કિંમતો સાથે સંબંધિત છે. <link target-id="CNX_ElemAlg_Figure_01_07_001_new" /> માં દર્શાવેલાં છે <term class="no-emphasis" id="term-00003">સ્થાનકિંમત</term> નાં નામ, દશાંશ ચિહ્નની ડાબી અને જમણી બાજુએ.</para>
<figure id="CNX_ElemAlg_Figure_01_07_001_new">
<media id="fs-id1170654939786" alt="“સ્થાનકિંમત” મથાળાવાળું કોષ્ટક છે. ડાબેથી જમણે “સો હજાર”, “દસ હજાર”, “હજાર”, “સો”, “દશક” અને “એકમ” છે. પછી એક ખાલી ખાનું છે, જેની નીચે દશાંશ ચિહ્ન છે. જમણે “દશાંશ”, “શતાંશ”, “સહસ્રાંશ”, “દસ-સહસ્રાંશ” અને “લક્ષાંશ” છે; આ અનુક્રમે 1/10, 1/100, 1/1000, 1/10000 અને 1/100000નાં સ્થાન છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_07_001_new.jpg" />
</media>
<caption>દશાંશ સંખ્યાની સ્થાનકિંમતો દશાંશ ચિહ્નની ડાબી અને જમણી બાજુએ દર્શાવી છે.</caption>
</figure>
<example id="fs-id1170655082372">
<title>દશાંશને શબ્દોમાં કેવી રીતે લખવું</title>
<exercise id="fs-id1170655124389">
<problem id="fs-id1170655154728">
<para id="fs-id1170654953397">દશાંશ 4.3ને શબ્દોમાં લખો.</para>
</problem>
<solution id="fs-id1170655130426">
<title>ઉકેલ</title>
<media id="fs-id1170655232620" alt="આ ચાર પગલાંની શ્રેણીનો પહેલો ભાગ છે; સંખ્યા 4.3 આપી છે. સૂચના છે: “પગલું 1. દશાંશ ચિહ્નની ડાબી બાજુની સંખ્યાને શબ્દોમાં લખો.” જમણે લખ્યું છે: “દશાંશ ચિહ્નની ડાબે 4 છે.” તેની જમણે “ચાર” અને પછી મોટી ખાલી જગ્યા છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_07_002a_new.jpg" />
</media>
<media id="fs-id1170654238417" alt="બીજું પગલું છે: “પગલું 2. દશાંશ ચિહ્ન માટે ‘અને’ લખો.” જમણે “ચાર અને” પછી ખાલી જગ્યા છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_07_002b_new.jpg" />
</media>
<media id="fs-id1170654235434" alt="ત્રીજું પગલું છે: “પગલું 3. દશાંશ ચિહ્નની જમણી બાજુના સંખ્યાભાગને પૂર્ણ સંખ્યા ગણીને શબ્દોમાં લખો.” જમણે “દશાંશ ચિહ્નની જમણે 3 છે” અને પછી “ચાર અને ત્રણ” પછી ખાલી જગ્યા છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_07_002c_new.jpg" />
</media>
<media id="fs-id1170654221344" alt="છેલ્લું પગલું છે: “પગલું 4. દશાંશ સ્થાનનું નામ લખો.” જમણે “ચાર અને ત્રણ દશાંશ” લખ્યું છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_07_002d_new.jpg" />
</media>
</solution>
</exercise>
</example>
<note id="fs-id1170654968812" class="try">
<exercise id="fs-id1170655083604">
<problem id="fs-id1170655126801">
<para id="fs-id1170655166442">દશાંશને શબ્દોમાં લખો: <m:math><m:mrow><m:mn>6.7</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655123982">
<para id="fs-id1170655027731">છ અને સાત દશાંશ</para>
</solution>
</exercise>
</note>
<note id="fs-id1170655007274" class="try">
<exercise id="fs-id1170655263759">
<problem id="fs-id1170655204364">
<para id="fs-id1170655195222">દશાંશને શબ્દોમાં લખો: <m:math><m:mrow><m:mn>5.8</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654986335">
<para id="fs-id1170654859071">પાંચ અને આઠ દશાંશ</para>
</solution>
</exercise>
</note>
<para id="fs-id1170655192852"><term class="no-emphasis" id="term-00004">દશાંશ</term>ને શબ્દોમાં લખવાનાં જરૂરી પગલાંનો સારાંશ નીચે આપ્યો છે.</para>
<note id="fs-id1170654942148" class="howto">
<title>દશાંશને શબ્દોમાં લખો.</title>
<list id="fs-id1166424843973" list-type="enumerated" number-style="arabic" class="stepwise">
<item>દશાંશ ચિહ્નની ડાબી બાજુની સંખ્યાને શબ્દોમાં લખો.</item>
<item>દશાંશ ચિહ્ન માટે “અને” લખો.</item>
<item>દશાંશ ચિહ્નની જમણી બાજુના સંખ્યાભાગને પૂર્ણ સંખ્યા ગણીને શબ્દોમાં લખો.</item>
<item>છેલ્લા અંકના દશાંશ સ્થાનનું નામ લખો.</item>
</list>
</note>
<example id="fs-id1170654871253"><exercise id="fs-id1170655202724"><problem id="fs-id1170654944254">
<para id="fs-id1170653216327">દશાંશને શબ્દોમાં લખો: <m:math><m:mrow><m:mn>−15.571</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654978509">
<title>ઉકેલ</title>
<table id="eip-237" class="unnumbered unstyled" summary="દશાંશ −15.571ને શબ્દોમાં લખવાની પગલાંવાર રીત દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry><m:math><m:mn>−15.571</m:mn></m:math></entry>
  </row>
  <row>
    <entry>દશાંશ ચિહ્નની ડાબી બાજુની સંખ્યાને શબ્દોમાં લખો.</entry>
    <entry>ઋણ પંદર __________________________________</entry>
  </row>
  <row>
    <entry>દશાંશ ચિહ્ન માટે “અને” લખો.</entry>
    <entry>ઋણ પંદર અને ______________________________</entry>
  </row>
  <row>
    <entry>દશાંશ ચિહ્નની જમણી બાજુની સંખ્યાને શબ્દોમાં લખો.</entry>
    <entry>ઋણ પંદર અને પાંચસો એકોતેર __________</entry>
  </row>
  <row>
    <entry>1 સહસ્રાંશના સ્થાને છે.</entry>
    <entry>ઋણ પંદર અને પાંચસો એકોતેર સહસ્રાંશ</entry>
  </row>
</tbody>


</tgroup>
</table>

</solution>
</exercise></example><note id="fs-id1170654932007" class="try">
<exercise id="fs-id1170655113246">
<problem id="fs-id1170655114489">
<para id="fs-id1170655200671">દશાંશને શબ્દોમાં લખો: <m:math><m:mrow><m:mn>−13.461</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654985394">
<para id="fs-id1170655161374">ઋણ તેર અને ચારસો એકસઠ સહસ્રાંશ</para>
</solution>
</exercise>
</note>
<note id="fs-id1170654904356" class="try">
<exercise id="fs-id1170655099371">
<problem id="fs-id1170654983710">
<para id="fs-id1170655213298">દશાંશને શબ્દોમાં લખો: <m:math><m:mrow><m:mn>−2.053</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655083252">
<para id="fs-id1170655201034">ઋણ બે અને ત્રેપન સહસ્રાંશ</para>
</solution>
</exercise>
</note>
<para id="fs-id1170654940662">ચેક લખતી વખતે આપણે સંખ્યાને અંકોમાં અને શબ્દોમાં બંને રીતે લખીએ છીએ. હવે શબ્દોમાં આપેલી સંખ્યાને દશાંશ સ્વરૂપે કેવી રીતે લખવી તે જોઈએ.</para>
<example id="fs-id1170654904903">
<title>દશાંશને અંકોમાં કેવી રીતે લખવું</title>
<exercise id="fs-id1170654940914">
<problem id="fs-id1170655099614">
<para id="fs-id1170655224187">“ચૌદ અને ચોવીસ સહસ્રાંશ”ને દશાંશ સ્વરૂપે લખો.</para>
</problem>
<solution id="fs-id1170655000728">
<title>ઉકેલ</title>
<media id="fs-id1170654903748" alt="આ ચાર પગલાંની શ્રેણીનો પહેલો ભાગ છે. સૂચના છે: “પગલું 1. ‘અને’ શબ્દ શોધો—તે દશાંશ ચિહ્નનું સ્થાન સૂચવે છે. ‘અને’ની નીચે દશાંશ ચિહ્ન મૂકો. ‘અને’ પહેલાંના શબ્દોને પૂર્ણ સંખ્યામાં ફેરવીને દશાંશ ચિહ્નની ડાબે લખો.” જમણે “ચૌદ અને ચોવીસ સહસ્રાંશ” લખ્યું છે. નીચે એ જ શબ્દોમાં “અને”ને રેખાંકિત કર્યું છે. નીચે દશાંશ ચિહ્નની ડાબે નાની અને જમણે મોટી ખાલી જગ્યા છે. તેની નીચે નાની જગ્યામાં 14, પછી દશાંશ ચિહ્ન અને મોટી ખાલી જગ્યા છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_07_003a_new.jpg" />
</media>
<media id="fs-id1170654048412" alt="બીજું પગલું છે: “પગલું 2. છેલ્લા શબ્દમાં આપેલી સ્થાનકિંમત પરથી દશાંશ ચિહ્નની જમણે જરૂરી સ્થાનો ચિહ્નિત કરો.” જમણે “છેલ્લો શબ્દ સહસ્રાંશ છે” લખ્યું છે. આગળ 14 પછી દશાંશ ચિહ્ન અને ત્રણ નાની ખાલી જગ્યાઓ છે; નીચે “દશાંશ”, “શતાંશ” અને “સહસ્રાંશ” લખ્યાં છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_07_003b_new.jpg" />
</media>
<media id="fs-id1170654048180" alt="ત્રીજું પગલું છે: “પગલું 3. ‘અને’ પછીના શબ્દોને સંખ્યામાં ફેરવીને દશાંશ ચિહ્નની જમણે લખો. છેલ્લો અંક છેલ્લા સ્થાને આવે તેમ ખાલી જગ્યામાં સંખ્યા લખો.” જમણે 14 પછી દશાંશ ચિહ્ન, એક ખાલી જગ્યા અને પછી અગાઉની બે ખાલી જગ્યામાં 2 અને 4 છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_07_003c_new.jpg" />
</media>
<media id="fs-id1170652616660" alt="છેલ્લું પગલું છે: “પગલું 4. જરૂર મુજબ ખાલી સ્થાનોમાં શૂન્ય ભરો.” જમણે “દશાંશના સ્થાને શૂન્ય જરૂરી છે” લખ્યું છે. આગળ 14 પછી દશાંશ ચિહ્ન અને ખાલી જગ્યાઓમાં અનુક્રમે 0, 2 અને 4 છે. નીચે “‘ચૌદ અને ચોવીસ સહસ્રાંશ’ને 14.024 લખાય છે” લખ્યું છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_07_003d_new.jpg" />
</media>
</solution>
</exercise>
</example>
<note id="fs-id1170655134448" class="try">
<exercise id="fs-id1170655207773">
<problem id="fs-id1170655000928">
<para id="fs-id1170654941684">દશાંશ સ્વરૂપે લખો: તેર અને અડસઠ સહસ્રાંશ.</para>
</problem>
<solution id="fs-id1170654904167">
<para id="fs-id1170654938597">13.068</para>
</solution>
</exercise>
</note>
<note id="fs-id1170655198811" class="try">
<exercise id="fs-id1170655068592">
<problem id="fs-id1170654967488">
<para id="fs-id1170654943669">દશાંશ સ્વરૂપે લખો: પાંચ અને ચોરાણું સહસ્રાંશ.</para>
</problem>
<solution id="fs-id1170655099905">
<para id="fs-id1170654854792">5.094</para>
</solution>
</exercise>
</note>
<para id="fs-id1170654928706"><term class="no-emphasis" id="term-00005">દશાંશ</term>ને અંકોમાં લખવાનાં પગલાંનો સારાંશ નીચે આપ્યો છે.</para>
<note id="fs-id1170654962479" class="howto">
<title>દશાંશને અંકોમાં લખો.</title>
<list id="fs-id1166424904966" list-type="enumerated" number-style="arabic" class="stepwise">
<item>“અને” શબ્દ શોધો—તે દશાંશ ચિહ્નનું સ્થાન સૂચવે છે.
<list id="fs-id1170655091046" list-type="bulleted" bullet-style="bullet">
<item>“અને” શબ્દની નીચે દશાંશ ચિહ્ન મૂકો. “અને” પહેલાંના શબ્દોને પૂર્ણ સંખ્યામાં ફેરવો અને તેને દશાંશ ચિહ્નની ડાબે લખો.</item>
<item>જો “અને” ન હોય, તો “0” લખીને તેની જમણે દશાંશ ચિહ્ન મૂકો.</item>
</list></item>
<item>છેલ્લા શબ્દમાં આપેલી સ્થાનકિંમત પરથી દશાંશ ચિહ્નની જમણે જરૂરી સ્થાનો ચિહ્નિત કરો.</item>
<item>“અને” પછીના શબ્દોને સંખ્યામાં ફેરવીને દશાંશ ચિહ્નની જમણે લખો. છેલ્લો અંક છેલ્લા સ્થાને આવે તેમ ખાલી જગ્યામાં સંખ્યા લખો.</item>
<item>જરૂર મુજબ ખાલી સ્થાનોમાં શૂન્ય ભરો.</item>
</list>
</note>
</section>
<section id="fs-id1170655091067">
<title>દશાંશને નજીકની આપેલી સ્થાનકિંમતમાં ફેરવો</title>
<para id="fs-id1170654977720">દશાંશને નજીકની આપેલી સ્થાનકિંમતમાં ફેરવવું, એટલે કે ગોળ કરવું, પૂર્ણ સંખ્યાઓને ફેરવવા જેવું જ છે. પૂર્ણ સંખ્યાઓ માટે વાપરેલી રીતના આધારે આપણે દશાંશને ફેરવીશું.</para>
<example id="fs-id1170655128638">
<title>દશાંશને નજીકની આપેલી સ્થાનકિંમતમાં કેવી રીતે ફેરવવું</title>
<exercise id="fs-id1170654965636">
<problem id="fs-id1170655162744">
<para id="fs-id1170654989897">18.379ને નજીકના શતાંશમાં ફેરવો.</para>
</problem>
<solution id="fs-id1170655213305"><title>ઉકેલ</title>
<media id="fs-id1170655218662" alt="આ ચાર પગલાંની શ્રેણીનો પહેલો ભાગ છે: “આપેલી સ્થાનકિંમત શોધીને તેના પર તીર મૂકો.” જમણે 18.379માં “શતાંશનું સ્થાન” પરથી તીર 7 તરફ જાય છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_07_004a_new.jpg" />
</media>
<media id="fs-id1170653985218" alt="બીજું પગલું છે: “પગલું 2. આપેલી સ્થાનકિંમતની જમણી બાજુના અંકને રેખાંકિત કરો.” જમણે 18.379માં 9 રેખાંકિત છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_07_004b_new.jpg" />
</media>
<media id="fs-id1170653901496" alt="ત્રીજું પગલું છે: “પગલું 3. શું આ અંક 5 કરતાં મોટો અથવા બરાબર છે?” નીચે છે: “હા: આપેલી સ્થાનકિંમતના અંકમાં 1 ઉમેરો.” તેની નીચે છે: “ના: આપેલી સ્થાનકિંમતના અંકને બદલશો નહીં.” જમણે લખ્યું છે: “9 એ 5 કરતાં મોટો અથવા બરાબર છે, એટલે 7માં 1 ઉમેરો” આગળ 18.379માં 9 પાસે “કાઢો” અને 7 પાસે “1 ઉમેરો” લખ્યું છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_07_004c_new.jpg" />
</media>
<media id="fs-id1170653744228" alt="છેલ્લું પગલું છે: “પગલું 4. જે અંક સુધી ફેરવવાનું છે તેની જમણી બાજુના બધા અંક કાઢીને સંખ્યા ફરી લખો.” જમણે 18.38 પછી લખ્યું છે: “18.379ને નજીકના શતાંશમાં ફેરવતાં 18.38 મળે છે.”">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_07_004d_new.jpg" />
</media>
</solution>
</exercise>
</example>
<note id="fs-id1170654989566" class="try">
<exercise id="fs-id1170655025200">
<problem id="fs-id1170655027579">
<para id="fs-id1170654954676">નજીકના શતાંશમાં ફેરવો: <m:math><m:mrow><m:mn>1.047</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655195781">
<para id="fs-id1170654903945">1.05</para>
</solution>
</exercise>
</note>
<note id="fs-id1170655201251" class="try">
<exercise id="fs-id1170653235541">
<problem id="fs-id1170655120820">
<para id="fs-id1170654952450">નજીકના શતાંશમાં ફેરવો: <m:math><m:mrow><m:mn>9.173</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655189000">
<para id="fs-id1170654951631">9.17</para>
</solution>
</exercise>
</note>
<para id="fs-id1170655029280"><term class="no-emphasis" id="term-00006">દશાંશ</term>ને નજીકની આપેલી સ્થાનકિંમતમાં ફેરવવાનાં પગલાંનો સારાંશ નીચે આપ્યો છે.</para>
<para id="fs-id1166422577018"><newline /></para>
<note id="fs-id1170653237730" class="howto">
<title>દશાંશને નજીકની આપેલી સ્થાનકિંમતમાં ફેરવો.</title>
<list id="fs-id1166424888811" list-type="enumerated" number-style="arabic" class="stepwise">
<item>આપેલી સ્થાનકિંમત શોધીને તેના પર તીર મૂકો.</item>
<item>તે સ્થાનકિંમતની જમણી બાજુના અંકને રેખાંકિત કરો.</item>
<item>શું આ અંક 5 કરતાં મોટો અથવા બરાબર છે?
<list id="fs-id1170655166985" list-type="bulleted" bullet-style="bullet">
<item>હા—આપેલી સ્થાનકિંમતના અંકમાં 1 ઉમેરો.</item>
<item>ના—આપેલી સ્થાનકિંમતના અંકને <emphasis effect="underline">બદલશો નહીં</emphasis> .</item>
</list></item>
<item>જે અંક સુધી ફેરવવાનું છે તેની જમણી બાજુના બધા અંક કાઢીને સંખ્યા ફરી લખો.</item>
</list>
</note>
<example id="fs-id1170655158137">
<exercise id="fs-id1170655162272">
<problem id="fs-id1170655195278">
<para id="fs-id1170655399363">18.379ને નજીકના આ સ્થાને ફેરવો: <span class="token">ⓐ</span> દશાંશ <span class="token">ⓑ</span> પૂર્ણ સંખ્યા.</para>
</problem>
<solution id="fs-id1170654872675">
<title>ઉકેલ</title>
<para id="fs-id1170654935270">18.379ને ફેરવો</para>
<list id="fs-id1166422548075" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> નજીકના દશાંશમાં<newline />
<table id="eip-id1169752878832" class="unnumbered unstyled can-break" aria-label="ચાર પગલાંનું કોષ્ટક છે. પહેલા પગલામાં દશાંશના સ્થાન પર તીર મૂકવાનું કહ્યું છે; 18.379માં તીર 3 તરફ જાય છે. બીજામાં તેની જમણી બાજુનો અંક રેખાંકિત કરવાનું કહ્યું છે; 7 રેખાંકિત છે. ત્રીજામાં “7 એ 5 કરતાં મોટો અથવા બરાબર હોવાથી 3માં 1 ઉમેરો” લખ્યું છે; 7 અને 9 પાસે “કાઢો” અને 3 પાસે “1 ઉમેરો” છે. છેલ્લા પગલામાં દશાંશના સ્થાનની જમણી બાજુના બધા અંક કાઢીને સંખ્યા ફરી લખવાનું કહ્યું છે. જમણે 18.4 અને પછી “એટલે 18.379ને નજીકના દશાંશમાં ફેરવતાં 18.4 મળે છે” લખ્યું છે.">
<label /><tgroup cols="2">
 <tbody>
  <row>
    <entry>દશાંશના સ્થાન પર તીર મૂકો.</entry>
    <entry><media id="eip-id1169752964044" alt="“દશાંશનું સ્થાન” શબ્દોમાંથી તીર 18.379ના 3 તરફ જાય છે અને તેનું દશાંશનું સ્થાન બતાવે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_005a_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>આપેલી સ્થાનકિંમતની જમણી બાજુના અંકને રેખાંકિત કરો.</entry>
    <entry><media id="eip-id1169752799574" alt="18.379માં “દશાંશનું સ્થાન” પરથી તીર 3 તરફ જાય છે; તેની જમણી બાજુનો અંક 7 રેખાંકિત છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_005b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>7 એ 5 કરતાં મોટો અથવા બરાબર હોવાથી 3માં 1 ઉમેરો.</entry>
    <entry><media id="eip-id1169750840488" alt="18.379માં 3 તરફ “1 ઉમેરો”નું તીર છે; જમણી બાજુના અંકો 7 અને 9 પાસે “કાઢો” છે. આ નજીકના દશાંશમાં ફેરવવાનું પગલું છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_005c_img_new.jpg" /></media></entry>
  </row>
    <row>
    <entry>જે અંક સુધી ફેરવવાનું છે તેની જમણી બાજુના બધા અંક કાઢીને સંખ્યા ફરી લખો.</entry>
    <entry><media id="eip-id1169750591270" alt="સફેદ પૃષ્ઠભૂમિ પર 18.4 સંખ્યા છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_005d_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>ધ્યાન આપો: કાઢેલા અંકોની જગ્યાએ શૂન્ય મૂક્યાં નથી.</entry>
    <entry>એટલે 18.379ને નજીકના દશાંશમાં ફેરવતાં 18.4 મળે છે.</entry>
  </row>
 </tbody>

</tgroup>
</table><newline /><newline /></item>
<item><span class="token">ⓑ</span> નજીકની પૂર્ણ સંખ્યામાં<newline />
<table id="eip-id1169754002832" class="unnumbered unstyled can-break" aria-label="ચાર પગલાંનું કોષ્ટક છે. પહેલા પગલામાં એકમના સ્થાન પર તીર મૂકવાનું કહ્યું છે; 18.379માં તીર 8 તરફ જાય છે. બીજામાં તેની જમણી બાજુના અંકને રેખાંકિત કરવાનું કહ્યું છે; 3 રેખાંકિત છે. ત્રીજામાં “3 એ 5 કરતાં મોટો અથવા બરાબર નથી, તેથી 8માં 1 ઉમેરશો નહીં” લખ્યું છે; 3, 7 અને 9 પાસે “કાઢો” અને 8 પાસે “1 ઉમેરશો નહીં” છે. છેલ્લા પગલામાં એકમના સ્થાનની જમણી બાજુના બધા અંક કાઢીને સંખ્યા ફરી લખવાનું કહ્યું છે. જમણે 18 અને પછી “એટલે 18.379ને નજીકની પૂર્ણ સંખ્યામાં ફેરવતાં 18 મળે છે” લખ્યું છે.">
<label /><tgroup cols="2">
 <tbody>
  <row>
    <entry>એકમના સ્થાન પર તીર મૂકો.</entry>
    <entry><media id="eip-id1169754058794" alt="“એકમનું સ્થાન” શબ્દોમાંથી તીર 18.379ના 8 તરફ જાય છે અને તેનું સ્થાન બતાવે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_006a_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>આપેલી સ્થાનકિંમતની જમણી બાજુના અંકને રેખાંકિત કરો.</entry>
    <entry><media id="eip-id1169754058811" alt="18.379માં “એકમનું સ્થાન” પરથી તીર 8 તરફ જાય છે; તેની જમણી બાજુનો અંક 3 રેખાંકિત છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_006b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>3 એ 5 કરતાં મોટો અથવા બરાબર નથી, તેથી 8માં 1 ઉમેરશો નહીં.</entry>
    <entry><media id="eip-id1169754362233" alt="18.379ને નીચેની નજીકની પૂર્ણ સંખ્યામાં ફેરવવાનું દર્શાવ્યું છે. દશાંશ ભાગ .379 “કાઢો” અને પૂર્ણ ભાગમાં “1 ઉમેરશો નહીં” લખ્યું છે, જેથી 18 મળે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_006c_img_new.jpg" /></media></entry>
  </row>
    <row>
    <entry>જે અંક સુધી ફેરવવાનું છે તેની જમણી બાજુના બધા અંક કાઢીને સંખ્યા ફરી લખો.</entry>
    <entry><media id="eip-id1169754362250" alt="સફેદ પૃષ્ઠભૂમિની ઉપર જમણી બાજુએ સંખ્યા 18 દેખાય છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_006d_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry />
    <entry>એટલે 18.379ને નજીકની પૂર્ણ સંખ્યામાં ફેરવતાં 18 મળે છે.</entry>
  </row>
 </tbody>

</tgroup>
</table></item>
</list></solution>
</exercise>
</example>
<note id="fs-id1170654989015" class="try">
<exercise id="fs-id1170655069621">
<problem id="fs-id1170655025740">
<para id="fs-id1170655190444">ફેરવો <m:math><m:mrow><m:mn>6.582</m:mn></m:mrow></m:math> નજીકના આ સ્થાને: <span class="token">ⓐ</span> શતાંશ <span class="token">ⓑ</span> દશાંશ <span class="token">ⓒ</span> પૂર્ણ સંખ્યા.</para>
</problem>
<solution id="fs-id1170655105998">
<para id="fs-id1170655232561"><span class="token">ⓐ</span> 6.58 <span class="token">ⓑ</span> 6.6 <span class="token">ⓒ</span> 7</para>
</solution>
</exercise>
</note>
<note id="fs-id1170655089024" class="try">
<exercise id="fs-id1170655000058">
<problem id="fs-id1170654989989">
<para id="fs-id1170655104214">ફેરવો <m:math><m:mrow><m:mn>15.2175</m:mn></m:mrow></m:math> નજીકના આ સ્થાને: <span class="token">ⓐ</span> સહસ્રાંશ <span class="token">ⓑ</span> શતાંશ <span class="token">ⓒ</span> દશાંશ.</para>
</problem>
<solution id="fs-id1170655197187">
<para id="fs-id1170655161963"><span class="token">ⓐ</span> 15.218 <span class="token">ⓑ</span> 15.22 <span class="token">ⓒ</span> 15.2</para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1170654977734">
<title>દશાંશનો સરવાળો અને બાદબાકી કરો</title>
<para id="fs-id1170655154216">દશાંશનો સરવાળો કે બાદબાકી કરવા દશાંશ ચિહ્નો એકની નીચે એક ગોઠવીએ છીએ. આમ ગોઠવવાથી આપણે અનુરૂપ <term class="no-emphasis" id="term-00007">સ્થાનકિંમત</term>નો સરવાળો કે બાદબાકી કરી શકીએ છીએ. પછી સંખ્યાઓને પૂર્ણ સંખ્યા ગણીને સરવાળો કે બાદબાકી કરીએ અને જવાબમાં દશાંશ ચિહ્ન મૂકીએ.</para>
<note id="fs-id1170654861951" class="howto">
<title>દશાંશનો સરવાળો કે બાદબાકી કરો.</title>
<list id="fs-id1166422560823" list-type="enumerated" number-style="arabic" class="stepwise">
<item>દશાંશ ચિહ્નો એકની નીચે એક આવે તેમ સંખ્યાઓ લખો.</item>
<item>જરૂર મુજબ ખાલી સ્થાનોમાં શૂન્ય વાપરો.</item>
<item>સંખ્યાઓને પૂર્ણ સંખ્યા ગણીને સરવાળો કે બાદબાકી કરો. પછી આપેલી સંખ્યાઓનાં દશાંશ ચિહ્નોની નીચે જવાબમાં દશાંશ ચિહ્ન મૂકો.</item>
</list>
</note>
<example id="fs-id1170654942217"><exercise id="fs-id1170655128622">
<problem id="fs-id1170655150934">
<para id="fs-id1170654982792">સરવાળો કરો: <m:math><m:mrow><m:mn>23.5</m:mn><m:mo>+</m:mo><m:mn>41.38</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654944111">
<title>ઉકેલ</title>
<table id="eip-474" summary="દશાંશ સંખ્યાઓના સરવાળાની પગલાંવાર રીત: સંખ્યાઓ ગોઠવવી, ખાલી સ્થાન માટે શૂન્ય મૂકવું અને અંતિમ સરવાળો શોધવો.">
<tgroup cols="2"><tbody>
  <row>
    <entry>દશાંશ ચિહ્નો એકની નીચે એક આવે તેમ સંખ્યાઓ લખો.</entry>
    <entry><m:math><m:munder accentunder="true"><m:mtable><m:mtr><m:mtd columnalign="left"><m:mspace width="0.7em" /><m:mn>23.5</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mo>+</m:mo><m:mn>41.38</m:mn></m:mtd></m:mtr></m:mtable><m:mtext>______</m:mtext></m:munder></m:math></entry>
  </row>
  <row>
    <entry>23.5માં 5 પછી ખાલી સ્થાન માટે 0 મૂકો.
    <newline />યાદ રાખો, <m:math><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>10</m:mn></m:mrow></m:mfrac><m:mo>=</m:mo><m:mfrac><m:mrow><m:mn>50</m:mn></m:mrow><m:mrow><m:mn>100</m:mn></m:mrow></m:mfrac><m:mspace width="0.5em" /><m:mtext>એટલે</m:mtext><m:mspace width="0.5em" /><m:mn>0.5</m:mn><m:mo>=</m:mo><m:mn>0.50</m:mn></m:math>.</entry>
    <entry><m:math><m:munder accentunder="true"><m:mrow><m:mtable><m:mtr><m:mtd columnalign="left"><m:mspace width="0.7em" /><m:mn>23.50</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mo>+</m:mo><m:mn>41.38</m:mn></m:mtd></m:mtr></m:mtable></m:mrow><m:mtext>______</m:mtext></m:munder></m:math></entry>
  </row>
  <row>
    <entry>સંખ્યાઓને પૂર્ણ સંખ્યા ગણીને સરવાળો કરો.
    <newline />પછી સરવાળામાં દશાંશ ચિહ્ન મૂકો.</entry>
    <entry><m:math><m:mtable><m:mtr><m:mtd columnalign="left"><m:munder accentunder="true"><m:mtable><m:mtr><m:mtd columnalign="left"><m:mspace width="0.7em" /><m:mn>23.50</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mo>+</m:mo><m:mn>41.38</m:mn></m:mtd></m:mtr></m:mtable><m:mtext>______</m:mtext></m:munder></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mspace width="0.7em" /><m:mn>64.88</m:mn></m:mtd></m:mtr></m:mtable></m:math></entry>
  </row>
</tbody>
</tgroup>
</table>
</solution>
</exercise>
</example><note id="fs-id1170655205631" class="try">
<exercise id="fs-id1170655151038">
<problem id="fs-id1170655114138">
<para id="fs-id1170655213420">સરવાળો કરો: <m:math><m:mrow><m:mn>4.8</m:mn><m:mo>+</m:mo><m:mn>11.69</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654919229">
<para id="fs-id1170655167053">16.49</para>
</solution>
</exercise>
</note>
<note id="fs-id1170653235826" class="try">
<exercise id="fs-id1170655081466">
<problem id="fs-id1170655104055">
<para id="fs-id1170655075018">સરવાળો કરો: <m:math><m:mrow><m:mn>5.123</m:mn><m:mo>+</m:mo><m:mn>18.47</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655208527">
<para id="fs-id1170654983099">23.593</para>
</solution>
</exercise>
</note>
<example id="fs-id1170655197222"><exercise id="fs-id1170655127389"><problem id="fs-id1170654921340">
<para id="fs-id1170655162342">બાદબાકી કરો: <m:math><m:mrow><m:mn>20</m:mn><m:mo>−</m:mo><m:mn>14.65</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655067989">
<title>ઉકેલ</title>
<table id="eip-645" summary="પૂર્ણ સંખ્યામાંથી દશાંશ બાદ કરવાની પગલાંવાર રીત, ઉદાહરણ 20 − 14.65.">
<tgroup cols="2"><tbody>
  <row>
  	<entry />
  	<entry><m:math><m:mn>20</m:mn><m:mo>−</m:mo><m:mn>14.65</m:mn></m:math></entry>
  </row>
  <row>
    <entry>દશાંશ ચિહ્નો એકની નીચે એક આવે તેમ સંખ્યાઓ લખો.
    <newline />યાદ રાખો: 20 પૂર્ણ સંખ્યા છે, એટલે 0 પછી દશાંશ ચિહ્ન મૂકો.
	</entry>
    <entry><m:math><m:munder accentunder="true"><m:mtable><m:mtr><m:mtd columnalign="left"><m:mspace width="0.7em" /><m:mn>20.</m:mn></m:mtd></m:mtr><m:mtr><m:mtd><m:mo>−</m:mo><m:mn>14.65</m:mn></m:mtd></m:mtr></m:mtable><m:mtext>______</m:mtext></m:munder></m:math></entry>
  </row>
  <row>
    <entry>જમણી બાજુના ખાલી સ્થાનોમાં શૂન્ય મૂકો.</entry>
    <entry><m:math><m:mtable><m:mtr><m:mtd columnalign="left"><m:mspace width="0.7em" /><m:mn>20.00</m:mn></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:munder accentunder="true"><m:mrow><m:mn>−14.65</m:mn></m:mrow><m:mtext>______</m:mtext></m:munder></m:mtd></m:mtr></m:mtable></m:math></entry>
  </row>
    <row>
    <entry>બાદબાકી કરો અને જવાબમાં દશાંશ ચિહ્ન મૂકો.</entry>
    <entry><m:math><m:mtable><m:mtr><m:mtd columnalign="left"><m:munder accentunder="true"><m:mtable><m:mtr><m:mtd columnalign="left"><m:mspace width="0.8em" /><m:mover><m:mrow><m:menclose notation="updiagonalstrike"><m:mn>2</m:mn></m:menclose></m:mrow><m:mn>1</m:mn></m:mover><m:mover><m:mrow><m:menclose notation="updiagonalstrike"><m:mn>0</m:mn></m:menclose></m:mrow><m:mrow><m:mover><m:mrow><m:menclose notation="updiagonalstrike"><m:mrow><m:mn>10</m:mn></m:mrow></m:menclose></m:mrow><m:mn>9</m:mn></m:mover></m:mrow></m:mover><m:mo>.</m:mo><m:mover><m:mrow><m:menclose notation="updiagonalstrike"><m:mn>0</m:mn></m:menclose></m:mrow><m:mrow><m:mover><m:mrow><m:menclose notation="updiagonalstrike"><m:mrow><m:mn>10</m:mn></m:mrow></m:menclose></m:mrow><m:mn>9</m:mn></m:mover></m:mrow></m:mover><m:mover><m:mrow><m:menclose notation="updiagonalstrike"><m:mn>0</m:mn></m:menclose></m:mrow><m:mrow><m:menclose notation="updiagonalstrike"><m:mrow><m:mn>10</m:mn></m:mrow></m:menclose></m:mrow></m:mover></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mn>1</m:mn><m:mspace width="0.2em" /><m:mn>4</m:mn><m:mspace width="0.4em" /><m:mo>.</m:mo><m:mspace width="0.3em" /><m:mn>6</m:mn><m:mspace width="0.4em" /><m:mn>5</m:mn></m:mtd></m:mtr></m:mtable><m:mtext>__________</m:mtext></m:munder></m:mtd></m:mtr><m:mtr><m:mtd columnalign="left"><m:mspace width="1.8em" /><m:mn>5</m:mn><m:mspace width="0.4em" /><m:mo>.</m:mo><m:mspace width="0.2em" /><m:mn>3</m:mn><m:mspace width="0.4em" /><m:mn>5</m:mn></m:mtd></m:mtr></m:mtable></m:math></entry>
  </row>
</tbody>
</tgroup>
</table>
</solution>
</exercise>
</example><note id="fs-id1170655029303" class="try">
<exercise id="fs-id1170655025457">
<problem id="fs-id1170654965912">
<para id="fs-id1170655215425">બાદબાકી કરો: <m:math><m:mrow><m:mn>10</m:mn><m:mo>−</m:mo><m:mn>9.58</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655098018">
<para id="fs-id1170655226477">0.42</para>
</solution>
</exercise>
</note>
<note id="fs-id1170655155254" class="try">
<exercise id="fs-id1170655065248">
<problem id="fs-id1170654885732">
<para id="fs-id1170655150516">બાદબાકી કરો: <m:math><m:mrow><m:mn>50</m:mn><m:mo>−</m:mo><m:mn>37.42</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655007064">
<para id="fs-id1170654977263">12.58</para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1170654958097"><title>દશાંશનો ગુણાકાર અને ભાગાકાર કરો</title><para id="fs-id1170655129811">દશાંશનો ગુણાકાર પૂર્ણ સંખ્યાના ગુણાકાર જેવો જ છે—ફક્ત દશાંશ ચિહ્ન ક્યાં મૂકવું તે નક્કી કરવું પડે છે. દશાંશને પહેલાં અપૂર્ણાંકમાં ફેરવીને ગુણાકાર કરીએ તો દશાંશના ગુણાકારની રીત સમજાશે.</para>
<para id="fs-id1170655215976">તો દશાંશને પહેલાં અપૂર્ણાંકમાં ફેરવીને જોઈએ કે તેમનું <term class="no-emphasis" id="term-00008">ગુણનફળ</term> શું મળે છે. આપણે બે ઉદાહરણ સાથે જોઈશું. પેટર્ન શોધો!</para>
<table id="eip-id1169754130025" class="unnumbered unstyled" aria-label="0.3, 0.7, 0.2 અને 0.46 આપ્યાં છે; પહેલી ત્રણ પાસે “1 સ્થાન” અને 0.46 પાસે “2 સ્થાન” છે. નીચે “અપૂર્ણાંકમાં ફેરવો” સૂચના છે. 3/10 ગુણ્યા 7/10 અને 2/10 ગુણ્યા 46/100 લખ્યાં છે; આ ઉપરની સંખ્યાઓને અનુરૂપ છે. પછી ગુણાકાર કરતાં 21/100 અને 92/1000 મળે છે. આગળ “દશાંશમાં ફેરવો” સૂચના છે. 0.21 પાસે “2 સ્થાન” અને 0.092 પાસે “3 સ્થાન” છે.">
<label /><tgroup cols="2">
 <tbody>
  <row>
    <entry />
    <entry><media id="eip-id1169754130042" alt="દશાંશ સંખ્યાઓ અને તેમનાં દશાંશ સ્થાનો: (0.3), (0.7) અને (0.2)માં દરેકમાં 1 દશાંશ સ્થાન છે; (0.46)માં 2 દશાંશ સ્થાન છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_009a_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>અપૂર્ણાંકમાં ફેરવો.<m:math><m:mrow><m:mspace width="8em" /></m:mrow></m:math></entry>
    <entry><media id="eip-id1169753944283" alt="અપૂર્ણાંકનો ગુણાકાર દર્શાવતી બે પદાવલી: 3/10 ગુણ્યા 7/10 અને 2/10 ગુણ્યા 46/100."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_009b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry><media id="eip-id1169753944299" alt="સફેદ પૃષ્ઠભૂમિ પર કાળા રંગમાં બે અપૂર્ણાંક બાજુબાજુએ છે: 21/100 અને 92/1000."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_009c_img_new.jpg" /></media></entry>
  </row>
    <row>
    <entry>દશાંશમાં ફેરવો.</entry>
    <entry><media id="eip-id1169753944316" alt="કૌંસ અને લખાણથી દશાંશ સ્થાનોની સંખ્યા બતાવી છે: 0.21માં 2 અને 0.092માં 3 દશાંશ સ્થાન છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_009d_img_new.jpg" /></media></entry>
  </row>
 </tbody>

</tgroup>
</table>
<para id="fs-id1170655162411">ધ્યાન આપો: પહેલા ઉદાહરણમાં બંને સંખ્યામાં દશાંશ ચિહ્ન પછી એક-એક અંક હતો અને ગુણનફળમાં બે દશાંશ સ્થાન મળ્યાં. બીજા ઉદાહરણમાં એક દશાંશ સ્થાનવાળી સંખ્યાને બે દશાંશ સ્થાનવાળી સંખ્યા વડે ગુણી, અને ગુણનફળમાં ત્રણ દશાંશ સ્થાન મળ્યાં.</para>
<para id="fs-id1170655062737">દશાંશ ચિહ્નને થોડા સમય માટે અવગણીને, પૂર્ણ સંખ્યાઓની જેમ ગુણાકાર કરીએ છીએ. પછી અવયવોમાં દશાંશ સ્થાનોની સંખ્યા ગણીએ છીએ; તેનો સરવાળો ગુણનફળમાં દશાંશ સ્થાનોની સંખ્યા જણાવે છે.</para>
<para id="fs-id1170655029564">ધન અને ઋણ સંખ્યાના ગુણાકારના નિયમો દશાંશને પણ લાગુ પડે છે!</para>
<para id="fs-id1170655121723">બે સંખ્યાનો <emphasis effect="italics">ગુણાકાર કરીએ</emphasis> ત્યારે,</para>
<list id="fs-id1170655188642" list-type="bulleted" bullet-style="bullet">
<item>જો તેમનાં ચિહ્નો <emphasis effect="italics">સમાન</emphasis> હોય, તો ગુણનફળ <emphasis effect="italics">ધન</emphasis>.</item>
<item>જો તેમનાં ચિહ્નો <emphasis effect="italics">જુદાં</emphasis> હોય, તો ગુણનફળ <emphasis effect="italics">ઋણ</emphasis>.</item>
</list>
<para id="fs-id1170655028705">ધન કે ઋણ દશાંશનો ગુણાકાર કરતી વખતે પહેલાં ગુણનફળનું ચિહ્ન નક્કી કરીએ, પછી બંને સંખ્યા ધન હોય તેમ ગુણાકાર કરીએ. અંતે યોગ્ય ચિહ્ન સાથે ગુણનફળ લખીએ.</para>
<note id="fs-id1170654988259" class="howto">
<title>દશાંશનો ગુણાકાર કરો.</title>
<list id="fs-id1166424905197" list-type="enumerated" number-style="arabic" class="stepwise">
<item>ગુણનફળનું ચિહ્ન નક્કી કરો.</item>
<item>સંખ્યાઓની જમણી બાજુ સરખી ગોઠવીને એકની નીચે એક લખો. દશાંશ ચિહ્નોને થોડા સમય માટે અવગણીને પૂર્ણ સંખ્યાઓની જેમ ગુણાકાર કરો.</item>
<item>દશાંશ ચિહ્ન મૂકો. ગુણનફળમાં દશાંશ સ્થાનોની સંખ્યા, અવયવોમાં દશાંશ સ્થાનોની સંખ્યાના સરવાળા જેટલી હોય છે.</item>
<item>યોગ્ય ચિહ્ન સાથે ગુણનફળ લખો.</item>
</list>
</note>
<example id="fs-id1170654990020">
<exercise id="fs-id1170655128721"><problem id="fs-id1170655075135">
<para id="fs-id1170655208074">ગુણાકાર કરો: <m:math><m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>−3.9</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>4.075</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655111654">
<title>ઉકેલ</title>
<table id="eip-id1169753348487" class="unnumbered unstyled" aria-label="પદાવલી (−3.9)(4.075) છે. ચિહ્નો જુદાં હોવાથી ગુણનફળ ઋણ છે. પહેલાં નિરપેક્ષ મૂલ્યોને જમણી બાજુ સરખી ગોઠવી ગુણીએ: 4.075ની નીચે ×3.9. દશાંશ ચિહ્ન અવગણતાં આંશિક ગુણનફળ 36675 અને એક સ્થાન ડાબે ખસેડેલું 12225 મળે છે; સરવાળો 158925 છે. અવયવોમાં 1 + 3 = 4 દશાંશ સ્થાન હોવાથી નિરપેક્ષ મૂલ્યોનું ગુણનફળ 15.8925 છે. યોગ્ય ઋણ ચિહ્ન મૂકતાં (−3.9)(4.075) = −15.8925.">
<label /><tgroup cols="2">
 <tbody>
  <row>
    <entry />
    <entry>(−3.9)(4.075)</entry>
  </row>
  <row>
    <entry>ચિહ્નો જુદાં છે. ગુણનફળ ઋણ થશે.</entry>
    <entry />
  </row>
  <row>
    <entry>સંખ્યાઓની જમણી બાજુ સરખી ગોઠવીને એકની નીચે એક લખો.</entry>
    <entry><media id="eip-id1169752872718" alt="ઊભી ગોઠવણીમાં 4.075ને 3.9 વડે ગુણવાનો દાખલો છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_010b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>ગુણાકાર કરો.</entry>
    <entry><media id="eip-id1169750874908" alt="4.075ને 3.9 વડે ગુણવાની ઊભી ગણતરી છે. આંશિક ગુણનફળ 36675 અને એક સ્થાન ડાબે ખસેડેલું 12225 છે; સરવાળો 158925 છે. અંતિમ દશાંશ ચિહ્ન હજી મૂક્યું નથી."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_010c_img_new.jpg" /></media></entry>
  </row>
    <row>
    <entry>અવયવોમાં દશાંશ સ્થાનોની સંખ્યાનો સરવાળો કરો (1 + 3).<newline /><newline /><media id="eip-id1169753269067" alt="બે દશાંશ (−3.9) અને (4.075)માં દશાંશ સ્થાનોની સંખ્યા દર્શાવી છે: (−3.9)માં 1 અને (4.075)માં 3 દશાંશ સ્થાન છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_010a_img_new.jpg" /></media><newline />જમણેથી 4 સ્થાન પછી દશાંશ ચિહ્ન મૂકો.</entry>
    <entry><media id="eip-id1169753284625" alt="4.075ને 3.9 વડે ગુણવાની પગલાંવાર ઊભી ગણતરીમાં 15.8925 મળે છે; 4 દશાંશ સ્થાન ગણવાનું દર્શાવ્યું છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_010d_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>ચિહ્નો જુદાં છે, એટલે ગુણનફળ ઋણ છે.</entry>
    <entry>(−3.9)(4.075) = −15.8925</entry>
  </row>
 </tbody>

</tgroup>
</table>
</solution>
</exercise></example>
<note id="fs-id1170654989132" class="try">
<exercise id="fs-id1170654977683">
<problem id="fs-id1170655057717">
<para id="fs-id1170655083436">ગુણાકાર કરો: <m:math><m:mrow><m:mn>−4.5</m:mn><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>6.107</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655025662">
<para id="fs-id1170655037473"><m:math><m:mrow><m:mn>−27.4815</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170655202782" class="try">
<exercise id="fs-id1170655060570">
<problem id="fs-id1170654936513">
<para id="fs-id1170655162430">ગુણાકાર કરો: <m:math><m:mrow><m:mn>−10.79</m:mn><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>8.12</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655151558">
<para id="fs-id1170655120746"><m:math><m:mrow><m:mn>−87.6148</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<para id="fs-id1170655107014">બીજા ઘણા વિષયોમાં, ખાસ કરીને વિજ્ઞાનમાં, તમે દશાંશને 10ની ઘાત (10, 100, 1000 વગેરે) વડે ગુણશો. કાગળ પર થોડા ગુણાકાર કરતાં તમને એક પેટર્ન દેખાશે: 10ની ઘાતમાં શૂન્યોની સંખ્યા અને ગુણનફળ મેળવવા દશાંશ ચિહ્ન જમણે કેટલાં સ્થાન ખસેડવું તે વચ્ચે સંબંધ છે.</para>
<note id="fs-id1170654972139" class="howto">
<title>દશાંશને દસની ઘાત વડે ગુણો.</title>
<list id="fs-id1166422556911" list-type="enumerated" number-style="arabic" class="stepwise">
<item>10ની ઘાતમાં જેટલાં શૂન્ય હોય તેટલાં સ્થાન દશાંશ ચિહ્ન જમણે ખસેડો.</item>
<item>જરૂર મુજબ સંખ્યાના અંતે શૂન્ય ઉમેરો.</item>
</list>
</note>
<example id="fs-id1170655164348">
<exercise id="fs-id1170655200831">
<problem id="fs-id1170654981723">
<para id="fs-id1170655088072">5.63ને ગુણો <span class="token">ⓐ</span> 10 વડે <span class="token">ⓑ</span> 100 વડે <span class="token">ⓒ</span> 1,000 વડે.</para>
</problem>
<solution id="fs-id1170655174581"><title>ઉકેલ</title>
<para id="fs-id1170654915804">દસની ઘાતમાં શૂન્યોની સંખ્યા પરથી દશાંશ ચિહ્ન જમણે કેટલાં સ્થાન ખસેડવું તે જાણી શકાય છે.</para>
<para id="fs-id1166424779193"><span class="token">ⓐ</span> <newline />
<table id="eip-id1169752865183" class="unnumbered unstyled" aria-label="5.63 ગુણ્યા 10 પદાવલી છે. સૂચના છે: “10માં 1 શૂન્ય છે, એટલે દશાંશ ચિહ્ન 1 સ્થાન જમણે ખસેડો.” 5.63માં તીર દશાંશ ચિહ્નથી શરૂ થઈને 6 અને 3 વચ્ચે જાય છે. પછી 56.3 આપ્યું છે.">
<label /><tgroup cols="2">
 <tbody>
  <row>
    <entry />
    <entry>5.63(10)</entry>
  </row>
  <row>
    <entry>10માં 1 શૂન્ય છે, એટલે દશાંશ ચિહ્ન 1 સ્થાન જમણે ખસેડો.   </entry>
    <entry><media id="eip-id1169753258712" alt="તીર બતાવે છે કે દશાંશ ચિહ્ન એક સ્થાન જમણે ખસેડતાં 5.63માંથી 56.3 મળે છે; તે 10 વડે ગુણાકાર દર્શાવે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_011_img_new.jpg" /></media></entry>
  </row>
 </tbody>

</tgroup>
</table><newline /><newline />
<span class="token">ⓑ</span> <newline />
<table id="eip-id1169752935718" class="unnumbered unstyled can-break" aria-label="5.63 ગુણ્યા 100 પદાવલી છે. સૂચના છે: “100માં 2 શૂન્ય છે, એટલે દશાંશ ચિહ્ન 2 સ્થાન જમણે ખસેડો.” 5.63માં તીર દશાંશ ચિહ્નથી શરૂ થઈને 6 અને 3 વચ્ચે અને પછી 3ની પાછળ જાય છે. પછી 563 આપ્યું છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry>5.63(100)</entry>
  </row>
  <row>
    <entry>100માં 2 શૂન્ય છે, એટલે દશાંશ ચિહ્ન 2 સ્થાન જમણે ખસેડો.   </entry>
    <entry><media id="eip-id1169752908904" alt="100 વડે ગુણવા દશાંશ ચિહ્ન બે સ્થાન જમણે ખસેડવાનું બતાવ્યું છે: 5.63માંથી 563 મળે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_012_img_new.jpg" /></media></entry>
  </row>
 </tbody>


</tgroup>
</table><newline /><newline />
<span class="token">ⓒ</span> <newline />
<table id="eip-id1169751883861" class="unnumbered unstyled can-break" aria-label="5.63 ગુણ્યા 1,000 પદાવલી છે. સૂચના છે: “1,000માં 3 શૂન્ય છે, એટલે દશાંશ ચિહ્ન 3 સ્થાન જમણે ખસેડો.” 5.63માં તીર દશાંશ ચિહ્નથી શરૂ થઈને 6 અને 3 વચ્ચે, પછી 3ની પાછળ અને પછી વધુ એક સ્થાન જાય છે. સૂચના છે: “અંતે એક શૂન્ય ઉમેરવું પડે છે.” પછી 5,630 આપ્યું છે.">
<label /><tgroup cols="2">
 <tbody>
  <row>
    <entry />
    <entry>5.63(1,000)</entry>
  </row>
  <row>
    <entry>1,000માં 3 શૂન્ય છે, એટલે દશાંશ ચિહ્ન 3 સ્થાન જમણે ખસેડો.</entry>
    <entry><media id="eip-id1169749465627" alt="5.63માં દશાંશ ચિહ્નથી વાદળી તીર ત્રણ સ્થાન જમણે જાય છે; તે 1,000 વડે ગુણવા માટેનું દશાંશ સ્થાનાંતરણ છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_013a_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>અંતે એક શૂન્ય ઉમેરવું પડે છે.</entry>
    <entry><media id="eip-id1169754029608" alt="સંખ્યા 5,630 દર્શાવી છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_013b_img_new.jpg" /></media></entry>
  </row>
 </tbody>

</tgroup>
</table></para></solution>
</exercise>
</example>
<note id="fs-id1170655178326" class="try">
<exercise id="fs-id1170655126782">
<problem id="fs-id1170655150426">
<para id="fs-id1170655089696">2.58ને ગુણો <span class="token">ⓐ</span> 10 વડે <span class="token">ⓑ</span> 100 વડે <span class="token">ⓒ</span> 1,000 વડે.</para>
</problem>
<solution id="fs-id1170654981785">
<para id="fs-id1170655196937"><span class="token">ⓐ</span> 25.8 <span class="token">ⓑ</span> 258 <span class="token">ⓒ</span> 2,580</para>
</solution>
</exercise>
</note>
<note id="fs-id1170654962992" class="try">
<exercise id="fs-id1170655228959">
<problem id="fs-id1170655224503">
<para id="fs-id1170655162315">14.2ને ગુણો <span class="token">ⓐ</span> 10 વડે <span class="token">ⓑ</span> 100 વડે <span class="token">ⓒ</span> 1,000 વડે.</para>
</problem>
<solution id="fs-id1170655157929">
<para id="fs-id1170655069369"><span class="token">ⓐ</span> 142 <span class="token">ⓑ</span> 1,420 <span class="token">ⓒ</span> 14,200</para>
</solution>
</exercise>
</note>
<para id="fs-id1170654983167">ગુણાકારની જેમ, <term class="no-emphasis" id="term-00009">ભાગાકાર</term> પણ દશાંશ માટે પૂર્ણ સંખ્યાના ભાગાકાર જેવો જ છે. ફક્ત દશાંશ ચિહ્ન ક્યાં મૂકવું તે નક્કી કરવું પડે છે.</para>
<para id="fs-id1170654953534">દશાંશનો ભાગાકાર કરવા, છેદને પૂર્ણ સંખ્યા બનાવવા તેને 10ની કઈ ઘાત વડે ગુણવો તે નક્કી કરો. પછી અંશને પણ તે જ ઘાત વડે ગુણો, જેનો આધાર છે <m:math><m:mrow><m:mn>10</m:mn><m:mo>.</m:mo></m:mrow></m:math> સમ અપૂર્ણાંકના ગુણધર્મને લીધે અપૂર્ણાંકની કિંમત બદલાતી નથી! પરિણામે અંશ અને છેદમાં દશાંશ ચિહ્નો સરખાં સ્થાન જમણે ખસે છે. ઉદાહરણ તરીકે:</para>
<equation id="fs-id1170654924906" class="unnumbered"><label /><m:math><m:mtable><m:mtr><m:mtd columnalign="center"><m:mfrac><m:mrow><m:mn>0.8</m:mn></m:mrow><m:mrow><m:mn>0.4</m:mn></m:mrow></m:mfrac></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mfrac><m:mrow><m:mn>0.8</m:mn><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>10</m:mn></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow><m:mrow><m:mn>0.4</m:mn><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>10</m:mn></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:mfrac></m:mtd></m:mtr><m:mtr><m:mtd columnalign="center"><m:mfrac><m:mn>8</m:mn><m:mn>4</m:mn></m:mfrac></m:mtd></m:mtr></m:mtable></m:math></equation>
<para id="fs-id1170654941815">દશાંશ માટે પણ ધન અને ઋણ સંખ્યાના ભાગાકારના નિયમો વાપરીએ છીએ. પહેલાં ભાગફળનું ચિહ્ન નક્કી કરો, પછી બંને સંખ્યા ધન હોય તેમ ભાગાકાર કરો. અંતે યોગ્ય ચિહ્ન સાથે ભાગફળ લખો.</para>
<para id="fs-id1170655133056">ભાગાકારનાં ચિહ્નો અને શબ્દો ફરી જોઈએ:</para>
<equation id="fs-id1170655007198" class="unnumbered"><label /><m:math><m:mrow><m:munder><m:mi>a</m:mi><m:mrow><m:mtext>ભાજ્ય</m:mtext></m:mrow></m:munder><m:mo>÷</m:mo><m:munder><m:mi>b</m:mi><m:mrow><m:mtext>ભાજક</m:mtext></m:mrow></m:munder><m:mo>=</m:mo><m:munder><m:mtext>c</m:mtext><m:mrow><m:mtext>ભાગફળ</m:mtext></m:mrow></m:munder><m:mspace width="5em" /><m:munder><m:mi>b</m:mi><m:mrow><m:mtext>ભાજક</m:mtext></m:mrow></m:munder><m:mtable><m:mtr><m:mtd columnalign="right"><m:mrow><m:munder><m:mtext>c</m:mtext><m:mrow><m:mtext>ભાગફળ</m:mtext></m:mrow></m:munder></m:mrow></m:mtd></m:mtr><m:mtr><m:mtd columnalign="right"><m:menclose notation="longdiv"><m:mrow><m:munder><m:mi>a</m:mi><m:mrow><m:mtext>ભાજ્ય</m:mtext></m:mrow></m:munder></m:mrow></m:menclose></m:mtd></m:mtr></m:mtable></m:mrow></m:math></equation>
<para id="fs-id1170654928702">સરળતાથી જોઈ શકાય તે માટે દશાંશના ભાગાકારનાં પગલાં લખીએ.</para>
<note id="fs-id1170655089296" class="howto">
<title>દશાંશનો ભાગાકાર કરો.</title>
<list id="fs-id1166422823773" list-type="enumerated" number-style="arabic" class="stepwise">
<item>ભાગફળનું ચિહ્ન નક્કી કરો.</item>
<item>દશાંશ ચિહ્નને જમણી બાજુના છેલ્લા અંકની પાછળ “ખસેડીને” ભાજકને પૂર્ણ સંખ્યા બનાવો. ભાજ્યમાં પણ દશાંશ ચિહ્ન એટલાં જ સ્થાન “ખસેડો”—જરૂર મુજબ શૂન્ય ઉમેરો.</item>
<item>ભાગાકાર કરો. ભાગફળમાં દશાંશ ચિહ્ન, ભાજ્યના દશાંશ ચિહ્નની ઉપર મૂકો.</item>
<item>યોગ્ય ચિહ્ન સાથે ભાગફળ લખો.</item>
</list>
</note>
<example id="fs-id1170655120809">
<exercise id="fs-id1170654915607"><problem id="fs-id1170654962371">
<para id="fs-id1170654935439">ભાગાકાર કરો: <m:math><m:mrow><m:mn>−25.65</m:mn><m:mo>÷</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>−0.06</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654969632">
<title>ઉકેલ</title>
<para id="fs-id1170655041701">યાદ રાખો: સમ અપૂર્ણાંકના ગુણધર્મને કારણે ભાજક અને ભાજ્યમાં દશાંશ ચિહ્નો “ખસેડી” શકાય છે.</para>
<table id="eip-id1169754369321" class="unnumbered unstyled" aria-label="ઋણ 25.65 ભાગ્યા ઋણ 0.06 આપ્યું છે. કોષ્ટકમાં ડાબે સૂચના અને જમણે ગણતરી છે. પહેલા પગલામાં “ચિહ્નો સમાન છે” અને જમણે “ભાગફળ ધન છે” છે. પછી ભાજકમાં દશાંશ ચિહ્ન છેલ્લા અંકની પાછળ ખસેડીને તેને પૂર્ણ સંખ્યા બનાવવાનું અને ભાજ્યમાં પણ એટલાં જ સ્થાન ખસેડવાનું કહ્યું છે. 25.65ને 0.06 વડે ભાગવાની ગોઠવણીમાં બંને દશાંશ ચિહ્નો પરથી તીર છેલ્લા અંકની પાછળ જાય છે. ચોથા પગલામાં ભાગાકાર કરીને ભાગફળમાં દશાંશ ચિહ્ન ભાજ્યના દશાંશ ચિહ્નની ઉપર મૂકવાનું કહ્યું છે. 2565.0ને 006. વડે ભાગતાં ભાગફળ 427.5 છે. નીચે ક્રમે −24, આડી રેખા, 16, −12, આડી રેખા, 45, −42, આડી રેખા, 30, 30 અને અંતિમ આડી રેખા છે. પાંચમું પગલું યોગ્ય ચિહ્ન સાથે જવાબ લખવાનું છે: −25.65 ÷ (−0.06) = 427.5."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry><m:math><m:mn>−25.65</m:mn><m:mo>÷</m:mo><m:mo>(</m:mo><m:mn>−0.06</m:mn><m:mo>)</m:mo></m:math></entry>
  </row>
  <row>
    <entry>ચિહ્નો સમાન છે.</entry>
    <entry>ભાગફળ ધન છે.</entry>
  </row>
  <row>
    <entry>દશાંશ ચિહ્નને જમણી બાજુના છેલ્લા અંકની પાછળ “ખસેડીને” ભાજકને પૂર્ણ સંખ્યા બનાવો.</entry>
    <entry />
  </row>
  <row>
    <entry>ભાજ્યમાં દશાંશ ચિહ્ન એટલાં જ સ્થાન “ખસેડો”.</entry>
    <entry><media id="eip-id1169751952546" alt="25.65ને 0.06 વડે ભાગવાની ગોઠવણી છે. વાદળી તીર ભાગાકાર પહેલાં ભાજક અને ભાજ્ય બંનેમાં દશાંશ ચિહ્ન બે સ્થાન જમણે ખસેડવાનું બતાવે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_014a_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>ભાગાકાર કરો.<newline />ભાગફળમાં દશાંશ ચિહ્ન, ભાજ્યના દશાંશ ચિહ્નની ઉપર મૂકો.</entry>
    <entry><media id="eip-id1169751952565" alt="2565.0ને 6 વડે ભાગતાં ભાગફળ 427.5 મળે છે. બાદબાકી સહિતની આખી પગલાંવાર ગણતરી દર્શાવી છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_014b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>યોગ્ય ચિહ્ન સાથે ભાગફળ લખો.</entry>
    <entry><m:math><m:mn>−25.65</m:mn><m:mo>÷</m:mo><m:mo>(</m:mo><m:mn>−0.06</m:mn><m:mo>)</m:mo><m:mo>=</m:mo><m:mn>427.5</m:mn></m:math></entry>
  </row>
 </tbody>


</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id1170655027224" class="try">
<exercise id="fs-id1170654951698">
<problem id="fs-id1170655353521">
<para id="fs-id1170655230047">ભાગાકાર કરો: <m:math><m:mrow><m:mn>−23.492</m:mn><m:mo>÷</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>−0.04</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654931861">
<para id="fs-id1170655351826">587.3</para>
</solution>
</exercise>
</note>
<note id="fs-id1170655059477" class="try">
<exercise id="fs-id1170655162174">
<problem id="fs-id1170654965547">
<para id="fs-id1170655029208">ભાગાકાર કરો: <m:math><m:mrow><m:mn>−4.11</m:mn><m:mo>÷</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>−0.12</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654958121">
<para id="fs-id1170655154073">34.25</para>
</solution>
</exercise>
</note>
<para id="fs-id1170655124340">દશાંશને પૂર્ણ સંખ્યા વડે ભાગવાનો એક સામાન્ય ઉપયોગ છે: અનેક વસ્તુના પૅકમાંથી એક વસ્તુની કિંમત શોધવી. માનો કે પાણીની 24 બોટલના ખોખાની કિંમત $3.99 છે. એક બોટલની કિંમત શોધવા $3.99ને 24 વડે ભાગીએ. આ ભાગાકાર આમાં દર્શાવ્યો છે: <link target-id="fs-id1170655126266" />. નાણાંની ગણતરીમાં જવાબને નજીકના સેન્ટ (શતાંશ)માં ફેરવીશું.</para>
<example id="fs-id1170655126266">
<exercise id="fs-id1170654957141"><problem id="fs-id1170654938076">
<para id="fs-id1170654981962">ભાગાકાર કરો: <m:math><m:mrow><m:mn>$3.99</m:mn><m:mo>÷</m:mo><m:mn>24</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170655133913">
<title>ઉકેલ</title>
<table id="eip-id1169754137615" class="unnumbered unstyled can-break" aria-label="$3.99ને 24 વડે ભાગવાનો દાખલો છે. દશાંશ ચિહ્નો ગોઠવી 3.990 ÷ 24ની ગણતરી સહસ્રાંશ સુધી કરતાં ભાગફળના અંકો 0.166 મળે છે; આ હજી ચોક્કસ અંતિમ ભાગફળ નથી. નીચે ક્રમે 24,159,144,150,144 અને શેષના સ્થાને 6 છે. નજીકના સેન્ટમાં ફેરવતાં $3.99 ÷ 24 ≈ $0.17."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry><m:math><m:mn>$3.99</m:mn><m:mo>÷</m:mo><m:mn>24</m:mn></m:math></entry>
  </row>
  <row>
    <entry>ભાગફળમાં દશાંશ ચિહ્ન, ભાજ્યના દશાંશ ચિહ્નની ઉપર મૂકો.</entry>
    <entry />
  </row>
  <row>
    <entry>સામાન્ય રીતે ભાગાકાર કરો.<newline />ક્યારે અટકવું? નાણાંની ગણતરી હોવાથી નજીકના સેન્ટ (શતાંશ)માં ફેરવીએ છીએ. તે માટે સહસ્રાંશના સ્થાન સુધી ભાગાકાર કરવો પડે છે.</entry>
    <entry><media id="eip-id1169754122161" alt="3.990ને 24 વડે ભાગવાની પગલાંવાર ગણતરીમાં 0.166 અને નીચે 6 શેષ દર્શાવ્યા છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_015_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>નજીકના સેન્ટમાં ફેરવો.</entry>
    <entry><m:math><m:mn>$0.166</m:mn><m:mo>≈</m:mo><m:mn>$0.17</m:mn></m:math><newline /><m:math><m:mn>$3.99</m:mn><m:mo>÷</m:mo><m:mn>24</m:mn><m:mo>≈</m:mo><m:mn>$0.17</m:mn></m:math></entry>
  </row>
 </tbody>


</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id1170655221334" class="try">
<exercise id="fs-id1170654939316">
<problem id="fs-id1170655104719">
<para id="fs-id1170654943489">ભાગાકાર કરો: <m:math><m:mrow><m:mn>$6.99</m:mn><m:mo>÷</m:mo><m:mn>36</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654983050">
<para id="fs-id1170655354181">$0.19</para>
</solution>
</exercise>
</note>
<note id="fs-id1170655158044" class="try">
<exercise id="fs-id1170655026005">
<problem id="fs-id1170655106548">
<para id="fs-id1170655104233">ભાગાકાર કરો: <m:math><m:mrow><m:mn>$4.99</m:mn><m:mo>÷</m:mo><m:mn>12</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654908608">
<para id="fs-id1170655134764">$0.42</para>
</solution>
</exercise>
</note>
</section><section id="fs-id1170655102379">
<title>દશાંશ, અપૂર્ણાંક અને ટકાને એકબીજાના સ્વરૂપમાં ફેરવો</title>
<para id="fs-id1170654915544">છેલ્લા (સૌથી જમણી બાજુના) અંકની સ્થાનકિંમત ઓળખીને દશાંશને અપૂર્ણાંકમાં ફેરવીએ છીએ. 0.03માં 3 શતાંશના સ્થાને છે, એટલે 0.03ના સમ અપૂર્ણાંકનો છેદ 100 છે.</para>
<equation id="fs-id1170655111307" class="unnumbered"><label /><m:math><m:mrow><m:mn>0</m:mn><m:mspace width="0.2em" /><m:mn>0.03</m:mn><m:mo>=</m:mo><m:mfrac><m:mn>3</m:mn><m:mrow><m:mn>100</m:mn></m:mrow></m:mfrac></m:mrow></m:math></equation>
<para id="fs-id1170655205009">ધ્યાન આપો: દશાંશ ચિહ્નની ડાબી બાજુની સંખ્યા શૂન્ય હોય ત્યારે મળતા અપૂર્ણાંકનો અંશ તેના છેદ કરતાં નાનો હોય છે. આવા અપૂર્ણાંકને કહે છે <term class="no-emphasis" id="term-00010">શુદ્ધ અપૂર્ણાંક</term>.</para>
<para id="fs-id1170655197111">દશાંશને અપૂર્ણાંકમાં ફેરવવાનાં પગલાંનો સારાંશ રીતની પેટીમાં આપ્યો છે.</para>
<note id="fs-id1170655206712" class="howto">
<title>દશાંશને શુદ્ધ અપૂર્ણાંકમાં ફેરવો.</title>
<list id="fs-id1166422823849" list-type="enumerated" number-style="arabic" class="stepwise">
<item>છેલ્લા અંકની સ્થાનકિંમત નક્કી કરો.</item>
<item>અપૂર્ણાંક લખો.
<list id="fs-id1170655121293" list-type="bulleted" bullet-style="bullet">
<item>અંશ—દશાંશ ચિહ્નની જમણી બાજુના અંકો વડે બનતી પૂર્ણ સંખ્યા</item>
<item>છેદ—છેલ્લા અંકના સ્થાનને અનુરૂપ અપૂર્ણાંકના છેદમાં આવતી દસની ઘાત</item>
</list></item>
</list>
</note>
<example id="fs-id1170654989764">
<exercise id="fs-id1170655221889">
<problem id="fs-id1170655150644">
<para id="fs-id1170654986180">0.374ને અપૂર્ણાંક તરીકે લખો.</para>
</problem>
<solution id="fs-id1170655205678">
<title>ઉકેલ</title>
<para id="fs-id1170655037749"><table id="eip-id1169752838117" class="unnumbered unstyled can-break" aria-label="0.374 આપ્યું છે. કોષ્ટકમાં ડાબે સૂચના અને જમણે ગણતરી છે. પહેલા પગલામાં છેલ્લા અંકની સ્થાનકિંમત નક્કી કરવાનું કહ્યું છે: 0.3 પાસે દશાંશ, 7 પાસે શતાંશ અને 4 પાસે સહસ્રાંશ છે. બીજામાં “અપૂર્ણાંક લખો: અંશ 374 છે” અને જમણે 374/1,000 છે. ત્રીજામાં “અપૂર્ણાંક સાદો કરો” અને જમણે (2 ગુણ્યા 187)/(2 ગુણ્યા 500) છે. ચોથામાં “સામાન્ય અવયવો વડે ભાગો” અને જમણે 187/500 છે. એટલે 0.374 = 187/500."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry />
    <entry align="center"><m:math><m:mn>0.374</m:mn></m:math></entry>
  </row>
  <row>
    <entry>છેલ્લા અંકની સ્થાનકિંમત નક્કી કરો.</entry>
    <entry align="center"><media id="eip-id1169752926445" alt="દશાંશ સ્થાનકિંમતો દર્શાવી છે: 0.3 પાસે દશાંશ, 7 પાસે શતાંશ અને 4 પાસે સહસ્રાંશ."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_016_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>0.374 માટે અપૂર્ણાંક લખો:<newline /><list id="eip-id1169752926531" list-type="bulleted" bullet-style=""><item>અંશ 374 છે.</item><item>છેદ 1,000 છે.</item></list></entry>
    <entry align="center"><m:math><m:mfrac><m:mn>374</m:mn><m:mn>1000</m:mn></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>અપૂર્ણાંક સાદો કરો.</entry>
    <entry align="center"><m:math><m:mfrac><m:mrow><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>187</m:mn></m:mrow><m:mrow><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>500</m:mn></m:mrow></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>સામાન્ય અવયવો વડે ભાગો.</entry>
    <entry align="center"><m:math><m:mfrac><m:mn>187</m:mn><m:mn>500</m:mn></m:mfrac></m:math><newline />એટલે, <m:math><m:mn>0.374</m:mn><m:mo>=</m:mo><m:mfrac><m:mn>187</m:mn><m:mn>500</m:mn></m:mfrac></m:math></entry>
  </row>
 </tbody>



</tgroup>
</table></para><para id="fs-id1170654965315">શું તમે જોયું કે આ અપૂર્ણાંકના છેદમાં શૂન્યોની સંખ્યા: <m:math><m:mrow><m:mfrac><m:mrow><m:mn>374</m:mn></m:mrow><m:mrow><m:mn>1,000</m:mn></m:mrow></m:mfrac></m:mrow></m:math> એ 0.374માં દશાંશ સ્થાનોની સંખ્યા જેટલી છે?</para>
</solution>
</exercise>
</example>
<note id="fs-id1170655073444" class="try">
<exercise id="fs-id1170655003556">
<problem id="fs-id1170655351640">
<para id="fs-id1170655215496">0.234ને અપૂર્ણાંક તરીકે લખો.</para>
</problem>
<solution id="fs-id1170655158112">
<para id="fs-id1170655125808"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>117</m:mn></m:mrow><m:mrow><m:mn>500</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170655353631" class="try">
<exercise id="fs-id1170655124404">
<problem id="fs-id1170654969676">
<para id="fs-id1170655175103">0.024ને અપૂર્ણાંક તરીકે લખો.</para>
</problem>
<solution id="fs-id1170655216143">
<para id="fs-id1170654985458"><m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mrow><m:mn>125</m:mn></m:mrow></m:mfrac></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<para id="fs-id1170654931916">આપણે દશાંશને અપૂર્ણાંકમાં ફેરવતાં શીખ્યા. હવે ઊલટું કરીશું—અપૂર્ણાંકને દશાંશમાં ફેરવીશું. યાદ રાખો: અપૂર્ણાંક રેખા ભાગાકાર સૂચવે છે. એટલે <m:math><m:mrow><m:mfrac><m:mn>4</m:mn><m:mn>5</m:mn></m:mfrac></m:mrow></m:math> ને લખી શકાય છે <m:math><m:mrow><m:mn>4</m:mn><m:mo>÷</m:mo><m:mn>5</m:mn></m:mrow></m:math> અથવા <m:math><m:mrow><m:mn>5</m:mn><m:menclose notation="longdiv"><m:mn>4</m:mn></m:menclose><m:mo>.</m:mo></m:mrow></m:math> આ પરથી અપૂર્ણાંકને દશાંશમાં ફેરવવાની નીચેની રીત મળે છે.</para>
<note id="fs-id1170655222662" class="howto">
<title>અપૂર્ણાંકને દશાંશમાં ફેરવો.</title>
<para id="fs-id1167835330636">અપૂર્ણાંકને દશાંશમાં ફેરવવા તેના અંશને તેના છેદ વડે ભાગો.</para>
</note>
<example id="fs-id1170655007191">
<exercise id="fs-id1170654983810">
<problem id="fs-id1170655150719">
<para id="fs-id1170655105604"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math>ને દશાંશ તરીકે લખો.</para>
</problem>
<solution id="fs-id1170655124919">
<title>ઉકેલ</title>
<para id="fs-id1170655124777">અપૂર્ણાંક રેખા ભાગાકાર સૂચવે છે. પહેલાં નિરપેક્ષ મૂલ્ય માટે આ અપૂર્ણાંકને લખીએ: <m:math><m:mrow><m:mfrac><m:mn>5</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math> આ રીતે: <m:math><m:mrow><m:mn>8</m:mn><m:menclose notation="longdiv"><m:mn>5</m:mn></m:menclose><m:mo>.</m:mo></m:mrow></m:math> હવે ભાગાકાર કરો અને અંતે મૂળ ઋણ ચિહ્ન મૂકો.</para>
<media id="fs-id1170654966693" alt="5.000ને 8 વડે ભાગતાં નિરપેક્ષ મૂલ્યનું ભાગફળ 0.625 છે. નીચે 48, આડી રેખા, 20, 16, આડી રેખા, 40, 40 અને અંતિમ આડી રેખા છે. આકૃતિની અંતિમ પંક્તિમાં ઋણ ચિહ્ન સાથે −5/8 = −0.625 લખ્યું છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_07_017_img_new.jpg" />
</media>
</solution>
</exercise>
</example>
<note id="fs-id1170655113776" class="try">
<exercise id="fs-id1170655004386">
<problem id="fs-id1170655024912">
<para id="fs-id1170655229974"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math>ને દશાંશ તરીકે લખો.</para>
</problem>
<solution id="fs-id1170655154221">
<para id="fs-id1170655129731"><m:math><m:mrow><m:mn>−0.875</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170655061405" class="try">
<exercise id="fs-id1170655134437">
<problem id="fs-id1170654969471">
<para id="fs-id1170654953686"><m:math><m:mrow><m:mo>−</m:mo><m:mspace width="0.2em" /><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac></m:mrow></m:math>ને દશાંશ તરીકે લખો.</para>
</problem>
<solution id="fs-id1170655164036">
<para id="fs-id1170655193638"><m:math><m:mrow><m:mn>−0.375</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<para id="fs-id1170655000282">ભાગાકાર કરતાં હંમેશાં શેષ શૂન્ય મળતો નથી. ક્યારેક ભાગફળમાં દશાંશના અંકો ફરીફરી આવે છે. એક <term id="term-00011">આવર્ત દશાંશ</term> એવો દશાંશ છે, જેમાં છેલ્લો અંક અથવા અંકોનો સમૂહ અનંત વખત ફરીફરી આવે છે. આવર્તિત અંકોના સમૂહ ઉપર રેખા મૂકીને આવર્તન દર્શાવાય છે.</para>
<note id="fs-id1170655219747">
<title>આવર્ત દશાંશ</title>
<para id="fs-id1170655126226">એક <emphasis effect="bold">આવર્ત દશાંશ</emphasis> એવો દશાંશ છે, જેમાં છેલ્લો અંક અથવા અંકોનો સમૂહ અનંત વખત ફરીફરી આવે છે.</para>
</note>
<para id="fs-id1170655000245">આવર્તિત અંકોના સમૂહ ઉપર રેખા મૂકીને આવર્તન દર્શાવાય છે.</para>
<example id="fs-id1170654988304">
<exercise id="fs-id1170655200688">
<problem id="fs-id1170654919361">
<para id="fs-id1170654924199"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>43</m:mn></m:mrow><m:mrow><m:mn>22</m:mn></m:mrow></m:mfrac></m:mrow></m:math>ને દશાંશ તરીકે લખો.</para>
</problem>
<solution id="fs-id1170655025946">
<title>ઉકેલ</title>
<para id="fs-id1170654977418"><media id="fs-id1170654982890" alt="43/22 આપ્યું છે. સૂચના છે: “43ને 22 વડે ભાગો.” 43.00000ને 22 વડે ભાગવાની ગોઠવણીમાં ભાગફળ 1.95454 છે. નીચે 22, આડી રેખા, 210, 198, આડી રેખા, 120, 110, આડી રેખા, 100, 88, આડી રેખા, 120, 110, આડી રેખા, 100, 88, આડી રેખા અને પછી ત્રણ ટપકાં છે. 120 અને 100 ફરીફરી આવે છે તે દર્શાવ્યું છે. “પેટર્ન ફરી આવે છે, એટલે ભાગફળના અંકો પણ ફરી આવશે” લખ્યું છે. અંતે 43/22 = 1.954માં 54ની ઉપર નાની આડી રેખા છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_07_018_img_new.jpg" />
</media></para>
</solution>
</exercise>
</example>
<note id="fs-id1170655000638" class="try">
<exercise id="fs-id1170655207846">
<problem id="fs-id1170655154772">
<para id="fs-id1170655125921"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>27</m:mn></m:mrow><m:mrow><m:mn>11</m:mn></m:mrow></m:mfrac></m:mrow></m:math>ને દશાંશ તરીકે લખો.</para>
</problem>
<solution id="fs-id1170655163739">
<para id="fs-id1170655166549"><m:math><m:mrow><m:mn>2.</m:mn><m:mover accent="true"><m:mrow><m:mn>45</m:mn></m:mrow><m:mtext>—</m:mtext></m:mover></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<note id="fs-id1170654940618" class="try">
<exercise id="fs-id1170655155181">
<problem id="fs-id1170655207224">
<para id="fs-id1170655161369"><m:math><m:mrow><m:mfrac><m:mrow><m:mn>51</m:mn></m:mrow><m:mrow><m:mn>22</m:mn></m:mrow></m:mfrac></m:mrow></m:math>ને દશાંશ તરીકે લખો.</para>
</problem>
<solution id="fs-id1170655069781">
<para id="fs-id1170654905621"><m:math><m:mrow><m:mn>2.3</m:mn><m:mover accent="true"><m:mrow><m:mn>18</m:mn></m:mrow><m:mtext>—</m:mtext></m:mover></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<para id="fs-id1170654958830">ક્યારેક અપૂર્ણાંક અને દશાંશ બંને ધરાવતી પદાવલીને સાદું રૂપ આપવું પડે છે.</para>
<example id="fs-id1170655133018">
<exercise id="fs-id1170654940778">
<problem id="fs-id1170655154796">
<para id="fs-id1170655089358">સાદું રૂપ આપો: <m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>6.4</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654929183">
<title>ઉકેલ</title>
<para id="fs-id1170655026448">પહેલાં એક સંખ્યાનું સ્વરૂપ બદલવું પડે, જેથી બંને સંખ્યા એકસરખા સ્વરૂપમાં હોય. અપૂર્ણાંકને દશાંશમાં અથવા દશાંશને અપૂર્ણાંકમાં ફેરવી શકીએ. સામાન્ય રીતે અપૂર્ણાંકને દશાંશમાં ફેરવવું સરળ પડે છે.<newline />
<table id="eip-id1169754088588" class="unnumbered unstyled can-break" aria-label="7/8 + 6.4 પદાવલી છે. સૂચના છે: “7/8ને દશાંશમાં ફેરવો.” જમણે 7.000ને 8 વડે ભાગતાં ભાગફળ 0.875 છે. નીચે 64, આડી રેખા, 60, 56, આડી રેખા, 40, 40, અંતિમ આડી રેખા અને 0 છે. આગળ “સરવાળો કરો” સૂચના છે. જમણે 0.875 + 6.4 છે, એટલે 7/8 + 6.4 = 7.275.">
<label /><tgroup cols="3">
 <tbody>
  <row>
    <entry />
    <entry />
    <entry><m:math><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>6.4</m:mn></m:math></entry>
  </row>
  <row>
    <entry><m:math><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac></m:math>ને દશાંશમાં ફેરવો.</entry>
    <entry><media id="eip-id1169749852706" alt="7ને 8 વડે ભાગવાની પગલાંવાર ગણતરીમાં દશાંશ ભાગફળ 0.875 અને શેષ શૂન્ય મળે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_019_img_new.jpg" /></media></entry>
    <entry />
  </row>
  <row>
    <entry>સરવાળો કરો.</entry>
<entry />
    <entry><m:math><m:mn>0.875</m:mn><m:mo>+</m:mo><m:mn>6.4</m:mn></m:math></entry>
</row>
  <row>
    <entry />
    <entry />
    <entry><m:math><m:mn>7.275</m:mn></m:math></entry>
    </row>
<row>
    <entry />
    <entry />
    <entry>એટલે, <m:math><m:mrow><m:mfrac><m:mn>7</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>6.4</m:mn><m:mo>=</m:mo><m:mn>7.275</m:mn></m:mrow></m:math></entry>
  </row>
 </tbody>

</tgroup>
</table></para></solution>
</exercise>
</example>
<note id="fs-id1170655218794" class="try">
<exercise id="fs-id1170654943887">
<problem id="fs-id1170655229698">
<para id="fs-id1170654953761">સાદું રૂપ આપો: <m:math><m:mrow><m:mfrac><m:mn>3</m:mn><m:mn>8</m:mn></m:mfrac><m:mo>+</m:mo><m:mn>4.9</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654984861">
<para id="fs-id1170654928209">5.275</para>
</solution>
</exercise>
</note>
<note id="fs-id1170655060169" class="try">
<exercise id="fs-id1170655126485">
<problem id="fs-id1170654939321">
<para id="fs-id1170654953737">સાદું રૂપ આપો: <m:math><m:mrow><m:mn>5.7</m:mn><m:mo>+</m:mo><m:mfrac><m:mrow><m:mn>13</m:mn></m:mrow><m:mrow><m:mn>20</m:mn></m:mrow></m:mfrac><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1170654969523">
<para id="fs-id1170654886938">6.35</para>
</solution>
</exercise>
</note>
<para id="fs-id1170654932294"><emphasis effect="bold">ટકા</emphasis> એ 100 છેદવાળો ગુણોત્તર છે. ટકાનો અર્થ છે પ્રતિ સો. ટકા દર્શાવવા % ચિહ્ન વાપરીએ છીએ.</para>
<note id="fs-id1170655106959">
<title>ટકા</title>
<para id="fs-id1170655090844"><term id="term-00012">ટકા</term> એ 100 છેદવાળો ગુણોત્તર છે.</para>
</note>
<para id="fs-id1170655133249">ટકા એક ગુણોત્તર હોવાથી તેને સરળતાથી અપૂર્ણાંક તરીકે લખી શકાય છે. ટકા એટલે પ્રતિ 100, એટલે અપૂર્ણાંકનો છેદ 100 છે. પછી અંશને છેદ વડે ભાગીને અપૂર્ણાંકને દશાંશમાં ફેરવીએ છીએ.</para>
<table id="eip-613" summary="6%, 78% અને 135%ને 100 છેદવાળા અપૂર્ણાંકમાં અને પછી દશાંશમાં ફેરવવાનું દર્શાવે છે.">
<tgroup cols="4"><tbody>
  <row>
    <entry />
    <entry><m:math><m:mn>6%</m:mn></m:math></entry>
    <entry><m:math><m:mn>78%</m:mn></m:math></entry>
    <entry><m:math><m:mn>135%</m:mn></m:math></entry>
  </row>
  <row>
    <entry>100 છેદવાળા ગુણોત્તર તરીકે લખો.</entry>
    <entry><m:math><m:mfrac><m:mn>6</m:mn><m:mrow><m:mn>100</m:mn></m:mrow></m:mfrac></m:math></entry>
    <entry><m:math><m:mfrac><m:mn>78</m:mn><m:mrow><m:mn>100</m:mn></m:mrow></m:mfrac></m:math></entry>
    <entry><m:math><m:mfrac><m:mn>135</m:mn><m:mrow><m:mn>100</m:mn></m:mrow></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>અંશને છેદ વડે ભાગીને અપૂર્ણાંકને દશાંશમાં ફેરવો.</entry>
    <entry><m:math><m:mn>0.06</m:mn></m:math></entry>
    <entry><m:math><m:mn>0.78</m:mn></m:math></entry>
    <entry><m:math><m:mn>1.35</m:mn></m:math></entry>
  </row>
</tbody>

</tgroup>
</table><para id="fs-id1170655066390">શું તમને પેટર્ન દેખાય છે? <emphasis effect="italics">ટકામાં આપેલી સંખ્યાને દશાંશમાં ફેરવવા દશાંશ ચિહ્ન બે સ્થાન ડાબે ખસેડીએ છીએ.</emphasis></para>
<media id="fs-id1170655166487" alt="પહેલા ભાગમાં 6%માં 6 અને % વચ્ચેના સ્થાનથી તીર 6ની ડાબે અને પછી વધુ એક સ્થાન ડાબે જાય છે; નીચે 0.06 છે. બીજા ભાગમાં 78%માં 8 અને % વચ્ચેના સ્થાનથી તીર 7 અને 8 વચ્ચે અને પછી 7ની ડાબે જાય છે; નીચે 0.78 છે. ત્રીજા ભાગમાં 2.7%માં તીર દશાંશ ચિહ્નથી 2ની ડાબે અને પછી વધુ એક સ્થાન ડાબે જાય છે; નીચે 0.027 છે. ચોથા ભાગમાં 135%માં 5 અને % વચ્ચેના સ્થાનથી તીર 3 અને 5 વચ્ચે અને પછી 1 અને 3 વચ્ચે જાય છે; નીચે 1.35 છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_07_023_img_new.jpg" />
</media>
<example id="fs-id1170655163112">
<exercise id="fs-id1170655124362">
<problem id="fs-id1170655219842">
<para id="fs-id1170655099418">દરેક ટકાને દશાંશમાં ફેરવો: <span class="token">ⓐ</span> 62% <span class="token">ⓑ</span> 135% <span class="token">ⓒ</span> 35.7%.</para>
</problem>
<solution id="fs-id1170655098922">
<title>ઉકેલ</title>
<para id="fs-id1170653218581"><table id="fs-id1167835311022" class="unnumbered unstyled can-break" aria-label="(a) “દશાંશ ચિહ્ન બે સ્થાન ડાબે ખસેડો” સૂચના છે. 62%માં 2 અને % વચ્ચેના સ્થાનથી તીર 6 અને 2 વચ્ચે અને પછી 6ની પહેલાં જાય છે. નીચે .62 છે."><label /><tgroup cols="2">
 <tbody>
  <row>
    <entry><span class="token">ⓐ</span> </entry>
    <entry />
  </row>
  <row>
    <entry />
    <entry><media id="eip-id1169750795982" alt="62%માં દશાંશ ચિહ્નનું સ્થાન 2 પછી છે; વાદળી તીર ત્યાંથી બે સ્થાન ડાબે ખસેડવાનું બતાવે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_020a_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>દશાંશ ચિહ્ન બે સ્થાન ડાબે ખસેડો.</entry>
    <entry><m:math><m:mn>0.62</m:mn></m:math></entry>
  </row>
  </tbody>
  </tgroup>
  </table>
  <table id="fs-id1167835479824" class="unnumbered unstyled can-break" aria-label="(b) “દશાંશ ચિહ્ન બે સ્થાન ડાબે ખસેડો” સૂચના છે. 135%માં 5 અને % વચ્ચેના સ્થાનથી તીર 3 અને 5 વચ્ચે અને પછી 1 અને 3 વચ્ચે જાય છે. નીચે 1.35 છે."><label /><tgroup cols="2">
 <tbody>
  <row>
    <entry><span class="token">ⓑ</span> </entry>
    <entry />
  </row>
  <row>
    <entry />
    <entry><media id="eip-id1169750875596" alt="135%માં દશાંશ ચિહ્નનું સ્થાન 5 પછી છે; વાદળી તીર ત્યાંથી બે સ્થાન ડાબે, 1 અને 3 વચ્ચે, ખસેડવાનું બતાવે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_020b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>દશાંશ ચિહ્ન બે સ્થાન ડાબે ખસેડો.</entry>
    <entry><m:math><m:mn>1.35</m:mn></m:math></entry>
  </row>
  </tbody>
  </tgroup>
  </table>
<table id="fs-id1167835297201" class="unnumbered unstyled can-break" aria-label="(c) “દશાંશ ચિહ્ન બે સ્થાન ડાબે ખસેડો” સૂચના છે. 35.7%માં દશાંશ ચિહ્નથી તીર બે સ્થાન ડાબે, 3ની પહેલાં, જાય છે. પરિણામ 0.357 છે."><label /><tgroup cols="2">
 <tbody>
    <row>
    <entry><span class="token">ⓒ</span> </entry>
    <entry />
  </row>
  <row>
    <entry />
    <entry><media id="eip-id1169753258746" alt="35.7%માં વાદળી તીર દશાંશ ચિહ્નને બે સ્થાન ડાબે, 3ની પહેલાં, ખસેડવાનું બતાવે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_020c_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>દશાંશ ચિહ્ન બે સ્થાન ડાબે ખસેડો.</entry>
    <entry><m:math><m:mn>0.357</m:mn></m:math></entry>
  </row>
 </tbody>

</tgroup>
</table></para></solution>
</exercise>
</example>
<note id="fs-id1170655104527" class="try">
<exercise id="fs-id1170655026256">
<problem id="fs-id1170655197168">
<para id="fs-id1170655261586">દરેક ટકાને દશાંશમાં ફેરવો: <span class="token">ⓐ</span> <m:math><m:mrow><m:mn>9%</m:mn></m:mrow></m:math> <span class="token">ⓑ</span> <m:math><m:mrow><m:mn>87%</m:mn></m:mrow></m:math> <span class="token">ⓒ</span> 3.9%.</para>
</problem>
<solution id="fs-id1170655026105">
<para id="fs-id1170654988894"><span class="token">ⓐ</span> 0.09 <span class="token">ⓑ</span> 0.87 <span class="token">ⓒ</span> 0.039</para>
</solution>
</exercise>
</note>
<note id="fs-id1170654967456" class="try">
<exercise id="fs-id1170655353932">
<problem id="fs-id1170655213342">
<para id="fs-id1170654977593">દરેક ટકાને દશાંશમાં ફેરવો: <span class="token">ⓐ</span> 3% <span class="token">ⓑ</span> 91% <span class="token">ⓒ</span> 8.3%.</para>
</problem>
<solution id="fs-id1170655218579">
<para id="fs-id1170655196826"><span class="token">ⓐ</span> 0.03 <span class="token">ⓑ</span> 0.91 <span class="token">ⓒ</span> 0.083</para>
</solution>
</exercise>
</note>
<para id="fs-id1170655132940">ટકાની વ્યાખ્યા અને સ્થાનકિંમત યાદ રાખીએ તો દશાંશને ટકામાં ફેરવવાની રીત સમજાય છે.</para>
<para id="fs-id1170655162904">દશાંશને ટકામાં ફેરવવા યાદ રાખો: ટકા એટલે પ્રતિ સો. દશાંશને 100 છેદવાળા અપૂર્ણાંકમાં ફેરવીએ તો તે અપૂર્ણાંકને ટકામાં ફેરવવો સરળ છે.</para>
<table id="eip-184" summary="ત્રણ દશાંશ 0.83, 1.05 અને 0.075ને તેમના સમ અપૂર્ણાંક અને ટકા સ્વરૂપમાં ફેરવવાનું કોષ્ટક છે.">
<tgroup cols="4"><tbody>
  <row>
    <entry />
    <entry><m:math><m:mn>0.83</m:mn></m:math></entry>
    <entry><m:math><m:mn>1.05</m:mn></m:math></entry>
    <entry><m:math><m:mn>0.075</m:mn></m:math></entry>
  </row>
  <row>
    <entry>અપૂર્ણાંક તરીકે લખો.</entry>
    <entry><m:math><m:mfrac><m:mn>83</m:mn><m:mrow><m:mn>100</m:mn></m:mrow></m:mfrac></m:math></entry>
    <entry><m:math><m:mn>1</m:mn><m:mfrac><m:mn>5</m:mn><m:mrow><m:mn>100</m:mn></m:mrow></m:mfrac></m:math></entry>
    <entry><m:math><m:mfrac><m:mn>75</m:mn><m:mrow><m:mn>1000</m:mn></m:mrow></m:mfrac></m:math></entry>
  </row>
  <row>
    <entry>છેદ 100 છે.</entry>
    <entry />
    <entry><m:math><m:mfrac><m:mn>105</m:mn><m:mrow><m:mn>100</m:mn></m:mrow></m:mfrac></m:math></entry>
    <entry><m:math><m:mfrac><m:mn>7.5</m:mn><m:mrow><m:mn>100</m:mn></m:mrow></m:mfrac></m:math></entry>
  </row>
    <row>
    <entry>ગુણોત્તરને ટકા તરીકે લખો.</entry>
    <entry><m:math><m:mn>83%</m:mn></m:math></entry>
    <entry><m:math><m:mn>105%</m:mn></m:math></entry>
    <entry><m:math><m:mn>7.5%</m:mn></m:math></entry>
  </row>
</tbody>
</tgroup>
</table><para id="fs-id1170654939286">પેટર્ન ઓળખાય છે? <emphasis effect="italics">દશાંશને ટકામાં ફેરવવા દશાંશ ચિહ્ન બે સ્થાન જમણે ખસેડીએ અને પછી ટકાનું ચિહ્ન ઉમેરીએ</emphasis>.</para>
<media id="fs-id1170654985014" alt="પહેલા ભાગમાં 0.05માં દશાંશ ચિહ્નથી તીર 0 અને 5 વચ્ચે અને પછી 5ની પાછળ જાય છે; નીચે 5% છે. બીજામાં 0.83માં તીર 8 અને 3 વચ્ચે અને પછી 3ની પાછળ જાય છે; નીચે 83% છે. ત્રીજામાં 1.05માં તીર 0 અને 5 વચ્ચે અને પછી 5ની પાછળ જાય છે; નીચે 105% છે. ચોથામાં 0.075માં તીર 0 અને 7 વચ્ચે અને પછી 7 અને 5 વચ્ચે જાય છે; નીચે 7.5% છે. પાંચમામાં 0.3માં તીર 3ની પાછળ અને પછી વધુ એક સ્થાન જમણે જાય છે; નીચે 30% છે.">
<image mime-type="image/jpeg" src="../../media/CNX_ElemAlg_Figure_01_07_021_img_new.jpg" />
</media>
<example id="fs-id1170655225662">
<exercise id="fs-id1170654954608"><problem id="fs-id1170654954610">
<para id="fs-id1170655107279">દરેક દશાંશને ટકામાં ફેરવો: <span class="token">ⓐ</span> 0.51 <span class="token">ⓑ</span> 1.25 <span class="token">ⓒ</span> 0.093.</para>
</problem>
<solution id="fs-id1170655226998">
<title>ઉકેલ</title><table id="eip-id1169753137153" class="unnumbered unstyled can-break" aria-label="(a) “દશાંશ ચિહ્ન બે સ્થાન જમણે ખસેડો” સૂચના છે. 0.51માં દશાંશ ચિહ્નથી તીર 5 અને 1 વચ્ચે અને પછી 1ની પાછળ જાય છે. નીચે 51% છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry><span class="token">ⓐ</span> </entry>
    <entry />
  </row>
  <row>
    <entry />
    <entry><media id="eip-id1169750875648" alt="0.51માં વાદળી તીર દશાંશ ચિહ્નને બે સ્થાન જમણે, 1ની પાછળ, ખસેડવાનું બતાવે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_022a_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>દશાંશ ચિહ્ન બે સ્થાન જમણે ખસેડો.</entry>
    <entry><m:math><m:mn>51%</m:mn></m:math></entry>
  </row>
  </tbody>
  </tgroup>
  </table>
  <table id="fs-id1167831040263" class="unnumbered unstyled can-break" aria-label="(b) “દશાંશ ચિહ્ન બે સ્થાન જમણે ખસેડો” સૂચના છે. 1.25માં તીર દશાંશ ચિહ્નથી બે સ્થાન જમણે, 5ની પાછળ, જાય છે. નીચે 125% છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry><span class="token">ⓑ</span> </entry>
    <entry />
  </row>
  <row>
    <entry />
    <entry><media id="eip-id1169753320625" alt="1.25માં વાદળી તીર દશાંશ ચિહ્નને બે સ્થાન જમણે, 5ની પાછળ, ખસેડવાનું બતાવે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_022b_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>દશાંશ ચિહ્ન બે સ્થાન જમણે ખસેડો.</entry>
    <entry><m:math><m:mn>125%</m:mn></m:math></entry>
  </row>
  </tbody>
  </tgroup>
  </table>
  <table id="fs-id1167835167385" class="unnumbered unstyled" aria-label="(c) “દશાંશ ચિહ્ન બે સ્થાન જમણે ખસેડો” સૂચના છે. 0.093માં દશાંશ ચિહ્નથી તીર 0 અને 9 વચ્ચે અને પછી 9 અને 3 વચ્ચે જાય છે. નીચે 9.3% છે."><label />
<tgroup cols="2"><tbody>
    <row>
    <entry><span class="token">ⓒ</span> </entry>
    <entry />
  </row>
  <row>
    <entry />
    <entry><media id="eip-id1169753184552" alt="0.093માં વાદળી તીર દશાંશ ચિહ્નને બે સ્થાન જમણે, 9 અને 3 વચ્ચે, ખસેડવાનું બતાવે છે."><image mime-type="image/png" src="../../media/CNX_ElemAlg_Figure_01_07_022c_img_new.jpg" /></media></entry>
  </row>
  <row>
    <entry>દશાંશ ચિહ્ન બે સ્થાન જમણે ખસેડો.</entry>
    <entry><m:math><m:mn>9.3%</m:mn></m:math></entry>
  </row>
 </tbody>
</tgroup>
</table>
</solution>
</exercise></example>
<note id="fs-id1170655098057" class="try">
<exercise id="fs-id1170655163904">
<problem id="fs-id1170655163906">
<para id="fs-id1170655058757">દરેક દશાંશને ટકામાં ફેરવો: <span class="token">ⓐ</span> 0.17 <span class="token">ⓑ</span> 1.75 <span class="token">ⓒ</span> 0.0825.</para>
</problem>
<solution id="fs-id1170654904124">
<para id="fs-id1170654904126"><span class="token">ⓐ</span> 17% <span class="token">ⓑ</span> 175% <span class="token">ⓒ</span> 8.25%</para>
</solution>
</exercise>
</note>
<note id="fs-id1170655213399" class="try">
<exercise id="fs-id1170654985785">
<problem id="fs-id1170654985787">
<para id="fs-id1170654888115">દરેક દશાંશને ટકામાં ફેરવો: <span class="token">ⓐ</span> 0.41 <span class="token">ⓑ</span> 2.25 <span class="token">ⓒ</span> 0.0925.</para>
</problem>
<solution id="fs-id1170655081883">
<para id="fs-id1170655081885"><span class="token">ⓐ</span> 41% <span class="token">ⓑ</span> 225% <span class="token">ⓒ</span> 9.25%</para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1170655163040" class="key-concepts">
<title>મુખ્ય ખ્યાલો</title>
<list id="fs-id1170655106869" list-type="bulleted" bullet-style="bullet">
<item><emphasis effect="bold">દશાંશને શબ્દોમાં લખો</emphasis>
<list id="fs-id1170654931844" list-type="enumerated" number-style="arabic" class="stepwise">
<item>દશાંશ ચિહ્નની ડાબી બાજુની સંખ્યાને શબ્દોમાં લખો.</item>
<item>દશાંશ ચિહ્ન માટે “અને” લખો.</item>
<item>દશાંશ ચિહ્નની જમણી બાજુના સંખ્યાભાગને પૂર્ણ સંખ્યા ગણીને શબ્દોમાં લખો.</item>
<item>છેલ્લા અંકના દશાંશ સ્થાનનું નામ લખો.</item>
</list></item>
<item><emphasis effect="bold">દશાંશને અંકોમાં લખો</emphasis>
<list id="fs-id1170655029728" list-type="enumerated" number-style="arabic" class="stepwise">
<item>“અને” શબ્દ શોધો—તે દશાંશ ચિહ્નનું સ્થાન સૂચવે છે. “અને”ની નીચે દશાંશ ચિહ્ન મૂકો. “અને” પહેલાંના શબ્દોને પૂર્ણ સંખ્યામાં ફેરવીને દશાંશ ચિહ્નની ડાબે લખો. જો “અને” ન હોય, તો “0” લખીને તેની જમણે દશાંશ ચિહ્ન મૂકો.</item>
<item>છેલ્લા શબ્દમાં આપેલી સ્થાનકિંમત પરથી દશાંશ ચિહ્નની જમણે જરૂરી સ્થાનો ચિહ્નિત કરો.</item>
<item>“અને” પછીના શબ્દોને સંખ્યામાં ફેરવીને દશાંશ ચિહ્નની જમણે લખો. છેલ્લો અંક છેલ્લા સ્થાને આવે તેમ ખાલી જગ્યામાં સંખ્યા લખો.</item>
<item>જરૂર મુજબ ખાલી સ્થાનોમાં શૂન્ય ભરો.</item>
</list></item>
<item><emphasis effect="bold">દશાંશને નજીકની આપેલી સ્થાનકિંમતમાં ફેરવો</emphasis>
<list id="fs-id1170655114584" list-type="enumerated" number-style="arabic" class="stepwise">
<item>આપેલી સ્થાનકિંમત શોધીને તેના પર તીર મૂકો.</item>
<item>તે સ્થાનકિંમતની જમણી બાજુના અંકને રેખાંકિત કરો.</item>
<item>શું આ અંક 5 કરતાં મોટો અથવા બરાબર છે? હા—આપેલી સ્થાનકિંમતના અંકમાં 1 ઉમેરો. ના—આપેલી સ્થાનકિંમતના અંકને <emphasis effect="underline">બદલશો નહીં</emphasis> .</item>
<item>જે અંક સુધી ફેરવવાનું છે તેની જમણી બાજુના બધા અંક કાઢીને સંખ્યા ફરી લખો.</item>
</list></item>
<item><emphasis effect="bold">દશાંશનો સરવાળો કે બાદબાકી કરો</emphasis>
<list id="fs-id1170655063011" list-type="enumerated" number-style="arabic" class="stepwise">
<item>દશાંશ ચિહ્નો એકની નીચે એક આવે તેમ સંખ્યાઓ લખો.</item>
<item>જરૂર મુજબ ખાલી સ્થાનોમાં શૂન્ય વાપરો.</item>
<item>સંખ્યાઓને પૂર્ણ સંખ્યા ગણીને સરવાળો કે બાદબાકી કરો. પછી આપેલી સંખ્યાઓનાં દશાંશ ચિહ્નોની નીચે જવાબમાં દશાંશ ચિહ્ન મૂકો.</item>
</list></item>
<item><emphasis effect="bold">દશાંશનો ગુણાકાર કરો</emphasis>
<list id="fs-id1170655162096" list-type="enumerated" number-style="arabic" class="stepwise">
<item>ગુણનફળનું ચિહ્ન નક્કી કરો.</item>
<item>સંખ્યાઓની જમણી બાજુ સરખી ગોઠવીને એકની નીચે એક લખો. દશાંશ ચિહ્નોને થોડા સમય માટે અવગણીને પૂર્ણ સંખ્યાઓની જેમ ગુણાકાર કરો.</item>
<item>દશાંશ ચિહ્ન મૂકો. ગુણનફળમાં દશાંશ સ્થાનોની સંખ્યા, અવયવોમાં દશાંશ સ્થાનોની સંખ્યાના સરવાળા જેટલી હોય છે.</item>
<item>યોગ્ય ચિહ્ન સાથે ગુણનફળ લખો.</item>
</list></item>
<item><emphasis effect="bold">દશાંશને દસની ઘાત વડે ગુણો</emphasis>
<list id="fs-id1170655037577" list-type="enumerated" number-style="arabic" class="stepwise">
<item>10ની ઘાતમાં જેટલાં શૂન્ય હોય તેટલાં સ્થાન દશાંશ ચિહ્ન જમણે ખસેડો.</item>
<item>જરૂર મુજબ સંખ્યાના અંતે શૂન્ય ઉમેરો.</item>
</list></item>
<item><emphasis effect="bold">દશાંશનો ભાગાકાર કરો</emphasis>
<list id="fs-id1170655201026" list-type="enumerated" number-style="arabic" class="stepwise">
<item>ભાગફળનું ચિહ્ન નક્કી કરો.</item>
<item>દશાંશ ચિહ્નને જમણી બાજુના છેલ્લા અંકની પાછળ “ખસેડીને” ભાજકને પૂર્ણ સંખ્યા બનાવો. ભાજ્યમાં પણ દશાંશ ચિહ્ન એટલાં જ સ્થાન “ખસેડો”—જરૂર મુજબ શૂન્ય ઉમેરો.</item>
<item>ભાગાકાર કરો. ભાગફળમાં દશાંશ ચિહ્ન, ભાજ્યના દશાંશ ચિહ્નની ઉપર મૂકો.</item>
<item>યોગ્ય ચિહ્ન સાથે ભાગફળ લખો.</item>
</list></item>
<item><emphasis effect="bold">દશાંશને શુદ્ધ અપૂર્ણાંકમાં ફેરવો</emphasis>
<list id="fs-id1170654983497" list-type="enumerated" number-style="arabic" class="stepwise">
<item>છેલ્લા અંકની સ્થાનકિંમત નક્કી કરો.</item>
<item>અપૂર્ણાંક લખો: અંશ—દશાંશ ચિહ્નની જમણી બાજુના અંકો વડે બનતી પૂર્ણ સંખ્યા; છેદ—છેલ્લા અંકના સ્થાનને અનુરૂપ અપૂર્ણાંકના છેદમાં આવતી દસની ઘાત.</item>
</list></item>
<item><emphasis effect="bold">અપૂર્ણાંકને દશાંશમાં ફેરવો</emphasis> અપૂર્ણાંકના અંશને છેદ વડે ભાગો.</item>
</list>
</section>
<section id="fs-id1170655025026" class="section-exercises">
<section id="fs-id1170655025030" class="practice-perfect">
<title>અભ્યાસથી નિપુણતા</title>
<para id="fs-id1170655189303"><emphasis effect="bold">દશાંશને શબ્દોમાં અને અંકોમાં લખો</emphasis></para>
<para id="fs-id1166424918156">નીચેના અભ્યાસોમાં દશાંશ સ્વરૂપે લખો.</para>
<exercise id="fs-id1170655163516">
<problem id="fs-id1170654905563">
<para id="fs-id1170654905565">ઓગણત્રીસ અને એક્યાસી શતાંશ</para>
</problem>
<solution id="fs-id1170655111614">
