<?xml version='1.0' encoding='utf-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" xmlns:ns1="http://cnx.rice.edu/mdml" xml:lang="gu-Gujr-IN">
<title>પૂર્ણ સંખ્યાઓનો ગુણાકાર કરો</title>
<metadata>
  <ns1:content-id>m81255</ns1:content-id>
  <ns1:title>પૂર્ણ સંખ્યાઓનો ગુણાકાર કરો</ns1:title>
  <ns1:abstract><para id="para-00001">આ વિભાગના અંતે તમે:</para><list id="list-00001">
<item>ગુણાકારની લખાવટનો ઉપયોગ કરી શકશો.</item>
<item>પૂર્ણ સંખ્યાઓનો ગુણાકાર નમૂના દ્વારા દર્શાવી શકશો.</item>
<item>પૂર્ણ સંખ્યાઓનો ગુણાકાર કરી શકશો.</item>
<item>શબ્દોમાં આપેલી વાતને ગણિતની લખાવટમાં ફેરવી શકશો.</item>
<item>વ્યવહારુ પ્રશ્નોમાં પૂર્ણ સંખ્યાઓનો ગુણાકાર કરી શકશો.</item>
</list></ns1:abstract>
  <ns1:uuid>9b248006-6668-446c-bcc4-bd1a9730b4ad</ns1:uuid>
</metadata>

<content>
<note id="fs-id2209942" class="be-prepared">
<para id="fs-id2279966">શરૂઆત કરતાં પહેલાં તૈયારી તપાસવાના આ પ્રશ્નો ઉકેલો.</para>
<exercise id="fs-idm344657232">
<problem id="fs-idm349226720">
<para id="fs-idm348462256">સરવાળો કરો: <m:math><m:mrow><m:mn>1,683</m:mn><m:mo>+</m:mo><m:mn>479</m:mn><m:mo>.</m:mo></m:mrow></m:math><newline />
જો આ પ્રશ્નમાં ભૂલ થઈ હોય, તો ફરી જુઓ: <link target-id="fs-id1801021" document="m81244" />.</para>
</problem>
<solution id="fs-idm321743392">
<para id="fs-idm348371040"><m:math><m:mrow><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>162</m:mn></m:mrow></m:math></para>
</solution>
</exercise></note>
<note id="fs-id2209943" class="be-prepared">
<exercise id="fs-idm348809552">
<problem id="fs-idm350333120">
<para id="fs-idm349370880">બાદબાકી કરો: <m:math><m:mrow><m:mn>605</m:mn><m:mo>−</m:mo><m:mn>321</m:mn><m:mo>.</m:mo></m:mrow></m:math><newline />
જો આ પ્રશ્નમાં ભૂલ થઈ હોય, તો ફરી જુઓ: <link target-id="fs-id1342104" document="m81245" />.</para>
</problem>
<solution id="fs-idm345697152">
<para id="fs-idm339658208"><m:math><m:mrow><m:mn>284</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<section id="fs-id2264601">
<title>ગુણાકારની લખાવટનો ઉપયોગ કરો</title>
<para id="fs-id2496968">ધારો કે તમને આ બધા એક સેન્ટના સિક્કા ગણવાનું કહેવામાં આવે, જે અહીં દર્શાવેલા છે: <link target-id="CNX_BMath_Figure_01_04_001" />.</para>
<figure id="CNX_BMath_Figure_01_04_001">
<media id="fs-id1387943" alt="સિક્કાની 3 આડી હરોળ છે; દરેક હરોળમાં 8 સિક્કા છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_04_001.jpg" />
</media>
</figure>
<para id="fs-id2300732">શું તમે સિક્કા એક પછી એક ગણશો? કે દરેક હરોળના સિક્કાની સંખ્યા ગણીને એ સંખ્યાને <m:math><m:mn>3</m:mn></m:math> વખત ઉમેરશો?</para>
<equation id="fs-id1935432" class="unnumbered"><label /><m:math><m:mrow><m:mn>8</m:mn><m:mo>+</m:mo><m:mn>8</m:mn><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow></m:math></equation>
<para id="fs-id1772585">ગુણાકાર એ પુનરાવર્તિત સરવાળો દર્શાવવાની રીત છે. તેથી <m:math><m:mrow><m:mn>8</m:mn></m:mrow></m:math> ને ત્રણ વખત ઉમેરવાને બદલે આપણે ગુણાકારની પદાવલી લખી શકીએ.</para>
<equation id="fs-id4229230" class="unnumbered"><label /><m:math><m:mrow><m:mn>3</m:mn><m:mspace width="0.2em" /><m:mo>×</m:mo><m:mspace width="0.2em" /><m:mn>8</m:mn></m:mrow></m:math></equation>
<para id="fs-id2818031">ગુણાકાર થતી દરેક સંખ્યાને અવયવ અને પરિણામને <term id="term-00001">ગુણનફળ</term> કહીએ છીએ. આપણે <m:math><m:mrow><m:mn>3</m:mn><m:mspace width="0.2em" /><m:mo>×</m:mo><m:mspace width="0.2em" /><m:mn>8</m:mn></m:mrow></m:math> ને <emphasis effect="italics">ત્રણ ગુણ્યા આઠ</emphasis> વાંચીએ છીએ અને પરિણામને <emphasis effect="italics">ત્રણ અને આઠનું ગુણનફળ કહીએ છીએ</emphasis>.</para><para id="fs-id2339858">ગુણાકાર દર્શાવતાં કેટલાંક પ્રતીકો છે. તેમાં આ પ્રતીક <m:math><m:mo>×</m:mo></m:math> તેમ જ બિંદુ <m:math><m:mo>·</m:mo></m:math>અને કૌંસનો સમાવેશ થાય છે: <m:math><m:mrow><m:mo>(</m:mo><m:mspace width="0.2em" /><m:mtext>).</m:mtext></m:mrow></m:math></para>
<note id="fs-id1266464">
<title>ગુણાકારની ક્રિયાનાં પ્રતીકો</title>
<para id="fs-id2196798">ગુણાકાર સમજાવવા પ્રતીકો અને શબ્દો વાપરી શકીએ છીએ.</para>
<table id="fs-id1187222" aria-label="5 સ્તંભ અને 1 હરોળનું કોષ્ટક. પહેલા સ્તંભનું નામ “ક્રિયા” છે અને તેમાં “ગુણાકાર” છે. બીજા સ્તંભનું નામ “લખાવટ” છે અને તેમાં ત્રણ પ્રતીકો છે: ગુણાકારનું × ચિહ્ન, બિંદુ અને કૌંસ. ત્રીજા સ્તંભનું નામ “પદાવલી” છે અને તેમાં બીજા સ્તંભનાં જુદાં પ્રતીકો વડે 3 ગુણ્યા 8નાં ત્રણ સ્વરૂપ છે. ચોથા સ્તંભનું નામ “આ રીતે વાંચો” છે અને તેમાં “ત્રણ ગુણ્યા આઠ” છે. પાંચમા સ્તંભનું નામ “પરિણામ” છે અને તેમાં “3 અને 8નું ગુણનફળ” છે." class="unnumbered">
<label />
<tgroup cols="5">
<colspec colnum="1" colname="c1" />
<colspec colnum="2" colname="c2" />
<colspec colnum="3" colname="c3" />
<colspec colnum="4" colname="c4" />
<colspec colnum="5" colname="c5" />
<thead>
<row valign="top">
<entry align="left">ક્રિયા</entry>
<entry align="left">લખાવટ</entry>
<entry align="left">પદાવલી</entry>
<entry align="left">આ રીતે વાંચો</entry>
<entry align="left">પરિણામ</entry>
</row>
</thead>
<tbody>
<row valign="top">
<entry valign="top" align="left"><m:math><m:mrow><m:mtext>ગુણાકાર</m:mtext></m:mrow></m:math></entry>
<entry valign="top" align="left"><m:math><m:mrow><m:mo>×</m:mo></m:mrow></m:math><newline /><m:math><m:mrow><m:mo>·</m:mo></m:mrow></m:math><newline /><m:math><m:mrow><m:mo>(</m:mo><m:mspace width="0.2em" /><m:mo>)</m:mo></m:mrow></m:math></entry>
<entry valign="top" align="left"><m:math><m:mrow><m:mn>3</m:mn><m:mspace width="0.2em" /><m:mo>×</m:mo><m:mspace width="0.2em" /><m:mn>8</m:mn></m:mrow></m:math><newline /><m:math><m:mrow><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>8</m:mn></m:mrow></m:math><newline /><m:math><m:mrow><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></entry>
<entry valign="top" align="left"><m:math><m:mrow><m:mtext>ત્રણ ગુણ્યા આઠ</m:mtext></m:mrow></m:math></entry>
<entry valign="top" align="left"><m:math><m:mrow><m:mtext>3 અને 8નું ગુણનફળ</m:mtext></m:mrow></m:math></entry>
</row>
</tbody>
</tgroup>
</table>
</note>
<example id="fs-id1613668">
<exercise id="fs-id1582205"><problem id="fs-id1920178">
<para id="fs-id2471373">ગણિતની લખાવટને શબ્દોમાં ફેરવો:</para>
<list id="eip-id1168287342411" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mn>7</m:mn><m:mspace width="0.2em" /><m:mo>×</m:mo><m:mspace width="0.2em" /><m:mn>6</m:mn></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mrow><m:mn>12</m:mn><m:mo>·</m:mo><m:mn>14</m:mn></m:mrow></m:math></item>
<item><span class="token">ⓒ</span> <m:math><m:mrow><m:mn>6</m:mn><m:mo stretchy="false">(</m:mo><m:mn>13</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></item></list></problem>
<solution id="fs-id1727798">
<title>ઉકેલ</title>
<list id="eip-id1168289744402" list-type="labeled-item" class="circled"><item><span class="token">ⓐ</span> આને આપણે <emphasis effect="italics">સાત ગુણ્યા છ</emphasis> વાંચીએ છીએ અને પરિણામ છે <emphasis effect="italics">સાત અને છનું ગુણનફળ</emphasis>.</item>
<item><span class="token">ⓑ</span> આને આપણે <emphasis effect="italics">બાર ગુણ્યા ચૌદ</emphasis> વાંચીએ છીએ અને પરિણામ છે <emphasis effect="italics">બાર અને ચૌદનું ગુણનફળ</emphasis>.</item>
<item><span class="token">ⓒ</span> આને આપણે <emphasis effect="italics">છ ગુણ્યા તેર</emphasis> વાંચીએ છીએ અને પરિણામ છે <emphasis effect="italics">છ અને તેરનું ગુણનફળ</emphasis>.</item></list></solution>
</exercise></example>
<note id="fs-id2172015" class="try">
<exercise id="fs-id1223488"><problem id="fs-id2819085">
<para id="fs-id2595008">ગણિતની લખાવટને શબ્દોમાં ફેરવો:</para>
<list id="eip-id1168286025584" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mn>8</m:mn><m:mspace width="0.2em" /><m:mo>×</m:mo><m:mspace width="0.2em" /><m:mn>7</m:mn></m:math></item><item><span class="token">ⓑ</span> <m:math><m:mn>18</m:mn><m:mo>·</m:mo><m:mn>11</m:mn></m:math></item></list>
</problem>
<solution id="fs-id2278064">
<list id="eip-id1168288211731" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> આઠ ગુણ્યા સાત; આઠ અને સાતનું ગુણનફળ </item><item><span class="token">ⓑ</span> અઢાર ગુણ્યા અગિયાર; અઢાર અને અગિયારનું ગુણનફળ</item></list></solution>
</exercise></note>
<note id="fs-id1948860" class="try">
<exercise id="fs-id1396373"><problem id="fs-id1463587">
<para id="fs-id1823892">ગણિતની લખાવટને શબ્દોમાં ફેરવો:</para>
<list id="eip-id1168288623785" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mo stretchy="false">(</m:mo><m:mn>13</m:mn><m:mo stretchy="false">)</m:mo><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mo stretchy="false">)</m:mo></m:math></item><item><span class="token">ⓑ</span> <m:math><m:mn>5</m:mn><m:mo stretchy="false">(</m:mo><m:mn>16</m:mn><m:mo stretchy="false">)</m:mo></m:math></item></list></problem>
<solution id="fs-id1465166">
<list id="eip-id1168288173115" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> તેર ગુણ્યા સાત; તેર અને સાતનું ગુણનફળ </item><item><span class="token">ⓑ</span> પાંચ ગુણ્યા સોળ; પાંચ અને સોળનું ગુણનફળ</item></list></solution>
</exercise></note>
</section>
<section id="fs-id1321319">
<title>પૂર્ણ સંખ્યાઓનો ગુણાકાર નમૂના દ્વારા દર્શાવો</title>
<para id="fs-id1790692">ગુણાકારનો નમૂનો બનાવવાની ઘણી રીત છે. અગાઉના વિભાગોમાં આપણે <m:math><m:mrow><m:mtext>આધાર-10</m:mtext></m:mrow></m:math> ના ખંડો વાપર્યા હતા; અહીં ગુણાકારનો અર્થ સમજવા ગણતરીની ચકતીઓ વાપરીશું. ગણવા માટે વાપરી શકાય એવી કોઈ પણ વસ્તુ ગણતરીની ચકતી બની શકે છે. આપણે વાદળી રંગની ગોળ ચકતીઓ વાપરીશું.</para>
<example id="fs-id3298604">
<exercise id="fs-id764495">
<problem id="fs-id2496622">
<para id="fs-id1596393">નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>3</m:mn><m:mspace width="0.2em" /><m:mo>×</m:mo><m:mspace width="0.2em" /><m:mn>8</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2410020">
<title>ઉકેલ</title>
<para id="fs-id1543868">આ ગુણનફળનો નમૂનો બનાવવા માટે: <m:math><m:mrow><m:mn>3</m:mn><m:mspace width="0.2em" /><m:mo>×</m:mo><m:mspace width="0.2em" /><m:mn>8</m:mn><m:mo>,</m:mo></m:mrow></m:math> આપણે એક હરોળથી શરૂઆત કરીશું, જેમાં <m:math><m:mn>8</m:mn></m:math> ચકતીઓ હોય.<newline />
<media id="fs-id4164916" alt="8 ચકતીઓની એક આડી હરોળ.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_04_002_img.jpg" />
</media></para>
<para id="fs-id2802597">બીજો અવયવ છે <m:math><m:mrow><m:mn>3</m:mn><m:mo>,</m:mo></m:mrow></m:math> તેથી આપણે <m:math><m:mn>3</m:mn></m:math> હરોળ બનાવીશું, જેમાં દરેકમાં <m:math><m:mn>8</m:mn></m:math> ચકતીઓ હોય.<newline />
<media id="fs-id2318692" alt="ચકતીઓની 3 આડી હરોળ છે; દરેક હરોળમાં 8 ચકતીઓ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_01_04_003_img.jpg" />
</media></para>
<para id="fs-id2218144">હવે પરિણામ ગણીએ. કુલ <m:math><m:mrow><m:mn>24</m:mn></m:mrow></m:math> ચકતીઓ છે.</para>
<para id="fs-id1407817"><m:math><m:mrow><m:mn>3</m:mn><m:mspace width="0.2em" /><m:mo>×</m:mo><m:mspace width="0.2em" /><m:mn>8</m:mn><m:mo>=</m:mo><m:mn>24</m:mn></m:mrow></m:math></para>
<para id="fs-id1799237">ચકતીઓને બાજુથી જોશો, તો જણાશે કે આપણે <m:math><m:mn>8</m:mn></m:math> હરોળ પણ બનાવી શક્યા હોત, જેમાં દરેકમાં <m:math><m:mn>3</m:mn></m:math> ચકતીઓ હોય. ગુણનફળ સરખું જ રહેત. આ વિચારને ફરી પછી જોઈશું.</para>
</solution>
</exercise>
</example>
<note id="fs-id2129872" class="try">
<exercise id="fs-id1569182">
