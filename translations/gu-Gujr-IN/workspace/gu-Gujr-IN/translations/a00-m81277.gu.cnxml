<?xml version='1.0' encoding='utf-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" xmlns:md="http://cnx.rice.edu/mdml" xml:lang="gu-Gujr-IN">
<title>પૂર્ણાંકોની બાદબાકી કરો</title>
<metadata>
  <md:content-id>m81277</md:content-id>
  <md:title>પૂર્ણાંકોની બાદબાકી કરો</md:title>
  <md:abstract><para id="para-00001">આ વિભાગના અંતે તમે આ કરી શકશો:</para><list id="list-00001">
<item>પૂર્ણાંકોની બાદબાકીને નમૂના દ્વારા દર્શાવી શકશો</item>
<item>પૂર્ણાંકો ધરાવતી પદાવલીઓ સરળ કરી શકશો</item>
<item>પૂર્ણાંકો ધરાવતી ચલ પદાવલીઓની કિંમત શોધી શકશો</item>
<item>શબ્દસમૂહોને બીજગણિતીય પદાવલીઓમાં ફેરવી શકશો</item>
<item>વ્યવહારુ પ્રશ્નોમાં પૂર્ણાંકોની બાદબાકી કરી શકશો</item>
</list></md:abstract>
  <md:uuid>834642be-f141-48c4-aa97-01b61193ccd0</md:uuid>
</metadata>

<content>
<note id="fs-id2687175" class="be-prepared">
<para id="fs-id2209895">શરૂઆત કરતાં પહેલાં તૈયારીની આ કસોટી કરો.</para>
<exercise id="fs-idm176096208">
<problem id="fs-idm216672368">
<para id="fs-idm201757264">સરળ કરો: <m:math><m:mrow><m:mn>12</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mn>−1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>.</m:mo></m:mrow></m:math><newline />
જો આ પ્રશ્નનો જવાબ ન મળ્યો હોય, તો ફરી જુઓ <link target-id="fs-id1949613" document="m81268" />.</para>
</problem>
<solution id="fs-idm208415152">
<para id="fs-idm214097152"><m:math><m:mn>5</m:mn></m:math></para>
</solution>
</exercise></note>
<note id="fs-id2687177" class="be-prepared">
<exercise id="fs-idm184236752">
<problem id="fs-idm192883184">
<para id="fs-idm214495552">ગાણિતિક લખાવટમાં ફેરવો: <emphasis effect="italics">આ સંખ્યાઓનો તફાવત:</emphasis> <m:math><m:mrow><m:mtext mathvariant="italic">20</m:mtext></m:mrow></m:math> <emphasis effect="italics">અને</emphasis> <m:math><m:mrow><m:mtext mathvariant="italic">−15</m:mtext></m:mrow></m:math> .<newline />
જો આ પ્રશ્નનો જવાબ ન મળ્યો હોય, તો ફરી જુઓ <link target-id="fs-id2297604" document="m81245" />.</para>
</problem>
<solution id="fs-idm200684592">
<para id="fs-idm180218704"><m:math><m:mrow><m:mn>20</m:mn><m:mo>−</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mo>−</m:mo><m:mn>15</m:mn></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</solution>
</exercise></note>
<note id="fs-id2387175" class="be-prepared">
<exercise id="fs-idm206047648">
<problem id="fs-idm206122464">
<para id="fs-idm214323760">સરવાળો કરો: <m:math><m:mrow><m:mn>−18</m:mn><m:mo>+</m:mo><m:mn>7</m:mn><m:mo>.</m:mo></m:mrow></m:math><newline />
જો આ પ્રશ્નનો જવાબ ન મળ્યો હોય, તો ફરી જુઓ <link target-id="fs-id1166761472172" document="m81276" />.</para>
</problem>
<solution id="fs-idm201887216">
<para id="fs-idm216465712"><m:math><m:mrow><m:mo>-</m:mo><m:mn>11</m:mn></m:mrow></m:math></para>
</solution>
</exercise>
</note>
<section id="fs-id2630807"><title>પૂર્ણાંકોની બાદબાકીને નમૂના દ્વારા દર્શાવો</title><para id="fs-id1920186">પાછલા વિભાગમાં નાના બાળક અને બિસ્કિટની વાર્તા યાદ છે? બાળકો રોજિંદા અનુભવોમાંથી સંખ્યાઓની બાદબાકી શીખે છે. વાસ્તવિક જીવનના અનુભવો ધન સંખ્યાઓની બાદબાકી માટે અને તાપમાન જેવી કેટલીક પરિસ્થિતિઓમાં ઋણ તથા ધન સંખ્યાઓના સરવાળા માટે નમૂના પૂરા પાડે છે. પરંતુ ઋણ સંખ્યાઓની બાદબાકીને રોજિંદા અનુભવો સાથે જોડવી મુશ્કેલ છે. ઋણ સંખ્યાઓ સામેલ હોય ત્યારે બાદબાકીની સાહજિક સમજ મોટા ભાગના લોકોને હોતી નથી. ગણિતના શિક્ષકો ઋણ સંખ્યાઓની બાદબાકી સમજાવવા જુદા જુદા નમૂના વાપરે છે.</para>
<para id="fs-id1714662">બાદબાકીને નમૂના દ્વારા દર્શાવવા આપણે કાઉન્ટર વાપરવાનું ચાલુ રાખીશું. યાદ રાખો કે વાદળી કાઉન્ટર ધન સંખ્યાઓ અને લાલ કાઉન્ટર ઋણ સંખ્યાઓ દર્શાવે છે.</para>
<para id="fs-id2370590">તમે નાના હતા ત્યારે કદાચ <m:math><m:mrow><m:mn>5</m:mn><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math> ને <emphasis effect="italics">પાંચમાંથી ત્રણ દૂર કરો</emphasis>તરીકે વાંચ્યું હશે. કાઉન્ટર વાપરીએ ત્યારે બાદબાકીને આ જ રીતે વિચારી શકીએ છીએ.</para>
<note id="eip-609" class="manipulative-math">“નિશાનીવાળી સંખ્યાઓની બાદબાકી” નામની હેરફેરની વસ્તુઓ વડે ગણિતની પ્રવૃત્તિ કરવાથી પૂર્ણાંકોની બાદબાકી વધુ સારી રીતે સમજવામાં મદદ મળશે.</note><para id="fs-id2212069">આપણે આ સંખ્યાઓ વડે બાદબાકીનાં ચાર તથ્યોને નમૂના દ્વારા દર્શાવીશું: <m:math><m:mrow><m:mn>5</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>3</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<equation id="fs-id328332" class="unnumbered"><label /><m:math><m:mrow><m:mn>5</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mspace width="1em" /><m:mn>−5</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−3</m:mn><m:mo stretchy="false">)</m:mo><m:mspace width="1em" /><m:mn>−5</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mspace width="1em" /><m:mn>5</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></equation>
<example id="fs-id2204811">
<exercise id="fs-id1517547"><problem id="fs-id2140876">
<para id="fs-id1899309">નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>5</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2239685">
<title>ઉકેલ</title>
<table id="eip-id1168469608926" class="unnumbered unstyled" aria-label="આકૃતિમાં પાંચ હરોળ છે. પહેલી હરોળ પદાવલીનો અર્થ સમજવાનું કહે છે. પછી 5 ઓછા 3 એટલે 5માંથી 3 દૂર કરો એમ લખેલું છે. બીજી હરોળ પ્રથમ સંખ્યાનો નમૂનો બનાવી 5 ધન કાઉન્ટરથી શરૂ કરવાનું કહે છે. પછી 5 વાદળી વર્તુળ છે. ત્રીજી હરોળ બીજી સંખ્યા દૂર કરવાનું, એટલે 3 ધન કાઉન્ટર દૂર કરવાનું કહે છે. પછી 5 વાદળી વર્તુળ છે, જેમાં પહેલા ત્રણ ઘેરેલાં છે. ચોથી હરોળ બાકી રહેલા કાઉન્ટર શોધવાનું કહે છે. પછી 2 વાદળી વર્તુળ છે અને તેમનું નામ બે ધન આપેલું છે. પાંચમી હરોળ કહે છે કે 5 અને 3નો તફાવત 2 છે. પછી પદાવલી 5 ઓછા 3 બરાબર 2 છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry>પદાવલીનો અર્થ સમજો.</entry>
   <entry><m:math><m:mn>5</m:mn><m:mo>−</m:mo><m:mn>3</m:mn></m:math> એટલે <m:math><m:mn>5</m:mn></m:math> માંથી દૂર કરો <m:math><m:mn>3</m:mn></m:math>.</entry>
 </row>
 <row>
 <entry>પ્રથમ સંખ્યાનો નમૂનો બનાવો. 5 ધન કાઉન્ટરથી શરૂ કરો.</entry>
 <entry><media id="eip-id1168466179681" alt="આછા વાદળી રંગનાં પાંચ વર્તુળ આડી હરોળમાં છે અને વચ્ચેના વર્તુળની નીચે 5 લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_027_img-01.png" /></media></entry>
 </row>
 <row>
 <entry>બીજી સંખ્યા દૂર કરો. એટલે 3 ધન કાઉન્ટર દૂર કરો.</entry>
 <entry><media id="eip-id1168466034874" alt="આછા વાદળી રંગનાં ચાર વર્તુળ ગુલાબી અંડાકાર અને ડાબી તરફના તીરથી ઘેરેલાં છે. સમૂહની નીચે “2 ધન” લખેલું છે, જે કદાચ ચાર વર્તુળમાંથી કોઈ ગણતરી કે પસંદગી દર્શાવે છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_027_img-02.png" /></media></entry>
 </row>
 <row>
 <entry>બાકી રહેલા કાઉન્ટર શોધો.</entry>
 <entry><media id="eip-id1168466034890" alt="સફેદ પૃષ્ઠભૂમિ પર આછા વાદળી રંગનાં બે વર્તુળ બાજુબાજુ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_027_img-03.png" /></media></entry>
 </row>
 <row>
  <entry />
  <entry><m:math><m:mn>5</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>2</m:mn></m:math>.<newline />આ સંખ્યાઓનો તફાવત: <m:math><m:mn>5</m:mn></m:math> અને <m:math><m:mn>3</m:mn></m:math> છે <m:math><m:mn>2</m:mn></m:math>.</entry>
 </row>

</tbody>







</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id1726350" class="try">
<exercise id="fs-id1603740">
<problem id="fs-id1345685">
<para id="fs-id2420886">પદાવલીને નમૂના દ્વારા દર્શાવો:</para><para id="fs-id1227302"><m:math><m:mrow><m:mn>6</m:mn><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1739650">
<para id="fs-id1171104076304"><newline />
<media id="fs-id2325658" alt="આકૃતિમાં આછા ગુલાબી રંગના 6 ધન કાઉન્ટરની હરોળ છે. પહેલા ચાર કાઉન્ટર ઘેરેલા છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_003_img.jpg" />
</media><newline />2</para>
</solution>
</exercise>
</note>
<note id="fs-id1171103093029" class="try">
<exercise id="fs-id1612031">
<problem id="fs-id1805508">
<para id="fs-id1171101122579">પદાવલીને નમૂના દ્વારા દર્શાવો:</para><para id="fs-id1841686"><m:math><m:mrow><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id3002191">
<para id="fs-id1171103099745"><newline />
<media id="fs-id1178811" alt="આકૃતિમાં આછા ગુલાબી રંગના 7 ધન કાઉન્ટરની હરોળ છે. પહેલા ચાર કાઉન્ટર ઘેરેલા છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_004_img.jpg" />
</media><newline />3</para>
</solution>
</exercise>
</note>
<example id="fs-id1258440">
<exercise id="fs-id1178377"><problem id="fs-id1384723">
<para id="fs-id1281578">નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>−5</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−3</m:mn><m:mo stretchy="false">)</m:mo><m:mtext>.</m:mtext></m:mrow></m:math></para>
</problem>
<solution id="fs-id2835532">
<title>ઉકેલ</title>
<table id="eip-id1168469693755" class="unnumbered unstyled" aria-label="આકૃતિમાં પાંચ હરોળ છે. પહેલી હરોળ પદાવલીનો અર્થ સમજવાનું કહે છે. પછી 5 ઓછા ઋણ 3 એટલે 5માંથી ઋણ 3 દૂર કરો એમ લખેલું છે. બીજી હરોળ પ્રથમ સંખ્યાનો નમૂનો બનાવી 5 ઋણ કાઉન્ટરથી શરૂ કરવાનું કહે છે. પછી 5 લાલ વર્તુળ છે. ત્રીજી હરોળ બીજી સંખ્યા દૂર કરવાનું, એટલે 3 ઋણ કાઉન્ટર દૂર કરવાનું કહે છે. પછી 5 લાલ વર્તુળ છે, જેમાં પહેલા ત્રણ ઘેરેલાં છે. ચોથી હરોળ બાકી રહેલા કાઉન્ટરની સંખ્યા શોધવાનું કહે છે. પછી 2 લાલ વર્તુળ છે અને તેમનું નામ બે ઋણ આપેલું છે. પાંચમી હરોળ કહે છે કે ઋણ 5 અને ઋણ 3નો તફાવત ઋણ 2 છે. તેની બાજુમાં પદાવલી ઋણ 5 ઓછા ઋણ 3 બરાબર ઋણ બે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry>પદાવલીનો અર્થ સમજો.</entry>
   <entry><m:math><m:mn>−5</m:mn><m:mo>−</m:mo><m:mo>(</m:mo><m:mn>−3</m:mn><m:mo>)</m:mo></m:math> એટલે <m:math><m:mn>−5</m:mn></m:math> માંથી દૂર કરો <m:math><m:mn>−3</m:mn></m:math>.</entry>
 </row>
 <row>
 <entry>પ્રથમ સંખ્યાનો નમૂનો બનાવો. 5 ઋણ કાઉન્ટરથી શરૂ કરો.</entry>
 <entry><media id="eip-id1168466276232" alt="લાલ રંગનાં પાંચ વર્તુળ હરોળમાં છે અને વચ્ચેના વર્તુળોની નીચે −5 લખેલું છે; આ ઋણ પાંચ પૂર્ણાંકનું દૃશ્યરૂપ દર્શાવે છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_028_img-01.png" /></media></entry>
 </row>
 <row>
 <entry>બીજી સંખ્યા દૂર કરો. એટલે 3 ઋણ કાઉન્ટર દૂર કરો.</entry>
 <entry><media id="eip-id1168466710901" alt="ચિત્રમાં ચાર લાલ વર્તુળની હરોળ છે. પહેલા ત્રણ વર્તુળ જાંબલી અંડાકાર અને તીરથી ઘેરેલાં છે. ચોથા વર્તુળની નીચે “2 ઋણ” લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_028_img-02.png" /></media></entry>
 </row>
 <row>
 <entry>બાકી રહેલા કાઉન્ટરની સંખ્યા શોધો.</entry>
 <entry><media id="eip-id1168466710918" alt="સફેદ પૃષ્ઠભૂમિ પર ઘેરી લાલ કિનારીવાળાં બે આછા લાલ વર્તુળ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_028_img-03.png" /></media></entry>
 </row>
 <row>
  <entry />
  <entry><m:math><m:mn>−5</m:mn><m:mo>−</m:mo><m:mo>(</m:mo><m:mn>−3</m:mn><m:mo>)</m:mo><m:mo>=</m:mo><m:mn>−2</m:mn></m:math>.<newline />આ સંખ્યાઓનો તફાવત: <m:math><m:mn>−5</m:mn></m:math> અને <m:math><m:mn>−3</m:mn></m:math> છે <m:math><m:mn>−2</m:mn></m:math>.</entry>
 </row>

</tbody>

</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id2582882" class="try">
<exercise id="fs-id1515819">
<problem id="fs-id1886243">
<para id="fs-id2874394">પદાવલીને નમૂના દ્વારા દર્શાવો:</para><para id="fs-id1560411"><m:math><m:mrow><m:mn>−6</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1281168">
<para id="fs-id1171104040685"><newline />
<media id="fs-id2817252" alt="આકૃતિમાં ઘેરા ગુલાબી રંગના 6 ઋણ કાઉન્ટરની હરોળ છે. છેલ્લા ચાર કાઉન્ટર ઘેરેલા છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_008_img.jpg" />
</media><newline />−2</para>
</solution>
</exercise>
</note>
<note id="fs-id1171104121231" class="try">
<exercise id="fs-id2485716">
<problem id="fs-id2590492">
<para id="fs-id1171103994837">પદાવલીને નમૂના દ્વારા દર્શાવો:</para><para id="fs-id1622397"><m:math><m:mrow><m:mn>−7</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1217820">
<para id="fs-id1171100586132"><newline />
<media id="fs-id2741558" alt="આકૃતિમાં ઘેરા ગુલાબી રંગના 7 ઋણ કાઉન્ટરની હરોળ છે. પહેલા ચાર કાઉન્ટર ઘેરેલા છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_009_img.jpg" />
</media><newline />−3</para>
</solution>
</exercise>
</note>
<para id="fs-id2140325">ધ્યાન આપો કે <link target-id="fs-id2204811" /> અને <link target-id="fs-id1258440" /> ખૂબ સરખાં છે.</para>
<list id="fs-id801766" list-type="bulleted" bullet-style="bullet">
<item>પહેલા આપણે <m:math><m:mrow><m:mn>3</m:mn></m:mrow></m:math> ધન કાઉન્ટરને <m:math><m:mrow><m:mn>5</m:mn></m:mrow></m:math> ધન કાઉન્ટરમાંથી દૂર કરીને <m:math><m:mrow><m:mn>2</m:mn></m:mrow></m:math> ધન કાઉન્ટર મેળવ્યા.</item>
<item>પછી આપણે <m:math><m:mrow><m:mn>3</m:mn></m:mrow></m:math> ઋણ કાઉન્ટરને <m:math><m:mrow><m:mn>5</m:mn></m:mrow></m:math> ઋણ કાઉન્ટરમાંથી દૂર કરીને <m:math><m:mrow><m:mn>2</m:mn></m:mrow></m:math> ઋણ કાઉન્ટર મેળવ્યા.</item>
</list>
<para id="fs-id2190681">દરેક ઉદાહરણમાં માત્ર એક જ રંગના કાઉન્ટર વપરાયા હતા, તેથી બાદબાકી માટેની “દૂર કરો” રીત સહેલાઈથી લાગુ પડી.</para>
<media id="fs-id2649025" alt="આકૃતિમાં 5 વાદળી વર્તુળની હરોળ છે. પહેલા ત્રણ ઘેરેલાં છે. હરોળની ઉપર 5 ઓછા 3 બરાબર 2 છે. તેની બાજુમાં 5 લાલ વર્તુળની હરોળ છે. પહેલા ત્રણ ઘેરેલાં છે. તેની ઉપર ઋણ 5 ઓછા ઋણ 3 બરાબર ઋણ 2 છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_040_img.jpg" />
</media>
<para id="fs-id1302220">હવે એક ધન અને એક ઋણ સંખ્યાની બાદબાકી કરીએ ત્યારે શું થાય છે તે જોઈએ. ધન અને ઋણ બંને કાઉન્ટર તથા કેટલીક વાર શૂન્ય બનાવતી કેટલીક જોડીઓ પણ વાપરવી પડશે. એક <term class="no-emphasis" id="term-00001">શૂન્ય બનાવતી જોડી</term> ઉમેરવાથી મૂલ્ય બદલાતું નથી.</para>
<example id="fs-id1546649">
<exercise id="fs-id1466526"><problem id="fs-id2655657">
<para id="fs-id1371532">નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>−5</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1355787">
<title>ઉકેલ</title>
<table id="eip-id1168468477542" class="unnumbered unstyled" aria-label="આકૃતિમાં સાત હરોળ છે. પહેલી હરોળ પદાવલીનો અર્થ સમજવાનું કહે છે. પછી ઋણ 5 ઓછા 3 એટલે ઋણ 5માંથી 3 દૂર કરો એમ લખેલું છે. બીજી હરોળ પ્રથમ સંખ્યાનો નમૂનો બનાવી 5 ઋણ કાઉન્ટરથી શરૂ કરવાનું કહે છે. પછી 5 લાલ વર્તુળ છે. ત્રીજી હરોળ બીજી સંખ્યા દૂર કરવાનું કહે છે, એટલે આપણે 3 ધન કાઉન્ટર દૂર કરવા છે. પછી 5 લાલ વર્તુળની હરોળ અને તેની બાજુમાં 3 લાલ વર્તુળ છે. આ ત્રણ લાલ વર્તુળની નીચે 3 વાદળી વર્તુળ છે. ચોથી હરોળ કહે છે કે દૂર કરવા કોઈ ધન કાઉન્ટર નથી, તેથી 3 ધન કાઉન્ટર મળે ત્યાં સુધી શૂન્ય બનાવતી જોડીઓ ઉમેરો. પાંચમી હરોળ હવે ત્રણ ધન કાઉન્ટર દૂર કરવાનું કહે છે. પછી 5 લાલ વર્તુળની હરોળ અને તેની બાજુમાં 3 લાલ વર્તુળ છે. આ ત્રણ લાલ વર્તુળની નીચે 3 વાદળી વર્તુળ છે. વાદળી વર્તુળ ઘેરેલાં છે. છઠ્ઠી હરોળ બાકી રહેલા કાઉન્ટરની સંખ્યા ગણવાનું કહે છે. પછી 8 લાલ વર્તુળ છે. સાતમી હરોળ કહે છે કે ઋણ પાંચ અને ત્રણનો તફાવત ઋણ 8 છે. પછી પદાવલી ઋણ 5 ઓછા 3 બરાબર ઋણ 8 છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry>પદાવલીનો અર્થ સમજો.</entry>
   <entry><m:math><m:mn>−5</m:mn><m:mo>−</m:mo><m:mn>3</m:mn></m:math> એટલે <m:math><m:mn>−5</m:mn></m:math> માંથી દૂર કરો <m:math><m:mn>3</m:mn></m:math>.</entry>
 </row>
 <row>
 <entry>પ્રથમ સંખ્યાનો નમૂનો બનાવો. 5 ઋણ કાઉન્ટરથી શરૂ કરો.</entry>
 <entry><media id="eip-id1168468683954" alt="ઘેરી લાલ કિનારીવાળાં પાંચ આછાં લાલ વર્તુળ આડી હરોળમાં છે અને ડાબેથી ત્રીજા વર્તુળની નીચે −5 લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_029_img-01.png" /></media></entry>
 </row>
 <row>
 <entry>બીજી સંખ્યા દૂર કરો.<newline />એટલે આપણે 3 ધન કાઉન્ટર દૂર કરવાના છે.</entry>
<entry />
</row>
<row>
<entry>પરંતુ દૂર કરવા માટે કોઈ ધન કાઉન્ટર નથી.<newline />3 ધન કાઉન્ટર મળે ત્યાં સુધી શૂન્ય બનાવતી જોડીઓ ઉમેરો.</entry>
 <entry><media id="eip-id1168468437857" alt="આઠ લાલ અને ત્રણ આછા વાદળી વર્તુળ છે. ડાબે પાંચ લાલ વર્તુળ અને જમણે ત્રણ લાલ વર્તુળની નીચે ત્રણ વાદળી વર્તુળ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_029_img-02.png" /></media></entry>
 </row>
 <row>
 <entry>હવે 3 ધન કાઉન્ટર દૂર કરો.</entry>
 <entry><media id="eip-id1168469754368" alt="બાદબાકીનું ચિત્ર છે. લાલ વર્તુળના મોટા સમૂહની નીચેનાં ત્રણ વાદળી વર્તુળ અંડાકાર અને તીરથી ઘેરેલાં છે અને તેમને દૂર કરવાનું દર્શાવે છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_029_img-03.png" /></media></entry>
 </row>
 <row>
 <entry>બાકી રહેલા કાઉન્ટરની સંખ્યા ગણો.</entry>
 <entry><media id="eip-id1168467148860" alt="ઘેરી લાલ કિનારીવાળાં આછાં લાલ આઠ વર્તુળની હરોળ છે. તેમની નીચે ઘેરા વાદળી રંગે “8 ઋણ” લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_029_img-04.png" /></media></entry>
 </row>
 <row>
  <entry />
  <entry><m:math><m:mn>−5</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>=</m:mo><m:mn>−8</m:mn></m:math>.<newline />આ સંખ્યાઓનો તફાવત: <m:math><m:mn>−5</m:mn></m:math> અને <m:math><m:mn>3</m:mn></m:math> છે <m:math><m:mn>−8</m:mn></m:math>.</entry>
 </row>

</tbody>
</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id2481763" class="try">
<exercise id="fs-id2751476">
<problem id="fs-id3323891">
<para id="fs-id1169851">પદાવલીને નમૂના દ્વારા દર્શાવો:</para><para id="fs-id1597847"><m:math><m:mrow><m:mn>−6</m:mn><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1798586">
<para id="fs-id1171104079337"><newline />
<media id="fs-id2281527" alt="આકૃતિમાં ઘેરા ગુલાબી રંગના 10 ઋણ કાઉન્ટરની હરોળ છે; પહેલા છ અને છેલ્લા ચાર વચ્ચે અંતર છે. છેલ્લા ચારની નીચે આછા ગુલાબી રંગના ચાર ધન કાઉન્ટર છે અને આ ચાર ધન કાઉન્ટર ઘેરેલા છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_012_img.jpg" />
</media><newline />−10</para>
</solution>
</exercise>
</note>
<note id="fs-id1171104037759" class="try">
<exercise id="fs-id1633735">
<problem id="fs-id998948">
<para id="fs-id1171104037878">પદાવલીને નમૂના દ્વારા દર્શાવો:</para><para id="fs-id1474800"><m:math><m:mrow><m:mn>−7</m:mn><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1264998">
<para id="fs-id1171104073662"><newline />
<media id="fs-id2420172" alt="આકૃતિમાં ઘેરા ગુલાબી રંગના 11 ઋણ કાઉન્ટરની હરોળ છે; પહેલા સાત અને છેલ્લા ચાર વચ્ચે અંતર છે. છેલ્લા ચારની નીચે આછા ગુલાબી રંગના ચાર ધન કાઉન્ટર છે અને આ ચાર ધન કાઉન્ટર ઘેરેલા છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_013_img.jpg" />
</media><newline />−11</para>
</solution>
</exercise>
</note>
<example id="fs-id1048785">
<exercise id="fs-id1407878"><problem id="fs-id1595962">
<para id="fs-id2370203">નમૂના દ્વારા દર્શાવો: <m:math><m:mrow><m:mn>5</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−3</m:mn><m:mo stretchy="false">)</m:mo><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1971800">
<title>ઉકેલ</title>
<table id="eip-id1168467234371" class="unnumbered unstyled" aria-label="આકૃતિમાં સાત હરોળ છે. પહેલી હરોળ પદાવલીનો અર્થ સમજવાનું કહે છે. પછી 5 ઓછા ઋણ 3 એટલે 5માંથી ઋણ 3 દૂર કરો એમ લખેલું છે. બીજી હરોળ પ્રથમ સંખ્યાનો નમૂનો બનાવી 5 ધન કાઉન્ટરથી શરૂ કરવાનું કહે છે. પછી 5 વાદળી વર્તુળ છે. ત્રીજી હરોળ બીજી સંખ્યા દૂર કરવાનું કહે છે, એટલે આપણે 3 ઋણ કાઉન્ટર દૂર કરવા છે. પછી 5 વાદળી વર્તુળની હરોળ અને તેની બાજુમાં 3 વાદળી વર્તુળ છે. આ ત્રણ વાદળી વર્તુળની નીચે 3 લાલ વર્તુળ છે. ચોથી હરોળ કહે છે કે દૂર કરવા કોઈ ઋણ કાઉન્ટર નથી, તેથી 3 ઋણ કાઉન્ટર મળે ત્યાં સુધી શૂન્ય બનાવતી જોડીઓ ઉમેરો. પાંચમી હરોળ હવે ત્રણ ઋણ કાઉન્ટર દૂર કરવાનું કહે છે. પછી 5 વાદળી વર્તુળની હરોળ અને તેની બાજુમાં 3 વાદળી વર્તુળ છે. આ ત્રણ વાદળી વર્તુળની નીચે 3 લાલ વર્તુળ છે. લાલ વર્તુળ ઘેરેલાં છે. છઠ્ઠી હરોળ બાકી રહેલા કાઉન્ટરની સંખ્યા ગણવાનું કહે છે. પછી 8 વાદળી વર્તુળ છે. સાતમી હરોળ કહે છે કે 5 અને ઋણ 3નો તફાવત આઠ છે અને તેની બાજુમાં પદાવલી 5 ઓછા ઋણ 3 બરાબર આઠ છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry>પદાવલીનો અર્થ સમજો.</entry>
   <entry><m:math><m:mn>5</m:mn><m:mo>−</m:mo><m:mo>(</m:mo><m:mn>−3</m:mn><m:mo>)</m:mo></m:math> એટલે <m:math><m:mn>5</m:mn></m:math> માંથી દૂર કરો <m:math><m:mn>−3</m:mn></m:math>.</entry>
 </row>
 <row>
 <entry>પ્રથમ સંખ્યાનો નમૂનો બનાવો. 5 ધન કાઉન્ટરથી શરૂ કરો.</entry>
 <entry><media id="eip-id1168468391750" alt="ઘેરી વાદળી કિનારીવાળાં પાંચ આછાં વાદળી વર્તુળ સફેદ પૃષ્ઠભૂમિ પર આડી હરોળમાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_030_img-01.png" /></media></entry>
 </row>
 <row>
 <entry>બીજી સંખ્યા દૂર કરો, એટલે 3 ઋણ કાઉન્ટર દૂર કરો.</entry>
 <entry />
 </row>
 <row>
 <entry>પરંતુ દૂર કરવા માટે કોઈ ઋણ કાઉન્ટર નથી.<newline />3 ઋણ કાઉન્ટર મળે ત્યાં સુધી શૂન્ય બનાવતી જોડીઓ ઉમેરો.</entry>
 <entry><media id="eip-id1168468596582" alt="સફેદ પૃષ્ઠભૂમિ પર આઠ આછાં વાદળી અને ત્રણ લાલ વર્તુળ બે હરોળમાં, સમૂહો વચ્ચે અંતર રાખીને ગોઠવેલાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_030_img-02.png" /></media></entry>
 </row>
 <row>
 <entry>પછી 3 ઋણ કાઉન્ટર દૂર કરો.</entry>
 <entry><media id="eip-id1168468753977" alt="ત્રણ લાલ વર્તુળ જાંબલી અંડાકાર અને તીરથી ઘેરેલાં છે. તેઓ સાત આછાં વાદળી વર્તુળમાંથી ત્રણની નીચે છે અને દૂર થતો જથ્થો દર્શાવે છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_030_img-03.png" /></media></entry>
 </row>
 <row>
 <entry>બાકી રહેલા કાઉન્ટરની સંખ્યા ગણો.</entry>
 <entry><media id="eip-id1168468413201" alt="ઘેરી વાદળી કિનારીવાળાં આછાં વાદળી આઠ વર્તુળની હરોળ છે અને તેની નીચે “8 ધન” લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_030_img-04.png" /></media></entry>
 </row>
 <row>
 <entry />
 <entry>આ સંખ્યાઓનો તફાવત: <m:math><m:mn>5</m:mn></m:math> અને <m:math><m:mn>−3</m:mn></m:math> છે <m:math><m:mn>8</m:mn></m:math>.<newline /><m:math><m:mn>5</m:mn><m:mo>−</m:mo><m:mo>(</m:mo><m:mn>−3</m:mn><m:mo>)</m:mo><m:mo>=</m:mo><m:mn>8</m:mn></m:math></entry>
 </row>

</tbody>







</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id2472624" class="try">
<exercise id="fs-id1823049">
<problem id="fs-id1524047">
<para id="fs-id2363014">પદાવલીને નમૂના દ્વારા દર્શાવો:</para><para id="fs-id2876700"><m:math><m:mrow><m:mn>6</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1374360">
<para id="fs-id1171103099861"><newline />
<media id="fs-id2439874" alt="આકૃતિમાં આછા ગુલાબી રંગના 10 ધન કાઉન્ટરની હરોળ છે; પહેલા છ અને છેલ્લા ચાર વચ્ચે અંતર છે. છેલ્લા ચારની નીચે ઘેરા ગુલાબી રંગના ચાર ઋણ કાઉન્ટર છે અને આ ચાર ઋણ કાઉન્ટર ઘેરેલા છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_016_img.jpg" />
</media><newline />10</para></solution>
</exercise>
</note>
<note id="fs-id1171103123344" class="try">
<exercise id="fs-id1961677">
<problem id="fs-id769961">
<para id="fs-id1171103961935">પદાવલીને નમૂના દ્વારા દર્શાવો:</para><para id="fs-id3402467"><m:math><m:mrow><m:mn>7</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2454542">
<para id="fs-id1171103052760"><newline />
<media id="fs-id1471821" alt="આકૃતિમાં આછા ગુલાબી રંગના 11 ધન કાઉન્ટરની હરોળ છે; પહેલા સાત અને છેલ્લા ચાર વચ્ચે અંતર છે. છેલ્લા ચારની નીચે ઘેરા ગુલાબી રંગના ચાર ઋણ કાઉન્ટર છે અને આ ચાર ઋણ કાઉન્ટર ઘેરેલા છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_017_img.jpg" />
</media><newline />11</para>
</solution>
</exercise>
</note>
<example id="eip-742"><exercise id="eip-289"><problem id="eip-623">
  <para id="eip-530">દરેક બાદબાકીને નમૂના દ્વારા દર્શાવો. <newline />
<list id="eip-id1168466165064" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span>  8 − 2 </item>
<item><span class="token">ⓑ</span> −5 − 4</item>
<item><span class="token">ⓒ</span> 6 − (−6) </item>
<item><span class="token">ⓓ</span> −8 − (−3)</item></list></para></problem>

<solution id="eip-648">
<table id="eip-id1168468308805" class="unnumbered unstyled" summary="આ કોષ્ટક 8 − 2 બાદબાકીનો પ્રશ્ન પગલે પગલે ઉકેલવાની પ્રક્રિયા દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓐ</span> </entry>
   <entry />
   </row>
   <row>
   <entry />
   <entry align="center"><m:math><m:mn>8</m:mn><m:mo>−</m:mo><m:mn>2</m:mn></m:math><newline />આનો અર્થ છે <m:math><m:mn>8</m:mn></m:math> માંથી દૂર કરો <m:math><m:mn>2</m:mn></m:math>.</entry>
 </row>
 <row>
 <entry>8 ધન કાઉન્ટરથી શરૂ કરો.</entry>
  <entry><media id="eip-id1168468282347" alt="સફેદ પૃષ્ઠભૂમિ પર આછાં વાદળી, પાતળી વાદળી કિનારી અને છાયાવાળાં આઠ વર્તુળ આડી હરોળમાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_041_img-01.png" /></media></entry>
 </row>
 <row>
 <entry>2 ધન કાઉન્ટર દૂર કરો.</entry>
  <entry><media id="eip-id1168467258669" alt="હરોળમાંનાં પહેલા બે આછાં વાદળી વર્તુળ જાંબલી અંડાકારથી ઘેરેલાં છે અને વળેલો તીર તેમની તરફ પાછો ચીંધે છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_041_img-02.png" /></media></entry>
 </row>
 <row>
 <entry>કેટલા બાકી રહ્યા?</entry>
 <entry align="center"><m:math><m:mn>6</m:mn></m:math></entry>
</row>
<row>
<entry />
<entry align="center"><m:math><m:mn>8</m:mn><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>=</m:mo><m:mn>6</m:mn></m:math></entry>
 </row>

</tbody>






</tgroup>
</table><table id="eip-id1168466328467" class="unnumbered unstyled" summary="ચકતીના નમૂના વડે −5 − 4 ગણવાનાં પગલાં દર્શાવતું પૂર્ણાંકોની બાદબાકીનું દૃશ્યરૂપ."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓑ</span> </entry>
<entry />
</row>
<row>
<entry />
   <entry align="center"><m:math><m:mn>−5</m:mn><m:mo>−</m:mo><m:mn>4</m:mn></m:math><newline />આનો અર્થ છે <m:math><m:mn>−5</m:mn></m:math> માંથી દૂર કરો <m:math><m:mn>4</m:mn></m:math>.</entry>
 </row>
 <row>
 <entry>5 ઋણ કાઉન્ટરથી શરૂ કરો.</entry>
<entry><media id="eip-id1168467452836" alt="ઘેરી લાલ કિનારીવાળાં પાંચ આછાં લાલ વર્તુળ સફેદ પૃષ્ઠભૂમિ પર આડી હરોળમાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_042_img-01.png" /></media></entry>
</row>
<row>
<entry>તમારે 4 ધન કાઉન્ટર દૂર કરવાના છે.<newline />4 ધન કાઉન્ટર મેળવવા શૂન્ય બનાવતી 4 જોડીઓ ઉમેરો.</entry>
<entry><media id="eip-id1168467162583" alt="ઘેરી લાલ કિનારીવાળાં આઠ આછાં લાલ વર્તુળ પાંચ અને ત્રણના બે સમૂહમાં ગોઠવેલાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_042_img-02.png" /></media><newline /><media id="eip-id1168466276883" alt="સફેદ પૃષ્ઠભૂમિ પર વાદળી કિનારીવાળાં ચાર આછાં વાદળી વર્તુળ આડી હરોળમાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_042_img-03.png" /></media></entry>
</row>

 <row>
 <entry>4 ધન કાઉન્ટર દૂર કરો.</entry>
  <entry><media id="eip-id1168466276901" alt="ઉપર બતાવેલાં સાત લાલ વર્તુળમાંથી ચારની નીચે આવેલાં ચાર આછાં વાદળી વર્તુળ ગુલાબી અંડાકાર અને તીરથી ઘેરેલાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_042_img-04.png" /></media></entry>
 </row>
 <row>
 <entry>કેટલા બાકી રહ્યા?</entry>
 <entry><media id="eip-id1168466276918" alt="લાલ કિનારીવાળાં આછાં ગુલાબી નવ વર્તુળ આડી હરોળમાં છે; ડાબે પાંચ અને જમણે ચારના સમૂહ વચ્ચે થોડું અંતર છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_042_img-05.png" /></media></entry>
 </row>
 <row>
 <entry />
 <entry align="center"><m:math><m:mn>−9</m:mn></m:math></entry>
 </row>
<row>
 <entry />
 <entry align="center"><m:math><m:mn>−5</m:mn><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>=</m:mo><m:mn>−9</m:mn></m:math></entry>
 </row>

</tbody>









</tgroup>
</table><table id="eip-id1168469609690" class="unnumbered unstyled" summary="ધન અને ઋણ પૂર્ણાંકનાં દૃશ્યરૂપો વડે 6 − (−6) ગણવાની પગલે પગલે પ્રક્રિયા."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓒ</span> </entry>
<entry />
</row>
<row>
<entry />
   <entry align="center"><m:math><m:mn>6</m:mn><m:mo>−</m:mo><m:mo>(</m:mo><m:mn>−6</m:mn><m:mo>)</m:mo></m:math><newline />આનો અર્થ છે <m:math><m:mn>6</m:mn></m:math> માંથી દૂર કરો <m:math><m:mn>−6</m:mn></m:math>.</entry>
 </row>
 <row>
 <entry>6 ધન કાઉન્ટરથી શરૂ કરો.</entry>
  <entry><media id="eip-id1168466089141" alt="ઘેરી વાદળી કિનારીવાળાં પાંચ આછાં વાદળી વર્તુળ સફેદ પૃષ્ઠભૂમિ પર આડી હરોળમાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_043_img-01.png" /></media></entry>
 </row>
<row>
<entry>દૂર કરવા માટે 6 ઋણ કાઉન્ટર મળે એ માટે શૂન્ય બનાવતી 6 જોડીઓ ઉમેરો.</entry>
<entry><media id="eip-id1168468468816" alt="વર્તુળની બે હરોળ છે. ઉપરની હરોળમાં 10 આછાં વાદળી વર્તુળ અને તેની નીચે જમણી બાજુએ 6 લાલ વર્તુળ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_043_img-02.png" /></media></entry>
</row>
 <row>
 <entry>6 ઋણ કાઉન્ટર દૂર કરો.</entry>
  <entry><media id="eip-id1168466089158" alt="આકૃતિમાં આછાં વાદળી અગિયાર વર્તુળની હરોળ છે અને તેની નીચે સીધાં પાંચ લાલ વર્તુળ છે. લાલ વર્તુળોને જાંબલી અંડાકાર ઘેરે છે અને અંદરનો વળેલો તીર ડાબી તરફ ચીંધે છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_043_img-03.png" /></media></entry>
 </row>
 <row>
 <entry>કેટલા બાકી રહ્યા?</entry>
 <entry><media id="eip-id1168466645271" alt="સફેદ પૃષ્ઠભૂમિ પર પાતળી વાદળી કિનારીવાળાં આછાં વાદળી અગિયાર વર્તુળની આડી હરોળ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_043_img-04.png" /></media></entry>
 </row>
 <row>
<entry />
<entry align="center"><m:math><m:mn>12</m:mn></m:math></entry>
</row>
 <row>
 <entry />
 <entry align="center"><m:math><m:mn>6</m:mn><m:mo>−</m:mo><m:mo>(</m:mo><m:mn>−6</m:mn><m:mo>)</m:mo><m:mo>=</m:mo><m:mn>12</m:mn></m:math></entry>
  </row>
</tbody>











</tgroup>
</table><table id="eip-id1168468534936" class="unnumbered unstyled" summary="ચિત્રો અને ગાણિતિક લખાવટ વડે −3ને −8માંથી બાદ કરવાની પગલે પગલે દૃશ્ય રીત."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓓ</span> </entry>
<entry />
</row>
<row>
<entry />
   <entry align="center"><m:math><m:mn>−8</m:mn><m:mo>−</m:mo><m:mo>(</m:mo><m:mn>−3</m:mn><m:mo>)</m:mo></m:math><newline />આનો અર્થ છે <m:math><m:mn>−8</m:mn></m:math> માંથી દૂર કરો <m:math><m:mn>−3</m:mn></m:math>.</entry>
 </row>
 <row>
 <entry>8 ઋણ કાઉન્ટરથી શરૂ કરો.</entry>
  <entry><media id="eip-id1168468552724" alt="આછાં લાલ, લાલ કિનારીવાળાં આઠ વર્તુળ હરોળમાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_044_img-01.png" /></media></entry>
 </row>
 <row>
 <entry>3 ઋણ કાઉન્ટર દૂર કરો.</entry>
  <entry><media id="eip-id1168468400395" alt="લાલ રંગનાં આઠ વર્તુળની હરોળમાં પહેલાં ત્રણને જાંબલી અંડાકાર ઘેરે છે અને અંડાકારનો તીર ડાબી તરફ વળે છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_044_img-02.png" /></media></entry>
 </row>
 <row>
 <entry>કેટલા બાકી રહ્યા?</entry>
 <entry><media id="eip-id1168468457178" alt="સફેદ પૃષ્ઠભૂમિ પર ઘેરી લાલ કિનારીવાળાં પાંચ સરખાં આછાં લાલ વર્તુળ આડી હરોળમાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_044_img-03.png" /></media></entry>
</row>
<row>
<entry />
<entry align="center"><m:math><m:mn>−5</m:mn></m:math></entry>
 </row>
<row>
<entry />
<entry align="center"><m:math><m:mn>−8</m:mn><m:mo>−</m:mo><m:mo>(</m:mo><m:mn>−3</m:mn><m:mo>)</m:mo><m:mo>=</m:mo><m:mn>−5</m:mn></m:math></entry>
  </row>
</tbody>




</tgroup>
</table></solution>
</exercise></example>

<note id="eip-id1168467202301" class="try"><exercise id="eip-id1168468751474"><problem id="eip-id1168468751475"><para id="eip-id1168468751476">દરેક બાદબાકીને નમૂના દ્વારા દર્શાવો.<newline />
<list id="eip-id1168466363427" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> 7 - (-8)</item>
<item><span class="token">ⓑ</span> -7 - (-2) </item>
<item><span class="token">ⓒ</span> 4 - 1 </item>
<item><span class="token">ⓓ</span> -6 - 8 </item></list></para></problem>
<solution id="eip-id1168468751481">
<para id="eip-id1168468751483"><span class="token">ⓐ</span> <newline />
<media id="eip-id1168469608120" alt="આકૃતિમાં વર્તુળની બે હરોળ છે. નીચેની હરોળનાં સાત ઘેરા રાખોડી વર્તુળ અંડાકાર અને ડાબી તરફના તીરથી ઘેરેલાં છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_045_img.jpg" /></media><newline />
<span class="token">ⓑ</span> <newline />
<media id="eip-id1168469608133" alt="સાત રાખોડી વર્તુળની હરોળમાં છેલ્લા બે વર્તુળ એકસાથે ઘેરેલાં છે અને તીર તેમને પાછો ચીંધે છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_046_img.jpg" /></media><newline />
<span class="token">ⓒ</span> <newline />
<media id="eip-id1168469608146" alt="ચાર રાખોડી વર્તુળની હરોળમાં એક વર્તુળને ગોળ તીર ઘેરીને ચીંધે છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_047_img.jpg" /></media><newline />
<span class="token">ⓓ</span> <newline />
<media id="eip-id1168469608158" alt="7 આછાં રાખોડી વર્તુળની હરોળ અંડાકાર અને વળેલા તીરથી ઘેરેલી છે. તેની ઉપર ઘેરા રાખોડી વર્તુળની બે હરોળ છે અને દરેકમાં 7 વર્તુળ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_048_img.jpg" /></media></para></solution>
</exercise></note><note id="eip-id1168467202308" class="try"><exercise id="eip-id1168467255400"><problem id="eip-id1168467255401"><para id="eip-id1168467255402">દરેક બાદબાકીને નમૂના દ્વારા દર્શાવો.<newline />
<list id="eip-id1168469422020" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> 4 - (-6) </item>
<item><span class="token">ⓑ</span> -8 - (-1) </item>
<item><span class="token">ⓒ</span> 7 - 3 </item>
<item><span class="token">ⓓ</span>  -4 - 2  </item></list></para></problem>
<solution id="eip-id1168467255407">
<para id="eip-id1168467255410"><span class="token">ⓐ</span> <newline />
<media id="eip-id1168467255414" alt="ઉપરની હરોળમાં દસ આછાં રાખોડી વર્તુળ છે, જે ચાર અને છના સમૂહમાં જુદાં છે. નીચે છ ઘેરા રાખોડી વર્તુળ છે, જેમને અંડાકાર ઘેરે છે અને નીચે વળેલો તીર છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_049_img.jpg" /></media><newline />
<span class="token">ⓑ</span> <newline />
<media id="eip-id1168467255428" alt="આઠ અવસ્થાવાળું સીમિત સ્વયંસંચાલિત યંત્ર દર્શાવેલું છે. છેલ્લી અવસ્થાની પોતાની તરફ પાછી આવતી કડી છે, જે ઘણી વાર સ્વીકારતી અથવા અંતિમ અવસ્થા દર્શાવે છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_050_img.jpg" /></media><newline />
<span class="token">ⓒ</span> <newline />
<media id="eip-id1168467255442" alt="રાખોડી વર્તુળની શ્રેણીમાં છેલ્લાં ત્રણ વર્તુળ અંડાકાર અને પાછા ફરતા તીરથી ઘેરેલાં છે. પહેલા ચાર વર્તુળ પછી ચક્રમાં આવતાં ત્રણ વર્તુળ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_051_img.jpg" /></media><newline />
<span class="token">ⓓ</span> <newline />
<media id="eip-id1168467255455" alt="ઘેરા રાખોડી વર્તુળની હરોળની નીચે બે આછાં રાખોડી વર્તુળ છે; તેમને અંડાકાર અને ડાબી તરફના વળેલા તીરથી ઘેરેલાં છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_052_img.jpg" /></media></para></solution>
</exercise></note><example id="fs-id2576870">
<exercise id="fs-id2582897"><problem id="fs-id1733112">
<para id="fs-id1726587">દરેક બાદબાકીની પદાવલીને નમૂના દ્વારા દર્શાવો:</para>
<list id="eip-id1168468264062" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn> 2</m:mn><m:mo>−</m:mo><m:mn>8</m:mn></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mn>−3</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−8</m:mn><m:mo stretchy="false">)</m:mo></m:math></item></list></problem>
<solution id="fs-id2146713">
<title>ઉકેલ</title>
<table id="eip-id1168466285116" class="unnumbered unstyled" aria-label="આકૃતિમાં છ હરોળ છે. પહેલી હરોળ કહે છે કે આપણે 2 ધનથી શરૂ કરીએ છીએ. પછી 2 વાદળી વર્તુળ છે. બીજી હરોળ કહે છે કે આપણે 8 ધન દૂર કરવા છે, પરંતુ આપણી પાસે માત્ર 2 છે. ત્રીજી હરોળ દૂર કરવા માટે 8 ધન મળે ત્યાં સુધી શૂન્ય બનાવતી જોડીઓ ઉમેરવાનું કહે છે. પછી 8 વાદળી વર્તુળની હરોળ છે; પહેલા બે અને છેલ્લા 6 વચ્ચે અંતર છે. છેલ્લા છની નીચે 6 લાલ વર્તુળની હરોળ છે. ચોથી હરોળ પછી 8 ધન દૂર કરવાનું કહે છે. પછી 8 વાદળી વર્તુળની ઘેરેલી હરોળ છે. પાંચમી હરોળ બાકી રહેલા કાઉન્ટરની સંખ્યા શોધવાનું કહે છે. છ ઋણ છે. પછી છ ઋણ નામવાળાં 6 લાલ વર્તુળ છે. છઠ્ઠી હરોળમાં 2 ઓછા 8 બરાબર ઋણ 6 છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓐ</span> <newline />આપણે 2 ધન કાઉન્ટરથી શરૂ કરીએ છીએ.</entry>
   <entry><media id="eip-id1168467043494" alt="આછા વાદળી રંગનાં બે વર્તુળ આડાં ગોઠવેલાં છે અને તેમની નીચે 2 લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_031_img-01.png" /></media></entry>
 </row>
 <row>
 <entry>આપણે 8 ધન કાઉન્ટર દૂર કરવા છે, પરંતુ આપણી પાસે માત્ર 2 છે.</entry>
<entry />
</row>
<row>
<entry>દૂર કરવા માટે 8 ધન કાઉન્ટર મળે ત્યાં સુધી શૂન્ય બનાવતી જોડીઓ ઉમેરો.</entry>
  <entry><media id="eip-id1168467043513" alt="આકૃતિમાં 8 વાદળી અને 6 લાલ વર્તુળ છે; બે વાદળી વર્તુળ મુખ્ય સમૂહથી અલગ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_031_img-02.png" /></media></entry>
 </row>
 <row>
 <entry>પછી આઠ ધન કાઉન્ટર દૂર કરો.</entry>
  <entry><media id="eip-id1168469829362" alt="વર્તુળની બે હરોળ છે. ઉપરની હરોળમાં 8 વાદળી વર્તુળ છે, જેને ગુલાબી અંડાકાર અને ડાબા તીરે ઘેર્યાં છે; નીચેની હરોળમાં 6 નારંગી વર્તુળ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_031_img-03.png" /></media></entry>
 </row>
 <row>
 <entry>બાકી રહેલા કાઉન્ટરની સંખ્યા શોધો.<newline />6 ઋણ કાઉન્ટર છે.</entry>
 <entry><media id="eip-id1168466271736" alt="છ લાલ વર્તુળ આડી હરોળમાં છે અને તેમની નીચે “6 ઋણ” લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_031_img-04.png" /></media></entry>
 </row>
<row>
<entry />
<entry><m:math><m:mn>2</m:mn><m:mo>−</m:mo><m:mn>8</m:mn><m:mo>=</m:mo><m:mn>−6</m:mn></m:math></entry>
  </row>
</tbody>




</tgroup>
</table>

<table id="eip-id1168468388588" class="unnumbered unstyled" aria-label="આકૃતિમાં છ હરોળ છે. પહેલી હરોળ કહે છે કે આપણે 3 ઋણથી શરૂ કરીએ છીએ. પછી 3 લાલ વર્તુળ છે. બીજી હરોળ કહે છે કે આપણે 8 ઋણ દૂર કરવા છે, પરંતુ આપણી પાસે માત્ર 3 છે. ત્રીજી હરોળ દૂર કરવા માટે 8 ઋણ મળે ત્યાં સુધી શૂન્ય બનાવતી જોડીઓ ઉમેરવાનું કહે છે. પછી 8 લાલ વર્તુળની હરોળ છે; પહેલા ત્રણ અને છેલ્લા 5 વચ્ચે અંતર છે. છેલ્લા 5ની નીચે 5 વાદળી વર્તુળની હરોળ છે. ચોથી હરોળ પછી 8 ઋણ દૂર કરવાનું કહે છે. પછી 8 લાલ વર્તુળની ઘેરેલી હરોળ છે. પાંચમી હરોળ બાકી રહેલા કાઉન્ટરની સંખ્યા શોધવાનું કહે છે. પાંચ ધન છે. પછી 5 વાદળી વર્તુળ છે. છઠ્ઠી હરોળમાં ઋણ 3 ઓછા ઋણ 8 બરાબર 5 છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓑ</span> <newline />આપણે 3 ઋણ કાઉન્ટરથી શરૂ કરીએ છીએ.</entry>
   <entry><media id="eip-id1168467247478" alt="ત્રણ લાલ વર્તુળ આડી હરોળમાં છે અને તેમની નીચે 3 લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_032_img-01.png" /></media></entry>
 </row>
 <row>
 <entry>આપણે 8 ઋણ કાઉન્ટર દૂર કરવા છે, પરંતુ આપણી પાસે માત્ર 3 છે.</entry>
  <entry />
 </row>
 <row>
 <entry>દૂર કરવા માટે 8 ઋણ કાઉન્ટર મળે ત્યાં સુધી શૂન્ય બનાવતી જોડીઓ ઉમેરો.</entry>
  <entry><media id="eip-id1168468228102" alt="સફેદ પૃષ્ઠભૂમિ પર લાલ અને વાદળી વર્તુળ છે. ઉપરની હરોળમાં આઠ લાલ વર્તુળ બે સમૂહમાં અને નીચેની હરોળમાં પાંચ વાદળી વર્તુળ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_032_img-02.png" /></media></entry>
 </row>
 <row>
 <entry>પછી 8 ઋણ કાઉન્ટર દૂર કરો.</entry>
 <entry><media id="eip-id1168468389679" alt="આઠ લાલ વર્તુળને ડાબી તરફના તીરવાળા અંડાકારે ઘેર્યાં છે. તેમની નીચે છ વાદળી વર્તુળ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_032_img-03.png" /></media></entry>
 </row>
 <row>
 <entry>બાકી રહેલા કાઉન્ટરની સંખ્યા શોધો.<newline />5 ધન કાઉન્ટર છે.</entry>
 <entry><media id="eip-id1168468583751" alt="પાંચ વાદળી-રાખોડી વર્તુળ આડી હરોળમાં છે અને તેમની નીચે “5 ધન” લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_032_img-04.png" /></media></entry>
</row>
<row>
<entry />
<entry><m:math><m:mn>−3</m:mn><m:mo>−</m:mo><m:mo>(</m:mo><m:mn>−8</m:mn><m:mo>)</m:mo><m:mo>=</m:mo><m:mn>5</m:mn></m:math></entry>
 </row>

</tbody>




</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id1279088" class="try">
<exercise id="fs-id1789487"><problem id="fs-id2261317">
<para id="fs-id3166943">દરેક બાદબાકીની પદાવલીને નમૂના દ્વારા દર્શાવો.</para>
<list id="eip-id1168466205125" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>9</m:mn></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−5</m:mn><m:mo>−</m:mo><m:mo stretchy="false" /><m:mo stretchy="false">(</m:mo><m:mn>−9</m:mn><m:mo stretchy="false">)</m:mo></m:math></item></list></problem>
<solution id="fs-id1988721">
<para id="fs-id1463372"><span class="token">ⓐ</span> <newline />
<media id="fs-id2466219" alt="આકૃતિમાં આછા ગુલાબી રંગના 9 ધન કાઉન્ટરની હરોળ છે; પહેલા સાત અને છેલ્લા બે વચ્ચે અંતર છે. આખી હરોળ ઘેરેલી છે. છેલ્લા બેની નીચે ઘેરા ગુલાબી રંગના બે ઋણ કાઉન્ટર છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_020_img.jpg" />
</media><newline />−2 <newline /><span class="token">ⓑ</span> <newline />
<media id="eip-idm380134560" alt="આકૃતિમાં ઘેરા ગુલાબી રંગના 9 ઋણ કાઉન્ટરની હરોળ છે; પહેલા પાંચ અને છેલ્લા ચાર વચ્ચે અંતર છે. આખી હરોળ ઘેરેલી છે. છેલ્લા ચારની નીચે આછા ગુલાબી રંગના ચાર ધન કાઉન્ટર છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_021_img.jpg" />
</media><newline />4</para></solution>

</exercise></note>
<note id="fs-id1171104003747" class="try">
<exercise id="fs-id2174292"><problem id="fs-id770331">
<para id="fs-id1171104004574">દરેક બાદબાકીની પદાવલીને નમૂના દ્વારા દર્શાવો.</para>
<list id="eip-id1168468470083" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>4</m:mn><m:mo>−</m:mo><m:mn>7</m:mn></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−7</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−10</m:mn><m:mo stretchy="false">)</m:mo></m:math></item></list></problem>
<solution id="fs-id1365621">
<para id="fs-id1510772"><span class="token">ⓐ</span> <newline />
<media id="fs-id1782529" alt="આકૃતિમાં આછા ગુલાબી રંગના સાત ધન કાઉન્ટરની હરોળ છે; પહેલા ચાર અને છેલ્લા ત્રણ વચ્ચે અંતર છે. આખી હરોળ ઘેરેલી છે. છેલ્લા ત્રણની નીચે ઘેરા ગુલાબી રંગના ત્રણ ઋણ કાઉન્ટર છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_022_img.jpg" />
</media><newline />−3<newline />
<span class="token">ⓑ</span> <newline />
<media id="eip-idm510157984" alt="આકૃતિમાં ઘેરા ગુલાબી રંગના 10 ઋણ કાઉન્ટરની હરોળ છે; પહેલા સાત અને છેલ્લા ત્રણ વચ્ચે અંતર છે. આખી હરોળ ઘેરેલી છે. છેલ્લા ત્રણની નીચે આછા ગુલાબી રંગના ત્રણ ધન કાઉન્ટર છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_023_img.jpg" />
</media><newline />3</para></solution>

</exercise></note>
</section><section id="fs-id2835459">
<title>પૂર્ણાંકો ધરાવતી પદાવલીઓ સરળ કરો</title>
<para id="fs-id1314280">શું તમને કોઈ ઢાંચો દેખાય છે? શું તમે હવે કાઉન્ટર વિના પૂર્ણાંકોની બાદબાકી કરવા તૈયાર છો? ચાલો, બીજી બે બાદબાકી કરીએ. કાઉન્ટર વડે તેમનો નમૂનો કેવી રીતે બનાવીએ તે વિચારીશું, પરંતુ ખરેખર કાઉન્ટર વાપરીશું નહીં.</para><list id="fs-id2376804" list-type="bulleted" bullet-style="bullet">
<item>બાદ કરો: <m:math><m:mrow><m:mn>−23</m:mn><m:mo>−</m:mo><m:mn>7</m:mn><m:mo>.</m:mo></m:mrow></m:math><newline />
વિચારો: આપણે <m:math><m:mrow><m:mn>23</m:mn></m:mrow></m:math> ઋણ કાઉન્ટરથી શરૂ કરીએ છીએ.<newline />
આપણે <m:math><m:mrow><m:mn>7</m:mn></m:mrow></m:math> ધન કાઉન્ટર દૂર કરવા છે, પરંતુ દૂર કરવા માટે કોઈ ધન કાઉન્ટર નથી.<newline />
તેથી <m:math><m:mrow><m:mn>7</m:mn></m:mrow></m:math> શૂન્ય બનાવતી જોડીઓ ઉમેરીને <m:math><m:mrow><m:mn>7</m:mn></m:mrow></m:math> ધન કાઉન્ટર મેળવીએ છીએ. હવે <m:math><m:mrow><m:mn>7</m:mn></m:mrow></m:math> ધન કાઉન્ટર દૂર કરીએ છીએ.<newline />
તો શું બચે છે? મૂળ <m:math><m:mrow><m:mn>23</m:mn></m:mrow></m:math> ઋણ કાઉન્ટર ઉપરાંત <m:math><m:mrow><m:mn>7</m:mn></m:mrow></m:math> વધુ ઋણ કાઉન્ટર છે. પરિણામ <m:math><m:mrow><m:mn>30</m:mn></m:mrow></m:math> ઋણ કાઉન્ટર છે.<newline />
<equation id="fs-id1171102982684" class="unnumbered"><label /><m:math><m:mrow><m:mn>−23</m:mn><m:mo>−</m:mo><m:mn>7</m:mn><m:mo>=</m:mo><m:mn>−30</m:mn></m:mrow></m:math></equation><newline />
ધ્યાન આપો કે બાદ કરવાની સંખ્યા છે <m:math><m:mrow><m:mtext>7,</m:mtext></m:mrow></m:math> આ માટે આપણે ઉમેર્યા: <m:math><m:mrow><m:mn>7</m:mn></m:mrow></m:math> ઋણ કાઉન્ટર.</item>
<item>બાદ કરો: <m:math><m:mrow><m:mn>30</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−12</m:mn><m:mo stretchy="false">)</m:mo><m:mo>.</m:mo></m:mrow></m:math><newline />
વિચારો: આપણે <m:math><m:mrow><m:mn>30</m:mn></m:mrow></m:math> ધન કાઉન્ટરથી શરૂ કરીએ છીએ.<newline />
આપણે <m:math><m:mrow><m:mn>12</m:mn></m:mrow></m:math> ઋણ કાઉન્ટર દૂર કરવા છે, પરંતુ દૂર કરવા માટે કોઈ ઋણ કાઉન્ટર નથી.<newline />
તેથી <m:math><m:mrow><m:mn>12</m:mn></m:mrow></m:math> શૂન્ય બનાવતી જોડીઓ આ <m:math><m:mrow><m:mn>30</m:mn></m:mrow></m:math> ધન કાઉન્ટરમાં ઉમેરીએ છીએ. હવે <m:math><m:mrow><m:mn>12</m:mn></m:mrow></m:math> ઋણ કાઉન્ટર દૂર કરીએ છીએ.<newline />
શું બચે છે? મૂળ <m:math><m:mrow><m:mn>30</m:mn></m:mrow></m:math> ધન કાઉન્ટર ઉપરાંત <m:math><m:mrow><m:mn>12</m:mn></m:mrow></m:math> વધુ ધન કાઉન્ટર છે. પરિણામ <m:math><m:mrow><m:mn>42</m:mn></m:mrow></m:math> ધન કાઉન્ટર છે.<newline />
<equation id="fs-id1171104053087" class="unnumbered"><label /><m:math><m:mrow><m:mn>30</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−12</m:mn><m:mo stretchy="false">)</m:mo><m:mo>=</m:mo><m:mn>42</m:mn></m:mrow></m:math></equation><newline />
ધ્યાન આપો કે બાદ કરવાની સંખ્યા છે <m:math><m:mrow><m:mn>−12</m:mn><m:mo>,</m:mo></m:mrow></m:math> આ માટે આપણે ધન સંખ્યા ઉમેરી: <m:math><m:mrow><m:mn>12</m:mn><m:mo>.</m:mo></m:mrow></m:math></item>
</list>
<para id="fs-id2670396">આપણે હંમેશાં કાઉન્ટર વાપરીએ એવું નથી—ખાસ કરીને મોટી સંખ્યાઓ સાથે કામ કરતી વખતે. પરંતુ પહેલાં કાઉન્ટર વડે અભ્યાસ કરવાથી ખ્યાલ લાગુ કરવાની એક મૂર્ત રીત મળી. તેથી કાઉન્ટર વિના બાદબાકી કેવી રીતે કરવી તેનું ચિત્ર મનમાં બનાવીને યાદ રાખી શકીએ છીએ.</para>
<para id="fs-id2365190">શું તમે ધ્યાન આપ્યું કે નિશાનીવાળી સંખ્યાઓની બાદબાકી વિરોધી સંખ્યાના સરવાળા વડે કરી શકાય છે? આ વિચારને તમે ઘણી વાર <term class="no-emphasis" id="term-00002">બાદબાકીનો ગુણધર્મ</term>તરીકે આ રીતે લખેલો જોશો:</para>
<note id="eip-637"><label /><title>બાદબાકીનો ગુણધર્મ</title><equation id="eip-id1169343107112" class="unnumbered"><m:math><m:mrow><m:mi>a</m:mi><m:mo>−</m:mo><m:mi>b</m:mi><m:mo>=</m:mo><m:mi>a</m:mi><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mtext mathvariant="italic">−b</m:mtext><m:mo stretchy="false">)</m:mo></m:mrow></m:math></equation></note><para id="fs-id1153497">આ બે ઉદાહરણો જુઓ.</para>
<media id="fs-id1988340" alt="આકૃતિમાં બે સ્તંભ છે. પહેલા સ્તંભમાં 6 ઓછા 4 છે. તેની નીચે 6 વાદળી વર્તુળની હરોળ છે; પહેલા 4 અને છેલ્લા 2 વચ્ચે અંતર છે અને પહેલા 4 ઘેરેલા છે. હરોળની નીચે 2 છે. બીજા સ્તંભમાં 6 વત્તા ઋણ 4 છે. તેની નીચે 6 વાદળી વર્તુળની હરોળ છે; પહેલા 4 અને છેલ્લા 2 વચ્ચે અંતર છે અને પહેલા 4 ઘેરેલા છે. પહેલા ચારની નીચે 4 લાલ વર્તુળની હરોળ છે. તેની નીચે 2 છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_033_img.jpg" />
</media>
<para id="fs-id782874">આપણે જોઈએ છીએ કે <m:math><m:mrow><m:mn>6</m:mn><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math> થી આના જેટલો જ જવાબ મળે છે: <m:math><m:mrow><m:mn>6</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−4</m:mn><m:mo stretchy="false">)</m:mo><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id1835863">અલબત્ત, પહેલા ઉદાહરણની જેમ બાદબાકીના પ્રશ્નમાં માત્ર ધન સંખ્યાઓ હોય, ત્યારે આપણે સીધી બાદબાકી કરીએ છીએ. આની બાદબાકી કેવી રીતે કરવી તે આપણે બહુ પહેલાંથી જાણીએ છીએ: <m:math><m:mrow><m:mn>6</m:mn><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math> પરંતુ <m:math><m:mrow><m:mn>6</m:mn><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math> થી આના જેટલો જ જવાબ મળે છે: <m:math><m:mrow><m:mn>6</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> એ જાણવાથી ઋણ સંખ્યાઓની બાદબાકી કરતી વખતે મદદ મળે છે.</para><example id="fs-id1509873">
<exercise id="fs-id2281044"><problem id="fs-id2135754">
<para id="fs-id1508967">સરળ કરો:
<list id="eip-id1168468772640" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>13</m:mn><m:mo>−</m:mo><m:mn>8</m:mn><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>13</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−8</m:mn><m:mo stretchy="false">)</m:mo><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−17</m:mn><m:mo>−</m:mo><m:mn>9</m:mn><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>−17</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−9</m:mn><m:mo stretchy="false">)</m:mo></m:math></item></list></para></problem>
<solution id="fs-id2954855">
<title>ઉકેલ</title>
<table id="eip-id1168469839872" class="unnumbered unstyled" summary="આ કોષ્ટક 13 − 8 અને 13 + (−8)નાં ઉદાહરણ વડે બતાવે છે કે કોઈ સંખ્યાની બાદબાકી તેના વિરોધીના સરવાળા સમાન છે."><label />
<tgroup cols="2"><tbody>
<row>
   <entry><span class="token">ⓐ</span> </entry>
   <entry />
</row>
<row>
   <entry />
   <entry align="right"><m:math><m:mn>13</m:mn><m:mo>−</m:mo><m:mn>8</m:mn></m:math> અને <m:math><m:mn>13</m:mn><m:mo>+</m:mo><m:mo>(</m:mo><m:mn>−8</m:mn><m:mo>)</m:mo></m:math></entry>
 </row>
 <row>
 <entry>સરળ કરવા બાદબાકી કરો.</entry>
  <entry align="right"><m:math><m:mn>13</m:mn><m:mo>−</m:mo><m:mn>8</m:mn><m:mo>=</m:mo><m:mn>5</m:mn></m:math></entry>
 </row>
 <row>
 <entry>સરળ કરવા સરવાળો કરો.</entry>
  <entry align="right"><m:math><m:mn>13</m:mn><m:mo>+</m:mo><m:mo>(</m:mo><m:mn>−8</m:mn><m:mo>)</m:mo><m:mo>=</m:mo><m:mn>5</m:mn></m:math></entry>
 </row>
 <row>
 <entry>8ને 13માંથી બાદ કરવું એ −8ને 13માં ઉમેરવા સમાન છે.</entry>
 <entry />
 </row>

</tbody>





</tgroup>
</table><table id="eip-id1164272171485" class="unnumbered unstyled" summary="ઉદાહરણ વડે આ કોષ્ટક બતાવે છે કે કોઈ સંખ્યાની બાદબાકી તેના ઋણ સમકક્ષના સરવાળા સમાન છે."><label />
<tgroup cols="2"><tbody>
 <row>
 <entry><span class="token">ⓑ</span> </entry>
 <entry />
 </row>
 <row>
 <entry />
 <entry align="right"><m:math><m:mn>−17</m:mn><m:mo>−</m:mo><m:mn>9</m:mn></m:math> અને <m:math><m:mn>−17</m:mn><m:mo>+</m:mo><m:mo>(</m:mo><m:mn>−9</m:mn><m:mo>)</m:mo></m:math></entry>
 </row>
 <row>
 <entry>સરળ કરવા બાદબાકી કરો.</entry>
 <entry align="right"><m:math><m:mn>−17</m:mn><m:mo>−</m:mo><m:mn>9</m:mn><m:mo>=</m:mo><m:mn>−26</m:mn></m:math></entry>
 </row>
 <row>
 <entry>સરળ કરવા સરવાળો કરો.</entry>
 <entry align="right"><m:math><m:mn>−17</m:mn><m:mo>+</m:mo><m:mo>(</m:mo><m:mn>−9</m:mn><m:mo>)</m:mo><m:mo>=</m:mo><m:mn>−26</m:mn></m:math></entry>
 </row>
 <row>
 <entry>9ને −17માંથી બાદ કરવું એ −9ને −17માં ઉમેરવા સમાન છે.</entry>
<entry />
 </row>

</tbody>





</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id1811289" class="try">
<exercise id="fs-id2264863"><problem id="fs-id1631520">
<para id="fs-id766244">દરેક પદાવલી સરળ કરો:</para>
<list id="eip-id1168467239890" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>21</m:mn><m:mo>−</m:mo><m:mn>13</m:mn><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>21</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−13</m:mn><m:mo stretchy="false">)</m:mo><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−11</m:mn><m:mo>−</m:mo><m:mn>7</m:mn><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>−11</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−7</m:mn><m:mo stretchy="false">)</m:mo></m:math></item></list></problem>
<solution id="fs-id2300362">
<list id="eip-id1168468537526" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> 8, 8 </item>
<item><span class="token">ⓑ</span> −18, −18 </item></list></solution>
</exercise></note>
<note id="fs-id1171104020384" class="try">
<exercise id="fs-id1762046">
<problem id="fs-id2219309">
<para id="fs-id1171104406995">દરેક પદાવલી સરળ કરો:</para>
<para id="fs-id1609094"><list id="eip-id1168466907380" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>15</m:mn><m:mo>−</m:mo><m:mn>7</m:mn><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>15</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−7</m:mn><m:mo stretchy="false">)</m:mo><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−14</m:mn><m:mo>−</m:mo><m:mn>8</m:mn><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>−14</m:mn><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−8</m:mn><m:mo stretchy="false">)</m:mo></m:math></item></list></para></problem>
<solution id="fs-id2261766">
<para id="fs-id2657426"><list id="eip-id1168468513309" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> 8, 8 </item>
<item><span class="token">ⓑ</span> −22, −22 </item></list></para></solution>
</exercise>
</note>
<para id="fs-id2464344">હવે ઋણ સંખ્યાની બાદબાકી કરીએ ત્યારે શું થાય છે તે જુઓ.</para>
<media id="fs-id2751961" alt="આકૃતિમાં બે સ્તંભ છે. પહેલા સ્તંભમાં 8 ઓછા ઋણ 5 છે. તેની નીચે 13 વાદળી વર્તુળની હરોળ છે; પહેલા 8 અને પછીના 5 વચ્ચે અંતર છે. છેલ્લા 5 વાદળી વર્તુળની નીચે 5 લાલ વર્તુળની હરોળ છે અને તેઓ ઘેરેલાં છે. તેની નીચે 13 છે. બીજા સ્તંભમાં 8 વત્તા 5 છે. તેની નીચે 13 વાદળી વર્તુળની હરોળ છે; પહેલા 8 અને છેલ્લા 5 વચ્ચે અંતર છે. તેની નીચે 13 છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_024_img.jpg" />
</media>
<para id="fs-id1732672">આપણે જોઈએ છીએ કે <m:math><m:mrow><m:mn>8</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math> થી આના જેટલું જ પરિણામ મળે છે: <m:math><m:mrow><m:mn>8</m:mn><m:mo>+</m:mo><m:mn>5</m:mn><m:mo>.</m:mo></m:mrow></m:math> ઋણ સંખ્યાની બાદબાકી કરવી એ ધન સંખ્યાનો સરવાળો કરવા જેવી છે.</para>
<example id="fs-id2789219">
<exercise id="fs-id1632042"><problem id="fs-id1944621">
<para id="fs-id1885021">સરળ કરો: <list id="eip-id1168467169673" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>9</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−15</m:mn><m:mo stretchy="false">)</m:mo><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>9</m:mn><m:mo>+</m:mo><m:mn>15</m:mn><m:mspace width="1em" /></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−7</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−4</m:mn><m:mo stretchy="false">)</m:mo><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>−7</m:mn><m:mo>+</m:mo><m:mn>4</m:mn></m:math></item></list></para></problem>
<solution id="fs-id1571351">
<title>ઉકેલ</title>
<table id="eip-id1168468712402" class="unnumbered unstyled" summary="9 − (−15) = 9 + 15 = 24નાં ઉદાહરણ વડે બતાવે છે કે ઋણ સંખ્યાની બાદબાકી તેના ધન સમકક્ષના સરવાળા સમાન છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓐ</span> </entry>
   <entry />
   </row>
   <row>
   <entry />
   <entry align="right"><m:math><m:mn>9</m:mn><m:mo>−</m:mo><m:mo>(</m:mo><m:mn>−15</m:mn><m:mo>)</m:mo></m:math> અને <m:math><m:mn>9</m:mn><m:mo>+</m:mo><m:mn>15</m:mn></m:math></entry>
 </row>
 <row>
 <entry>સરળ કરવા બાદબાકી કરો.</entry>
  <entry align="right"><m:math><m:mn>9</m:mn><m:mo>−</m:mo><m:mo>(</m:mo><m:mn>−15</m:mn><m:mo>)</m:mo><m:mo>=</m:mo><m:mn>24</m:mn></m:math></entry>
 </row>
 <row>
 <entry>સરળ કરવા સરવાળો કરો.</entry>
  <entry align="right"><m:math><m:mn>9</m:mn><m:mo>+</m:mo><m:mn>15</m:mn><m:mo>=</m:mo><m:mn>24</m:mn></m:math></entry>
 </row>
 <row>
 <entry>−15ને 9માંથી બાદ કરવું એ 15ને 9માં ઉમેરવા સમાન છે.</entry>
 <entry />
 </row>

</tbody>




</tgroup>
</table><table id="eip-id1164270694692" class="unnumbered unstyled" summary="−7 − (−4) = −7 + 4નાં ઉદાહરણ વડે આ કોષ્ટક બતાવે છે કે ઋણ સંખ્યાની બાદબાકી ધન સંખ્યાના સરવાળા સમાન છે."><label />
<tgroup cols="2"><tbody>

 <row>
 <entry><span class="token">ⓑ</span> </entry>
 <entry />
 </row>
 <row>
 <entry />
 <entry align="right"><m:math><m:mn>−7</m:mn><m:mo>−</m:mo><m:mo>(</m:mo><m:mn>−4</m:mn><m:mo>)</m:mo></m:math> અને <m:math><m:mn>−7</m:mn><m:mo>+</m:mo><m:mn>4</m:mn></m:math></entry>
 </row>
 <row>
 <entry>સરળ કરવા બાદબાકી કરો.</entry>
 <entry align="right"><m:math><m:mn>−7</m:mn><m:mo>−</m:mo><m:mo>(</m:mo><m:mn>−4</m:mn><m:mo>)</m:mo><m:mo>=</m:mo><m:mn>−3</m:mn></m:math></entry>
 </row>
 <row>
 <entry>સરળ કરવા સરવાળો કરો.</entry>
 <entry align="right"><m:math><m:mn>−7</m:mn><m:mo>+</m:mo><m:mn>4</m:mn><m:mo>=</m:mo><m:mn>−3</m:mn></m:math></entry>
 </row>
 <row>
 <entry>−4ને −7માંથી બાદ કરવું એ 4ને −7માં ઉમેરવા સમાન છે.</entry>
 <entry />
 </row>

</tbody>



</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id1823192" class="try">
<exercise id="fs-id2658084">
<problem id="fs-id1398237">
<para id="fs-id1397945">દરેક પદાવલી સરળ કરો:</para>
<para id="fs-id1171104043639"><list id="eip-id1168469637544" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>6</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−13</m:mn><m:mo stretchy="false">)</m:mo><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>6</m:mn><m:mo>+</m:mo><m:mn>13</m:mn><m:mspace width="1em" /></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−5</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−1</m:mn><m:mo stretchy="false">)</m:mo><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>−5</m:mn><m:mo>+</m:mo><m:mn>1</m:mn></m:math></item></list></para></problem>
<solution id="fs-id1579164">
<para id="fs-id1368901"><list id="eip-id1168469448233" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> 19, 19 </item>
<item><span class="token">ⓑ</span> −4, −4</item></list></para></solution>
</exercise>
</note>
<note id="fs-id1171104384340" class="try">
<exercise id="fs-id1499181">
<problem id="fs-id1910995">
<para id="fs-id1171103271744">દરેક પદાવલી સરળ કરો:</para>
<para id="fs-id1213413"><list id="eip-id1168466333215" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>4</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−19</m:mn><m:mo stretchy="false">)</m:mo><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>4</m:mn><m:mo>+</m:mo><m:mn>19</m:mn><m:mspace width="1em" /></m:math></item>
<item><span class="token">ⓐ</span> <m:math><m:mn>−4</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−7</m:mn><m:mo stretchy="false">)</m:mo><m:mspace width="0.2em" /><m:mtext>અને</m:mtext><m:mspace width="0.2em" /><m:mn>−4</m:mn><m:mo>+</m:mo><m:mn>7</m:mn></m:math></item></list></para></problem>
<solution id="fs-id845547">
<para id="fs-id1225003"><list id="eip-id1168469459396" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> 23, 23 </item>
<item><span class="token">ⓑ</span> 3, 3 </item></list></para></solution>
</exercise>
</note>
<para id="eip-891">આમાં મળેલાં પરિણામો ફરી જુઓ: <link target-id="fs-id2204811" /> - <link target-id="fs-id1048785" />.</para><table id="eip-703"><label /><title>પૂર્ણાંકોની બાદબાકી</title>
<tgroup cols="3">  <colspec colnum="1" colname="c1" />
    <colspec colnum="2" colname="c2" />
    <colspec colnum="3" colname="c3" /><tbody>
  <row>
    <entry align="center"><m:math><m:mn>5</m:mn><m:mo>–</m:mo><m:mn>3</m:mn></m:math></entry>
    <entry align="center"><m:math><m:mn>–5</m:mn><m:mo>–</m:mo><m:mo>(</m:mo><m:mn>–3</m:mn><m:mo>)</m:mo></m:math></entry>
  </row>
  <row>
    <entry align="center"><m:math><m:mn>2</m:mn></m:math></entry>
    <entry align="center"><m:math><m:mn>–2</m:mn></m:math></entry>
  </row>
  <row>
    <entry align="center">2 ધન</entry>
    <entry align="center">2 ઋણ</entry>
  </row>

  <row>
    <entry namest="c1" nameend="c2">દૂર કરવાના રંગના પૂરતા કાઉન્ટર હોય ત્યારે બાદબાકી કરો.</entry>
  </row>
  <row>
    <entry align="center"><m:math><m:mn>–5</m:mn><m:mo>–</m:mo><m:mn>3</m:mn></m:math></entry>
    <entry align="center"><m:math><m:mn>5</m:mn><m:mo>–</m:mo><m:mo>(</m:mo><m:mn>–3</m:mn><m:mo>)</m:mo></m:math></entry>
  </row>
  <row>
    <entry align="center"><m:math><m:mn>–8</m:mn></m:math></entry>
    <entry align="center"><m:math><m:mn>8</m:mn></m:math></entry>
  </row>
  <row>
    <entry align="center">5 ઋણ કાઉન્ટર છે અને 3 ધન કાઉન્ટર બાદ કરવા છે</entry>
    <entry align="center">5 ધન કાઉન્ટર છે અને 3 ઋણ કાઉન્ટર બાદ કરવા છે</entry>
  </row>
  <row>
    <entry align="center">શૂન્ય બનાવતી જોડીઓ જરૂરી છે</entry>
    <entry align="center">શૂન્ય બનાવતી જોડીઓ જરૂરી છે</entry>
  </row>

  <row>
    <entry namest="c1" nameend="c2">દૂર કરવા માટે પૂરતા કાઉન્ટર ન હોય ત્યારે શૂન્ય બનાવતી જોડીઓ ઉમેરો.</entry>
  </row>

</tbody>
</tgroup>
</table><example id="fs-id2670060">
<exercise id="fs-id1389306"><problem id="fs-id2817662">
<para id="fs-id2323237">સરળ કરો: <m:math><m:mrow><m:mn>−74</m:mn><m:mo>−</m:mo><m:mo>(</m:mo><m:mrow><m:mn>−58</m:mn></m:mrow><m:mo>)</m:mo><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1714476">
<title>ઉકેલ</title>
<table id="eip-id1168468287610" class="unnumbered unstyled" summary="આ કોષ્ટક ઋણ સંખ્યાઓની બાદબાકી કરવાની પ્રક્રિયા શબ્દોમાં, તેને અનુરૂપ ગાણિતિક પદાવલી અને પરિણામ સાથે દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry>આપણે 58 ઋણ કાઉન્ટરને 74 ઋણ કાઉન્ટરમાંથી દૂર કરીએ છીએ.</entry>
   <entry><m:math><m:mrow><m:mn>−74</m:mn><m:mo>−</m:mo><m:mo>(</m:mo><m:mrow><m:mn>−58</m:mn></m:mrow><m:mo>)</m:mo></m:mrow></m:math></entry>
 </row>
 <row>
 <entry>બાદબાકી કરો.</entry>
  <entry><m:math><m:mrow><m:mn>−16</m:mn></m:mrow></m:math></entry>
 </row>

</tbody>








</tgroup>
</table></solution>


</exercise></example>
<note id="fs-id1499549" class="try">
<exercise id="fs-id2135124">
<problem id="fs-id1464644">
<para id="fs-id1731582">પદાવલી સરળ કરો:</para>
<para id="fs-id1215437"><m:math><m:mrow><m:mn>−67</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−38</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1823532">
<para id="fs-id2140556">−29</para>
</solution>
</exercise>
</note>
<note id="fs-id1171100610747" class="try">
<exercise id="fs-id2661807">
<problem id="fs-id1368142">
<para id="fs-id1171103028561">પદાવલી સરળ કરો:</para>
<para id="fs-id2202683"><m:math><m:mrow><m:mn>−83</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−57</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2277868">
<para id="fs-id1114873">−26</para>
</solution>
</exercise>
</note>
<example id="fs-id1522872">
<exercise id="fs-id1457927"><problem id="fs-id2784341">
<para id="fs-id1571011">સરળ કરો: <m:math><m:mrow><m:mn>7</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−4</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:mn>9</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id764647">
<title>ઉકેલ</title>
<para id="fs-id2431509">આ પદાવલી સરળ કરવા ક્રિયાઓનો ક્રમ વાપરીએ છીએ અને પહેલાં કૌંસની અંદરની ક્રિયાઓ કરીએ છીએ. પછી ડાબેથી જમણે બાદબાકી કરીએ છીએ.</para>
<table id="eip-id1168469609684" class="unnumbered unstyled" summary="લેખિત વર્ણન અને દૃશ્યરૂપ વડે ગાણિતિક પદાવલીને પગલે પગલે સરળ કરવાની પ્રક્રિયા."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry>પહેલા કૌંસની અંદર સરળ કરો.</entry>
   <entry><media id="eip-id1164270858705" alt="ગાણિતિક પદાવલીમાં 7 ઓછા, ખુલ્લા કૌંસમાં ઋણ 4 ઓછા 3, બંધ કૌંસ, ઓછા 9 છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_03_03_054_img-01.png" /></media></entry>
 </row>
 <row>
 <entry>ડાબેથી જમણે બાદબાકી કરો.</entry>
  <entry><media id="eip-id1164269626302" alt="ગાણિતિક પદાવલી 7 ઓછા ઋણ 7 ઓછા 9 દર્શાવેલી છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_03_03_054_img-02.png" /></media></entry>
 </row>
 <row>
 <entry>બાદબાકી કરો.</entry>
  <entry><media id="eip-id1168469635455" alt="સફેદ પૃષ્ઠભૂમિ પર ઘેરા રંગમાં ગાણિતિક પદાવલી 14 − 9 દર્શાવેલી છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_03_03_054_img-03.png" /></media></entry>
</row>
<row>
<entry />
<entry><media id="eip-id1168469469532" alt="સફેદ પૃષ્ઠભૂમિ પર કાળા રંગમાં 5 લખેલું છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_03_03_054_img-04.png" /></media></entry>
 </row>

</tbody>







</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id1297928" class="try">
<exercise id="fs-id1728091">
<problem id="fs-id1393531">
<para id="fs-id2670029">પદાવલી સરળ કરો:</para>
<para id="fs-id1171102898572"><m:math><m:mrow><m:mn>8</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−3</m:mn><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1361775">
<para id="fs-id2170437">3</para>
</solution>
</exercise>
</note>
<note id="fs-id1171103989384" class="try">
<exercise id="fs-id929240">
<problem id="fs-id1517295">
<para id="fs-id1171104059576">પદાવલી સરળ કરો:</para>
<para id="fs-id1397028"><m:math><m:mrow><m:mn>12</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−9</m:mn><m:mo>−</m:mo><m:mn>6</m:mn><m:mo stretchy="false">)</m:mo><m:mo>−</m:mo><m:mn>14</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1300542">
<para id="fs-id1598571">13</para>
</solution>
</exercise>
</note>
<example id="fs-id1282197">
<exercise id="fs-id998264"><problem id="fs-id1379602">
<para id="fs-id1405093">સરળ કરો: <m:math><m:mrow><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>·</m:mo><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>5</m:mn><m:mo>·</m:mo><m:mn>8</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1345587">
<title>ઉકેલ</title>
<para id="fs-id1495748">આ પદાવલી સરળ કરવા આપણે ક્રિયાઓનો ક્રમ વાપરીએ છીએ. પહેલા ગુણાકાર કરીએ છીએ અને પછી ડાબેથી જમણે બાદબાકી કરીએ છીએ.</para>
<table id="eip-id1168468652720" class="unnumbered unstyled" summary="આ કોષ્ટક ક્રિયાઓના ક્રમ મુજબ ગાણિતિક પદાવલીની કિંમત શોધતી વખતે આવતા પગલાં અને તેમને અનુરૂપ દૃશ્ય ફેરફારો દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry>પહેલા ગુણાકાર કરો.</entry>
   <entry><media id="eip-id1164269616024" alt="સફેદ પૃષ્ઠભૂમિ પર આડી હરોળમાં સાદા અક્ષરે ગાણિતિક પદાવલી 3.7 − 4.7 − 5.8 દર્શાવેલી છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_03_03_055_img-01.png" /></media></entry>
 </row>
 <row>
 <entry>ડાબેથી જમણે બાદબાકી કરો.</entry>
  <entry><media id="eip-id1164269616042" alt="સફેદ પૃષ્ઠભૂમિ પર 21, 28 અને 40 સંખ્યાઓ એક હરોળમાં ટૂંકી રેખાઓથી જુદી પાડેલી છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_03_03_055_img-02.png" /></media></entry>
 </row>
 <row>
 <entry>બાદબાકી કરો.</entry>
  <entry><media id="eip-id1164269616059" alt="સફેદ પૃષ્ઠભૂમિની વચ્ચે ગાણિતિક પદાવલી −7 − 40 દર્શાવેલી છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_03_03_055_img-03.png" /></media></entry>
</row>
<row>
<entry />
  <entry><media id="eip-id1168466034937" alt="સફેદ પૃષ્ઠભૂમિ પર કાળા રંગમાં −47 લખેલું છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_03_03_055_img-04.png" /></media></entry>
 </row>

</tbody>







</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id1862885" class="try">
<exercise id="fs-id1760912">
<problem id="fs-id1883214">
<para id="fs-id1518794">પદાવલી સરળ કરો:</para>
<para id="fs-id1171104036142"><m:math><m:mrow><m:mn>6</m:mn><m:mo>·</m:mo><m:mn>2</m:mn><m:mo>−</m:mo><m:mn>9</m:mn><m:mo>·</m:mo><m:mn>1</m:mn><m:mo>−</m:mo><m:mn>8</m:mn><m:mo>·</m:mo><m:mn>9</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1376352">
<para id="fs-id2262017">−69</para>
</solution>
</exercise>
</note>
<note id="fs-id1171104081166" class="try">
<exercise id="fs-id2597348">
<problem id="fs-id1152981">
<para id="fs-id1171103177460">પદાવલી સરળ કરો:</para>
<para id="fs-id2297696"><m:math><m:mrow><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>5</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>·</m:mo><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>4</m:mn><m:mo>·</m:mo><m:mn>9</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id2264860">
<para id="fs-id1861801">−47</para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1823548">
<title>પૂર્ણાંકો ધરાવતી ચલ પદાવલીઓની કિંમત શોધો</title>
<para id="fs-id2389245">હવે આપણે એવી <term class="no-emphasis" id="term-00003">પદાવલીઓ</term> ની કિંમત શોધવાનો અભ્યાસ કરીશું જેમાં <term class="no-emphasis" id="term-00004">ઋણ સંખ્યાઓની બાદબાકી</term> તથા ધન સંખ્યાઓ સામેલ હોય.</para>
<example id="fs-id2385513">
<exercise id="fs-id1631845">
<problem id="fs-id991471">
<para id="fs-id1713522">કિંમત શોધો <m:math><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn><m:mspace width="0.2em" /><m:mtext>જ્યારે</m:mtext><m:mspace width="0.2em" /></m:math>

<list id="eip-id1168469592927" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn><m:mspace width="0.2em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>−6</m:mn><m:mo>.</m:mo></m:math></item></list></para></problem>
<solution id="fs-id2645487">
<title>ઉકેલ</title>
<para id="fs-id2304162"><span class="token">ⓐ</span> આની કિંમત શોધવા: <m:math><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:math> જ્યારે <m:math><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>3</m:mn></m:math> ત્યારે પદાવલીમાં  <m:math><m:mn>3</m:mn></m:math> ને <m:math><m:mi>x</m:mi></m:math> ની જગ્યાએ મૂકો.<newline />
<table id="eip-id1168465998847" class="unnumbered unstyled" aria-label="આકૃતિમાં 3 હરોળ છે. પહેલી હરોળમાં x ઓછા 4 છે. બીજી હરોળ xની જગ્યાએ 3 મૂકવાનું કહે છે અને તેમાં 3 ઓછા 4 છે. ત્રીજી હરોળ બાદબાકી કરવાનું કહે છે અને તેમાં ઋણ 1 છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry />
   <entry><media id="eip-id1164269514089" alt="સફેદ પૃષ્ઠભૂમિ પર કાળા રંગમાં ગાણિતિક પદાવલી x − 4 છે. ચલ x પછી ઓછાનું ચિહ્ન અને પછી 4 છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_034_img-02.png" /></media></entry>
 </row>
 <row>
 <entry><media id="eip-id1164269514103" alt="સફેદ પૃષ્ઠભૂમિ પર ઘાટા અક્ષરે “xની જગ્યાએ 3 મૂકો” લખેલું છે. 3 લાલ રંગમાં અને બાકીનું લખાણ ઘેરા વાદળી-લીલા રંગમાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_034_img-01.png" /></media></entry>
  <entry><media id="eip-id1164269514113" alt="ગાણિતિક પદાવલી 3 − 4 દર્શાવેલી છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_034_img-03.png" /></media></entry>
 </row>
 <row>
 <entry>બાદબાકી કરો.</entry>
  <entry><media id="eip-id1164270891239" alt="સફેદ પૃષ્ઠભૂમિ પર કાળા રંગમાં −1 લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_034_img-04.png" /></media></entry>
 </row>

</tbody>



</tgroup>
</table></para><para id="fs-id2190853"><span class="token">ⓑ</span> આની કિંમત શોધવા: <m:math><m:mi>x</m:mi><m:mo>−</m:mo><m:mn>4</m:mn></m:math> જ્યારે <m:math><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>−6</m:mn><m:mo>,</m:mo></m:math>  ત્યારે પદાવલીમાં  <m:math><m:mrow><m:mn>−6</m:mn></m:mrow></m:math> ને <m:math><m:mrow><m:mi>x</m:mi></m:mrow></m:math> ની જગ્યાએ મૂકો.

<table id="eip-id1168466833806" class="unnumbered unstyled" aria-label="આકૃતિમાં 3 હરોળ છે. પહેલી હરોળમાં x ઓછા 4 છે. બીજી હરોળ xની જગ્યાએ ઋણ 6 મૂકવાનું કહે છે અને તેમાં ઋણ 6 ઓછા 4 છે. ત્રીજી હરોળ બાદબાકી કરવાનું કહે છે અને તેમાં ઋણ 10 છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry />
   <entry><media id="eip-id1164271017002" alt="સફેદ પૃષ્ઠભૂમિ પર કાળા રંગમાં ગાણિતિક પદાવલી x − 4 છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_035_img-02.png" /></media></entry>
 </row>
 <row>
 <entry><media id="eip-id1164271017015" alt="સફેદ પૃષ્ઠભૂમિ પર વાદળી-લીલા રંગમાં “xની જગ્યાએ −6 મૂકો” લખેલું છે અને −6 લાલ રંગમાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_035_img-01.png" /></media></entry>
  <entry><media id="eip-id1168469699335" alt="સફેદ પૃષ્ઠભૂમિ પર લાલ અને કાળા રંગમાં ગાણિતિક પદાવલી −6 − 4 છે, જે 4ને −6માંથી બાદ કરવાનું દર્શાવે છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_035_img-03.png" /></media></entry>
 </row>
 <row>
 <entry>બાદબાકી કરો.</entry>
  <entry><media id="eip-id1164271017044" alt="સફેદ પૃષ્ઠભૂમિ પર કાળા રંગમાં ઋણ 10, એટલે ઓછા 10, લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_035_img-04.png" /></media></entry>
 </row>

</tbody>




</tgroup>
</table></para></solution>
</exercise>
</example>
<note id="fs-id1311565" class="try">
<exercise id="fs-id2296329">
<problem id="fs-id2750915">
<para id="fs-id1549933">દરેક પદાવલીની કિંમત શોધો:</para>
<para id="fs-id1171103981075"><m:math><m:mi>y</m:mi><m:mo>−</m:mo><m:mn>7</m:mn><m:mspace width="0.2em" /><m:mtext>જ્યારે</m:mtext><m:mspace width="0.2em" /></m:math>
<list id="eip-id1168469846800" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>5</m:mn><m:mspace width="0.2em" /><m:mspace width="0.2em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>−8</m:mn></m:math></item></list></para></problem>
<solution id="fs-id2494534">
<para id="fs-id1788936"><list id="eip-id1168466289079" list-type="enumerated" number-style="arabic" class="circled"><item>
<span class="token">ⓐ</span> −2</item>
<item><span class="token">ⓑ</span> −15</item></list></para></solution>
</exercise>
</note>
<note id="fs-id1171104405937" class="try">
<exercise id="fs-id1575730">
<problem id="fs-id2146186">
<para id="fs-id1171103128796">દરેક પદાવલીની કિંમત શોધો:</para>
<para id="fs-id2220406"><m:math><m:mi>m</m:mi><m:mo>−</m:mo><m:mn>3</m:mn><m:mspace width="0.2em" /><m:mtext>જ્યારે</m:mtext><m:mspace width="0.2em" /></m:math>

<list id="eip-id1168466928975" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>1</m:mn><m:mspace width="0.2em" /></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>−4</m:mn></m:math></item></list></para></problem>
<solution id="fs-id1406166">
<para id="fs-id2474808"><list id="eip-id1168466598594" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> −2</item>
<item><span class="token">ⓑ</span> −7</item></list></para></solution>
</exercise>
</note>
<example id="fs-id2472253">
<exercise id="fs-id1529707">
<problem id="fs-id1406164">
<para id="fs-id1364012">કિંમત શોધો <m:math><m:mn>20</m:mn><m:mo>−</m:mo><m:mi>z</m:mi><m:mspace width="0.2em" /><m:mtext>જ્યારે</m:mtext><m:mspace width="0.2em" /></m:math>

<list id="eip-id1168467246995" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mi>z</m:mi><m:mo>=</m:mo><m:mn>12</m:mn><m:mspace width="0.2em" /></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mi>z</m:mi><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>12</m:mn></m:math></item></list></para></problem>
<solution id="fs-id1899878">
<title>ઉકેલ</title>
<para id="fs-id1828632"><span class="token">ⓐ</span> આની કિંમત શોધવા: <m:math><m:mrow><m:mn>20</m:mn><m:mo>−</m:mo><m:mi>z</m:mi><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>z</m:mi><m:mo>=</m:mo><m:mn>12</m:mn><m:mo>,</m:mo></m:mrow></m:math>  ત્યારે પદાવલીમાં  <m:math><m:mrow><m:mn>12</m:mn></m:mrow></m:math> ને  <m:math><m:mrow><m:mi>z</m:mi></m:mrow></m:math>  ની જગ્યાએ મૂકો.<newline />


<table id="eip-id1168469489544" class="unnumbered unstyled" aria-label="આકૃતિમાં 3 હરોળ છે. પહેલી હરોળમાં 20 ઓછા z છે. બીજી હરોળ zની જગ્યાએ 12 મૂકવાનું કહે છે અને તેમાં 20 ઓછા 12 છે. ત્રીજી હરોળ બાદબાકી કરવાનું કહે છે અને તેમાં 8 છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry />
   <entry><media id="eip-id1164270789302" alt="સફેદ પૃષ્ઠભૂમિ પર સાદા અક્ષરે ગાણિતિક પદાવલી 20 − z છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_036_img-02.png" /></media></entry>
 </row>
 <row>
 <entry><media id="eip-id1168469755618" alt="ચિત્રમાં “zની જગ્યાએ 12 મૂકો” લખેલું છે. “મૂકો” અને “zની જગ્યાએ” ઘેરા વાદળી-લીલા રંગમાં તથા 12 લાલ રંગમાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_036_img-01.png" /></media></entry>
  <entry><media id="eip-id1164270789327" alt="ગાણિતિક પદાવલી 20 − 12 છે અને 12 લાલ રંગમાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_036_img-03.png" /></media></entry>
 </row>
 <row>
 <entry>બાદબાકી કરો.</entry>
  <entry><media id="eip-id1164269656091" alt="સફેદ પૃષ્ઠભૂમિ પર કાળા રંગમાં 8 લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_036_img-04.png" /></media></entry>
 </row>

</tbody>




</tgroup>
</table></para><para id="fs-id2150647"><span class="token">ⓑ</span> આની કિંમત શોધવા: <m:math><m:mrow><m:mn>20</m:mn><m:mo>−</m:mo><m:mi>z</m:mi><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>z</m:mi><m:mo>=</m:mo><m:mn>−12</m:mn><m:mo>,</m:mo><m:mspace width="0.2em" /><m:mtext> ત્યારે પદાવલીમાં </m:mtext><m:mspace width="0.2em" /><m:mn>−12</m:mn><m:mspace width="0.2em" /><m:mtext>ને </m:mtext><m:mspace width="0.2em" /><m:mi>z</m:mi><m:mspace width="0.2em" /><m:mtext> ની જગ્યાએ મૂકો.</m:mtext></m:mrow></m:math><newline />


<table id="eip-id1168469804288" class="unnumbered unstyled" aria-label="આકૃતિમાં 3 હરોળ છે. પહેલી હરોળમાં 20 ઓછા z છે. બીજી હરોળ zની જગ્યાએ ઋણ 12 મૂકવાનું કહે છે અને તેમાં 20 ઓછા ઋણ 12 છે. ત્રીજી હરોળ બાદબાકી કરવાનું કહે છે અને તેમાં 32 છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry />
   <entry><media id="eip-id1164271003617" alt="સફેદ પૃષ્ઠભૂમિ પર સાદા અક્ષરે બીજગણિતીય પદાવલી 20 − z છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_037_img-02.png" /></media></entry>
 </row>
 <row>
 <entry><media id="eip-id1168466338699" alt="“zની જગ્યાએ −12 મૂકો” લખેલું છે અને −12 લાલ રંગમાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_037_img-01.png" /></media></entry>
  <entry><media id="eip-id1168466338709" alt="સફેદ પૃષ્ઠભૂમિ પર કાળા અને લાલ રંગમાં ગાણિતિક પદાવલી 20 − (−12) છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_037_img-03.png" /></media></entry>
 </row>
 <row>
 <entry>બાદબાકી કરો.</entry>
  <entry><media id="eip-id1164271003662" alt="સફેદ પૃષ્ઠભૂમિ પર રાખોડી રંગમાં 32 સ્પષ્ટ રીતે દર્શાવેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_037_img-04.png" /></media></entry>
 </row>

</tbody>



</tgroup>
</table></para></solution>
</exercise>
</example>
<note id="fs-id1608660" class="try">
<exercise id="fs-id1381763">
<problem id="fs-id2485774">
<para id="fs-id1574419">દરેક પદાવલીની કિંમત શોધો:</para>
<para id="fs-id1171104402783"><m:math><m:mn>17</m:mn><m:mo>−</m:mo><m:mi>k</m:mi><m:mspace width="0.2em" /><m:mtext>જ્યારે</m:mtext><m:mspace width="0.2em" /></m:math>

<list id="eip-id1168466211298" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mi>k</m:mi><m:mo>=</m:mo><m:mn>19</m:mn><m:mspace width="0.2em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mi>k</m:mi><m:mo>=</m:mo><m:mn>−19</m:mn></m:math></item></list></para></problem>
<solution id="fs-id1549906">
<para id="fs-id1356896"><list id="eip-id1168468630680" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> −2 </item>
<item><span class="token">ⓑ</span> 36 </item></list></para></solution>
</exercise>
</note>
<note id="fs-id1171104386516" class="try">
<exercise id="fs-id1988718"><problem id="fs-id1579016">
<para id="fs-id1171104090763">દરેક પદાવલીની કિંમત શોધો:</para>
<para id="fs-id1264887"><m:math><m:mn>−5</m:mn><m:mo>−</m:mo><m:mi>b</m:mi><m:mspace width="0.2em" /><m:mtext>જ્યારે</m:mtext><m:mspace width="0.2em" /></m:math>

<list id="eip-id1168468395455" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>14</m:mn><m:mspace width="0.2em" /></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>−14</m:mn></m:math></item></list></para></problem>
<solution id="fs-id1726122">
<list id="eip-id1168466154650" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> −19 </item>
<item><span class="token">ⓑ</span> 9 </item></list></solution>
</exercise></note>
</section>
<section id="fs-id1516354">
<title>શબ્દસમૂહોને બીજગણિતીય પદાવલીઓમાં ફેરવો</title>
<para id="fs-id1494616">જ્યારે આપણે પહેલી વાર ક્રિયાનાં ચિહ્નો રજૂ કર્યાં હતાં, ત્યારે જોયું હતું કે પદાવલી <m:math><m:mrow><m:mi>a</m:mi><m:mo>−</m:mo><m:mi>b</m:mi></m:mrow></m:math> ને નીચે બતાવ્યા મુજબ ઘણી રીતે વાંચી શકાય છે.</para>
<figure id="CNX_BMath_Figure_03_03_025"><media id="fs-id1634010" alt="આ કોષ્ટકમાં છ હરોળ છે. પહેલી હરોળમાં a − b છે. બીજી હરોળમાં a ઓછા b લખેલું છે. ત્રીજી હરોળમાં a અને bનો તફાવત છે. ચોથી હરોળ bને aમાંથી બાદ કરવાનું કહે છે. પાંચમી હરોળમાં aમાંથી b બાદ કરેલું છે. છઠ્ઠી હરોળમાં b એ a કરતાં ઓછું છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_025.jpg" />
</media>
</figure><para id="fs-id2597337">આ પદાવલીમાં <m:math><m:mrow><m:mi>a</m:mi></m:mrow></m:math> અને <m:math><m:mrow><m:mi>b</m:mi></m:mrow></m:math> નો યોગ્ય ક્રમ રાખવાની કાળજી લો!</para>
<example id="fs-id764459">
<exercise id="fs-id2650597">
<problem id="fs-id1154213">

<para id="fs-id2300195">ગાણિતિક લખાવટમાં ફેરવો અને પછી સરળ કરો:</para>
<list id="fs-id265059711" list-type="enumerated" number-style="arabic" class="circled">
<item>
<span class="token">ⓐ</span> આ સંખ્યાઓનો તફાવત: <m:math><m:mrow><m:mn>13</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>−21</m:mn></m:mrow></m:math>
</item>

<item>
<span class="token">ⓑ</span> બાદ કરવાની સંખ્યા: <m:math><m:mrow><m:mn>24</m:mn></m:mrow></m:math> ; જેમાંથી બાદ કરવી છે તે સંખ્યા: <m:math><m:mrow><m:mn>−19</m:mn></m:mrow></m:math>
</item>
</list>
</problem>
<solution id="fs-id1826108">
<title>ઉકેલ</title>
<para id="fs-id2777674"><span class="token">ⓐ</span> “ <emphasis effect="italics">તફાવત</emphasis> ” એટલે બાદબાકી. સંખ્યાઓ જે ક્રમમાં આપેલી હોય એ જ ક્રમમાં તેમની બાદબાકી કરો.<newline />


<table id="eip-id1168467306164" class="unnumbered unstyled" aria-label="આકૃતિમાં ત્રણ હરોળ છે. પહેલી હરોળ 13 અને ઋણ 21નો તફાવત કહે છે. બીજી હરોળ ફેરવવાનું કહે છે અને તેમાં 13 ઓછા ઋણ 21 છે. ત્રીજી હરોળ સરળ કરવાનું કહે છે અને તેમાં 34 છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry />
   <entry><media id="eip-id1168467253324" alt="“13 અને −21નો તફાવત” લખેલું છે અને “તફાવત” શબ્દ લાલ રંગમાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_038_img-01.png" /></media></entry>
 </row>
 <row>
 <entry>ફેરવો.</entry>
  <entry><media id="eip-id1164271932460" alt="સફેદ પૃષ્ઠભૂમિ પર ગાણિતિક પદાવલી 13 − (−21) છે, જે ઋણ સંખ્યાની બાદબાકી દર્શાવે છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_038_img-02.png" /></media></entry>
 </row>
 <row>
 <entry>સરળ કરો.</entry>
  <entry><media id="eip-id1164271931625" alt="સફેદ પૃષ્ઠભૂમિ પર ઘેરા રંગમાં 34 સ્પષ્ટ રીતે દર્શાવેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_038_img-03.png" /></media></entry>
 </row>

</tbody>






</tgroup>
</table></para><para id="fs-id2173576"><span class="token">ⓑ</span> <emphasis effect="italics">બાદ કરો</emphasis> એટલે દૂર કરવાની સંખ્યા છે <m:math><m:mrow><m:mn>24</m:mn></m:mrow></m:math> અને તે આ સંખ્યામાંથી દૂર કરવી છે: <m:math><m:mrow><m:mn>−19</m:mn><m:mo>.</m:mo></m:mrow></m:math><newline />


<table id="eip-id1168468668595" class="unnumbered unstyled" aria-label="આકૃતિમાં ત્રણ હરોળ છે. પહેલી હરોળ 24ને ઋણ 19માંથી બાદ કરવાનું કહે છે. બીજી હરોળ ફેરવવાનું કહે છે અને તેમાં ઋણ 19 ઓછા 24 છે. ત્રીજી હરોળ સરળ કરવાનું કહે છે અને તેમાં ઋણ 43 છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry />
   <entry><media id="eip-id1168467162135" alt="“24ને −19માંથી બાદ કરો” લખેલું છે અને ગાણિતિક ક્રિયા કરવાની સૂચના આપે છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_039_img-01.png" /></media></entry>
 </row>
 <row>
 <entry>ફેરવો.</entry>
  <entry><media id="eip-id1164268627489" alt="સફેદ પૃષ્ઠભૂમિ પર ઘેરા રાખોડી રંગમાં ગાણિતિક પદાવલી −19 − 24 છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_039_img-02.png" /></media></entry>
 </row>
 <row>
 <entry>સરળ કરો.</entry>
  <entry><media id="eip-id1164271708012" alt="સફેદ પૃષ્ઠભૂમિ પર કાળા રંગમાં −43 લખેલું છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_039_img-03.png" /></media></entry>
 </row>

</tbody>




</tgroup>
</table></para></solution>
</exercise>
</example>
<note id="fs-id2691147" class="try">
<exercise id="fs-id2262843"><problem id="fs-id1390241">
<para id="fs-id2451491">ફેરવો અને સરળ કરો:</para>
<list id="eip-id1168468714481" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> આ સંખ્યાઓનો તફાવત: <m:math><m:mrow><m:mn>14</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>−23</m:mn></m:mrow></m:math></item>

<item><span class="token">ⓑ</span> બાદ કરવાની સંખ્યા: <m:math><m:mrow><m:mn>21</m:mn></m:mrow></m:math> ; જેમાંથી બાદ કરવી છે તે સંખ્યા: <m:math><m:mrow><m:mn>−17</m:mn></m:mrow></m:math></item></list></problem>
<solution id="fs-id1151539">
<list id="eip-id1168469805781" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> 14 − (−23) = 37 </item>
<item><span class="token">ⓑ</span> −17 − 21 = −38 </item></list></solution>
</exercise></note>
<note id="fs-id1171103126806" class="try">
<exercise id="fs-id2295496"><problem id="fs-id1608655">
<para id="fs-id1171104386671">ફેરવો અને સરળ કરો:</para>
<list id="eip-id1168468583720" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> આ સંખ્યાઓનો તફાવત: <m:math><m:mrow><m:mn>11</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>−19</m:mn></m:mrow></m:math></item>
<item><span class="token">ⓑ</span> બાદ કરવાની સંખ્યા: <m:math><m:mrow><m:mn>18</m:mn></m:mrow></m:math> ; જેમાંથી બાદ કરવી છે તે સંખ્યા: <m:math><m:mrow><m:mn>−11</m:mn></m:mrow></m:math></item></list></problem>
<solution id="fs-id612431">
<list id="eip-id1168466012756" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> 11 − (−19) = 30 </item>
<item><span class="token">ⓑ</span> −11 − 18 = −29 </item></list></solution>
</exercise></note>
</section>
<section id="fs-id2140266"><title>વ્યવહારુ પ્રશ્નોમાં પૂર્ણાંકોની બાદબાકી કરો</title><para id="fs-id2310042">શું શોધવાનું છે અથવા તેને શું કહેવું તે જ ન જાણતા હોઈએ તો કંઈક શોધવું મુશ્કેલ છે. તેથી વ્યવહારુ પ્રશ્ન ઉકેલતી વખતે પહેલાં આપણે શું શોધવાનું છે તે નક્કી કરવું જોઈએ. પછી તેને શોધવા જરૂરી માહિતી આપતો શબ્દસમૂહ લખી શકીએ. શબ્દસમૂહને પદાવલીમાં ફેરવીને જવાબ મેળવવા પદાવલી સરળ કરીશું. અંતે જવાબ અર્થપૂર્ણ છે તેની ખાતરી કરવા તેને વાક્યમાં સારાંશરૂપે લખીશું.</para>
<note id="fs-id1899211" class="howto"><title>વ્યવહારુ પ્રશ્નો ઉકેલો.</title><list id="eip-id1168467238278" list-type="enumerated" number-style="arabic" class="stepwise"><item>તમારે શું શોધવાનું છે તે ઓળખો.</item>
<item>તે શોધવા જરૂરી માહિતી આપતો શબ્દસમૂહ લખો.</item>
<item>શબ્દસમૂહને પદાવલીમાં ફેરવો.</item>
<item>પદાવલી સરળ કરો.</item>
<item>પ્રશ્નનો જવાબ પૂરા વાક્યમાં આપો.</item></list></note><example id="fs-id2306385">
<exercise id="fs-id2474717"><problem id="fs-id1859718">
<para id="fs-id1760903">સવારે ઇલિનૉઇના અર્બાનામાં તાપમાન <m:math><m:mrow><m:mn>11</m:mn></m:mrow></m:math> ડિગ્રી ફેરનહાઇટ હતું. બપોરના મધ્ય સુધીમાં તાપમાન ઘટીને <m:math><m:mrow><m:mn>−9</m:mn></m:mrow></m:math> ડિગ્રી ફેરનહાઇટ થયું. સવારના અને બપોરના તાપમાન વચ્ચે કેટલો તફાવત હતો?</para>
</problem>
<solution id="fs-id1931805">
<title>ઉકેલ</title>
<table id="eip-id1168467263240" class="unnumbered unstyled" summary="આ કોષ્ટક અજ્ઞાત રાશિ ઓળખવાથી અંતિમ જવાબ લખવા સુધી તાપમાનના તફાવતનો પ્રશ્ન પગલે પગલે ઉકેલવાની પ્રક્રિયા દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry>પગલું 1. આપણે શું શોધવાનું છે તે ઓળખો.</entry>
   <entry>સવારના અને બપોરના તાપમાન વચ્ચેનો તફાવત</entry>
 </row>
 <row>
 <entry>પગલું 2. તે શોધવા જરૂરી માહિતી આપતો શબ્દસમૂહ લખો.</entry>
  <entry>આ સંખ્યાઓનો તફાવત: <m:math><m:mn>11</m:mn></m:math> અને <m:math><m:mn>−9</m:mn></m:math></entry>
 </row>
 <row>
 <entry>પગલું 3. શબ્દસમૂહને પદાવલીમાં ફેરવો.<newline />“ <emphasis effect="italics">તફાવત</emphasis> ” શબ્દ બાદબાકી દર્શાવે છે.</entry>
  <entry><m:math><m:mn>11</m:mn><m:mo>−</m:mo><m:mo>(</m:mo><m:mn>−9</m:mn><m:mo>)</m:mo></m:math></entry>
 </row>
 <row>
 <entry>પગલું 4. પદાવલી સરળ કરો.</entry>
 <entry><m:math><m:mn>20</m:mn></m:math></entry>
 </row>
 <row>
 <entry>પગલું 5. પ્રશ્નનો જવાબ આપતું પૂરું વાક્ય લખો.</entry>
 <entry>તાપમાનમાં <m:math><m:mn>20</m:mn></m:math> ડિગ્રી ફેરનહાઇટનો તફાવત હતો.</entry>
 </row>

</tbody>



</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id1630451" class="try">
<exercise id="fs-id1523793">
<problem id="fs-id2283807">
<para id="fs-id1607618">સવારે અલાસ્કાના ઍન્કરેજમાં તાપમાન <m:math><m:mrow><m:mtext>15 ડિગ્રી ફેરનહાઇટ</m:mtext></m:mrow></m:math> હતું. બપોરના મધ્ય સુધીમાં તાપમાન ઘટીને શૂન્યથી <m:math><m:mrow><m:mn>30 degrees</m:mn></m:mrow></m:math> નીચે થયું. સવારના અને બપોરના તાપમાન વચ્ચે કેટલો તફાવત હતો?</para>
</problem>
<solution id="fs-id1360052">
<para id="fs-id2300465">45 ડિગ્રી ફેરનહાઇટ</para>
</solution>
</exercise>
</note>
<note id="fs-id1171103277265" class="try">
<exercise id="fs-id1328064">
<problem id="fs-id2223649">
<para id="fs-id2276833">બપોરના ભોજન સમયે ડેન્વરમાં તાપમાન <m:math><m:mrow><m:mn>−6</m:mn></m:mrow></m:math> ડિગ્રી ફેરનહાઇટ હતું. સૂર્યાસ્ત સુધીમાં તાપમાન ઘટીને <m:math><m:mrow><m:mtext>−15 ડિગ્રી ફેરનહાઇટ</m:mtext></m:mrow></m:math> થયું. બપોરના અને સૂર્યાસ્તના તાપમાન વચ્ચે કેટલો તફાવત હતો?</para>
</problem>
<solution id="fs-id2593978">
<para id="fs-id1618736">9 ડિગ્રી ફેરનહાઇટ</para>
</solution>
</exercise>
</note>
<para id="fs-id2150823">ભૂગોળમાં સમુદ્ર સપાટીથી નીચે આવેલા સ્થળોની ઊંચાઈ ઋણ સંખ્યાના ઉપયોગનું બીજું ઉદાહરણ પૂરું પાડે છે.</para>
<example id="fs-id2369853">
<exercise id="fs-id2296292"><problem id="fs-id2269228">
<para id="fs-id933986">દિનેશે કૅલિફૉર્નિયાના સૌથી ઊંચા બિંદુ માઉન્ટ વિટનીથી સૌથી નીચા બિંદુ ડેથ વૅલી સુધી પદયાત્રા કરી. માઉન્ટ વિટનીની ઊંચાઈ સમુદ્ર સપાટીથી <m:math><m:mrow><m:mn>14,497</m:mn></m:mrow></m:math> ફૂટ ઉપર અને ડેથ વૅલીની ઊંચાઈ સમુદ્ર સપાટીથી <m:math><m:mrow><m:mn>282</m:mn></m:mrow></m:math> ફૂટ નીચે છે. માઉન્ટ વિટની અને ડેથ વૅલીની ઊંચાઈમાં કેટલો તફાવત છે?</para>
</problem>
<solution id="fs-id1567366">
<title>ઉકેલ</title>


<table id="eip-id1168468370720" class="unnumbered unstyled" summary="માઉન્ટ વિટની અને ડેથ વૅલીની ઊંચાઈ વચ્ચેનો તફાવત ગણવાનો પગલે પગલે ઉકેલ."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry>પગલું 1. આપણે શું શોધવાનું છે?</entry>
   <entry>માઉન્ટ વિટની અને ડેથ વૅલીની ઊંચાઈ વચ્ચેનો તફાવત</entry>
 </row>
 <row>
 <entry>પગલું 2. શબ્દસમૂહ લખો.</entry>
  <entry>માઉન્ટ વિટનીની ઊંચાઈ − ડેથ વૅલીની ઊંચાઈ</entry>
 </row>
 <row>
 <entry>પગલું 3. ફેરવો.</entry>
 <entry><m:math><m:mn>14,497</m:mn><m:mo>−</m:mo><m:mo>(</m:mo><m:mn>−282</m:mn><m:mo>)</m:mo></m:math></entry>
 </row>
 <row>
 <entry>પગલું 4. સરળ કરો.</entry>
 <entry><m:math><m:mn>14,779</m:mn></m:math></entry>
 </row>
 <row>
 <entry>પગલું 5. પ્રશ્નનો જવાબ આપતું પૂરું વાક્ય લખો.</entry>
 <entry>ઊંચાઈમાં <m:math><m:mn>14,779</m:mn></m:math> ફૂટનો તફાવત છે.</entry>
 </row>

</tbody>








</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id1564483" class="try">
<exercise id="fs-id2149538">
<problem id="fs-id2933642">
<para id="fs-id2214153">એક દિવસે જૉન હવાઈના હલેઆકલા જ્વાળામુખરના <m:math><m:mrow><m:mn>10,023 foot</m:mn></m:mrow></m:math> ઊંચા શિખર સુધી ચાલ્યો. બીજા દિવસે સ્કૂબા ડાઇવિંગ કરતી વખતે તે સમુદ્ર સપાટીથી <m:math><m:mrow><m:mn>80 feet</m:mn></m:mrow></m:math> નીચે આવેલી ગુફા સુધી ડૂબકી લગાવી. હલેઆકલાના શિખરની ઊંચાઈ અને ગુફાની ઊંડાઈ વચ્ચે કેટલો તફાવત છે?</para>
</problem>
<solution id="fs-id2219306">
<para id="fs-id1516593">10,103 ફૂટ</para>
</solution>
</exercise>
</note>
<note id="fs-id1171103996779" class="try">
<exercise id="fs-id2212161">
<problem id="fs-id1379169">
<para id="fs-id3367870">નૉટિલસ સબમરીન પાણીની સપાટીથી <m:math><m:mrow><m:mn>340 feet</m:mn></m:mrow></m:math> નીચે અને એક્સપ્લોરર સબમરીન પાણીની સપાટીથી <m:math><m:mrow><m:mn>573 feet</m:mn></m:mrow></m:math> નીચે છે. નૉટિલસ અને એક્સપ્લોરરના સ્થાન વચ્ચે કેટલો તફાવત છે?</para>
</problem>
<solution id="fs-id1543061">
<para id="fs-id2351102">233 ફૂટ</para>
</solution>
</exercise>
</note>
<para id="fs-id2472276">પોતાના પૈસાનું સંચાલન કરતી વખતે ધન અને ઋણ બંને સંખ્યાઓ આવી શકે છે. તમારા ચેકિંગ ખાતામાં કદાચ <term class="no-emphasis" id="term-00005">ખાતાની જમા રકમ કરતાં વધુ ઉપાડ</term> કરવાની સુવિધા હોય. તેનો અર્થ એ છે કે બૅન્ક તમને ખાતામાં હોય એના કરતાં વધુ રકમના ચેક લખવા દે છે—જ્યાં સુધી બૅન્કને ખાતરી હોય કે તે તમારી પાસેથી રકમ પાછી મેળવી શકશે!</para>
<example id="fs-id2170723">
<exercise id="fs-id2196619"><problem id="fs-id2140729">
<para id="fs-id2300206">લેસ્લીના ચેકિંગ ખાતામાં <m:math><m:mrow><m:mtext>$25</m:mtext></m:mrow></m:math> છે અને તે આ રકમનો ચેક લખે છે: <m:math><m:mrow><m:mtext>$8.</m:mtext></m:mrow></m:math>
<list id="eip-id1168469566308" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> તે ચેક લખે પછી બાકી રકમ કેટલી છે?</item>
<item><span class="token">ⓑ</span> તે આ રકમનો બીજો ચેક લખે છે: <m:math><m:mrow><m:mtext>$20.</m:mtext></m:mrow></m:math> આ ચેક પછી નવી બાકી રકમ કેટલી છે?</item>
<item><span class="token">ⓒ</span> લેસ્લીની મિત્રએ કહ્યું કે લેસ્લીએ તેને જન્મદિવસના કાર્ડ સાથે આપેલો આ રકમનો ચેક ખોવાઈ ગયો: <m:math><m:mrow><m:mtext>$10</m:mtext></m:mrow></m:math> હવે લેસ્લીના ચેકિંગ ખાતામાં કેટલી બાકી રકમ છે?</item></list></para>
</problem>
<solution id="fs-id1937057"><title>ઉકેલ</title>


<table id="eip-id1168466711056" class="unnumbered unstyled" summary="આ કોષ્ટક ખાતાની બાકી રકમવાળો મૂળભૂત વ્યવહારુ પ્રશ્ન પ્રશ્નથી અંતિમ જવાબ સુધી ઉકેલવાનાં પગલાં દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓐ</span> </entry>
   <entry />
 </row>
 <row>
 <entry>આપણે શું શોધવાનું છે?</entry>
  <entry align="center">ખાતાની બાકી રકમ</entry>
 </row>
 <row>
 <entry>શબ્દસમૂહ લખો.</entry>
 <entry align="center"><m:math><m:mn>$25</m:mn></m:math> ઓછા <m:math><m:mn>$8</m:mn></m:math></entry>
 </row>
 <row>
 <entry>ફેરવો</entry>
 <entry align="center"><media id="eip-id1168464908697" alt="ચિત્રમાં $25 − $8 ગાણિતિક બાદબાકીનો પ્રશ્ન છે, જે પચ્ચીસ ડૉલર અને આઠ ડૉલર વચ્ચેનો તફાવત શોધવાની ક્રિયા દર્શાવે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_03_03_057_img-01.png" /></media></entry>
 </row>
 <row>
 <entry>સરળ કરો.</entry>
 <entry align="center"><media id="eip-id1168468513708" alt="સફેદ પૃષ્ઠભૂમિ પર કાળા રંગમાં $17 લખેલું છે, જે સત્તર ડૉલરની રકમ દર્શાવે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_03_03_057_img-02.png" /></media></entry>
 </row>
 <row>
 <entry>જવાબનું વાક્ય લખો.</entry>
 <entry>બાકી રકમ છે <m:math><m:mo>$</m:mo><m:mn>17</m:mn></m:math>.</entry>
 </row>

</tbody>










</tgroup>
</table><table id="eip-id1168469689180" class="unnumbered unstyled" summary="રકમ ઉપાડ્યા પછી બૅન્કની બાકી રકમ ગણવાનો પગલે પગલે ઉકેલ, જેમાં ઓવરડ્રાફ્ટની પરિસ્થિતિ દર્શાવેલી છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓑ</span> </entry>
   <entry />
 </row>
 <row>
 <entry>આપણે શું શોધવાનું છે?</entry>
  <entry align="center">નવી બાકી રકમ</entry>
 </row>
 <row>
 <entry>શબ્દસમૂહ લખો.</entry>
 <entry align="center"><m:math><m:mn>$17</m:mn></m:math> ઓછા <m:math><m:mn>$20</m:mn></m:math></entry>
 </row>
 <row>
 <entry>ફેરવો</entry>
 <entry align="center"><media id="eip-id1168466010260" alt="સફેદ પૃષ્ઠભૂમિ પર કાળા રંગમાં $17 − $20 કિંમતની શ્રેણી દર્શાવતું આંકડાકીય લખાણ છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_03_03_058_img-01.png" /></media></entry>
</row>
 <row>
 <entry>સરળ કરો.</entry>
 <entry align="center"><media id="eip-id1168469617802" alt="સફેદ પૃષ્ઠભૂમિ પર કાળા રંગમાં −$3 છે, જે ઋણ નાણાકીય મૂલ્ય અથવા ત્રણ ડૉલરનો ખર્ચ દર્શાવે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_03_03_058_img-02.png" /></media></entry>
 </row>
 <row>
 <entry>જવાબનું વાક્ય લખો.</entry>
 <entry>તેણે ખાતાની જમા રકમ કરતાં આટલી વધુ રકમ ઉપાડી છે: <m:math><m:mo>$</m:mo><m:mn>3</m:mn></m:math>.</entry>
 </row>

</tbody>








</tgroup>
</table><table id="eip-id1168469468765" class="unnumbered unstyled" summary="પ્રશ્ન ઓળખવાથી અંતિમ જવાબ લખવા સુધી નવી નાણાકીય બાકી રકમ ગણવાનો પગલે પગલે ઉકેલ."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓒ</span> </entry>
   <entry />
 </row>
 <row>
 <entry>આપણે શું શોધવાનું છે?</entry>
  <entry align="center">નવી બાકી રકમ</entry>
 </row>
 <row>
 <entry>શબ્દસમૂહ લખો.</entry>
 <entry align="center"><m:math><m:mn>$10</m:mn></m:math> કરતાં વધુ <m:math><m:mo>−</m:mo><m:mn>$3</m:mn></m:math></entry>
 </row>
 <row>
 <entry>ફેરવો</entry>
 <entry align="center"><media id="eip-id1168467262968" alt="ચિત્રમાં સરવાળાની પદાવલી −$3 + $10 છે. ધન $10ને ઋણ $3માં ઉમેરવાથી મળતું ચોખ્ખું ધન મૂલ્ય $7 છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_03_03_059_img-01.png" /></media></entry>
 </row>
 <row>
 <entry>સરળ કરો.</entry>
<entry align="center"><media id="eip-id1168467261059" alt="ચિત્રમાં $7 લખેલું છે, જે સાત ડૉલરની રકમ દર્શાવે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_03_03_059_img-02.png" /></media></entry>
 </row>
 <row>
 <entry>જવાબનું વાક્ય લખો.</entry>
 <entry>હવે બાકી રકમ છે <m:math><m:mo>$</m:mo><m:mn>7</m:mn></m:math>.</entry>
 </row>

</tbody>








</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id2784545" class="try">
<exercise id="fs-id1526060"><problem id="fs-id1366190">
<para id="fs-id1899859">અરાસેલીના ચેકિંગ ખાતામાં <m:math><m:mrow><m:mtext>$75</m:mtext></m:mrow></m:math> છે અને તે આ રકમનો ચેક લખે છે: <m:math><m:mrow><m:mtext>$27</m:mtext><m:mo>.</m:mo></m:mrow></m:math>
<list id="eip-id1168468504993" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> તે ચેક લખે પછી બાકી રકમ કેટલી છે?</item>
<item><span class="token">ⓑ</span> તે આ રકમનો બીજો ચેક લખે છે: <m:math><m:mrow><m:mtext>$50</m:mtext><m:mo>.</m:mo></m:mrow></m:math> નવી બાકી રકમ કેટલી છે?</item>
<item><span class="token">ⓒ</span> તેણે એક સેવાભાવી સંસ્થાને મોકલેલો આ રકમનો ચેક ક્યારેય વટાવાયો નહોતો: <m:math><m:mrow><m:mtext>$20</m:mtext></m:mrow></m:math> હવે અરાસેલીના ચેકિંગ ખાતામાં કેટલી બાકી રકમ છે?</item></list></para>
</problem>
<solution id="fs-id1762208">
<list id="eip-id1168466271780" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> $48 </item>
<item><span class="token">ⓑ</span> −$2 </item>
<item><span class="token">ⓒ</span> $18 </item></list></solution>
</exercise></note>
<note id="fs-id1171102863689" class="try">
<exercise id="fs-id1231745"><problem id="fs-id1186108">
<para id="fs-id2926661">જેનેવિવના બૅન્ક ખાતામાં જમા રકમ કરતાં વધુ ઉપાડ થયો હતો અને તેની બાકી રકમ છે <m:math><m:mrow><m:mo>−</m:mo><m:mtext>$78</m:mtext><m:mo>.</m:mo></m:mrow></m:math>
<list id="eip-id1168468773891" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> તે બાળસંભાળ કરીને કમાયેલી આ રકમનો ચેક જમા કરે છે: <m:math><m:mrow><m:mtext>$24</m:mtext></m:mrow></m:math> નવી બાકી રકમ કેટલી છે?</item>
<item><span class="token">ⓑ</span> તે આ રકમનો બીજો ચેક જમા કરે છે: <m:math><m:mrow><m:mtext>$49</m:mtext><m:mo>.</m:mo></m:mrow></m:math> શું તેનું દેવું ચૂકવાઈ ગયું છે? તેની નવી બાકી રકમ કેટલી છે?</item></list></para>
</problem>
<solution id="fs-id1546273">
<para id="fs-id1348086"><list id="eip-id1168468476118" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> −$54 </item>
<item><span class="token">ⓑ</span> ના, −$5 </item></list></para></solution>
</exercise></note>
<note id="eip-id1168468743382" class="links-to-literacy">“એલિવેટર મૅજિક” નામની સાક્ષરતા સાથે જોડાયેલી પ્રવૃત્તિ તમને આ વિભાગમાં આવરી લીધેલા વિષયોને બીજી રીતે જોવાની તક આપશે.</note>
<note id="fs-id2668647" class="media-2"><title>વધારાનાં ઑનલાઇન સાધનો જુઓ</title><list id="fs-id1630561" display="block">
<item><link url="https://openstaxcollege.org/l/24AddSubtrInteg">પૂર્ણાંકોનો સરવાળો અને બાદબાકી</link></item>
<item><link url="https://openstaxcollege.org/l/24Subtrinteger">રંગીન કાઉન્ટર વડે પૂર્ણાંકોની બાદબાકી</link></item>
<item><link url="https://openstaxcollege.org/l/24Subtractbasic">પૂર્ણાંકોની બાદબાકીના મૂળભૂત ખ્યાલો</link></item>
<item><link url="https://openstaxcollege.org/l/24introintegerr">પૂર્ણાંકોની બાદબાકી</link></item>
<item><link url="https://openstaxcollege.org/l/24integerappp">પૂર્ણાંકનો વ્યવહારુ ઉપયોગ</link></item>
</list>
</note></section><section id="fs-id2280141" class="key-concepts">
<title>મુખ્ય ખ્યાલો</title>
<list id="fs-id2662238" list-type="bulleted" bullet-style="bullet"><item><emphasis effect="bold">પૂર્ણાંકોની બાદબાકી</emphasis><table id="eip-id1168466110349" summary="આ કોષ્ટક સીધી બાદબાકી અને શૂન્ય બનાવતી જોડીઓ જરૂરી હોય એવા કિસ્સાઓનાં ઉદાહરણો તથા ખ્યાલનાં પગલાં વડે પૂર્ણાંકોની બાદબાકીની રીતો દર્શાવે છે."><tgroup cols="3">  <colspec colnum="1" colname="c1" />
    <colspec colnum="2" colname="c2" />
    <colspec colnum="3" colname="c3" /><tbody>
  <row>
    <entry align="center"><m:math><m:mn>5</m:mn><m:mo>–</m:mo><m:mn>3</m:mn></m:math></entry>
    <entry align="center"><m:math><m:mn>–5</m:mn><m:mo>–</m:mo><m:mo>(</m:mo><m:mn>–3</m:mn><m:mo>)</m:mo></m:math></entry>
  </row>
  <row>
    <entry align="center"><m:math><m:mn>2</m:mn></m:math></entry>
    <entry align="center"><m:math><m:mn>–2</m:mn></m:math></entry>
  </row>
  <row>
    <entry align="center">2 ધન</entry>
    <entry align="center">2 ઋણ</entry>
  </row>

  <row>
    <entry namest="c1" nameend="c2">દૂર કરવાના રંગના પૂરતા કાઉન્ટર હોય ત્યારે બાદબાકી કરો.</entry>
  </row>
  <row>
    <entry align="center"><m:math><m:mn>–5</m:mn><m:mo>–</m:mo><m:mn>3</m:mn></m:math></entry>
    <entry align="center"><m:math><m:mn>5</m:mn><m:mo>–</m:mo><m:mo>(</m:mo><m:mn>–3</m:mn><m:mo>)</m:mo></m:math></entry>
  </row>
  <row>
    <entry align="center"><m:math><m:mn>–8</m:mn></m:math></entry>
    <entry align="center"><m:math><m:mn>8</m:mn></m:math></entry>
  </row>
  <row>
    <entry align="center">5 ઋણ કાઉન્ટર છે અને 3 ધન કાઉન્ટર બાદ કરવા છે</entry>
    <entry align="center">5 ધન કાઉન્ટર છે અને 3 ઋણ કાઉન્ટર બાદ કરવા છે</entry>
  </row>
  <row>
    <entry align="center">શૂન્ય બનાવતી જોડીઓ જરૂરી છે</entry>
    <entry align="center">શૂન્ય બનાવતી જોડીઓ જરૂરી છે</entry>
  </row>

  <row>
    <entry namest="c1" nameend="c2">દૂર કરવા માટે પૂરતા કાઉન્ટર ન હોય ત્યારે શૂન્ય બનાવતી જોડીઓ ઉમેરો.</entry>
  </row>

</tbody>
</tgroup>
</table></item>
<item><emphasis effect="bold">બાદબાકીનો ગુણધર્મ</emphasis>
<list id="eip-id1168466068564" list-type="bulleted" bullet-style="open-circle"><item><m:math><m:mrow><m:mi>a</m:mi><m:mo>−</m:mo><m:mi>b</m:mi><m:mo>=</m:mo><m:mi>a</m:mi><m:mo>+</m:mo><m:mo stretchy="false">(</m:mo><m:mtext mathvariant="italic">−b</m:mtext><m:mo stretchy="false">)</m:mo></m:mrow></m:math></item>

<item><m:math><m:mrow><m:mi>a</m:mi><m:mo>−</m:mo><m:mo>(</m:mo><m:mi>−b</m:mi><m:mo>)</m:mo><m:mo>=</m:mo><m:mi>a</m:mi><m:mo>+</m:mo><m:mi>b</m:mi></m:mrow></m:math></item></list>
</item>
<item><emphasis effect="bold">વ્યવહારુ પ્રશ્નો ઉકેલો</emphasis>
<list id="eip-id1168469817896" list-type="bulleted" bullet-style="open-circle"><item>પગલું 1. તમારે શું શોધવાનું છે તે ઓળખો.</item>
<item>પગલું 2. તે શોધવા જરૂરી માહિતી આપતો શબ્દસમૂહ લખો.</item>
<item>પગલું 3. શબ્દસમૂહને પદાવલીમાં ફેરવો.</item>
<item>પગલું 4. પદાવલી સરળ કરો.</item>
<item>પગલું 5. પ્રશ્નનો જવાબ પૂરા વાક્યમાં આપો.</item></list></item></list></section>
<section id="fs-id2129487" class="section-exercises">
<section id="fs-id1531346" class="practice-perfect"><title>અભ્યાસથી નિપુણતા મળે</title><para id="fs-id2686450"><emphasis effect="bold">પૂર્ણાંકોની બાદબાકીને નમૂના દ્વારા દર્શાવો</emphasis> </para><para id="eip-774">નીચેના અભ્યાસમાં દરેક પદાવલીને નમૂના દ્વારા દર્શાવો અને સરળ કરો.</para><exercise id="fs-id2954860">
<problem id="fs-id1398080">
<para id="fs-id2261170"><m:math><m:mrow><m:mn>8</m:mn><m:mo>−</m:mo><m:mn>2</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1161100">
<para id="fs-id1171103061756"><newline />
<media id="fs-id2365306" alt="આકૃતિમાં આછા ગુલાબી રંગના 8 ધન કાઉન્ટરની હરોળ છે. પહેલા 2 કાઉન્ટર ઘેરેલા છે અને છેલ્લા 6થી અલગ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_201_img.jpg" />
</media><newline />6</para>
</solution>
</exercise>
<exercise id="fs-id2296014">
<problem id="fs-id1581238">
<para id="fs-id1798410"><m:math><m:mrow><m:mn>9</m:mn><m:mo>−</m:mo><m:mn>3</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1185457">
<problem id="fs-id1201840">
<para id="fs-id2323011"><m:math><m:mrow><m:mn>−5</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2264921">
<para id="fs-id1171104400216"><newline />
<media id="fs-id2220213" alt="આકૃતિમાં ઘેરા ગુલાબી રંગના 5 કાઉન્ટરની હરોળ છે. પહેલો કાઉન્ટર ઘેરેલો છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_203_img.jpg" />
</media><newline />−4</para>
</solution>
</exercise>
<exercise id="fs-id892326">
<problem id="fs-id1515880">
<para id="fs-id1560842"><m:math><m:mrow><m:mn>−6</m:mn><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2433732">
<problem id="fs-id2778086">
<para id="fs-id2812397"><m:math><m:mrow><m:mn>−5</m:mn><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id1257568">
<para id="fs-id1171103004042"><newline /><media id="fs-id1363559" alt="આકૃતિમાં ઘેરા ગુલાબી રંગના 9 ઋણ કાઉન્ટરની હરોળ છે; પહેલા 5 અને છેલ્લા 4 વચ્ચે અંતર છે. છેલ્લા 4ની નીચે આછા ગુલાબી રંગના 4 ધન કાઉન્ટર છે અને આ ચાર ધન કાઉન્ટર ઘેરેલા છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_03_205_img.jpg" />
</media><newline />
−9</para>
</solution>
</exercise>
