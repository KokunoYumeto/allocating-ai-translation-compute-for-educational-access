<?xml version='1.0' encoding='utf-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" xmlns:ns1="http://cnx.rice.edu/mdml" xml:lang="gu-Gujr-IN">
<title>પૂર્ણાંકોનો પરિચય</title>
<metadata>
  <ns1:content-id>m81275</ns1:content-id>
  <ns1:title>પૂર્ણાંકોનો પરિચય</ns1:title>
  <ns1:abstract><para id="para-00001">આ વિભાગના અંતે તમે:</para>
<list id="list-00001">
<item>સંખ્યારેખા પર ધન અને ઋણ સંખ્યાઓનું સ્થાન દર્શાવી શકશો</item>
<item>ધન અને ઋણ સંખ્યાઓનો ક્રમ નક્કી કરી શકશો</item>
<item>વિરોધી સંખ્યાઓ શોધી શકશો</item>
<item>નિરપેક્ષ મૂલ્ય ધરાવતી પદાવલીઓ સરળ કરી શકશો</item>
<item>શબ્દસમૂહોને પૂર્ણાંક ધરાવતી પદાવલીઓમાં ફેરવી શકશો</item>
</list></ns1:abstract>
  <ns1:uuid>ff579e3c-dd25-47d2-9e73-edfdee3ace70</ns1:uuid>
</metadata>

<content>
<note id="fs-id1618903" class="be-prepared">
<para id="fs-id1829004">શરૂઆત કરતાં પહેલાં તૈયારી તપાસવાના આ પ્રશ્નો ઉકેલો.</para>
<exercise id="fs-idm319497872">
<problem id="fs-idm325632688">
<para id="fs-idm304804576">સંખ્યારેખા પર દર્શાવો: <m:math><m:mrow><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mtext> અને </m:mtext><m:mspace width="0.2em" /><m:mn>3</m:mn></m:mrow></m:math> .<newline />
આ પ્રશ્ન ન આવડ્યો હોય તો ફરી જુઓ: <link target-id="fs-id1262372" document="m81243" />.</para>
</problem>
<solution id="fs-idm323440240">
<para id="fs-idm338503440"><media id="fs-id1654574" alt="આડી સંખ્યારેખા પર −5થી 5 સુધીના પૂર્ણાંક દર્શાવ્યા છે. નારંગી બિંદુઓ 0, 1 અને 3 પર છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_205_img.jpg" />
</media></para>
</solution>
</exercise></note>
<note id="fs-id1618203" class="be-prepared">
<exercise id="fs-idm319662176">
<problem id="fs-idm324326592">
<para id="fs-idm354172464">યોગ્ય નિશાની ભરો: <m:math><m:mrow><m:mtext> (=, &lt;, અથવા &gt;): </m:mtext><m:mspace width="0.2em" /><m:mn>2</m:mn><m:mo>___</m:mo><m:mn>4</m:mn></m:mrow></m:math><newline />
આ પ્રશ્ન ન આવડ્યો હોય તો ફરી જુઓ: <link target-id="fs-id1714381" document="m81268" />.</para>
</problem>
<solution id="fs-idm325756592">
<para id="fs-idm323042304"><m:math><m:mo>&lt;</m:mo></m:math></para>
</solution>
</exercise>
</note>
<section id="fs-id2708003">
<title>સંખ્યારેખા પર ધન અને ઋણ સંખ્યાઓનું સ્થાન દર્શાવો</title>
<para id="fs-id1820372">શું તમે એવા સ્થળે રહો છો જ્યાં શિયાળો ખૂબ ઠંડો હોય? શું તમે કદી શૂન્યથી નીચા તાપમાનનો અનુભવ કર્યો છે? જો હા, તો તમે ઋણ સંખ્યાઓથી પહેલેથી પરિચિત છો. <term id="term-00001">ઋણ સંખ્યા</term> એ એવી સંખ્યા છે જે આ સંખ્યા કરતાં નાની હોય: <m:math><m:mrow><m:mn>0</m:mn><m:mo>.</m:mo></m:mrow></m:math> ખૂબ નીચા તાપમાનને શૂન્યથી નીચેની ડિગ્રીમાં માપીએ છીએ અને તેને વર્ણવી શકીએ <term class="no-emphasis" id="term-00002">ઋણ સંખ્યાઓ</term> વડે. ઉદાહરણ તરીકે, <m:math><m:mn>−1</m:mn><m:mtext> °F </m:mtext></m:math> (જેને “ઋણ એક ડિગ્રી ફેરનહાઇટ” વાંચીએ) છે <m:math><m:mrow><m:mn>1</m:mn><m:mspace width="0.2em" /><m:mtext> ડિગ્રી </m:mtext></m:mrow></m:math> નીચે, આ તાપમાનથી: <m:math><m:mrow><m:mn>0</m:mn><m:mo>.</m:mo></m:mrow></m:math> સંખ્યા ઋણ હોવાનું દર્શાવવા તેની પહેલાં “−” નિશાની લખાય છે. <link target-id="CNX_BMath_Figure_03_01_002" /> ત્યાં તાપમાન દર્શાવ્યું છે: <m:math><m:mn>−20</m:mn><m:mtext> °F </m:mtext><m:mo>,</m:mo></m:math> જે છે <m:math><m:mrow><m:mn>20</m:mn><m:mspace width="0.2em" /><m:mtext> ડિગ્રી </m:mtext></m:mrow></m:math> નીચે, આ તાપમાનથી: <m:math><m:mrow><m:mn>0</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<figure id="CNX_BMath_Figure_03_01_002">
<media id="fs-id1724574" alt="ચિત્રમાં ડિગ્રી ફેરનહાઇટના માપવાળું થર્મોમીટર છે. થર્મોમીટરમાં 20 ડિગ્રી તાપમાન દર્શાવ્યું છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_002.jpg" />
</media>
<caption>શૂન્યથી નીચાં તાપમાનને ઋણ સંખ્યાઓથી વર્ણવીએ છીએ.</caption>
</figure>
<para id="fs-id3383000">ઋણ સંખ્યાઓ માત્ર તાપમાન માટે નથી. બૅન્કમાં <term class="no-emphasis" id="term-00003">ખાતાની જમા રકમ કરતાં વધુ ઉપાડ</term> ઋણ સંખ્યાનું બીજું ઉદાહરણ છે. કોઈ વ્યક્તિ પોતાના ખાતામાં હોય તેનાથી વધુ રકમનો ચેક લખે, તો ખાતાની બાકી રકમ ઋણ થાય છે.</para>
<para id="fs-id1299001">ઊંચાઈ પણ દર્શાવી શકાય <term class="no-emphasis" id="term-00004">ઋણ સંખ્યાઓ</term> વડે. સમુદ્રની સપાટીએ <term class="no-emphasis" id="term-00005">ઊંચાઈ</term> છે <m:math><m:mrow><m:mtext> 0 ફૂટ </m:mtext><m:mo>.</m:mo></m:mrow></m:math> સમુદ્રની સપાટીથી ઉપરની ઊંચાઈ ધન અને તેની નીચેની ઊંચાઈ ઋણ છે. ઇઝરાયલ અને જોર્ડનની સરહદે આવેલા મૃત સમુદ્રની ઊંચાઈ સમુદ્રની સપાટીથી લગભગ <m:math><m:mrow><m:mn>1,302</m:mn><m:mspace width="0.2em" /><m:mtext> ફૂટ </m:mtext></m:mrow></m:math> નીચે છે, તેથી મૃત સમુદ્રની ઊંચાઈ આ રીતે દર્શાવી શકાય: <m:math><m:mn>−1,302</m:mn><m:mspace width="0.2em" /><m:mtext> ફૂટ </m:mtext><m:mo>.</m:mo></m:math> જુઓ <link target-id="CNX_BMath_Figure_03_01_003" />.</para>
<figure id="CNX_BMath_Figure_03_01_003">
<media id="fs-id1223650" alt="ચિત્રમાં ઇઝરાયલના કિનારાનું બાજુથી દૃશ્ય છે, જેમાં જુદી ઊંચાઈઓ દર્શાવી છે. ભૂમધ્ય સમુદ્ર પાસે 0 ફૂટ ઊંચાઈ અને મૃત સમુદ્ર પાસે ઋણ 1302 ફૂટ ઊંચાઈ લખેલી છે. જોર્ડન દેશનું નામ પણ ચિત્રમાં છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_003.jpg" />
</media>
<caption>ભૂમધ્ય સમુદ્રની સપાટીની ઊંચાઈ છે <m:math><m:mrow><m:mn>0</m:mn><m:mspace width="0.2em" /><m:mtext> ફૂટ </m:mtext><m:mo>.</m:mo></m:mrow></m:math> આકૃતિ દર્શાવે છે કે નજીકના પર્વતોની ઊંચાઈ વધુ (ધન) છે, જ્યારે મૃત સમુદ્રની ઊંચાઈ ઓછી (ઋણ) છે.</caption>
</figure>
<para id="fs-id2048600">સમુદ્રની સપાટી નીચેનું ઊંડાણ પણ ઋણ સંખ્યાઓથી વર્ણવીએ છીએ. ઉદાહરણ તરીકે, સબમરીન આટલા ઊંડાણે ઊતરે: <m:math><m:mrow><m:mn>500</m:mn><m:mspace width="0.2em" /><m:mtext> ફૂટ </m:mtext><m:mo>.</m:mo></m:mrow></m:math> તો તેનું સ્થાન હશે <m:math><m:mn>−500</m:mn><m:mspace width="0.2em" /><m:mtext> ફૂટ </m:mtext></m:math> જે દર્શાવ્યું છે <link target-id="CNX_BMath_Figure_03_01_004" />.</para>
<figure id="CNX_BMath_Figure_03_01_004">
<media id="fs-id1640657" alt="ચિત્રમાં પાણીની નીચે સબમરીન છે. પાણીમાં ફૂટમાં માપેલી ઊભી સંખ્યારેખા પણ છે. સંખ્યારેખા પર સપાટીએ 0 ફૂટ અને પાણીની નીચે સબમરીનના સ્થાને ઋણ 500 ફૂટ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_004.jpg" />
</media>
<caption>સમુદ્રની સપાટી નીચેના ઊંડાણને ઋણ સંખ્યાઓથી વર્ણવીએ છીએ. સબમરીન <m:math><m:mrow><m:mn>500</m:mn><m:mspace width="0.2em" /><m:mtext> ફૂટ </m:mtext></m:mrow></m:math> સમુદ્રની સપાટીથી નીચે હોય, તો તેનું સ્થાન છે <m:math><m:mn>−500</m:mn><m:mspace width="0.2em" /><m:mtext> ફૂટ </m:mtext><m:mo>.</m:mo></m:math></caption>
</figure>
<para id="fs-id1103886">ધન અને <term class="no-emphasis" id="term-00006">ઋણ સંખ્યાઓ</term> બંને દર્શાવી શકાય <term class="no-emphasis" id="term-00007">સંખ્યારેખા</term> પર. યાદ કરો કે <link document="m81244">પૂર્ણ સંખ્યાઓનો સરવાળો કરો</link> માં બનાવેલી સંખ્યારેખા શરૂ થતી હતી <m:math><m:mrow><m:mn>0</m:mn></m:mrow></m:math> થી અને તેમાં <term class="no-emphasis" id="term-00008">ગણતરીની સંખ્યાઓ</term> જમણી તરફ વધતી દર્શાવેલી હતી, જુઓ <link target-id="CNX_BMath_Figure_03_01_005" />. ગણતરીની સંખ્યાઓ <m:math><m:mrow><m:mtext>(1, 2, 3, …)</m:mtext></m:mrow></m:math> સંખ્યારેખા પર બધી ધન છે. આપણે વત્તાની નિશાની, <m:math><m:mrow><m:mo>+</m:mo><m:mo>,</m:mo></m:mrow></m:math> ધન સંખ્યાની પહેલાં લખી શકીએ; જેમ કે <m:math><m:mo>+</m:mo><m:mn>2</m:mn></m:math> અથવા <m:math><m:mo>+</m:mo><m:mn>3</m:mn><m:mo>,</m:mo></m:math> પરંતુ સામાન્ય રીતે વત્તાની નિશાની છોડીને માત્ર સંખ્યા લખીએ છીએ. કોઈ નિશાની ન હોય, તો સંખ્યાને ધન માનવામાં આવે છે.</para><figure id="CNX_BMath_Figure_03_01_005">
<media id="fs-id1941342" alt="ચિત્રમાં 0થી 6 સુધીના માપવાળી સંખ્યારેખા છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_005.jpg" />
</media>
</figure>
<para id="fs-id824419">હવે સંખ્યારેખાને લંબાવવાની જરૂર છે, જેથી તેમાં <term class="no-emphasis" id="term-00009">ઋણ સંખ્યાઓ</term> સામેલ થાય. શૂન્યની ડાબી તરફ કેટલાક એકમના ચિહ્નો મૂકીએ; તેમની વચ્ચેનું અંતર ધન બાજુ જેટલું જ રાખીએ. આ ચિહ્નો પર ઋણ સંખ્યાઓ લખીએ: <m:math><m:mn>−1</m:mn></m:math> પ્રથમ ચિહ્ન પર, જે આની ડાબે છે: <m:math><m:mrow><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>−2</m:mn></m:mrow></m:math> પછીના ચિહ્ન પર, અને આમ આગળ. જુઓ <link target-id="CNX_BMath_Figure_03_01_006" />.</para>
<figure id="CNX_BMath_Figure_03_01_006"><media id="fs-id2518518" alt="ચિત્રમાં વચ્ચે 0 ધરાવતી સંખ્યારેખા છે. ધન સંખ્યાઓ 1થી 4 છે આની જમણે: 0; ઋણ સંખ્યાઓ ઋણ 1થી ઋણ 4 છે આની ડાબે: 0.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_006.jpg" />
</media>

<caption>સંખ્યારેખા પર ધન સંખ્યાઓ શૂન્યની જમણે છે. ઋણ સંખ્યાઓ શૂન્યની ડાબે છે. શૂન્ય વિશે શું? શૂન્ય ધન પણ નથી અને ઋણ પણ નથી.</caption></figure><para id="fs-id2328420">રેખાના બંને છેડાના તીર દર્શાવે છે કે સંખ્યારેખા બંને દિશામાં અનંત સુધી લંબાય છે. સૌથી મોટી <term class="no-emphasis" id="term-00010">ધન સંખ્યા</term>  હોતી નથી. તેવી જ રીતે અસ્તિત્વમાં નથી સૌથી નાની  <term class="no-emphasis" id="term-00011">ઋણ સંખ્યા</term>. </para><note id="eip-id1170386571872" class="manipulative-math"><para id="eip-id1170379572629">ગણિતનાં સાધનો સાથેની પ્રવૃત્તિ “સંખ્યારેખા—ભાગ 2” કરવાથી પૂર્ણાંકોની સમજ વધુ સારી થશે.</para></note>
<example id="fs-id1975221">
<exercise id="fs-id1999438">
<problem id="fs-id1926749"><para id="fs-id2770947">સંખ્યારેખા પર આ સંખ્યાઓ દર્શાવો:<newline />
<list id="eip-id1168469856984" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>3</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−3</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓒ</span> <m:math><m:mspace width="0.2em" /><m:mn>−2</m:mn></m:math></item>

</list></para></problem>
<solution id="fs-id2312161">
<title>ઉકેલ</title>
<para id="fs-id1977328">સંખ્યારેખા દોરો. <m:math><m:mrow><m:mn>0</m:mn></m:mrow></m:math> વચ્ચે દર્શાવો અને ડાબે તથા જમણે કેટલાક એકમોના અંક લખો.</para>
<para id="fs-id2230862"><list id="eip-id1168469873401" list-type="enumerated" number-style="arabic" class="circled"><item>ⓐ આ સંખ્યા દર્શાવવા: <m:math><m:mrow><m:mn>3</m:mn><m:mo>,</m:mo></m:mrow></m:math> અહીંથી શરૂ કરો: <m:math><m:mrow><m:mn>0</m:mn></m:mrow></m:math> અને જમણે ત્રણ એકમ ગણો. બિંદુ મૂકો, જુઓ <link target-id="CNX_BMath_Figure_03_01_007" />.<newline />
<figure id="CNX_BMath_Figure_03_01_007">
<media id="fs-id1364559" alt="ચિત્રમાં ઋણ 4થી 4 સુધીની સંખ્યારેખા છે, જેમાં 3 પર બિંદુ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_007.jpg" />
</media></figure></item>

<item>ⓑ આ સંખ્યા દર્શાવવા: <m:math><m:mn>−3</m:mn><m:mo>,</m:mo></m:math> અહીંથી શરૂ કરો: <m:math><m:mrow><m:mn>0</m:mn></m:mrow></m:math> અને ડાબે ત્રણ એકમ ગણો. બિંદુ મૂકો, જુઓ <link target-id="CNX_BMath_Figure_03_01_008" />.<newline />
<figure id="CNX_BMath_Figure_03_01_008">
<media id="fs-id1384336" alt="ચિત્રમાં ઋણ 4થી 4 સુધીની સંખ્યારેખા છે, જેમાં ઋણ 3 પર બિંદુ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_008.jpg" />
</media></figure></item>

<item>ⓒ આ સંખ્યા દર્શાવવા: <m:math><m:mn>−2</m:mn><m:mo>,</m:mo></m:math> અહીંથી શરૂ કરો: <m:math><m:mrow><m:mn>0</m:mn></m:mrow></m:math> અને ડાબે બે એકમ ગણો. બિંદુ મૂકો, જુઓ <link target-id="CNX_BMath_Figure_03_01_009" />.<newline />
<figure id="CNX_BMath_Figure_03_01_009">
<media id="fs-id1698474" alt="ચિત્રમાં ઋણ 4થી 4 સુધીની સંખ્યારેખા છે, જેમાં ઋણ 2 પર બિંદુ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_009.jpg" />
</media></figure></item></list></para></solution>
</exercise>
</example>
<note id="fs-id1505758" class="try">
<exercise id="fs-id1561194">
<problem id="fs-id2571541">
<para id="fs-id1374512">સંખ્યારેખા પર આ સંખ્યાઓ દર્શાવો.
<list id="eip-id1168468266645" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>1</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−1</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓒ</span> <m:math><m:mspace width="0.2em" /><m:mn>−4</m:mn></m:math></item>
</list></para></problem>
<solution id="fs-id1425869">
<para id="fs-id1171105209735"><newline />
<media id="fs-id3243188" alt="ચિત્રમાં સંખ્યારેખા છે. ઋણ 4ના બિંદુ પર c, ઋણ 1ના બિંદુ પર b અને 1ના બિંદુ પર a અક્ષર લખેલો છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_010_img.jpg" />
</media></para>
</solution>
</exercise>
</note>
<note id="fs-id15057580" class="try">
<exercise id="fs-id1396107">
<problem id="fs-id1898121">
<para id="fs-id13745120">સંખ્યારેખા પર આ સંખ્યાઓ દર્શાવો.
<list id="eip-id1168468230668" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>−4</m:mn><m:mspace width="1em" /></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>4</m:mn><m:mspace width="1em" /> </m:math></item>
<item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>−1</m:mn></m:math></item>
</list></para></problem>
<solution id="fs-id1120270">
<para id="fs-id1171105509679"><newline />
<media id="fs-id772532" alt="ચિત્રમાં સંખ્યારેખા છે. ઋણ 4ના બિંદુ પર a, ઋણ 1ના બિંદુ પર c અને 4ના બિંદુ પર b અક્ષર લખેલો છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_011_img.jpg" />
</media></para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1376292">
<title>ધન અને ઋણ સંખ્યાઓનો ક્રમ નક્કી કરો</title>
<para id="fs-id1345204">આપણે <term class="no-emphasis" id="term-00012">સંખ્યારેખા</term> વાપરીને ધન અને ઋણ સંખ્યાઓની સરખામણી તથા તેમનો ક્રમ નક્કી કરી શકીએ. ડાબેથી જમણે જતાં સંખ્યાનું મૂલ્ય વધે છે. જમણેથી ડાબે જતાં મૂલ્ય ઘટે છે. જુઓ <link target-id="CNX_BMath_Figure_03_01_012" />.</para>
<figure id="CNX_BMath_Figure_03_01_012">
<media id="fs-id3351071" alt="ચિત્રમાં સંખ્યારેખા છે. સંખ્યારેખાની ઉપર જમણે બતાવતો તીર છે, જેની પાસે વધતું લખેલું છે. સંખ્યારેખાની નીચે ડાબે બતાવતો તીર છે, જેની પાસે ઘટતું લખેલું છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_012.jpg" />
</media>
</figure>
<para id="fs-id1190625">ધન સંખ્યાઓની જેમ ધન અને <term class="no-emphasis" id="term-00013">ઋણ સંખ્યાઓ</term>નો ક્રમ દર્શાવવા અસમાનતાનાં ચિહ્નો વાપરી શકીએ. યાદ રાખો કે આપણે લખીએ <m:math><m:mrow><m:mi>a</m:mi><m:mo>&lt;</m:mo><m:mi>b</m:mi></m:mrow></m:math> (વાંચો: <m:math><m:mi>a</m:mi></m:math> <emphasis effect="italics">નાનું છે આના કરતાં:</emphasis> <m:math><m:mi>b</m:mi></m:math>), જ્યારે <m:math><m:mi>a</m:mi></m:math> ડાબે હોય, આની: <m:math><m:mi>b</m:mi></m:math> સંખ્યારેખા પર. આપણે લખીએ <m:math><m:mrow><m:mi>a</m:mi><m:mo>&gt;</m:mo><m:mi>b</m:mi></m:mrow></m:math> (વાંચો: <m:math><m:mi>a</m:mi></m:math> <emphasis effect="italics">મોટું છે આના કરતાં:</emphasis> <m:math><m:mi>b</m:mi></m:math>), જ્યારે <m:math><m:mi>a</m:mi></m:math> જમણે હોય, આની: <m:math><m:mi>b</m:mi></m:math> સંખ્યારેખા પર. આ વાત આ સંખ્યાઓ માટે દર્શાવી છે: <m:math><m:mrow><m:mn>3</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>5</m:mn></m:mrow></m:math> , જુઓ <link target-id="CNX_BMath_Figure_03_01_013" />.</para>
<figure id="CNX_BMath_Figure_03_01_013">
<media id="fs-id1259449" alt="ચિત્રમાં સંખ્યારેખા પર 3 અને 5ના બિંદુઓ દર્શાવ્યા છે. સંખ્યારેખાની નીચે લખ્યું છે: 3 નાનું છે આના કરતાં: 5; અને 5 મોટું છે આના કરતાં: 3.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_013.jpg" />
</media>
<caption>સંખ્યા <m:math><m:mrow><m:mn>3</m:mn></m:mrow></m:math> ડાબે છે, આની: <m:math><m:mrow><m:mn>5</m:mn></m:mrow></m:math> સંખ્યારેખા પર. તેથી <m:math><m:mrow><m:mn>3</m:mn></m:mrow></m:math> નાનું છે, આના કરતાં: <m:math><m:mrow><m:mn>5</m:mn><m:mo>,</m:mo></m:mrow></m:math> અને <m:math><m:mrow><m:mn>5</m:mn></m:mrow></m:math> મોટું છે, આના કરતાં: <m:math><m:mrow><m:mn>3</m:mn><m:mo>.</m:mo></m:mrow></m:math></caption>
</figure>
<para id="fs-id957996">આગળની સંખ્યારેખાઓ વધુ થોડાં ઉદાહરણો દર્શાવે છે.</para>
<para id="fs-id1383508">ⓐ<newline />
<media id="fs-id3926399" alt="ચિત્રમાં સંખ્યારેખા પર 1 અને 4ના બિંદુઓ દર્શાવ્યા છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_014a_img.jpg" />
</media></para><para id="fs-id1654012"><m:math><m:mrow><m:mn>4</m:mn></m:mrow></m:math> જમણે છે, આની: <m:math><m:mrow><m:mn>1</m:mn></m:mrow></m:math> સંખ્યારેખા પર, તેથી <m:math><m:mrow><m:mn>4</m:mn><m:mo>&gt;</m:mo><m:mn>1</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id1336748"><m:math><m:mrow><m:mn>1</m:mn></m:mrow></m:math> ડાબે છે, આની: <m:math><m:mrow><m:mn>4</m:mn></m:mrow></m:math> સંખ્યારેખા પર, તેથી <m:math><m:mrow><m:mn>1</m:mn><m:mo>&lt;</m:mo><m:mn>4</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id1371635">ⓑ<newline />
<media id="fs-id1802292" alt="ચિત્રમાં સંખ્યારેખા પર ઋણ 2 અને 1ના બિંદુઓ દર્શાવ્યા છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_014b_img.jpg" />
</media></para><para id="fs-id1649402"><m:math><m:mrow><m:mn>−2</m:mn></m:mrow></m:math> ડાબે છે, આની: <m:math><m:mrow><m:mn>1</m:mn></m:mrow></m:math> સંખ્યારેખા પર, તેથી <m:math><m:mrow><m:mn>−2</m:mn><m:mo>&lt;</m:mo><m:mn>1</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id1165826"><m:math><m:mrow><m:mn>1</m:mn></m:mrow></m:math> જમણે છે, આની: <m:math><m:mrow><m:mn>−2</m:mn></m:mrow></m:math> સંખ્યારેખા પર, તેથી <m:math><m:mrow><m:mn>1</m:mn><m:mo>&gt;</m:mo><m:mn>−2</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id1211646">ⓒ<newline />
<media id="fs-id3214013" alt="ચિત્રમાં સંખ્યારેખા પર ઋણ 3 અને ઋણ 1ના બિંદુઓ દર્શાવ્યા છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_014c_img.jpg" />
</media></para><para id="fs-id3179780"><m:math><m:mrow><m:mn>−1</m:mn></m:mrow></m:math> જમણે છે, આની: <m:math><m:mrow><m:mn>−3</m:mn></m:mrow></m:math> સંખ્યારેખા પર, તેથી <m:math><m:mrow><m:mn>−1</m:mn><m:mo>&gt;</m:mo><m:mn>−3</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id2740034"><m:math><m:mn>−3</m:mn></m:math> ડાબે છે, આની: <m:math><m:mn>−1</m:mn></m:math> સંખ્યારેખા પર, તેથી <m:math><m:mrow><m:mn>−3</m:mn><m:mo>&lt;</m:mo><m:mo>−</m:mo><m:mn>1</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<example id="fs-id3350134">
<exercise id="fs-id3440349"><problem id="fs-id1377649">
<para id="fs-id1872989">નીચેની દરેક સંખ્યાજોડીની સરખામણી કરવા વાપરો: <m:math><m:mrow><m:mo>&lt;</m:mo></m:mrow></m:math> અથવા <m:math><m:mrow><m:mtext>&gt;:</m:mtext></m:mrow></m:math><newline />

<list id="eip-id1168467249369" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>14</m:mn><m:mo>___</m:mo><m:mn>6</m:mn><m:mspace width="0.8em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−1</m:mn><m:mo>___</m:mo><m:mn>9</m:mn><m:mspace width="0.8em" /></m:math></item>

<item><span class="token">ⓒ</span> <m:math><m:mspace width="0.2em" /><m:mn>−1</m:mn><m:mo>___</m:mo><m:mn>−4</m:mn><m:mspace width="0.8em" /></m:math></item>

<item><span class="token">ⓓ</span> <m:math><m:mspace width="0.2em" /><m:mn>2</m:mn><m:mo>___</m:mo><m:mn>−20</m:mn></m:math></item>

</list></para></problem>
<solution id="fs-id2315857">
<title>ઉકેલ</title>
<para id="fs-id1174006">શરૂઆતમાં સંખ્યારેખા પર સંખ્યાઓ દર્શાવો, જુઓ <link target-id="CNX_BMath_Figure_03_01_015" />.<newline />
<figure id="CNX_BMath_Figure_03_01_015">
<media id="fs-id3003703" alt="ચિત્રમાં સંખ્યારેખા પર ઋણ 20, ઋણ 4, ઋણ 1, 2, 6, 9 અને 14ના બિંદુઓ દર્શાવ્યા છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_015.jpg" />
</media>
</figure></para>


<table id="eip-id1168469859124" class="unnumbered unstyled" summary="14 અને 6ની સરખામણી; સંખ્યારેખાના આધારે પરિસ્થિતિ અને તેનાથી મળતી ગાણિતિક અસમાનતા સમજાવે છે."><label />
<tgroup cols="2"><tbody>
<row>
<entry><span class="token">ⓐ</span> 14 અને 6ની સરખામણી કરો.</entry>
<entry><m:math><m:mn>14</m:mn><m:mo>___</m:mo><m:mn>6</m:mn></m:math></entry>
</row>
 <row>
   <entry>14 જમણે છે, 6ની, સંખ્યારેખા પર.</entry>
   <entry><m:math><m:mn>14</m:mn><m:mo>&gt;</m:mo><m:mn>6</m:mn></m:math></entry>
 </row>


</tbody>


</tgroup>
</table><table id="eip-id1168468303840" class="unnumbered unstyled" summary="−1 અને 9ની સરખામણી સંખ્યારેખાના તર્ક અને ગાણિતિક અસમાનતા વડે કરે છે."><label />
<tgroup cols="2"><tbody>
<row>
<entry><span class="token">ⓑ</span> −1 અને 9ની સરખામણી કરો.</entry>
<entry><m:math><m:mn>−1</m:mn><m:mo>___</m:mo><m:mn>9</m:mn></m:math></entry>
</row>

 <row>
   <entry>−1 ડાબે છે, 9ની, સંખ્યારેખા પર.</entry>
   <entry><m:math><m:mn>−1</m:mn><m:mo>&lt;</m:mo><m:mn>9</m:mn></m:math></entry>
 </row>


</tbody>



</tgroup>
</table><table id="eip-id1168467263438" class="unnumbered unstyled" summary="ઋણ પૂર્ણાંકોની સરખામણી; સંખ્યારેખા પર તેમનાં સ્થાન અસમાનતા કેવી રીતે નક્કી કરે છે તે દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
<row>
<entry><span class="token">ⓒ</span> −1 અને −4ની સરખામણી કરો.</entry>
<entry><m:math><m:mn>−1</m:mn><m:mo>___</m:mo><m:mn>−4</m:mn></m:math></entry>
</row>
 <row>
   <entry>−1 જમણે છે, −4ની, સંખ્યારેખા પર.</entry>
   <entry><m:math><m:mn>−1</m:mn><m:mo>&gt;</m:mo><m:mn>−4</m:mn></m:math></entry>
 </row>


</tbody>




</tgroup>
</table><table id="eip-id1168468416637" class="unnumbered unstyled" summary="2 અને −20ની સરખામણી, તેનું વર્ણન અને અનુરૂપ ગાણિતિક અસમાનતા; ધન અને ઋણ સંખ્યાઓની સરખામણી કેવી રીતે કરવી તે દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
<row>
<entry><span class="token">ⓓ</span> 2 અને −20ની સરખામણી કરો.</entry>
<entry><m:math><m:mn>2</m:mn><m:mo>___</m:mo><m:mn>−20</m:mn></m:math></entry>
</row>

 <row>
   <entry>2 જમણે છે, −20ની, સંખ્યારેખા પર.</entry>
   <entry><m:math><m:mn>2</m:mn><m:mo>&gt;</m:mo><m:mn>−20</m:mn></m:math></entry>
 </row>


</tbody>



</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id1327811" class="try">
<exercise id="fs-id3937820">
<problem id="fs-id1764873">
<para id="fs-id1768569">નીચેની દરેક સંખ્યાજોડીની સરખામણી કરવા વાપરો: <m:math><m:mrow><m:mo>&lt;</m:mo></m:mrow></m:math> અથવા <m:math><m:mrow><m:mtext>&gt;.</m:mtext></m:mrow></m:math>
<list id="eip-id1168468466634" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>15</m:mn><m:mo>___</m:mo><m:mn>7</m:mn><m:mspace width="0.8em" /></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−2</m:mn><m:mo>___</m:mo><m:mn>5</m:mn><m:mspace width="0.8em" /></m:math></item>
<item><span class="token">ⓒ</span> <m:math><m:mspace width="0.2em" /><m:mn>−3</m:mn><m:mo>___</m:mo><m:mn>−7</m:mn><m:mspace width="0.8em" /></m:math></item>
<item><span class="token">ⓓ</span> <m:math><m:mspace width="0.2em" /><m:mn>5</m:mn><m:mo>___</m:mo><m:mn>−17</m:mn></m:math></item>

</list></para></problem>
<solution id="fs-id1223199">
<para id="fs-id1697346"><list id="eip-id1168468454852" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> &gt; </item>
<item><span class="token">ⓑ</span> &lt; </item>
<item><span class="token">ⓒ</span> &gt; </item>
<item><span class="token">ⓓ</span> &gt; </item>
</list></para></solution>
</exercise>
</note>
<note id="fs-id13278110" class="try">
<exercise id="fs-id2337620">
<problem id="fs-id1403503">
<para id="fs-id17685690">નીચેની દરેક સંખ્યાજોડીની સરખામણી કરવા વાપરો: <m:math><m:mrow><m:mo>&lt;</m:mo></m:mrow></m:math> અથવા <m:math><m:mrow><m:mtext>&gt;.</m:mtext></m:mrow></m:math></para>
<para id="fs-id1395245"><list id="eip-id1168468389365" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>8</m:mn><m:mo>___</m:mo><m:mn>13</m:mn><m:mspace width="0.8em" /></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>3</m:mn><m:mo>___</m:mo><m:mn>−4</m:mn><m:mspace width="1em" /></m:math></item>
<item><span class="token">ⓒ</span> <m:math><m:mspace width="0.2em" /><m:mn>−5</m:mn><m:mo>___</m:mo><m:mn>−2</m:mn><m:mspace width="1em" /></m:math></item>
<item><span class="token">ⓓ</span> <m:math><m:mspace width="0.2em" /><m:mn>9</m:mn><m:mo>___</m:mo><m:mn>−21</m:mn></m:math></item>

</list></para></problem>
<solution id="fs-id1271349">
<para id="fs-id1998299"><list id="eip-id1168468771438" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> &lt; </item>
<item><span class="token">ⓑ</span> &gt; </item>
<item><span class="token">ⓒ</span> &lt; </item>
<item><span class="token">ⓓ</span> &gt; </item>
</list></para></solution>
</exercise>
</note>
</section>
<section id="fs-id2719522">
<title>વિરોધી સંખ્યાઓ શોધો</title>
<para id="fs-id2020904">સંખ્યારેખા પર ઋણ સંખ્યાઓ ધન સંખ્યાઓના અરીસાના પ્રતિબિંબ જેવી છે, વચ્ચે શૂન્ય છે. સંખ્યાઓ <m:math><m:mrow><m:mn>2</m:mn></m:mrow></m:math> અને <m:math><m:mn>−2</m:mn></m:math> શૂન્યથી સમાન અંતરે હોવાથી તેમને કહે છે <term id="term-00014">વિરોધી સંખ્યાઓ</term>. આ સંખ્યાની વિરોધી સંખ્યા: <m:math><m:mrow><m:mn>2</m:mn></m:mrow></m:math> છે <m:math><m:mn>−2</m:mn><m:mo>,</m:mo></m:math> અને આ સંખ્યાની વિરોધી સંખ્યા: <m:math><m:mn>−2</m:mn></m:math> છે <m:math><m:mrow><m:mn>2</m:mn></m:mrow></m:math> , જુઓ <link target-id="CNX_BMath_Figure_03_01_016" />(a). તેવી જ રીતે, <m:math><m:mrow><m:mn>3</m:mn></m:mrow></m:math> અને <m:math><m:mn>−3</m:mn></m:math> વિરોધી સંખ્યાઓ છે, જુઓ <link target-id="CNX_BMath_Figure_03_01_016" />(b).</para>
<figure id="CNX_BMath_Figure_03_01_016">
<media id="fs-id2609952" alt="ચિત્રમાં બે સંખ્યારેખા છે. પહેલીમાં ઋણ 2 અને ધન 2ના બિંદુઓ દર્શાવ્યા છે. પહેલી રેખાની નીચે લખ્યું છે કે ઋણ 2 અને 2 વિરોધી સંખ્યાઓ છે. બીજી સંખ્યારેખામાં ઋણ 3 અને 3ના બિંદુઓ દર્શાવ્યા છે. રેખાની નીચે લખ્યું છે કે ઋણ 3 અને 3 વિરોધી સંખ્યાઓ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_016.jpg" />
</media>
</figure>
<note id="fs-id1793900">
<title>વિરોધી સંખ્યા</title>
<para id="fs-id2307168">આપેલી સંખ્યાની વિરોધી સંખ્યા સંખ્યારેખા પર શૂન્યથી એટલા જ અંતરે, પરંતુ શૂન્યની બીજી બાજુ હોય છે.</para>
</note>
<example id="fs-id3416212">
<exercise id="fs-id1886183">
<problem id="fs-id1764826">
<para id="fs-id3310743">દરેક સંખ્યાની વિરોધી સંખ્યા શોધો:<newline />
<list id="eip-id1168466032830" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>7</m:mn></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−10</m:mn></m:math></item></list></para></problem>
<solution id="fs-id1693591">
<title>ઉકેલ</title>
<para id="fs-id3553732"><list id="eip-id1168466191342" list-type="enumerated" number-style="arabic" class="circled"><item> <span class="token">ⓐ</span> સંખ્યા <m:math><m:mrow><m:mn>−7</m:mn></m:mrow></m:math> સમાન અંતરે છે, આ સંખ્યાથી: <m:math><m:mrow><m:mn>0</m:mn></m:mrow></m:math> જેટલા અંતરે છે: <m:math><m:mrow><m:mn>7</m:mn><m:mo>,</m:mo></m:mrow></m:math> પરંતુ બીજી બાજુ, આની: <m:math><m:mrow><m:mn>0</m:mn><m:mo>.</m:mo></m:mrow></m:math> તેથી <m:math><m:mrow><m:mn>−7</m:mn></m:mrow></m:math> વિરોધી સંખ્યા છે, આની: <m:math><m:mrow><m:mn>7</m:mn></m:mrow></m:math> , જુઓ <link target-id="CNX_BMath_Figure_03_01_017" />.<newline />
<figure id="CNX_BMath_Figure_03_01_017">
<media id="fs-id3019387" alt="ચિત્રમાં સંખ્યારેખા છે. ઋણ 7 અને 7ના બિંદુઓ દર્શાવ્યા છે. રેખાની ઉપર દર્શાવ્યું છે કે 0થી ઋણ 7 સુધીનું અંતર અને 0થી 7 સુધીનું અંતર બંને 7 છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_017.jpg" />
</media>
</figure>
</item>

<item><span class="token">ⓑ</span> સંખ્યા <m:math><m:mrow><m:mn>10</m:mn></m:mrow></m:math> સમાન અંતરે છે, આ સંખ્યાથી: <m:math><m:mrow><m:mn>0</m:mn></m:mrow></m:math> જેટલા અંતરે છે: <m:math><m:mrow><m:mn>−10</m:mn></m:mrow></m:math>, પરંતુ બીજી બાજુ, આની: <m:math><m:mrow><m:mn>0</m:mn><m:mo>.</m:mo></m:mrow></m:math> તેથી <m:math><m:mrow><m:mn>10</m:mn></m:mrow></m:math> વિરોધી સંખ્યા છે, આની: <m:math><m:mrow><m:mn>−10</m:mn></m:mrow></m:math> , જુઓ <link target-id="CNX_BMath_Figure_03_01_018" />.<newline />
<figure id="CNX_BMath_Figure_03_01_018">
<media id="fs-id1372134" alt="ચિત્રમાં સંખ્યારેખા છે. ઋણ 10 અને 10ના બિંદુઓ દર્શાવ્યા છે. રેખાની ઉપર દર્શાવ્યું છે કે 0થી ઋણ 10 સુધીનું અંતર અને 0થી 10 સુધીનું અંતર બંને 10 છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_018.jpg" />
</media>
</figure>
</item>

</list></para></solution>
</exercise>
</example>
<note id="fs-id732832" class="try">
<exercise id="fs-id2668220">
<problem id="fs-id2517886">
<para id="fs-id1412086">દરેક સંખ્યાની વિરોધી સંખ્યા શોધો:<newline />
<list id="eip-id1168467168925" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>4</m:mn><m:mspace width="1em" />
</m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−3</m:mn></m:math></item>
</list></para></problem>
<solution id="fs-id2530905">
<para id="fs-id1334508"><list id="eip-id1168468503181" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> −4 </item>
<item> <span class="token">ⓑ</span> 3 </item>
</list></para></solution>
</exercise>
</note>
<note id="fs-id7328320" class="try">
<exercise id="fs-id1909093">
<problem id="fs-id1018541">
<para id="fs-id2675305">દરેક સંખ્યાની વિરોધી સંખ્યા શોધો:<newline />
<list id="eip-id1168469876985" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>8</m:mn><m:mspace width="1em" /></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−5</m:mn></m:math></item>
</list></para></problem>
<solution id="fs-id1336334">
<para id="fs-id3366425"><list id="eip-id1168467263111" list-type="enumerated" number-style="arabic" class="circled"><item> <span class="token">ⓐ</span> −8 </item>
<item><span class="token">ⓑ</span> 5 </item>
</list></para></solution>
</exercise>
</note>
<section id="fs-id1363307">
<title>વિરોધી સંખ્યાની લખાવટ</title>
<para id="fs-id1325658">જેમ અંગ્રેજીમાં એક જ શબ્દના જુદા અર્થ હોઈ શકે, તેમ બીજગણિતમાં એક જ નિશાનીના પણ જુદા અર્થ હોઈ શકે. તેનો ઉપયોગ કેવી રીતે થયો છે તે જોઈને ચોક્કસ અર્થ સ્પષ્ટ થાય છે. તમે આ નિશાની <m:math><m:mrow><m:mtext>“−”,</m:mtext></m:mrow></m:math> ત્રણ જુદી રીતે જોઈ છે.</para>
<para id="eip-251"><table id="eip-id1168469523154" class="unnumbered unstyled" summary="કોષ્ટકમાં બાદબાકી કે ઋણની નિશાની “−”ના ગાણિતિક સંદર્ભમાં જુદા ઉપયોગ સમજાવ્યા છે: બાદબાકી, ઋણ સંખ્યા અને વિરોધી સંખ્યા દર્શાવવી."><label />
<tgroup cols="2"><tbody>
<row>
<entry><m:math><m:mn>10</m:mn><m:mo>−</m:mo><m:mn>4</m:mn></m:math></entry>
<entry>બે સંખ્યાઓની વચ્ચે આ નિશાની બાદબાકીની ક્રિયા દર્શાવે છે. <newline />
આને વાંચીએ:  <m:math><m:mn>10</m:mn><m:mo>−</m:mo><m:mn>4</m:mn></m:math> આ રીતે: 10  <emphasis effect="italics">ઓછા </emphasis> <m:math><m:mn>4</m:mn></m:math>.</entry>

</row>
<row>
<entry><m:math><m:mn>−8</m:mn></m:math></entry>
<entry>સંખ્યાની પહેલાં આ નિશાની ઋણ સંખ્યા દર્શાવે છે. <newline />
આને વાંચીએ:  <m:math><m:mn>−8</m:mn></m:math> આ રીતે:  <emphasis effect="italics">ઋણ આઠ </emphasis>.</entry>
</row>
<row>
<entry><m:math><m:mo>−</m:mo><m:mi>x</m:mi></m:math></entry>
<entry>ચલ કે સંખ્યાની પહેલાં તે વિરોધી સંખ્યા દર્શાવે છે. <newline />આને વાંચીએ: <m:math><m:mn>−</m:mn><m:mi>x</m:mi></m:math> આ રીતે:  <emphasis effect="italics">આ સંખ્યાની વિરોધી સંખ્યા: </emphasis> <m:math><m:mi>x</m:mi></m:math>.</entry>
</row>
<row>
<entry><m:math><m:mo>−</m:mo><m:mo>(</m:mo><m:mn>−2</m:mn><m:mo>)</m:mo></m:math></entry>
<entry>અહીં બે નિશાનીઓ છે. કૌંસની અંદરની નિશાની દર્શાવે છે કે સંખ્યા ઋણ 2 છે. <newline />
કૌંસની બહારની નિશાની વિરોધી સંખ્યા દર્શાવે છે. આને વાંચીએ:  <m:math><m:mo>−</m:mo><m:mo>(</m:mo><m:mrow><m:mn>−2</m:mn></m:mrow><m:mo>)</m:mo></m:math> આ રીતે:  <emphasis effect="italics">આ સંખ્યાની વિરોધી સંખ્યા: </emphasis> <m:math><m:mn>−2.</m:mn></m:math></entry>
</row>
</tbody>



</tgroup>
</table></para><note id="fs-id1334043">
<title>વિરોધી સંખ્યાની લખાવટ</title>
<para id="fs-id1349006"><m:math><m:mrow><m:mo>−</m:mo><m:mi>a</m:mi></m:mrow></m:math> એ આ સંખ્યાની વિરોધી સંખ્યા દર્શાવે છે: <m:math><m:mi>a</m:mi></m:math></para>
<para id="fs-id1264671">આ લખાવટ <m:math><m:mrow><m:mo>−</m:mo><m:mi>a</m:mi></m:mrow></m:math> વાંચાય છે <emphasis effect="italics">આ સંખ્યાની વિરોધી સંખ્યા:</emphasis> <m:math><m:mi>a</m:mi><m:mo>.</m:mo></m:math></para>
</note>
<example id="fs-id1335351">
<exercise id="fs-id2545639">
<problem id="fs-id1239990">
<para id="fs-id1343473">સરળ કરો: <m:math><m:mrow><m:mo>−</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>−6</m:mn></m:mrow><m:mo>)</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1224196">
<title>ઉકેલ</title>
<para id="fs-id1349871"><table id="eip-id1172095963601" class="unnumbered unstyled" summary="ઋણ સંખ્યાની વિરોધી સંખ્યા શોધવાનો ખ્યાલ દર્શાવે છે: −(−6) બરાબર 6."><label />
<tgroup cols="2"><tbody>
<row><entry /><entry align="right">
 <m:math><m:mrow><m:mo>−</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>−6</m:mn></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></entry></row>

<row><entry>આ સંખ્યાની વિરોધી સંખ્યા:  <m:math><m:mrow><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow></m:math> છે
 <m:math><m:mrow><m:mn>6</m:mn><m:mo>.</m:mo></m:mrow></m:math> </entry>
<entry align="right"><m:math><m:mrow><m:mn>6</m:mn></m:mrow></m:math></entry></row></tbody>
</tgroup>
</table></para></solution>
</exercise>
</example>
<note id="fs-id2713211" class="try">
<exercise id="fs-id1391373">
<problem id="fs-id2929016">
<para id="fs-id1384497">સરળ કરો:</para>
<para id="fs-id1171103641190"><m:math><m:mrow><m:mo>−</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>−1</m:mn></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
<solution id="fs-id2016131">
<para id="fs-id1766724">1</para>
</solution>
</exercise>
</note>
<note id="fs-id1171105158454" class="try">
<exercise id="fs-id1318543">
<problem id="fs-id1238862">
<para id="fs-id1171105051336">સરળ કરો:</para>
<para id="fs-id1318337"><m:math><m:mrow><m:mo>−</m:mo><m:mrow><m:mo>(</m:mo><m:mrow><m:mn>−5</m:mn></m:mrow><m:mo>)</m:mo></m:mrow></m:mrow></m:math></para>
</problem>
<solution id="fs-id1402899">
<para id="fs-id2505542">5</para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id2531615">
<title>પૂર્ણાંકો</title>
<para id="fs-id1761108">ગણતરીની સંખ્યાઓ, તેમની વિરોધી સંખ્યાઓ અને <m:math><m:mrow><m:mn>0</m:mn></m:mrow></m:math> નો સમૂહ એટલે આ સંખ્યાઓનો સમૂહ: <term class="no-emphasis" id="term-00015">પૂર્ણાંકો</term>.</para><note id="fs-id2000830">
<title>પૂર્ણાંકો</title>
<para id="fs-id1402833"><emphasis effect="bold">પૂર્ણાંકો</emphasis> એટલે ગણતરીની સંખ્યાઓ, તેમની <term class="no-emphasis" id="term-00016">વિરોધી સંખ્યાઓ</term> અને શૂન્ય.</para><equation id="fs-id1312862" class="unnumbered"><label /><m:math><m:mrow><m:mtext>…</m:mtext><m:mspace width="0.2em" /><m:mn>−3</m:mn><m:mo>,</m:mo><m:mn>−2</m:mn><m:mo>,</m:mo><m:mn>−1</m:mn><m:mo>,</m:mo><m:mn>0</m:mn><m:mo>,</m:mo><m:mn>1</m:mn><m:mo>,</m:mo><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>3</m:mn><m:mtext>…</m:mtext></m:mrow></m:math></equation></note>
<para id="fs-id2871794">ચલની વિરોધી સંખ્યાનું મૂલ્ય શોધતી વખતે આપણે નિશાનીઓ બાબતે ખૂબ કાળજી રાખવી જોઈએ.</para><example id="fs-id1976792"><exercise id="fs-id2072497"><problem id="fs-id1337008">
<para id="fs-id1197928">કિંમત શોધો: <m:math><m:mo>−</m:mo><m:mi>x</m:mi><m:mo>:</m:mo></m:math>
<list id="eip-id1168468606073" list-type="enumerated" number-style="arabic" class="circled"><item> <span class="token">ⓐ</span> જ્યારે <m:math><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:math></item>
<item><span class="token">ⓑ</span> જ્યારે <m:math><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>−8</m:mn><m:mo>.</m:mo></m:math></item>

</list></para>
</problem>
<solution id="fs-id1764632">
<table id="eip-id1168469610553" class="unnumbered unstyled" aria-label="ચિત્રમાં ત્રણ હરોળ છે. પહેલી હરોળમાં ઋણ x છે. બીજી હરોળમાં 8 મૂકવાનું કહે છે xની જગ્યાએ અને કૌંસમાં સંખ્યા 8ની પહેલાં ઋણ નિશાની દર્શાવી છે. ત્રીજી હરોળમાં સરળ કરવાનું કહે છે અને ઋણ 8 દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
 <row>
 <entry><span class="token">ⓐ</span> આની કિંમત શોધવા: <m:math><m:mo>−</m:mo><m:mi>x</m:mi></m:math> જ્યારે <m:math><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>8</m:mn></m:math>, આ કિંમત મૂકો: <m:math><m:mn>8</m:mn></m:math> , આ ચલની જગ્યાએ: <m:math><m:mi>x</m:mi></m:math>.</entry>
 <entry />
 </row>
 <row>
   <entry />
   <entry><m:math><m:mo>−</m:mo><m:mi>x</m:mi></m:math></entry>
 </row>
 <row>
   <entry align="left"><media id="eip-id1168469869046" alt="8 મૂકો xની જગ્યાએ."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_020_img-01.png" /></media></entry>
   <entry align="left"><media id="eip-id1168466395677" alt="ગાણિતિક પદાવલીમાં ઋણ નિશાની પછી કૌંસમાં સંખ્યા 8 છે; 8 લાલ રંગમાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_020_img-02.png" /></media></entry>
 </row>
 <row>
   <entry>સરળ કરો.</entry>
   <entry><m:math><m:mn>−8</m:mn></m:math></entry>
 </row>
</tbody>
</tgroup>
</table><table id="eip-id1168466251150" class="unnumbered unstyled" aria-label="ચિત્રમાં ત્રણ હરોળ છે. પહેલી હરોળમાં ઋણ x છે. બીજી હરોળમાં ઋણ 8 મૂકવાનું કહે છે xની જગ્યાએ અને કૌંસમાં ઋણ સંખ્યા 8ની પહેલાં ઋણ નિશાની દર્શાવી છે. ત્રીજી હરોળમાં સરળ કરવાનું કહે છે અને સંખ્યા 8 દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
 <row>
 <entry><span class="token">ⓑ</span> આની કિંમત શોધવા: <m:math><m:mo>−</m:mo><m:mi>x</m:mi></m:math> જ્યારે <m:math><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>−8</m:mn></m:math>, આ કિંમત મૂકો: <m:math><m:mn>−8</m:mn></m:math> , આ ચલની જગ્યાએ: <m:math><m:mi>x</m:mi></m:math>.</entry>
 <entry />
 </row>
 <row>
   <entry />
   <entry><m:math><m:mo>−</m:mo><m:mi>x</m:mi></m:math></entry>
 </row>
 <row>
   <entry align="left"><media id="eip-id1168466026790" alt="ચિત્રમાં લખ્યું છે: “−8 મૂકો xની જગ્યાએ.” લખાણમાં −8 લાલ છે, જ્યારે બાકીનું લખાણ ઘેરા વાદળી-લીલા રંગમાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_021_img-01.png" /></media></entry>
   <entry align="left"><media id="eip-id1168466095771" alt="ગણિતની પદાવલી −(−8)નું ચિત્ર; તેમાં 8 અને અંદરની ઋણ નિશાની લાલ છે, જ્યારે સૌથી બહારની ઋણ નિશાની અને કૌંસ કાળાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_021_img-02.png" /></media></entry>
 </row>
 <row>
   <entry>સરળ કરો.</entry>
   <entry><m:math><m:mn>8</m:mn></m:math></entry>
 </row>

</tbody>
</tgroup>
</table></solution>
</exercise></example><note id="fs-id1424758" class="try">
<exercise id="fs-id2506777"><problem id="fs-id2728096">
<para id="fs-id1342984">કિંમત શોધો: <m:math><m:mo>−</m:mo><m:mi>n</m:mi><m:mo>:</m:mo><m:mspace width="1em" /></m:math>
<list id="eip-id1168466295764" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>n</m:mi><m:mo>=</m:mo><m:mn>4</m:mn><m:mspace width="0.8em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>n</m:mi><m:mo>=</m:mo><m:mn>−4</m:mn></m:math></item>
</list></para>

</problem>
<solution id="fs-id2033826">
<list id="eip-id1168467280322" list-type="enumerated" number-style="arabic" class="circled"><item> <span class="token">ⓐ</span> −4 </item>
<item> <span class="token">ⓑ</span> 4 </item>
</list>
</solution>
</exercise></note>
<note id="fs-id1171105159594" class="try">
<exercise id="fs-id3023803"><problem id="fs-id2670104">
<para id="fs-id1171105121329">કિંમત શોધો:
<m:math><m:mo>−</m:mo><m:mi>m</m:mi><m:mo>:</m:mo><m:mspace width="1em" /></m:math>

<list id="eip-id1168469828619" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>11</m:mn><m:mspace width="0.8em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>−11</m:mn></m:math></item>

</list></para>

</problem>
<solution id="fs-id3977260">
<list id="eip-id1168468253999" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> −11 </item>
<item><span class="token">ⓑ</span> 11 </item>
</list>
</solution>

</exercise></note>
</section>
</section>
<section id="fs-id1649298">
<title>નિરપેક્ષ મૂલ્ય ધરાવતી પદાવલીઓ સરળ કરો</title>
<para id="fs-id1404890">આપણે જોયું કે આ સંખ્યાઓ: <m:math><m:mrow><m:mn>5</m:mn></m:mrow></m:math> અને <m:math><m:mn>−5</m:mn></m:math> છે <term class="no-emphasis" id="term-00017">વિરોધી સંખ્યાઓ</term> કારણ કે તેઓ સમાન અંતરે છે, આ સંખ્યાથી: <m:math><m:mrow><m:mn>0</m:mn></m:mrow></m:math> સંખ્યારેખા પર. બંને પાંચ એકમ દૂર છે, આ સંખ્યાથી: <m:math><m:mrow><m:mn>0</m:mn><m:mo>.</m:mo></m:mrow></m:math> આ સંખ્યા <m:math><m:mrow><m:mn>0</m:mn></m:mrow></m:math> અને સંખ્યારેખા પરની કોઈ પણ સંખ્યા વચ્ચેના અંતરને તે સંખ્યાનું <term id="term-00018">નિરપેક્ષ મૂલ્ય</term> કહે છે. અંતર કદી ઋણ હોતું નથી, તેથી કોઈ પણ સંખ્યાનું <term class="no-emphasis" id="term-00019">નિરપેક્ષ મૂલ્ય</term> કદી ઋણ હોતું નથી.</para>
<para id="fs-id2020586">નિરપેક્ષ મૂલ્યનું ચિહ્ન એટલે સંખ્યાની બંને બાજુ એક-એક ઊભી રેખા. તેથી આ સંખ્યાનું નિરપેક્ષ મૂલ્ય: <m:math><m:mrow><m:mn>5</m:mn></m:mrow></m:math> આ રીતે લખાય છે: <m:math><m:mrow><m:mo>|</m:mo><m:mn>5</m:mn><m:mo>|</m:mo><m:mo /></m:mrow><m:mo>,</m:mo></m:math> અને આ સંખ્યાનું નિરપેક્ષ મૂલ્ય: <m:math><m:mn>−5</m:mn></m:math> આ રીતે લખાય છે: <m:math><m:mrow><m:mo>|</m:mo><m:mrow><m:mn>−5</m:mn></m:mrow><m:mo>|</m:mo></m:mrow></m:math> , જુઓ <link target-id="CNX_BMath_Figure_03_01_019" />.</para>
<figure id="CNX_BMath_Figure_03_01_019">
<media id="fs-id1595569" alt="ચિત્રમાં સંખ્યારેખા છે. ઋણ 5 અને 5ના બિંદુઓ દર્શાવ્યા છે. સંખ્યારેખાની ઉપર ઋણ 5થી 0 સુધીનું અંતર 5 એકમ લખ્યું છે. સંખ્યારેખાની ઉપર 0થી 5 સુધીનું અંતર પણ 5 એકમ લખ્યું છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_019.jpg" />
</media>
</figure>
<note id="fs-id1248712">
<title>નિરપેક્ષ મૂલ્ય</title>
<para id="fs-id2519017">સંખ્યાનું <term class="no-emphasis" id="term-00020">નિરપેક્ષ મૂલ્ય</term> એટલે તેનું અંતર, આ સંખ્યાથી: <m:math><m:mrow><m:mn>0</m:mn></m:mrow></m:math> સંખ્યારેખા પર.</para>
<para id="fs-id1864552">આ સંખ્યાનું નિરપેક્ષ મૂલ્ય: <m:math><m:mi>n</m:mi></m:math> આ રીતે લખાય છે: <m:math><m:mrow><m:mrow><m:mo>|</m:mo><m:mi>n</m:mi><m:mo>|</m:mo></m:mrow><m:mo>.</m:mo></m:mrow></m:math></para>
<equation id="fs-id2883399" class="unnumbered"><label /><m:math><m:mrow><m:mrow><m:mo>|</m:mo><m:mi>n</m:mi><m:mo>|</m:mo></m:mrow><m:mo>≥</m:mo><m:mn>0</m:mn><m:mspace width="0.2em" /><m:mtext> બધી સંખ્યાઓ માટે </m:mtext></m:mrow></m:math></equation>
</note>
<example id="fs-id1272287">
<exercise id="fs-id1798637"><problem id="fs-id1935434">
<para id="fs-id1705181">સરળ કરો:
<list id="eip-id1168466318850" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mo stretchy="false">|</m:mo><m:mn>3</m:mn><m:mo stretchy="false">|</m:mo></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mo stretchy="false">|</m:mo><m:mn>−44</m:mn><m:mo stretchy="false">|</m:mo></m:math></item>

<item><span class="token">ⓒ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mn>0</m:mn><m:mo>|</m:mo></m:math></item>
</list></para>



</problem>
<solution id="fs-id1626185">
<title>ઉકેલ</title>

<table id="eip-id1165118025864" class="unnumbered unstyled" summary="કોષ્ટક નિરપેક્ષ મૂલ્યનો ખ્યાલ દર્શાવે છે: 3 છે 3 એકમ દૂર શૂન્યથી, જેને ગાણિતિક રીતે |3| = 3 લખ્યું છે."><label /><tgroup cols="2"><tbody>
<row><entry><span class="token">ⓐ</span> </entry><entry /></row>
<row><entry />
<entry> <m:math><m:mrow><m:mo>|</m:mo><m:mn>3</m:mn><m:mo>|</m:mo></m:mrow></m:math></entry>
</row>
<row><entry>3 છે 3 એકમ દૂર શૂન્યથી.</entry>
<entry> <m:math><m:mrow><m:mn>3</m:mn></m:mrow></m:math></entry>
</row>
</tbody>
</tgroup>
</table>

 <table id="eip-id1171842979184" class="unnumbered unstyled" summary="કોષ્ટકમાં −44ના ઉદાહરણથી નિરપેક્ષ મૂલ્યનો ખ્યાલ દર્શાવ્યો છે, તેની ગાણિતિક પદાવલી અને શબ્દોમાં સમજ આપી છે."><label /><tgroup cols="2"><tbody>
<row><entry><span class="token">ⓑ</span> </entry><entry /></row><row><entry />
<entry> <m:math><m:mrow><m:mo>|</m:mo><m:mn>−44</m:mn><m:mo>|</m:mo></m:mrow></m:math></entry>
</row>
<row><entry>−44 છે 44 એકમ દૂર શૂન્યથી.</entry>
<entry> <m:math><m:mrow><m:mn>44</m:mn></m:mrow></m:math></entry>
</row>
</tbody>
</tgroup>
</table>

<table id="eip-id1171842583307" class="unnumbered unstyled" summary="નાના કોષ્ટકમાં કૉપિરાઇટનું ચિહ્ન, શૂન્યનું નિરપેક્ષ મૂલ્ય અને તેને લગતું વાક્ય છે."><label />
<tgroup cols="2"><tbody>
<row><entry><span class="token">ⓒ</span> </entry><entry /></row>
<row><entry />
<entry> <m:math><m:mrow><m:mo>|</m:mo><m:mn>0</m:mn><m:mo>|</m:mo></m:mrow></m:math></entry>
</row>
<row><entry>0 પહેલેથી શૂન્ય પર છે.</entry>
<entry> <m:math><m:mrow><m:mn>0</m:mn></m:mrow></m:math></entry>
</row>
</tbody>

</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id1240167" class="try">
<exercise id="fs-id1751911">
<problem id="fs-id1510348">
<para id="fs-id2000460">સરળ કરો:
<list id="eip-id1168468773054" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.8em" /><m:mo>|</m:mo><m:mn>12</m:mn><m:mo>|</m:mo><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.8em" /><m:mo>−</m:mo><m:mo>|</m:mo><m:mn>−28</m:mn><m:mo>|</m:mo></m:math></item>

</list></para></problem>
<solution id="fs-id1999478">
<para id="fs-id1378566"><list id="eip-id1168468528105" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span>  12 </item>
<item> <span class="token">ⓑ</span> −28 </item>
</list></para></solution>
</exercise>
</note>
<note id="fs-id1171101804781" class="try">
<exercise id="fs-id1198414"><problem id="fs-id1612324">
<para id="fs-id1171105399470">સરળ કરો:
<list id="eip-id1168468416946" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mn>9</m:mn><m:mo>|</m:mo><m:mspace width="1em" /></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mo>−</m:mo><m:mo>|</m:mo><m:mn>37</m:mn><m:mo>|</m:mo></m:math></item>
</list></para>
</problem>
<solution id="fs-id1141233">
<list id="eip-id1168469590342" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> 9 </item>
<item><span class="token">ⓑ</span> −37 </item>
</list></solution>
</exercise></note>
<para id="eip-597">ક્રિયાઓના ક્રમમાં નિરપેક્ષ મૂલ્યની ઊભી રેખાઓને કૌંસની જેમ ગણીએ છીએ. પહેલાં તેની અંદરની પદાવલી સરળ કરીએ છીએ.</para><example id="fs-id3917008">
<exercise id="fs-id1659988">
<problem id="fs-id3079056">
<para id="fs-id1303018">કિંમત શોધો:
<list id="eip-id1168468276739" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mrow><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mi>x</m:mi><m:mo>|</m:mo><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>−35</m:mn></m:mrow></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mrow><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mrow><m:mtext mathvariant="italic"> −y </m:mtext></m:mrow><m:mo>|</m:mo><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>−20</m:mn></m:mrow></m:math></item>

<item><span class="token">ⓒ</span> <m:math><m:mrow><m:mspace width="0.2em" /><m:mo>−</m:mo><m:mo>|</m:mo><m:mi>u</m:mi><m:mo>|</m:mo><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>u</m:mi><m:mo>=</m:mo><m:mn>12</m:mn></m:mrow></m:math></item>

<item><span class="token">ⓓ</span> <m:math><m:mrow><m:mspace width="0.2em" /><m:mo>−</m:mo><m:mo>|</m:mo><m:mi>p</m:mi><m:mo>|</m:mo><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>p</m:mi><m:mo>=</m:mo><m:mn>−14</m:mn></m:mrow></m:math></item></list></para></problem>
<solution id="fs-id1353919">
<title>ઉકેલ</title>
<para id="fs-id1207484"><table id="eip-id1168466007339" class="unnumbered unstyled" aria-label="ચિત્રમાં ત્રણ હરોળ છે. પહેલી હરોળમાં xનું નિરપેક્ષ મૂલ્ય છે. બીજી હરોળમાં ઋણ 35 મૂકવાનું કહે છે xની જગ્યાએ અને નિરપેક્ષ મૂલ્યના ચિહ્નમાં ઋણ 35 છે. ત્રીજી હરોળમાં નિરપેક્ષ મૂલ્ય લેવાનું કહે છે અને 35 છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓐ</span> આ શોધવા: <m:math><m:mo>|</m:mo><m:mi>x</m:mi><m:mo>|</m:mo></m:math> જ્યારે <m:math><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>−35</m:mn><m:mo>:</m:mo></m:math></entry>
<entry />
</row>
<row>
<entry />
   <entry><m:math><m:mo>|</m:mo><m:mi>x</m:mi><m:mo>|</m:mo></m:math></entry>
 </row>
 <row>
   <entry align="left"><media id="eip-id1168466723540" alt="ચિત્રમાં સફેદ પૃષ્ઠભૂમિ પર આછા વાદળી-રાખોડી અક્ષરે લખ્યું છે: “−35 મૂકો xની જગ્યાએ.” તેમાં −35 લાલ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_022_img-01.png" /></media></entry>
   <entry align="left"><media id="eip-id1168469749372" alt="ચિત્રમાં −35ના નિરપેક્ષ મૂલ્યની ગાણિતિક લખાવટ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_022_img-02.png" /></media></entry>
 </row>
 <row>
   <entry>નિરપેક્ષ મૂલ્ય લો.</entry>
   <entry><m:math><m:mn>35</m:mn></m:math></entry>
 </row>

</tbody>

</tgroup>
</table><table id="eip-id1168469585161" class="unnumbered unstyled" aria-label="ચિત્રમાં ચાર હરોળ છે. પહેલી હરોળમાં yનું નિરપેક્ષ મૂલ્ય છે. બીજી હરોળમાં ઋણ 20 મૂકવાનું કહે છે yની જગ્યાએ અને નિરપેક્ષ મૂલ્યના ચિહ્નની અંદર ઋણ નિશાની પછી કૌંસમાં ઋણ 20 છે. ત્રીજી હરોળમાં સરળ કરવાનું કહે છે અને નિરપેક્ષ મૂલ્યના ચિહ્નની અંદર 20 છે. ચોથી હરોળમાં નિરપેક્ષ મૂલ્ય લેવાનું કહે છે અને 20 છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓑ</span> આ શોધવા: <m:math><m:mo>|</m:mo><m:mo>−</m:mo><m:mi>y</m:mi><m:mo>|</m:mo></m:math> જ્યારે <m:math><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>−20</m:mn><m:mo>:</m:mo></m:math></entry>
   <entry />
</row>
<row>
<entry />
<entry><m:math><m:mo>|</m:mo><m:mo>−</m:mo><m:mi>y</m:mi><m:mo>|</m:mo></m:math></entry>
 </row>
 <row>
   <entry align="left"><media id="eip-id1168469436806" alt="સફેદ પૃષ્ઠભૂમિ પર લખ્યું છે: “−20 મૂકો yની જગ્યાએ.” તેમાં −20 લાલ અને બાકીનું લખાણ ઘેરા વાદળી-રાખોડી રંગમાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_023_img-01.png" /></media></entry>
   <entry align="left"><media id="eip-id1168469566638" alt="નિરપેક્ષ મૂલ્યની પદાવલી |−(−(−20))| દર્શાવી છે; સંખ્યા −20 લાલ રંગમાં છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_023_img-02.png" /></media></entry>
 </row>
 <row>
   <entry>સરળ કરો.</entry>
   <entry><m:math><m:mo>|</m:mo><m:mn>20</m:mn><m:mo>|</m:mo></m:math></entry>
 </row>
 <row>
 <entry>નિરપેક્ષ મૂલ્ય લો.</entry>
 <entry><m:math><m:mo>20</m:mo></m:math></entry>
 </row>

</tbody>












</tgroup>
</table><table id="eip-id1168466911241" class="unnumbered unstyled" aria-label="ચિત્રમાં ત્રણ હરોળ છે. પહેલી હરોળમાં uના નિરપેક્ષ મૂલ્યની પહેલાં ઋણ નિશાની છે. બીજી હરોળમાં 12 મૂકવાનું કહે છે uની જગ્યાએ અને નિરપેક્ષ મૂલ્યના ચિહ્નની અંદર 12 તથા તેની બહાર ઋણ નિશાની છે. ત્રીજી હરોળમાં નિરપેક્ષ મૂલ્ય લેવાનું કહે છે અને ઋણ 12 છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓒ</span> આ શોધવા: <m:math><m:mo>−</m:mo><m:mo>|</m:mo><m:mi>u</m:mi><m:mo>|</m:mo></m:math> જ્યારે <m:math><m:mi>u</m:mi><m:mo>=</m:mo><m:mn>12</m:mn><m:mo>:</m:mo></m:math></entry>
<entry />
</row>
<row>
<entry />
   <entry><m:math><m:mo>−</m:mo><m:mo>|</m:mo><m:mi>u</m:mi><m:mo>|</m:mo></m:math></entry>
 </row>
 <row>
   <entry align="left"><media id="eip-id1168469592863" alt="લખાણ છે: “12 મૂકો uની જગ્યાએ.” તેમાં 12 લાલ છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_024_img-01.png" /></media></entry>
   <entry align="left"><media id="eip-id1168469757078" alt="ચિત્રમાં ગાણિતિક પદાવલી −|12| છે, જેનું મૂલ્ય ઋણ બાર થાય છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_024_img-02.png" /></media></entry>
 </row>
 <row>
   <entry>નિરપેક્ષ મૂલ્ય લો.</entry>
   <entry><m:math><m:mn>−12</m:mn></m:math></entry>
 </row>


</tbody>












</tgroup>
</table><table id="eip-id1168468381460" class="unnumbered unstyled" aria-label="ચિત્રમાં ત્રણ હરોળ છે. પહેલી હરોળમાં pના નિરપેક્ષ મૂલ્યની પહેલાં ઋણ નિશાની છે. બીજી હરોળમાં ઋણ 14 મૂકવાનું કહે છે pની જગ્યાએ અને ઋણ 14ના નિરપેક્ષ મૂલ્યની પહેલાં ઋણ નિશાની છે. ત્રીજી હરોળમાં નિરપેક્ષ મૂલ્ય લેવાનું કહે છે અને ઋણ 14 છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓓ</span> આ શોધવા: <m:math><m:mo>−</m:mo><m:mo>|</m:mo><m:mi>p</m:mi><m:mo>|</m:mo></m:math> જ્યારે <m:math><m:mi>p</m:mi><m:mo>=</m:mo><m:mn>−14</m:mn><m:mo>:</m:mo></m:math></entry>
<entry />
</row>
<row>
<entry />
   <entry><m:math><m:mo>−</m:mo><m:mo>|</m:mo><m:mi>p</m:mi><m:mo>|</m:mo></m:math></entry>
 </row>
 <row>
   <entry align="left"><media id="eip-id1168468496380" alt="લખાણ છે: “−14 મૂકો pની જગ્યાએ.” તેમાં −14 લાલ છે, જે દર્શાવે છે કે આ કિંમત ચલ pની જગ્યાએ મૂકવાની છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_025_img-01.png" /></media></entry>
   <entry align="left"><media id="eip-id1168468712204" alt="ઋણ ચૌદના નિરપેક્ષ મૂલ્યની વિરોધી સંખ્યા દર્શાવતી ગાણિતિક પદાવલી −|−14| લખેલી છે."><image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_025_img-02.png" /></media></entry>
 </row>
 <row>
   <entry>નિરપેક્ષ મૂલ્ય લો.</entry>
   <entry><m:math><m:mn>−14</m:mn></m:math></entry>
 </row>


</tbody>







</tgroup>
</table></para><para id="fs-id1875797">ધ્યાન આપો કે નિરપેક્ષ મૂલ્યના ચિહ્નની બહાર ઋણ નિશાની હોય ત્યારે જ પરિણામ ઋણ છે.</para>
</solution>
</exercise>
</example>
<note id="fs-id1376557" class="try">
<exercise id="fs-id1724654"><problem id="fs-id1190494">
<para id="fs-id1411404">કિંમત શોધો:
<list id="eip-id1168467550410" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mi>x</m:mi><m:mo>|</m:mo><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>−17</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mrow><m:mtext mathvariant="italic"> −y </m:mtext></m:mrow><m:mo>|</m:mo><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>−39</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓒ</span> <m:math><m:mspace width="0.2em" /><m:mo>−</m:mo><m:mo>|</m:mo><m:mi>m</m:mi><m:mo>|</m:mo><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>22</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓓ</span> <m:math><m:mspace width="0.2em" /><m:mo>−</m:mo><m:mo>|</m:mo><m:mi>p</m:mi><m:mo>|</m:mo><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>p</m:mi><m:mo>=</m:mo><m:mn>−11</m:mn></m:math></item>

</list></para>

</problem>
<solution id="fs-id2550841">
<list id="eip-id1168469873494" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> 17 </item>
<item><span class="token">ⓑ</span> 39 </item>
<item><span class="token">ⓒ</span> −22 </item>
<item><span class="token">ⓓ</span> −11 </item>
</list></solution>
</exercise></note>
<note id="fs-id1171103646064" class="try">
<exercise id="fs-id1161642"><problem id="fs-id1370635">
<list id="eip-id1168467288817" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mi>y</m:mi><m:mo>|</m:mo><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>−23</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mrow><m:mo>−</m:mo><m:mi>y</m:mi></m:mrow><m:mo>|</m:mo><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>−21</m:mn></m:math></item>

<item><span class="token">ⓒ</span> <m:math><m:mspace width="0.2em" /><m:mo>−</m:mo><m:mo>|</m:mo><m:mi>n</m:mi><m:mo>|</m:mo><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>n</m:mi><m:mo>=</m:mo><m:mn>37</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓓ</span> <m:math><m:mspace width="0.2em" /><m:mo>−</m:mo><m:mo>|</m:mo><m:mi>q</m:mi><m:mo>|</m:mo><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>q</m:mi><m:mo>=</m:mo><m:mn>−49</m:mn></m:math></item>

</list></problem>
<solution id="fs-id1412916">
<list id="eip-id1168469726670" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> 23 </item>
<item><span class="token">ⓑ</span> 21 </item>
<item><span class="token">ⓒ</span> −37 </item>
<item><span class="token">ⓓ</span> −49 </item>
</list></solution>
</exercise></note>
<example id="fs-id1271821"><exercise id="fs-id1411060"><problem id="fs-id4166952">
<para id="fs-id1240982">ભરો: <m:math><m:mrow><m:mtext>&lt;</m:mtext><m:mo>,</m:mo><m:mtext>&gt;</m:mtext><m:mo>,</m:mo><m:mtext> અથવા </m:mtext><m:mo>=</m:mo></m:mrow></m:math> નીચેના દરેક માટે:</para>
<para id="fs-id1182588"><list id="eip-id1168468767333" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mn>−5</m:mn><m:mo>|</m:mo><m:mo>___</m:mo><m:mo>−</m:mo><m:mo>|</m:mo><m:mn>−5</m:mn><m:mo>|</m:mo><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>8</m:mn><m:mo>___</m:mo><m:mo>−</m:mo><m:mo>|</m:mo><m:mn>−8</m:mn><m:mo>|</m:mo><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓒ</span> <m:math><m:mspace width="0.2em" /><m:mn>−9</m:mn><m:mo>___</m:mo><m:mo>−</m:mo><m:mo>|</m:mo><m:mn>−9</m:mn><m:mo>|</m:mo><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓓ</span> <m:math><m:mspace width="0.2em" /><m:mo>−</m:mo><m:mo>|</m:mo><m:mn>−7</m:mn><m:mo>|</m:mo><m:mo>___</m:mo><m:mn>−7</m:mn></m:math></item>

</list></para></problem>
<solution id="fs-id1179762">
<title>ઉકેલ</title>
<para id="fs-id1697572">બે પદાવલીઓની સરખામણી કરવા પહેલાં દરેકને સરળ કરો. પછી સરખામણી કરો.</para>
<table id="eip-id1166567974475" class="unnumbered unstyled" summary="કોષ્ટકમાં નિરપેક્ષ મૂલ્યની પદાવલી સરળ કરીને ક્રમ નક્કી કરવાનાં પગલાં છે; અંતે 5 અને −5ની સરખામણી છે."><label />
<tgroup cols="2"><tbody><row><entry><span class="token">ⓐ</span> </entry><entry /></row>
  <row>
    <entry />
    <entry>
<m:math><m:mrow><m:mo>|</m:mo><m:mn>−5</m:mn><m:mo>|</m:mo><m:mo>___</m:mo><m:mo>−</m:mo><m:mo>|</m:mo><m:mn>−5</m:mn><m:mo>|</m:mo></m:mrow></m:math></entry>
  </row>
  <row>
    <entry>સરળ કરો.</entry>
    <entry>
<m:math><m:mrow><m:mn>5</m:mn><m:mo>___</m:mo><m:mn>−5</m:mn></m:mrow></m:math></entry>
  </row>
  <row>
    <entry>ક્રમ નક્કી કરો.</entry>
    <entry><m:math><m:mrow><m:mn>5</m:mn><m:mo>&gt;</m:mo><m:mn>−5</m:mn></m:mrow></m:math></entry>
  </row>
</tbody>

</tgroup>
</table>

 <table id="eip-id1166568580863" class="unnumbered unstyled" summary="નિરપેક્ષ મૂલ્ય અને ઋણ સંખ્યાઓ ધરાવતી ગાણિતિક પદાવલી સરળ કરીને ક્રમ નક્કી કરવાનાં પગલાં."><label />
<tgroup cols="2"><tbody><row><entry><span class="token">ⓑ</span> </entry><entry /></row>
  <row>
    <entry>
</entry>
    <entry>
<m:math><m:mrow><m:mn>8</m:mn><m:mo>___</m:mo><m:mo>−</m:mo><m:mo>|</m:mo><m:mn>−8</m:mn><m:mo>|</m:mo></m:mrow></m:math></entry>
  </row>
  <row>
    <entry>સરળ કરો.</entry>
    <entry>
<m:math><m:mrow><m:mn>8</m:mn><m:mo>___</m:mo><m:mo>−</m:mo><m:mn>8</m:mn></m:mrow></m:math></entry>
  </row>
  <row>
    <entry>ક્રમ નક્કી કરો.</entry>
    <entry><m:math><m:mrow><m:mn>8</m:mn><m:mo>&gt;</m:mo><m:mo>−</m:mo><m:mn>8</m:mn></m:mrow></m:math></entry>
  </row>
</tbody>


</tgroup>
</table>

<table id="eip-id1166567977584" class="unnumbered unstyled" summary="કોષ્ટકમાં −9ની સરખામણી −9ના નિરપેક્ષ મૂલ્યની વિરોધી સંખ્યા સાથે કરવાની પ્રક્રિયા અને સરળ કરવાનાં પગલાં દર્શાવ્યાં છે."><label />
<tgroup cols="2"><tbody><row><entry><span class="token">ⓒ</span> </entry><entry /></row>
  <row>
 <entry />
  <entry><m:math><m:mn>−9</m:mn><m:mo>___</m:mo><m:mo>−</m:mo><m:mo>|</m:mo><m:mn>−9</m:mn><m:mo>|</m:mo><m:mspace width="1em" /></m:math></entry>
</row>
  <row>
    <entry>સરળ કરો.
</entry>
    <entry>
<m:math><m:mrow><m:mn>−9</m:mn><m:mo>___</m:mo><m:mo>−</m:mo><m:mn>9</m:mn></m:mrow></m:math></entry>
  </row>
  <row>
    <entry>ક્રમ નક્કી કરો.</entry>
    <entry>
<m:math><m:mrow><m:mn>−9</m:mn><m:mo>=</m:mo><m:mn>−9</m:mn></m:mrow></m:math></entry>
  </row>

</tbody>




</tgroup>
</table><table id="eip-id1166569017628" class="unnumbered unstyled" summary="નિરપેક્ષ મૂલ્યની બહાર ઋણ નિશાની ધરાવતી પદાવલી સરળ કરીને ક્રમ નક્કી કરવાનાં પગલાં દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
<row><entry><span class="token">ⓓ</span> </entry><entry /></row>
 <row>
   <entry />
   <entry><m:math><m:mo>−</m:mo><m:mo>|</m:mo><m:mn>−7</m:mn><m:mo>|</m:mo><m:mo>___</m:mo><m:mn>−7</m:mn></m:math></entry>
</row>
  <row>
    <entry>સરળ કરો.</entry>
    <entry>
<m:math><m:mrow><m:mn>−7</m:mn><m:mo>___</m:mo><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math></entry>
  </row>
  <row>
    <entry>ક્રમ નક્કી કરો.</entry>
    <entry><m:math><m:mrow><m:mn>−7</m:mn><m:mo>=</m:mo><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow></m:math></entry>
  </row>
</tbody>


</tgroup>
</table></solution>
</exercise></example><note id="fs-id2570761" class="try">
<exercise id="fs-id2711614"><problem id="fs-id1679527">
<para id="fs-id4297694">ભરો: <m:math><m:mrow><m:mtext>&lt;</m:mtext><m:mo>,</m:mo><m:mtext>&gt;</m:mtext><m:mo>,</m:mo><m:mtext> અથવા </m:mtext><m:mo>=</m:mo><m:mspace width="0.2em" /><m:mtext> નીચેના દરેક માટે: </m:mtext></m:mrow></m:math>

<list id="eip-id1168469875336" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mn>−9</m:mn><m:mo>|</m:mo><m:mspace width="0.2em" /><m:mtext>___</m:mtext><m:mo>−</m:mo><m:mo>|</m:mo><m:mn>−9</m:mn><m:mo>|</m:mo><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>2</m:mn><m:mo>___</m:mo><m:mo>−</m:mo><m:mo>|</m:mo><m:mn>−2</m:mn><m:mo>|</m:mo><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓒ</span> <m:math><m:mspace width="0.2em" /><m:mn>−8</m:mn><m:mo>___</m:mo><m:mo>|</m:mo><m:mn>−8</m:mn><m:mo>|</m:mo><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓓ</span> <m:math><m:mspace width="0.2em" /><m:mo>−</m:mo><m:mo>|</m:mo><m:mn>−5</m:mn><m:mo>|</m:mo><m:mtext>___</m:mtext><m:mn>−5</m:mn></m:math></item>

</list></para>

</problem>
<solution id="fs-id2727832">
<list id="eip-id1168468520073" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> &gt; </item>
<item><span class="token">ⓑ</span> &gt; </item>
<item><span class="token">ⓒ</span> &lt; </item>
<item><span class="token">ⓓ</span> = </item>
</list></solution>
</exercise></note>
<note id="fs-id1171105520809" class="try">
<exercise id="fs-id2008190"><problem id="fs-id3005014">
<para id="fs-id1171103714799">ભરો: <m:math><m:mrow><m:mtext>&lt;</m:mtext><m:mo>,</m:mo><m:mtext>&gt;</m:mtext><m:mo>,</m:mo><m:mtext> અથવા </m:mtext><m:mo>=</m:mo></m:mrow></m:math> નીચેના દરેક માટે:

<list id="eip-id1168469856365" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>7</m:mn><m:mtext>___</m:mtext><m:mo>−</m:mo><m:mo>|</m:mo><m:mn>−7</m:mn><m:mo>|</m:mo><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mo>−</m:mo><m:mo>|</m:mo><m:mn>−11</m:mn><m:mo>|</m:mo><m:mtext>___</m:mtext><m:mn>−11</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓒ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mn>−4</m:mn><m:mo>|</m:mo><m:mtext>___</m:mtext><m:mo>−</m:mo><m:mo>|</m:mo><m:mn>−4</m:mn><m:mo>|</m:mo><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓓ</span> <m:math><m:mspace width="0.2em" /><m:mn>−1</m:mn><m:mtext>___</m:mtext><m:mo>|</m:mo><m:mn>−1</m:mn><m:mo>|</m:mo></m:math></item>

</list></para>
</problem>
<solution id="fs-id2496191">
<list id="eip-id1168468610969" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> &gt;</item>
<item> <span class="token">ⓑ</span> =</item>
<item> <span class="token">ⓒ</span> &gt;</item>
<item><span class="token">ⓓ</span> &lt; </item>
</list></solution>
</exercise></note>
<para id="fs-id3499574"><term class="no-emphasis" id="term-00021">નિરપેક્ષ મૂલ્ય</term> ની ઊભી રેખાઓ જૂથ બનાવતાં ચિહ્નો જેવું કામ કરે છે. પહેલાં નિરપેક્ષ મૂલ્યની રેખાઓની અંદરની પદાવલી શક્ય તેટલી સરળ કરો. પછી મળેલી સંખ્યાનું નિરપેક્ષ મૂલ્ય લો અને નિરપેક્ષ મૂલ્યનાં ચિહ્નોની બહારની ક્રિયાઓ કરો.</para>
<example id="fs-id2580509">
<exercise id="fs-id1773308">
<problem id="fs-id3058031">
<para id="fs-id1632370">સરળ કરો:
<list id="eip-id1168469793229" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mn>9</m:mn><m:mn>−3</m:mn><m:mo>|</m:mo><m:mspace width="1em" /><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>4</m:mn><m:mo>|</m:mo><m:mn>−2</m:mn><m:mo>|</m:mo></m:math></item>

</list></para></problem>
<solution id="fs-id2701111">
<title>ઉકેલ</title>
<para id="fs-id1704002">દરેક પદાવલી માટે ક્રિયાઓનો ક્રમ અનુસરો. કૌંસની જેમ નિરપેક્ષ મૂલ્યનાં ચિહ્નોની અંદરથી શરૂ કરો.</para>
<para id="fs-id2695531"><table id="eip-id1168466096398" class="unnumbered unstyled" summary="નિરપેક્ષ મૂલ્યની પદાવલી સરળ કરવાની ક્રમશઃ પ્રક્રિયા, વચ્ચે મળતાં અને અંતિમ પરિણામો દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓐ</span> </entry>
<entry />
</row>
<row>
<entry />
   <entry>|9−3|</entry>
 </row>
 <row>
   <entry>નિરપેક્ષ મૂલ્યના ચિહ્નની અંદર સરળ કરો.</entry>
   <entry>|6|</entry>
 </row>
 <row>
   <entry>નિરપેક્ષ મૂલ્ય લો.</entry>
   <entry>6</entry>
 </row>


</tbody>







</tgroup>
</table><table id="eip-id1168469668431" class="unnumbered unstyled" summary="કોષ્ટકમાં નિરપેક્ષ મૂલ્યની પદાવલી 4|−2|ની કિંમત શોધવાનાં પગલાં દર્શાવ્યાં છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry><span class="token">ⓑ</span> </entry>
<entry />
</row>
<row>
<entry />
   <entry>4|−2|</entry>
 </row>
 <row>
   <entry>નિરપેક્ષ મૂલ્ય લો.</entry>
   <entry>4⋅2</entry>
 </row>
 <row>
   <entry>ગુણાકાર કરો.</entry>
   <entry>8</entry>
 </row>


</tbody>







</tgroup>
</table></para></solution>
</exercise>
</example>
<note id="fs-id3020759" class="try">
<exercise id="fs-id1877188"><problem id="fs-id2000946">
<para id="fs-id2017148">સરળ કરો:

<list id="eip-id1168466027915" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mn>12</m:mn><m:mo>−</m:mo><m:mn>9</m:mn><m:mo>|</m:mo><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>3</m:mn><m:mo>|</m:mo><m:mn>−6</m:mn><m:mo>|</m:mo></m:math></item>

</list></para></problem>
<solution id="fs-id2631145">
<list id="eip-id1168468239785" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> 3 </item>
<item><span class="token">ⓑ</span> 18 </item>
</list></solution>
</exercise></note>
<note id="fs-id1171105501743" class="try">
<exercise id="fs-id1887567"><problem id="fs-id2517985">
<para id="fs-id1171105157227">સરળ કરો:
<list id="eip-id1168468393830" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mn>27</m:mn><m:mo>−</m:mo><m:mn>16</m:mn><m:mo>|</m:mo><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>9</m:mn><m:mo>|</m:mo><m:mn>−7</m:mn><m:mo>|</m:mo></m:math></item>

</list></para></problem>
<solution id="fs-id1641081">
<list id="eip-id1168468389207" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> 11 </item>
<item><span class="token">ⓑ</span> 63 </item>
</list></solution>
</exercise></note>
<example id="fs-id1750035">
<exercise id="fs-id2238878">
<problem id="fs-id1693789">
<para id="fs-id1394201">સરળ કરો: <m:math><m:mrow><m:mo>|</m:mo><m:mrow><m:mn>8</m:mn><m:mo>+</m:mo><m:mn>7</m:mn></m:mrow><m:mo>|</m:mo><m:mo>−</m:mo><m:mo>|</m:mo><m:mrow><m:mn>5</m:mn><m:mo>+</m:mo><m:mn>6</m:mn></m:mrow><m:mo>|</m:mo><m:mo>.</m:mo></m:mrow></m:math>
</para>
</problem>
<solution id="fs-id2524664">
<title>ઉકેલ</title>
<para id="fs-id2353007">દરેક પદાવલી માટે ક્રિયાઓનો ક્રમ અનુસરો. આની અંદરથી શરૂ કરો: <term class="no-emphasis" id="term-00022">નિરપેક્ષ મૂલ્યનાં ચિહ્નો</term> કૌંસની જેમ.</para>
<para id="fs-id1293450"><table id="eip-id1168469785725" class="unnumbered unstyled" summary="નિરપેક્ષ મૂલ્યની પદાવલીને શરૂઆતના પ્રશ્નથી અંતિમ સંખ્યાત્મક પરિણામ સુધી સરળ કરવાનાં પગલાં દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry />
   <entry align="center">|8+7|−|5+6|</entry>
 </row>
 <row>
   <entry>નિરપેક્ષ મૂલ્યના દરેક ચિહ્નની અંદર સરળ કરો.</entry>
   <entry align="center">|15|−|11|</entry>
 </row>
 <row>
   <entry>બાદબાકી કરો.</entry>
   <entry align="center">4</entry>
 </row>


</tbody>







</tgroup>
</table></para></solution>
</exercise>
</example>
<note id="fs-id1926953" class="try">
<exercise id="fs-id1653980">
<problem id="fs-id1410633">
<para id="fs-id2770367">સરળ કરો: <m:math><m:mrow><m:mo>|</m:mo><m:mrow><m:mn>1</m:mn><m:mo>+</m:mo><m:mn>8</m:mn></m:mrow><m:mo>|</m:mo><m:mo>−</m:mo><m:mo>|</m:mo><m:mrow><m:mn>2</m:mn><m:mo>+</m:mo><m:mn>5</m:mn></m:mrow><m:mo>|</m:mo></m:mrow></m:math></para></problem>
<solution id="fs-id1819684">
<para id="fs-id1292060">2</para>
</solution>
</exercise>
</note>
<note id="fs-id1171105090096" class="try">
<exercise id="fs-id2336749">
<problem id="fs-id2548032">
<para id="fs-id1171105540420">સરળ કરો: <m:math><m:mrow><m:mo>|</m:mo><m:mrow><m:mn>9</m:mn><m:mn>−5</m:mn></m:mrow><m:mo>|</m:mo><m:mo>−</m:mo><m:mo>|</m:mo><m:mrow><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow><m:mo>|</m:mo></m:mrow></m:math></para></problem>
<solution id="fs-id3058052">
<para id="fs-id2581801">3</para>
</solution>
</exercise>
</note>
<example id="fs-id1708871">
<exercise id="fs-id2049023"><problem id="fs-id1785694">
<para id="fs-id1967290">સરળ કરો: <m:math><m:mrow><m:mn>24</m:mn><m:mo>−</m:mo><m:mo>|</m:mo><m:mrow><m:mn>19</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mn>6</m:mn><m:mo>−</m:mo><m:mn>2</m:mn><m:mo stretchy="false">)</m:mo></m:mrow><m:mo>|</m:mo><m:mo>.</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id4403272">
<title>ઉકેલ</title>
<para id="fs-id1865738">આપણે <term class="no-emphasis" id="term-00023">ક્રિયાઓનો ક્રમ</term> વાપરીએ છીએ. યાદ રાખો કે જૂથ બનાવતાં ચિહ્નોની અંદર પહેલાં સરળ કરવાનું છે; તેથી નિરપેક્ષ મૂલ્યનાં ચિહ્નોની અંદરના કૌંસ પહેલાં આવશે.</para>
<table id="eip-id1168467296922" class="unnumbered unstyled" summary="ક્રિયાઓના ક્રમ અને નિરપેક્ષ મૂલ્યનો ઉપયોગ કરીને ગાણિતિક પદાવલી સરળ કરવાનાં પગલાં દર્શાવે છે."><label />
<tgroup cols="2"><tbody>
 <row>
   <entry> </entry>
   <entry><m:math><m:mn>24</m:mn><m:mo>−</m:mo><m:mo stretchy="true">|</m:mo><m:mn>19</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>(</m:mo><m:mn>6</m:mn><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>)</m:mo><m:mo stretchy="true">|</m:mo></m:math></entry>
 </row>
 <row>
   <entry>પહેલાં કૌંસની અંદર સરળ કરો.</entry>
   <entry><m:math><m:mn>24</m:mn><m:mo>−</m:mo><m:mo stretchy="true">|</m:mo><m:mn>19</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mo>(</m:mo><m:mn>4</m:mn><m:mo>)</m:mo><m:mo stretchy="true">|</m:mo></m:math></entry>
 </row>
 <row>
   <entry>આનો ગુણાકાર કરો: <m:math><m:mn>3</m:mn><m:mo>(</m:mo><m:mn>4</m:mn><m:mo>)</m:mo></m:math>.</entry>
   <entry><m:math><m:mn>24</m:mn><m:mo>−</m:mo><m:mo stretchy="true">|</m:mo><m:mn>19</m:mn><m:mo>−</m:mo><m:mn>12</m:mn><m:mo stretchy="true">|</m:mo></m:math></entry>
 </row>
 <row>
 <entry>નિરપેક્ષ મૂલ્યના ચિહ્નની અંદર બાદબાકી કરો.</entry>
 <entry><m:math><m:mn>24</m:mn><m:mo>−</m:mo><m:mo stretchy="true">|</m:mo><m:mn>7</m:mn><m:mo stretchy="true">|</m:mo></m:math></entry>
 </row>
 <row>
 <entry>નિરપેક્ષ મૂલ્ય લો.</entry>
<entry><m:math><m:mn>24</m:mn><m:mo>−</m:mo><m:mn>7</m:mn></m:math></entry>
 </row>
 <row>
 <entry>બાદબાકી કરો.</entry>
 <entry><m:math><m:mn>17</m:mn></m:math></entry>
 </row>


</tbody>












</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id3349238" class="try">
<exercise id="fs-id4661068">
<problem id="fs-id1797402">
<para id="fs-id2354142">સરળ કરો: <m:math><m:mrow><m:mn>19</m:mn><m:mo>−</m:mo><m:mo>|</m:mo><m:mrow><m:mn>11</m:mn><m:mo>−</m:mo><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mn>3</m:mn><m:mo>−</m:mo><m:mn>1</m:mn><m:mo stretchy="false">)</m:mo></m:mrow><m:mo>|</m:mo></m:mrow></m:math></para></problem>
<solution id="fs-id3248760">
<para id="fs-id2571236">16</para>
</solution>
</exercise>
</note>
<note id="fs-id1171103376785" class="try">
<exercise id="fs-id1643890">
<problem id="fs-id2016518">
<para id="fs-id1171105090758">સરળ કરો: <m:math><m:mrow><m:mn>9</m:mn><m:mo>−</m:mo><m:mo>|</m:mo><m:mrow><m:mn>8</m:mn><m:mo>−</m:mo><m:mn>4</m:mn><m:mo stretchy="false">(</m:mo><m:mn>7</m:mn><m:mo>−</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow><m:mo>|</m:mo></m:mrow></m:math></para></problem>
<solution id="fs-id1311796">
<para id="fs-id1783158">9</para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1910275">
<title>શબ્દસમૂહોને પૂર્ણાંક ધરાવતી પદાવલીઓમાં ફેરવો</title>
<para id="fs-id1885017">હવે શબ્દસમૂહોને એવી પદાવલીઓમાં ફેરવી શકીએ, જેમાં આવે <term class="no-emphasis" id="term-00024">પૂર્ણાંકો</term>. ઋણ નિશાની દર્શાવતા શબ્દો શોધો. ઉદાહરણ તરીકે, આ શબ્દ <emphasis effect="italics">ઋણ</emphasis> “ઋણ વીસ”માં દર્શાવે છે <m:math><m:mn>−20</m:mn><m:mo>.</m:mo></m:math> તેવી જ રીતે આ શબ્દ <emphasis effect="italics">વિરોધી</emphasis> આ શબ્દસમૂહમાં દર્શાવે છે: “આ સંખ્યાની વિરોધી સંખ્યા: <m:math><m:mrow><m:mn>20</m:mn><m:mtext>.”</m:mtext></m:mrow></m:math></para>
<example id="fs-id3939941">
<exercise id="fs-id3257293"><problem id="fs-id1886593">
<para id="fs-id1930179">દરેક શબ્દસમૂહને પૂર્ણાંક ધરાવતી પદાવલીમાં ફેરવો:
<list id="eip-id1168466247724" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> ધન ચૌદની વિરોધી સંખ્યા</item>
<item><span class="token">ⓑ</span> આ સંખ્યાની વિરોધી સંખ્યા: <m:math><m:mn>−11</m:mn></m:math></item>
<item><span class="token">ⓒ</span> ઋણ સોળ </item>
<item><span class="token">ⓓ</span> બેમાંથી ઋણ સાત બાદ કરો</item></list></para>




</problem>
<solution id="fs-id1667990">
<title>ઉકેલ</title>
<list id="eip-id1168466348672" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> ચૌદની વિરોધી સંખ્યા<newline />
 <m:math><m:mrow><m:mn>−14</m:mn></m:mrow></m:math></item>

<item><span class="token">ⓑ</span> −11ની વિરોધી સંખ્યા<newline />
 <m:math><m:mrow><m:mo>−</m:mo><m:mo>(</m:mo><m:mn>−11</m:mn><m:mo>)</m:mo><m:mo>=</m:mo><m:mn>11</m:mn></m:mrow></m:math></item>


<item><span class="token">ⓒ</span> ઋણ સોળ<newline />
<m:math><m:mrow><m:mn>−16</m:mn></m:mrow></m:math></item>

<item><span class="token">ⓓ</span> બેમાંથી ઋણ સાત બાદ કરો<newline />
<m:math><m:mrow><m:mn>2</m:mn><m:mo>−</m:mo><m:mo>(</m:mo><m:mn>−7</m:mn><m:mo>)</m:mo></m:mrow></m:math>
</item>
</list></solution>
</exercise></example>
<note id="fs-id1292536" class="try">
<exercise id="fs-id3162194"><problem id="fs-id3939070">
<para id="fs-id2018022">દરેક શબ્દસમૂહને પૂર્ણાંક ધરાવતી પદાવલીમાં ફેરવો:
<list id="eip-id1168468244530" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> ધન નવની વિરોધી સંખ્યા </item>
<item><span class="token">ⓑ</span> આ સંખ્યાની વિરોધી સંખ્યા: <m:math><m:mrow><m:mn>−15</m:mn></m:mrow></m:math>  </item>
<item><span class="token">ⓒ</span> ઋણ વીસ  </item>
<item><span class="token">ⓓ</span> અગિયારમાંથી ઋણ ચાર બાદ કરો </item>
</list></para>
</problem>
<solution id="fs-id2771095">
<list id="eip-id1168466312519" list-type="enumerated" number-style="arabic" class="circled"><item>ⓐ −9 </item>
<item>ⓑ 15 </item>
<item>ⓒ −20 </item>
<item>ⓓ 11−(−4)</item>
</list></solution>
</exercise></note>
<note id="fs-id1171105477099" class="try">
<exercise id="fs-id4273241"><problem id="fs-id1932231">
<para id="fs-id1171103641178">દરેક શબ્દસમૂહને પૂર્ણાંક ધરાવતી પદાવલીમાં ફેરવો:
<list id="eip-id1168469566525" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> ઋણ ઓગણીસની વિરોધી સંખ્યા</item>
<item><span class="token">ⓑ</span> બાવીસની વિરોધી સંખ્યા </item>
<item><span class="token">ⓒ</span> ઋણ નવ </item>
<item><span class="token">ⓓ</span> ઋણ આઠમાંથી ઋણ પાંચ બાદ કરો </item>
</list></para>

</problem>
<solution id="fs-id1697542">
<list id="eip-id1168469877300" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> 19 </item>
<item><span class="token">ⓑ</span> −22</item>
<item><span class="token">ⓒ</span> −9</item>
<item><span class="token">ⓓ</span> −8−(−5)</item>
</list>
</solution>
</exercise></note>
<para id="fs-id1331891">આ વિભાગની શરૂઆતમાં જોયું તેમ, રોજિંદા જીવનની ઘણી પરિસ્થિતિઓ વર્ણવવા ઋણ સંખ્યાઓ જરૂરી છે. આગળના ઉદાહરણમાં ઋણ સંખ્યાઓના વધુ કેટલાક ઉપયોગ જોઈશું.</para>
<example id="fs-id1199536">
<exercise id="fs-id3225381"><problem id="fs-id2548166">
<para id="fs-id2505373">પૂર્ણાંક ધરાવતી પદાવલીમાં ફેરવો:

<list id="eip-id1168469545597" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> તાપમાન છે <m:math><m:mn>12</m:mn><m:mspace width="0.2em" /><m:mtext> ડિગ્રી ફેરનહાઇટ </m:mtext></m:math> શૂન્યથી નીચે.</item>

<item><span class="token">ⓑ</span> ફૂટબૉલની ટીમ આટલું આગળ વધી: <m:math><m:mn>3</m:mn><m:mspace width="0.2em" /><m:mtext> યાર્ડ. </m:mtext></m:math></item>

<item><span class="token">ⓒ</span> મૃત સમુદ્રની ઊંચાઈ છે <m:math><m:mn>1,302</m:mn><m:mspace width="0.2em" /><m:mtext> ફૂટ </m:mtext></m:math> સમુદ્રની સપાટીથી નીચે.</item>

<item><span class="token">ⓓ</span> ચેકિંગ ખાતામાં જમા રકમ કરતાં આટલો વધુ ઉપાડ થયો છે: <m:math><m:mtext>$40.</m:mtext></m:math></item></list></para></problem>
<solution id="fs-id757707">
<title>ઉકેલ</title>
<para id="fs-id2008138">દરેક વાક્યમાં મુખ્ય શબ્દસમૂહ શોધો. પછી ઋણ નિશાની દર્શાવતા શબ્દો શોધો. વાક્યમાં જણાવેલા માપના એકમો સામેલ કરવાનું ભૂલશો નહીં.</para>
<table id="eip-id1166567530079" class="unnumbered unstyled" summary="ઋણ તાપમાન વર્ણવતા શબ્દસમૂહોનો અર્થ અને તેમને સંખ્યામાં દર્શાવવાની રીત સમજાવે છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry><span class="token">ⓐ</span> 
</entry>
    <entry> તાપમાન 12 ડિગ્રી ફેરનહાઇટ શૂન્યથી નીચે છે.</entry>
  </row>
  <row>
    <entry><emphasis effect="italics">શૂન્યથી નીચે</emphasis> એ દર્શાવે છે કે 12 ઋણ સંખ્યા છે.
</entry>
    <entry>
<m:math><m:mrow><m:mo>−</m:mo><m:mn>12ºF</m:mn></m:mrow></m:math>
</entry>
  </row>
</tbody>


</tgroup>
</table>
<table id="eip-id1166568935976" class="unnumbered unstyled" summary="કોષ્ટકમાં ફૂટબૉલમાં આગળ વધવાની પરિસ્થિતિ દર્શાવીને તેનું વર્ણન ધન સંખ્યાત્મક મૂલ્ય સાથે જોડ્યું છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry><span class="token">ⓑ</span> 
</entry>
    <entry> ફૂટબૉલની ટીમ 3 યાર્ડ આગળ વધી.</entry>
  </row>
  <row>
    <entry>આ શબ્દ <emphasis effect="italics">આગળ વધવું</emphasis> દર્શાવે છે કે 3 ધન સંખ્યા છે.
</entry>
    <entry>
<m:math><m:mrow><m:mn>3</m:mn></m:mrow></m:math> યાર્ડ
</entry>
  </row>
</tbody>

</tgroup>
</table>
<table id="eip-id1166568936114" class="unnumbered unstyled" summary="કોષ્ટકમાં “સમુદ્રની સપાટીથી નીચે”ને ઋણ મૂલ્ય તરીકે સમજાવ્યું છે; મૃત સમુદ્રની −1,302 ફૂટ ઊંચાઈ તેનું ઉદાહરણ છે."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry><span class="token">ⓒ</span> </entry>
    <entry> મૃત સમુદ્રની ઊંચાઈ 1,302 ફૂટ સમુદ્રની સપાટીથી નીચે છે.</entry>
  </row>
  <row>
    <entry><emphasis effect="italics">સમુદ્રની સપાટીથી નીચે</emphasis> એ દર્શાવે છે કે 1,302 ઋણ સંખ્યા છે.
</entry>
    <entry>
<m:math><m:mrow><m:mo>−</m:mo><m:mn>1,302</m:mn></m:mrow></m:math> ફૂટ
</entry>
  </row>
</tbody>

</tgroup>
</table>
<table id="eip-id1166566291529" class="unnumbered unstyled" summary="ચેકિંગ ખાતામાં જમા રકમ કરતાં વધુ ઉપાડને ઋણ સંખ્યા તરીકે દર્શાવતું ઉદાહરણ."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry><span class="token">ⓓ</span> </entry>
    <entry> ચેકિંગ ખાતામાં જમા રકમ કરતાં $40 વધુ ઉપાડ થયો છે.</entry>
  </row>
  <row>
    <entry><emphasis effect="italics">જમા કરતાં વધુ ઉપાડ</emphasis> એ દર્શાવે છે કે 40 ઋણ સંખ્યા છે.</entry>
    <entry>
<m:math><m:mrow><m:mo>−</m:mo><m:mn>$40</m:mn></m:mrow></m:math>
</entry>
  </row>
</tbody>

</tgroup>
</table></solution>
</exercise></example>
<note id="fs-id1701459" class="try">
<exercise id="fs-id1615902">
<problem id="fs-id1797592">
<para id="fs-id1286882">પૂર્ણાંક ધરાવતી પદાવલીમાં ફેરવો:</para>
<para id="fs-id1787708">ફૂટબૉલની ટીમ આટલું આગળ વધી: <m:math><m:mrow><m:mn>5</m:mn><m:mspace width="0.2em" /><m:mtext> યાર્ડ. </m:mtext></m:mrow></m:math></para>
</problem>
<solution id="fs-id3175613">
<para id="fs-id1950924">5 યાર્ડ</para>
</solution>
</exercise>
</note>
<note id="fs-id1171103492044" class="try">
<exercise id="fs-id2017693">
<problem id="fs-id2017564">
<para id="fs-id1171105178311">પૂર્ણાંક ધરાવતી પદાવલીમાં ફેરવો:</para>
<para id="fs-id2337411">સ્કૂબા ડાઇવર હતો <m:math><m:mrow><m:mn>30</m:mn><m:mspace width="0.2em" /><m:mtext> ફૂટ </m:mtext></m:mrow></m:math> પાણીની સપાટીથી નીચે.</para>
</problem>
<solution id="fs-id1239300">
<para id="fs-id1955799">−30 ફૂટ</para>
</solution>
</exercise>
</note>
<note id="fs-id2568209" class="media-2"><title>વધારાનાં ઑનલાઇન સંસાધનો જુઓ</title><list id="fs-id2608336" display="block">
<item><link url="https://openstaxcollege.org/l/24introinteger">પૂર્ણાંકોનો પરિચય</link></item>
<item><link url="https://openstaxcollege.org/l/24neginteger">ઋણ પૂર્ણાંકોની વિરોધી સંખ્યાઓ સરળ કરવી</link></item>
<item><link url="https://openstaxcollege.org/l/24abvalue">પૂર્ણાંકોના નિરપેક્ષ મૂલ્યની સરખામણી</link></item>
<item><link url="https://openstaxcollege.org/l/24usinginequal">અસમાનતાઓ વડે પૂર્ણાંકોની સરખામણી</link></item>
</list>
</note></section>
<section id="fs-id1967130" class="key-concepts">
<title>મુખ્ય સંકલ્પનાઓ</title>
<list id="fs-id1375824" list-type="bulleted" bullet-style="bullet"><item>વિરોધી સંખ્યાની લખાવટ
<list id="eip-id1168467150822" list-type="bulleted" bullet-style="open-circle"><item><m:math><m:mrow><m:mo>−</m:mo><m:mi>a</m:mi></m:mrow></m:math> એ આ સંખ્યાની વિરોધી સંખ્યા દર્શાવે છે: <m:math><m:mi>a</m:mi></m:math></item>
<item>આ લખાવટ <m:math><m:mrow><m:mo>−</m:mo><m:mi>a</m:mi></m:mrow></m:math> આ રીતે વાંચીએ: <emphasis effect="italics">આ સંખ્યાની વિરોધી સંખ્યા:</emphasis> <m:math><m:mi>a</m:mi><m:mo>.</m:mo></m:math></item></list>
</item>
<item>નિરપેક્ષ મૂલ્યની લખાવટ
<list id="eip-id1168467332657"><item>આ સંખ્યાનું નિરપેક્ષ મૂલ્ય: <m:math><m:mi>n</m:mi></m:math> આ રીતે લખાય છે: <m:math><m:mrow><m:mrow><m:mo>|</m:mo><m:mi>n</m:mi><m:mo>|</m:mo></m:mrow></m:mrow></m:math>.</item>
<item><m:math><m:mrow><m:mrow><m:mo>|</m:mo><m:mi>n</m:mi><m:mo>|</m:mo></m:mrow><m:mo>≥</m:mo><m:mn>0</m:mn></m:mrow></m:math> બધી સંખ્યાઓ માટે.</item>
</list>

</item></list></section>
<section id="fs-id2344650" class="section-exercises">
<section id="fs-id4344891" class="practice-perfect"><title>અભ્યાસથી નિપુણતા</title><para id="fs-id2942770"><emphasis effect="bold">સંખ્યારેખા પર ધન અને ઋણ સંખ્યાઓનું સ્થાન દર્શાવો</emphasis> </para><para id="eip-702">નીચેના અભ્યાસ માટે સંખ્યારેખા દોરો અને આપેલાં બિંદુઓનાં સ્થાન દર્શાવીને તેમની ઓળખ લખો.</para><exercise id="fs-id1653512">
<problem id="fs-id1935504">
<para id="fs-id1615925"><list id="eip-id1168467165258" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>2</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−2</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓒ</span> <m:math><m:mspace width="0.2em" /><m:mn>−5</m:mn></m:math></item>
</list></para></problem>
<solution id="fs-id1798295">
<para id="fs-id1171105096046"><newline />
<media id="fs-id1372283" alt="ચિત્રમાં સંખ્યારેખા છે. ઋણ 5 પાસે c, બે એકમ ડાબે આની: 0, ત્યાં b, અને બે એકમ જમણે આની: 0, ત્યાં a લખેલું છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_201_img.jpg" />
</media></para>
</solution>
</exercise>
<exercise id="fs-id1396178"><problem id="fs-id1789410">
<list id="eip-id1168468469726" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>5</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−5</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓒ</span> <m:math><m:mspace width="0.2em" /><m:mn>−2</m:mn></m:math></item>

</list></problem>
</exercise><exercise id="fs-id2321993"><problem id="fs-id3425623">
<list id="eip-id1168468694196" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>−8</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>8</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓒ</span> <m:math><m:mspace width="0.2em" /><m:mn>−6</m:mn></m:math></item>

</list>
</problem>
<solution id="fs-id2537148">
<para id="fs-id1171103688417"><newline />
<media id="fs-id1054913" alt="ચિત્રમાં સંખ્યારેખા છે. ઋણ 8 પાસે a, ઋણ 6 પાસે c અને 5 પાસે b લખેલું છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_03_01_203_img.jpg" />
</media></para>
</solution>
</exercise><exercise id="fs-id1226032"><problem id="fs-id2610360">
<list id="eip-id1168469711517" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>−7</m:mn><m:mspace width="1em" />
</m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>7</m:mn><m:mspace width="1em" /></m:math></item>
<item><span class="token">ⓒ</span> <m:math><m:mspace width="0.2em" /><m:mn>−1</m:mn></m:math></item>
</list>
</problem>
</exercise><para id="fs-id1756514"><emphasis effect="bold">સંખ્યારેખા પર ધન અને ઋણ સંખ્યાઓનો ક્રમ નક્કી કરો</emphasis> </para><para id="eip-862">નીચેના અભ્યાસમાં દરેક સંખ્યાજોડીની સરખામણી કરવા વાપરો: <m:math><m:mrow><m:mo>&lt;</m:mo></m:mrow></m:math> અથવા <m:math><m:mrow><m:mtext>&gt;.</m:mtext></m:mrow></m:math></para><exercise id="fs-id1945782"><problem id="fs-id1611798">
<para id="fs-id1701064"><list id="eip-id1168469475733" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>9</m:mn><m:mtext>__</m:mtext><m:mn>4</m:mn><m:mspace width="0.2em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−3</m:mn><m:mtext>__</m:mtext><m:mn>6</m:mn><m:mspace width="0.2em" /></m:math></item>

<item><span class="token">ⓒ</span> <m:math><m:mspace width="0.2em" /><m:mn>−8</m:mn><m:mtext>__</m:mtext><m:mn>−2</m:mn><m:mspace width="0.2em" /></m:math></item>

<item><span class="token">ⓓ</span> <m:math><m:mspace width="0.2em" /><m:mn>1</m:mn><m:mtext>__</m:mtext><m:mn>−10</m:mn></m:math></item>

</list></para>
</problem>
<solution id="fs-id1617621">
<list id="eip-id1168468289303" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> &gt; </item>
<item><span class="token">ⓑ</span> &lt; </item>
<item><span class="token">ⓒ</span> &lt; </item>
<item><span class="token">ⓓ</span> &gt; </item>
</list></solution>
</exercise><exercise id="fs-id1889175"><problem id="fs-id2584430">
<list id="eip-id1168467492766" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>6</m:mn><m:mtext>__</m:mtext><m:mn>2</m:mn><m:mo>;</m:mo><m:mspace width="0.2em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−7</m:mn><m:mtext>__</m:mtext><m:mn>4</m:mn><m:mo>;</m:mo><m:mspace width="0.2em" /></m:math></item>

<item><span class="token">ⓒ</span> <m:math><m:mspace width="0.2em" /><m:mn>−9</m:mn><m:mtext>__</m:mtext><m:mn>−1</m:mn><m:mo>;</m:mo><m:mspace width="0.2em" /></m:math></item>

<item><span class="token">ⓓ</span> <m:math><m:mspace width="0.2em" /><m:mn>9</m:mn><m:mtext>__</m:mtext><m:mn>−3</m:mn></m:math></item>
</list></problem>
</exercise><exercise id="fs-id1926155"><problem id="fs-id1676528">
<list id="eip-id1168467143999" class="circled" list-type="enumerated" number-style="arabic"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>−5</m:mn><m:mtext>__</m:mtext><m:mn>1</m:mn><m:mo>;</m:mo><m:mspace width="0.2em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−4</m:mn><m:mtext>__</m:mtext><m:mn>−9</m:mn><m:mo>;</m:mo><m:mspace width="0.2em" /></m:math></item>

<item><span class="token">ⓒ</span> <m:math><m:mspace width="0.2em" /><m:mn>6</m:mn><m:mtext>__</m:mtext><m:mn>10</m:mn><m:mo>;</m:mo><m:mspace width="0.2em" /></m:math></item>

<item><span class="token">ⓓ</span> <m:math><m:mspace width="0.2em" /><m:mn>3</m:mn><m:mtext>__</m:mtext><m:mn>−8</m:mn></m:math></item>
</list>
</problem>


<solution id="fs-id2341584">
<list id="eip-id1168468388584" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> &lt; </item>
<item><span class="token">ⓑ</span> &gt; </item>
<item><span class="token">ⓒ</span> &lt; </item>
<item><span class="token">ⓓ</span> &gt; </item>
</list></solution>
</exercise><exercise id="fs-id2239506"><problem id="fs-id1379788"><list id="eip-id1168469523733" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>−7</m:mn><m:mtext>__</m:mtext><m:mn>3</m:mn><m:mo>;</m:mo><m:mspace width="0.2em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−10</m:mn><m:mtext>__</m:mtext><m:mn>−5</m:mn><m:mo>;</m:mo><m:mspace width="0.2em" /></m:math></item>

<item><span class="token">ⓒ</span> <m:math><m:mspace width="0.2em" /><m:mn>2</m:mn><m:mtext>__</m:mtext><m:mn>−6</m:mn><m:mo>;</m:mo><m:mspace width="0.2em" /></m:math></item>

<item><span class="token">ⓓ</span> <m:math><m:mspace width="0.2em" /><m:mn>8</m:mn><m:mtext>__</m:mtext><m:mn>9</m:mn></m:math></item>
</list>
</problem>
</exercise><para id="fs-id2787619"><emphasis effect="bold">વિરોધી સંખ્યાઓ શોધો</emphasis> </para><para id="eip-901">નીચેના અભ્યાસમાં દરેક સંખ્યાની વિરોધી સંખ્યા શોધો.</para><exercise id="fs-id2059225"><problem id="fs-id758866">
<list id="eip-id1168468456328" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>2</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−6</m:mn></m:math></item>

</list>
</problem>
<solution id="fs-id1346010">
<list id="eip-id1168468398565" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> −2 </item>
<item><span class="token">ⓑ</span> 6 </item>
</list></solution>
</exercise><exercise id="fs-id2341790"><problem id="fs-id3119245">
<list id="eip-id1168468586309" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>9</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>−4</m:mn></m:math></item>
</list>
</problem>
</exercise><exercise id="fs-id2715632"><problem id="fs-id1630602">
<list id="eip-id1168468653068" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>−8</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>1</m:mn></m:math></item>

</list>
</problem>
<solution id="fs-id3058064">
<list id="eip-id1168466071835" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> 8 </item>
<item><span class="token">ⓑ</span> −1 </item>
</list></solution>
</exercise><exercise id="fs-id1635143"><problem id="fs-id2570337">
<list id="eip-id1168466170218" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>−2</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>6</m:mn></m:math></item>
</list></problem>
</exercise><para id="fs-id1571899">નીચેના અભ્યાસમાં સરળ કરો.</para><exercise id="fs-id1331546">
<problem id="fs-id1333968">
<para id="fs-id2616696"><m:math><m:mrow><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−4</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2648322">
<para id="fs-id3527780">4</para>
</solution>
</exercise>
<exercise id="fs-id1935143">
<problem id="fs-id2536852">
<para id="fs-id1331788"><m:math><m:mrow><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−8</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1875913">
<problem id="fs-id1878198">
<para id="fs-id2887186"><m:math><m:mrow><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−15</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id2556651">
<para id="fs-id2610282">15</para>
</solution>
</exercise>
<exercise id="fs-id1933673">
<problem id="fs-id2000480">
<para id="fs-id1402975"><m:math><m:mrow><m:mo>−</m:mo><m:mo stretchy="false">(</m:mo><m:mn>−11</m:mn><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para></problem>
</exercise>
<para id="fs-id1742965">નીચેના અભ્યાસમાં કિંમત શોધો.</para><exercise id="fs-id1743136"><problem id="fs-id3333703">
<para id="fs-id2786344"><m:math><m:mo>−</m:mo><m:mi>m</m:mi><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /></m:math>

<list id="eip-id1168469743351" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>3</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mi>m</m:mi><m:mo>=</m:mo><m:mn>−3</m:mn></m:math></item>

</list></para>
</problem>
<solution id="fs-id1338436">
<list id="eip-id1168468250649" list-type="enumerated" number-style="arabic" class="circled"><item> <span class="token">ⓐ</span> −3 </item>
<item> <span class="token">ⓑ</span> 3 </item>
</list></solution>
</exercise><exercise id="fs-id1611234">
<problem id="fs-id1250726">
<para id="fs-id1809290"><m:math><m:mo>−</m:mo><m:mi>p</m:mi><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /></m:math>
<list id="eip-id1168466170213" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mi>p</m:mi><m:mo>=</m:mo><m:mn>6</m:mn><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mi>p</m:mi><m:mo>=</m:mo><m:mn>−6</m:mn></m:math></item>
</list></para></problem>
</exercise>
<exercise id="fs-id1385457"><problem id="fs-id1830712">
<para id="fs-id2546270"><m:math><m:mo>−</m:mo><m:mi>c</m:mi><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /></m:math>
<list id="eip-id1168468610892" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mi>c</m:mi><m:mo>=</m:mo><m:mn>12</m:mn><m:mspace width="1em" /></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mi>c</m:mi><m:mo>=</m:mo><m:mn>−12</m:mn></m:math></item>
</list></para>
</problem>
<solution id="fs-id2946007">
<list id="eip-id1168468756296" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> −12; </item>
<item><span class="token">ⓑ</span> 12 </item>
</list>
</solution>
</exercise><exercise id="fs-id1593644">
<problem id="fs-id1361722">
<para id="fs-id1908530"><m:math><m:mo>−</m:mo><m:mi>d</m:mi><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /></m:math>
<list id="eip-id1168467202995" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mi>d</m:mi><m:mo>=</m:mo><m:mn>21</m:mn><m:mspace width="1em" /></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mi>d</m:mi><m:mo>=</m:mo><m:mn>−21</m:mn></m:math></item>
</list></para></problem>
</exercise>
<para id="fs-id1813786"><emphasis effect="bold">નિરપેક્ષ મૂલ્ય ધરાવતી પદાવલીઓ સરળ કરો</emphasis> </para><para id="eip-527">નીચેના અભ્યાસમાં નિરપેક્ષ મૂલ્યની દરેક પદાવલી સરળ કરો.</para><exercise id="fs-id1345680"><problem id="fs-id2544303">
<list id="eip-id1168466130944" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mn>7</m:mn><m:mo>|</m:mo><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mn>−25</m:mn><m:mo>|</m:mo><m:mspace width="1em" /></m:math></item>

<item>ⓒ<m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mn>0</m:mn><m:mo>|</m:mo></m:math></item>
</list></problem>
<solution id="fs-id1659330">
<list id="eip-id1168468253616" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> 7 </item>
<item><span class="token">ⓑ</span> 25 </item>
<item><span class="token">ⓒ</span> 0 </item>
</list></solution>
</exercise><exercise id="fs-id1350656"><problem id="fs-id1335789">
<list id="eip-id1168469606686" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mn>5</m:mn><m:mo>|</m:mo><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mrow><m:mn>20</m:mn></m:mrow><m:mo>|</m:mo><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓒ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mrow><m:mn>−19</m:mn></m:mrow><m:mo>|</m:mo></m:math></item>

</list>
</problem>
</exercise><exercise id="fs-id1603841"><problem id="fs-id1333010">
<list id="eip-id1168469895685" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mn>−32</m:mn><m:mo>|</m:mo><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mn>−18</m:mn><m:mo>|</m:mo><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓒ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mn>16</m:mn><m:mo>|</m:mo></m:math></item>
</list>
</problem>
<solution id="fs-id1935979">
<list id="eip-id1168467192160" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> 32 </item>
<item><span class="token">ⓑ</span> 18 </item>
<item><span class="token">ⓒ</span> 16</item>
</list></solution>
</exercise><exercise id="fs-id1761408"><problem id="fs-id1615197">
<list id="eip-id1168469868372" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mn>−41</m:mn><m:mo>|</m:mo><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mn>−40</m:mn><m:mo>|</m:mo><m:mspace width="1em" /></m:math></item>

<item><span class="token">ⓒ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mn>22</m:mn><m:mo>|</m:mo></m:math></item>
</list></problem>
</exercise><para id="fs-id2335670">નીચેના અભ્યાસમાં નિરપેક્ષ મૂલ્યની દરેક પદાવલીની કિંમત શોધો.</para><exercise id="fs-id1248614"><problem id="fs-id1767743">
<list id="eip-id1168468289862" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mi>x</m:mi><m:mo>|</m:mo><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>x</m:mi><m:mo>=</m:mo><m:mn>−28</m:mn></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mo>−</m:mo><m:mi>u</m:mi><m:mo>|</m:mo><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>u</m:mi><m:mo>=</m:mo><m:mn>−15</m:mn></m:math></item>

</list>
</problem>
<solution id="fs-id3225453">
<list id="eip-id1168467293920" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> 28 </item>
<item><span class="token">ⓑ</span> 15 </item>
</list></solution>
</exercise><exercise id="fs-id1406053"><problem id="fs-id1613267">
<list id="eip-id1168468281692" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mi>y</m:mi><m:mo>|</m:mo><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>y</m:mi><m:mo>=</m:mo><m:mn>−37</m:mn></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mo>−</m:mo><m:mi>z</m:mi><m:mo>|</m:mo><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>z</m:mi><m:mo>=</m:mo><m:mn>−24</m:mn></m:math></item>
</list></problem>
</exercise><exercise id="fs-id1377464"><problem id="fs-id1760040">
<list id="eip-id1168468433499" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mo>−</m:mo><m:mo>|</m:mo><m:mi>p</m:mi><m:mo>|</m:mo><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>p</m:mi><m:mo>=</m:mo><m:mn>19</m:mn></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mo>−</m:mo><m:mo>|</m:mo><m:mi>q</m:mi><m:mo>|</m:mo><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>q</m:mi><m:mo>=</m:mo><m:mn>−33</m:mn></m:math></item>
</list></problem>
<solution id="fs-id2334749">
<list id="eip-id1168468357548" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> −19</item>
<item><span class="token">ⓑ</span> −33</item>
</list></solution>
</exercise><exercise id="fs-id1628935"><problem id="fs-id1255535">
<list id="eip-id1168466163284" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mo>−</m:mo><m:mo>|</m:mo><m:mi>a</m:mi><m:mo>|</m:mo><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>a</m:mi><m:mo>=</m:mo><m:mn>60</m:mn></m:math></item>

<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mo>−</m:mo><m:mo>|</m:mo><m:mi>b</m:mi><m:mo>|</m:mo><m:mspace width="0.2em" /><m:mtext> જ્યારે </m:mtext><m:mspace width="0.2em" /><m:mi>b</m:mi><m:mo>=</m:mo><m:mn>−12</m:mn></m:math></item>
</list></problem>
</exercise><para id="fs-id1368924">નીચેના અભ્યાસમાં ભરો: <m:math><m:mrow><m:mtext>&lt;</m:mtext><m:mo>,</m:mo><m:mtext>&gt;</m:mtext><m:mo>,</m:mo><m:mtext> અથવા </m:mtext><m:mo>=</m:mo></m:mrow></m:math> દરેક પદાવલીની સરખામણી કરવા.</para><exercise id="fs-id1654350"><problem id="fs-id1255103">
<list id="eip-id1168468261146" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>−6</m:mn><m:mtext>__</m:mtext><m:mo>|</m:mo><m:mn>−6</m:mn><m:mo>|</m:mo><m:mspace width="0.2em" /></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mo>−</m:mo><m:mo>|</m:mo><m:mn>−3</m:mn><m:mo>|</m:mo><m:mtext>__</m:mtext><m:mn>−3</m:mn></m:math></item>
</list></problem>
<solution id="fs-id2506204">
<list id="eip-id1168467301018" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> &lt; </item>
<item><span class="token">ⓑ</span> =</item>
</list></solution>
</exercise><exercise id="fs-id1974033"><problem id="fs-id2511532">
<list id="eip-id1168465998165" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mn>−8</m:mn><m:mtext>__</m:mtext><m:mo>|</m:mo><m:mn>−8</m:mn><m:mo>|</m:mo><m:mspace width="0.2em" /></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mo>−</m:mo><m:mo>|</m:mo><m:mn>−2</m:mn><m:mo>|</m:mo><m:mtext>__</m:mtext><m:mn>−2</m:mn></m:math></item>
</list></problem>
</exercise><exercise id="fs-id2330927"><problem id="fs-id1567028">
<list id="eip-id1168467492791" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mn>−3</m:mn><m:mo>|</m:mo><m:mtext>__</m:mtext><m:mo>−</m:mo><m:mo>|</m:mo><m:mn>−3</m:mn><m:mo>|</m:mo><m:mspace width="0.2em" /></m:math></item>
<item><span class="token">ⓑ</span> <m:math><m:mspace width="0.2em" /><m:mn>4</m:mn><m:mtext>__</m:mtext><m:mo>−</m:mo><m:mo>|</m:mo><m:mn>−4</m:mn><m:mo>|</m:mo></m:math></item>
</list>
</problem>
<solution id="fs-id2006246">
<list id="eip-id1168468483806" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> &gt;</item>
<item><span class="token">ⓑ</span> &gt;</item>
</list>
</solution>
</exercise><exercise id="fs-id1668973"><problem id="fs-id1565328">
<list id="eip-id1168468350528" list-type="enumerated" number-style="arabic" class="circled"><item><span class="token">ⓐ</span> <m:math><m:mspace width="0.2em" /><m:mo>|</m:mo><m:mn>−5</m:mn><m:mo>|</m:mo><m:mtext>__</m:mtext><m:mo>−</m:mo><m:mo>|</m:mo><m:mn>−5</m:mn><m:mo>|</m:mo><m:mspace width="0.2em" /></m:math></item>
<item>ⓑ<m:math><m:mspace width="0.2em" /><m:mn>9</m:mn><m:mtext>__</m:mtext><m:mo>−</m:mo><m:mo>|</m:mo><m:mn>−9</m:mn><m:mo>|</m:mo></m:math></item>
</list></problem>
</exercise><para id="fs-id2715205">નીચેના અભ્યાસમાં દરેક પદાવલી સરળ કરો.</para><exercise id="fs-id1998557">
<problem id="fs-id1998559">
<para id="fs-id2707014"><m:math><m:mrow><m:mo>|</m:mo><m:mrow><m:mn>8</m:mn><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow><m:mo>|</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id3437980">
<para id="fs-id3437983">4</para>
</solution>
</exercise>
<exercise id="fs-id3051702">
<problem id="fs-id2349858">
<para id="fs-id2349860"><m:math><m:mrow><m:mo>|</m:mo><m:mrow><m:mn>9</m:mn><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow><m:mo>|</m:mo></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1255649">
<problem id="fs-id2674797">
<para id="fs-id1761313"><m:math><m:mrow><m:mn>8</m:mn><m:mo>|</m:mo><m:mrow><m:mn>−7</m:mn></m:mrow><m:mo>|</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1230696">
<para id="fs-id1224790">56</para>
</solution>
</exercise>
<exercise id="fs-id4017851">
<problem id="fs-id4017853">
<para id="fs-id1346246"><m:math><m:mrow><m:mn>5</m:mn><m:mo>|</m:mo><m:mrow><m:mn>−5</m:mn></m:mrow><m:mo>|</m:mo></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id1304798">
<problem id="fs-id2673483">
<para id="fs-id2673485"><m:math><m:mrow><m:mo>|</m:mo><m:mrow><m:mn>15</m:mn><m:mo>−</m:mo><m:mn>7</m:mn></m:mrow><m:mo>|</m:mo><m:mo>−</m:mo><m:mo>|</m:mo><m:mrow><m:mn>14</m:mn><m:mo>−</m:mo><m:mn>6</m:mn></m:mrow><m:mo>|</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1826314">
<para id="fs-id1826316">0</para>
</solution>
</exercise>
<exercise id="fs-id3424766">
<problem id="fs-id2243009">
<para id="fs-id2243011"><m:math><m:mrow><m:mo>|</m:mo><m:mrow><m:mn>17</m:mn><m:mo>−</m:mo><m:mn>8</m:mn></m:mrow><m:mo>|</m:mo><m:mo>−</m:mo><m:mo>|</m:mo><m:mrow><m:mn>13</m:mn><m:mo>−</m:mo><m:mn>4</m:mn></m:mrow><m:mo>|</m:mo></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id3090523">
<problem id="fs-id2714720">
<para id="fs-id2714722"><m:math><m:mrow><m:mn>18</m:mn><m:mo>−</m:mo><m:mo>|</m:mo><m:mrow><m:mn>2</m:mn><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mo>−</m:mo><m:mn>3</m:mn><m:mo stretchy="false">)</m:mo></m:mrow><m:mo>|</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id4166923">
<para id="fs-id1865677">8</para>
</solution>
</exercise>
<exercise id="fs-id2020017">
<problem id="fs-id3329671">
<para id="fs-id2060338"><m:math><m:mrow><m:mn>15</m:mn><m:mo>−</m:mo><m:mo>|</m:mo><m:mrow><m:mn>3</m:mn><m:mo stretchy="false">(</m:mo><m:mn>8</m:mn><m:mo>−</m:mo><m:mn>5</m:mn><m:mo stretchy="false">)</m:mo></m:mrow><m:mo>|</m:mo></m:mrow></m:math></para>
