<para id="fs-id2715745"><m:math><m:mrow><m:mn>8</m:mn><m:mo stretchy="false">(</m:mo><m:mn>14</m:mn><m:mo>−</m:mo><m:mn>2</m:mn><m:mo>|</m:mo><m:mrow><m:mn>−2</m:mn></m:mrow><m:mo>|</m:mo><m:mo stretchy="false">)</m:mo></m:mrow></m:math></para>
</problem>
<solution id="fs-id1669600">
<para id="fs-id1669603">80</para>
</solution>
</exercise>
