<?xml version='1.0' encoding='utf-8'?>
<document xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" xmlns:ns1="http://cnx.rice.edu/mdml" xml:lang="gu-Gujr-IN">
<title>અવિભાજ્ય અવયવીકરણ અને લઘુત્તમ સામાન્ય અવયવી</title>
<metadata>
  <ns1:content-id>m81273</ns1:content-id>
  <ns1:title>અવિભાજ્ય અવયવીકરણ અને લઘુત્તમ સામાન્ય અવયવી</ns1:title>
  <ns1:abstract><para id="para-00001">આ વિભાગના અંતે તમે:</para>
<list id="list-00001">
<item>સંયુક્ત સંખ્યાનું અવિભાજ્ય અવયવીકરણ શોધી શકશો</item>
<item>બે સંખ્યાઓનો લઘુત્તમ સામાન્ય અવયવી (LCM) શોધી શકશો</item>
</list></ns1:abstract>
  <ns1:uuid>f844b6a5-7d09-4876-b9dc-aa70a9d3a4af</ns1:uuid>
</metadata>

<content>
<note id="fs-id2210144" class="be-prepared">
<para id="fs-id1833162">શરૂઆત કરતાં પહેલાં તૈયારી તપાસવાના આ પ્રશ્નો ઉકેલો.</para>
<exercise id="fs-idm207759728">
<problem id="fs-idm175130512">
<para id="fs-idm187755040">શું <m:math><m:mrow><m:mn>810</m:mn></m:mrow></m:math> આના વડે વિભાજ્ય છે: <m:math><m:mrow><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>5</m:mn><m:mo>,</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mtext> અથવા </m:mtext><m:mspace width="0.2em" /><m:mn>10</m:mn><m:mo>?</m:mo></m:mrow></m:math><newline />જો આ પ્રશ્નનો જવાબ ન મળ્યો હોય, તો ફરી જુઓ <link target-id="fs-id1159977" document="m81272" />.</para>
</problem>
<solution id="fs-idm191507024">
<para id="fs-idm202854032"><m:math><m:mrow><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>5</m:mn><m:mo>,</m:mo><m:mn>6</m:mn><m:mo>,</m:mo><m:mn>10</m:mn></m:mrow></m:math></para>
</solution>
</exercise></note>
<note id="fs-id2310144" class="be-prepared">
<exercise id="fs-idm221537168">
<problem id="fs-idm221166336">
<para id="fs-idm189112640">શું <m:math><m:mrow><m:mn>127</m:mn></m:mrow></m:math> અવિભાજ્ય છે કે સંયુક્ત?<newline />જો આ પ્રશ્નનો જવાબ ન મળ્યો હોય, તો ફરી જુઓ <link target-id="fs-id1756650" document="m81272" />.</para>
</problem>
<solution id="fs-idm210312992">
<para id="fs-idm217961216">અવિભાજ્ય</para>
</solution>
</exercise>
<exercise id="fs-idm187674160">
<problem id="fs-idm214020224">
<para id="fs-idm211406528">લખો <m:math><m:mrow><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>2</m:mn></m:mrow></m:math> ઘાતના સ્વરૂપમાં.<newline />જો આ પ્રશ્નનો જવાબ ન મળ્યો હોય, તો ફરી જુઓ <link target-id="fs-id1971784" document="m81268" />.</para>
</problem>
<solution id="fs-idm214736592">
<para id="fs-idm211897488"><m:math><m:mrow><m:msup><m:mn>2</m:mn><m:mn>4</m:mn></m:msup></m:mrow></m:math></para>
</solution>
</exercise></note>
<section id="fs-id2268140">
<title>સંયુક્ત સંખ્યાનું અવિભાજ્ય અવયવીકરણ શોધો</title>
<para id="fs-id2692103">અગાઉના વિભાગમાં સંખ્યાના અવયવ શોધ્યા. અવિભાજ્ય સંખ્યાના માત્ર બે અવયવ હોય છે: સંખ્યા <m:math><m:mrow><m:mn>1</m:mn></m:mrow></m:math> અને અવિભાજ્ય સંખ્યા પોતે. સંયુક્ત સંખ્યાના બે કરતાં વધુ અવયવ હોય છે અને દરેક સંયુક્ત સંખ્યાને અવિભાજ્ય સંખ્યાઓના અનન્ય ગુણનફળ તરીકે લખી શકાય. તેને સંખ્યાનું <term id="term-00001">અવિભાજ્ય અવયવીકરણ</term>  કહે છે. અવિભાજ્ય અવયવીકરણ લખીએ ત્યારે સંખ્યાને અવિભાજ્ય સંખ્યાઓના ગુણનફળ તરીકે ફરી લખીએ છીએ. આ અભ્યાસક્રમમાં આગળ જતાં સંયુક્ત સંખ્યાનું અવિભાજ્ય અવયવીકરણ ઉપયોગી થશે.</para>
<note id="fs-id1783914">
<title>અવિભાજ્ય અવયવીકરણ</title>
<para id="fs-id2310594">સંખ્યાનું અવિભાજ્ય અવયવીકરણ એ અવિભાજ્ય સંખ્યાઓનું એવું ગુણનફળ છે જે આપેલી સંખ્યા બરાબર હોય.</para>
</note>
<note id="eip-941" class="manipulative-math">હાથથી સામગ્રી ગોઠવીને ગણિત સમજવાની “અવિભાજ્ય સંખ્યાઓ” પ્રવૃત્તિ કરવાથી અવિભાજ્ય સંખ્યાઓની વધુ સારી સમજ મળશે.</note><para id="fs-id2471450">આ વિભાગમાં કામ કરતાં, નીચેની યાદીનો સંદર્ભ લઈ શકો; તેમાં આ સંખ્યા કરતાં નાની અવિભાજ્ય સંખ્યાઓ છે: <m:math><m:mrow><m:mn>50</m:mn></m:mrow></m:math> .</para>
<equation id="fs-id2904623" class="unnumbered"><label /><m:math><m:mrow><m:mn>2</m:mn><m:mo>,</m:mo><m:mn>3</m:mn><m:mo>,</m:mo><m:mn>5</m:mn><m:mo>,</m:mo><m:mn>7</m:mn><m:mo>,</m:mo><m:mn>11</m:mn><m:mo>,</m:mo><m:mn>13</m:mn><m:mo>,</m:mo><m:mn>17</m:mn><m:mo>,</m:mo><m:mn>19</m:mn><m:mo>,</m:mo><m:mn>23</m:mn><m:mo>,</m:mo><m:mn>29</m:mn><m:mo>,</m:mo><m:mn>31</m:mn><m:mo>,</m:mo><m:mn>37</m:mn><m:mo>,</m:mo><m:mn>41</m:mn><m:mo>,</m:mo><m:mn>43</m:mn><m:mo>,</m:mo><m:mn>47</m:mn></m:mrow></m:math></equation>
<section id="fs-id2759014">
<title>અવયવવૃક્ષની પદ્ધતિથી અવિભાજ્ય અવયવીકરણ</title>
<para id="fs-id1632121">સંખ્યાનું અવિભાજ્ય અવયવીકરણ શોધવાની એક રીત છે <term class="no-emphasis" id="term-00002">અવયવવૃક્ષ</term> બનાવવાની. પહેલાં સંખ્યા લખીએ, પછી તેને બે અવયવના ગુણનફળ તરીકે લખીએ. અવયવોને સંખ્યાની નીચે લખીને નાના રેખાખંડથી સંખ્યા સાથે જોડીએ; તે અવયવવૃક્ષની “શાખા” છે.</para>
<para id="fs-id1841262">જો અવયવ અવિભાજ્ય હોય, તો તેની આસપાસ વર્તુળ કરીએ, જાણે વૃક્ષ પર કળી હોય; પછી તે શાખાનું વધુ અવયવીકરણ ન કરીએ. જો અવયવ અવિભાજ્ય ન હોય, તો પ્રક્રિયા ફરી કરીએ: તેને બે અવયવના ગુણનફળ તરીકે લખીને વૃક્ષમાં નવી શાખાઓ ઉમેરીએ.</para>
<para id="fs-id1510405">બધી શાખાના છેડે અવિભાજ્ય સંખ્યા મળે ત્યાં સુધી ચાલુ રાખીએ. અવયવવૃક્ષ પૂરું થાય ત્યારે વર્તુળ કરેલી અવિભાજ્ય સંખ્યાઓથી અવિભાજ્ય અવયવીકરણ મળે છે.</para>
<para id="fs-id2168577">ઉદાહરણ તરીકે, આ સંખ્યાનું અવિભાજ્ય અવયવીકરણ શોધીએ: <m:math><m:mrow><m:mn>36</m:mn><m:mo>.</m:mo></m:mrow></m:math> અવયવની કોઈ પણ જોડીથી શરૂઆત કરી શકીએ, જેમ કે <m:math><m:mn>3</m:mn></m:math> અને <m:math><m:mrow><m:mn>12</m:mn><m:mo>.</m:mo></m:mrow></m:math> આપણે લખીએ <m:math><m:mn>3</m:mn></m:math> અને <m:math><m:mrow><m:mn>12</m:mn></m:mrow></m:math> આ સંખ્યાની નીચે: <m:math><m:mrow><m:mn>36</m:mn></m:mrow></m:math> અને શાખાથી તેમને જોડીએ.</para>
<media id="fs-id2777835" alt="ચિત્રમાં અવયવવૃક્ષ છે, જેની ટોચ પર 36 છે. સંખ્યા 36ની નીચેથી બે શાખા નીકળે છે. જમણી શાખાના છેડે 3 છે અને તેની આસપાસ વર્તુળ છે. ડાબી શાખાના છેડે 12 છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_02_05_018_img.jpg" />
</media>
<para id="fs-id1312499">અવયવ <m:math><m:mn>3</m:mn></m:math> અવિભાજ્ય છે, તેથી તેની આસપાસ વર્તુળ કરીએ. અવયવ <m:math><m:mrow><m:mn>12</m:mn></m:mrow></m:math> સંયુક્ત છે, તેથી તેના અવયવ શોધવા પડશે. આ જોડી લઈએ: <m:math><m:mn>3</m:mn></m:math> અને <m:math><m:mrow><m:mn>4</m:mn><m:mo>.</m:mo></m:mrow></m:math> આ અવયવો વૃક્ષમાં નીચે લખીએ, આ સંખ્યાની: <m:math><m:mrow><m:mn>12</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<media id="fs-id1631520" alt="ચિત્રમાં અવયવવૃક્ષ છે, જેની ટોચ પર 36 છે. સંખ્યા 36ની નીચેથી બે શાખા નીકળે છે. જમણી શાખાના છેડે 3 છે અને તેની આસપાસ વર્તુળ છે. ડાબી શાખાના છેડે 12 છે. સંખ્યા 12ની નીચેથી બીજી બે શાખા નીકળે છે. જમણી શાખાના છેડે 4 અને ડાબી શાખાના છેડે 3 છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_02_05_019_img.jpg" />
</media>
<para id="fs-id2133008">અવયવ <m:math><m:mrow><m:mn>3</m:mn></m:mrow></m:math> અવિભાજ્ય છે, તેથી તેની આસપાસ વર્તુળ કરીએ. અવયવ <m:math><m:mrow><m:mn>4</m:mn></m:mrow></m:math> સંયુક્ત છે અને તેનું અવયવીકરણ છે <m:math><m:mrow><m:mn>2</m:mn><m:mo>·</m:mo><m:mn>2</m:mn><m:mo>.</m:mo></m:mrow></m:math> આ અવયવો નીચે લખીએ, આ સંખ્યાની: <m:math><m:mrow><m:mn>4</m:mn><m:mo>.</m:mo></m:mrow></m:math> આ સંખ્યા: <m:math><m:mrow><m:mn>2</m:mn></m:mrow></m:math> અવિભાજ્ય હોવાથી વર્તુળ કરીએ બંને <m:math><m:mrow><m:mn>2</m:mn><m:mtext> ની આસપાસ </m:mtext><m:mo>.</m:mo></m:mrow></m:math></para>
<media id="fs-id2492072" alt="ચિત્રમાં અવયવવૃક્ષ છે, જેની ટોચ પર 36 છે. સંખ્યા 36ની નીચેથી બે શાખા નીકળે છે. જમણી શાખાના છેડે 3 છે અને તેની આસપાસ વર્તુળ છે. ડાબી શાખાના છેડે 12 છે. સંખ્યા 12ની નીચેથી બીજી બે શાખા નીકળે છે. જમણી શાખાના છેડે 4 અને ડાબી શાખાના છેડે 3 છે, જેની આસપાસ વર્તુળ છે. સંખ્યા 4ની નીચેથી બીજી બે શાખા નીકળે છે. ડાબી અને જમણી બંને શાખાના છેડે 2 છે અને બંનેની આસપાસ વર્તુળ છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_02_05_009_img.jpg" />
</media>
<para id="fs-id2280966">વર્તુળ કરેલી અવિભાજ્ય સંખ્યાઓનું ગુણનફળ એટલે અવિભાજ્ય અવયવીકરણ. સામાન્ય રીતે અવિભાજ્ય અવયવ નાનાથી મોટા ક્રમમાં લખીએ છીએ.</para>
<equation id="fs-id1891683" class="unnumbered"><label /><m:math><m:mrow><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>3</m:mn><m:mo>⋅</m:mo><m:mn>3</m:mn></m:mrow></m:math></equation>
<para id="fs-id1472205">આવા કિસ્સામાં કેટલાક અવિભાજ્ય અવયવ ફરી આવે છે, તેથી અવિભાજ્ય અવયવીકરણ ઘાતના સ્વરૂપમાં લખી શકીએ.</para>
<equation id="fs-id2279211" class="unnumbered"><label /><m:math><m:mtable><m:mtr><m:mtd><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>3</m:mn><m:mo>⋅</m:mo><m:mn>3</m:mn></m:mtd></m:mtr><m:mtr><m:mtd /></m:mtr><m:mtr><m:mtd><m:msup><m:mn>2</m:mn><m:mn>2</m:mn></m:msup><m:mo>⋅</m:mo><m:msup><m:mn>3</m:mn><m:mn>2</m:mn></m:msup></m:mtd></m:mtr></m:mtable></m:math></equation>
<para id="fs-id1215798">ધ્યાન આપો કે અવયવવૃક્ષની શરૂઆત આ સંખ્યાના અવયવની કોઈ પણ જોડીથી કરી શકતા: <m:math><m:mrow><m:mn>36</m:mn><m:mo>.</m:mo></m:mrow></m:math> આપણે લીધા <m:math><m:mrow><m:mn>12</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>3</m:mn><m:mo>,</m:mo></m:mrow></m:math> પરંતુ એ જ પરિણામ મળત જો શરૂઆત કરીએ <m:math><m:mn>2</m:mn></m:math> અને <m:math><m:mrow><m:mn>18</m:mn><m:mo>,</m:mo><m:mn>4</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>9</m:mn><m:mo>,</m:mo><m:mtext> અથવા </m:mtext><m:mspace width="0.2em" /><m:mn>6</m:mn><m:mspace width="0.2em" /><m:mtext> અને </m:mtext><m:mspace width="0.2em" /><m:mn>6</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<note id="fs-id2967696" class="howto"><title>અવયવવૃક્ષની પદ્ધતિથી સંયુક્ત સંખ્યાનું અવિભાજ્ય અવયવીકરણ શોધો.</title><list id="eip-id1168469875559" list-type="enumerated" number-style="arabic" class="stepwise"><item>આપેલી સંખ્યાના અવયવની કોઈ પણ જોડી શોધો અને આ બે સંખ્યાથી બે શાખા બનાવો.</item>
<item>જો અવયવ અવિભાજ્ય હોય, તો તે શાખા પૂરી થઈ. અવિભાજ્ય સંખ્યાની આસપાસ વર્તુળ કરો.</item>
<item>જો અવયવ અવિભાજ્ય ન હોય, તો તેને અવયવની જોડીના ગુણનફળ તરીકે લખો અને પ્રક્રિયા ચાલુ રાખો.</item>
<item>સંયુક્ત સંખ્યાને વર્તુળ કરેલી બધી અવિભાજ્ય સંખ્યાઓના ગુણનફળ તરીકે લખો.</item>
</list></note><example id="fs-id1528968">
<exercise id="fs-id1313576"><problem id="fs-id1614444">
<para id="fs-id1737489">આ સંખ્યાનું અવિભાજ્ય અવયવીકરણ શોધો: <m:math><m:mrow><m:mn>48</m:mn></m:mrow></m:math> અવયવવૃક્ષની પદ્ધતિથી.</para>
</problem>
<solution id="fs-id1607674">
<title>ઉકેલ</title>
<table id="eip-id1168466026521" class="unnumbered unstyled" aria-label="ચિત્રમાં અનેક અવયવવૃક્ષ છે, જેની ટોચ પર 48 છે. પહેલા વૃક્ષમાં 48ની નીચેથી બે શાખા નીકળે છે. અવયવની જોડી 2 અને 24 છે; જમણી શાખાના છેડે 24 અને ડાબીના છેડે 2 છે. બેની આસપાસ વર્તુળ છે, જે તે અવિભાજ્ય હોવાનું અને શાખા પૂરી થયાનું દર્શાવે છે. પછીના વૃક્ષમાં અગાઉનું વૃક્ષ ફરી છે, પરંતુ હવે 24ની નીચેથી બે શાખા નીકળે છે. અવયવની જોડી 4 અને 6 છે; જમણી શાખાના છેડે 6 અને ડાબીના છેડે 4 છે. બંનેમાંથી કોઈની આસપાસ વર્તુળ નથી, કારણ કે તેઓ અવિભાજ્ય નથી. છેલ્લા વૃક્ષમાં અગાઉનું વૃક્ષ ફરી છે, પરંતુ હવે 4ની નીચેથી બે શાખા અને 6ની નીચેથી બે શાખા નીકળે છે. આ સંખ્યાની નીચેની શાખાઓ: 4, અવયવની જોડી 2 અને 2 દર્શાવે છે. બંને બેની આસપાસ વર્તુળ છે, જે તેઓ અવિભાજ્ય હોવાનું અને શાખા પૂરી થયાનું દર્શાવે છે. આ સંખ્યાની નીચેની શાખાઓ: 6, અવયવની જોડી 2 અને 3 દર્શાવે છે. બંનેની આસપાસ વર્તુળ છે, જે તેઓ અવિભાજ્ય હોવાનું અને શાખા પૂરી થયાનું દર્શાવે છે. સંખ્યા 48નું અવિભાજ્ય અવયવીકરણ વૃક્ષની બધી વર્તુળ કરેલી સંખ્યાઓથી બને છે: 2, 2, 2, 2 અને 3. અવિભાજ્ય અવયવીકરણ આ રીતે લખી શકાય: 2 ગુણ્યા 2 ગુણ્યા 2 ગુણ્યા 2 ગુણ્યા 3. આ સંખ્યાના વારંવારના ગુણાકાર માટે ઘાત વાપરીને: 2, તેને લખી શકાય 2ની ચોથી ઘાત ગુણ્યા 3.">
<label /><tgroup cols="2">
 <tbody>
  <row>
    <entry><para id="eip-id1168469860438">વૃક્ષની શરૂઆત કોઈ પણ અવયવજોડીથી કરી શકીએ, આ સંખ્યાની: 48. આ જોડી લઈએ: 2 અને 24. </para><para id="eip-id1168469860440">અવયવ 2ની આસપાસ વર્તુળ કરીએ, કારણ કે તે અવિભાજ્ય છે અને તે શાખા પૂરી થઈ.</para></entry>
    <entry><media id="eip-id1168469860444" alt="અવયવવૃક્ષમાં સંખ્યા 48માંથી તેના અવયવ તરફ શાખા નીકળે છે. તેની તરત નીચે 2 અને 24 છે; સંખ્યા 2ની આસપાસ વર્તુળ છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_05_022_img-01.png" /></media></entry>
  </row>
  <row>
    <entry>હવે અવયવીકરણ કરીએ, આ સંખ્યાનું: 24. આ જોડી લઈએ: 4 અને 6.</entry>
    <entry><media id="eip-id1168469408943" alt="આંશિક રીતે પૂરું થયેલું અવયવવૃક્ષ સંખ્યા 48નું અવિભાજ્ય અવયવીકરણ દર્શાવે છે. અવિભાજ્ય અવયવ 2ની આસપાસ વર્તુળ છે અને 24, 4 તથા 6 માટે શાખાઓ છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_05_022_img-02.png" /></media></entry>
  </row>
  <row>
    <entry><para id="eip-id1168466275583"> બંનેમાંથી કોઈ અવયવ અવિભાજ્ય નથી, તેથી એકેયની આસપાસ વર્તુળ ન કરીએ. <newline /> અવયવીકરણ કરીએ, આ સંખ્યાનું: 4; અવયવ લઈએ 2 અને 2. <newline /> અવયવીકરણ કરીએ, આ સંખ્યાનું: 6; અવયવ લઈએ 2 અને 3. </para><para id="eip-id1168466275590">બધા 2 અને એક 3ની આસપાસ વર્તુળ કરીએ, કારણ કે તેઓ અવિભાજ્ય છે. હવે બધી શાખાના છેડે અવિભાજ્ય સંખ્યા છે.</para></entry>
    <entry><media id="eip-id1168469871229" alt="અવયવવૃક્ષ સંખ્યા 48નું અવિભાજ્ય અવયવીકરણ દર્શાવે છે: તેના અવિભાજ્ય અવયવ 2, 2, 2, 2 અને 3 છે, જેમનો ગુણાકાર કરતાં 48 મળે છે. આ રીત સંખ્યાને તેના મૂળભૂત અવિભાજ્ય ઘટકોમાં વહેંચે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_05_022_img-03.png" /></media></entry>
  </row>
  <row>
    <entry>વર્તુળ કરેલી સંખ્યાઓનું ગુણનફળ લખો.</entry>
    <entry><m:math><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>3</m:mn></m:math></entry>
  </row>
  <row>
    <entry>ઘાતના સ્વરૂપમાં લખો.</entry>
    <entry><m:math><m:msup><m:mn>2</m:mn><m:mn>4</m:mn></m:msup><m:mo>⋅</m:mo><m:mn>3</m:mn></m:math></entry>
  </row>
</tbody>

</tgroup>
</table>
<para id="fs-id1828493">બધા અવયવોનો ગુણાકાર કરીને જાતે ચકાસો. પરિણામ આ હોવું જોઈએ: <m:math><m:mrow><m:mn>48</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</solution>
</exercise></example>
<note id="fs-id2597265" class="try">
<exercise id="fs-id2784105">
<problem id="fs-id1892040">
<para id="fs-id1386307">અવયવવૃક્ષની પદ્ધતિથી અવિભાજ્ય અવયવીકરણ શોધો: <m:math><m:mrow><m:mn>80</m:mn></m:mrow></m:math></para></problem>
<solution id="fs-id991172">
<para id="fs-id1517811">2 ⋅ 2 ⋅ 2 ⋅ 2 ⋅ 5, અથવા 2<sup>4</sup> ⋅ 5</para>
</solution>
</exercise>
</note>
<note id="fs-id1171103928958" class="try">
<exercise id="fs-id1791080">
<problem id="fs-id1494422">
<para id="fs-id1171104075257">અવયવવૃક્ષની પદ્ધતિથી અવિભાજ્ય અવયવીકરણ શોધો: <m:math><m:mrow><m:mn>60</m:mn></m:mrow></m:math></para></problem>
<solution id="fs-id1545814">
<para id="fs-id1281819">2 ⋅ 2 ⋅ 3 ⋅ 5, અથવા 2<sup>2</sup> ⋅ 3 ⋅ 5</para>
</solution>
</exercise>
</note>
<example id="fs-id1374964">
<exercise id="fs-id1919178"><problem id="fs-id2818054">
<para id="fs-id2568002">આ સંખ્યાનું અવિભાજ્ય અવયવીકરણ શોધો: 84; અવયવવૃક્ષની પદ્ધતિથી.</para>
</problem>
<solution id="fs-id2311391">
<title>ઉકેલ</title>
<table id="eip-id1168467446629" class="unnumbered unstyled" aria-label="ચિત્રમાં બે અવયવવૃક્ષ છે, જેની ટોચ પર 84 છે. પહેલા વૃક્ષમાં 84ની નીચેથી બે શાખા નીકળે છે. અવયવની જોડી 4 અને 21 છે; જમણી શાખાના છેડે 21 અને ડાબીના છેડે 4 છે. છેલ્લા વૃક્ષમાં અગાઉનું વૃક્ષ ફરી છે, પરંતુ હવે 4ની નીચેથી બે શાખા અને 21ની નીચેથી બે શાખા નીકળે છે. આ સંખ્યાની નીચેની શાખાઓ: 4, અવયવની જોડી 2 અને 2 દર્શાવે છે. બંને બેની આસપાસ વર્તુળ છે, જે તેઓ અવિભાજ્ય હોવાનું અને શાખા પૂરી થયાનું દર્શાવે છે. આ સંખ્યાની નીચેની શાખાઓ: 21, અવયવની જોડી 3 અને 7 દર્શાવે છે. બંનેની આસપાસ વર્તુળ છે, જે તેઓ અવિભાજ્ય હોવાનું અને શાખા પૂરી થયાનું દર્શાવે છે. સંખ્યા 84નું અવિભાજ્ય અવયવીકરણ વૃક્ષની બધી વર્તુળ કરેલી સંખ્યાઓથી બને છે: 2, 2, 3 અને 7. અવિભાજ્ય અવયવીકરણ આ રીતે લખી શકાય: 2 ગુણ્યા 2 ગુણ્યા 3 ગુણ્યા 7. આ સંખ્યાના વારંવારના ગુણાકાર માટે ઘાત વાપરીને: 2, તેને લખી શકાય 2નો વર્ગ ગુણ્યા 3 ગુણ્યા 7."><label />
<tgroup cols="2"><tbody>
  <row>
    <entry><para id="eip-id1168468561574">અવયવની આ જોડીથી શરૂઆત કરીએ: 4 અને 21. </para><para id="eip-id1168468561576">બંનેમાંથી કોઈ અવયવ અવિભાજ્ય નથી, તેથી વધુ અવયવીકરણ કરીએ.</para></entry>
    <entry><media id="eip-id1168468294078" alt="અવયવવૃક્ષમાં સંખ્યા 84માંથી તેના અવયવ 4 અને 21 તરફ શાખા નીકળે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_05_023_img-01.png" /></media></entry>
  </row>
  <row>
    <entry>હવે બધા અવયવ અવિભાજ્ય છે, તેથી તેમની આસપાસ વર્તુળ કરીએ.</entry>
    <entry><media id="eip-id1168468774285" alt="અવિભાજ્ય અવયવીકરણનું વૃક્ષ બતાવે છે કે સંખ્યા 84ને તેના અવિભાજ્ય અવયવમાં કેવી રીતે વહેંચી શકાય: 2, 2, 3 અને 7."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_05_023_img-02.png" /></media></entry>
  </row>
  <row>
    <entry>પછી આ સંખ્યાને, 84, વર્તુળ કરેલી બધી અવિભાજ્ય સંખ્યાઓના ગુણનફળ તરીકે લખીએ.</entry>
    <entry><m:math><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>3</m:mn><m:mo>⋅</m:mo><m:mn>7</m:mn></m:math><newline />
    <m:math><m:msup><m:mn>2</m:mn><m:mn>2</m:mn></m:msup><m:mo>⋅</m:mo><m:mn>3</m:mn><m:mo>⋅</m:mo><m:mn>7</m:mn></m:math></entry>
  </row>
</tbody>



</tgroup>
</table><para id="fs-id2379012">આ સંખ્યાનું અવયવવૃક્ષ દોરો: <m:math><m:mrow><m:mn>84</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</solution>
</exercise></example>
<note id="fs-id1812847" class="try">
<exercise id="fs-id1904680">
<problem id="fs-id1574335">
<para id="fs-id1312880">અવયવવૃક્ષની પદ્ધતિથી અવિભાજ્ય અવયવીકરણ શોધો: <m:math><m:mrow><m:mn>126</m:mn></m:mrow></m:math></para></problem>
<solution id="fs-id1805297">
<para id="fs-id1891867">2 ⋅ 3 ⋅ 3 ⋅ 7, અથવા 2 ⋅ 3<sup>2</sup> ⋅ 7</para>
</solution>
</exercise>
</note>
<note id="fs-id1171104087867" class="try">
<exercise id="fs-id1542080">
<problem id="fs-id1880890">
<para id="fs-id1171104385207">અવયવવૃક્ષની પદ્ધતિથી અવિભાજ્ય અવયવીકરણ શોધો: <m:math><m:mrow><m:mn>294</m:mn></m:mrow></m:math></para></problem>
<solution id="fs-id2238151">
<para id="fs-id2299156">2 ⋅ 3 ⋅ 7 ⋅ 7, અથવા 2 ⋅ 3 ⋅ 7<sup>2</sup></para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1392559">
<title>નિસરણીની પદ્ધતિથી અવિભાજ્ય અવયવીકરણ</title>
<para id="fs-id1518735">આ <term class="no-emphasis" id="term-00003">નિસરણીની પદ્ધતિ</term> સંયુક્ત સંખ્યાના અવિભાજ્ય અવયવ શોધવાની બીજી રીત છે. તે અવયવવૃક્ષની પદ્ધતિ જેવું જ પરિણામ આપે છે. કેટલાકને અવયવવૃક્ષ કરતાં નિસરણીની પદ્ધતિ વધુ ગમે છે, અને કેટલાકને તેનું ઊલટું.</para>
<para id="fs-id1040789">“નિસરણી” બનાવવાની શરૂઆત માટે, આપેલી સંખ્યાને તેના સૌથી નાના અવિભાજ્ય અવયવ વડે ભાગો. ઉદાહરણ તરીકે, આ સંખ્યા માટે નિસરણી શરૂ કરવા: <m:math><m:mrow><m:mn>36</m:mn><m:mo>,</m:mo></m:mrow></m:math> આપણે ભાગીએ <m:math><m:mrow><m:mn>36</m:mn></m:mrow></m:math> ને <m:math><m:mrow><m:mn>2</m:mn><m:mo>,</m:mo></m:mrow></m:math> વડે; તે સૌથી નાનો અવિભાજ્ય અવયવ છે, આ સંખ્યાનો: <m:math><m:mrow><m:mn>36</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<media id="fs-id2451776" alt="ચિત્રમાં 2 વડે 36ને ભાગતાં ભાગફળ 18 મળે છે. ભાગાકારના કૌંસની બહાર ડાબે 2, અંદર 36 અને ઉપર 18 છે; તે 36ની ઉપર કૌંસની બહાર છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_02_05_010_img.jpg" />
</media>
<para id="fs-id1253635">નિસરણીમાં “પગથિયું” ઉમેરવા, એ જ અવિભાજ્ય સંખ્યા વડે નિઃશેષ ભાગી શકાય ત્યાં સુધી વારંવાર ભાગીએ.</para>
<media id="fs-id2698106" alt="ચિત્રમાં 2 વડે 36ને ભાગતાં ભાગફળ 18 મળે છે. ભાગાકારના કૌંસની બહાર ડાબે 2, અંદર 36 અને ઉપર 18 છે; તે 36ની ઉપર કૌંસની બહાર છે. ભાગફળ 18ની આસપાસ બીજો ભાગાકારનો કૌંસ છે; બહાર ડાબે 2 અને ઉપર 9 છે, જે 18ની ઉપર કૌંસની બહાર છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_02_05_011_img.jpg" />
</media>
<para id="fs-id1567092">પછી પછીની અવિભાજ્ય સંખ્યા વડે ભાગીએ; એટલે ભાગીએ <m:math><m:mn>9</m:mn></m:math> ને, આના વડે: <m:math><m:mrow><m:mn>3</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<media id="fs-id2205845" alt="ચિત્રમાં 2 વડે 36ને ભાગતાં ભાગફળ 18 મળે છે. ભાગાકારના કૌંસની બહાર ડાબે 2, અંદર 36 અને ઉપર 18 છે; તે 36ની ઉપર કૌંસની બહાર છે. ભાગફળ 18ની આસપાસ બીજો ભાગાકારનો કૌંસ છે; બહાર ડાબે 2 અને ઉપર 9 છે, જે 18ની ઉપર કૌંસની બહાર છે. ભાગફળ 9ની આસપાસ બીજો ભાગાકારનો કૌંસ છે; બહાર ડાબે 3 અને ઉપર 3 છે, જે 9ની ઉપર કૌંસની બહાર છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_02_05_012_img.jpg" />
</media>
<para id="fs-id2323265">ભાગફળ અવિભાજ્ય થાય ત્યાં સુધી આ રીતે ભાગતાં નિસરણીમાં ઉપર વધીએ. અહીં ભાગફળ <m:math><m:mrow><m:mn>3</m:mn><m:mo>,</m:mo></m:mrow></m:math> અવિભાજ્ય હોવાથી અટકીએ.</para>
<para id="fs-id1806165">નિસરણીની પદ્ધતિને ક્યારેક એકની ઉપર એક ગોઠવેલા ભાગાકારની પદ્ધતિ કેમ કહે છે તે દેખાય છે?</para>
<para id="fs-id1370585">નિસરણીની બાજુઓ અને ટોચ પરની બધી અવિભાજ્ય સંખ્યાઓનું ગુણનફળ એટલે અવિભાજ્ય અવયવીકરણ.</para>
<equation id="fs-id4369169" class="unnumbered"><label /><m:math><m:mtable><m:mtr><m:mtd><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>3</m:mn><m:mo>⋅</m:mo><m:mn>3</m:mn></m:mtd></m:mtr><m:mtr><m:mtd /></m:mtr><m:mtr><m:mtd><m:msup><m:mn>2</m:mn><m:mn>2</m:mn></m:msup><m:mo>⋅</m:mo><m:msup><m:mn>3</m:mn><m:mn>2</m:mn></m:msup></m:mtd></m:mtr></m:mtable></m:math></equation>
<para id="fs-id1194091">ધ્યાન આપો કે અવયવવૃક્ષની પદ્ધતિથી જે મળ્યું હતું તે જ પરિણામ અહીં મળે છે.</para>
<note id="fs-id1722874" class="howto"><title>નિસરણીની પદ્ધતિથી સંયુક્ત સંખ્યાનું અવિભાજ્ય અવયવીકરણ શોધો.</title><list id="eip-id1168468309839" list-type="enumerated" number-style="arabic" class="stepwise"><item>સંખ્યાને સૌથી નાની અવિભાજ્ય સંખ્યા વડે ભાગો.</item>
<item>તે અવિભાજ્ય સંખ્યા વડે નિઃશેષ ભાગી શકાય ત્યાં સુધી વારંવાર ભાગો.</item>
<item>પછીની અવિભાજ્ય સંખ્યા વડે નિઃશેષ ભાગી શકાય ત્યાં સુધી ભાગો.</item>
<item>ભાગફળ અવિભાજ્ય સંખ્યા થાય ત્યાં સુધી ચાલુ રાખો.</item>
<item>સંયુક્ત સંખ્યાને નિસરણીની બાજુઓ અને ટોચ પરની બધી અવિભાજ્ય સંખ્યાઓના ગુણનફળ તરીકે લખો.</item>
</list></note><example id="fs-id1222143"><exercise id="fs-id1383686"><problem id="fs-id3401583">
<para id="fs-id2961369">આ સંખ્યાનું અવિભાજ્ય અવયવીકરણ શોધો: <m:math><m:mrow><m:mn>120</m:mn></m:mrow></m:math> નિસરણીની પદ્ધતિથી.</para>
</problem>
<solution id="fs-id2368416">
<title>ઉકેલ</title>


<table id="eip-id1168468590158" class="unnumbered unstyled" aria-label="ચિત્રમાં નિસરણી જેવી ગોઠવણીના ભાગાકારના અનેક તબક્કા છે. પહેલામાં 2 વડે 120ને ભાગતાં ભાગફળ 60 મળે છે. ભાગવા માટે બે પસંદ કર્યું છે, કારણ કે આ સંખ્યાનો: 120, તે સૌથી નાનો અવિભાજ્ય અવયવ છે, આ સંખ્યાનો: 120. ભાગાકારના કૌંસની બહાર ડાબે 2, અંદર 120 અને ઉપર 60 છે; તે 120ની ઉપર કૌંસની બહાર છે. પછીનું ચિત્ર વારંવાર ભાગવાનું દર્શાવે છે, આના વડે: 2, જ્યાં સુધી નિઃશેષ ભાગી શકાય. અગાઉનો ભાગાકાર ફરી છે, પરંતુ હવે 60ની આસપાસ બીજો કૌંસ છે, બહાર ડાબે 2 અને ઉપર 30 છે; તે 60ની ઉપર કૌંસની બહાર છે. કારણ કે 30 હજુ આના વડે વિભાજ્ય છે: 2, તેથી 30ની આસપાસ બીજો કૌંસ છે, બહાર ડાબે 2 અને ઉપર 15 છે; તે 30ની ઉપર કૌંસની બહાર છે. સંખ્યા 15 વિભાજ્ય નથી આના વડે: 2, પરંતુ પછીની અવિભાજ્ય સંખ્યા વડે વિભાજ્ય છે: 3. પછીના ચિત્રમાં અગાઉના ચિત્ર ઉપરાંત 15ની આસપાસ બીજો કૌંસ છે, બહાર ડાબે 3 અને ઉપર 5 છે; તે 15ની ઉપર કૌંસની બહાર છે. ભાગફળ 5 અવિભાજ્ય હોવાથી નિસરણી પૂરી થઈ. સંખ્યા 120નું અવિભાજ્ય અવયવીકરણ ભાગાકારના કૌંસની બહારની બધી સંખ્યાઓથી બને છે: 2, 2, 2, 3 અને 5. અવિભાજ્ય અવયવીકરણ આ રીતે લખી શકાય: 2 ગુણ્યા 2 ગુણ્યા 2 ગુણ્યા 3 ગુણ્યા 5. આ સંખ્યાના વારંવારના ગુણાકાર માટે ઘાત વાપરીને: 2, તેને લખી શકાય 2ની ત્રીજી ઘાત ગુણ્યા 3 ગુણ્યા 5.">
<label /><tgroup cols="2">
 <tbody>
  <row>
    <entry>સૌથી નાની અવિભાજ્ય સંખ્યા વડે ભાગો; તે છે 2.</entry>
    <entry><media id="eip-id1168468775312" alt="લાંબા ભાગાકારમાં 120ને ભાગ્યા છે 2 વડે; ભાગફળ 60 ભાગાકારની રેખાની ઉપર છે. ભાજક 2, ભાજ્ય 120 અને ભાગાકારનું પરિણામ 60 છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_05_024_img-01.png" /></media></entry>
  </row>
  <row>
    <entry>વારંવાર ભાગો 2 વડે, જ્યાં સુધી નિઃશેષ ભાગી શકાય.</entry>

<entry><media id="eip-id1168468478403" alt="લાંબા ભાગાકારની શ્રેણી વારંવાર ભાગવાનું દર્શાવે છે, આના વડે: 2. પહેલા 120 ભાગ્યા 2 બરાબર 60, પછી 60 ભાગ્યા 2 બરાબર 30 અને પછી 30 ભાગ્યા 2 બરાબર 15."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_05_024_img-03.png" /></media></entry>
  </row>
  <row>
    <entry>પછીની અવિભાજ્ય સંખ્યા વડે ભાગો: 3.</entry>
    <entry><media id="eip-id1168468274425" alt="વારંવાર ભાગાકાર કરીને 120નું અવિભાજ્ય અવયવીકરણ કરતાં અવયવ મળે છે: 2, 2, 2, 3 અને 5."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_05_024_img-02.png" /></media></entry>
  </row>
  <row>
    <entry>ભાગફળ 5 અવિભાજ્ય હોવાથી નિસરણી પૂરી થઈ. આ સંખ્યાનું અવિભાજ્ય અવયવીકરણ લખો: 120.</entry>
    <entry><m:math><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>3</m:mn><m:mo>⋅</m:mo><m:mn>5</m:mn></m:math><newline />
    <m:math><m:msup><m:mn>2</m:mn><m:mn>3</m:mn></m:msup><m:mo>⋅</m:mo><m:mn>3</m:mn><m:mo>⋅</m:mo><m:mn>5</m:mn></m:math></entry>
  </row>
</tbody>

</tgroup>
</table>


<para id="fs-id2219880">અવયવોનો ગુણાકાર કરીને જાતે ચકાસો. પરિણામ આ હોવું જોઈએ: <m:math><m:mrow><m:mn>120</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
</solution>
</exercise></example><note id="fs-id2631036" class="try">
<exercise id="fs-id2190037">
<problem id="fs-id2687663">
<para id="fs-id4876998">નિસરણીની પદ્ધતિથી અવિભાજ્ય અવયવીકરણ શોધો: <m:math><m:mrow><m:mn>80</m:mn></m:mrow></m:math></para></problem>
<solution id="fs-id1368058">
<para id="fs-id1359189">2 ⋅ 2 ⋅ 2 ⋅ 2 ⋅ 5, અથવા 2<sup>4</sup> ⋅ 5</para>
</solution>
</exercise>
</note>
<note id="fs-id1171103121163" class="try">
<exercise id="fs-id1278710">
<problem id="fs-id1885085">
<para id="fs-id1171102812600">નિસરણીની પદ્ધતિથી અવિભાજ્ય અવયવીકરણ શોધો: <m:math><m:mrow><m:mn>60</m:mn></m:mrow></m:math></para></problem>
<solution id="fs-id1824819">
<para id="fs-id1346236">2 ⋅ 2 ⋅ 3 ⋅ 5, અથવા 2<sup>2</sup> ⋅ 3 ⋅ 5</para>
</solution>
</exercise>
</note>
<example id="fs-id2684532">
<exercise id="fs-id1630958"><problem id="fs-id1586762">
<para id="fs-id2661234">આ સંખ્યાનું અવિભાજ્ય અવયવીકરણ શોધો: <m:math><m:mrow><m:mn>48</m:mn></m:mrow></m:math> નિસરણીની પદ્ધતિથી.</para>
</problem>
<solution id="fs-id1778711">
<title>ઉકેલ</title>
<table id="eip-id1168469467686" class="unnumbered unstyled" aria-label="ચિત્રમાં નિસરણી જેવી ગોઠવણીના ભાગાકારના અનેક તબક્કા છે. પહેલામાં 2 વડે 48ને ભાગતાં ભાગફળ 24 મળે છે. ભાગવા માટે બે પસંદ કર્યું છે, કારણ કે આ સંખ્યાનો: 48, તે સૌથી નાનો અવિભાજ્ય અવયવ છે, આ સંખ્યાનો: 48. ભાગાકારના કૌંસની બહાર ડાબે 2, અંદર 48 અને ઉપર 24 છે; તે 48ની ઉપર કૌંસની બહાર છે. પછીનું ચિત્ર વારંવાર ભાગવાનું દર્શાવે છે, આના વડે: 2, જ્યાં સુધી નિઃશેષ ભાગી શકાય. અગાઉનો ભાગાકાર ફરી છે, પરંતુ હવે 24ની આસપાસ બીજો કૌંસ છે, બહાર ડાબે 2 અને ઉપર 12 છે; તે 24ની ઉપર કૌંસની બહાર છે. કારણ કે 12 હજુ આના વડે વિભાજ્ય છે: 2, તેથી 12ની આસપાસ બીજો કૌંસ છે, બહાર ડાબે 2 અને ઉપર 6 છે; તે 30ની ઉપર કૌંસની બહાર છે. સંખ્યા 6 હજુ આના વડે વિભાજ્ય છે: 2, તેથી 6ની આસપાસ બીજો કૌંસ છે, બહાર ડાબે 2 અને ઉપર 3 છે; તે 6ની ઉપર કૌંસની બહાર છે. ભાગફળ 3 અવિભાજ્ય હોવાથી નિસરણી પૂરી થઈ. સંખ્યા 48નું અવિભાજ્ય અવયવીકરણ ભાગાકારના કૌંસની બહારની બધી સંખ્યાઓથી બને છે: 2, 2, 2, 2 અને 3. અવિભાજ્ય અવયવીકરણ આ રીતે લખી શકાય: 2 ગુણ્યા 2 ગુણ્યા 2 ગુણ્યા 2 ગુણ્યા 3. આ સંખ્યાના વારંવારના ગુણાકાર માટે ઘાત વાપરીને: 2, તેને લખી શકાય 2ની ચોથી ઘાત ગુણ્યા 3.">
<label /><tgroup cols="2">
 <tbody>
  <row>
    <entry>સૌથી નાની અવિભાજ્ય સંખ્યા વડે ભાગો: 2.</entry>
    <entry><media id="eip-id1168466807907" alt="લાંબા ભાગાકારમાં 48ને ભાગ્યા છે 2 વડે. ભાગફળ 24 ભાજકની ઉપર લખેલું છે; તે દર્શાવે છે કે 24 પરિણામ છે આ ભાગાકારનું: 48 ભાગ્યા 2."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_05_025_img-01.png" /></media></entry>
  </row>
  <row>
    <entry>વારંવાર ભાગો 2 વડે, જ્યાં સુધી નિઃશેષ ભાગી શકાય.</entry>
    <entry><media id="eip-id1168466807923" alt="વારંવાર ભાગાકાર કરવાની ક્રમશઃ રીત, આના વડે: 2. તેમાં 48ને વારંવાર ભાગ્યા છે 2 વડે, જ્યાં સુધી 3 મળે. દર્શાવેલા ભાગાકાર છે: 48/2=24, 24/2=12, 12/2=6 અને 6/2=3."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_05_025_img-02.png" /></media></entry>
  </row>
  <row>
    <entry>ભાગફળ 3 અવિભાજ્ય હોવાથી નિસરણી પૂરી થઈ. આ સંખ્યાનું અવિભાજ્ય અવયવીકરણ લખો: 48.</entry>
    <entry><m:math><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>3</m:mn></m:math><newline />
    <m:math><m:msup><m:mn>2</m:mn><m:mn>4</m:mn></m:msup><m:mo>⋅</m:mo><m:mn>3</m:mn></m:math></entry>
  </row>
</tbody>

</tgroup>
</table>

</solution>
</exercise></example>
<note id="fs-id1960517" class="try">
<exercise id="fs-id2215242">
<problem id="fs-id2587256">
<para id="fs-id1407478">નિસરણીની પદ્ધતિથી અવિભાજ્ય અવયવીકરણ શોધો. <m:math><m:mrow><m:mn>126</m:mn></m:mrow></m:math></para></problem>
<solution id="fs-id1517523">
<para id="fs-id1235865">2 ⋅ 3 ⋅ 3 ⋅ 7, અથવા 2 ⋅ 3<sup>2</sup> ⋅ 7</para>
</solution>
</exercise>
</note>
<note id="fs-id1171104399917" class="try">
<exercise id="fs-id1596728">
<problem id="fs-id2794738">
<para id="fs-id1171103038093">નિસરણીની પદ્ધતિથી અવિભાજ્ય અવયવીકરણ શોધો. <m:math><m:mrow><m:mn>294</m:mn></m:mrow></m:math></para></problem>
<solution id="fs-id2353123">
<para id="fs-id2626365">2 ⋅ 3 ⋅ 7 ⋅ 7, અથવા 2 ⋅ 3 ⋅ 7<sup>2</sup></para>
</solution>
</exercise>
</note>
</section>
</section>
<section id="fs-id4363755">
<title>બે સંખ્યાઓનો લઘુત્તમ સામાન્ય અવયવી (LCM) શોધો</title>
<para id="fs-id1731557">અવયવી અને અવિભાજ્ય સંખ્યાઓ શીખવાનું એક કારણ એ છે કે તેમની મદદથી બે સંખ્યાઓનો લઘુત્તમ સામાન્ય અવયવી શોધી શકીએ. જુદા છેદવાળા અપૂર્ણાંકોનો સરવાળો અને બાદબાકી કરીએ ત્યારે આ ઉપયોગી થશે.</para>
<section id="fs-id2669058">
<title>અવયવીની યાદી બનાવવાની પદ્ધતિ</title>
<para id="fs-id2031605">બે સંખ્યાઓનો સામાન્ય અવયવી એ એવી સંખ્યા છે જે બંને સંખ્યાઓનો અવયવી હોય. ધારો કે સામાન્ય અવયવી શોધવા છે, આ સંખ્યાઓના: <m:math><m:mrow><m:mn>10</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>25</m:mn><m:mo>.</m:mo></m:mrow></m:math> દરેક સંખ્યાના શરૂઆતના કેટલાક અવયવીની યાદી બનાવી શકીએ. પછી બંને યાદીમાં આવતા અવયવી શોધીએ; તેઓ સામાન્ય અવયવી છે.</para><equation id="fs-id2451489" class="unnumbered"><label /><m:math><m:mrow><m:mtable><m:mtr>
<m:mtd columnalign="left"><m:mn>10</m:mn><m:mtext>:</m:mtext><m:mn>10</m:mn><m:mo>,</m:mo><m:mn>20</m:mn><m:mo>,</m:mo><m:mn>30</m:mn><m:mo>,</m:mo><m:mn>40</m:mn><m:mo>,</m:mo><m:mspace width="0.2em" /><m:mstyle fontweight="bold"><m:mn>50</m:mn></m:mstyle><m:mo>,</m:mo><m:mn>60</m:mn><m:mo>,</m:mo><m:mn>70</m:mn><m:mo>,</m:mo><m:mn>80</m:mn><m:mo>,</m:mo><m:mn>90</m:mn><m:mo>,</m:mo><m:mstyle fontweight="bold"><m:mn>100</m:mn></m:mstyle><m:mo>,</m:mo><m:mn>110</m:mn><m:mo>,</m:mo><m:mtext>…</m:mtext></m:mtd></m:mtr>

<m:mtr><m:mtd columnalign="left"><m:mrow><m:mn>25</m:mn><m:mtext>:</m:mtext><m:mn>25</m:mn><m:mo>,</m:mo><m:mspace width="0.2em" /><m:mstyle fontweight="bold"><m:mn>50</m:mn></m:mstyle><m:mo>,</m:mo><m:mn>75</m:mn><m:mo>,</m:mo><m:mspace width="0.2em" /><m:mstyle fontweight="bold"><m:mn>100</m:mn></m:mstyle><m:mo>,</m:mo><m:mn>125</m:mn><m:mo>,</m:mo><m:mtext>…</m:mtext></m:mrow>
</m:mtd></m:mtr>
</m:mtable></m:mrow></m:math></equation><para id="fs-id2642518">આપણે જોઈએ છીએ કે <m:math><m:mrow><m:mn>50</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>100</m:mn></m:mrow></m:math> બંને યાદીમાં આવે છે. તેઓ સામાન્ય અવયવી છે આ સંખ્યાઓના: <m:math><m:mrow><m:mn>10</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>25</m:mn><m:mo>.</m:mo></m:mrow></m:math> દરેક સંખ્યાની અવયવીની યાદી આગળ વધારીએ તો વધુ સામાન્ય અવયવી મળશે.</para>
<para id="fs-id1223478">બે સંખ્યાઓનો અવયવી હોય તેવી સૌથી નાની સંખ્યાને કહે છે <term id="term-00004">લઘુત્તમ સામાન્ય અવયવી</term> (LCM). એટલે આ સંખ્યાઓનો લઘુત્તમ સામાન્ય અવયવી: <m:math><m:mrow><m:mn>10</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>25</m:mn></m:mrow></m:math> છે <m:math><m:mrow><m:mn>50</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<note id="fs-id1373200" class="howto"><title>અવયવીની યાદી બનાવીને બે સંખ્યાઓનો લઘુત્તમ સામાન્ય અવયવી (LCM) શોધો.</title><list id="eip-id1168466318223" list-type="enumerated" number-style="arabic" class="stepwise"><item>દરેક સંખ્યાના શરૂઆતના કેટલાક અવયવીની યાદી બનાવો.</item>
<item>બંને યાદીમાં આવતા સામાન્ય અવયવી શોધો. જો કોઈ સામાન્ય અવયવી ન હોય, તો દરેક સંખ્યાના વધુ અવયવી લખો.</item>
<item>બંને યાદીમાં આવતી સૌથી નાની સંખ્યા શોધો.</item>
<item>આ સંખ્યા લઘુત્તમ સામાન્ય અવયવી છે.</item>
</list></note><example id="fs-id1385343">
<exercise id="fs-id1375698">
<problem id="fs-id2133285">
<para id="fs-id1368463">આ સંખ્યાઓનો LCM શોધો: <m:math><m:mrow><m:mn>15</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>20</m:mn></m:mrow></m:math> અવયવીની યાદી બનાવીને.</para>
</problem>
<solution id="fs-id2425629">
<title>ઉકેલ</title>
<para id="fs-id1791214">શરૂઆતના કેટલાક અવયવીની યાદી બનાવો, આ સંખ્યાના: <m:math><m:mrow><m:mn>15</m:mn></m:mrow></m:math> અને આ સંખ્યાના: <m:math><m:mrow><m:mn>20</m:mn><m:mo>.</m:mo></m:mrow></m:math> પહેલો સામાન્ય અવયવી ઓળખો.</para>
<para id="fs-id1608874"><m:math><m:mtable columnalign="left"><m:mtr columnalign="left"><m:mtd columnalign="left"><m:mtext>15:</m:mtext><m:mspace width="0.2em" /><m:mn>15</m:mn><m:mo>,</m:mo><m:mn>30</m:mn><m:mo>,</m:mo><m:mn>45</m:mn><m:mo>,</m:mo><m:mspace width="0.2em" /><m:mstyle fontweight="bold"><m:mn>60</m:mn></m:mstyle><m:mo>,</m:mo><m:mn>75</m:mn><m:mo>,</m:mo><m:mn>90</m:mn><m:mo>,</m:mo><m:mn>105</m:mn><m:mo>,</m:mo><m:mo>120</m:mo></m:mtd></m:mtr><m:mtr columnalign="left"><m:mtd columnalign="left"><m:mtext>20:</m:mtext><m:mspace width="0.2em" /><m:mn>20</m:mn><m:mo>,</m:mo><m:mn>40</m:mn><m:mo>,</m:mo><m:mspace width="0.2em" /><m:mstyle fontweight="bold"><m:mn>60</m:mn></m:mstyle><m:mo>,</m:mo><m:mn>80</m:mn><m:mo>,</m:mo><m:mn>100</m:mn><m:mo>,</m:mo><m:mn>120</m:mn><m:mo>,</m:mo><m:mn>140</m:mn><m:mo>,</m:mo><m:mn>160</m:mn></m:mtd></m:mtr></m:mtable></m:math></para>
<para id="fs-id601120">બંને યાદીમાં આવતી સૌથી નાની સંખ્યા છે <m:math><m:mrow><m:mn>60</m:mn><m:mo>,</m:mo></m:mrow></m:math> તેથી <m:math><m:mrow><m:mn>60</m:mn></m:mrow></m:math> લઘુત્તમ સામાન્ય અવયવી છે આ સંખ્યાઓનો: <m:math><m:mrow><m:mn>15</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>20</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id1939322">ધ્યાન આપો કે <m:math><m:mrow><m:mn>120</m:mn></m:mrow></m:math> પણ બંને યાદીમાં છે. તે સામાન્ય અવયવી છે, પરંતુ લઘુત્તમ સામાન્ય અવયવી નથી.</para>
</solution>
</exercise>
</example>
<note id="fs-id2200134" class="try">
<exercise id="fs-id2620285">
<problem id="fs-id1463141">
<para id="fs-id2031721">આપેલી સંખ્યાઓનો લઘુત્તમ સામાન્ય અવયવી (LCM) શોધો: <m:math><m:mrow><m:mn>9</m:mn><m:mspace width="0.2em" /><m:mtext> અને </m:mtext><m:mspace width="0.2em" /><m:mn>12</m:mn></m:mrow></m:math></para></problem>
<solution id="fs-id1484974">
<para id="fs-id1301452">36</para>
</solution>
</exercise>
</note>
<note id="fs-id1171104411680" class="try">
<exercise id="fs-id2269388">
<problem id="fs-id2198541">
<para id="fs-id1171104400907">આપેલી સંખ્યાઓનો લઘુત્તમ સામાન્ય અવયવી (LCM) શોધો: <m:math><m:mrow><m:mn>18</m:mn><m:mspace width="0.2em" /><m:mtext> અને </m:mtext><m:mspace width="0.2em" /><m:mn>24</m:mn></m:mrow></m:math></para></problem>
<solution id="fs-id2961425">
<para id="fs-id769939">72</para>
</solution>
</exercise>
</note>
</section>
<section id="fs-id1731523">
<title>અવિભાજ્ય અવયવની પદ્ધતિ</title>
<para id="fs-id2264653">બે સંખ્યાઓનો લઘુત્તમ સામાન્ય અવયવી શોધવાની બીજી રીત છે તેમના અવિભાજ્ય અવયવ વાપરવા. આ પદ્ધતિથી LCM શોધીશું, આ સંખ્યાઓનો: <m:math><m:mrow><m:mn>12</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>18</m:mn><m:mo>.</m:mo></m:mrow></m:math></para>
<para id="fs-id1618951">પહેલાં દરેક સંખ્યાનું અવિભાજ્ય અવયવીકરણ શોધીએ.</para>
<equation id="fs-id1385188" class="unnumbered"><label /><m:math><m:mrow><m:mn>12</m:mn><m:mo>=</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>3</m:mn><m:mspace width="3em" /><m:mn>18</m:mn><m:mo>=</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>3</m:mn><m:mo>⋅</m:mo><m:mn>3</m:mn></m:mrow></m:math></equation>
<para id="fs-id1784427">પછી દરેક સંખ્યાને અવિભાજ્ય સંખ્યાઓના ગુણનફળ તરીકે લખીએ. શક્ય હોય ત્યાં સમાન અવિભાજ્ય અવયવ એકની નીચે એક ગોઠવીએ.</para>
<equation id="fs-id2691130" class="unnumbered"><label /><m:math><m:mtable columnalign="left"><m:mtr columnalign="left"><m:mtd columnalign="left"><m:mn>12</m:mn><m:mo>=</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>3</m:mn></m:mtd></m:mtr>
<m:mtr><m:mtd><m:mn>18</m:mn><m:mo>=</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mspace width="1.1em" /><m:mn>3</m:mn><m:mo>⋅</m:mo><m:mn>3</m:mn></m:mtd></m:mtr></m:mtable></m:math></equation><para id="fs-id1376925">હવે દરેક સ્તંભની અવિભાજ્ય સંખ્યા નીચે ઉતારીએ. આ અવયવોનું ગુણનફળ એટલે LCM.</para>
<media id="fs-id1733229" alt="ચિત્રમાં સંખ્યા 12નું અવિભાજ્ય અવયવીકરણ સમીકરણ તરીકે છે: 12 બરાબર 2 ગુણ્યા 2 ગુણ્યા 3. તેની નીચે સંખ્યા 18નું અવિભાજ્ય અવયવીકરણ સમીકરણ તરીકે છે: 18 બરાબર 2 ગુણ્યા 3 ગુણ્યા 3. બંને સમીકરણની બરાબરની નિશાનીઓ એકની નીચે એક છે. પહેલો 2, આ સંખ્યાના અવયવીકરણમાંનો: 12, ગોઠવાયેલો છે આ અવયવની ઉપર: 2, આ સંખ્યાના અવયવીકરણમાંના: 18. બીજા 2ની નીચે, આ સંખ્યાના અવયવીકરણમાંના: 12, ખાલી જગ્યા છે, આ સંખ્યાના અવયવીકરણમાં: 18. અવયવ 3ની નીચે, આ સંખ્યાના અવયવીકરણમાંના: 12, પહેલો 3 છે, આ સંખ્યાના અવયવીકરણમાંનો: 18. બીજા 3ની ઉપર કોઈ અવયવ નથી, આ સંખ્યાના અવયવીકરણમાંથી: 12. આ સંખ્યાના અવયવીકરણની નીચે આડી રેખા છે: 18. તેની નીચે સમીકરણ LCM બરાબર 2 ગુણ્યા 2 ગુણ્યા 3 ગુણ્યા 3 છે. ઊભા તીર આ સંખ્યાના અવયવીકરણથી: 12, આ સંખ્યાના અવયવીકરણમાંથી પસાર થઈને: 18, LCMના સમીકરણ સુધી પહોંચે છે. પહેલું તીર પહેલા 2થી શરૂ થાય છે, આ સંખ્યાના અવયવીકરણમાંના: 12, અને આ અવયવમાંથી પસાર થાય છે: 2, આ સંખ્યાના અવયવીકરણમાંના: 18; તે LCMના પહેલા 2 પર પહોંચે છે. બીજું તીર પછીના 2થી શરૂ થાય છે, આ સંખ્યાના અવયવીકરણમાંના: 12, અને આ સંખ્યાના અવયવીકરણની ખાલી જગ્યામાંથી પસાર થાય છે: 18; તે LCMના બીજા 2 પર પહોંચે છે. ત્રીજું તીર આ અવયવથી શરૂ થાય છે: 3, આ સંખ્યાના અવયવીકરણમાંના: 12, અને પહેલા 3માંથી પસાર થાય છે, આ સંખ્યાના અવયવીકરણમાંના: 18; તે LCMના પહેલા 3 પર પહોંચે છે. છેલ્લું તીર બીજા 3થી શરૂ થાય છે, આ સંખ્યાના અવયવીકરણમાંના: 18, અને LCMના બીજા 3 તરફ નીચે બતાવે છે.">
<image mime-type="image/jpeg" src="../../media/CNX_BMath_Figure_02_05_006_img.jpg" />
</media>
<para id="fs-id1299150">ધ્યાન આપો કે અવિભાજ્ય અવયવો, આ સંખ્યાના: <m:math><m:mrow><m:mn>12</m:mn></m:mrow></m:math> અને આ સંખ્યાના: <m:math><m:mrow><m:mn>18</m:mn></m:mrow></m:math> LCMમાં સામેલ છે. સામાન્ય અવિભાજ્ય અવયવોને એકની નીચે એક ગોઠવવાથી દરેક સામાન્ય અવયવ માત્ર એક વખત લેવાય છે. તે ખાતરી આપે છે કે <m:math><m:mrow><m:mn>36</m:mn></m:mrow></m:math> લઘુત્તમ સામાન્ય અવયવી છે.</para>
<note id="fs-id1275660" class="howto"><title>અવિભાજ્ય અવયવની પદ્ધતિથી LCM શોધો.</title><list id="eip-id1168469871370" list-type="enumerated" number-style="arabic" class="stepwise"><item>દરેક સંખ્યાનું અવિભાજ્ય અવયવીકરણ શોધો.</item>
<item>દરેક સંખ્યાને અવિભાજ્ય સંખ્યાઓના ગુણનફળ તરીકે લખો. શક્ય હોય ત્યાં સમાન અવિભાજ્ય અવયવ એકની નીચે એક ગોઠવો.</item>
<item>દરેક સ્તંભની અવિભાજ્ય સંખ્યા નીચે ઉતારો.</item>
<item>અવયવોનો ગુણાકાર કરીને LCM મેળવો.</item>
</list></note><example id="fs-id1168927">
<exercise id="fs-id1919971"><problem id="fs-id2440220">
<para id="fs-id2494756">આ સંખ્યાઓનો LCM શોધો: <m:math><m:mrow><m:mn>15</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>18</m:mn></m:mrow></m:math> અવિભાજ્ય અવયવની પદ્ધતિથી.</para>
</problem>
<solution id="fs-id1833421">
<title>ઉકેલ</title>
<table id="eip-id1168467200222" class="unnumbered unstyled" aria-label="ચિત્રમાં સંખ્યા 15નું અવિભાજ્ય અવયવીકરણ સમીકરણ તરીકે છે: 15 બરાબર 3 ગુણ્યા 5. બાજુમાં સંખ્યા 18નું અવિભાજ્ય અવયવીકરણ સમીકરણ તરીકે છે: 2 ગુણ્યા 3 ગુણ્યા 3. નીચે આ સંખ્યાઓના અવિભાજ્ય અવયવીકરણનાં સમીકરણો: 15 અને 18, એકની નીચે એક છે; આ સંખ્યાનું સમીકરણ: 15, ઉપર અને આ સંખ્યાનું સમીકરણ: 18, નીચે છે. સમાન અવિભાજ્ય અવયવ એકની નીચે એક આવે તે રીતે ગોઠવ્યા છે. તેની નીચે ફરી ઊભાં ગોઠવેલાં એ જ સમીકરણો છે અને આ સંખ્યાના અવયવીકરણની નીચે આડી રેખા છે: 18. રેખાની નીચે સમીકરણ LCM બરાબર 2 ગુણ્યા 3 ગુણ્યા 3 ગુણ્યા 5 છે. ઊભા તીર આ સંખ્યાના અવયવીકરણથી: 15, આ સંખ્યાના અવયવીકરણમાંથી પસાર થઈને: 18, LCMના સમીકરણ સુધી પહોંચે છે. આ અવયવ નથી: 2, આ સંખ્યાના અવયવીકરણમાં: 15; તેથી પહેલું તીર આ અવયવથી શરૂ થાય છે: 2, આ સંખ્યાના અવયવીકરણમાંના: 18, અને LCMના આ અવયવ તરફ નીચે બતાવે છે: 2. બીજું તીર પહેલા 3થી શરૂ થાય છે, આ સંખ્યાના અવયવીકરણમાંના: 15, અને પહેલા 3માંથી પસાર થાય છે, આ સંખ્યાના અવયવીકરણમાંના: 18; તે LCMના પહેલા 3 પર પહોંચે છે. આ સંખ્યાના અવયવીકરણમાં બીજા કોઈ ત્રણ નથી: 15; તેથી પછીનું તીર બીજા 3થી શરૂ થાય છે, આ સંખ્યાના અવયવીકરણમાંના: 18, અને LCMના બીજા 3 તરફ નીચે બતાવે છે. આ સંખ્યાના અવયવીકરણમાં બીજા કોઈ અવયવ નથી: 18; તેથી છેલ્લું તીર આ અવયવથી શરૂ થાય છે: 5, આ સંખ્યાના અવયવીકરણમાંના: 15, અને નીચે આ સંખ્યાના અવયવીકરણના અંતની ખાલી જગ્યામાંથી પસાર થઈને: 18, LCMના આ અવયવ પર પહોંચે છે: 5. આ સંખ્યાઓનો લઘુત્તમ સામાન્ય અવયવી: 15 અને 18, છે 2 ગુણ્યા 3 ગુણ્યા 3 ગુણ્યા 5, જે બરાબર છે 90.">
<label /><tgroup cols="2">
 <tbody>
  <row>
    <entry>દરેક સંખ્યાને અવિભાજ્ય સંખ્યાઓના ગુણનફળ તરીકે લખો.</entry>
    <entry><media id="eip-id1168467267821" alt="ચિત્રમાં બે સંખ્યાનું અવિભાજ્ય અવયવીકરણ છે: સંખ્યા 15ને 3 ગુણ્યા 5 તરીકે અને 18ને 2 ગુણ્યા 3 ગુણ્યા 3 તરીકે દર્શાવી છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_05_026_img-01.png" /></media></entry>
  </row>
  <row>
    <entry>દરેક સંખ્યાને અવિભાજ્ય સંખ્યાઓના ગુણનફળ તરીકે લખો. શક્ય હોય ત્યાં સમાન અવિભાજ્ય અવયવ એકની નીચે એક ગોઠવો.</entry>
    <entry><media id="eip-id1168468495660" alt="આ સંખ્યાઓનું અવિભાજ્ય અવયવીકરણ સ્પષ્ટ અને ટૂંકા સ્વરૂપમાં દર્શાવ્યું છે: 15 (3 * 5) અને 18 (2 * 3 * 3)."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_05_026_img-02.png" /></media></entry>
  </row>
  <row>
    <entry>દરેક સ્તંભની અવિભાજ્ય સંખ્યા નીચે ઉતારો.</entry>
    <entry><media id="eip-id1168467254295" alt="અવિભાજ્ય અવયવીકરણથી લઘુત્તમ સામાન્ય અવયવી (LCM) શોધવાની રીત દર્શાવી છે, આ સંખ્યાઓનો: 15 અને 18. અહીં 15 = 3 * 5 અને 18 = 2 * 3 * 3 છે. LCMમાં આ અવયવ ભેગા થાય છે: 2 * 3 * 3 * 5."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_05_026_img-03.png" /></media></entry>
  </row>
  <row>
    <entry>અવયવોનો ગુણાકાર કરીને LCM મેળવો.</entry>
    <entry><m:math><m:mtext> LCM </m:mtext><m:mo>=</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>3</m:mn><m:mo>⋅</m:mo><m:mn>3</m:mn><m:mo>⋅</m:mo><m:mn>5</m:mn></m:math><newline />
    આ સંખ્યાઓનો LCM: 15 અને 18, છે 90.</entry>
  </row>
</tbody>

</tgroup>
</table>

</solution>
</exercise></example>
<note id="fs-id2297954" class="try">
<exercise id="fs-id2297606">
<problem id="fs-id2662798">
<para id="fs-id1366621">અવિભાજ્ય અવયવની પદ્ધતિથી LCM શોધો. <m:math><m:mrow><m:mn>15</m:mn><m:mspace width="0.2em" /><m:mtext> અને </m:mtext><m:mspace width="0.2em" /><m:mn>20</m:mn></m:mrow></m:math></para></problem>
<solution id="fs-id1509531">
<para id="fs-id2369772">60</para>
</solution>
</exercise>
</note>
<note id="fs-id1171103976684" class="try">
<exercise id="fs-id4121453">
<problem id="fs-id2703897">
<para id="fs-id1171104044823">અવિભાજ્ય અવયવની પદ્ધતિથી LCM શોધો. <m:math><m:mrow><m:mn>15</m:mn><m:mspace width="0.2em" /><m:mtext> અને </m:mtext><m:mspace width="0.2em" /><m:mn>35</m:mn></m:mrow></m:math></para></problem>
<solution id="fs-id1359041">
<para id="fs-id1542320">105</para>
</solution>
</exercise>
</note>
<example id="fs-id2830383">
<exercise id="fs-id1368772"><problem id="fs-id1988680">
<para id="fs-id1918210">આ સંખ્યાઓનો LCM શોધો: <m:math><m:mrow><m:mn>50</m:mn></m:mrow></m:math> અને <m:math><m:mrow><m:mn>100</m:mn></m:mrow></m:math> અવિભાજ્ય અવયવની પદ્ધતિથી.</para>
</problem>
<solution id="fs-id1612193">
<title>ઉકેલ</title>
<table id="eip-id1168466277374" class="unnumbered unstyled" aria-label="ચિત્રમાં સંખ્યા 50નું અવિભાજ્ય અવયવીકરણ સમીકરણ તરીકે છે: 50 બરાબર 2 ગુણ્યા 5 ગુણ્યા 5. બાજુમાં સંખ્યા 100નું અવિભાજ્ય અવયવીકરણ સમીકરણ તરીકે છે: 2 ગુણ્યા 2 ગુણ્યા 5 ગુણ્યા 5. નીચે આ સંખ્યાઓના અવિભાજ્ય અવયવીકરણનાં સમીકરણો: 50 અને 100, એકની નીચે એક છે; આ સંખ્યાનું સમીકરણ: 50, ઉપર અને આ સંખ્યાનું સમીકરણ: 100, નીચે છે. સમાન અવિભાજ્ય અવયવ એકની નીચે એક આવે તે રીતે ગોઠવ્યા છે. તેની નીચે ફરી ઊભાં ગોઠવેલાં એ જ સમીકરણો છે અને આ સંખ્યાના અવયવીકરણની નીચે આડી રેખા છે: 100. રેખાની નીચે સમીકરણ LCM બરાબર 2 ગુણ્યા 2 ગુણ્યા 5 ગુણ્યા 5 છે. ઊભા તીર આ સંખ્યાના અવયવીકરણથી: 50, આ સંખ્યાના અવયવીકરણમાંથી પસાર થઈને: 100, LCMના સમીકરણ સુધી પહોંચે છે. આ અવયવની એક જ નકલ છે: 2, આ સંખ્યાના અવયવીકરણમાં: 50; તેથી પહેલું તીર પહેલા 2થી શરૂ થાય છે, આ સંખ્યાના અવયવીકરણમાંના: 100, અને LCMના પહેલા 2 તરફ નીચે બતાવે છે. બીજું તીર પહેલા 2થી શરૂ થાય છે, આ સંખ્યાના અવયવીકરણમાંના: 50, અને બીજા 2માંથી પસાર થાય છે, આ સંખ્યાના અવયવીકરણમાંના: 100; તે LCMના બીજા 2 પર પહોંચે છે. પછીનું તીર પહેલા 5થી શરૂ થાય છે, આ સંખ્યાના અવયવીકરણમાંના: 50, અને પહેલા 5માંથી પસાર થાય છે, આ સંખ્યાના અવયવીકરણમાંના: 100; તે LCMના પહેલા 5 પર પહોંચે છે. છેલ્લું તીર બીજા 5થી શરૂ થાય છે, આ સંખ્યાના અવયવીકરણમાંના: 50, અને બીજા 5માંથી પસાર થાય છે, આ સંખ્યાના અવયવીકરણમાંના: 100; તે LCMના બીજા 5 પર પહોંચે છે. આ સંખ્યાઓનો લઘુત્તમ સામાન્ય અવયવી: 50 અને 100, છે 2 ગુણ્યા 2 ગુણ્યા 5 ગુણ્યા 5, જે બરાબર છે 100.">
<label /><tgroup cols="2">
 <tbody>
  <row>
    <entry>દરેક સંખ્યાનું અવિભાજ્ય અવયવીકરણ લખો.</entry>
    <entry><media id="eip-id1168466034886" alt="ચિત્રમાં સંખ્યા 50નું અવિભાજ્ય અવયવીકરણ 2 ગુણ્યા 5 ગુણ્યા 5 તરીકે અને સંખ્યા 100નું અવિભાજ્ય અવયવીકરણ 2 ગુણ્યા 2 ગુણ્યા 5 ગુણ્યા 5 તરીકે છે."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_05_027_img-01.png" /></media></entry>
  </row>
  <row>
    <entry>દરેક સંખ્યાને અવિભાજ્ય સંખ્યાઓના ગુણનફળ તરીકે લખો. શક્ય હોય ત્યાં સમાન અવિભાજ્ય અવયવ એકની નીચે એક ગોઠવો.</entry>
    <entry><media id="eip-id1168469780194" alt="સફેદ પૃષ્ઠભૂમિ પર આ સંખ્યાઓનું અવિભાજ્ય અવયવીકરણ દર્શાવ્યું છે: 50 (2*5*5) અને 100 (2*2*5*5)."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_05_027_img-02.png" /></media></entry>
  </row>
  <row>
    <entry>દરેક સ્તંભની અવિભાજ્ય સંખ્યા નીચે ઉતારો.</entry>
    <entry><media id="eip-id1168469780210" alt="ચિત્ર અવિભાજ્ય અવયવીકરણ વડે લઘુત્તમ સામાન્ય અવયવી (LCM)ની ગણતરી દર્શાવે છે, આ સંખ્યાઓ માટે: 50 અને 100. તેમાં 50ને 2 ગુણ્યા 5 ગુણ્યા 5 તરીકે અને 100ને 2 ગુણ્યા 2 ગુણ્યા 5 ગુણ્યા 5 તરીકે દર્શાવતાં LCM મળે છે: 2 ગુણ્યા 2 ગુણ્યા 5 ગુણ્યા 5."><image mime-type="image/png" src="../../media/CNX_BMath_Figure_02_05_027_img-03.png" /></media></entry>
  </row>
  <row>
    <entry>અવયવોનો ગુણાકાર કરીને LCM મેળવો.</entry>
    <entry><m:math><m:mtext> LCM </m:mtext><m:mo>=</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>2</m:mn><m:mo>⋅</m:mo><m:mn>5</m:mn><m:mo>⋅</m:mo><m:mn>5</m:mn></m:math><newline />
    આ સંખ્યાઓનો LCM: 50 અને 100, છે 100.</entry>
  </row>
</tbody>

</tgroup>
</table>

</solution>
</exercise></example>
