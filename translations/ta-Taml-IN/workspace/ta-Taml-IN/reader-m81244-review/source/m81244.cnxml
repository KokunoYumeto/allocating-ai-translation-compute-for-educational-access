<problem id="fs-id2657723">
<para id="fs-id1549331"><m:math><m:mrow><m:mn>6,118</m:mn><m:mo>+</m:mo><m:mn>15,990</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
