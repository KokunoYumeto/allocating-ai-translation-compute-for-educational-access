<exercise id="fs-id2202157">
<problem id="fs-id1508765">
<para id="fs-id2430610"><m:math><m:mrow><m:mn>775</m:mn><m:mo>+</m:mo><m:mn>369</m:mn></m:mrow></m:math></para>
