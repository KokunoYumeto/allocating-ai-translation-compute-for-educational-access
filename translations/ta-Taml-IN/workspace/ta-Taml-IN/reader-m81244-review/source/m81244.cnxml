<para id="fs-id2211302"><m:math><m:mrow><m:mn>368,911</m:mn><m:mo>+</m:mo><m:mn>857,289</m:mn></m:mrow></m:math></para>
</problem>
</exercise>
<exercise id="fs-id2308954">
<problem id="fs-id1799797">
<para id="fs-id1608176"><m:math><m:mrow><m:mn>24,731</m:mn><m:mo>+</m:mo><m:mn>592</m:mn><m:mo>+</m:mo><m:mn>3,868</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id2334168">
<para id="fs-id1566297"><m:math><m:mn>29,191</m:mn></m:math></para></solution>
</exercise>
<exercise id="fs-id1352693">
