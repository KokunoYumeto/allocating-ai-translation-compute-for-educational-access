<?xml version="1.0" encoding="UTF-8"?>
<glossary xmlns="http://cnx.rice.edu/cnxml" xmlns:m="http://www.w3.org/1998/Math/MathML" xml:lang="ta-Taml-IN">
<definition id="fs-id2642858">
<term>ஆயம்</term>
<meaning id="fs-id2145854">எண் கோட்டில் உள்ள ஒரு புள்ளியுடன் இணைக்கப்படும் எண், அந்தப் புள்ளியின் ஆயம் எனப்படும்.</meaning>
</definition>
<definition id="fs-id2935860">
<term>இயல் எண்கள்</term>
<meaning id="fs-id2567732">1, 2, 3, … ஆகிய எண்கள் இயல் எண்கள் எனப்படும்.</meaning>
</definition>
<definition id="fs-id2711214">
<term>எண் கோடு</term>
<meaning id="fs-id2443061">எண்களைக் காட்சிப்படுத்த எண் கோடு பயன்படுகிறது. எண் கோட்டில் இடமிருந்து வலமாகச் செல்லும்போது எண்கள் பெரிதாகின்றன; வலமிருந்து இடமாகச் செல்லும்போது எண்கள் சிறிதாகின்றன.</meaning>
</definition>
<definition id="fs-id3330600">
<term>தொடக்கப்புள்ளி</term>
<meaning id="fs-id2284600">எண் கோட்டில் 0 என்று குறிக்கப்பட்ட புள்ளி தொடக்கப்புள்ளி எனப்படும்.</meaning>
</definition>
<definition id="fs-id1336470">
<term>இடமதிப்பு முறை</term>
<meaning id="fs-id2263265">ஓர் எண்ணில் ஒரு இலக்கத்தின் மதிப்பு அது இருக்கும் இடத்தைப் பொறுத்திருப்பதால், நமது எண் முறை இடமதிப்பு முறை என்று அழைக்கப்படுகிறது.</meaning>
</definition>
<definition id="fs-id2263270">
<term>முழுமையாக்கல்</term>
<meaning id="fs-id2326485">ஓர் எண்ணின் தோராய மதிப்பைப் பெறும் செயல்முறை முழுமையாக்கல் எனப்படும்.</meaning>
</definition>
<definition id="fs-id4338000">
<term>முழு எண்கள்</term>
<meaning id="fs-id1934263">0, 1, 2, 3, … ஆகிய எண்கள் முழு எண்கள் எனப்படும்.</meaning>
</definition>
</glossary>
