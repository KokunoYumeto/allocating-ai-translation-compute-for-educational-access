        },
        {
          "tag": "H3",
          "text": "کتاب دے سوالاں دے جواب"
        },
        {
          "tag": "H2",
          "text": "ہور وسائل"
        },
        {
          "tag": "H3",
          "text": "سکھن والیاں تے استاداں دے وسائل"
        },
        {
          "tag": "H3",
          "text": "ساتھی اداریاں دے وسائل"
        },
        {
          "tag": "H2",
          "text": "لکھاریاں بارے"
        },
        {
          "tag": "H3",
          "text": "وڈا حصہ پاؤن والے سینئر لکھاری"
        },
        {
          "tag": "H3",
          "text": "جانچ پڑتال کرن والے"
        },
        {
