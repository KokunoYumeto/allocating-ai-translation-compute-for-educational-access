<note id="fs-id1171102903594" class="try">
<exercise id="fs-id2877178">
<problem id="fs-id2877181">
<para id="fs-id1171097539626">Gawea luwih prasaja:</para>
<para id="fs-id2877183"><m:math><m:mrow><m:mn>12</m:mn><m:mo>·</m:mo><m:mn>3</m:mn><m:mo>÷</m:mo><m:mn>4</m:mn></m:mrow></m:math></para>
</problem>
<solution id="fs-id2877202">
<para id="fs-id2877204">9</para>
