    <entry><span class="token">ⓒ</span> </entry>
    <entry />
  </row>
  <row>
    <entry />
    <entry align="center">mpg Mini Cooper____mpg Fit</entry>
  </row>
  <row>
    <entry>Golekana nilaine ing tabel.</entry>
    <entry align="center">27____27</entry>
  </row>
  <row>
    <entry>Bandhingna.</entry>
    <entry align="center">27 = 27</entry>
  </row>
  <row>
    <entry />
    <entry align="center">mpg Mini Cooper = mpg Fit</entry>
  </row>
</tbody>



