  </row>
  <row>
    <entry>Golekana nilaine ing tabel.</entry>
    <entry align="center">26____27</entry>
  </row>
  <row>
    <entry>Bandhingna.</entry>
    <entry align="center">26 &lt; 27</entry>
  </row>
  <row>
    <entry />
    <entry align="center">mpg Versa &lt; mpg Fit</entry>
  </row>
</tbody>



</tgroup>
</table>
<table id="eip-id1164755344710" class="unnumbered unstyled" summary="Tabel iki mbandhingake efisiensi bahan bakar Mini Cooper lan Fit sarta nuduhake yen loro-lorone nggayuh 27 mpg."><label />
<tgroup cols="2"><tbody>
