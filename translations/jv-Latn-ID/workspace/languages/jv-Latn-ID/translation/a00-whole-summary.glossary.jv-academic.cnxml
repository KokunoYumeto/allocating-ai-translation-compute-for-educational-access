<?xml version='1.0' encoding='utf-8'?>
<glossary xmlns="http://cnx.rice.edu/cnxml" xml:lang="jv-Latn-ID">
<definition id="fs-id2642858">
<term>koordinat</term>
<meaning id="fs-id2145854">Wilangan sing dipasangake karo sawijining titik ing garis wilangan diarani koordinat titik kasebut.</meaning>
</definition>
<definition id="fs-id2935860">
<term>wilangan asli</term>
<meaning id="fs-id2567732">Wilangan asli yaiku wilangan 1, 2, 3,…. </meaning>
</definition>
<definition id="fs-id2711214">
<term>garis wilangan</term>
<meaning id="fs-id2443061">Garis wilangan digunakake kanggo nggambarake wilangan. Wilangan ing garis wilangan saya gedhé saka kiwa menyang tengen lan saya cilik saka tengen menyang kiwa.</meaning>
</definition>
<definition id="fs-id3330600">
<term>titik asal</term>
<meaning id="fs-id2284600">Titik asal yaiku titik kanthi label 0 ing garis wilangan.</meaning>
</definition>
<definition id="fs-id1336470">
<term>sistem nilai panggonan</term>
<meaning id="fs-id2263265">Sistem wilangan kita diarani sistem nilai panggonan amarga nilai sawijining digit gumantung marang posisi, utawa panggonan, digit kasebut ing sawijining wilangan.</meaning>
</definition>
<definition id="fs-id2263270">
<term>pambunderan</term>
<meaning id="fs-id2326485">Proses nemtokake nilai watara sawijining wilangan diarani pambunderan.</meaning>
</definition>
<definition id="fs-id4338000">
<term>wilangan cacah</term>
<meaning id="fs-id1934263">Wilangan cacah yaiku wilangan 0, 1, 2, 3, ….</meaning>
</definition>
</glossary>
