<solution id="fs-id934090">
<para id="fs-id1827165"><m:math><m:mn>13</m:mn><m:mo>+</m:mo><m:mn>18</m:mn><m:mo>=</m:mo><m:mn>31</m:mn></m:math></para></solution>
</exercise>
