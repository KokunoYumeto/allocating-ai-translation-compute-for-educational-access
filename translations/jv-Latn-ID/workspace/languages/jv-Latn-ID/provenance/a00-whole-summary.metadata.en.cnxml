  <ns1:title>Introduction to Whole Numbers</ns1:title>
  <ns1:abstract><para id="para-00001">By the end of this section, you will be able to:</para>
<list id="list-00001">
<item>Identify counting numbers and whole numbers</item>
<item>Model whole numbers</item>
<item>Identify the place value of a digit</item>
<item>Use place value to name whole numbers</item>
<item>Use place value to write whole numbers</item>
<item>Round whole numbers</item>
</list></ns1:abstract>
